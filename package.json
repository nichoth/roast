{
  "name": "@substrate-system/roast",
  "version": "0.0.1",
  "description": "Adversarial review",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "bin": {
    "roast": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/THIRD_PARTY_LICENSES.txt",
    "roast.schema.json",
    "LICENSE.txt",
    "LICENSE-MIT.txt",
    "LICENSE-APACHE.txt"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node --import ./scripts/eslint-ts6.ts node_modules/eslint/bin/eslint.js src test scripts eslint.config.js",
    "typecheck": "tsc -p tsconfig.json",
    "schema": "node scripts/schema.ts",
    "build": "npm run schema && node scripts/bundle.ts",
    "build:test": "node scripts/bundle.ts --test",
    "test": "npm run build && npm run test:run",
    "test:run": "npm run build:test && npm run test:tap",
    "test:tap": "bash -o pipefail -c 'node test/test-bundle.js | tap-spec'",
    "test:one": "bash -o pipefail -c 'node scripts/bundle.ts --test-file \"$0\" && node test/one-bundle.js | tap-spec'",
    "test:live": "node scripts/bundle.ts --live && bash -o pipefail -c 'node test/live-bundle.js | tap-spec'",
    "check:pack": "node scripts/check-pack.ts",
    "toc": "markdown-toc --maxdepth 3 -i README.md",
    "preversion": "npm run lint",
    "version": "npm run toc && auto-changelog && npm run stage:docs",
    "stage:docs": "git add CHANGELOG.md README.md",
    "postversion": "git push --follow-tags && npm publish",
    "prepublishOnly": "npm run build && npm run check:pack"
  },
  "auto-changelog": {
    "package": true,
    "template": "keepachangelog",
    "breakingPattern": "BREAKING CHANGE:"
  },
  "devDependencies": {
    "@substrate-system/debug": "^0.9.64",
    "@substrate-system/redeye": "^0.1.8",
    "@substrate-system/tapzero": "^0.10.15",
    "@types/node": "^22.18.0",
    "@types/yargs": "^17.0.33",
    "@typescript/typescript6": "^6.0.2",
    "ajv": "^8.20.0",
    "auto-changelog": "^2.4.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.6.0",
    "hermes-tiiny-router": "^2.1.3",
    "jsonc-parser": "^3.3.1",
    "markdown-toc": "^1.2.0",
    "newneostandard": "^0.14.1",
    "tap-spec": "^5.0.0",
    "tiiny-router-pi": "^0.0.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.62.0",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "keywords": [
    "AI"
  ],
  "homepage": "https://github.com/nichoth/roast#readme",
  "bugs": {
    "url": "https://github.com/nichoth/roast/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nichoth/roast.git"
  },
  "author": "nichoth",
  "allowScripts": {
    "esbuild": true
  }
}
