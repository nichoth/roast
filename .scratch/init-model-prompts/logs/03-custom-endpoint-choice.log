ame = sameCustom(finder, verifier)\n        if (same && finderModel === verifierModel) {\n            return ['custom', 'custom']\n        }\n        if (same) {\n            return ['custom-finder', 'custom-verifier']\n        }\n        return ['custom-finder', 'custom-verifier']\n    }\n    if (fCustom) return ['custom', verifier.provider]\n    if (vCustom) return [finder.provider, 'custom']\n    const fAt = finder.provider\n    const vAt = verifier.provider\n    const separate = fAt === vAt &&\n        finderModel !== verifierModel\n    return [\n        fAt + (separate ? '-finder' : ''),\n        vAt + (separate ? '-verifier' : ''),\n    ]\n}\n\nexport function starter (\n    finder:StarterChoice, verifier:StarterChoice\n):string {\n    const finderModel = finder.model || PLACEHOLDER_FINDER_MODEL\n    const verifierModel = verifier.model ||\n        PLACEHOLDER_VERIFIER_MODEL\n    const [fName, vName] = profileNames(\n        finder, verifier, finderModel, verifierModel\n    )\n    const profiles = [\n        renderProfile(fName, finder, finderModel),\n    ]\n    if (fName !== vName) {\n        profiles.push(\n            renderProfile(vName, verifier, verifierModel)\n        )\n    }\n    return TEMPLATE\n        .replace('__SCHEMA__', JSON.stringify(SCHEMA_REF))\n        .replace('__PROFILES__', profiles.join(',\\n'))\n        .replace('__FINDER_PROFILE__', JSON.stringify(fName))\n        .replace('__VERIFIER_PROFILE__', JSON.stringify(vName))\n}"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":710,"cache_read_input_tokens":81603,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":710},"output_tokens":1,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fa31655d-debc-49e9-83c6-d8bc618478fe","