{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B7sfifr8V3zJDAyiZAh3Bf","type":"tool_result","content":"1\t// Shared defaults for starter rendering and CLI settings.\n2\texport const DEFAULT_CONFIDENCE_FLOOR = 0.6\n3\texport const DEFAULT_QUICK_CONFIDENCE_FLOOR = 0.8\n4\texport const DEFAULT_SNAPSHOT = true\n5\texport const DEFAULT_GATE_OFFER = true\n6\texport const GATE_DEFAULT_TIMEOUT = 180\n7\texport const GATE_DEFAULT_SEVERITY = 'HIGH'\n8\t\n9\t// Durations use config spelling; CLI consumers parse them as Go durations.\n10\texport const DEFAULT_LIMITS = Object.freeze({\n11\t    deadline:'10m',\n12\t    request_timeout:'10m',\n13\t    max_total_tokens:3_000_000,\n14\t    max_diff_bytes:1_000_000,\n15\t    max_prompt_bytes:8_000_000,\n16\t    max_file_ctx_bytes:400_000,\n17\t    max_attempts:4,\n18\t    max_verified:25,\n19\t})\n20\t\n21\t// Suggested model IDs for each built-in provider, used by the\n22\t// starter and the UnplaceableModelError hint.\n23\texport const SUGGESTED_MODELS = Object.freeze({\n24\t    anthropic:'claude-opus-5-5',\n25\t    openai:'gpt-6.1-terra',\n26\t    openrouter:Object.freeze([\n27\t        'anthropic/claude-opus-5-5',\n28\t        'openai/gpt-6.1-terra',\n29\t    ] as const),\n30\t})\n31\t\n32\t// Review flag defaults that have no config key. Survey values apply\n33\t// with `--scope repo`; quick values with `--quick`.\n34\texport const DEFAULT_REVIEW_MAX_TURNS = 16\n35\texport const SURVEY_MAX_TURNS = 40\n36\texport const SURVEY_DEADLINE = '25m'\n37\texport const QUICK_DIFF_BYTES = 200_000\n38\texport const QUICK_FILE_CTX_BYTES = 100_000\n39\t"}]},"parent_tool_use_id":"toolu_01D3vMhfKEa3y1FeL1F2HcCq","agent_id":"a85f2eb3553f193db","session_id":"fa31655d-debc-49e9-83c6-d8bc618478fe","uuid":"43accdfb-3ab6-45ec-a997-e8a50f05a87b","timestamp":"2026-11-24T22:23:55.893Z","tool_result_meta":[{"id":"toolu_01B7sfifr8V3zJDAyiZAh3Bf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}