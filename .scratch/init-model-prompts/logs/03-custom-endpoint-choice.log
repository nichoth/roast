{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012FUJF9r5drUWg5eKG5a6X5","type":"tool_result","content":"95\t}\n96\t\n97\texport async function isApproved (\n98\t    dir:string,\n99\t    hash:string,\n100\t    opts:TrustOpts = {}\n101\t):Promise<ApprovalState> {\n102\t    const rec = await readTrustRecord(await trustPath(dir, opts))\n103\t    if (rec.kind === 'legacy') return 'legacy'\n104\t    return rec.approved.includes(hash) ? 'approved' : 'not-approved'\n105\t}\n106\t\n107\t// Records `hash` for this clone. A legacy record is replaced, not\n108\t// migrated; a malformed one aborts with the file untouched.\n109\texport async function approve (\n110\t    dir:string,\n111\t    hash:string,\n112\t    opts:TrustOpts = {}\n113\t):Promise<void> {\n114\t    const file = await trustPath(dir, opts)\n115\t    const rec = await readTrustRecord(file)\n116\t    let approved = [hash]\n117\t    if (rec.kind === 'current') {\n118\t        if (rec.approved.includes(hash)) return\n119\t        approved = [...rec.approved, hash]"}]},"parent_tool_use_id":null,"session_id":"fa31655d-debc-49e9-83c6-d8bc618478fe","uuid":"8f15f35f-f84b-4c18-8ef9-5e622c694b9e","timestamp":"2026-11-24T22:31:54.608Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-03-custom-endpoint-choice/src/trust/trust.ts","content":"}\n\nexport async function isApproved (\n    dir:string,\n    hash:string,\n    opts:TrustOpts = {}\n):Promise<ApprovalState> {\n    const rec = await readTrustRecord(await trustPath(dir, opts))\n    if (rec.kind === 'legacy') return 'legacy'\n    return rec.approved.includes(hash) ? 'approved' : 'not-approved'\n}\n\n// Records `hash` for this clone. A legacy record is replaced, not\n// migrated; a malformed one aborts with the file untouched.\nexport async function approve (\n    dir:string,\n    hash:string,\n    opts:TrustOpts = {}\n):Promise<void> {\n    const file = await trustPath(dir, opts)\n    const rec = awa