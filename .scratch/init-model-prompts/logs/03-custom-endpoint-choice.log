{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018gX7jjNecUjRgpWYGJjk1B","type":"tool_result","content":"1\timport { test } from '../helpers/test.js'\n2\timport { decode, normalize } from '../../src/config/load.js'\n3\timport {\n4\t    starter,\n5\t    starterFromModels,\n6\t    UnplaceableModelError,\n7\t} from '../../src/config/starter.js'\n8\timport type { RoleChoice } from '../../src/config/starter.js'\n9\timport { thrown } from './helpers.js'\n10\timport {\n11\t    DEFAULT_LIMITS,\n12\t    SUGGESTED_MODELS,\n13\t} from '../../src/config/defaults.js'\n14\timport { gateOffers, snapshotEnabled } from '../../src/config/load.js'\n15\timport {\n16\t    GATE_DEFAULT_TIMEOUT,\n17\t    GATE_DEFAULT_SEVERITY,\n18\t} from '../../src/cli/gate.js'\n19\t\n20\ttest('starter places models and separates different models', t => {\n21\t    const cases:Array<[string, string, string, string, number]> = [\n22\t        ['', '', 'openai', 'anthropic', 2],\n23\t        ['claude-opus-5-5', 'gpt-5', 'anthropic', 'openai', 2],\n24\t        ['gpt-5', 'claude-sonnet-5-5', 'openai', 'anthropic', 2],\n25\t        ['claude-opus-5-5', '', 'anthropic', 'openai', 2],\n26\t        ['', 'gpt-5', 'anthropic', 'openai', 2],\n27\t        ['codex-mini-latest', '', 'openai', 'anthropic', 2],\n28\t        ['claude-x', 'claude-y', 'anthropic', 'anthropic', 2],\n29\t        ['gpt-5', 'gpt-5', 'openai', 'openai', 1],\n30\t        ['anthropic/claude-x', 'openai/gpt-5',\n31\t            'openrouter', 'openrouter', 2],\n32\t        ['meta-llama/llama-4:free', 'anthropic/claude-x',\n33\t            'openrouter', 'openrouter', 2],\n34\t        ['claude-x', 'openai/gpt-5', 'anthropic', 'openrouter', 2],\n35\t        ['anthropic/claude-x', 'gpt-5', 'openrouter', 'openai', 2],\n36\t        ['anthropic/claude-x', '', 'openrouter', 'openrouter', 2],\n37\t        ['', 'openai/gpt-5', 'openrouter', 'openrouter', 2],\n38\t        [' \\tgpt-5\\u0085', '', 'openai', 'anthropic', 2],\n39\t    ]\n40\t    const providers = {\n41\t        openai:['responses', 'https://api.openai.com/v1', 'OPENAI_API_KEY'],\n42\t        anthropic:['anthropic', 'https://api.anthropic.com/v1',\n43\t            'ANTHROPIC_API_KEY'],\n44\t        openrouter:['chat', 'https://openrouter.ai/api/v1',\n45\t            'OPENROUTER_API_KEY'],\n46\t    }\n47\t    for (const [finder, verifier, fAt, vAt, count] of cases) {\n48\t        const cfg = normalize(\n49\t            decode(starterFromModels(finder, verifier)), ''\n50\t        )\n51\t        t.equal(Object.keys(cfg.inference_profiles).length, count)\n52\t        for (const [role, at, model] of [\n53\t            ['finder', fAt, finder], ['verifier', vAt, verifier],\n54\t        ] as const) {\n55\t            const name = cfg.roles[role]!.profile\n56\t            const p = cfg.inference_profiles[name!]!\n57\t            t.deepEqual([p.protocol, p.endpoint, p.api_key_env],\n58\t                providers[at as keyof typeof providers])\n59\t            t.equal(p.model, model.trim().replace(/\\u0085$/, '') ||\n60\t                `<${role}-model>`)\n61\t        }\n62\t        if (finder !== verifier) {\n63\t            t.ok(cfg.roles.finder!.profile !== cfg.roles.verifier!.profile,\n64\t                'different models have different profiles')\n65\t        }\n66\t    }\n67\t})\n68\t\n69\ttest('starter gives default and OpenRouter profiles stable names', t => {\n70\t    for (const [f, v, names] of [\n71\t        ['', '', ['openai', 'anthropic']],\n72\t        ['anthropic/claude-x', 'openai/gpt-5',\n73\t            ['openrouter-finder', 'openrouter-verifier']],\n74\t    ] as const) {\n75\t        const cfg = normalize(decode(starterFromModels(f, v)), '')\n76\t        t.deepEqual(\n77\t            [\n78\t                cfg.roles.finder!.profile,\n79\t                cfg.roles.verifier!.profile,\n80\t            ],\n81\t            [...names]\n82\t        )\n83\t    }\n84\t})\n85\t\n86\ttest('starter rejects unplaceable IDs with role and trimmed model', t => {\n87\t    for (const model of [\n88\t        'gemini-2.5-pro', 'some-model', 'openai',\n89\t        'claude-opus-5-5[1m]', 'openai:api', 'Claude-Opus-5-5',\n90\t        'claude-x@2024', 'gpt-5 mini', 'Anthropic/claude-opus-5-5',\n91\t        'anthropic/Claude-Opus-5-5', 'anthropic/ claude-opus-5-5',\n92\t        'anthropic/claude-opus-5-5[1m]', 'openai/gpt-5:api',\n93\t        'anthropic/anthropic', 'google/gemini', 'openai/', '/gpt-5',\n94\t        'openai/gpt-5/mini', 'meta-llama/llama-4:',\n95\t    ]) {\n96\t        for (const role of ['finder', 'verifier']) {\n97\t            const err = thrown(() => starterFromModels(\n98\t                role === 'finder' ? ` ${model} ` : '',\n99\t                role === 'verifier' ? ` ${model} ` : ''\n100\t            ))\n101\t            t.ok(err instanceof UnplaceableModelError)\n102\t            if (!(err instanceof UnplaceableModelError)) continue\n103\t            t.equal(err.role, role)\n104\t            t.equal(err.model, model)\n105\t        }\n106\t    }\n107\t    const first = thrown(() => starterFromModels(\n108\t        'invalid-finder', 'invalid-verifier'\n109\t    ))\n110\t    t.equal((first as UnplaceableModelError).role, 'finder')\n111\t})\n112\t\n113\ttest('suggested model constants exist for each built-in provider', t => {\n114\t    t.ok(SUGGESTED_MODELS.anthropic, 'anthropic suggested model')\n115\t    t.ok(SUGGESTED_MODELS.openai, 'openai suggested model')\n116\t    t.ok(SUGGESTED_MODELS.openrouter, 'openrouter suggested models')\n117\t    t.equal(SUGGESTED_MODELS.anthropic, 'claude-opus-5-5')\n118\t    t.equal(SUGGESTED_MODELS.openai, 'gpt-6.1-terra')\n119\t    t.ok(\n120\t        SUGGESTED_MODELS.openrouter.includes(\n121\t            'anthropic/claude-opus-5-5'\n122\t        ),\n123\t        'openrouter has anthropic slug'\n124\t    )\n125\t    t.ok(\n126\t        SUGGESTED_MODELS.openrouter.includes(\n127\t            'openai/gpt-6.1-terra'\n128\t        ),\n129\t        'openrouter has openai slug'\n130\t    )\n131\t})\n132\t\n133\ttest('starter accepts RoleChoice per role', t => {\n134\t    const finder:RoleChoice = {\n135\t        provider:'openai', model:'gpt-5'\n136\t    }\n137\t    const verifier:RoleChoice = {\n138\t        provider:'anthropic', model:'claude-opus-5-5'\n139\t    }\n140\t    const cfg = normalize(decode(starter(finder, verifier)), '')\n141\t    const fp = cfg.inference_profiles[cfg.roles.finder!.profile!]!\n142\t    const vp = cfg.inference_profiles[cfg.roles.verifier!.profile!]!\n143\t    t.equal(fp.model, 'gpt-5')\n144\t    t.equal(vp.model, 'claude-opus-5-5')\n145\t    t.equal(fp.endpoint, 'https://api.openai.com/v1')\n146\t    t.equal(vp.endpoint, 'https://api.anthropic.com/v1')\n147\t})\n148\t\n149\ttest('starterFromModels produces same output as old starter', t => {\n150\t    const cases:[string, string][] = [\n151\t        ['', ''],\n152\t        ['claude-opus-5-5', 'gpt-5'],\n153\t        ['gpt-5', 'claude-sonnet-5-5'],\n154\t        ['claude-opus-5-5', ''],\n155\t        ['', 'gpt-5'],\n156\t        ['anthropic/claude-x', 'openai/gpt-5'],\n157\t    ]\n158\t    for (const [f, v] of cases) {\n159\t        const cfg = normalize(\n160\t            decode(starterFromModels(f, v)), ''\n161\t        )\n162\t        const fp = cfg.inference_profiles[\n163\t            cfg.roles.finder!.profile!\n164\t        ]!\n165\t        const vp = cfg.inference_profiles[\n166\t            cfg.roles.verifier!.profile!\n167\t        ]!\n168\t        t.ok(fp.model, `finder model set for [${f}, ${v}]`)\n169\t        t.ok(vp.model, `verifier model set for [${f}, ${v}]`)\n170\t    }\n171\t})\n172\t\n173\ttest('UnplaceableModelError uses suggested model constants', t => {\n174\t    const err = new UnplaceableModelError('finder', 'bad-model')\n175\t    t.ok(\n176\t        err.message.includes(SUGGESTED_MODELS.anthropic),\n177\t        'mentions anthropic suggested model'\n178\t    )\n179\t    t.ok(\n180\t        err.message.includes(\n181\t            SUGGESTED_MODELS.openrouter[0]!\n182\t        ),\n183\t        'mentions openrouter suggested model'\n184\t    )\n185\t})\n186\t\n187\ttest('starter comments agree with runtime defaults', t => {\n188\t    const body = starterFromModels('', '')\n189\t    const comments = body.split('\\n').filter(line =>\n190\t        /^ {2}\\/\\/ (?: *\"| *})/.test(line))\n191\t        .map(line => line.slice(5)).join('\\n')\n192\t    // Only object-property comments are executable JSONC when uncommented.\n193\t    const blocks = comments.slice(comments.indexOf('\"review\":'))\n194\t    const raw = decode('{\"version\":1,' + blocks + '}')\n195\t    const cfg = normalize(decode(body), '')\n196\t    t.deepEqual({ ...raw.limits }, {\n197\t        deadline:'10m',\n198\t        request_timeout:'10m',\n199\t        max_total_tokens:3000000,\n200\t        max_diff_bytes:1000000,"}]},"parent_tool_use_id":"toolu_01D3vMhfKEa3y1FeL1F2HcCq","agent_id":"a85f2eb3553f193db","session_id":"fa31655d-debc-49e9-83c6-d8bc618478fe","uuid":"57b27278-a444-44bd-a3ca-1c814249d0cd","timestamp":"2026-11-24T22:24:01.306Z","tool_result_meta":[{"id":"toolu_018gX7jjNecUjRgpWYGJjk1B","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"fork","task_description":"Read all relevant source files"}
