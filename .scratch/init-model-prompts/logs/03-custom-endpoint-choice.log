{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Sm9ffXP4S12JYWFpB5Gh4H","type":"tool_result","content":"1\t// Credential resolution and endpoint overrides (spec 02, 2.6 and 2.9).\n2\t// `env` is always passed in; nothing here reads process.env. A key never\n3\t// appears in a CredentialSource or an error message.\n4\timport { ConfigError } from './load.js'\n5\timport {\n6\t    builtinProviders,\n7\t    defaultBaseURL,\n8\t    providerAt,\n9\t    sameEndpoint,\n10\t} from './provider.js'\n11\timport { type ResolvedRole, updateRole } from './resolved-role.js'\n12\t\n13\texport type Env = Readonly<Record<string, string|undefined>>\n14\t\n15\t// The stored-credential store a loaded config carries (filled by the\n16\t// credentials area; config never imports it).\n17\texport interface StoredCredentials {\n18\t    // null or a '' key when none is stored. Throws when a credentials file\n19\t    // cannot be used; it never skips a bad file.\n20\t    lookup (provider:string):{\n21\t        key:string,\n22\t        scope:'project'|'user'|'',\n23\t    }|null;\n24\t}\n25\t\n26\texport type CredentialKind =\n27\t    'role_env'|'profile_env'|'provider_env'|'stored'|'none'\n28\t\n29\texport interface CredentialSource {\n30\t    readonly kind:CredentialKind;\n31\t    // The variable read, for env kinds.\n32\t    readonly env?:string;\n33\t    // stored: provider name and scope ('project' or 'user').\n34\t    readonly provider?:string;\n35\t    readonly scope?:string;\n36\t    // none: a set provider key that was not sent.\n37\t    readonly withheld?:string;\n38\t}\n39\t\n40\texport interface Credential {\n41\t    key:string;\n42\t    source:CredentialSource;\n43\t}\n44\t\n45\t// A variable counts only when it is set to a non-empty string.\n46\texport function envValue (env:Env, name:string):string {\n47\t    if (name === '' || !Object.hasOwn(env, name)) return ''\n48\t    const v = env[name]\n49\t    return typeof v === 'string' ? v : ''\n50\t}\n51\t\n52\texport function roleKeyVar (role:string):string {\n53\t    return `ROAST_${role.toUpperCase()}_API_KEY`\n54\t}\n55\t\n56\t// Where a credential came from, never the credential itself.\n57\texport function describeSource (s:CredentialSource):string {\n58\t    switch (s.kind) {\n59\t        case 'role_env': return `${s.env} (role override)`\n60\t        case 'profile_env': return `${s.env} (profile api_key_env)`\n61\t        case 'provider_env': return `${s.env} (ambient provider key)`\n62\t        case 'stored':\n63\t            return `stored ${s.scope} credential for ${s.provider}`\n64\t        default:\n65\t            return s.withheld ?\n66\t                `none; ${s.withheld} is set but is sent only to its ` +\n67\t                    \"provider's default endpoint\" :\n68\t                'none'\n69\t    }\n70\t}\n71\t\n72\tfunction wrap (roleName:string, err:unknown):ConfigError {\n73\t    const cause = err instanceof Error ? err.message : String(err)\n74\t    return new ConfigError(`role ${roleName}: ${cause}`, { cause:err })\n75\t}\n76\t\n77\t// A set standard key variable of a built-in provider, preferring the\n78\t// provider at the protocol's default endpoint, or ''. Called only after no\n79\t// key was sent, so any variable it names was withheld.\n80\tfunction withheldKey (protocol:string, env:Env):string {\n81\t    const providers = builtinProviders()\n82\t    const preferred = providers.find(p =>\n83\t        sameEndpoint(p.endpoint, defaultBaseURL(protocol)))\n84\t    const candidates = [\n85\t        ...(preferred ? [preferred.keyEnv] : []),\n86\t        ...providers.map(p => p.keyEnv),\n87\t    ]\n88\t    return candidates.find(name => envValue(env, name) !== '') ?? ''\n89\t}\n90\t\n91\t// The stored key of the built-in provider at endpoint and protocol. The\n92\t// registry alone decides the provider, so a custom endpoint never\n93\t// receives a stored key.\n94\tfunction storedCredential (\n95\t    stored:StoredCredentials|undefined,\n96\t    protocol:string,\n97\t    endpoint:string\n98\t):Credential|null {\n99\t    const provider = providerAt(endpoint, protocol)\n100\t    if (!provider || !stored) return null\n101\t    const found = stored.lookup(provider.name)\n102\t    if (!found || found.key === '') return null\n103\t    return {\n104\t        key:found.key,\n105\t        source:{ kind:'stored', provider:provider.name, scope:found.scope },\n106\t    }\n107\t}\n108\t\n109\t// A built-in provider's standard key, else its stored key, only when the\n110\t// role is on that provider's endpoint with a protocol it accepts there.\n111\t// Throws when the store is reached and unusable.\n112\texport function ambientCredential (\n113\t    protocol:string,\n114\t    endpoint:string,\n115\t    stored:StoredCredentials|undefined,\n116\t    env:Env\n117\t):Credential {\n118\t    const provider = providerAt(endpoint, protocol)\n119\t    if (provider) {\n120\t        const key = envValue(env, provider.keyEnv)\n121\t        if (key !== '') {\n122\t            return { key, source:{ kind:'provider_env', env:provider.keyEnv } }\n123\t        }\n124\t        const fromStore = storedCredential(stored, protocol, endpoint)\n125\t        if (fromStore) return fromStore\n126\t    }\n127\t    const withheld = withheldKey(protocol, env)\n128\t    return { key:'', source:{ kind:'none', withheld } }\n129\t}\n130\t\n131\t// The credential of a freshly resolved role: the role variable, the\n132\t// profile's variable, then the ambient provider key or stored key.\n133\texport function resolveCredential (\n134\t    roleName:string,\n135\t    apiKeyEnv:string,\n136\t    role:Pick<ResolvedRole, 'protocol'|'baseURL'|'stored'>,\n137\t    env:Env\n138\t):Credential {\n139\t    const roleVar = roleKeyVar(roleName)\n140\t    const roleKey = envValue(env, roleVar)\n141\t    if (roleKey !== '') {\n142\t        return { key:roleKey, source:{ kind:'role_env', env:roleVar } }\n143\t    }\n144\t    try {\n145\t        if (apiKeyEnv !== '') {\n146\t            const source:CredentialSource = {\n147\t                kind:'profile_env',\n148\t                env:apiKeyEnv,\n149\t            }\n150\t            const key = envValue(env, apiKeyEnv)\n151\t            if (key !== '') return { key, source }\n152\t            // An unset profile variable on a built-in endpoint falls back\n153\t            // to the provider's variable, then its stored key, as\n154\t            // rebindCredential does after an override.\n155\t            const ambient = ambientCredential(role.protocol, role.baseURL,\n156\t                role.stored, env)\n157\t            return ambient.key === '' ? { key:'', source } : ambient\n158\t        }\n159\t        return ambientCredential(role.protocol, role.baseURL, role.stored,\n160\t            env)\n161\t    } catch (err) {\n162\t        throw wrap(roleName, err)\n163\t    }\n164\t}\n165\t\n166\tinterface Overrides {\n167\t    baseURL?:string;\n168\t    protocol?:string;\n169\t}\n170\t\n171\t// Applies the protocol, then the endpoint override. Returns the moved\n172\t// role and whether the protocol override moved it from one provider's\n173\t// default endpoint to another's.\n174\tfunction applyEndpointOverrides (\n175\t    role:ResolvedRole,\n176\t    { baseURL, protocol }:Overrides\n177\t):{ role:ResolvedRole, crossed:boolean } {\n178\t    let crossed = false\n179\t    let next = role\n180\t    if (protocol !== undefined) {\n181\t        const previousDefault = defaultBaseURL(role.protocol)\n182\t        const nextDefault = defaultBaseURL(protocol)\n183\t        next = updateRole(next, { protocol })\n184\t        if (nextDefault !== previousDefault &&\n185\t            (!role.explicitEndpoint ||\n186\t                sameEndpoint(role.baseURL, previousDefault))) {\n187\t            next = updateRole(next, { baseURL:nextDefault })\n188\t            crossed = true\n189\t        }\n190\t    }\n191\t    if (baseURL !== undefined) {\n192\t        next = updateRole(next, { baseURL, explicitEndpoint:true })\n193\t        crossed = false\n194\t    }\n195\t    return { role:next, crossed }\n196\t}\n197\t\n198\t// Re-resolves a credential after the endpoint or protocol changed. A role\n199\t// key, or a profile key on an endpoint that did not cross providers,\n200\t// follows the override; any other key is checked again.\n201\tfunction rebindCredential (\n202\t    roleName:string,\n203\t    role:ResolvedRole,\n204\t    crossed:boolean,\n205\t    env:Env\n206\t):ResolvedRole {\n207\t    const kind = role.credential.kind\n208\t    if (kind === 'role_env') return role\n209\t    if (kind === 'profile_env' && !crossed) return role\n210\t    const roleVar = roleKeyVar(roleName)\n211\t    const roleKey = envValue(env, roleVar)\n212\t    if (roleKey !== '') {\n213\t        return updateRole(role, {\n214\t            apiKey:roleKey,\n215\t            credential:{ kind:'role_env', env:roleVar },\n216\t        })\n217\t    }\n218\t    let found:Credential\n219\t    try {\n220\t        found = ambientCredential(role.protocol, role.baseURL, role.stored,\n221\t            env)\n222\t    } catch (err) {\n223\t        throw wrap(roleName, err)\n224\t    }\n225\t    return updateRole(role, { apiKey:found.key, credential:found.source })\n226\t}\n227\t\n228\t// Applies `--<role>-base-url` / `--<role>-protocol` (undefined = flag not\n229\t// given) and re-binds the credential through the same path as initial\n230\t// resolution. Throws only when a needed stored credential is unusable.\n231\texport function overrideEndpoint (\n232\t    roleName:string,\n233\t    role:ResolvedRole,\n234\t    overrides:Overrides,\n235\t    env:Env\n236\t):ResolvedRole {\n237\t    const moved = applyEndpointOverrides(role, overrides)\n238\t    return rebindCredential(roleName, moved.role, moved.crossed, env)\n239\t}\n240\t\n241\t// Exposed for the override matrix tests only.\n242\texport const internal = { applyEndpointOverrides, rebindCredential }\n243\t"}]},"parent_tool_use_id":null,"session_id":"fa31655d-debc-49e9-83c6-d8bc618478fe","uuid":"e4759b5b-03a4-4931-81d0-da17cec6652c","timestamp":"2026-11-24T22:25:22.775Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-03-custom-endpoint-choice/src/config/credential.ts","content":"// Credential resolution and endpoint overrides (spec 02, 2.6 and 2.9).\n// `env` is always passed in; nothing here reads process.env. A key never\n// appears in a CredentialSource or an error message.\nimport { ConfigError } from './load.js'\nimport {\n    builtinProviders,\n    defaultBaseURL,\n    providerAt,\n    sameEndpoint,\n} from './provider.js'\nimport { type ResolvedRole, updateRole } from './resolved-role.js'\n\nexport type Env = Readonly<Record<string, string|undefined>>\n\n// The stored-credential store a loaded config carries (filled by the\n// credentials area; config never imports it).\nexport interface StoredCredentials {\n    // null or a '' key when none is stored. Throws when a credentials file\n    // cannot be used; it never skips a bad file.\n    lookup (provider:string):{\n        key:string,\n        scope:'project'|'user'|'',\n    }|null;\n}\n\nexport type CredentialKind =\n    'role_env'|'profile_env'|'provider_env'|'stored'|'none'\n\nexport interface CredentialSource {\n    readonly kind:CredentialKind;\n    // The variable read, for env kinds.\n    readonly env?:string;\n    // stored: provider name and scope ('project' or 'user').\n    readonly provider?:string;\n    readonly scope?:string;\n    // none: a set provider key that was not sent.\n    readonly withheld?:string;\n}\n\nexport interface Credential {\n    key:string;\n    source:CredentialSource;\n}\n\n// A variable counts only when it is set to a non-empty string.\nexport function envValue (env:Env, name:string):string {\n    if (name === '' || !Object.hasOwn(env, name)) return ''\n    const v = env[name]\n    return typeof v === 'string' ? v : ''\n}\n\nexport function roleKeyVar (role:string):string {\n    return `ROAST_${role.toUpperCase()}_API_KEY`\n}\n\n// Where a credential came from, never the credential itself.\nexport function describeSource (s:CredentialSource):string {\n    switch (s.kind) {\n        case 'role_env': return `${s.env} (role override)`\n        case 'profile_env': return `${s.env} (profile api_key_env)`\n        case 'provider_env': return `${s.env} (ambient provider key)`\n        case 'stored':\n            return `stored ${s.scope} credential for ${s.provider}`\n        default:\n            return s.withheld ?\n                `none; ${s.withheld} is set but is sent only to its ` +\n                    \"provider's default endpoint\" :\n                'none'\n    }\n}\n\nfunction wrap (roleName:string, err:unknown):ConfigError {\n    const cause = err instanceof Error ? err.message : String(err)\n    return new ConfigError(`role ${roleName}: ${cause}`, { cause:err })\n}\n\n// A set standard key variable of a built-in provider, preferring the\n// provider at the protocol's default endpoint, or ''. Called only after no\n// key was sent, so any variable it names was withheld.\nfunction withheldKey (protocol:string, env:Env):string {\n    const providers = builtinProviders()\n    const preferred = providers.find(p =>\n        sameEndpoint(p.endpoint, defaultBaseURL(protocol)))\n    const candidates = [\n        ...(preferred ? [preferred.keyEnv] : []),\n        ...providers.map(p => p.keyEnv),\n    ]\n    return candidates.find(name => envValue(env, name) !== '') ?? ''\n}\n\n// The stored key of the built-in provider at endpoint and protocol. The\n// registry alone decides the provider, so a custom endpoint never\n// receives a stored key.\nfunction storedCredential (\n    stored:StoredCredentials|undefined,\n    protocol:string,\n    endpoint:string\n):Credential|null {\n    const provider = providerAt(endpoint, protocol)\n    if (!provider || !stored) return null\n    const found = stored.lookup(provider.name)\n    if (!found || found.key === '') return null\n    return {\n        key:found.key,\n        source:{ kind:'stored', provider:provider.name, scope:found.scope },\n    }\n}\n\n// A built-in provider's standard key, else its stored key, only when the\n// role is on that provider's endpoint with a protocol it accepts there.\n// Throws when the store is reached and unusable.\nexport function ambientCredential (\n    protocol:string,\n    endpoint:string,\n    stored:StoredCredentials|undefined,\n    env:Env\n):Credential {\n    const provider = providerAt(endpoint, protocol)\n    if (provider) {\n        const key = envValue(env, provider.keyEnv)\n        if (key !== '') {\n            return { key, source:{ kind:'provider_env', env:provider.keyEnv } }\n        }\n        const fromStore = storedCredential(stored, protocol, endpoint)\n        if (fromStore) return fromStore\n    }\n    const withheld = withheldKey(protocol, env)\n    return { key:'', source:{ kind:'none', withheld } }\n}\n\n// The credential of a freshly resolved role: the role variable, the\n// profile's variable, then the ambient provider key or stored key.\nexport function resolveCredential (\n    roleName:string,\n    apiKeyEnv:string,\n    role:Pick<ResolvedRole, 'protocol'|'baseURL'|'stored'>,\n    env:Env\n):Credential {\n    const roleVar = roleKeyVar(roleName)\n    const roleKey = envValue(env, roleVar)\n    if (roleKey !== '') {\n        return { key:roleKey, source:{ kind:'role_env', env:roleVar } }\n    }\n    try {\n        if (apiKeyEnv !== '') {\n            const source:CredentialSource = {\n                kind:'profile_env',\n                env:apiKeyEnv,\n            }\n            const key = envValue(env, apiKeyEnv)\n            if (key !== '') return { key, source }\n            // An unset profile variable on a built-in endpoint falls back\n            // to the provider's variable, then its stored key, as\n            // rebindCredential does after an override.\n            const ambient = ambientCredential(role.protocol, role.baseURL,\n                role.stored, env)\n            return ambient.key === '' ? { key:'', source } : ambient\n        }\n        return ambientCredential(role.protocol, role.baseURL, role.stored,\n            env)\n    } catch (err) {\n        throw wrap(roleName, err)\n    }\n}\n\ninterface Overrides {\n    baseURL?:string;\n    protocol?:string;\n}\n\n// Applies the protocol, then the endpoint override. Returns the moved\n// role and whether the protocol override moved it from one provider's\n// default endpoint to another's.\nfunction applyEndpointOverrides (\n    role:ResolvedRole,\n    { baseURL, protocol }:Overrides\n):{ role:ResolvedRole, crossed:boolean } {\n    let crossed = false\n    let next = role\n    if (protocol !== undefined) {\n        const previousDefault = defaultBaseURL(role.protocol)\n        const nextDefault = defaultBaseURL(protocol)\n        next = updateRole(next, { protocol })\n        if (nextDefault !== previousDefault &&\n            (!role.explicitEndpoint ||\n                sameEndpoint(role.baseURL, previousDefault))) {\n            next = updateRole(next, { baseURL:nextDefault })\n            crossed = true\n        }\n    }\n    if (baseURL !== undefined) {\n        next = updateRole(next, { baseURL, explicitEndpoint:true })\n        crossed = false\n    }\n    return { role:next, crossed }\n}\n\n// Re-resolves a credential after the endpoint or protocol changed. A role\n// key, or a profile key on an endpoint that did not cross providers,\n// follows the override; any other key is checked again.\nfunction rebindCredential (\n    roleName:string,\n    role:ResolvedRole,\n    crossed:boolean,\n    env:Env\n):ResolvedRole {\n    const kind = role.credential.kind\n    if (kind === 'role_env') return role\n    if (kind === 'profile_env' && !crossed) return role\n    const roleVar = roleKeyVar(roleName)\n    const roleKey = envValue(env, roleVar)\n    if (roleKey !== '') {\n        return updateRole(role, {\n            apiKey:roleKey,\n            credential:{ kind:'role_env', env:roleVar },\n        })\n    }\n    let found:Credential\n    try {\n        found = ambientCredential(role.protocol, role.baseURL, role.stored,\n            env)\n    } catch (err) {\n        throw wrap(roleName, err)\n    }\n    return updateRole(role, { apiKey:found.key, credential:found.source })\n}\n\n// Applies `--<role>-base-url` / `--<role>-protocol` (undefined = flag not\n// given) and re-binds the credential through the same path as initial\n// resolution. Throws only when a needed stored credential is unusable.\nexport function overrideEndpoint (\n    roleName:string,\n    role:ResolvedRole,\n    overrides:Overrides,\n    env:Env\n):ResolvedRole {\n    const moved = applyEndpointOverrides(role, overrides)\n    return rebindCredential(roleName, moved.role, moved.crossed, env)\n}\n\n// Exposed for the override matrix tests only.\nexport const internal = { applyEndpointOverrides, rebindCredential }\n","numLines":243,"startLine":1,"totalLines":243}},"tool_result_meta":[{"id":"toolu_01Sm9ffXP4S12JYWFpB5Gh4H","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
