rifier!.profile, 'custom')","+        t.equal(","+            Object.keys(cfg.inference_profiles).length, 1","+        )","+    })","+"," test('starter comments agree with runtime defaults', t => {","     const body = starterFromModels('', '')","     const comments = body.split('\\n').filter(line =>"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01VL1BAW9fiVV6C16mYE595K","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
