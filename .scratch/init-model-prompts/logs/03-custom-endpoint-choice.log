{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012rgwBPVmuk4YDAdmW4qTk5","type":"tool_result","content":"1\t// `roast trust` and the review-time trust check (spec 03, 2.7 to 2.9).\n2\t// A config that sends code or credentials anywhere but a built-in\n3\t// provider's standard endpoint and key variable, or that replaces a\n4\t// prompt, must be approved for this clone before anything is sent.\n5\timport type { Argv } from 'yargs'\n6\timport type { ProjectConfig } from '../config/load.js'\n7\timport {\n8\t    type TrustProjection,\n9\t    requiresApproval,\n10\t    trustHash,\n11\t    trustProjection,\n12\t} from '../config/trust.js'\n13\timport { gitRoot } from '../git/git.js'\n14\timport { line } from '../textsafe/textsafe.js'\n15\timport { approve, isApproved } from '../trust/trust.js'\n16\timport type { CommandArgs, CommandDef, RunContext } from './command.js'\n17\timport { loadProjectConfig } from './config.js'\n18\timport { UsageError } from './errors.js'\n19\timport { interactiveTerminals, promptNoDefault } from './terminal.js'\n20\t\n21\tconst QUESTION = 'Trust this project config?'\n22\tconst APPROVED = 'Approved for this clone.\\n'\n23\t\n24\texport const NOT_APPROVED = 'the project config names endpoints, ' +\n25\t    'credential variables, or prompt files that are not approved for this ' +\n26\t    'clone; review and approve them with `npx roast trust`'\n27\t\n28\texport const LEGACY_APPROVAL = 'this clone\\'s approvals were recorded by ' +\n29\t    'an older Roast and are no longer accepted; review and approve the ' +\n30\t    'project config again with `npx roast trust`'\n31\t\n32\t// What requireTrust may touch: the CLI context without its command\n33\t// details.\n34\texport type TrustIo = Pick<RunContext,\n35\t    'stdin'|'stderr'|'lines'|'env'|'signal'>\n36\t\n37\t// Prints every security-relevant value of the projection, each escaped to\n38\t// one line so config text cannot add lines or terminal escapes.\n39\texport function writeTrustSummary (\n40\t    out:NodeJS.WritableStream,\n41\t    p:TrustProjection\n42\t):void {\n43\t    let text = 'This project config sends code and credentials to:\\n'\n44\t    for (const profile of p.profiles) {\n45\t        const credential = profile.credentialEnv === '' ?\n46\t            '(none named)' :\n47\t            line(profile.credentialEnv)\n48\t        text += `  ${line(profile.selector)}: profile ` +\n49\t            `${line(profile.profile)}\\n` +\n50\t            `    endpoint:   ${line(profile.endpoint)}\\n` +\n51\t            `    protocol:   ${line(profile.protocol)}\\n` +\n52\t            `    credential: ${credential}\\n`\n53\t    }\n54\t    if (p.promptOverrides.length > 0) {\n55\t        text += 'and replaces prompts with these files:\\n'\n56\t        for (const o of p.promptOverrides) {\n57\t            text += `  ${line(o.name)}: ${line(o.path)}\\n`\n58\t        }\n59\t    }\n60\t    out.write(text)\n61\t}\n62\t\n63\t// Fails unless the config needs no approval or this clone approved it.\n64\t// On terminals it asks inline (on stderr); elsewhere it never reads\n65\t// stdin. A trust record that cannot be read is not a usage error.\n66\texport async function requireTrust (\n67\t    dir:string,\n68\t    cfg:ProjectConfig,\n69\t    io:TrustIo\n70\t):Promise<void> {\n71\t    const p = trustProjection(cfg)\n72\t    if (!requiresApproval(p)) return\n73\t    const hash = trustHash(p)\n74\t    const opts = { env:io.env as NodeJS.ProcessEnv, signal:io.signal }\n75\t    const state = await isApproved(dir, hash, opts)\n76\t    if (state === 'approved') return\n77\t    if (!interactiveTerminals(io.stdin, io.stderr)) {\n78\t        throw new UsageError(state === 'legacy' ?\n79\t            LEGACY_APPROVAL :\n80\t            NOT_APPROVED)\n81\t    }\n82\t    if (state === 'legacy') {\n83\t        io.stderr.write('The existing approvals for this clone came from ' +\n84\t            'an older Roast and are no longer accepted.\\n')\n85\t    }\n86\t    writeTrustSummary(io.stderr, p)\n87\t    if (!await promptNoDefault(io.stderr, io.lines, QUESTION)) {\n88\t        throw new UsageError('project config not approved; nothing ' +\n89\t            'recorded and nothing sent')\n90\t    }\n91\t    await approve(dir, hash, opts)\n92\t    io.stderr.write(APPROVED)\n93\t}\n94\t\n95\tasync function trustHandler (\n96\t    args:CommandArgs,\n97\t    ctx:RunContext\n98\t):Promise<void> {\n99\t    let root:string\n100\t    try {\n101\t        root = await gitRoot(ctx.cwd, {\n102\t            env:ctx.env as NodeJS.ProcessEnv,\n103\t            signal:ctx.signal,\n104\t        })\n105\t    } catch (err) {\n106\t        if (ctx.signal.aborted) throw err\n107\t        throw new UsageError('not inside a git repository', { cause:err })\n108\t    }\n109\t    const explicit = typeof args.config === 'string' ? args.config : ''\n110\t    const cfg = await loadProjectConfig(explicit, ctx)\n111\t    const p = trustProjection(cfg)\n112\t    writeTrustSummary(ctx.stdout, p)\n113\t    if (!requiresApproval(p)) {\n114\t        ctx.stdout.write('Only default provider endpoints and key ' +\n115\t            'variables are used; no approval is needed.\\n')\n116\t        return\n117\t    }\n118\t    if (args.yes !== true &&\n119\t        !await promptNoDefault(ctx.stdout, ctx.lines, QUESTION)) {\n120\t        throw new UsageError('not approved; nothing recorded')\n121\t    }\n122\t    await approve(root, trustHash(p), {\n123\t        env:ctx.env as NodeJS.ProcessEnv,\n124\t        signal:ctx.signal,\n125\t    })\n126\t    ctx.stdout.write(APPROVED)\n127\t}\n128\t\n129\texport const trustCommand:CommandDef = {\n130\t    command:'trust',\n131\t    describe:'Approve the project config\\'s endpoints and credentials',\n132\t    builder:(y:Argv) => y\n133\t        .option('config', {\n134\t            type:'string',\n135\t            describe:'project config file (default: nearest .roast.json)',\n136\t        })\n137\t        .option('yes', {\n138\t