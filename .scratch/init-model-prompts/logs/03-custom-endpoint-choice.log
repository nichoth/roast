n52\t    return p.endpoint || defaultBaseURL(p.protocol)\n53\t}\n54\t\n55\t// The profile's own credential variable, without the role override.\n56\tfunction credentialEnv (p:NormalizedProfile):string {\n57\t    if (p.api_key_env) return p.api_key_env\n58\t    return providerAt(profileEndpoint(p), p.protocol)?.keyEnv ?? ''\n59\t}\n60\t\n61\texport function trustProjection (cfg:ProjectConfig):TrustProjection {\n62\t    const profiles:TrustedProfile[] = []\n63\t    const add = (selector:string, name:string|undefined):void => {\n64\t        if (name === undefined) return\n65\t        if (!Object.hasOwn(cfg.inference_profiles, name)) return\n66\t        const p = cfg.inference_profiles[name]\n67\t        profiles.push({\n68\t            selector,\n69\t            profile:name,\n70\t            endpoint:profileEndpoint(p),\n71\t            protocol:p.protocol,\n72\t            credentialEnv:credentialEnv(p),\n73\t        })\n74\t    }\n75\t    const roles = cfg.roles as Record<string, ProjectConfig['roles']['finder']>\n76\t    for (const roleName of Object.keys(roles).sort(byCodeUnits)) {\n77\t        const role = roles[roleName]\n78\t        if (!role) continue\n79\t        add(`roles.${roleName}`, role.profile)\n80\t        const routes = role.author_routes ?? {}\n81\t        for (const family of Object.keys(routes).sort(byCodeUnits)) {\n82\t            add(`roles.${roleName}.author_routes.${family}`, routes[family])\n83\t        }\n84\t    }\n85\t    const promptOverrides:PromptOverride[] = []\n86\t    for (const name of PROMPT_NAMES) {\n87\t        const path = cfg.prompts?.[name] ?? ''\n88\t        if (path !== '') promptOverrides.push({ name:`prompts.${name}`, path })\n89\t    }\n90\t    return { profiles, promptOverrides }\n91\t}\n92\t\n93\t// On a built-in provider's endpoint, with a protocol it accepts and its\n94\t// standard key variable.\n95\tfunction standard (p:TrustedProfile):boolean {\n96\t    const provider = providerAt(p.endpoint, p.protocol)\n97\t    return provider !== undefined && p.credentialEnv === provider.keyEnv\n98\t}\n99\t\n100\texport function requiresApproval (p:TrustProjection):boolean {\n101\t    return p.promptOverrides.length > 0 || !p.profiles.every(standard)\n102\t}\n103\t\n104\tfunction compareDestinations (a:Destination, b:Destination):number {\n105\t    return byCodeUnits(a.endpoint, b.endpoint) ||\n106\t        byCodeUnits(a.protocol, b.protocol) ||\n107\t        byCodeUnits(a.credential_env, b.credential_env)\n108\t}\n109\t\n110\t// The JSON value the approval hash covers: deduplicated, sorted\n111\t// destinations and the prompt overrides in projection order. Selectors\n112\t// and profile names are left out.\n113\texport function trustHashDocument (p:TrustProjection):HashDocument {\n114\t    const destinations:Destination[] = []\n115\t    for (const profile of p.profiles) {\n116\t        const d:Destination = {\n117\t            credential_env:profile.credentialEnv,\n118\t            endpoint:profile.endpoint,\n119\t            protocol:profile.protocol,\n120\t        }\n121\t        if (!destinations.some(x => compareDestinations(x, d) === 0)) {\n122\t            destinations.push(d)\n123\t        }\n124\t    }\n125\t    destinations.sort(compareDestinations)\n126\t    const prompts = p.promptOverrides.map(o => ({\n127\t        name:o.name,\n128\t        path:o.path,\n129\t    }))\n130\t    return { destinations, prompts }\n131\t}\n132\t\n133\t// `sha256:<hex>` over the canonical JSON of the hash document.\n134\texport function trustHash (p:TrustProjection):string {\n135\t    const text = canonicalJson(trustHashDocument(p))\n136\t    return 'sha256:' + createHash('sha256').update(text, 'utf8').digest('hex')\n137\t}\n138\t"}]},"parent_tool_use_id":null,"session_id":"fa31655d-debc-49e9-83c6-d8bc618478fe","uuid":"2f9a80a8-9293-47d3-b484-bbe56ef2fe82","timestamp":"2026-11-24T22:25:34.481Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-03-custom-endpoint-choice/src/config/trust.ts","content":"// The trust projection (ADR-0001) and approval hash v2 (ADR-0003, spec\n// 03 sections 2.2 to 2.4). Pure: no I/O.\nimport { createHash } from 'node:crypto'\nimport { canonicalJson } from './canonical.js'\nimport type { NormalizedProfile, ProjectConfig } from './load.js'\nimport { defaultBaseURL, providerAt } from './provider.js'\n\n// One profile a role or author route selects, reduced to where requests\n// go, how, and which variable supplies the credential.\nexport interface TrustedProfile {\n    // \"roles.finder\" or \"roles.finder.author_routes.<family>\".\n    selector:string;\n    profile:string;\n    // The endpoint as configured, or the protocol default; not normalized.\n    endpoint:string;\n    protocol:string;\n    // The profile's credential variable; '' when none applies.\n    credentialEnv:string;\n}\n\nexport interface PromptOverride {\n    // \"prompts.finder_code\", \"prompts.finder_prose\", or \"prompts.verifier\".\n    name:string;\n    // The raw string from the config, unresolved.\n    path:string;\n}\n\nexport interface TrustProjection {\n    profiles:TrustedProfile[];\n    promptOverrides:PromptOverride[];\n}\n\n// Type aliases, not interfaces, so the document is a CanonicalValue.\nexport type Destination = {\n    credential_env:string;\n    endpoint:string;\n    protocol:string;\n}\n\nexport type HashDocument = {\n    destinations:Destination[];\n    prompts:{ name:string, path:string }[];\n}\n\nconst PROMPT_NAMES = ['finder_code', 'finder_prose', 'verifier'] as const\n\nfunction byCodeUnits (a:string, b:string):number {\n    return a < b ? -1 : a > b ? 1 : 0\n}\n\nfunction profileEndpoint (p:NormalizedProfile):string {\n    return p.endpoint || defaultBaseURL(p.protocol)\n}\n\n// The profile's own credential variable, without the role override.\nfunction credentialEnv (p:NormalizedProfile):string {\n    if (p.api_key_env) return p.api_key_env\n    return providerAt(profileEndpoint(p), p.protocol)?.keyEnv ?? ''\n}\n\nexport function trustProjection (cfg:ProjectConfig):TrustProjection {\n    const profiles:TrustedProfile[] = []\n    const add = (selector:string, name:string|undefined):void => {\n        if (name === undefined) return\n        if (!Object.hasOwn(cfg.inference_profiles, name)) return\n        const p = cfg.inference_profiles[name]\n        profiles.push({\n            selector,\n            profile:name,\n            endpoint:profileEndpoint(p),\n            protocol:p.protocol,\n            credentialEnv:credentialEnv(p),\n        })\n    }\n    const roles = cfg.roles as Record<string, ProjectConfig['roles']['finder']>\n    for (const roleName of Object.keys(roles).sort(byCodeUnits)) {\n        const role = roles[roleName]\n        if (!role) continue\n        add(`roles.${roleName}`, role.profile)\n        const routes = role.author_routes ?? {}\n        for (const family of Object.keys(routes).sort(byCodeUnits)) {\n            add(`roles.${roleName}.author_routes.${family}`, routes[family])\n        }\n    }\n    const promptOverrides:PromptOverride[] = []\n    for (const name of PROMPT_NAMES) {\n        const path = cfg.prompts?.[name] ?? ''\n        if (path !== '') promptOverrides.push({ name:`prompts.${name}`, path })\n    }\n    return { profiles, promptOverrides }\n}\n\n// On a built-in provider's endpoint, with a protocol it accepts and its\n// standard key variable.\nfunction standard (p:TrustedProfile):boolean {\n    const provider = providerAt(p.endpoint, p.protocol)\n    return provider !== undefined && p.credentialEnv === provider.keyEnv\n}\n\nexport function requiresApproval (p:TrustProjection):boolean {\n    return p.promptOverrides.length > 0 || !p.profiles.every(standard)\n}\n\nfunction compareDestinations (a:Destination, b:Destination):number {\n    return byCodeUnits(a.endpoint, b.endpoint) ||\n        byCodeUnits(a.protocol, b.protocol) ||\n        byCodeUnits(a.credential_env, b.credential_env)\n}\n\n// The JSON value the approval hash covers: deduplicated, sorted\n// destinations and the prompt overrides in projection order. Selectors\n// and profile names are left out.\nexport function trustHashDocument (p:TrustProjection):HashDocument {\n    const destinations:Destination[] = []\n    for (const profile of p.profiles) {\n        const d:Destination = {\n            credential_env:profile.credentialEnv,\n            endpoint:profile.endpoint,\n            protocol:profile.protocol,\n        }\n        if (!destinations.some(x => compareDestinations(x, d) === 0)) {\n            destinations.push(d)\n        }\n    }\n    destinations.sort(compareDestinations)\n    const prompts = p.promptOverrides.map(o => ({\n        name:o.name,\n        path:o.path,\n    }))\n    return { destinations, prompts }\n}\n\n// `sha256:<hex>` over the canonical JSON of the hash document.\nexport function trustHash (p:TrustProjection):string {\n    const text = canonicalJson(trustHashDocument(p))\n    return 'sha256:' + createHash('sha256').update(text, 'utf8').digest('hex')\n}\n","numLines":138,"startLine":1,"totalLines":138}},"tool_result_meta":[{"id":"toolu_01Y3ki4wJ8bofeBkQ7pMnoqd","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
