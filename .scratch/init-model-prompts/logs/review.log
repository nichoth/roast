{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012d1pNb4VySHGxAyPxdYGmF","type":"tool_result","content":"1\timport { test } from '../helpers/test.js'\n2\timport { decode, normalize } from '../../src/config/load.js'\n3\timport {\n4\t    starter,\n5\t    starterFromModels,\n6\t    UnplaceableModelError,\n7\t} from '../../src/config/starter.js'\n8\timport type {\n9\t    RoleChoice, CustomChoice,\n10\t} from '../../src/config/starter.js'\n11\timport { thrown } from './helpers.js'\n12\timport {\n13\t    DEFAULT_LIMITS,\n14\t    SUGGESTED_MODELS,\n15\t} from '../../src/config/defaults.js'\n16\timport { gateOffers, snapshotEnabled } from '../../src/config/load.js'\n17\timport {\n18\t    GATE_DEFAULT_TIMEOUT,\n19\t    GATE_DEFAULT_SEVERITY,\n20\t} from '../../src/cli/gate.js'\n21\t\n22\ttest('starter places models and separates different models', t => {\n23\t    const cases:Array<[string, string, string, string, number]> = [\n24\t        ['', '', 'openai', 'anthropic', 2],\n25\t        ['claude-opus-5-5', 'gpt-5', 'anthropic', 'openai', 2],\n26\t        ['gpt-5', 'claude-sonnet-5-5', 'openai', 'anthropic', 2],\n27\t        ['claude-opus-5-5', '', 'anthropic', 'openai', 2],\n28\t        ['', 'gpt-5', 'anthropic', 'openai', 2],\n29\t        ['codex-mini-latest', '', 'openai', 'anthropic', 2],\n30\t        ['claude-x', 'claude-y', 'anthropic', 'anthropic', 2],\n31\t        ['gpt-5', 'gpt-5', 'openai', 'openai', 1],\n32\t        ['anthropic/claude-x', 'openai/gpt-5',\n33\t            'openrouter', 'openrouter', 2],\n34\t        ['meta-llama/llama-4:free', 'anthropic/claude-x',\n35\t            'openrouter', 'openrouter', 2],\n36\t        ['claude-x', 'openai/gpt-5', 'anthropic', 'openrouter', 2],\n37\t        ['anthropic/claude-x', 'gpt-5', 'openrouter', 'openai', 2],\n38\t        ['anthropic/claude-x', '', 'openrouter', 'openrouter', 2],\n39\t        ['', 'openai/gpt-5', 'openrouter', 'openrouter', 2],\n40\t        [' \\tgpt-5\\u0085', '', 'openai', 'anthropic', 2],\n41\t    ]\n42\t    const providers = {\n43\t        openai:['responses', 'https://api.openai.com/v1', 'OPENAI_API_KEY'],\n44\t        anthropic:['anthropic', 'https://api.anthropic.com/v1',\n45\t            'ANTHROPIC_API_KEY'],\n46\t        openrouter:['chat', 'https://openrouter.ai/api/v1',\n47\t            'OPENROUTER_API_KEY'],\n48\t    }\n49\t    for (const [finder, verifier, fAt, vAt, count] of cases) {\n50\t        const cfg = normalize(\n51\t            decode(starterFromModels(finder, verifier)), ''\n52\t        )\n53\t        t.equal(Object.keys(cfg.inference_profiles).length, count)\n54\t        for (const [role, at, model] of [\n55\t            ['finder', fAt, finder], ['verifier', vAt, verifier],\n56\t        ] as const) {\n57\t            const name = cfg.roles[role]!.profile\n58\t            const p = cfg.inference_profiles[name!]!\n59\t            t.deepEqual([p.protocol, p.endpoint, p.api_key_env],\n60\t                providers[at as keyof typeof providers])\n61\t            t.equal(p.model, model.trim().replace(/\\u0085$/, '') ||\n62\t                `<${role}-model>`)\n63\t        }\n64\t        if (finder !== verifier) {\n65\t            t.ok(cfg.roles.finder!.profile !== cfg.roles.verifier!.profile,\n66\t                'different models have different profiles')\n67\t        }\n68\t    }\n69\t})\n70\t\n71\ttest('starter gives default and OpenRouter profiles stable names', t => {\n72\t    for (const [f, v, names] of [\n73\t        ['', '', ['openai', 'anthropic']],\n74\t        ['anthropic/claude-x', 'openai/gpt-5',\n75\t            ['openrouter-finder', 'openrouter-verifier']],\n76\t    ] as const) {\n77\t        const cfg = normalize(decode(starterFromModels(f, v)), '')\n78\t        t.deepEqual(\n79\t            [\n80\t                cfg.roles.finder!.profile,\n81\t                cfg.roles.verifier!.profile,\n82\t            ],\n83\t            [...names]\n84\t        )\n85\t    }\n86\t})\n87\t\n88\ttest('starter rejects unplaceable IDs with role and trimmed model', t => {\n89\t    for (const model of [\n90\t        'gemini-2.5-pro', 'some-model', 'openai',\n91\t        'claude-opus-5-5[1m]', 'openai:api', 'Claude-Opus-5-5',\n92\t        'claude-x@2024', 'gpt-5 mini', 'Anthropic/claude-opus-5-5',\n93\t        'anthropic/Claude-Opus-5-5', 'anthropic/ claude-opus-5-5',\n94\t        'anthropic/claude-opus-5-5[1m]', 'openai/gpt-5:api',\n95\t        'anthropic/anthropic', 'google/gemini', 'openai/', '/gpt-5',\n96\t        'openai/gpt-5/mini', 'meta-llama/llama-4:',\n97\t    ]) {\n98\t        for (const role of ['finder', 'verifier']) {\n99\t            const err = thrown(() => starterFromModels(\n100\t                role === 'finder' ? ` ${model} ` : '',\n101\t                role === 'verifier' ? ` ${model} ` : ''\n102\t            ))\n103\t            t.ok(err instanceof UnplaceableModelError)\n104\t            if (!(err instanceof UnplaceableModelError)) continue\n105\t            t.equal(err.role, role)\n106\t            t.equal(err.model, model)\n107\t        }\n108\t    }\n109\t    const first = thrown(() => starterFromModels(\n110\t        'invalid-finder', 'invalid-verifier'\n111\t    ))\n112\t    t.equal((first as UnplaceableModelError).role, 'finder')\n113\t})\n114\t\n115\ttest('suggested model constants exist for each built-in provider', t => {\n116\t    t.ok(SUGGESTED_MODELS.anthropic, 'anthropic suggested model')\n117\t    t.ok(SUGGESTED_MODELS.openai, 'openai suggested model')\n118\t    t.ok(SUGGESTED_MODELS.openrouter, 'openrouter suggested models')\n119\t    t.equal(SUGGESTED_MODELS.anthropic, 'claude-opus-5-5')\n120\t    t.equal(SUGGESTED_MODELS.openai, 'gpt-6.1-terra')\n121\t    t.ok(\n122\t        SUGGESTED_MODELS.openrouter.includes(\n123\t            'anthropic/claude-opus-5-5'\n124\t        ),\n125\t        'openrouter has anthropic slug'\n126\t    )\n127\t    t.ok(\n128\t        SUGGESTED_MODELS.openrouter.includes(\n129\t            'openai/gpt-6.1-terra'\n130\t        ),\n131\t        'openrouter has openai slug'\n132\t    )\n133\t})\n134\t\n135\ttest('starter accepts RoleChoice per role', t => {\n136\t    const finder:RoleChoice = {\n137\t        provider:'openai', model:'gpt-5'\n138\t    }\n139\t    const verifier:RoleChoice = {\n140\t        provider:'anthropic', model:'claude-opus-5-5'\n141\t    }\n142\t    const cfg = normalize(decode(starter(finder, verifier)), '')\n143\t    const fp = cfg.inference_profiles[cfg.roles.finder!.profile!]!\n144\t    const vp = cfg.inference_profiles[cfg.roles.verifier!.profile!]!\n145\t    t.equal(fp.model, 'gpt-5')\n146\t    t.equal(vp.model, 'claude-opus-5-5')\n147\t    t.equal(fp.endpoint, 'https://api.openai.com/v1')\n148\t    t.equal(vp.endpoint, 'https://api.anthropic.com/v1')\n149\t})\n150\t\n151\ttest('starterFromModels produces same output as old starter', t => {\n152\t    const cases:[string, string][] = [\n153\t        ['', ''],\n154\t        ['claude-opus-5-5', 'gpt-5'],\n155\t        ['gpt-5', 'claude-sonnet-5-5'],\n156\t        ['claude-opus-5-5', ''],\n157\t        ['', 'gpt-5'],\n158\t        ['anthropic/claude-x', 'openai/gpt-5'],\n159\t    ]\n160\t    for (const [f, v] of cases) {\n161\t        const cfg = normalize(\n162\t            decode(starterFromModels(f, v)), ''\n163\t        )\n164\t        const fp = cfg.inference_profiles[\n165\t            cfg.roles.finder!.profile!\n166\t        ]!\n167\t        const vp = cfg.inference_profiles[\n168\t            cfg.roles.verifier!.profile!\n169\t        ]!\n170\t        t.ok(fp.model, `finder model set for [${f}, ${v}]`)\n171\t        t.ok(vp.model, `verifier model set for [${f}, ${v}]`)\n172\t    }\n173\t})\n174\t\n175\ttest('UnplaceableModelError uses suggested model constants', t => {\n176\t    const err = new UnplaceableModelError('finder', 'bad-model')\n177\t    t.ok(\n178\t        err.message.includes(SUGGESTED_MODELS.anthropic),\n179\t        'mentions anthropic suggested model'\n180\t    )\n181\t    t.ok(\n182\t        err.message.includes(\n183\t            SUGGESTED_MODELS.openrouter[0]!\n184\t        ),\n185\t        'mentions openrouter suggested model'\n186\t    )\n187\t})\n188\t\n189\ttest('starter custom profile with api_key_env loads correctly',\n190\t    t => {\n191\t        const finder:CustomChoice = {\n192\t            kind:'custom',\n193\t            endpoint:'http://openai.api.tiiny/v1',\n194\t            protocol:'chat',\n195\t            apiKeyEnv:'TIINY_KEY',\n196\t            model:'Qwen/Qwen3.6-35B-A3B',\n197\t        }\n198\t        const verifier:RoleChoice = {\n199\t            provider:'anthropic', model:'claude-opus-5-5'\n200\t        }\n201\t        const cfg = normalize(decode(starter(finder, verifier)), '')\n202\t        const fp = cfg.inference_profiles[\n203\t            cfg.roles.finder!.profile!\n204\t        ]!\n205\t        t.equal(fp.endpoint,\n206\t            'http://openai.api.tiiny/v1')\n207\t        t.equal(fp.protocol, 'chat')\n208\t        t.equal(fp.api_key_env, 'TIINY_KEY')\n209\t        t.equal(fp.model, 'Qwen/Qwen3.6-35B-A3B')\n210\t        t.equal(cfg.roles.finder!.profile, 'custom')\n211\t    })\n212\t\n213\ttest('starter custom profile without api_key_env loads correctly',\n214\t    t => {\n215\t        const finder:CustomChoice = {\n216\t            kind:'custom',\n217\t            endpoint:'http://openai.api.tiiny/v1',\n218\t            protocol:'chat',\n219\t            apiKeyEnv:'',\n220\t            model:'openai/gpt-oss-20b',\n221\t        }\n222\t        const verifier:RoleChoice = {\n223\t            provider:'openai', model:'gpt-5'\n224\t        }\n225\t        const cfg = normalize(decode(starter(finder, verifier)), '')\n226\t        const fp = cfg.inference_profiles[\n227\t            cfg.roles.finder!.profile!\n228\t        ]!\n229\t        t.equal(fp.endpoint,\n230\t            'http://openai.api.tiiny/v1')\n231\t        t.equal(fp.protocol, 'chat')\n232\t        t.equal(fp.api_key_env, undefined)\n233\t        t.equal(fp.model, 'openai/gpt-oss-20b')\n234\t    })\n235\t\n236\ttest('starter two custom roles different settings split names',\n237\t    t => {\n238\t        const finder:CustomChoice = {\n239\t            kind:'custom',\n240\t            endpoint:'http://openai.api.tiiny/v1',\n241\t            protocol:'chat',\n242\t            apiKeyEnv:'TIINY_KEY',\n243\t            model:'Qwen/Qwen3.6-35B-A3B',\n244\t        }\n245\t        const verifier:CustomChoice = {\n246\t            kind:'custom',\n247\t            endpoint:'http://localhost:8080/v1',\n248\t            protocol:'responses',\n249\t            apiKeyEnv:'LOCAL_KEY',\n250\t            model:'my-model',\n251\t        }\n252\t        const cfg = normalize(\n253\t            decode(starter(finder, verifier)), ''\n254\t        )\n255\t        t.equal(cfg.roles.finder!.profile,\n256\t            'custom-finder')\n257\t        t.equal(cfg.roles.verifier!.profile,\n258\t            'custom-verifier')\n259\t        const fp = cfg.inference_profiles['custom-finder']!\n260\t        const vp = cfg.inference_profiles['custom-verifier']!\n261\t        t.equal(fp.endpoint,\n262\t            'http://openai.api.tiiny/v1')\n263\t        t.equal(vp.endpoint,\n264\t            'http://localhost:8080/v1')\n265\t    })\n266\t\n267\ttest('starter two identical custom roles share custom name',\n268\t    t => {\n269\t        const choice:CustomChoice = {\n270\t            kind:'custom',\n271\t            endpoint:'http://openai.api.tiiny/v1',\n272\t            protocol:'chat',\n273\t            apiKeyEnv:'TIINY_KEY',\n274\t            model:'Qwen/Qwen3.6-35B-A3B',\n275\t        }\n276\t        const cfg = normalize(\n277\t            decode(starter(choice, choice)), ''\n278\t        )\n279\t        t.equal(cfg.roles.finder!.profile, 'custom')\n280\t        t.equal(cfg.roles.verifier!.profile, 'custom')\n281\t        t.equal(\n282\t            Object.keys(cfg.inference_profiles).length, 1\n283\t        )\n284\t    })\n285\t\n286\ttest('starter comments agree with runtime defaults', t => {\n287\t    const body = starterFromModels('', '')\n288\t    const comments = body.split('\\n').filter(line =>\n289\t        /^ {2}\\/\\/ (?: *\"| *})/.test(line))\n290\t        .map(line => line.slice(5)).join('\\n')\n291\t    // Only object-property comments are executable JSONC when uncommented.\n292\t    const blocks = comments.slice(comments.indexOf('\"review\":'))\n293\t    const raw = decode('{\"version\":1,' + blocks + '}')\n294\t    const cfg = normalize(decode(body), '')\n295\t    t.deepEqual({ ...raw.limits }, {\n296\t        deadline:'10m',\n297\t        request_timeout:'10m',\n298\t        max_total_tokens:3000000,\n299\t        max_diff_bytes:1000000,\n300\t        max_prompt_bytes:8000000,\n301\t        max_file_ctx_bytes:400000,\n302\t        max_attempts:4,\n303\t        max_verified:25,\n304\t    })\n305\t    t.deepEqual({ ...raw.limits }, DEFAULT_LIMITS)\n306\t    t.equal(raw.review!.confidence_floor, cfg.review.confidence_floor)\n307\t    t.equal(raw.review!.quick_confidence_floor,\n308\t        cfg.review.quick_confidence_floor)\n309\t    t.equal(raw.review!.snapshot, snapshotEnabled(cfg))\n310\t    t.equal(raw.gate!.offer, gateOffers(cfg))\n311\t    t.equal(raw.gate!.timeout_seconds, GATE_DEFAULT_TIMEOUT)\n312\t    t.equal(raw.gate!.severity, GATE_DEFAULT_SEVERITY)\n313\t})\n314\t"}]},"parent_tool_use_id":"toolu_01NoWnxGniRCCzNW5rfoVfsx","agent_id":"adc0a41f1fc4a8870","session_id":"84d06975-53aa-44e0-a4d2-4df63462776f","uuid":"e12b6d0e-9061-4e92-b2d7-e57564dec0c5","timestamp":"2026-11-24T23:28:13.206Z","tool_result_meta":[{"id":"toolu_012d1pNb4VySHGxAyPxdYGmF","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"fork","task_description":"Read and analyze test diffs"}
