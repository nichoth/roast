in c && c.kind === 'custom'\n+}\n+\n const TEMPLATE =\n     `// Roast project config. Commit this file. It holds every setting except\n // credentials, which come from \"npx roast login\" or environment variables.\n@@ -85,7 +107,8 @@ export function placeModel (model:string):string|null {\n     }\n     if (!/^[a-z0-9][a-z0-9._-]*$/.test(model)) return null\n     const family = inferFamily(model)\n-    return lookupProvider(family) && !isFamilyName(model) ? family : null\n+    return lookupProvider(family) && !isFamilyName(model) ?\n+        family : null\n }\n \n export class UnplaceableModelError extends Error {\n@@ -93,17 +116,20 @@ export class UnplaceableModelError extends Error {\n     readonly model:string\n \n     constructor (role:'finder'|'verifier', model:string) {\n-        super(`${role} model ${goQuote(model)} is not a model ID init ` +\n-            'can place: use a bare OpenAI or Anthropic model ID ' +\n-            '(claude-opus-5-5), or OpenRouter\\'s <vendor>/<model> form ' +\n-            '(anthropic/claude-opus-5-5). For another provider, edit ' +\n-            'inference_profiles in .roast.json')\n+        super(\n+            `${role} model ${goQuote(model)} is not a ` +\n+            'model ID init can place: use a bare OpenAI or ' +\n+            `Anthropic model ID (${SUGGESTED_MODELS.anthropic})` +\n+            ', or OpenRouter\\'s <vendor>/<model> form ' +\n+            `(${SUGGESTED_MODELS.openrouter[0]}). For another` +\n+            ' provider, edit inference_profiles in .roast.json'\n+        )\n         this.role = role\n         this.model = model\n     }\n }\n \n-function otherProvider (provider:string):string {\n+export function otherProvider (provider:string):string {\n     if (provider === 'openrouter') return 'openrouter'\n     return provider === 'openai' ? 'anthropic' : 'openai'\n }\n@@ -120,30 +146,129 @@ function starterProfile (\n         '    }'\n }\n \n-export function starter (finderModel:string, verifierModel:string):string {\n-    finderModel = goTrimSpace(finderModel)\n-    verifierModel = goTrimSpace(verifierModel)\n-    const finderAt = finderModel ? placeModel(finderModel) : 'openai'\n-    if (!finderAt) throw new UnplaceableModelError('finder', finderModel)\n-    const verifierAt = verifierModel ? placeModel(verifierModel) : 'anthropic'\n-    if (!verifierAt) {\n-        throw new UnplaceableModelError('verifier', verifierModel)\n+function customProfile (\n+    name:string, c:CustomChoice, model:string\n+):string {\n+    const lines = [\n+        `    ${JSON.stringify(name)}: {`,\n+        `      \"endpoint\": ${JSON.stringify(c.endpoint)},`,\n+        `      \"protocol\": ${JSON.stringify(c.protocol)},`,\n+    ]\n+    if (c.apiKeyEnv !== '') {\n+        lines.push(\n+            '      \"api_key_env\": ' +\n+            `${JSON.stringify(c.apiKeyEnv)},`\n+        )\n+    }\n+    lines.push(\n+        `      \"model\": ${JSON.stringify(model)}`,\n+        '    }'\n+    )\n+    return lines.join('\\n')\n+}\n+\n+function sameCustom (a:CustomChoice, b:CustomChoice):boolean {\n+    return a.endpoint === b.endpoint &&\n+        a.protocol === b.protocol &&\n+        a.apiKeyEnv === b.apiKeyEnv\n+}\n+\n+function renderProfile (\n+    name:string, choice:StarterChoice, model:string\n+):string {\n+    if (isCustomChoice(choice)) {\n+        return customProfile(name, choice, model)\n     }\n-    const fAt = !finderModel && verifierModel ?\n-        otherProvider(verifierAt) : finderAt\n-    const vAt = !verifierModel && finderModel ?\n-        otherProvider(finderAt) : verifierAt\n-    finderModel ||= PLACEHOLDER_FINDER_MODEL\n-    verifierModel ||= PLACEHOLDER_VERIFIER_MODEL\n-    const separate = fAt === vAt && finderModel !== verifierModel\n-    const fName = fAt + (separate ? '-finder' : '')\n-    const vName = vAt + (separate ? '-verifier' : '')\n-    const profiles = [starterProfile(fName, fAt, finderModel)]\n+    return starterProfile(name, choice.provider, model)\n+}\n+\n+function profileNames (\n+    finder:StarterChoice,\n+    verifier:StarterChoice,\n+    finderModel:string,\n+    verifierModel:string\n+):[string, string] {\n+    const fCustom = isCustomChoice(finder)\n+    const vCustom = isCustomChoice(verifier)\n+    if (fCustom && vCustom) {\n+        const same = sameCustom(finder, verifier)\n+        if (same && finderModel === verifierModel) {\n+            return ['custom', 'custom']\n+        }\n+        if (same) {\n+            return ['custom-finder', 'custom-verifier']\n+        }\n+        return ['custom-finder', 'custom-verifier']\n+    }\n+    if (fCustom) {\n+        return ['custom', (verifier as RoleChoice).provider]\n+    }\n+    if (vCustom) {\n+        return [(finder as RoleChoice).provider, 'custom']\n+    }\n+    const fAt = (finder as RoleChoice).provider\n+    const vAt = (verifier as RoleChoice).provider\n+    const separate = fAt === vAt &&\n+        finderModel !== verifierModel\n+    return [\n+        fAt + (separate ? '-finder' : ''),\n+        vAt + (separate ? '-verifier' : ''),\n+    ]\n+}\n+\n+export function starter (\n+    finder:StarterChoice, verifier:StarterChoice\n+):string {\n+    const finderModel = finder.model || PLACEHOLDER_FINDER_MODEL\n+    const verifierModel = verifier.model ||\n+        PLACEHOLDER_VERIFIER_MODEL\n+    const [fName, vName] = profileNames(\n+        finder, verifier, finderModel, verifierModel\n+    )\n+    const profiles","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/nick/.claude/projects/-Users-nick-code-roast-review/84d06975-53aa-44e0-a4d2-4df63462776f/tool-results/bjjmnxt45.txt","persistedOutputSize":68285},"tool_result_meta":[{"id":"toolu_01QyfbAQGL2WwFVrp6sSZFzy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
