l, 'claude-opus-5-5')\n        t.equal(finder.baseURL,\n            'https://api.anthropic.com/v1')\n        const verifier = resolveRole(cfg, 'verifier', {\n            OPENAI_API_KEY:'k',\n        })\n        t.equal(verifier.model, 'gpt-5')\n        t.equal(verifier.baseURL,\n            'https://api.openai.com/v1')\n    })"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":742,"cache_read_input_tokens":75443,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":742},"output_tokens":1,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"814e505e-c3f6-40bd-873f-c494d2caa400","uuid":"fc04f9d0-c7ad-4dbf-9ad6-f0f28afe48ae","timestamp":"2026-11-24T21:46:05.809Z","request_id":"req_011ChNV8msqc5exEjDYVfLUt","wire_tool_inputs":{"toolu_01Rid6AVKiZmyDe9CjmHPCKd":{"file_path":"/Users/nick/code/roast.init-model-prompts-02-builtin-provider-prompts/test/cli/init.ts","old_string":"test('init skips offers when roles already have credentials', async t => {\n    const r = await initLoginRepo(t, true)\n    const result = await r.run('y\\nunused\\n', [], {\n        ...r.repo.env,\n        OPENAI_API_KEY:'available-openai',\n        ANTHROPIC_API_KEY:'available-anthropic',\n    })\n    t.equal(result.code, 0)\n    t.ok(!result.stderr.includes('[Y/n]'))\n    t.deepEqual(r.opened, [])\n    t.equal(r.server.requests.length, 0)\n    t.ok(!fs.existsSync(r.project))\n    t.ok(!fs.existsSync(r.user))\n})","new_string":"test('init skips offers when roles already have credentials', async t => {\n    const r = await initLoginRepo(t, true)\n    const result = await r.run('y\\nunused\\n', [], {\n        ...r.repo.env,\n        OPENAI_API_KEY:'available-openai',\n        ANTHROPIC_API_KEY:'available-anthropic',\n    })\n    t.equal(res