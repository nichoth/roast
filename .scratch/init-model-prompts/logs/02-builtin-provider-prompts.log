{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TVvdLci63SHuXf2oecNLpn","type":"tool_result","content":"1\t// The environment tests build `io.env` from (spec 01, 3.7).\n2\t\n3\tconst AMBIENT_PREFIXES = ['ANTHROPIC_', 'OPENAI_', 'OPENROUTER_', 'ROAST_']\n4\t\n5\t// A copy of `base` without any variable whose upper-cased name starts\n6\t// with ANTHROPIC_, OPENAI_, OPENROUTER_, or ROAST_.\n7\texport function cleanEnv (\n8\t    base:Readonly<Record<string, string|undefined>>\n9\t):Record<string, string> {\n10\t    const env:Record<string, string> = {}\n11\t    for (const [key, value] of Object.entries(base)) {\n12\t        if (value === undefined) continue\n13\t        const upper = key.toUpperCase()\n14\t        if (AMBIENT_PREFIXES.some(p => upper.startsWith(p))) continue\n15\t        env[key] = value\n16\t    }\n17\t    return env\n18\t}\n19\t"}]},"parent_tool_use_id":null,"session_id":"814e505e-c3f6-40bd-873f-c494d2caa400","uuid":"4075de45-c4f9-48a9-b6ec-228a05f35fe9","timestamp":"2026-11-24T21:45:02.145Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-02-builtin-provider-prompts/test/helpers/env.ts","content":"// The environment tests build `io.env` from (spec 01, 3.7).\n\nconst AMBIENT_PREFIXES = ['ANTHROPIC_', 'OPENAI_', 'OPENROUTER_', 'ROAST_']\n\n// A copy of `base` without any variable whose upper-cased name starts\n// with ANTHROPIC_, OPENAI_, OPENROUTER_, or ROAST_.\nexport function cleanEnv (\n    base:Readonly<Record<string, string|undefined>>\n):Record<string, string> {\n    const env:Record<string, string> = {}\n    for (const [key, value] of Object.entries(base)) {\n        if (value === undefined) continue\n        const upper = key.toUpperCase()\n        if (AMBIENT_PREFIXES.some(p => upper.startsWith(p))) continue\n        env[key] = value\n    }\n    return env\n}\n","numLines":19,"startLine":1,"totalLines":19}},"tool_result_meta":[{"id":"toolu_01TVvdLci63SHuXf2oecNLpn","per