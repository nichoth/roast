{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K99K7tF8RFU8e7PEsie3gE","type":"tool_result","content":"1\timport { PassThrough, Writable } from 'node:stream'\n2\t\n3\t// A writable that keeps everything written to it.\n4\texport class BufferStream extends Writable {\n5\t    chunks:Buffer[] = []\n6\t\n7\t    _write (\n8\t        chunk:Buffer|string,\n9\t        _enc:BufferEncoding,\n10\t        done:(err?:Error|null) => void\n11\t    ):void {\n12\t        this.chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk))\n13\t        done()\n14\t    }\n15\t\n16\t    text ():string {\n17\t        return Buffer.concat(this.chunks).toString('utf8')\n18\t    }\n19\t}\n20\t\n21\t// A readable stdin fed with fixed text, then EOF.\n22\texport function inputStream (text = ''):NodeJS.ReadableStream {\n23\t    const s = new PassThrough()\n24\t    s.end(text)\n25\t    return s\n26\t}\n27\t"}]},"parent_tool_use_id":null,"session_id":"814e505e-c3f6-40bd-873f-c494d2caa400","uuid":"4abf232a-59b0-45c6-849e-6d47b54b3c20","timestamp":"2026-11-24T21:45:01.568Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-02-builtin-provider-prompts/test/helpers/streams.ts","content":"import { PassThrough, Writable } from 'node:stream'\n\n// A writable that keeps everything written to it.\nexport class BufferStream extends Writable {\n    chunks:Buffer[] = []\n\n    _write (\n        chunk:Buffer|string,\n        _enc:BufferEncoding,\n        done:(err?:Error|null) => void\n    ):void {\n        this.chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk))\n        done()\n    }\n\n    text ():string {\n        return Buffer.concat(this.chunks).toString('utf8')\n    }\n}\n\n// A readable stdin fed with fixed text, then EOF.\nexport function inputStream (text = ''):NodeJS.ReadableStream {\n    const s = new PassThrough()\n    s.end(text)\n    return s\n}\n","numLines":27,"startLine":1,"totalLines":27}},"tool_result_