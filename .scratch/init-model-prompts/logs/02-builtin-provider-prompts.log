{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QM5MUcJ7qZCSPv4xLaMYhX","type":"tool_result","content":"1\t// Swaps the terminal hooks for a test and restores them at test end.\n2\timport { terminalHooks } from '../../src/cli/terminal.js'\n3\t\n4\tinterface Cleanup {\n5\t    cleanup (fn:() => void):void;\n6\t}\n7\t\n8\t// Makes interactiveTerminals answer `value` until the test ends.\n9\texport function simulateTerminals (t:Cleanup, value:boolean):void {\n10\t    const saved = terminalHooks.interactiveTerminals\n11\t    terminalHooks.interactiveTerminals = () => value\n12\t    t.cleanup(() => { terminalHooks.interactiveTerminals = saved })\n13\t}\n14\t\n15\t// Replaces openBrowser with a recorder; returns the URLs it was asked to\n16\t// open. Nothing is launched.\n17\texport function captureBrowser (t:Cleanup, error?:Error):string[] {\n18\t    const saved = terminalHooks.openBrowser\n19\t    const opened:string[] = []\n20\t    terminalHooks.openBrowser = async url => {\n21\t        opened.push(url)\n22\t        return error\n23\t    }\n24\t    t.cleanup(() => { terminalHooks.openBrowser = saved })\n25\t    return opened\n26\t}\n27\t"}]},"parent_tool_use_id":null,"session_id":"814e505e-c3f6-40bd-873f-c494d2caa400","uuid":"5e662e8f-8234-4a34-8ec9-221adc017601","timestamp":"2026-11-24T21:44:50.507Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-02-builtin-provider-prompts/test/helpers/terminal.ts","content":"// Swaps the terminal hooks for a test and restores them at test end.\nimport { terminalHooks } from '../../src/cli/terminal.js'\n\ninterface Cleanup {\n    cleanup (fn:() => void):void;\n}\n\n// Makes interactiveTerminals answer `value` until the test ends.\nexport function simulateTerminals (t:Cleanup, value:boolean):void {\n    const saved = terminalHooks.interactiveTerminals\n    terminalHooks.interactiveTerminals = () => value\n    t.cleanup(() => { terminalHooks.interactiveTerminals = saved })\n}\n\n// Replaces openBrowser with a recorder; returns the URLs it was asked to\n// open. Nothing is launched.\nexport function captureBrowser (t:Cleanup, error?:Error):string[] {\n    const saved = terminalHooks.openBrowser\n    const opened:string[] = []\n    terminalHooks.openBrowser = async url => {\n        opened.push(url)\n        return error\n    }\n    t.cleanup(() => { terminalHooks.openBrowser = saved })\n    return opened\n}\n","numLines":27,"startLine":1,"totalLines":27}},"tool_result_meta":[{"id":"toolu_01QM5MUcJ7qZCSPv4xLaMYhX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
