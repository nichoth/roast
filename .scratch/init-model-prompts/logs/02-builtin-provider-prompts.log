{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VBLNcpXo8FEy8VtYVLC9ZV","type":"tool_result","content":"1\t// Temporary directories and Git repositories for CLI tests, with an\n2\t// environment that isolates the user's home and config directories and\n3\t// gives Git an identity (CI runners have none).\n4\timport { execFileSync } from 'node:child_process'\n5\timport fs from 'node:fs'\n6\timport os from 'node:os'\n7\timport path from 'node:path'\n8\timport { cleanEnv } from './env.js'\n9\t\n10\texport interface TempDir {\n11\t    dir:string;\n12\t    env:Record<string, string>;\n13\t    remove ():void;\n14\t}\n15\t\n16\tfunction makeTemp (prefix:string):string {\n17\t    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n18\t}\n19\t\n20\t// The base test environment: the process env without provider or roast\n21\t// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside\n22\t// `root`, a Git identity, and no Git discovery above `root`.\n23\texport function isolatedEnv (root:string):Record<string, string> {\n24\t    const home = path.join(root, '.home')\n25\t    fs.mkdirSync(home, { recursive:true })\n26\t    return {\n27\t        ...cleanEnv(process.env),\n28\t        HOME:home,\n29\t        XDG_CONFIG_HOME:path.join(home, '.config'),\n30\t        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n31\t        GIT_AUTHOR_NAME:'Roast Test',\n32\t        GIT_AUTHOR_EMAIL:'roast-test@example.com',\n33\t        GIT_COMMITTER_NAME:'Roast Test',\n34\t        GIT_COMMITTER_EMAIL:'roast-test@example.com',\n35\t        GIT_CEILING_DIRECTORIES:path.dirname(root),\n36\t        GIT_CONFIG_NOSYSTEM:'1',\n37\t    }\n38\t}\n39\t\n40\t// A temporary directory that is not inside any Git repository. The test\n41\t// working directory is `dir/work`.\n42\texport function tempDir (prefix = 'roast-dir-'):TempDir {\n43\t    const root = makeTemp(prefix)\n44\t    const dir = path.join(root, 'work')\n45\t    fs.mkdirSync(dir)\n46\t    return {\n47\t        dir,\n48\t        env:isolatedEnv(root),\n49\t        remove:() => fs.rmSync(root, { recursive:true, force:true }),\n50\t    }\n51\t}\n52\t\n53\t// A temporary Git repository at `dir` (realpath, so it compares equal to\n54\t// what Git prints).\n55\texport function tempRepo (prefix = 'roast-repo-'):TempDir {\n56\t    const t = tempDir(prefix)\n57\t    execFileSync('git', ['init', '-q', t.dir], { env:t.env })\n58\t    return t\n59\t}\n60\t"}]},"parent_tool_use_id":null,"session_id":"814e505e-c3f6-40bd-873f-c494d2caa400","uuid":"8a7d7e06-d25f-42bc-9244-012c17e0cd66","timestamp":"2026-11-24T21:45:00.981Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-02-builtin-provider-prompts/test/helpers/repo.ts","content":"// Temporary directories and Git repositories for CLI tests, with an\n// environment that isolates the user's home and config directories and\n// gives Git an identity (CI runners have none).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { cleanEnv } from './env.js'\n\nexport interface TempDir {\n    dir:string;\n    env:Record<string, string>;\n    remove ():void;\n}\n\nfunction makeTemp (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\n// The base test environment: the process env without provider or roast\n// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside\n// `root`, a Git identity, and no Git discovery above `root`.\nexport function isolatedEnv (root:string):Record<string, string> {\n    const home = path.join(root, '.home')\n    fs.mkdirSync(home, { recursive:true })\n    return {\n        ...cleanEnv(process.env),\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n        GIT_AUTHOR_NAME:'Roast Test',\n        GIT_AUTHOR_EMAIL:'roast-test@example.com',\n        GIT_COMMITTER_NAME:'Roast Test',\n        GIT_COMMITTER_EMAIL:'roast-test@example.com',\n        GIT_CEILING_DIRECTORIES:path.dirname(root),\n        GIT_CONFIG_NOSYSTEM:'1',\n    }\n}\n\n// A temporary directory that is not inside any Git repository. The test\n// working directory is `dir/work`.\nexport function tempDir (prefix = 'roast-dir-'):TempDir {\n    const root = makeTemp(prefix)\n    const dir = path.join(root, 'work')\n    fs.mkdirSync(dir)\n    return {\n        dir,\n        env:isolatedEnv(root),\n        remove:() => fs.rmSync(root, { recursive:true, force:true }),\n    }\n}\n\n// A temporary Git repository at `dir` (realpath, so it compares equal to\n// what Git prints).\nexport function tempRepo (prefix = 'roast-repo-'):TempDir {\n    const t = tempDir(prefix)\n    execFileSync('git', ['init', '-q', t.dir], { env:t.env })\n    return t\n}\n","numLines":60,"startLine":1,"totalLines":60}},"tool_result_meta":[{"id":"toolu_01VBLNcpXo8FEy8VtYVLC9ZV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
