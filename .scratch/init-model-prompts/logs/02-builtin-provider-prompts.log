ored,\n    }\n    const { key, source } = resolveCredential(roleName, p.api_key_env ?? '',\n        located, env)\n    return makeRole({\n        ...located,\n        profile:profileName,\n        explicitEndpoint:Boolean(p.endpoint),\n        apiKey:key,\n        model:p.model ?? '',\n        maxOutputTokens:p.max_output_tokens,\n        sessionHeader:p.session_header ?? '',\n        pin:selection.pin ?? false,\n        authorRoutes:routes,\n        credential:Object.freeze(source),\n    })","numLines":60,"startLine":1,"totalLines":217}},"tool_result_meta":[{"id":"toolu_01AbKTmYru3fWbp6pt22UUGY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
