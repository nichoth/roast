{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0162CZ9XvpxmJDXTw9Egev7J","type":"tool_result","content":"1\t// Shared terminal helpers (spec 01, 2.16): yes/no prompt, secret input,\n2\t// terminal detection, browser opening. Terminal detection and browser\n3\t// opening are swappable through `terminalHooks` so tests never touch a\n4\t// real terminal or launch a browser.\n5\timport { spawn } from 'node:child_process'\n6\timport { isatty } from 'node:tty'\n7\timport { goTrimSpace } from '../gocompat/strings.js'\n8\timport { CancelledError } from './errors.js'\n9\t\n10\t// Reads a stream one character or line at a time. One reader serves every\n11\t// prompt in a command, so input buffered past one answer is kept for the\n12\t// next. The stream is attached lazily, on the first read.\n13\texport class LineReader {\n14\t    private readonly stream:NodeJS.ReadableStream\n15\t    private buf = ''\n16\t    private ended = false\n17\t    private error:Error|undefined\n18\t    private attached = false\n19\t    private wake:(() => void)|undefined\n20\t\n21\t    constructor (stream:NodeJS.ReadableStream) {\n22\t        this.stream = stream\n23\t    }\n24\t\n25\t    private attach ():void {\n26\t        if (this.attached) return\n27\t        this.attached = true\n28\t        const notify = ():void => {\n29\t            const w = this.wake\n30\t            this.wake = undefined\n31\t            w?.()\n32\t        }\n33\t        this.stream.setEncoding('utf8')\n34\t        this.stream.on('data', (chunk:string) => {\n35\t            this.buf += chunk\n36\t            notify()\n37\t        })\n38\t        this.stream.on('end', () => {\n39\t            this.ended = true\n40\t            notify()\n41\t        })\n42\t        this.stream.on('error', (err:Error) => {\n43\t            this.error = err\n44\t            notify()\n45\t        })\n46\t    }\n47\t\n48\t    // Waits until the buffer holds data, the stream ended, or failed.\n49\t    private async fill ():Promise<void> {\n50\t        this.attach()\n51\t        while (this.buf === '' && !this.ended && !this.error) {\n52\t            this.stream.resume()\n53\t            await new Promise<void>(resolve => { this.wake = resolve })\n54\t        }\n55\t        this.stream.pause()\n56\t        if (this.buf === '' && this.error) throw this.error\n57\t    }\n58\t\n59\t    // The next character, or null at end of input.\n60\t    async readChar ():Promise<string|null> {\n61\t        await this.fill()\n62\t        if (this.buf === '') return null\n63\t        const c = String.fromCodePoint(this.buf.codePointAt(0) as number)\n64\t        this.buf = this.buf.slice(c.length)\n65\t        return c\n66\t    }\n67\t\n68\t    // The next line without its line ending, or null at end of input with\n69\t    // nothing read. A last line without a newline is returned as is.\n70\t    async readLine ():Promise<string|null> {\n71\t        let line = ''\n72\t        for (;;) {\n73\t            await this.fill()\n74\t            if (this.buf === '') return line === '' ? null : line\n75\t            const i = this.buf.indexOf('\\n')\n76\t            if (i >= 0) {\n77\t                line += this.buf.slice(0, i)\n78\t                this.buf = this.buf.slice(i + 1)\n79\t                return line.endsWith('\\r') ? line.slice(0, -1) : line\n80\t            }\n81\t            line += this.buf\n82\t            this.buf = ''\n83\t        }\n84\t    }\n85\t}\n86\t\n87\t// Writes `<question> [Y/n] ` and reads one answer: empty, y, or yes (any\n88\t// case) is true; anything else, or end of input, is false.\n89\texport async function promptYesDefault (\n90\t    out:NodeJS.WritableStream,\n91\t    lines:LineReader,\n92\t    question:string\n93\t):Promise<boolean> {\n94\t    out.write(`${question} [Y/n] `)\n95\t    const answer = await lines.readLine()\n96\t    if (answer === null) return false\n97\t    const a = goTrimSpace(answer).toLowerCase()\n98\t    return a === '' || a === 'y' || a === 'yes'\n99\t}\n100\t\n101\t// Writes `<question> [y/N] ` and reads one answer: only y or yes (any\n102\t// case, surrounding space ignored) is true; empty input, anything else,\n103\t// or end of input is false.\n104\texport async function promptNoDefault (\n105\t    out:NodeJS.WritableStream,\n106\t    lines:LineReader,\n107\t    question:string\n108\t):Promise<boolean> {\n109\t    out.write(`${question} [y/N] `)\n110\t    const answer = await lines.readLine()\n111\t    if (answer === null) return false\n112\t    const a = goTrimSpace(answer).toLowerCase()\n113\t    return a === 'y' || a === 'yes'\n114\t}\n115\t\n116\tinterface RawTTY {\n117\t    isTTY?:boolean;\n118\t    setRawMode?:(on:boolean) => unknown;\n119\t}\n120\t\n121\tfunction rawCapable (stdin:NodeJS.ReadableStream):stdin is\n122\t    NodeJS.ReadableStream&Required<RawTTY> {\n123\t    const s = stdin as NodeJS.ReadableStream&RawTTY\n124\t    return s.isTTY === true && typeof s.setRawMode === 'function'\n125\t}\n126\t\n127\tconst CTRL_C = '\\x03'\n128\tconst CTRL_D = '\\x04'\n129\tconst BACKSPACE = '\\x08'\n130\tconst DELETE = '\\x7f'\n131\t\n132\t// Reads one line in raw mode without echo. Ctrl-C cancels.\n133\tasync function readRawLine (lines:LineReader):Promise<string|null> {\n134\t    let line = ''\n135\t    for (;;) {\n136\t        const c = await lines.readChar()\n137\t        if (c === null) return line === '' ? null : line\n138\t        if (c === '\\r' || c === '\\n') return line\n139\t        if (c === CTRL_C) throw new CancelledError()\n140\t        if (c === CTRL_D && line === '') return null\n141\t        if (c === BACKSPACE || c === DELETE) {\n142\t            line = line.slice(0, -1)\n143\t            continue\n144\t        }\n145\t        line += c\n146\t    }\n147\t}\n148\t\n149\t// Writes `prompt` and reads one secret. On a TTY it reads in raw mode\n150\t// without echo (Ctrl-C is cancellation); otherwise one plain line from\n151\t// the shared reader. The result is trimmed; end of input with no text is\n152\t// an error.\n153\texport async function readSecret (\n154\t    out:NodeJS.WritableStream,\n155\t    stdin:NodeJS.ReadableStream,\n156\t    lines:LineReader,\n157\t    prompt:string\n158\t):Promise<string> {\n159\t    out.write(prompt)\n160\t    let answer:string|null\n161\t    if (rawCapable(stdin)) {\n162\t        stdin.setRawMode(true)\n163\t        try {\n164\t            answer = await readRawLine(lines)\n165\t        } finally {\n166\t            stdin.setRawMode(false)\n167\t            out.write('\\n')\n168\t        }\n169\t    } else {\n170\t        answer = await lines.readLine()\n171\t    }\n172\t    if (answer === null) throw new Error('no input: end of file')\n173\t    return goTrimSpace(answer)\n174\t}\n175\t\n176\tfunction isTerminal (stream:unknown):boolean {\n177\t    const s = stream as { isTTY?:boolean, fd?:unknown }\n178\t    return s.isTTY === true && typeof s.fd === 'number' && isatty(s.fd)\n179\t}\n180\t\n181\t// Both streams are real terminals. A stream without a file descriptor,\n182\t// such as a test buffer, never is.\n183\tfunction defaultInteractiveTerminals (\n184\t    stdin:NodeJS.ReadableStream,\n185\t    stderr:NodeJS.WritableStream\n186\t):boolean {\n187\t    return isTerminal(stdin) && isTerminal(stderr)\n188\t}\n189\t\n190\t// Starts `open <url>` (darwin) or `xdg-open <url>` without waiting for\n191\t// it. Resolves with a spawn error, or undefined once started. The child\n192\t// is killed when `signal` aborts.\n193\tfunction defaultOpenBrowser (\n194\t    url:string,\n195\t    signal?:AbortSignal\n196\t):Promise<Error|undefined> {\n197\t    const cmd = process.platform === 'darwin' ? 'open' : 'xdg-open'\n198\t    return new Promise(resolve => {\n199\t        const child = spawn(cmd, [url], {\n200\t            stdio:'ignore',\n201\t            detached:true,\n202\t            signal,\n203\t        })\n204\t        child.on('spawn', () => {\n205\t            child.unref()\n206\t            resolve(undefined)\n207\t        })\n208\t        // Also swallows the AbortError emitted when `signal` kills it.\n209\t        child.on('error', err => resolve(err))\n210\t    })\n211\t}\n212\t\n213\texport const terminalHooks = {\n214\t    interactiveTerminals:defaultInteractiveTerminals,\n215\t    openBrowser:defaultOpenBrowser,\n216\t}\n217\t\n218\texport function interactiveTerminals (\n219\t    stdin:NodeJS.ReadableStream,\n220\t    stderr:NodeJS.WritableStream\n221\t):boolean {\n222\t    return terminalHooks.interactiveTerminals(stdin, stderr)\n223\t}\n224\t\n225\texport function openBrowser (\n226\t    url:string,\n227\t    signal?:AbortSignal\n228\t):Promise<Error|undefined> {\n229\t    return terminalHooks.openBrowser(url, signal)\n230\t}\n231\t"}]},"parent_tool_use_id":null,"session_id":"814e505e-c3f6-40bd-873f-c494d2caa400","uuid":"6287bb77-5d4d-473f-94c2-c46845f67446","timestamp":"2026-11-24T21:44:45.743Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-02-builtin-provider-prompts/src/cli/terminal.ts","content":"// Shared terminal helpers (spec 01, 2.16): yes/no prompt, secret input,\n// terminal detection, browser opening. Terminal detection and browser\n// opening are swappable through `terminalHooks` so tests never touch a\n// real terminal or launch a browser.\nimport { spawn } from 'node:child_process'\nimport { isatty } from 'node:tty'\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport { CancelledError } from './errors.js'\n\n// Reads a stream one character or line at a time. One reader serves every\n// prompt in a command, so input buffered past one answer is kept for the\n// next. The stream is attached lazily, on the first read.\nexport class LineReader {\n    private readonly stream:NodeJS.ReadableStream\n    private buf = ''\n    private ended = false\n    private error:Error|undefined\n    private attached = false\n    private wake:(() => void)|undefined\n\n    constructor (stream:NodeJS.ReadableStream) {\n        this.stream = stream\n    }\n\n    private attach ():void {\n        if (this.attached) return\n        this.attached = true\n        const notify = ():void => {\n            const w = this.wake\n            this.wake = undefined\n            w?.()\n        }\n        this.stream.setEncoding('utf8')\n        this.stream.on('data', (chunk:string) => {\n            this.buf += chunk\n            notify()\n        })\n        this.stream.on('end', () => {\n            this.ended = true\n            notify()\n        })\n        this.stream.on('error', (err:Error) => {\n            this.error = err\n            notify()\n        })\n    }\n\n    // Waits until the buffer holds data, the stream ended, or failed.\n    private async fill ():Promise<void> {\n        this.attach()\n        while (this.buf === '' && !this.ended && !this.error) {\n            this.stream.resume()\n            await new Promise<void>(resolve => { this.wake = resolve })\n        }\n        this.stream.pause()\n        if (this.buf === '' && this.error) throw this.error\n    }\n\n    // The next character, or null at end of input.\n    async readChar ():Promise<string|null> {\n        await this.fill()\n        if (this.buf === '') return null\n        const c = String.fromCodePoint(this.buf.codePointAt(0) as number)\n        this.buf = this.buf.slice(c.length)\n        return c\n    }\n\n    // The next line without its line ending, or null at end of input with\n    // nothing read. A last line without a newline is returned as is.\n    async readLine ():Promise<string|null> {\n        let line = ''\n        for (;;) {\n            await this.fill()\n            if (this.buf === '') return line === '' ? null : line\n            const i = this.buf.indexOf('\\n')\n            if (i >= 0) {\n                line += this.buf.slice(0, i)\n                this.buf = this.buf.slice(i + 1)\n                return line.endsWith('\\r') ? line.slice(0, -1) : line\n            }\n            line += this.buf\n            this.buf = ''\n        }\n    }\n}\n\n// Writes `<question> [Y/n] ` and reads one answer: empty, y, or yes (any\n// case) is true; anything else, or end of input, is false.\nexport async function promptYesDefault (\n    out:NodeJS.WritableStream,\n    lines:LineReader,\n    question:string\n):Promise<boolean> {\n    out.write(`${question} [Y/n] `)\n    const answer = await lines.readLine()\n    if (answer === null) return false\n    const a = goTrimSpace(answer).toLowerCase()\n    return a === '' || a === 'y' || a === 'yes'\n}\n\n// Writes `<question> [y/N] ` and reads one answer: only y or yes (any\n// case, surrounding space ignored) is true; empty input, anything else,\n// or end of input is false.\nexport async function promptNoDefault (\n    out:NodeJS.WritableStream,\n    lines:LineReader,\n    question:string\n):Promise<boolean> {\n    out.write(`${question} [y/N] `)\n    const answer = await lines.readLine()\n    if (answer === null) return false\n    const a = goTrimSpace(answer).toLowerCase()\n    return a === 'y' || a === 'yes'\n}\n\ninterface RawTTY {\n    isTTY?:boolean;\n    setRawMode?:(on:boolean) => unknown;\n}\n\nfunction rawCapable (stdin:NodeJS.ReadableStream):stdin is\n    NodeJS.ReadableStream&Required<RawTTY> {\n    const s = stdin as NodeJS.ReadableStream&RawTTY\n    return s.isTTY === true && typeof s.setRawMode === 'function'\n}\n\nconst CTRL_C = '\\x03'\nconst CTRL_D = '\\x04'\nconst BACKSPACE = '\\x08'\nconst DELETE = '\\x7f'\n\n// Reads one line in raw mode without echo. Ctrl-C cancels.\nasync function readRawLine (lines:LineReader):Promise<string|null> {\n    let line = ''\n    for (;;) {\n        const c = await lines.readChar()\n        if (c === null) return line === '' ? null : line\n        if (c === '\\r' || c === '\\n') return line\n        if (c === CTRL_C) throw new CancelledError()\n        if (c === CTRL_D && line === '') return null\n        if (c === BACKSPACE || c === DELETE) {\n            line = line.slice(0, -1)\n            continue\n        }\n        line += c\n    }\n}\n\n// Writes `prompt` and reads one secret. On a TTY it reads in raw mode\n// without echo (Ctrl-C is cancellation); otherwise one plain line from\n// the shared reader. The result is trimmed; end of input with no text is\n// an error.\nexport async function readSecret (\n    out:NodeJS.WritableStream,\n    stdin:NodeJS.ReadableStream,\n    lines:LineReader,\n    prompt:string\n):Promise<string> {\n    out.write(prompt)\n    let answer:string|null\n    if (rawCapable(stdin)) {\n        stdin.setRawMode(true)\n        try {\n            answer = await readRawLine(lines)\n        } finally {\n            stdin.setRawMode(false)\n            out.write('\\n')\n        }\n    } else {\n        answer = await lines.readLine()\n    }\n    if (answer === null) throw new Error('no input: end of file')\n    return goTrimSpace(answer)\n}\n\nfunction isTerminal (stream:unknown):boolean {\n    const s = stream as { isTTY?:boolean, fd?:unknown }\n    return s.isTTY === true && typeof s.fd === 'number' && isatty(s.fd)\n}\n\n// Both streams are real terminals. A stream without a file descriptor,\n// such as a test buffer, never is.\nfunction defaultInteractiveTerminals (\n    stdin:NodeJS.ReadableStream,\n    stderr:NodeJS.WritableStream\n):boolean {\n    return isTerminal(stdin) && isTerminal(stderr)\n}\n\n// Starts `open <url>` (darwin) or `xdg-open <url>` without waiting for\n// it. Resolves with a spawn error, or undefined once started. The child\n// is killed when `signal` aborts.\nfunction defaultOpenBrowser (\n    url:string,\n    signal?:AbortSignal\n):Promise<Error|undefined> {\n    const cmd = process.platform === 'darwin' ? 'open' : 'xdg-open'\n    return new Promise(resolve => {\n        const child = spawn(cmd, [url], {\n            stdio:'ignore',\n            detached:true,\n            signal,\n        })\n        child.on('spawn', () => {\n            child.unref()\n            resolve(undefined)\n        })\n        // Also swallows the AbortError emitted when `signal` kills it.\n        child.on('error', err => resolve(err))\n    })\n}\n\nexport const terminalHooks = {\n    interactiveTerminals:defaultInteractiveTerminals,\n    openBrowser:defaultOpenBrowser,\n}\n\nexport function interactiveTerminals (\n    stdin:NodeJS.ReadableStream,\n    stderr:NodeJS.WritableStream\n):boolean {\n    return terminalHooks.interactiveTerminals(stdin, stderr)\n}\n\nexport function openBrowser (\n    url:string,\n    signal?:AbortSignal\n):Promise<Error|undefined> {\n    return terminalHooks.openBrowser(url, signal)\n}\n","numLines":231,"startLine":1,"totalLines":231}},"tool_result_meta":[{"id":"toolu_0162CZ9XvpxmJDXTw9Egev7J","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
