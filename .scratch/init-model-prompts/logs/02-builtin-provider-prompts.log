el IDs in `defaults.ts` and the README `init` example together.","usage":{"total_tokens":113494,"tool_uses":4,"duration_ms":22521},"uuid":"8ca687c9-1715-4f94-b244-7c39e5a4e50c","session_id":"814e505e-c3f6-40bd-873f-c494d2caa400"}
