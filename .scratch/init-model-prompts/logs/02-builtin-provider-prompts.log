{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QyNUuJUgEvfaey8zrKBHLa","type":"tool_result","content":"1\t// pattern: Imperative Shell\n2\t// Shared provider fake for login and init. Inference replies can be\n3\t// supplied by callers when they also exercise a model request.\n4\timport {\n5\t    startInferenceServer,\n6\t    type Reply,\n7\t    type Script,\n8\t} from './inference-server.js'\n9\t\n10\texport async function providerServer (inference?:Script) {\n11\t    const credentials:string[] = []\n12\t    const hooks = {\n13\t        answerModels:(key:string):number|Reply => key === '' ? 401 : 200,\n14\t        answerKey:(key:string):number|Reply => key === '' ? 401 : 200,\n15\t    }\n16\t    const server = await startInferenceServer((req, n) => {\n17\t        const key = String(req.headers['x-api-key'] ??\n18\t            req.headers.authorization ?? '')\n19\t        credentials.push(key)\n20\t        if (req.method === 'GET' && req.path === '/v1/models') {\n21\t            if (req.headers['x-api-key'] &&\n22\t                req.headers['anthropic-version'] !== '2023-06-01') {\n23\t                return { status:400 }\n24\t            }\n25\t            const answer = hooks.answerModels(key)\n26\t            return typeof answer === 'number' ?\n27\t                { status:answer, body:'{}' } : answer\n28\t        }\n29\t        if (req.method === 'POST' &&\n30\t            req.path === '/api/v1/auth/keys') {\n31\t            const body = req.body as { code?:string }\n32\t            return {\n33\t                status:200,\n34\t                body:JSON.stringify({\n35\t                    key:`sk-or-minted-${body.code}`,\n36\t                })\n37\t            }\n38\t        }\n39\t        if (req.method === 'GET' && req.path === '/api/v1/key') {\n40\t            const answer = hooks.answerKey(key)\n41\t            return typeof answer === 'number' ?\n42\t                { status:answer, body:'{}' } : answer\n43\t        }\n44\t        return inference?.(req, n) ?? { status:404 }\n45\t    })\n46\t    return { ...server, credentials, hooks }\n47\t}\n48\t"}]},"parent_tool_use_id":null,"session_id":"814e505e-c3f6-40bd-873f-c494d2caa400","uuid":"39eb81f3-3968-4a2d-a647-b74ac39740cf","timestamp":"2026-11-24T21:45:07.852Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-02-builtin-provider-prompts/test/helpers/provider-server.ts","content":"// pattern: Imperative Shell\n// Shared provider fake for login and init. Inference replies can be\n// supplied by callers when they also exercise a model request.\nimport {\n    startInferenceServer,\n    type Reply,\n    type Script,\n} from './inference-server.js'\n\nexport async function providerServer (inference?:Script) {\n    const credentials:string[] = []\n    const hooks = {\n        answerModels:(key:string):number|Reply => key === '' ? 401 : 200,\n        answerKey:(key:string):number|Reply => key === '' ? 401 : 200,\n    }\n    const server = await startInferenceServer((req, n) => {\n        const key = String(req.headers['x-api-key'] ??\n            req.headers.authorization ?? '')\n        credentials.push(key)\n        if (req.method === 'GET' && req.path === '/v1/models') {\n            if (req.headers['x-api-key'] &&\n                req.headers['anthropic-version'] !== '2023-06-01') {\n                return { status:400 }\n            }\n            const answer = hooks.answerModels(key)\n            return typeof answer === 'number' ?\n                { status:answer, body:'{}' } : answer\n        }\n        if (req.method === 'POST' &&\n            req.path === '/api/v1/auth/keys') {\n            const body = req.body as { code?:string }\n            return {\n                status:200,\n                body:JSON.stringify({\n                    key:`sk-or-minted-${body.code}`,\n                })\n            }\n        }\n        if (req.method === 'GET' && req.path === '/api/v1/key') {\n            const answer = hooks.answerKey(key)\n            return typeof answer === 'number' ?\n                { status:answer, body:'{}' } : answer\n        }\n        return inference?.(req, n) ?? { status:404 }\n    })\n    return { ...server, credentials, hooks }\n}\n","numLines":48,"startLine":1,"totalLines":48}},"tool_result_meta":[{"id":"toolu_01QyNUuJUgEvfaey8zrKBHLa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
