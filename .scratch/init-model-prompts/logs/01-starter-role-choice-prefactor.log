{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R974n6vSd9RMYZRHvjw3Ds","type":"tool_result","content":"1\t// Provider-neutral model families (spec 02, 2.10).\n2\timport { goTrimSpace } from '../gocompat/strings.js'\n3\t\n4\tconst VENDOR_PREFIXES = [\n5\t    'anthropic', 'openai', 'google', 'gemini', 'mistral', 'xai', 'cohere',\n6\t    'deepseek',\n7\t]\n8\t\n9\t// [family, exact names, ID prefixes], first match wins.\n10\tconst RULES:[string, string[], string[]][] = [\n11\t    ['anthropic', ['anthropic'], ['claude-']],\n12\t    ['openai', ['openai'], ['gpt-', 'codex-', 'chatgpt-', 'o1', 'o3', 'o4']],\n13\t    ['google', ['google', 'gemini'], ['gemini-']],\n14\t    ['mistral', ['mistral'], ['mistral-', 'codestral-']],\n15\t    ['xai', ['xai'], ['grok-']],\n16\t    ['cohere', ['cohere'], ['command-']],\n17\t    ['deepseek', ['deepseek'], ['deepseek-']],\n18\t]\n19\t\n20\texport function canonicalFamily (family:string):string {\n21\t    return family === 'gemini' ? 'google' : family\n22\t}\n23\t\n24\tfunction trimSuffix (s:string, suffix:string):string {\n25\t    return s.endsWith(suffix) ? s.slice(0, s.length - suffix.length) : s\n26\t}\n27\t\n28\t// The model's family from a bare family name, a model ID, or a\n29\t// `<vendor>/<model>` ID, or '' when it cannot be determined.\n30\texport function inferFamily (model:string):string {\n31\t    let m = goTrimSpace(model).toLowerCase()\n32\t    if (m === '') return ''\n33\t    const slash = m.indexOf('/')\n34\t    if (slash >= 0) {\n35\t        const vendor = m.slice(0, slash)\n36\t        if (VENDOR_PREFIXES.includes(vendor)) return canonicalFamily(vendor)\n37\t        m = m.slice(slash + 1)\n38\t    }\n39\t    m = trimSuffix(trimSuffix(m, ':api'), '[1m]')\n40\t    for (const [family, names, prefixes] of RULES) {\n41\t        if (names.includes(m) || prefixes.some(p => m.startsWith(p))) {\n42\t            return family\n43\t        }\n44\t    }\n45\t    return ''\n46\t}\n47\t"}]},"parent_tool_use_id":null,"session_id":"9df03491-0f38-46e3-8d74-e94e90d0be62","uuid":"b47916bc-3bef-4184-887d-02c365f8bcf6","timestamp":"2026-11-24T21:34:09.513Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-01-starter-role-choice-prefactor/src/config/family.ts","content":"// Provider-neutral model families (spec 02, 2.10).\nimport { goTrimSpace } from '../gocompat/strings.js'\n\nconst VENDOR_PREFIXES = [\n    'anthropic', 'openai', 'google', 'gemini', 'mistral', 'xai', 'cohere',\n    'deepseek',\n]\n\n// [family, exact names, ID prefixes], first match wins.\nconst RULES:[string, string[], string[]][] = [\n    ['anthropic', ['anthropic'], ['claude-']],\n    ['openai', ['openai'], ['gpt-', 'codex-', 'chatgpt-', 'o1', 'o3', 'o4']],\n    ['google', ['google', 'gemini'], ['gemini-']],\n    ['mistral', ['mistral'], ['mistral-', 'codestral-']],\n    ['xai', ['xai'], ['grok-']],\n    ['cohere', ['cohere'], ['command-']],\n    ['deepseek', ['deepseek'], ['deepseek-']],\n]\n\nexport function canonicalFamily (family:string):string {\n    return family === 'gemini' ? 'google' : family\n}\n\nfunction trimSuffix (s:string, suffix:string):string {\n    return s.endsWith(suffix) ? s.slice(0, s.length - suffix.length) : s\n}\n\n// The model's family from a bare family name, a model ID, or a\n// `<vendor>/<model>` ID, or '' when it cannot be determined.\nexport function inferFamily (model:string):string {\n    let m = goTrimSpace(model).toLowerCase()\n    if (m === '') return ''\n    const slash = m.indexOf('/')\n    if (slash >= 0) {\n        const vendor = m.slice(0, slash)\n        if (VENDOR_PREFIXES.includes(vendor)) return canonicalFamily(vendor)\n        m = m.slice(slash + 1)\n    }\n    m = trimSuffix(trimSuffix(m, ':api'), '[1m]')\n    for (const [family, names, prefixes] of RULES) {\n        if (names.includes(m) || prefixes.some(p => m.startsWith(p))) {\n            return family\n        }\n    }\n    return ''\n}\n","numLines":47,"startLine":1,"totalLines":47}},"tool_result_meta":[{"id":"toolu_01R974n6vSd9RMYZRHvjw3Ds","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
