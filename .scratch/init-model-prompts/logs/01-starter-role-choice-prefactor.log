{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JfA1AXjp8C1mdhqHPSmVsj","type":"tool_result","content":"1\t// Shared helpers for role and credential tests at the module seam.\n2\timport {\n3\t    type ProjectConfig,\n4\t    type StoredCredentials,\n5\t    decode,\n6\t    normalize,\n7\t    withStoredCredentials,\n8\t} from '../../src/config/load.js'\n9\timport type { Env } from '../../src/config/credential.js'\n10\timport { type ResolvedRole, resolveRole } from '../../src/config/role.js'\n11\t\n12\texport const CUSTOM_ENDPOINT = 'https://template-endpoint.example/v1'\n13\texport const AMBIENT_GATEWAY = 'https://ambient-gateway.example/v1'\n14\texport const OPENROUTER = 'https://openrouter.ai/api/v1'\n15\t\n16\t// A config from JSON text, normalized as loadConfig would.\n17\texport function configFrom (doc:object):ProjectConfig {\n18\t    return normalize(decode(JSON.stringify({ version:1, ...doc })), '')\n19\t}\n20\t\n21\t// A config whose finder uses `profile` and whose verifier has a model.\n22\texport function finderConfig (\n23\t    profile:Record<string, unknown>,\n24\t    store?:StoredCredentials\n25\t):ProjectConfig {\n26\t    const cfg = configFrom({\n27\t        inference_profiles:{ finder:profile, verifier:{ model:'v' } },\n28\t        roles:{ finder:{ profile:'finder' }, verifier:{ profile:'verifier' } },\n29\t    })\n30\t    return store ? withStoredCredentials(cfg, store) : cfg\n31\t}\n32\t\n33\texport function resolveFinder (\n34\t    profile:Record<string, unknown>,\n35\t    env:Env,\n36\t    store?:StoredCredentials\n37\t):ResolvedRole {\n38\t    return resolveRole(finderConfig(profile, store), 'finder', env)\n39\t}\n40\t\n41\t// Answers lookups from fixed maps, project scope first, as the real\n42\t// credentials store does; records every provider asked for.\n43\texport class FakeStore implements StoredCredentials {\n44\t    lookups:string[] = []\n45\t    constructor (\n46\t        readonly project:Record<string, string> = {},\n47\t        readonly user:Record<string, string> = {},\n48\t        readonly err?:Error\n49\t    ) {}\n50\t\n51\t    lookup (provider:string):{ key:string, scope:'project'|'user' }|null {\n52\t        this.lookups.push(provider)\n53\t        if (this.err) throw this.err\n54\t        if (Object.hasOwn(this.project, provider)) {\n55\t            return { key:this.project[provider], scope:'project' }\n56\t        }\n57\t        if (Object.hasOwn(this.user, provider)) {\n58\t            return { key:this.user[provider], scope:'user' }\n59\t        }\n60\t        return null\n61\t    }\n62\t}\n63\t\n64\t// A project and a user key for every built-in provider.\n65\texport function bothStored ():FakeStore {\n66\t    const project:Record<string, string> = {}\n67\t    const user:Record<string, string> = {}\n68\t    for (const name of ['openai', 'anthropic', 'openrouter']) {\n69\t        project[name] = `project-${name}`\n70\t        user[name] = `user-${name}`\n71\t    }\n72\t    return new FakeStore(project, user)\n73\t}\n74\t\n75\t// The error `fn` throws, or undefined.\n76\texport function thrown (fn:() => unknown):Error|undefined {\n77\t    try {\n78\t        fn()\n79\t    } catch (err) {\n80\t        return err as Error\n81\t    }\n82\t    return undefined\n83\t}\n84\t"}]},"parent_tool_use_id":null,"session_id":"9df03491-0f38-46e3-8d74-e94e90d0be62","uuid":"2a5b70cd-f94e-4401-9da8-2beb3af77f4b","timestamp":"2026-11-24T21:34:10.203Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-01-starter-role-choice-prefactor/test/config/helpers.ts","content":"// Shared helpers for role and credential tests at the module seam.\nimport {\n    type ProjectConfig,\n    type StoredCredentials,\n    decode,\n    normalize,\n    withStoredCredentials,\n} from '../../src/config/load.js'\nimport type { Env } from '../../src/config/credential.js'\nimport { type ResolvedRole, resolveRole } from '../../src/config/role.js'\n\nexport const CUSTOM_ENDPOINT = 'https://template-endpoint.example/v1'\nexport const AMBIENT_GATEWAY = 'https://ambient-gateway.example/v1'\nexport const OPENROUTER = 'https://openrouter.ai/api/v1'\n\n// A config from JSON text, normalized as loadConfig would.\nexport function configFrom (doc:object):ProjectConfig {\n    return normalize(decode(JSON.stringify({ version:1, ...doc })), '')\n}\n\n// A config whose finder uses `profile` and whose verifier has a model.\nexport function finderConfig (\n    profile:Record<string, unknown>,\n    store?:StoredCredentials\n):ProjectConfig {\n    const cfg = configFrom({\n        inference_profiles:{ finder:profile, verifier:{ model:'v' } },\n        roles:{ finder:{ profile:'finder' }, verifier:{ profile:'verifier' } },\n    })\n    return store ? withStoredCredentials(cfg, store) : cfg\n}\n\nexport function resolveFinder (\n    profile:Record<string, unknown>,\n    env:Env,\n    store?:StoredCredentials\n):ResolvedRole {\n    return resolveRole(finderConfig(profile, store), 'finder', env)\n}\n\n// Answers lookups from fixed maps, project scope first, as the real\n// credentials store does; records every provider asked for.\nexport class FakeStore implements StoredCredentials {\n    lookups:string[] = []\n    constructor (\n        readonly project:Record<string, string> = {},\n        readonly user:Record<string, string> = {},\n        readonly err?:Error\n    ) {}\n\n    lookup (provider:string):{ key:string, scope:'project'|'user' }|null {\n        this.lookups.push(provider)\n        if (this.err) throw this.err\n        if (Object.hasOwn(this.project, provider)) {\n            return { key:this.project[provider], scope:'project' }\n        }\n        if (Object.hasOwn(this.user, provider)) {\n            return { key:this.user[provider], scope:'user' }\n        }\n        return null\n    }\n}\n\n// A project and a user key for every built-in provider.\nexport function bothStored ():FakeStore {\n    const project:Record<string, string> = {}\n    const user:Record<string, string> = {}\n    for (const name of ['openai', 'anthropic', 'openrouter']) {\n        project[name] = `project-${name}`\n        user[name] = `user-${name}`\n    }\n    return new FakeStore(project, user)\n}\n\n// The error `fn` throws, or undefined.\nexport function thrown (fn:() => unknown):Error|undefined {\n    try {\n        fn()\n    } catch (err) {\n        return err as Error\n    }\n    return undefined\n}\n","numLines":84,"startLine":1,"totalLines":84}},"tool_result_meta":[{"id":"toolu_01JfA1AXjp8C1mdhqHPSmVsj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
