king directory',\n    builder:y => y\n        .option('finder-model', {\n            type:'string',\n            default:'',\n            describe:'Finder model ID (default: a placeholder to edit)'\n        })\n        .option('verifier-model', {\n            type:'string',\n            default:'',\n            describe:'Verifier model ID (default: a placeholder to edit)'\n        })\n        .option('no-login', {\n            type:'boolean',\n            default:false,\n            describe:'Do not offer to log in to the config providers'\n        }),\n    handler:async (args, ctx) => {\n        let repo:string\n        try {\n            repo = await gitRoot(ctx.cwd, {\n                env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal,\n            })\n        } catch (err) {\n            if (ctx.signal.aborted) throw err\n            throw new UsageError(String(err), { cause:err })\n        }\n        const file = await writeStarter(ctx.cwd,\n            args['finder-model'] as string, args['verifier-model'] as string)\n        ctx.stdout.write(`wrote ${file}\\n`)\n        const ignored = await ensureStateIgnored(repo)\n        if (ignored.added) {\n            ctx.stdout.write(`added ${STATE_IGNORE_ENTRY} ` +\n                `to ${ignored.path}\\n`)\n        }\n        if (!args['no-login']) await offerLogin(file, ctx)\n    },\n}\n","structuredPatch":[{"oldStart":49,"oldLines":7,"newStart":49,"newLines":7,"lines":["     const file = path.resolve(cwd, PROJECT_CONFIG_NAME)","     let body:string","     try {","-        body = starter(finderModel, verifierModel)","+        body = starterFromModels(finderModel, verifierModel)","     } catch (err) {","         if (!(err instanceof UnplaceableModelError)) throw err","         throw new UsageError(`--${err.role}-model: ${err.message}`,"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01MQGZiaCaGCj9a39nBX5VB8","permission_decision":{"decision":"accept","source":"config","reason_type":"mod