{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ProbJy4RRKLn5cN3xxHTn8","type":"tool_result","content":"1\t// pattern: Functional Core\n2\timport { canonicalFamily, inferFamily } from './family.js'\n3\timport { lookupProvider } from './provider.js'\n4\timport { goQuote, goTrimSpace } from '../gocompat/strings.js'\n5\timport {\n6\t    DEFAULT_CONFIDENCE_FLOOR, DEFAULT_QUICK_CONFIDENCE_FLOOR,\n7\t    DEFAULT_SNAPSHOT, DEFAULT_GATE_OFFER, DEFAULT_LIMITS,\n8\t    GATE_DEFAULT_TIMEOUT, GATE_DEFAULT_SEVERITY,\n9\t} from './defaults.js'\n10\texport { isPlaceholderModel } from './role.js'\n11\t\n12\texport const SCHEMA_REF =\n13\t    './node_modules/@substrate-system/roast/roast.schema.json'\n14\texport const PLACEHOLDER_FINDER_MODEL = '<finder-model>'\n15\texport const PLACEHOLDER_VERIFIER_MODEL = '<verifier-model>'\n16\t\n17\tconst TEMPLATE =\n18\t    `// Roast project config. Commit this file. It holds every setting except\n19\t// credentials, which come from \"npx roast login\" or environment variables.\n20\t{\n21\t  \"$schema\": __SCHEMA__,\n22\t  \"version\": 1,\n23\t\n24\t  // Each profile names a model, its endpoint and protocol, and the\n25\t  // environment variable that holds its credential. These use built-in\n26\t  // provider endpoints with the standard key variables, so they need no\n27\t  // \\`npx roast trust\\` approval.\n28\t  \"inference_profiles\": {\n29\t__PROFILES__\n30\t  },\n31\t\n32\t  // The finder proposes defects; the verifier checks each one. Using\n33\t  // different model families keeps the two independent.\n34\t  \"roles\": {\n35\t    \"finder\": {\"profile\": __FINDER_PROFILE__},\n36\t    \"verifier\": {\"profile\": __VERIFIER_PROFILE__}\n37\t  },\n38\t\n39\t  // Review defaults.\n40\t  // \"review\": {\n41\t  //   \"confidence_floor\": ${JSON.stringify(DEFAULT_CONFIDENCE_FLOOR)},\n42\t  //   \"quick_confidence_floor\": ${\n43\t    JSON.stringify(DEFAULT_QUICK_CONFIDENCE_FLOOR)\n44\t},\n45\t  //   \"excludes\": []