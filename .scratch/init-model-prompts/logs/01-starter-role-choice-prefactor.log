{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018oNjYxPjRZRS1qk1e9SakJ","type":"tool_result","content":"1\timport { test } from '../helpers/test.js'\n2\timport { decode, normalize } from '../../src/config/load.js'\n3\timport {\n4\t    starter,\n5\t    UnplaceableModelError,\n6\t} from '../../src/config/starter.js'\n7\timport { thrown } from './helpers.js'\n8\timport { DEFAULT_LIMITS } from '../../src/config/defaults.js'\n9\timport { gateOffers, snapshotEnabled } from '../../src/config/load.js'\n10\timport {\n11\t    GATE_DEFAULT_TIMEOUT,\n12\t    GATE_DEFAULT_SEVERITY,\n13\t} from '../../src/cli/gate.js'\n14\t\n15\ttest('starter places models and separates different models', t => {\n16\t    const cases:Array<[string, string, string, string, number]> = [\n17\t        ['', '', 'openai', 'anthropic', 2],\n18\t        ['claude-opus-5-5', 'gpt-5', 'anthropic', 'openai', 2],\n19\t        ['gpt-5', 'claude-sonnet-5-5', 'openai', 'anthropic', 2],\n20\t        ['claude-opus-5-5', '', 'anthropic', 'openai', 2],\n21\t        ['', 'gpt-5', 'anthropic', 'openai', 2],\n22\t        ['codex-mini-latest', '', 'openai', 'anthropic', 2],\n23\t        ['claude-x', 'claude-y', 'anthropic', 'anthropic', 2],\n24\t        ['gpt-5', 'gpt-5', 'openai', 'openai', 1],\n25\t        ['anthropic/claude-x', 'openai/gpt-5',\n26\t            'openrouter', 'openrouter', 2],\n27\t        ['meta-llama/llama-4:free', 'anthropic/claude-x',\n28\t            'openrouter', 'openrouter', 2],\n29\t        ['claude-x', 'openai/gpt-5', 'anthropic', 'openrouter', 2],\n30\t        ['anthropic/claude-x', 'gpt-5', 'openrouter', 'openai', 2],\n31\t        ['anthropic/claude-x', '', 'openrouter', 'openrouter', 2],\n32\t        ['', 'openai/gpt-5', 'openrouter', 'openrouter', 2],\n33\t        [' \\tgpt-5\\u0085', '', 'openai', 'anthropic', 2],\n34\t    ]\n35\t    const providers = {\n36\t        openai:['responses', 'https://api.openai.com/v1', 'OPENAI_API_KEY'],\n37\t        anthropic:['anthropic', 'https://api.anthropic.com/v1',\n38\t            'ANTHROPIC_API_KEY'],\n39\t        openrouter:['chat', 'https://openrouter.ai/api/v1',\n40\t            'OPENROUTER_API_KEY'],\n41\t    }\n42\t    for (const [finder, verifier, fAt, vAt, count] of cases) {\n43\t        const cfg = normalize(decode(starter(finder, verifier)), '')\n44\t        t.equal(Object.keys(cfg.inference_profiles).length, count)\n45\t        for (const [role, at, model] of [\n46\t            ['finder', fAt, finder], ['verifier', vAt, verifier],\n47\t        ] as const) {\n48\t            const name = cfg.roles[role]!.profile\n49\t            const p = cfg.inference_profiles[name!]!\n50\t            t.deepEqual([p.protocol, p.endpoint, p.api_key_env],\n51\t                providers[at as keyof typeof providers])\n52\t            t.equal(p.model, model.trim().replace(/\\u0085$/, '') ||\n53\t                `<${role}-model>`)\n54\t        }\n55\t        if (finder !== verifier) {\n56\t            t.ok(cfg.roles.finder!.profile !== cfg.roles.verifier!.profile,\n57\t                'different models have different profiles')\n58\t        }\n59\t    }\n60\t})\n61\t\n62\ttest('starter gives default and OpenRouter profiles stable names', t => {\n63\t    for (const [f, v, names] of [\n64\t        ['', '', ['openai', 'anthropic']],\n65\t        ['anthropic/claude-x', 'openai/gpt-5',\n66\t            ['openrouter-finder', 'openrouter-verifier']],\n67\t    ] as const) {\n68\t        const cfg = normalize(decode(starter(f, v)), '')\n69\t        t.deepEqual([cfg.roles.finder!.profile, cfg.roles.verifier!.profile],\n70\t            [...names])\n71\t    }\n72\t})\n73\t\n74\ttest('starter rejects unplaceable IDs with role and trimmed model', t => {\n75\t    for (const model of [\n76\t        'gemini-2.5-pro', 'some-model', 'openai',\n77\t        'claude-opus-5-5[1m]', 'openai:api', 'Claude-Opus-5-5',\n78\t        'claude-x@2024', 'gpt-5 mini', 'Anthropic/claude-opus-5-5',\n79\t        'anthropic/Claude-Opus-5-5', 'anthropic/ claude-opus-5-5',\n80\t        'anthropic/claude-opus-5-5[1m]', 'openai/gpt-5:api',\n81\t        'anthropic/anthropic', 'google/gemini', 'openai/', '/gpt-5',\n82\t        'openai/gpt-5/mini', 'meta-llama/llama-4:',\n83\t    ]) {\n84\t        for (const role of ['finder', 'verifier']) {\n85\t            const err = thrown(() => starter(\n86\t                role === 'finder' ? ` ${model} ` : '',\n87\t                role === 'verifier' ? ` ${model} ` : ''\n88\t            ))\n89\t            t.ok(err instanceof UnplaceableModelError)\n90\t            if (!(err instanceof UnplaceableModelError)) continue\n91\t            t.equal(err.role, role)\n92\t            t.equal(err.model, model)\n93\t        }\n94\t    }\n95\t    const first = thrown(() => starter('invalid-finder', 'invalid-verifier'))\n96\t    t.equal((first as UnplaceableModelError).role, 'finder')\n97\t})\n98\t\n99\ttest('starter comments agree with runtime defaults', t => {\n100\t    const body = starter('', '')\n101\t    const comments = body.split('\\n').filter(line =>\n102\t        /^ {2}\\/\\/ (?: *\"| *})/.test(line))\n103\t        .map(line => line.slice(5)).join('\\n')\n104\t    // Only object-property comments are executable JSONC when uncommented.\n105\t    const blocks = comments.slice(comments.indexOf('\"review\":'))\n106\t    const raw = decode('{\"version\":1,' + blocks + '}')\n107\t    const cfg = normalize(decode(body), '')\n108\t    t.deepEqual({ ...raw.limits }, {\n109\t        deadline:'10m',\n110\t        request_timeout:'10m',\n111\t        max_total_tokens:3000000,\n112\t        max_diff_bytes:1000000,\n113\t        max_prompt_bytes:8000000,\n114\t        max_file_ctx_bytes:400000,\n115\t        max_attempts:4,\n116\t        max_verified:25,\n117\t    })\n118\t    t.deepEqual({ ...raw.limits }, DEFAULT_LIMITS)\n119\t    t.equal(raw.review!.confidence_floor, cfg.review.confidence_floor)\n120\t    t.equal(raw.review!.quick_confidence_floor,\n121\t        cfg.review.quick_confidence_floor)\n122\t    t.equal(raw.review!.snapshot, snapshotEnabled(cfg))\n123\t    t.equal(raw.gate!.offer, gateOffers(cfg))\n124\t    t.equal(raw.gate!.timeout_seconds, GATE_DEFAULT_TIMEOUT)\n125\t    t.equal(raw.gate!.severity, GATE_DEFAULT_SEVERITY)\n126\t})\n127\t"}]},"parent_tool_use_id":null,"session_id":"9df03491-0f38-46e3-8d74-e94e90d0be62","uuid":"b75abafd-bd90-4469-95ee-a48e6c6bccad","timestamp":"2026-11-24T21:34:03.421Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-01-starter-role-choice-prefactor/test/config/starter.ts","content":"import { test } from '../helpers/test.js'\nimport { decode, normalize } from '../../src/config/load.js'\nimport {\n    starter,\n    UnplaceableModelError,\n} from '../../src/config/starter.js'\nimport { thrown } from './helpers.js'\nimport { DEFAULT_LIMITS } from '../../src/config/defaults.js'\nimport { gateOffers, snapshotEnabled } from '../../src/config/load.js'\nimport {\n    GATE_DEFAULT_TIMEOUT,\n    GATE_DEFAULT_SEVERITY,\n} from '../../src/cli/gate.js'\n\ntest('starter places models and separates different models', t => {\n    const cases:Array<[string, string, string, string, number]> = [\n        ['', '', 'openai', 'anthropic', 2],\n        ['claude-opus-5-5', 'gpt-5', 'anthropic', 'openai', 2],\n        ['gpt-5', 'claude-sonnet-5-5', 'openai', 'anthropic', 2],\n        ['claude-opus-5-5', '', 'anthropic', 'openai', 2],\n        ['', 'gpt-5', 'anthropic', 'openai', 2],\n        ['codex-mini-latest', '', 'openai', 'anthropic', 2],\n        ['claude-x', 'claude-y', 'anthropic', 'anthropic', 2],\n        ['gpt-5', 'gpt-5', 'openai', 'openai', 1],\n        ['anthropic/claude-x', 'openai/gpt-5',\n            'openrouter', 'openrouter', 2],\n        ['meta-llama/llama-4:free', 'anthropic/claude-x',\n            'openrouter', 'openrouter', 2],\n        ['claude-x', 'openai/gpt-5', 'anthropic', 'openrouter', 2],\n        ['anthropic/claude-x', 'gpt-5', 'openrouter', 'openai', 2],\n        ['anthropic/claude-x', '', 'openrouter', 'openrouter', 2],\n        ['', 'openai/gpt-5', 'openrouter', 'openrouter', 2],\n        [' \\tgpt-5\\u0085', '', 'openai', 'anthropic', 2],\n    ]\n    const providers = {\n        openai:['responses', 'https://api.openai.com/v1', 'OPENAI_API_KEY'],\n        anthropic:['anthropic', 'https://api.anthropic.com/v1',\n            'ANTHROPIC_API_KEY'],\n        openrouter:['chat', 'https://openrouter.ai/api/v1',\n            'OPENROUTER_API_KEY'],\n    }\n    for (const [finder, verifier, fAt, vAt, count] of cases) {\n        const cfg = normalize(decode(starter(finder, verifier)), '')\n        t.equal(Object.keys(cfg.inference_profiles).length, count)\n        for (const [role, at, model] of [\n            ['finder', fAt, finder], ['verifier', vAt, verifier],\n        ] as const) {\n            const name = cfg.roles[role]!.profile\n            const p = cfg.inference_profiles[name!]!\n            t.deepEqual([p.protocol, p.endpoint, p.api_key_env],\n                providers[at as keyof typeof providers])\n            t.equal(p.model, model.trim().replace(/\\u0085$/, '') ||\n                `<${role}-model>`)\n        }\n        if (finder !== verifier) {\n            t.ok(cfg.roles.finder!.profile !== cfg.roles.verifier!.profile,\n                'different models have different profiles')\n        }\n    }\n})\n\ntest('starter gives default and OpenRouter profiles stable names', t => {\n    for (const [f, v, names] of [\n        ['', '', ['openai', 'anthropic']],\n        ['anthropic/claude-x', 'openai/gpt-5',\n            ['openrouter-finder', 'openrouter-verifier']],\n    ] as const) {\n        const cfg = normalize(decode(starter(f, v)), '')\n        t.deepEqual([cfg.roles.finder!.profile, cfg.roles.verifier!.profile],\n            [...names])\n    }\n})\n\ntest('starter rejects unplaceable IDs with role and trimmed model', t => {\n    for (const model of [\n        'gemini-2.5-pro', 'some-model', 'openai',\n        'claude-opus-5-5[1m]', 'openai:api', 'Claude-Opus-5-5',\n        'claude-x@2024', 'gpt-5 mini', 'Anthropic/claude-opus-5-5',\n        'anthropic/Claude-Opus-5-5', 'anthropic/ claude-opus-5-5',\n        'anthropic/claude-opus-5-5[1m]', 'openai/gpt-5:api',\n        'anthropic/anthropic', 'google/gemini', 'openai/', '/gpt-5',\n        'openai/gpt-5/mini', 'meta-llama/llama-4:',\n    ]) {\n        for (const role of ['finder', 'verifier']) {\n            const err = thrown(() => starter(\n                role === 'finder' ? ` ${model} ` : '',\n                role === 'verifier' ? ` ${model} ` : ''\n            ))\n            t.ok(err instanceof UnplaceableModelError)\n            if (!(err instanceof UnplaceableModelError)) continue\n            t.equal(err.role, role)\n            t.equal(err.model, model)\n        }\n    }\n    const first = thrown(() => starter('invalid-finder', 'invalid-verifier'))\n    t.equal((first as UnplaceableModelError).role, 'finder')\n})\n\ntest('starter comments agree with runtime defaults', t => {\n    const body = starter('', '')\n    const comments = body.split('\\n').filter(line =>\n        /^ {2}\\/\\/ (?: *\"| *})/.test(line))\n        .map(line => line.slice(5)).join('\\n')\n    // Only object-property comments are executable JSONC when uncommented.\n    const blocks = comments.slice(comments.indexOf('\"review\":'))\n    const raw = decode('{\"version\":1,' + blocks + '}')\n    const cfg = normalize(decode(body), '')\n    t.deepEqual({ ...raw.limits }, {\n        deadline:'10m',\n        request_timeout:'10m',\n        max_total_tokens:3000000,\n        max_diff_bytes:1000000,\n        max_prompt_bytes:8000000,\n        max_file_ctx_bytes:400000,\n        max_attempts:4,\n        max_verified:25,\n    })\n    t.deepEqual({ ...raw.limits }, DEFAULT_LIMITS)\n    t.equal(raw.review!.confidence_floor, cfg.review.confidence_floor)\n    t.equal(raw.review!.quick_confidence_floor,\n        cfg.review.quick_confidence_floor)\n    t.equal(raw.review!.snapshot, snapshotEnabled(cfg))\n    t.equal(raw.gate!.offer, gateOffers(cfg))\n    t.equal(raw.gate!.timeout_seconds, GATE_DEFAULT_TIMEOUT)\n    t.equal(raw.gate!.severity, GATE_DEFAULT_SEVERITY)\n})\n","numLines":127,"startLine":1,"totalLines":127}},"tool_result_meta":[{"id":"toolu_018oNjYxPjRZRS1qk1e9SakJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
