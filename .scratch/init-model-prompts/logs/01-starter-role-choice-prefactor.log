{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012ABtwdE7SBTnNUCm4Noqn7","type":"tool_result","content":"1\t// The built-in provider registry (spec 02, 2.7): the one place that says\n2\t// which endpoint, protocols, standard key variable, key page, and login\n3\t// method each provider has. Trust standardness, ambient credentials, the\n4\t// `init` starter, and login all consult it.\n5\timport { goTrimSpace } from '../gocompat/strings.js'\n6\t\n7\texport const DEFAULT_OPENAI_BASE_URL = 'https://api.openai.com/v1'\n8\texport const DEFAULT_ANTHROPIC_BASE_URL = 'https://api.anthropic.com/v1'\n9\texport const OPENROUTER_BASE_URL = 'https://openrouter.ai/api/v1'\n10\t\n11\texport type Protocol = 'chat'|'responses'|'anthropic'\n12\texport type LoginMethod = 'paste'|'browser'\n13\t\n14\texport interface BuiltinProvider {\n15\t    readonly name:string;\n16\t    readonly endpoint:string;\n17\t    // The first is the one starter profiles use.\n18\t    readonly protocols:readonly Protocol[];\n19\t    readonly keyEnv:string;\n20\t    readonly keyPage:string;\n21\t    readonly login:LoginMethod;\n22\t}\n23\t\n24\t// No two entries share an (endpoint, protocol) pair, so providerAt finds\n25\t// at most one. Order matters for withheldKey and listings.\n26\tconst REGISTRY:readonly BuiltinProvider[] = Object.freeze([\n27\t    {\n28\t        name:'openai',\n29\t        endpoint:DEFAULT_OPENAI_BASE_URL,\n30\t        protocols:['responses', 'chat'],\n31\t        keyEnv:'OPENAI_API_KEY',\n32\t        keyPage:'https://platform.openai.com/api-keys',\n33\t        login:'paste',\n34\t    },\n35\t    {\n36\t        name:'anthropic',\n37\t        endpoint:DEFAULT_ANTHROPIC_BASE_URL,\n38\t        protocols:['anthropic'],\n39\t        keyEnv:'ANTHROPIC_API_KEY',\n40\t        keyPage:'https://console.anthropic.com/settings/keys',\n41\t        login:'paste',\n42\t    },\n43\t    {\n44\t        name:'openrouter',\n45\t        endpoint:OPENROUTER_BASE_URL,\n46\t        protocols:['chat', 'responses'],\n47\t        keyEnv:'OPENROUTER_API_KEY',\n48\t        keyPage:'https://openrouter.ai/settings/keys',\n49\t        login:'browser',\n50\t    },\n51\t].map(p => Object.freeze({\n52\t    ...p,\n53\t    protocols:Object.freeze([...p.protocols]) as readonly Protocol[],\n54\t} as BuiltinProvider)))\n55\t\n56\tfunction copy (p:BuiltinProvider):BuiltinProvider {\n57\t    return { ...p, protocols:[...p.protocols] }\n58\t}\n59\t\n60\t// Copies of the registry, in registry order.\n61\texport function builtinProviders ():BuiltinProvider[] {\n62\t    return REGISTRY.map(copy)\n63\t}\n64\t\n65\t// The provider with exactly this name (case-sensitive).\n66\texport function lookupProvider (name:string):BuiltinProvider|undefined {\n67\t    const p = REGISTRY.find(p => p.name === name)\n68\t    return p && copy(p)\n69\t}\n70\t\n71\t// The provider that accepts `protocol` at `endpoint`.\n72\texport function providerAt (\n73\t    endpoint:string,\n74\t    protocol:string\n75\t):BuiltinProvider|undefined {\n76\t    const p = REGISTRY.find(p =>\n77\t        (p.protocols as readonly string[]).includes(protocol) &&\n78\t        sameEndpoint(p.endpoint, endpoint))\n79\t    return p && copy(p)\n80\t}\n81\t\n82\t// The implicit endpoint of a profile that sets none. OpenRouter is never\n83\t// one.\n84\texport function defaultBaseURL (protocol:string):string {\n85\t    return protocol === 'anthropic' ?\n86\t        DEFAULT_ANTHROPIC_BASE_URL :\n87\t        DEFAULT_OPENAI_BASE_URL\n88\t}\n89\t\n90\t// Parses an endpoint with WHATWG URL, or null when it does not parse or\n91\t// has an empty host. WHATWG repairs `https:///v1` and `https:v1` into a\n92\t// host; Go sees an empty one, so text after the scheme must start with\n93\t// `//` and a non-empty authority.\n94\texport function parseEndpoint (s:string):URL|null {\n95\t    const colon = s.indexOf(':')\n96\t    if (colon < 0) return null\n97\t    const rest = s.slice(colon + 1)\n98\t    if (!rest.startsWith('//')) return null\n99\t    const end = rest.slice(2).search(/[/?#]/)\n100\t    const authority = end < 0 ? rest.slice(2) : rest.slice(2, 2 + end)\n101\t    // Userinfo alone (`https://u@/v1`) leaves no host either.\n102\t    if (authority.slice(authority.lastIndexOf('@') + 1) === '') return null\n103\t    let u:URL\n104\t    try {\n105\t        u = new URL(s)\n106\t    } catch {\n107\t        return null\n108\t    }\n109\t    return u.host === '' ? null : u\n110\t}\n111\t\n112\tfunction stripTrailingSlashes (p:string):string {\n113\t    let end = p.length\n114\t    while (end > 0 && p[end - 1] === '/') end--\n115\t    return p.slice(0, end)\n116\t}\n117\t\n118\t// Endpoints compare by scheme and host (case-insensitive), path without\n119\t// trailing slashes, raw query, and userinfo. Unparseable values never\n120\t// match.\n121\texport function sameEndpoint (a:string, b:string):boolean {\n122\t    const left = parseEndpoint(goTrimSpace(a))\n123\t    const right = parseEndpoint(goTrimSpace(b))\n124\t    if (!left || !right) return false\n125\t    return left.protocol === right.protocol &&\n126\t        left.host === right.host &&\n127\t        stripTrailingSlashes(left.pathname) ===\n128\t            stripTrailingSlashes(right.pathname) &&\n129\t        left.search === right.search &&\n130\t        left.username === right.username &&\n131\t        left.password === right.password\n132\t}\n133\t"}]},"parent_tool_use_id":null,"session_id":"9df03491-0f38-46e3-8d74-e94e90d0be62","uuid":"0cfb976d-db92-4b8a-af37-354315b411cf","timestamp":"2026-11-24T21:34:04.659Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-01-starter-role-choice-prefactor/src/config/provider.ts","content":"// The built-in provider registry (spec 02, 2.7): the one place that says\n// which endpoint, protocols, standard key variable, key page, and login\n// method each provider has. Trust standardness, ambient credentials, the\n// `init` starter, and login all consult it.\nimport { goTrimSpace } from '../gocompat/strings.js'\n\nexport const DEFAULT_OPENAI_BASE_URL = 'https://api.openai.com/v1'\nexport const DEFAULT_ANTHROPIC_BASE_URL = 'https://api.anthropic.com/v1'\nexport const OPENROUTER_BASE_URL = 'https://openrouter.ai/api/v1'\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\nexport type LoginMethod = 'paste'|'browser'\n\nexport interface BuiltinProvider {\n    readonly name:string;\n    readonly endpoint:string;\n    // The first is the one starter profiles use.\n    readonly protocols:readonly Protocol[];\n    readonly keyEnv:string;\n    readonly keyPage:string;\n    readonly login:LoginMethod;\n}\n\n// No two entries share an (endpoint, protocol) pair, so providerAt finds\n// at most one. Order matters for withheldKey and listings.\nconst REGISTRY:readonly BuiltinProvider[] = Object.freeze([\n    {\n        name:'openai',\n        endpoint:DEFAULT_OPENAI_BASE_URL,\n        protocols:['responses', 'chat'],\n        keyEnv:'OPENAI_API_KEY',\n        keyPage:'https://platform.openai.com/api-keys',\n        login:'paste',\n    },\n    {\n        name:'anthropic',\n        endpoint:DEFAULT_ANTHROPIC_BASE_URL,\n        protocols:['anthropic'],\n        keyEnv:'ANTHROPIC_API_KEY',\n        keyPage:'https://console.anthropic.com/settings/keys',\n        login:'paste',\n    },\n    {\n        name:'openrouter',\n        endpoint:OPENROUTER_BASE_URL,\n        protocols:['chat', 'responses'],\n        keyEnv:'OPENROUTER_API_KEY',\n        keyPage:'https://openrouter.ai/settings/keys',\n        login:'browser',\n    },\n].map(p => Object.freeze({\n    ...p,\n    protocols:Object.freeze([...p.protocols]) as readonly Protocol[],\n} as BuiltinProvider)))\n\nfunction copy (p:BuiltinProvider):BuiltinProvider {\n    return { ...p, protocols:[...p.protocols] }\n}\n\n// Copies of the registry, in registry order.\nexport function builtinProviders ():BuiltinProvider[] {\n    return REGISTRY.map(copy)\n}\n\n// The provider with exactly this name (case-sensitive).\nexport function lookupProvider (name:string):BuiltinProvider|undefined {\n    const p = REGISTRY.find(p => p.name === name)\n    return p && copy(p)\n}\n\n// The provider that accepts `protocol` at `endpoint`.\nexport function providerAt (\n    endpoint:string,\n    protocol:string\n):BuiltinProvider|undefined {\n    const p = REGISTRY.find(p =>\n        (p.protocols as readonly string[]).includes(protocol) &&\n        sameEndpoint(p.endpoint, endpoint))\n    return p && copy(p)\n}\n\n// The implicit endpoint of a profile that sets none. OpenRouter is never\n// one.\nexport function defaultBaseURL (protocol:string):string {\n    return protocol === 'anthropic' ?\n        DEFAULT_ANTHROPIC_BASE_URL :\n        DEFAULT_OPENAI_BASE_URL\n}\n\n// Parses an endpoint with WHATWG URL, or null when it does not parse or\n// has an empty host. WHATWG repairs `https:///v1` and `https:v1` into a\n// host; Go sees an empty one, so text after the scheme must start with\n// `//` and a non-empty authority.\nexport function parseEndpoint (s:string):URL|null {\n    const colon = s.indexOf(':')\n    if (colon < 0) return null\n    const rest = s.slice(colon + 1)\n    if (!rest.startsWith('//')) return null\n    const end = rest.slice(2).search(/[/?#]/)\n    const authority = end < 0 ? rest.slice(2) : rest.slice(2, 2 + end)\n    // Userinfo alone (`https://u@/v1`) leaves no host either.\n    if (authority.slice(authority.lastIndexOf('@') + 1) === '') return null\n    let u:URL\n    try {\n        u = new URL(s)\n    } catch {\n        return null\n    }\n    return u.host === '' ? null : u\n}\n\nfunction stripTrailingSlashes (p:string):string {\n    let end = p.length\n    while (end > 0 && p[end - 1] === '/') end--\n    return p.slice(0, end)\n}\n\n// Endpoints compare by scheme and host (case-insensitive), path without\n// trailing slashes, raw query, and userinfo. Unparseable values never\n// match.\nexport function sameEndpoint (a:string, b:string):boolean {\n    const left = parseEndpoint(goTrimSpace(a))\n    const right = parseEndpoint(goTrimSpace(b))\n    if (!left || !right) return false\n    return left.protocol === right.protocol &&\n        left.host === right.host &&\n        stripTrailingSlashes(left.pathname) ===\n            stripTrailingSlashes(right.pathname) &&\n        left.search === right.search &&\n        left.username === right.username &&\n        left.password === right.password\n}\n","numLines":133,"startLine":1,"totalLines":133}},"tool_result_meta":[{"id":"toolu_012ABtwdE7SBTnNUCm4Noqn7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
