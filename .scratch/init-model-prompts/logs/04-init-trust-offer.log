{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bs79DET9pxVFWvJPuP6Abb","type":"tool_result","content":"diff --git a/test/cli/init.ts b/test/cli/init.ts\nindex fe8daf9..c577e35 100644\n--- a/test/cli/init.ts\n+++ b/test/cli/init.ts\n@@ -904,3 +904,58 @@ test('init trust offer no leaves unapproved', async t => {\n     t.ok(result.stderr.includes('npx roast trust'),\n         'hint printed')\n })\n+\n+test('init builtin-only config gets no trust offer', async t => {\n+    const repo = tempRepo()\n+    t.cleanup(repo.remove)\n+    simulateTerminals(t, true)\n+    // Two built-in providers, no extra stdin for trust\n+    const stdin = '2\\n\\n1\\n\\n'\n+    const result = await runRoast(\n+        ['init', '--no-login'], {\n+            cwd:repo.dir, env:repo.env, stdin,\n+        })\n+    t.equal(result.code, 0, 'exits 0')\n+    const file = path.join(repo.dir, '.roast.json')\n+    t.ok(fs.existsSync(file), 'config written')\n+    const cfg = loadConfig(file)\n+    const p = trustProjection(cfg)\n+    t.ok(!requiresApproval(p),\n+        'builtin config needs no approval')\n+    t.ok(!result.stderr.includes('Trust this'),\n+        'no trust prompt shown')\n+})\n+\n+test('init EOF at trust offer leaves config not approved',\n+    async t => {\n+        const repo = tempRepo()\n+        t.cleanup(repo.remove)\n+        simulateTerminals(t, true)\n+        // custom finder, builtin verifier, then EOF\n+        const stdin = [\n+            '4',\n+            'http://openai.api.tiiny/v1',\n+            '',\n+            'TIINY_KEY',\n+            'my-model',\n+            '1',\n+            '',\n+        ].join('\\n') + '\\n'\n+        const result = await runRoast(\n+            ['init', '--no-login'], {\n+                cwd:repo.dir, env:repo.env, stdin,\n+            })\n+        t.equal(result.code, 0, 'exits 0')\n+        const file = path.join(repo.dir, '.roast.json')\n+        t.ok(fs.existsSync(file), 'config written')\n+        const cfg = loadConfig(file)\n+        const p = trustProjection(cfg)\n+        t.ok(requiresApproval(p),\n+            'config needs approval')\n+        const hash = trustHash(p)\n+        const state = await isApproved(repo.dir, hash, {\n+            env:repo.env as NodeJS.ProcessEnv,\n+        })\n+        t.equal(state, 'not-approved',\n+            'not approved after EOF')\n+    })","is_error":false}]},"parent_tool_use_id":null,"session_id":"d5fff85d-1c72-432c-ba87-5f843ff95960","uuid":"ccf87b27-3364-428b-b4cb-7df7df9f2e6a","timestamp":"2026-11-24T23:23:00.457Z","tool_use_result":{"stdout":"diff --git a/test/cli/init.ts b/test/cli/init.ts\nindex fe8daf9..c577e35 100644\n--- a/test/cli/init.ts\n+++ b/test/cli/init.ts\n@@ -904,3 +904,58 @@ test('init trust offer no leaves unapproved', async t => {\n     t.ok(result.stderr.includes('npx roast trust'),\n         'hint printed')\n })\n+\n+test('init builtin-only config gets no trust offer', async t => {\n+    const repo = tempRepo()\n+    t.cleanup(repo.remove)\n+    simulateTerminals(t, true)\n+    // Two built-in providers, no extra stdin for trust\n+    const stdin = '2\\n\\n1\\n\\n'\n+    const result = await runRoast(\n+        ['init', '--no-login'], {\n+            cwd:repo.dir, env:repo.env, stdin,\n+        })\n+    t.equal(result.code, 0, 'exits 0')\n+    const file = path.join(repo.dir, '.roast.json')\n+    t.ok(fs.existsSync(file), 'config written')\n+    const cfg = loadConfig(file)\n+    const p = trustProjection(cfg)\n+    t.ok(!requiresApproval(p),\n+        'builtin config needs no approval')\n+    t.ok(!result.stderr.includes('Trust this'),\n+        'no trust prompt shown')\n+})\n+\n+test('init EOF at trust offer leaves config not approved',\n+    async t => {\n+        const repo = tempRepo()\n+        t.cleanup(repo.remove)\n+        simulateTerminals(t, true)\n+        // custom finder, builtin verifier, then EOF\n+        const stdin = [\n+            '4',\n+            'http://openai.api.tiiny/v1',\n+            '',\n+            'TIINY_KEY',\n+            'my-model',\n+            '1',\n+            '',\n+        ].join('\\n') + '\\n'\n+        const result = await runRoast(\n+            ['init', '--no-login'], {\n+                cwd:repo.dir, env:repo.env, stdin,\n+            })\n+        t.equal(result.code, 0, 'exits 0')\n+        const file = path.join(repo.dir, '.roast.json')\n+        t.ok(fs.existsSync(file), 'config written')\n+        const cfg = loadConfig(file)\n+        const p = trustProjection(cfg)\n+        t.ok(requiresApproval(p),\n+            'config needs approval')\n+        const hash = trustHash(p)\n+        const state = await isApproved(repo.dir, hash, {\n+            env:repo.env as NodeJS.ProcessEnv,\n+        })\n+        t.equal(state, 'not-approved',\n+            'not approved after EOF')\n+    })","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Bs79DET9pxVFWvJPuP6Abb","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
