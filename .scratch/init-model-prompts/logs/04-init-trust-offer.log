{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BpoAMTVxZdJiLPm58LcfUX","type":"tool_result","content":"1\t// Per-clone approvals of project configs (spec 03, 2.5 and 2.6). The\n2\t// record lives under the Git common directory, which `git clone` never\n3\t// copies, so a repository cannot ship its own approval.\n4\timport fs from 'node:fs/promises'\n5\timport path from 'node:path'\n6\timport { git } from '../git/git.js'\n7\timport { writeFileAtomic } from '../fsutil/atomic.js'\n8\t\n9\texport const TRUST_FILE = 'trust.json'\n10\tconst CURRENT_VERSION = 2\n11\tconst LEGACY_VERSION = 1\n12\t\n13\texport interface TrustOpts {\n14\t    signal?:AbortSignal;\n15\t    // The git environment, normally the CLI context's env.\n16\t    env?:NodeJS.ProcessEnv;\n17\t}\n18\t\n19\texport type TrustRecord =\n20\t    { kind:'current', approved:string[] }|{ kind:'legacy' }\n21\t\n22\texport type ApprovalState = 'approved'|'not-approved'|'legacy'\n23\t\n24\tfunction message (err:unknown):string {\n25\t    return err instanceof Error ? err.message : String(err)\n26\t}\n27\t\n28\t// <git-common-dir>/roast for the repository containing `dir`. Linked\n29\t// worktrees share the main repository's.\n30\texport async function stateDir (\n31\t    dir:string,\n32\t    opts:TrustOpts = {}\n33\t):Promise<string> {\n34\t    let out:Buffer\n35\t    try {\n36\t        out = await git(dir, ['rev-parse', '--path-format=absolute',\n37\t            '--git-common-dir'], opts)\n38\t    } catch (err) {\n39\t        if (opts.signal?.aborted) throw err\n40\t        throw new Error('not inside a git repository', { cause:err })\n41\t    }\n42\t    return path.join(out.toString('utf8').trim(), 'roast')\n43\t}\n44\t\n45\texport async function trustPath (\n46\t    dir:string,\n47\t    opts:TrustOpts = {}\n48\t):Promise<string> {\n49\t    try {\n50\t        return path.join(await stateDir(dir, opts), TRUST_FILE)\n51\t    } catch (err) {\n52\t        if (opts.signal?.aborted) throw err\n53\t        throw new Error(`trust: ${message(err)}`, { cause:err })\n54\t    }\n55\t}\n56\t\n57\tfunction isObject (v:unknown):v is Record<string, unknown> {\n58\t    return typeof v === 'object' && v !== null && !Array.isArray(v)\n59\t}\n60\t\n61\t// Reads the record at `file`. An absent file is an empty current record;\n62\t// a version 1 file (Go era) is legacy; anything else is an error.\n63\texport async function readTrustRecord (file:string):Promise<TrustRecord> {\n64\t    let text:string\n65\t    try {\n66\t        text = await fs.readFile(file, 'utf8')\n67\t    } catch (err) {\n68\t        if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n69\t            return { kind:'current', approved:[] }\n70\t        }\n71\t        throw new Error(`read trust record: ${message(err)}`, { cause:err })\n72\t    }\n73\t    const invalid = (cause:string):Error =>\n74\t        new Error(`read trust record ${file}: ${cause}`)\n75\t    let doc:unknown\n76\t    try {\n77\t        doc = JSON.parse(text)\n78\t    } catch (err) {\n79\t        throw invalid(message(err))\n80\t    }\n81\t    if (!isObject(doc)) throw invalid('not a JSON object')\n82\t    const version = doc.version\n83\t    if (version === LEGACY_VERSION) return { kind:'legacy' }\n84\t    if (version !== CURRENT_VERSION) {\n85\t        const shown = version === undefined ? 0 : JSON.stringify(version)\n86\t        throw new Error(`trust record ${file} has unsupported version ` +\n87\t            `${shown}`)\n88\t    }\n89\t    const approved = doc.approved ?? []\n90\t    if (!Array.isArray(approved) ||\n91\t        !approved.every(h => typeof h === 'string')) {\n92\t        throw invalid('approved must be an array of strings')\n93\t    }\n94\t    return { kind:'current', approved }\n95\t}\n96\t\n97\texport async function isApproved (\n98\t    dir:string,\n99\t    hash:string,\n100\t    opts:TrustOpts = {}\n101\t):Promise<ApprovalState> {\n102\t    const rec = await readTrustRecord(await trustPath(dir, opts))\n103\t    if (rec.kind === 'legacy') return 'legacy'\n104\t    return rec.approved.includes(hash) ? 'approved' : 'not-approved'\n105\t}\n106\t\n107\t// Records `hash` for this clone. A legacy record is replaced, not\n108\t// migrated; a malformed one aborts with the file untouched.\n109\texport async function approve (\n110\t    dir:string,\n111\t    hash:string,\n112\t    opts:TrustOpts = {}\n113\t):Promise<void> {\n114\t    const file = await trustPath(dir, opts)\n115\t    const rec = await readTrustRecord(file)\n116\t    let approved = [hash]\n117\t    if (rec.kind === 'current') {\n118\t        if (rec.approved.includes(hash)) return\n119\t        approved = [...rec.approved, hash]\n120\t    }\n121\t    const body = { version:CURRENT_VERSION, approved }\n122\t    await writeFileAtomic(file, JSON.stringify(body, null, 2) + '\\n', {\n123\t        mode:0o600,\n124\t        tempPrefix:'trust-',\n125\t        tempSuffix:'.json',\n126\t        dirMode:0o755,\n127\t        errorPrefix:'write trust record',\n128\t    })\n129\t}\n130\t"}]},"parent_tool_use_id":null,"session_id":"d5fff85d-1c72-432c-ba87-5f843ff95960","uuid":"45d8655b-1c3d-4631-8989-ced30c030edc","timestamp":"2026-11-24T22:46:34.576Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-04-init-trust-offer/src/trust/trust.ts","content":"// Per-clone approvals of project configs (spec 03, 2.5 and 2.6). The\n// record lives under the Git common directory, which `git clone` never\n// copies, so a repository cannot ship its own approval.\nimport fs from 'node:fs/promises'\nimport path from 'node:path'\nimport { git } from '../git/git.js'\nimport { writeFileAtomic } from '../fsutil/atomic.js'\n\nexport const TRUST_FILE = 'trust.json'\nconst CURRENT_VERSION = 2\nconst LEGACY_VERSION = 1\n\nexport interface TrustOpts {\n    signal?:AbortSignal;\n    // The git environment, normally the CLI context's env.\n    env?:NodeJS.ProcessEnv;\n}\n\nexport type TrustRecord =\n    { kind:'current', approved:string[] }|{ kind:'legacy' }\n\nexport type ApprovalState = 'approved'|'not-approved'|'legacy'\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\n// <git-common-dir>/roast for the repository containing `dir`. Linked\n// worktrees share the main repository's.\nexport async function stateDir (\n    dir:string,\n    opts:TrustOpts = {}\n):Promise<string> {\n    let out:Buffer\n    try {\n        out = await git(dir, ['rev-parse', '--path-format=absolute',\n            '--git-common-dir'], opts)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error('not inside a git repository', { cause:err })\n    }\n    return path.join(out.toString('utf8').trim(), 'roast')\n}\n\nexport async function trustPath (\n    dir:string,\n    opts:TrustOpts = {}\n):Promise<string> {\n    try {\n        return path.join(await stateDir(dir, opts), TRUST_FILE)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error(`trust: ${message(err)}`, { cause:err })\n    }\n}\n\nfunction isObject (v:unknown):v is Record<string, unknown> {\n    return typeof v === 'object' && v !== null && !Array.isArray(v)\n}\n\n// Reads the record at `file`. An absent file is an empty current record;\n// a version 1 file (Go era) is legacy; anything else is an error.\nexport async function readTrustRecord (file:string):Promise<TrustRecord> {\n    let text:string\n    try {\n        text = await fs.readFile(file, 'utf8')\n    } catch (err) {\n        if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n            return { kind:'current', approved:[] }\n        }\n        throw new Error(`read trust record: ${message(err)}`, { cause:err })\n    }\n    const invalid = (cause:string):Error =>\n        new Error(`read trust record ${file}: ${cause}`)\n    let doc:unknown\n    try {\n        doc = JSON.parse(text)\n    } catch (err) {\n        throw invalid(message(err))\n    }\n    if (!isObject(doc)) throw invalid('not a JSON object')\n    const version = doc.version\n    if (version === LEGACY_VERSION) return { kind:'legacy' }\n    if (version !== CURRENT_VERSION) {\n        const shown = version === undefined ? 0 : JSON.stringify(version)\n        throw new Error(`trust record ${file} has unsupported version ` +\n            `${shown}`)\n    }\n    const approved = doc.approved ?? []\n    if (!Array.isArray(approved) ||\n        !approved.every(h => typeof h === 'string')) {\n        throw invalid('approved must be an array of strings')\n    }\n    return { kind:'current', approved }\n}\n\nexport async function isApproved (\n    dir:string,\n    hash:string,\n    opts:TrustOpts = {}\n):Promise<ApprovalState> {\n    const rec = await readTrustRecord(await trustPath(dir, opts))\n    if (rec.kind === 'legacy') return 'legacy'\n    return rec.approved.includes(hash) ? 'approved' : 'not-approved'\n}\n\n// Records `hash` for this clone. A legacy record is replaced, not\n// migrated; a malformed one aborts with the file untouched.\nexport async function approve (\n    dir:string,\n    hash:string,\n    opts:TrustOpts = {}\n):Promise<void> {\n    const file = await trustPath(dir, opts)\n    const rec = await readTrustRecord(file)\n    let approved = [hash]\n    if (rec.kind === 'current') {\n        if (rec.approved.includes(hash)) return\n        approved = [...rec.approved, hash]\n    }\n    const body = { version:CURRENT_VERSION, approved }\n    await writeFileAtomic(file, JSON.stringify(body, null, 2) + '\\n', {\n        mode:0o600,\n        tempPrefix:'trust-',\n        tempSuffix:'.json',\n        dirMode:0o755,\n        errorPrefix:'write trust record',\n    })\n}\n","numLines":130,"startLine":1,"totalLines":130}},"tool_result_meta":[{"id":"toolu_01BpoAMTVxZdJiLPm58LcfUX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
