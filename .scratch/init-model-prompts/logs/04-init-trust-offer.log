{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019MqfWFifRju3PFQbARy5NR","type":"tool_result","content":"1\t// Shared terminal helpers (spec 01, 2.16): yes/no prompt, secret input,\n2\t// terminal detection, browser opening. Terminal detection and browser\n3\t// opening are swappable through `terminalHooks` so tests never touch a\n4\t// real terminal or launch a browser.\n5\timport { spawn } from 'node:child_process'\n6\timport { isatty } from 'node:tty'\n7\timport { goTrimSpace } from '../gocompat/strings.js'\n8\timport { CancelledError } from './errors.js'\n9\t\n10\t// Reads a stream one character or line at a time. One reader serves every\n11\t// prompt in a command, so input buffered past one answer is kept for the\n12\t// next. The stream is attached lazily, on the first read.\n13\texport class LineReader {\n14\t    private readonly stream:NodeJS.ReadableStream\n15\t    private buf = ''\n16\t    private ended = false\n17\t    private error:Error|undefined\n18\t    private attached = false\n19\t    private wake:(() => void)|undefined\n20\t\n21\t    constructor (stream:NodeJS.ReadableStream) {\n22\t        this.stream = stream\n23\t    }\n24\t\n25\t    private attach ():void {\n26\t        if (this.attached) return\n27\t        this.attached = true\n28\t        const notify = ():void => {\n29\t            const w = this.wake\n30\t            this.wake = undefined\n31\t            w?.()\n32\t        }\n33\t        this.stream.setEncoding('utf8')\n34\t        this.stream.on('data', (chunk:string) => {\n35\t            this.buf += chunk\n36\t            notify()\n37\t        })\n38\t        this.stream.on('end', () => {\n39\t            this.ended = true\n40\t            notify()\n41\t        })\n42\t        this.stream.on('error', (err:Error) => {\n43\t            this.error = err\n44\t            notify()\n45\t        })\n46\t    }\n47\t\n48\t    // Waits until the buffer holds data, the stream ended, or failed.\n49\t    private async fill ():Promise<void> {\n50\t        this.attach()\n51\t        while (this.buf === '' && !this.ended && !this.error) {\n52\t            this.stream.resume()\n53\t            await new Promise<void>(resolve => { this.wake = resolve })\n54\t        }\n55\t        this.stream.pause()\n56\t        if (this.buf === '' && this.error) throw this.error\n57\t    }\n58\t\n59\t    // The next character, or null at end of input.\n60\t    async readChar ():Promise<string|null> {\n61\t        await this.fill()\n62\t        if (this.buf === '') return null\n63\t        const c = String.fromCodePoint(this.buf.codePointAt(0) as number)\n64\t        this.buf = this.buf.slice(c.length)\n65\t        return c\n66\t    }\n67\t\n68\t    // The next line without its line ending, or null at end of input with\n69\t    // nothing read. A last line without a newline is returned as is.\n70\t    async readLine ():Promise<string|null> {\n71\t        let line = ''\n72\t        for (;;) {\n73\t            await this.fill()\n74\t            if (this.buf === '') return line === '' ? null : line\n75\t            const i = this.buf.indexOf('\\n')\n76\t            if (i >= 0) {\n77\t                line += this.buf.slice(0, i)\n78\t                this.buf = this.buf.slice(i + 1)\n79\t                return line.endsWith('\\r') ? line.slice(0, -1) : line\n80\t            }\n81\t            line += this.buf\n82\t            this.buf = ''\n83\t        }\n84\t    }\n85\t}\n86\t\n87\t// Writes `<question> [Y/n] ` and reads one answer: empty, y, or yes (any\n88\t// case) is true; anything else, or end of input, is false.\n89\texport async function promptYesDefault (\n90\t    out:NodeJS.WritableStream,\n91\t    lines:LineReader,\n92\t    question:string\n93\t):Promise<boolean> {\n94\t    out.write(`${question} [Y/n] `)\n95\t    const answer = await lines.readLine()\n96\t    if (answer === null) return false\n97\t    const a = goTrimSpace(answer).toLowerCase()\n98\t    return a === '' || a === 'y' || a === 'yes'\n99\t}\n100\t\n101\t// Writes `<question> [y/N] ` and reads one answer: only y or yes (any\n102\t// case, surrounding space ignored) is true; empty input, anything else,\n103\t// or end of input is false.\n104\texport async function promptNoDefault (\n105\t    out:NodeJS.WritableStream,\n106\t    lines:LineReader,\n107\t    question:string\n108\t):Promise<boolean> {\n109\t    out.write(`${question} [y/N] `)\n110\t    const answer = await lines.readLine()\n111\t    if (answer === null) return false\n112\t    const a = goTrimSpace(answer).toLowerCase()\n113\t    return a === 'y' || a === 'yes'\n114\t}\n115\t\n116\tinterface RawTTY {\n117\t    isTTY?:boolean;\n118\t    setRawMode?:(on:boolean) => unknown;\n119\t}\n120\t\n121\tfunction rawCapable (stdin:NodeJS.ReadableStream):stdin is\n122\t    NodeJS.ReadableStream&Required<RawTTY> {\n123\t    const s = stdin as NodeJS.ReadableStream&RawTTY\n124\t    return s.isTTY === true && typeof s.setRawMode === 'function'\n125\t}\n126\t\n127\tconst CTRL_C = '\\x03'\n128\tconst CTRL_D = '\\x04'\n129\tconst BACKSPACE = '\\x08'\n130\tconst DELETE = '\\x7f'\n131\t\n132\t// Reads one line in raw mode without echo. Ctrl-C cancels.\n133\tasync function readRawLine (lines:LineReader):Promise<string|null> {\n134\t    let line = ''\n135\t    for (;;) {\n136\t        const c = await lines.readChar()\n137\t        if (c === null) return line === '' ? null : line\n138\t        if (c === '\\r' || c === '\\n') return line\n139\t        if (c === CTRL_C) throw new CancelledError()\n140\t        if (c === CTRL_D && line === '') return null\n141\t        if (c === BACKSPACE || c === DELETE) {\n142\t            line = line.slice(0, -1)\n143\t            continue\n144\t        }\n145\t        line += c\n146\t    }\n147\t}\n148\t\n149\t// Writes `prompt` and reads one secret. On a TTY it reads in raw mode\n150\t// without echo (Ctrl-C is cancellation); otherwise one plain line from\n151\t// the shared reader. The result is trimmed; end of input with