{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GgGb1FBshFNDrAUjzAcRiz","type":"tool_result","content":"1\t// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n2\t// order when the test body finishes, pass or fail.\n3\timport { test as tapTest, type Test } from '@substrate-system/tapzero'\n4\t\n5\texport type CleanupTest = Test&{\n6\t    cleanup (fn:() => void|Promise<void>):void;\n7\t}\n8\t\n9\texport function test (\n10\t    name:string,\n11\t    fn:(t:CleanupTest) => void|Promise<void>\n12\t):void {\n13\t    tapTest(name, async t => {\n14\t        const cleanups:(() => void|Promise<void>)[] = []\n15\t        const ct = Object.assign(t, {\n16\t            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n17\t        })\n18\t        try {\n19\t            await fn(ct)\n20\t        } finally {\n21\t            for (const f of cleanups.reverse()) await f()\n22\t        }\n23\t    })\n24\t}\n25\t"}]},"parent_tool_use_id":null,"session_id":"d5fff85d-1c72-432c-ba87-5f843ff95960","uuid":"36e8a820-d4ef-4b6c-92ba-6a1c2b5b64f3","timestamp":"2026-11-24T22:50:58.717Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.init-model-prompts-04-init-trust-offer/test/helpers/test.ts","content":"// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\n","numLines":25,"startLine":1,"totalLines":25}},"tool_result_meta":[{"id":"toolu_01GgGb1FBshFNDrAUjzAcRiz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
