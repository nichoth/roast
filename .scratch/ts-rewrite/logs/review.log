ath.ts>|--live], ' +\n         `got ${args.join(' ')}`)\n }\n \n@@ -126,9 +125,6 @@ async function main ():Promise<void> {\n     if (mode.kind === 'test-file') {\n         return bundleTests(mode.file, 'test/one-bundle.js')\n     }\n-    if (mode.kind === 'diff') {\n-        return bundleTests('test/diff/index.ts', 'test/diff-bundle.js')\n-    }\n     return bundleTests('test/live/index.ts', 'test/live-bundle.js')\n }\n \n// The slimmed package check (spec 15, 2.10). Operates on process.cwd()\n// so tests can run it in a fixture. Run by `npm run check:pack` after a\n// build, in CI and in prepublishOnly. Run directly by Node (type\n// stripping), so only erasable TypeScript syntax is allowed here.\nimport { spawnSync } from 'node:child_process'\nimport { closeSync, openSync, readFileSync, readSync, statSync } from 'node:fs'\nimport { join } from 'node:path'\n\nconst REQUIRED_FILES = [\n    'dist/cli.js',\n    'dist/THIRD_PARTY_LICENSES.txt',\n    'roast.schema.json',\n    'LICENSE.txt',\n    'LICENSE-MIT.txt',\n    'LICENSE-APACHE.txt',\n]\n\nconst SHEBANG = '#!/usr/bin/env node\\n'\n\ninterface PackResult {\n    files?:Array<{ path?:unknown }>;\n}\n\n// The paths `npm pack --dry-run --json` would put in the tarball. npm 12\n// prints an object keyed by package name, older npm an array.\nfunction packedFiles (cwd:string):Set<string> {\n    const res = spawnSync('npm', ['pack', '--dry-run', '--json'], {\n        cwd,\n        encoding:'utf8',\n    })\n    if (res.error) throw res.error\n    if (res.status !== 0) {\n        process.stderr.write(res.stderr)\n        throw new Error(`npm pack --dry-run exited ${res.status}`)\n    }\n    const parsed:unknown = JSON.parse(res.stdout)\n    const results = (Array.isArray(parsed) ?\n        parsed :\n        Object.values(parsed as Record<string, unknown>)) as PackResult[]\n    if (results.length !== 1) {\n        throw new Error(`npm pack reported ${results.length} packages, ` +\n            'expected 1')\n    }\n    const files = results[0]?.files ?? []\n    return new Set(files.map(file => String(file.path)))\n}\n\nfunction manifestProblems (manifest:Record<string, unknown>):string[] {\n    const problems:string[] = []\n    if (typeof manifest.license !== 'string' || manifest.license === '') {\n        problems.push('package.json declares no license')\n    }\n    const deps = manifest.dependencies\n    if (deps !== undefined &&\n        (typeof deps !== 'object' || deps === null ||\n            Object.keys(deps).length > 0)) {\n        problems.push('package.json declares dependencies; everything ' +\n            'Roast runs must be bundled into dist/cli.js')\n    }\n    if (manifest.optionalDependencies !== undefined) {\n        problems.push('package.json declares optionalDependencies')\n    }\n    return problems\n}\n\nfunction cliProblems (path:string):string[] {\n    let fd:number\n    try {\n        fd = openSync(path, 'r')\n    } catch {\n        return [] // the tarball check already reports a missing file\n    }\n    const head = Buffer.alloc(SHEBANG.length)\n    try {\n        readSync(fd, head, 0, head.length, 0)\n    } finally {\n        closeSync(fd)\n    }\n    const problems:string[] = []\n    if (head.toString('utf8') !== SHEBANG) {\n        problems.push(`dist/cli.js does not start with ${\n            JSON.stringify(SHEBANG)}`)\n    }\n    if ((statSync(path).mode & 0o100) === 0) {\n        problems.push('dist/cli.js is not executable by its owner')\n    }\n    return problems\n}\n\nfunction main ():number {\n    const cwd = process.cwd()\n    const manifest = JSON.parse(readFileSync(join(cwd, 'package.json'),\n        'utf8')) as Record<string, unknown>\n    const packed = packedFiles(cwd)\n    const problems = [\n        ...REQUIRED_FILES\n            .filter(file => !packed.has(file))\n            .map(file => `the tarball does not contain ${file}`),\n        ...manifestProblems(manifest),\n        ...cliProblems(join(cwd, 'dist', 'cli.js')),\n    ]\n    if (problems.length > 0) {\n        for (const problem of problems) {\n            console.error(`packaging check failed: ${problem}`)\n        }\n        console.error('hint: run `npm run build`, then check the `files` ' +\n            'list in package.json')\n        return 1\n    }\n    console.log(`packaging check passed: ${packed.size} files, ` +\n        `${REQUIRED_FILES.length} required files present`)\n    return 0\n}\n\ntry {\n    process.exitCode = main()\n} catch (err) {\n    console.error(`packaging check failed: ${\n        err instanceof Error ? err.message : String(err)}`)\n    process.exitCode = 1\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WHDvHUDkpARk6Zt4qzqwqN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rhx3Q73F3WpViDDJBrf4dD","type":"tool_result","content":"// The snapshot capture decision for a review (spec 01, 2.13). The\n// snapshot area's functions are injected so the decision is testable\n// without Git.\nimport type { GitRunOpts } from '../git/git.js'\nimport type { SnapshotMeta } from '../record/meta-types.js'\nimport type { Scope } from '../scope/index.js'\nimport {\n    type Pin,\n    capture,\n    headOid,\n    revOid,\n    treeOid,\n} from '../snapshot/snapshot.js'\n\n// A pinned worktree tree (snapshot area pinWorktree); null when none.\nexport type WorktreePin = Pin|null\n\nexport interface CaptureOptions {\n    runId:string;\n    headOID:string;\n    baseOID:string;\n    indexTree:string;\n    worktree:WorktreePin;\n}\n\nexport interface Capture {\n    ref:string;\n    commit:string;\n    indexTree:string;\n    worktreeTree:string;\n    head:string;\n    base:string;\n    excluded:string[];\n}\n\nexport interface SnapshotDeps {\n    capture (repo:string, opts:CaptureOptions):Promise<Capture>;\n    // Each resolves '' when the revision does not resolve.\n    headOID (repo:string):Promise<string>;\n    revOID (repo:string, rev:string):Promise<string>;\n    treeOID (repo:string, rev:string):Promise<string>;\n}\n\nexport const DISABLED_REASON = 'disabled by review.snapshot'\nexport const DISABLED_CAVEAT =\n    'Git snapshot capture was disabled; this run cannot be replayed.'\nexport const FILE_MODES = 'regular and executable files plus symlinks; ' +\n    'empty directories are not represented'\n\nexport function defaultSnapshotDeps (opts:GitRunOpts):SnapshotDeps {\n    const o = { env:opts.env, signal:opts.signal }\n    return {\n        capture:(repo, c) => capture(repo, {\n            runId:c.runId,\n            headOid:c.headOID,\n            baseOid:c.baseOID,\n            indexTree:c.indexTree,\n            worktree:c.worktree,\n            ...o,\n        }),\n        headOID:repo => headOid(repo, o),\n        revOID:(repo, rev) => revOid(repo, rev, o),\n        treeOID:(repo, rev) => treeOid(repo, rev, o),\n    }\n}\n\nexport interface SnapshotDecision {\n    meta:SnapshotMeta;\n    caveats:string[];\n}\n\nexport async function captureSnapshot (\n    enabled:boolean,\n    repo:string,\n    runId:string,\n    scope:Pick<Scope, 'headOID'|'base'|'staged'|'survey'>,\n    indexTree:string,\n    pin:WorktreePin,\n    deps:SnapshotDeps\n):Promise<SnapshotDecision> {\n    if (!enabled) {\n        return {\n            meta:{ captured:false, reason:DISABLED_REASON },\n            caveats:[DISABLED_CAVEAT],\n        }\n    }\n    const head = scope.headOID || await deps.headOID(repo)\n    const base = scope.base !== '' ? await deps.revOID(repo, scope.base) : ''\n    let snap:Capture\n    try {\n        snap = await deps.capture(repo, {\n            runId, headOID:head, baseOID:base, indexTree, worktree:pin,\n        })\n    } catch (err) {\n        const reason = err instanceof Error ? err.message : String(err)\n        return {\n            meta:{ captured:false, reason, head, base },\n            caveats:[`Git snapshot capture failed: ${reason}`],\n        }\n    }\n    const diffPair = scope.staged ? 'head..index' :\n        scope.survey ? 'head' :\n            scope.base === '' ? 'head..worktree' : 'base..worktree'\n    const meta:SnapshotMeta = {\n        captured:true,\n        ref:snap.ref,\n        commit:snap.commit,\n        index_tree:snap.indexTree,\n        worktree_tree:snap.worktreeTree,\n        head:snap.head,\n        base:snap.base,\n        diff_pair:diffPair,\n        file_modes:FILE_MODES,\n        excluded_paths:[...snap.excluded],\n    }\n    const src = diffPair === 'base..worktree' ? base : head\n    if (src !== '') meta.base_tree = await deps.treeOID(repo, src)\n    const caveats = snap.excluded.length > 0 ?\n        [`snapshot excluded ${snap.excluded.length} denylisted untracked ` +\n            'path(s)'] :\n        []\n    return { meta, caveats }\n}\n// The secret denylist (spec 11, \"Secret denylist\"): untracked paths that\n// are never folded into a review diff, captured into a snapshot, or\n// served from the live working tree.\nimport { goPathMatch } from '../gocompat/match.js'\nimport { git } from '../git/git.js'\nimport { compareBytes, decodePaths } from '../scope/text.js'\n\n// SSH keys match by key-type prefix so suffixed names are covered; a bare\n// `id_*` would also drop ordinary sources such as id_map.go.\nexport const DEFAULT_DENYLIST:readonly string[] = Object.freeze([\n    '.env*', '*.pem', '*_rsa', '*.key', 'creds*',\n    'id_rsa*', 'id_dsa*', 'id_ecdsa*', 'id_ed25519*', 'id_xmss*',\n    'credentials.json', '.npmrc', '.pypirc', '.netrc', '_netrc', '.pgpass',\n    '.git-credentials', '*.p12', '*.pfx',\n])\n\nfunction basename (p:string):string {\n    const i = p.lastIndexOf('/')\n    return i === -1 ? p : p.slice(i + 1)\n}\n\n// Whether a repo-relative `/`-separated path matches any pattern, by its\n// basename or its full path, case-insensitively. A malformed pattern\n// never matches.\nexport function denylisted (\n    path:string,\n    patterns:readonly string[] = DEFAULT_DENYLIST\n):boolean {\n    const full = path.toLowerCase()\n    const base = basename(full)\n    return patterns.some(pattern => {\n        const p = pattern.toLowerCase()\n        return goPathMatch(p, base) || goPathMatch(p, full)\n    })\n}\n\nexport interface DenylistedUntrackedOpts {\n    // Omitted means DEFAULT_DENYLIST; an empty list disables filtering.\n    patterns?:readonly string[];\n    signal?:AbortSignal;\n    env?:NodeJS.ProcessEnv;\n}\n\n// The untracked, non-ignored paths matching the denylist, in byte order.\n// Tracked files are never listed: their content is already in history.\nexport async function denylistedUntracked (\n    repo:string,\n    opts:DenylistedUntrackedOpts = {}\n):Promise<string[]> {\n    const patterns = opts.patterns ?? DEFAULT_DENYLIST\n    if (patterns.length === 0) return []\n    const out = await git(repo,\n        ['ls-files', '--others', '--exclude-standard', '-z'],\n        { signal:opts.signal, env:opts.env })\n    return decodePaths(out).paths\n        .filter(p => p !== '' && denylisted(p, patterns))\n        .sort(compareBytes)\n}\nAGENTS.md\ndir.ts\nfindings.ts\nindex-file.ts\nindex-line.ts\njson.ts\nmeta-json.ts\nmeta-read.ts\nmeta-types.ts\nmeta.ts\nresponses.ts\nrun-id.ts","is_error":false}]},"parent_tool_use_id":"toolu_01Tw6eUvmTfMfsVNapeDwjUZ","agent_id":"acf0b2540a7701a5f","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"67768730-b67d-4c70-847f-2979815ae68d","timestamp":"2026-11-24T04:04:04.048Z","tool_result_meta":[{"id":"toolu_01Rhx3Q73F3WpViDDJBrf4dD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review snapshot/runs/survey"}
