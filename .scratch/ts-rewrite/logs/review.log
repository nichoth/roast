{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FjDrUQmDDZYFQmRfqbKSiL","type":"tool_result","content":"1\t// Review snapshots (spec 11): the worktree pin, the replayable capture\n2\t// under refs/roast/snapshots/, its deletion, and revision lookups. The\n3\t// live index and the working tree are never written.\n4\timport fs from 'node:fs/promises'\n5\timport os from 'node:os'\n6\timport path from 'node:path'\n7\timport { git } from '../git/git.js'\n8\timport { denylistedUntracked } from './denylist.js'\n9\t\n10\texport const REF_PREFIX = 'refs/roast/snapshots/'\n11\texport const DEFAULT_REF_RETENTION_MS = 30 * 24 * 3600 * 1000\n12\t\n13\t// Added to commit-tree only: capture works without user.email and never\n14\t// attributes Roast's object to the user. Dates are not overridden.\n15\tconst IDENTITY:Record<string, string> = {\n16\t    GIT_AUTHOR_NAME:'roast',\n17\t    GIT_AUTHOR_EMAIL:'roast@localhost',\n18\t    GIT_COMMITTER_NAME:'roast',\n19\t    GIT_COMMITTER_EMAIL:'roast@localhost',\n20\t}\n21\t\n22\texport interface Pin {\n23\t    tree:string;\n24\t    excluded:string[];\n25\t}\n26\t\n27\texport interface Snapshot {\n28\t    ref:string;\n29\t    commit:string;\n30\t    indexTree:string;\n31\t    worktreeTree:string;\n32\t    head:string;\n33\t    base:string;\n34\t    excluded:string[];\n35\t}\n36\t\n37\texport interface SnapshotOpts {\n38\t    signal?:AbortSignal;\n39\t    // The environment git runs with (and GIT_INDEX_FILE is read from);\n40\t    // process.env when absent.\n41\t    env?:NodeJS.ProcessEnv;\n42\t}\n43\t\n44\texport interface PinOptions extends SnapshotOpts {\n45\t    // Omitted means the default denylist; empty disables filtering.\n46\t    denylist?:readonly string[];\n47\t}\n48\t\n49\texport interface CaptureOptions extends PinOptions {\n50\t    runId:string;\n51\t    headOid:string;\n52\t    baseOid:string;\n53\t    // An index tree already pinned by the caller (staged reviews).\n54\t    indexTree?:string;\n55\t    // A worktree pin already taken by the caller.\n56\t    worktree?:Pin|null;\n57\t}\n58\t\n59\tfunction message (err:unknown):string {\n60\t    return err instanceof Error ? err.message : String(err)\n61\t}\n62\t\n63\tfunction wrap (prefix:string, err:unknown):Error {\n64\t    return new Error(`${prefix}: ${message(err)}`, { cause:err })\n65\t}\n66\t\n67\tasync function run (\n68\t    repo:string,\n69\t    args:readonly string[],\n70\t    opts:SnapshotOpts,\n71\t    extra?:{ env?:Record<string, string>, input?:string }\n72\t):Promise<string> {\n73\t    const out = await git(repo, args, {\n74\t        signal:opts.signal,\n75\t        env:opts.env,\n76\t        extraEnv:extra?.env,\n77\t        input:extra?.input,\n78\t    })\n79\t    return out.toString('utf8').trim()\n80\t}\n81\t\n82\t// Runs a git step, wrapping a failure with `prefix` unless aborted.\n83\tasync function step (\n84\t    prefix:string,\n85\t    opts:SnapshotOpts,\n86\t    fn:() => Promise<string>\n87\t):Promise<string> {\n88\t    try {\n89\t        return await fn()\n90\t    } catch (err) {\n91\t        opts.signal?.throwIfAborted()\n92\t        throw wrap(prefix, err)\n93\t    }\n94\t}\n95\t\n96\t// The index a review reads: GIT_INDEX_FILE from `env` (relative values\n97\t// against the toplevel `repo`), else `<gitDir>/index`.\n98\texport function liveIndexPath (\n99\t    repo:string,\n100\t    gitDir:string,\n101\t    env:NodeJS.ProcessEnv\n102\t):string {\n103\t    const live = env.GIT_INDEX_FILE ?? ''\n104\t    if (live === '') return path.join(gitDir, 'index')\n105\t    return path.isAbsolute(live) ? live : path.join(repo, live)\n106\t}\n107\t\n108\t// Copies an index byte for byte to `dst` (mode 0600, truncating). A\n109\t// missing source writes nothing: git treats it as an empty index.\n110\texport async function copyIndex (src:string, dst:string):Promise<void> {\n111\t    let data:Buffer\n112\t    try {\n113\t        data = await fs.readFile(src)\n114\t    } catch (err) {\n115\t        if ((err as NodeJS.ErrnoException).code === 'ENOENT') return\n116\t        throw wrap(`read ${src}`, err)\n117\t    }\n118\t    let fh:fs.FileHandle\n119\t    try {\n120\t        fh = await fs.open(dst, 'w', 0o600)\n121\t    } catch (err) {\n122\t        throw wrap(`create ${dst}`, err)\n123\t    }\n124\t    try {\n125\t        await fh.writeFile(data)\n126\t    } catch (err) {\n127\t        throw wrap('copy index', err)\n128\t    } finally {\n129\t        await fh.close()\n130\t    }\n131\t}\n132\t\n133\tfunction gitDirOf (repo:string, opts:SnapshotOpts):Promise<string> {\n134\t    return step('resolve git dir', opts,\n135\t        () => run(repo, ['rev-parse', '--absolute-git-dir'], opts))\n136\t}\n137\t\n138\tasync function withTempDir<T> (\n139\t    prefix:string,\n140\t    fn:(dir:string) => Promise<T>\n141\t):Promise<T> {\n142\t    let tmp:string\n143\t    try {\n144\t        tmp = await fs.mkdtemp(path.join(os.tmpdir(), prefix))\n145\t    } catch (err) {\n146\t        throw wrap('temp dir', err)\n147\t    }\n148\t    try {\n149\t        return await fn(tmp)\n150\t    } finally {\n151\t        await fs.rm(tmp, { recursive:true, force:true })\n152\t    }\n153\t}\n154\t\n155\t// Pin steps 3-7 inside `tmp`: the worktree written through a private\n156\t// copy of the live index, with denylisted untracked paths excluded.\n157\tasync function writeWorktree (\n158\t    repo:string,\n159\t    live:string,\n160\t    tmp:string,\n161\t    opts:PinOptions\n162\t):Promise<Pin> {\n163\t    const idx = path.join(tmp, 'worktree')\n164\t    await copyIndex(live, idx)\n165\t    const excluded = await denylistedUntracked(repo, {\n166\t        patterns:opts.denylist, signal:opts.signal, env:opts.env,\n167\t    })\n168\t    const env = { GIT_INDEX_FILE:idx }\n169\t    // The positive `.` is required: an exclude-only pathspec matches\n170\t    // nothing. `literal` keeps metacharacters in names from widening.\n171\t    const args = ['add', '-A', '--', '.',\n172\t        ...excluded.map(p => `:(exclude,literal)${p}`)]\n173\t    await step('git add -A (snapshot index)', opts,\n174\t        () => run(repo, args, opts, { env }))\n175\t    const tree = await step('write-tree (worktree)', opts,\n176\t        () => run(repo, ['write-tree'], opts, { env }))\n177\t    return { tree, excluded }\n178\t}\n179\t\n180\t// Writes the working tree, as a review sees it, into one unreferenced\n181\t// tree object. Needs no HEAD and leaves the live index untouched.\n182\texport async function pinWorktree (\n183\t    repo:string,\n184\t    opts:PinOptions = {}\n185\t):Promise<Pin> {\n186\t    const gitDir = await gitDirOf(repo, opts)\n187\t    const live = liveIndexPath(repo, gitDir, opts.env ?? process.env)\n188\t    return withTempDir('roast-pin-',\n189\t        tmp => writeWorktree(repo, live, tmp, opts))\n190\t}\n191\t\n192\t// Records a replayable snapshot: index and worktree trees joined in one\n193\t// composite tree, committed on HEAD (and a differing base), and pointed\n194\t// at by refs/roast/snapshots/<runId>. Throws rather than returning a\n195\t// partial snapshot.\n196\texport async function capture (\n197\t    repo:string,\n198\t    opts:CaptureOptions\n199\t):Promise<Snapshot> {\n200\t    if (opts.runId === '') throw new Error('snapshot: empty run id')\n201\t    if (opts.headOid === '') {\n202\t        throw new Error('repository has no commits; an unborn HEAD ' +\n203\t            'cannot be restored, so no replayable snapshot is possible')\n204\t    }\n205\t    const gitDir = await gitDirOf(repo, opts)\n206\t    const live = liveIndexPath(repo, gitDir, opts.env ?? process.env)\n207\t    return withTempDir('roast-snapshot-', async tmp => {\n208\t        let indexTree = opts.indexTree ?? ''\n209\t        if (indexTree === '') {\n210\t            const idx = path.join(tmp, 'index')\n211\t            await copyIndex(live, idx)\n212\t            indexTree = await step('write-tree (index)', opts,\n213\t                () => run(repo, ['write-tree'], opts,\n214\t                    { env:{ GIT_INDEX_FILE:idx } }))\n215\t        }\n216\t        const worktree = opts.worktree?.tree ?\n217\t            opts.worktree :\n218\t            await writeWorktree(repo, live, tmp, opts)\n219\t        const composite = await step('mktree', opts, () => run(repo,\n220\t            ['mktree'], opts, {\n221\t                input:`040000 tree ${indexTree}\\tindex\\n` +\n222\t                    `040000 tree ${worktree.tree}\\tworktree\\n`,\n223\t            }))\n224\t        const parents = ['-p', opts.headOid]\n225\t        if (opts.baseOid !== '' && opts.baseOid !== opts.headOid) {\n226\t            parents.push('-p', opts.baseOid)\n227\t        }\n228\t        const commit = await step('commit-tree', opts, () => run(repo,\n229\t            ['commit-tree', composite, ...parents,\n230\t                '-m', `roast run ${opts.runId}`],\n231\t            opts, { env:IDENTITY }))\n232\t        const ref = REF_PREFIX + opts.runId\n233\t        await step(`update-ref ${ref}`, opts,\n234\t            () => run(repo, ['update-ref', ref, commit], opts))\n235\t        return {\n236\t            ref,\n237\t            commit,\n238\t            indexTree,\n239\t            worktreeTree:worktree.tree,\n240\t            head:opts.headOid,\n241\t            base:opts.baseOid,\n242\t            excluded:[...worktree.excluded],\n243\t        }\n244\t    })\n245\t}\n246\t\n247\t// Deletes a run's snapshot ref (the review's cleanup before its run\n248\t// record exists).\n249\texport async function deleteSnapshot (\n250\t    repo:string,\n251\t    runId:string,\n252\t    opts:SnapshotOpts = {}\n253\t):Promise<void> {\n254\t    if (runId === '') throw new Error('delete snapshot: empty run id')\n255\t    const ref = REF_PREFIX + runId\n256\t    await step(`delete ${ref}`, opts,\n257\t        () => run(repo, ['update-ref', '-d', ref], opts))\n258\t}\n259\t\n260\tasync function verify (\n261\t    repo:string,\n262\t    rev:string,\n263\t    opts:SnapshotOpts\n264\t):Promise<string> {\n265\t    try {\n266\t        return await run(repo,\n267\t            ['rev-parse', '--verify', '--quiet', '--end-of-options', rev],\n268\t            opts)\n269\t    } catch {\n270\t        opts.signal?.throwIfAborted()\n271\t        return ''\n272\t    }\n273\t}\n274\t\n275\t// A snapshot from its ref alone: trees from the composite, head and base\n276\t// from the commit's parents (best effort). `excluded` is not recoverable.\n277\texport async function load (\n278\t    repo:string,\n279\t    runId:string,\n280\t    opts:SnapshotOpts = {}\n281\t):Promise<Snapshot> {\n282\t    const ref = REF_PREFIX + runId\n283\t    const commit = await verify(repo, `${ref}^{commit}`, opts)\n284\t    if (commit === '') {\n285\t        throw new Error(`no snapshot ref ${ref} in ${repo} (run predates ` +\n286\t            'snapshots, was pruned, or lives in another clone)')\n287\t    }\n288\t    const tree = (name:string):Promise<string> =>\n289\t        step(`snapshot ${ref} has no ${name}/ tree`, opts, () => run(repo,\n290\t            ['rev-parse', '--verify', '--quiet', '--end-of-options',\n291\t                `${ref}:${name}`], opts))\n292\t    const indexTree = await tree('index')\n293\t    const worktreeTree = await tree('worktree')\n294\t    return {\n295\t        ref,\n296\t        commit,\n297\t        indexTree,\n298\t        worktreeTree,\n299\t        head:await verify(repo, `${ref}^1`, opts),\n300\t        base:await verify(repo, `${ref}^2`, opts),\n301\t        excluded:[],\n302\t    }\n303\t}\n304\t\n305\t// `opts` with GIT_INDEX_FILE removed from the child environment, so an\n306\t// inherited index (inside a hook, say) never replaces a worktree's own.\n307\tfunction withoutIndexFile (opts:SnapshotOpts):SnapshotOpts {\n308\t    const env = { ...(opts.env ?? process.env) }\n309\t    delete env.GIT_INDEX_FILE\n310\t    return { ...opts, env }\n311\t}\n312\t\n313\t// Materializes a snapshot into a detached linked worktree at `dir`\n314\t// (resolved against the working directory once): disk holds the\n315\t// worktree tree, the index holds the index tree. A failure after\n316\t// `worktree add` removes the half-built worktree before rethrowing.\n317\texport async function restore (\n318\t    repo:string,\n319\t    runId:string,\n320\t    dir:string,\n321\t    opts:SnapshotOpts = {}\n322\t):Promise<Snapshot> {\n323\t    const o = withoutIndexFile(opts)\n324\t    const abs = path.resolve(dir)\n325\t    const snap = await load(repo, runId, o)\n326\t    if (snap.head === '') {\n327\t        throw new Error(`snapshot ${snap.ref} records no HEAD commit; ` +\n328\t            'it cannot be restored to a meaningful baseline')\n329\t    }\n330\t    await step('git worktree add', o, () => run(repo, ['worktree', 'add',\n331\t        '--detach', '--no-checkout', abs, snap.head], o))\n332\t    try {\n333\t        await step('read-tree (worktree)', o,\n334\t            () => run(abs, ['read-tree', snap.worktreeTree], o))\n335\t        await step('checkout-index', o,\n336\t            () => run(abs, ['checkout-index', '-a', '-f'], o))\n337\t        await step('read-tree (index)', o,\n338\t            () => run(abs, ['read-tree', snap.indexTree], o))\n339\t    } catch (err) {\n340\t        await removeWorktree(repo, abs, o).catch(() => {})\n341\t        throw err\n342\t    }\n343\t    return snap\n344\t}\n345\t\n346\t// `worktree remove --force`, falling back to deleting `dir` and pruning\n347\t// the worktree list; fails only when the prune fails too.\n348\texport async function removeWorktree (\n349\t    repo:string,\n350\t    dir:string,\n351\t    opts:SnapshotOpts = {}\n352\t):Promise<void> {\n353\t    const o = withoutIndexFile(opts)\n354\t    let removeErr:unknown\n355\t    try {\n356\t        await run(repo, ['worktree', 'remove', '--force', dir], o)\n357\t        return\n358\t    } catch (err) {\n359\t        o.signal?.throwIfAborted()\n360\t        removeErr = err\n361\t    }\n362\t    await fs.rm(dir, { recursive:true, force:true }).catch(() => {})\n363\t    try {\n364\t        await run(repo, ['worktree', 'prune'], o)\n365\t    } catch {\n366\t        throw wrap(`worktree remove ${dir}`, removeErr)\n367\t    }\n368\t}\n369\t\n370\texport interface Pruned {\n371\t    ref:string;\n372\t    runId:string;\n373\t    ageMs:number;\n374\t    deleted:boolean;\n375\t}\n376\t\n377\texport interface PruneOpts extends SnapshotOpts {\n378\t    // The clock, in milliseconds since the epoch.\n379\t    now?:() => number;\n380\t}\n381\t\n382\t// Deletes (or, dry, lists) snapshot refs at least `olderThanMs` old;\n383\t// zero or negative means the default retention. Refs of unknown age (a\n384\t// non-commit has no committer date) are never deleted. Only refs are\n385\t// touched: no run records, no gc.\n386\texport async function prune (\n387\t    repo:string,\n388\t    olderThanMs:number,\n389\t    dryRun:boolean,\n390\t    opts:PruneOpts = {}\n391\t):Promise<Pruned[]> {\n392\t    const threshold = olderThanMs <= 0 ?\n393\t        DEFAULT_REF_RETENTION_MS :\n394\t        olderThanMs\n395\t    const out = await step(`for-each-ref ${REF_PREFIX}`, opts,\n396\t        () => run(repo, ['for-each-ref',\n397\t            '--format=%(refname)%09%(committerdate:unix)', REF_PREFIX],\n398\t        opts))\n399\t    const now = (opts.now ?? Date.now)()\n400\t    const pruned:Pruned[] = []\n401\t    for (const line of out.split('\\n')) {\n402\t        const tab = line.indexOf('\\t')\n403\t        if (line.trim() === '' || tab === -1) continue\n404\t        const ref = line.slice(0, tab)\n405\t        if (!ref.startsWith(REF_PREFIX)) continue\n406\t        const ts = line.slice(tab + 1).trim()\n407\t        if (!/^[+-]?[0-9]+$/.test(ts)) continue\n408\t        const ageMs = now - Number(ts) * 1000\n409\t        if (ageMs < threshold) continue\n410\t        if (!dryRun) {\n411\t            await step(`delete ${ref}`, opts,\n412\t                () => run(repo, ['update-ref', '-d', ref], opts))\n413\t        }\n414\t        pruned.push({\n415\t            ref,\n416\t            runId:ref.slice(REF_PREFIX.length),\n417\t            ageMs,\n418\t            deleted:!dryRun,\n419\t        })\n420\t    }\n421\t    return pruned\n422\t}\n423\t\n424\t// The commit `rev` names, '' when it does not resolve.\n425\texport function revOid (\n426\t    repo:string,\n427\t    rev:string,\n428\t    opts:SnapshotOpts = {}\n429\t):Promise<string> {\n430\t    return verify(repo, `${rev}^{commit}`, opts)\n431\t}\n432\t\n433\texport function headOid (\n434\t    repo:string,\n435\t    opts:SnapshotOpts = {}\n436\t):Promise<string> {\n437\t    return revOid(repo, 'HEAD', opts)\n438\t}\n439\t\n440\t// The tree `rev` names, '' when it does not resolve.\n441\texport function treeOid (\n442\t    repo:string,\n443\t    rev:string,\n444\t    opts:SnapshotOpts = {}\n445\t):Promise<string> {\n446\t    return verify(repo, `${rev}^{tree}`, opts)\n447\t}\n448\t"}]},"parent_tool_use_id":"toolu_01Tw6eUvmTfMfsVNapeDwjUZ","agent_id":"acf0b2540a7701a5f","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"8e9a274b-c129-4429-89dd-6fa636259e63","timestamp":"2026-11-24T04:03:58.548Z","tool_result_meta":[{"id":"toolu_01FjDrUQmDDZYFQmRfqbKSiL","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review snapshot/runs/survey"}
