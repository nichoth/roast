{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VSHEfwiohdUSTpSXG4tHpX","type":"tool_result","content":"     1\t// Anthropic Messages fakes: a response builder, Go's `bindingServer`\n     2\t// (signed thinking bound to its prefix) and `deepSeekThinkingServer`\n     3\t// (DeepSeek thinking mode on chat and its Anthropic endpoint).\n     4\timport type { ServerResponse } from 'node:http'\n     5\timport {\n     6\t    startInferenceServer,\n     7\t    type InferenceServer,\n     8\t    type RecordedRequest,\n     9\t    type Script,\n    10\t} from './inference-server.js'\n    11\timport { writeInferenceStream } from './inference-stream.js'\n    12\timport { encodeToolResult } from '../../src/llm/json.js'\n    13\t\n    14\ttype Json = Record<string, unknown>\n    15\t\n    16\texport interface Call {\n    17\t    name:string;\n    18\t    args:unknown;\n    19\t}\n    20\t\n    21\texport const ANTHROPIC_USAGE = {\n    22\t    input_tokens:10,\n    23\t    output_tokens:4,\n    24\t    cache_creation_input_tokens:2,\n    25\t    cache_read_input_tokens:3,\n    26\t}\n    27\t\n    28\texport function thinkingBlock (text:string, signature = ''):Json {\n    29\t    return { type:'thinking', thinking:text, signature }\n    30\t}\n    31\t\n    32\texport function toolUseBlock (id:string, name:string, args:unknown):Json {\n    33\t    return { type:'tool_use', id, name, input:args }\n    34\t}\n    35\t\n    36\t// A complete Messages response; `stop_reason` follows the content unless\n    37\t// given.\n    38\texport function anthropicMessage (content:Json[], opts:{\n    39\t    stop?:string,\n    40\t    usage?:Json,\n    41\t    model?:string,\n    42\t} = {}):Json {\n    43\t    const calls = content.some(b => b.type === 'tool_use')\n    44\t    return {\n    45\t        id:'msg-1',\n    46\t        type:'message',\n    47\t        role:'assistant',\n    48\t        model:opts.model ?? 'claude-test',\n    49\t        content,\n    50\t        stop_reason:opts.stop ?? (calls ? 'tool_use' : 'end_turn'),\n    51\t        usage:opts.usage ?? ANTHROPIC_USAGE,\n    52\t    }\n    53\t}\n    54\t\n    55\t// A response calling each of `calls` in order (text when none).\n    56\texport function anthropicCalls (calls:Call[], opts:{\n    57\t    thinking?:string,\n    58\t    usage?:Json,\n    59\t} = {}):Json {\n    60\t    const content:Json[] = []\n    61\t    if (opts.thinking !== undefined) {\n    62\t        content.push(thinkingBlock(opts.thinking, 'sig-fixture'))\n    63\t    }\n    64\t    if (calls.length === 0) content.push({ type:'text', text:'done' })\n    65\t    calls.forEach((c, i) => {\n    66\t        content.push(toolUseBlock(`toolu-${i}`, c.name, c.args))\n    67\t    })\n    68\t    return anthropicMessage(content, { usage:opts.usage })\n    69\t}\n    70\t\n    71\t// Tool names an Anthropic request offers.\n    72\texport function anthropicToolNames (req:RecordedRequest):string[] {\n    73\t    const body = req.body as { tools?:{ name:string }[] }\n    74\t    return (body?.tools ?? []).map(t => t.name)\n    75\t}\n    76\t\n    77\t// Parsed-JSON identity: key order and whitespace are ignored.\n    78\tfunction canonical (v:unknown):string {\n    79\t    return encodeToolResult(v ?? null)\n    80\t}\n    81\t\n    82\tfunction reject (res:ServerResponse, body:unknown):void {\n    83\t    res.writeHead(400, { 'Content-Type':'application/json' })\n    84\t    res.end(JSON.stringify(body))\n    85\t}\n    86\t\n    87\texport interface BindingServer extends InferenceServer {\n    88\t    rejected:number;\n    89\t}\n    90\t\n    91\t// Go bindingServer: a signed thinking block is valid only while the\n    92\t// system prompt, the tool set, and every content block before it are\n    93\t// unchanged (compared as parsed JSON). The fake signs every thinking\n    94\t// block it emits over its prefix. `respond(n)` gives the content of the\n    95\t// n-th (1-based) response.\n    96\texport async function startBindingServer (\n    97\t    respond:(request:number) => Json[]\n    98\t):Promise<BindingServer> {\n    99\t    const issued = new Map<string, string>()\n   100\t    let count = 0\n   101\t    const holder:{ server?:BindingServer } = {}\n   102\t    const server = await startInferenceServer(req => res => {\n   103\t        const body = (req.body ?? {}) as {\n   104\t            system?:unknown,\n   105\t            tools?:unknown,\n   106\t            messages?:{ role:string, content:unknown[] }[],\n   107\t        }\n   108\t        count++\n   109\t        let prefix = canonical(body.system) + '\\n' +\n   110\t            canonical(body.tools) + '\\n'\n   111\t        const msgs = body.messages ?? []\n   112\t        for (let i = 0; i < msgs.length; i++) {\n   113\t            prefix += msgs[i].role + ':'\n   114\t            const content = Array.isArray(msgs[i].content) ?\n   115\t                msgs[i].content :\n   116\t                []\n   117\t            for (let j = 0; j < content.length; j++) {\n   118\t                const block = (content[j] ?? {}) as Json\n   119\t                if (block.type === 'thinking') {\n   120\t                    const want = issued.get(String(block.signature))\n   121\t                    if (want !== prefix) {\n   122\t                        if (holder.server) holder.server.rejected++\n   123\t                        reject(res, {\n   124\t                            type:'error',\n   125\t                            error:{\n   126\t                                type:'invalid_request_error',\n   127\t                                message:`messages.${i}.content.${j}: ` +\n   128\t                                    'Invalid `signature` in `thinking` block',\n   129\t                            },\n   130\t                        })\n   131\t                        return\n   132\t                    }\n   133\t                }\n   134\t                prefix += canonical(block) + '\\n'\n   135\t            }\n   136\t        }\n   137\t        const content = respond(count).map(b => ({ ...b }))\n   138\t        prefix += 'assistant:'\n   139\t        let stop = 'end_turn'\n   140\t        for (const block of content) {\n   141\t            if (block.type === 'thinking') {\n   142\t                const sig = `sig-${issued.size + 1}`\n   143\t                block.signature = sig\n   144\t                issued.set(sig, prefix)\n   145\t            } else if (block.type === 'tool_use') {\n   146\t                stop = 'tool_use'\n   147\t            }\n   148\t            prefix += canonical(block) + '\\n'\n   149\t        }\n   150\t        writeInferenceStream(res, 'anthropic', {\n   151\t            ...anthropicMessage(content, { stop }),\n   152\t            id:`msg-${count}`,\n   153\t            usage:{ input_tokens:10, output_tokens:5 },\n   154\t        })\n   155\t    })\n   156\t    holder.server = Object.assign(server, { rejected:0 })\n   157\t    return holder.server\n   158\t}\n   159\t\n   160\texport interface DeepSeekServer extends InferenceServer {\n   161\t    // Requests answered 400.\n   162\t    rejected:RecordedRequest[];\n   163\t}\n   164\t\n   165\t// What a DeepSeek fake answers: a tool call, or prose when `tool` is\n   166\t// empty; `finish` overrides the natural finish reason.\n   167\texport interface DeepSeekAnswer {\n   168\t    tool:string;\n   169\t    args?:unknown;\n   170\t    finish?:string;\n   171\t}\n   172\t\n   173\t// Go deepSeekThinkingServer as a script: any forced tool choice is a\n   174\t// 400, and with tools present every earlier assistant message must\n   175\t// replay its reasoning (`reasoning_content` on chat, a leading\n   176\t// `thinking` block on anthropic). `respond(req, n)` answers the n-th\n   177\t// (1-based) request; `rejected` collects the requests answered 400.\n   178\texport function deepSeekScript (\n   179\t    protocol:'chat'|'anthropic',\n   180\t    respond:(req:RecordedRequest, n:number) => DeepSeekAnswer\n   181\t):{ script:Script, rejected:RecordedRequest[] } {\n   182\t    const rejected:RecordedRequest[] = []\n   183\t    let count = 0\n   184\t    const script:Script = req => res => {\n   185\t        const body = (req.body ?? {}) as {\n   186\t            tool_choice?:unknown,\n   187\t            tools?:unknown[],\n   188\t            messages?:Json[],\n   189\t        }\n   190\t        const call = ++count\n   191\t        const choice = body.tool_choice\n   192\t        let auto = choice === undefined || choice === null ||\n   193\t            choice === 'auto'\n   194\t        if (choice !== null && typeof choice === 'object') {\n   195\t            auto = (choice as Json).type === 'auto'\n   196\t        }\n   197\t        if (!auto) {\n   198\t            rejected.push(req)\n   199\t            reject(res, {\n   200\t                error:{\n   201\t                    message:'Thinking mode does not support this ' +\n   202\t                        'tool_choice',\n   203\t                    type:'invalid_request_error',\n   204\t                },\n   205\t            })\n   206\t            return\n   207\t        }\n   208\t        const hasTools = (body.tools ?? []).length > 0\n   209\t        for (const m of body.messages ?? []) {\n   210\t            if (m.role !== 'assistant' || !hasTools) continue\n   211\t            const ok = protocol === 'chat' ?\n   212\t                'reasoning_content' in m :\n   213\t                Array.isArray(m.content) &&\n   214\t                    (m.content[0] as Json|undefined)?.type === 'thinking'\n   215\t            if (!ok) {\n   216\t                rejected.push(req)\n   217\t                reject(res, {\n   218\t                    type:'error',\n   219\t                    error:{\n   220\t                        type:'invalid_request_error',\n   221\t                        message:'The thinking in the thinking mode must ' +\n   222\t                            'be passed back to the API.',\n   223\t                    },\n   224\t                })\n   225\t                return\n   226\t            }\n   227\t        }\n   228\t        const answer = respond(req, call)\n   229\t        writeInferenceStream(res, protocol, protocol === 'chat' ?\n   230\t            deepSeekChat(answer, call) :\n   231\t            deepSeekAnthropic(answer, call))\n   232\t    }\n   233\t    return { script, rejected }\n   234\t}\n   235\t\n   236\texport async function startDeepSeekServer (\n   237\t    protocol:'chat'|'anthropic',\n   238\t    respond:(req:RecordedRequest, n:number) => DeepSeekAnswer\n   239\t):Promise<DeepSeekServer> {\n   240\t    const { script, rejected } = deepSeekScript(protocol, respond)\n   241\t    const server = await startInferenceServer(script)\n   242\t    return Object.assign(server, { rejected })\n   243\t}\n   244\t\n   245\tfunction deepSeekChat (a:DeepSeekAnswer, call:number):Json {\n   246\t    const message:Json = {\n   247\t        role:'assistant',\n   248\t        reasoning_content:'Thinking it through.',\n   249\t    }\n   250\t    let natural = 'stop'\n   251\t    if (a.tool === '') {\n   252\t        message.content = 'Here is my answer in prose.'\n   253\t    } else {\n   254\t        natural = 'tool_calls'\n   255\t        message.tool_calls = [{\n   256\t            id:`call-${call}`,\n   257\t            type:'function',\n   258\t            function:{ name:a.tool, arguments:JSON.stringify(a.args ?? {}) },\n   259\t        }]\n   260\t    }\n   261\t    return {\n   262\t        id:'chat',\n   263\t        object:'chat.completion',\n   264\t        model:'deepseek-test',\n   265\t        choices:[{\n   266\t            index:0,\n   267\t            finish_reason:a.finish || natural,\n   268\t            message,\n   269\t        }],\n   270\t        usage:{ prompt_tokens:10, completion_tokens:5, total_tokens:15 },\n   271\t    }\n   272\t}\n   273\t\n   274\tfunction deepSeekAnthropic (a:DeepSeekAnswer, call:number):Json {\n   275\t    const content:Json[] = [\n   276\t        thinkingBlock('Thinking it through.', `ds-${call}`),\n   277\t    ]\n   278\t    let natural = 'end_turn'\n   279\t    if (a.tool === '') {\n   280\t        content.push({ type:'text', text:'Here is my answer in prose.' })\n   281\t    } else {\n   282\t        natural = 'tool_use'\n   283\t        content.push(toolUseBlock(`toolu-${call}`, a.tool, a.args ?? {}))\n   284\t    }\n   285\t    return anthropicMessage(content, {\n   286\t        stop:a.finish || natural,\n   287\t        usage:{ input_tokens:10, output_tokens:5 },\n   288\t        model:'deepseek-test',\n   289\t    })\n   290\t}","is_error":false}]},"parent_tool_use_id":"toolu_01T6H39Mzrb9HTVEpUPxaMw9","agent_id":"a2d564e3db2c159ee","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"8cec8856-f787-48f1-a176-966525823c99","timestamp":"2026-11-24T04:05:01.701Z","tool_result_meta":[{"id":"toolu_01VSHEfwiohdUSTpSXG4tHpX","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review LLM adapters"}
