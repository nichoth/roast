{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FmjSzoKWpdNeY5o5PPYwSu","type":"tool_result","content":"// Model-ID rules (spec 06, 2.6).\n\nconst REASONING = /(?:^|[-.])(?:o[134]|oss)|gpt-[5-9]|codex-|computer-use/\nconst CLASSIC_CHAT = /gpt-3|gpt-4|chatgpt-|-chat/\n\n// Chat reasoning models take `max_completion_tokens` instead of\n// `max_tokens`.\nexport function isChatReasoningModel (id:string):boolean {\n    const lower = id.toLowerCase()\n    return REASONING.test(lower) && !CLASSIC_CHAT.test(lower)\n}\n\n// How the `responses` protocol sends the system prompt.\nexport function responsesSystemMode (\n    'server_error',\n    'internal_error',\n    'overloaded_error',\n    'api_error',\n    'rate_limit_error',\n])\n\n// An error delivered inside a 200 stream; retryable for transient\n// provider types (the code stands in when the type is empty).\nexport function streamError (\n    type:string,\n    code:string,\n    message:string\n):ProviderError {\n    const kind = type || code\n    const label = kind ? `${kind}: ${message}` : message\n    return new ProviderError(`stream error: ${label}`, {\n        providerType:type || undefined,\n        providerCode:code || undefined,\n        providerMessage:message,\n        retryable:TRANSIENT_STREAM_TYPES.has(kind),\n    })\n}\n\n// Each error in `err`'s cause chain, outermost first; cycle safe.\nfunction * chain (err:unknown):Generator<Error> {\n     1\t// The shared, pull-based SSE parser (spec 06, 2.7). Bytes are read only\n     2\t// as the consumer asks for the next event; it never buffers more than the\n     3\t// current chunk plus a partial line.\n     4\t\n     5\texport interface SseEvent {\n     6\t    event:string;\n     7\t    data:string;\n     8\t}\n     9\t\n    10\tinterface EventState {\n    11\t    event:string;\n    12\t    data:string[];\n    13\t}\n    14\t\n    15\t// Applies one line to the event state; returns the event a blank line\n    16\t// dispatches, if any.\n    17\tfunction applyLine (line:string, st:EventState):SseEvent|null {\n    18\t    if (line === '') {\n    19\t        const ev = st.data.length > 0 ?\n    20\t            { event:st.event, data:st.data.join('\\n') } :\n    21\t            null\n    22\t        st.event = ''\n    23\t        st.data = []\n    24\t        return ev\n    25\t    }\n    26\t    if (line.startsWith(':')) return null\n    27\t    const colon = line.indexOf(':')\n    28\t    const field = colon < 0 ? line : line.slice(0, colon)\n    29\t    let value = colon < 0 ? '' : line.slice(colon + 1)\n    30\t    if (value.startsWith(' ')) value = value.slice(1)\n    31\t    if (field === 'event') st.event = value\n    32\t    else if (field === 'data') st.data.push(value)\n    33\t    return null\n    34\t}\n    35\t\n    36\texport async function * parseSse (\n    37\t    chunks:AsyncIterable<Uint8Array>\n    38\t):AsyncGenerator<SseEvent> {\n    39\t    const decoder = new TextDecoder('utf-8')\n    40\t    const st:EventState = { event:'', data:[] }\n    41\t    let buf = ''\n    42\t    // A CR ended the previous line; a directly following LF belongs to it.\n    43\t    let skipLF = false\n    44\t\n    45\t    function * lines (final:boolean):Generator<string> {\n    46\t        for (;;) {\n    47\t            if (skipLF && buf.length > 0) {\n    48\t                if (buf.charCodeAt(0) === 10) buf = buf.slice(1)\n    49\t                skipLF = false\n    50\t            }\n    51\t            let i = 0\n    52\t            for (; i < buf.length; i++) {\n    53\t                const c = buf.charCodeAt(i)\n    54\t                if (c === 10 || c === 13) break\n    55\t            }\n    56\t            if (i === buf.length) {\n    57\t                if (final && buf.length > 0) {\n    58\t                    const rest = buf\n    59\t                    buf = ''\n    60\t                    yield rest\n    61\t                }\n    62\t                return\n    63\t            }\n    64\t            const line = buf.slice(0, i)\n    65\t            skipLF = buf.charCodeAt(i) === 13\n    66\t            buf = buf.slice(i + 1)\n    67\t            yield line\n    68\t        }\n    69\t    }\n    70\t\n    71\t    for await (const chunk of chunks) {\n    72\t        buf += decoder.decode(chunk, { stream:true })\n    73\t        for (const line of lines(false)) {\n    74\t            const ev = applyLine(line, st)\n    75\t            if (ev) yield ev\n    76\t        }\n    77\t    }\n    78\t    buf += decoder.decode()\n    79\t    for (const line of lines(true)) {\n    80\t        const ev = applyLine(line, st)\n    81\t        if (ev) yield ev\n    82\t    }\n    83\t    const last = applyLine('', st)\n    84\t    if (last) yield last\n    85\t}","is_error":false}]},"parent_tool_use_id":"toolu_01T6H39Mzrb9HTVEpUPxaMw9","agent_id":"a2d564e3db2c159ee","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"780bf95f-be2d-4ab9-9063-30971046c507","timestamp":"2026-11-24T04:06:58.371Z","tool_result_meta":[{"id":"toolu_01FmjSzoKWpdNeY5o5PPYwSu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review LLM adapters"}
