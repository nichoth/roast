{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JpqMTM5Gr7gwLq3d8t2WyG","type":"tool_result","content":"// \"web\" is accepted but triggers no addendum in v1.\nfunc appendLangAddenda(langs []string) string {\n\tvar has = make(map[string]bool, len(langs))\n\tfor _, l := range langs {\n\t\thas[l] = true\n\t}\n\tvar out string\n\tif has[\"go\"] {\n\t\tout += finderGoAddendumTmpl\n\t}\n\tif has[\"react\"] || has[\"frontend\"] {\n\t\tout += finderFrontendAddendumTmpl\n\t}\n\tif has[\"react\"] {\n\t\tout += finderReactHooksAddendumTmpl\n\t}\n\treturn out\n}\n\n// FinderUser renders the finder user message template.\nfunc FinderUser(vars FinderUserVars) string {\n\treturn mustRender(finderUserTmpl, vars)\n}\n\n// Verifier returns the verifier system prompt. overridePath, when non-empty,\n// replaces the embedded default.\nfunc Verifier(overridePath string) (string, error) {\n\treturn load(overridePath, func() (string, error) { return verifierSystemTmpl, nil })\n}\n\n// VerifierUser renders the verifier user message template.\nfunc VerifierUser(vars VerifierVars) string {\n\treturn mustRender(verifierUserTmpl, vars)\n}\n\n// load returns text from overridePath when non-empty, falling back to the\n// result of fallback(). A non-empty path that doesn't exist is an error.\nfunc load(overridePath string, fallback func() (string, error)) (string, error) {\n\tif overridePath == \"\" {\n\t\treturn fallback()\n\t}\n\tdata, err := os.ReadFile(overridePath)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"prompt override %s: %w\", overridePath, err)\n\t}\n\treturn string(data), nil\n}\n\n// verifierDataClose matches a closing tag of any wrapper verifier_user.tmpl\n// puts around finder- or repository-supplied text.\nvar verifierDataClose = regexp.MustCompile(`(?i)</\\s*(claim|code_quote|fixed_code|file_contents)\\b`)\n\n// dataText is the `data` template function. It defangs any closing wrapper\n// tag inside untrusted text, so a claim or file cannot end its own tag early\n// and append text that reads as part of the prompt.\nfunc dataText(s string) string {\n\treturn verifierDataClose.ReplaceAllString(s, `<\\/$1`)\n}\n\n// mustRender renders a text/template with data. Panics on parse error\n// (templates are compile-time constants; parse failure is a bug).\nfunc mustRender(tmplText string, data any) string {\n\tt := template.Must(template.New(\"\").Funcs(template.FuncMap{\"data\": dataText}).Parse(tmplText))\n\tvar buf bytes.Buffer\n\tif err := t.Execute(&buf, data); err != nil {\n\t\tpanic(fmt.Sprintf(\"prompts: template execution failed: %v\", err))\n\t}\n\treturn buf.String()\n}\n\n// TrimSpace returns the prompt with leading/trailing whitespace removed.\n// Useful when callers want a clean string for length checks.\nfunc TrimSpace(s string) string {\n\treturn strings.TrimSpace(s)\n}\n// pattern: Functional Core\n\nimport { formatFixed2 } from '../gocompat/strings.js'\n\n/** Inputs for the diff or repository-survey finder user message. */\nexport type FinderUserVars = {\n    task:string;\n    survey:boolean;\n    diff:string;\n    fileContext:string;\n    manifest:string;\n}\n\n/** Finder reasoning is deliberately excluded to avoid anchoring. */\nexport type VerifierVars = {\n    severity:string;\n    confidence:number;\n    file:string;\n    lines:string;\n    description:string;\n    codeQuote:string;\n    fixedCode:string;\n    fileSnippet:string;\n}\n\n/** Render finder_user.tmpl, inserting the supplied data verbatim. */\nexport function renderFinderUser (v:Readonly<FinderUserVars>):string {\n    const body = v.survey ? [\n        '## Repository under review (MANIFEST \\u2014 the map, ' +\n            'not the contents)',\n        '',\n        'The repository contents are not inline below. ' +\n            'Use the local tools to inspect relevant files.',\n        '',\n        '<manifest>',\n        v.manifest,\n        '</manifest>',\n        '',\n        'Every finding must include `code_quote` copied verbatim ' +\n            'from code retrieved through the tools and a concrete ' +\n            '`fixed_code` replacement.',\n    ] : [\n        '## Changes under review',\n        '',\n        '<diff>',\n        v.diff,\n        '</diff>',\n        '',\n        '## Files touched (full current contents, each line prefixed ' +\n            'with its real file line number)',\n        '',\n        '<files>',\n        v.fileContext,\n        '</files>',\n        '',\n        'Every finding must include `code_quote` (verbatim from <files>) ' +\n            'and `fixed_code` (concrete replacement). Cite line numbers ' +\n            'using the real file line numbers from the <files> section ' +\n            '\\u2014 not positions inside the <diff>.',\n    ]\n    return [\n        '## Task (what the builder was asked to do)',\n        '',\n        v.task,\n        '',\n        ...body,\n        '',\n        '',\n    ].join('\\n')\n}\n\n/** Render verifier_user.tmpl with every untrusted string defanged. */\nexport function renderVerifierUser (v:Readonly<VerifierVars>):string {\n    return [\n        '## The claim under adjudication',\n        '',\n        '<claim>',\n        `Severity: ${dataText(v.severity)} ` +\n            `(finder confidence ${formatFixed2(v.confidence)})`,\n        `File: ${dataText(v.file)} lines ${dataText(v.lines)}`,","is_error":false}]},"parent_tool_use_id":"toolu_018gF4SKTMT76p6W4DKSyVyJ","agent_id":"a65d44a24feed96f9","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"73093fce-1f80-4744-bcac-9cefea60daaa","timestamp":"2026-11-24T04:05:42.498Z","tool_result_meta":[{"id":"toolu_01JpqMTM5Gr7gwLq3d8t2WyG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review review cmd/verify/gate"}
