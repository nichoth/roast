{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AauXTmKBpgsyJXJCCTkgoC","type":"tool_result","content":"// Gate constants (spec 12, 2.1). HOOK_SCRIPT is the byte-exact\n// pre-commit.sh the Go releases installed, so those hooks compare equal\n// and are not reported stale.\nimport hookScript from './pre-commit.sh'\n\nexport const HOOK_SCRIPT:string = hookScript\n\nexport const HOOK_NAME = 'pre-commit'\nexport const SIDECAR_NAME = 'roast-pre-commit'\nexport const HOOK_MARKER = '# roast-gate-hook: v1'\nexport const HOOK_HEADER = `#!/bin/sh\\n${HOOK_MARKER}\\n`\nexport const APPEND_BEGIN =\n    '# >>> roast pre-commit gate (managed by `roast gate`) >>>'\nexport const APPEND_END = '# <<< roast pre-commit gate <<<'\n\nexport const CONFIG_KEY_DECISION = 'roast.gate'\nexport const CONFIG_KEY_NOTICE = 'roast.gate-notice'\n\n// The one line that runs the sidecar: the body of the appended block, and\n// what a user adds by hand to a hook Roast will not edit. It resolves the\n// sidecar through git, so it survives repo moves and core.hooksPath.\nexport function manualLine ():string {\n    return `\"$(git rev-parse --git-path hooks/${SIDECAR_NAME})\" || exit $?`\n}\n     664\n// Package gate installs and manages Roast's native Git pre-commit hook.\npackage gate\n\nimport _ \"embed\"\n\n// HookScript is the native Git pre-commit hook installed by this package.\n//\n//go:embed pre-commit.sh\nvar HookScript string\n\nconst (\n\tHookName    = \"pre-commit\"\n\tSidecarName = \"roast-pre-commit\"\n\tHookMarker  = \"# roast-gate-hook: v1\"\n\thookHeader  = \"#!/bin/sh\\n\" + HookMarker + \"\\n\"\n\tappendBegin = \"# >>> roast pre-commit gate (managed by `roast gate`) >>>\"\n\tappendEnd   = \"# <<< roast pre-commit gate <<<\"\n)","is_error":false}]},"parent_tool_use_id":"toolu_018gF4SKTMT76p6W4DKSyVyJ","agent_id":"a65d44a24feed96f9","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"a21de386-4354-45a1-a892-78ac41115417","timestamp":"2026-11-24T04:04:48.807Z","tool_result_meta":[{"id":"toolu_01AauXTmKBpgsyJXJCCTkgoC","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review review cmd/verify/gate"}
