{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L1HnxkjgPLmrsi3CUmX4Mz","type":"tool_result","content":"     197 src/llm/capture.ts\n      85 src/llm/sse.ts\n      49 src/llm/http.ts\n     331 total\n     1\t// Response body ownership and raw-response capture (spec 06, 2.11): a\n     2\t// size cap, the Content-Length check, streaming capture that never reads\n     3\t// ahead of the parser, and the client's sticky failure gate.\n     4\t\n     5\timport { CaptureError } from './errors.js'\n     6\timport type { Protocol, RawResponse } from './types.js'\n     7\t\n     8\texport const MAX_CAPTURED_RESPONSE_SIZE = 16 << 20\n     9\t\n    10\t// A client's capture state: after the first failure every later request\n    11\t// fails with the same error without contacting the server.\n    12\texport class CaptureGate {\n    13\t    failure?:CaptureError\n    14\t}\n    15\t\n    16\texport interface CaptureOptions {\n    17\t    role:string;\n    18\t    protocol:Protocol;\n    19\t    model:string;\n    20\t    captureResponse?:(raw:RawResponse) => Promise<void>|void;\n    21\t    // Overrides MAX_CAPTURED_RESPONSE_SIZE (tests).\n    22\t    limit?:number;\n    23\t}\n    24\t\n    25\texport interface CapturedBody {\n    26\t    // Body chunks, read only as the consumer pulls them.\n    27\t    chunks:AsyncIterable<Uint8Array>;\n    28\t    // Idempotent: cancels the body if it is not at EOF, then hands the\n    29\t    // bytes read to the capture callback. Throws a CaptureError.\n    30\t    release ():Promise<void>;\n    31\t}\n    32\t\n    33\tfunction latch (\n    34\t    gate:CaptureGate,\n    35\t    role:string,\n    36\t    detail:string,\n    37\t    cause?:unknown\n    38\t):CaptureError {\n    39\t    const err = new CaptureError(\n    40\t        `capture ${role} provider response: ${detail}`, { cause })\n    41\t    gate.failure ??= err\n    42\t    return err\n    43\t}\n    44\t\n    45\tfunction mediaType (contentType:string|null):string {\n    46\t    return (contentType ?? '').split(';')[0].trim().toLowerCase()\n    47\t}\n    48\t\n    49\tfunction concat (parts:Uint8Array[], size:number):Uint8Array {\n    50\t    const out = new Uint8Array(size)\n    51\t    let off = 0\n    52\t    for (const p of parts) {\n    53\t        out.set(p, off)\n    54\t        off += p.length\n    55\t    }\n    56\t    return out\n    57\t}\n    58\t\n    59\t// `p`, or the signal's reason as soon as it aborts.\n    60\texport function abortable<T> (p:Promise<T>, signal?:AbortSignal):Promise<T> {\n    61\t    if (!signal) return p\n    62\t    if (signal.aborted) return Promise.reject(signal.reason)\n    63\t    return new Promise<T>((resolve, reject) => {\n    64\t        const onAbort = () => reject(signal.reason)\n    65\t        signal.addEventListener('abort', onAbort, { once:true })\n    66\t        p.then(v => {\n    67\t            signal.removeEventListener('abort', onAbort)\n    68\t            resolve(v)\n    69\t        }, (e:unknown) => {\n    70\t            signal.removeEventListener('abort', onAbort)\n    71\t            reject(e)\n    72\t        })\n    73\t    })\n    74\t}\n    75\t\n    76\tasync function runCallback (\n    77\t    opts:CaptureOptions,\n    78\t    gate:CaptureGate,\n    79\t    contentType:RawResponse['contentType'],\n    80\t    body:Uint8Array\n    81\t):Promise<void> {\n    82\t    if (!opts.captureResponse) return\n    83\t    try {\n    84\t        await opts.captureResponse({\n    85\t            role:opts.role,\n    86\t            protocol:opts.protocol,\n    87\t            model:opts.model,\n    88\t            contentType,\n    89\t            body,\n    90\t        })\n    91\t    } catch (err) {\n    92\t        const msg = err instanceof Error ? err.message : String(err)\n    93\t        throw latch(gate, opts.role, msg, err)\n    94\t    }\n    95\t}\n    96\t\n    97\t// Opens a 2xx response body for the SSE parser.\n    98\texport async function openCapturedBody (\n    99\t    response:Response,\n   100\t    opts:CaptureOptions,\n   101\t    gate:CaptureGate,\n   102\t    signal?:AbortSignal\n   103\t):Promise<CapturedBody> {\n   104\t    const limit = opts.limit ?? MAX_CAPTURED_RESPONSE_SIZE\n   105\t    const reader = response.body?.getReader()\n   106\t    let done = !reader\n   107\t    let released = false\n   108\t\n   109\t    async function cancel ():Promise<void> {\n   110\t        if (done || !reader) return\n   111\t        done = true\n   112\t        await reader.cancel().catch(() => {})\n   113\t    }\n   114\t\n   115\t    // The next chunk, or null at EOF.\n   116\t    async function read ():Promise<Uint8Array|null> {\n   117\t        if (!reader) return null\n   118\t        const r = await abortable(reader.read(), signal)\n   119\t        return r.done ? null : r.value\n   120\t    }\n   121\t\n   122\t    const capturing = opts.captureResponse !== undefined\n   123\t    const length = Number(response.headers.get('content-length') ?? '')\n   124\t    if (capturing && Number.isFinite(length) && length > limit) {\n   125\t        await cancel()\n   126\t        throw latch(gate, opts.role,\n   127\t            `body exceeds ${limit}-byte limit`)\n   128\t    }\n   129\t\n   130\t    const sse = mediaType(response.headers.get('content-type')) ===\n   131\t        'text/event-stream'\n   132\t    if (capturing && !sse) {\n   133\t        const parts:Uint8Array[] = []\n   134\t        let size = 0\n   135\t        while (!done) {\n   136\t            const value = await read()\n   137\t            if (value === null) {\n   138\t                done = true\n   139\t                break\n   140\t            }\n   141\t            size += value.length\n   142\t            if (size > limit) {\n   143\t                await cancel()\n   144\t                throw latch(gate, opts.role,\n   145\t                    `body exceeds ${limit}-byte limit`)\n   146\t            }\n   147\t            parts.push(value)\n   148\t        }\n   149\t        const body = concat(parts, size)\n   150\t        try {\n   151\t            JSON.parse(new TextDecoder().decode(body))\n   152\t        } catch {\n   153\t            throw latch(gate, opts.role,\n   154\t                `${opts.model} returned invalid raw JSON`)\n   155\t        }\n   156\t        await runCallback(opts, gate, 'application/json', body)\n   157\t        async function * once () { yield body }\n   158\t        return { chunks:once(), release:async () => {} }\n   159\t    }\n   160\t\n   161\t    const parts:Uint8Array[] = []\n   162\t    let size = 0\n   163\t    let overflowed = false\n   164\t\n   165\t    async function * chunks ():AsyncGenerator<Uint8Array> {\n   166\t        while (!done) {\n   167\t            const value = await read()\n   168\t            if (value === null) {\n   169\t                done = true\n   170\t                return\n   171\t            }\n   172\t            if (capturing) {\n   173\t                if (size + value.length > limit) {\n   174\t                    overflowed = true\n   175\t                    await cancel()\n   176\t                    throw latch(gate, opts.role,\n   177\t                        `body exceeds ${limit}-byte limit`)\n   178\t                }\n   179\t                parts.push(value)\n   180\t                size += value.length\n   181\t            }\n   182\t            yield value\n   183\t        }\n   184\t    }\n   185\t\n   186\t    return {\n   187\t        chunks:chunks(),\n   188\t        async release ():Promise<void> {\n   189\t            if (released) return\n   190\t            released = true\n   191\t            await cancel()\n   192\t            if (!capturing || overflowed) return\n   193\t            await runCallback(opts, gate, 'text/event-stream',\n   194\t                concat(parts, size))\n   195\t        },\n   196\t    }\n   197\t}","is_error":false}]},"parent_tool_use_id":"toolu_01T6H39Mzrb9HTVEpUPxa