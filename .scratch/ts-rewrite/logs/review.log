{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Va2ns9UFPHeRVQehw3LCuk","type":"tool_result","content":"1\t// Installing, inspecting, and removing the pre-commit gate (spec 12, 2.4\n2\t// to 2.9). Roast never clobbers a hook it did not write: ownership is\n3\t// anchored (our header at byte 0, or a complete appended block that holds\n4\t// the invocation), and everything else is foreign.\n5\timport fs from 'node:fs/promises'\n6\timport path from 'node:path'\n7\timport { writeFileAtomic } from '../fsutil/atomic.js'\n8\timport { goTrimSpace, isGoSpace } from '../gocompat/strings.js'\n9\timport {\n10\t    APPEND_BEGIN,\n11\t    APPEND_END,\n12\t    CONFIG_KEY_NOTICE,\n13\t    HOOK_HEADER,\n14\t    HOOK_NAME,\n15\t    HOOK_SCRIPT,\n16\t    SIDECAR_NAME,\n17\t    manualLine,\n18\t} from './constants.js'\n19\timport { type Decision, readDecision } from './decision.js'\n20\timport {\n21\t    configGet,\n22\t    hooksPathConfigured,\n23\t    resolveHookPath,\n24\t    type Env,\n25\t} from './git-config.js'\n26\t\n27\texport interface GateStatus {\n28\t    repo:string;\n29\t    decision:Decision;\n30\t    hookPath:string;\n31\t    sidecarPath:string;\n32\t    // core.hooksPath is set: the hooks directory may serve other repos.\n33\t    shared:boolean;\n34\t    exists:boolean;\n35\t    // At most one of ours, appended, foreign is true.\n36\t    ours:boolean;\n37\t    appended:boolean;\n38\t    foreign:boolean;\n39\t    appendable:boolean;\n40\t    // Owner execute bit; git silently skips a hook without it.\n41\t    executable:boolean;\n42\t    // Roast's part (own hook or sidecar) differs from HOOK_SCRIPT.\n43\t    stale:boolean;\n44\t    noticeSent:boolean;\n45\t}\n46\t\n47\texport type InstallAction =\n48\t    'installed'|'appended'|'refreshed'|'up-to-date'|'manual'\n49\texport type RemoveAction = 'removed'|'nothing'|'preserved'\n50\t\n51\tconst SCRIPT_BYTES = Buffer.from(HOOK_SCRIPT)\n52\tconst HEADER_BYTES = Buffer.from(HOOK_HEADER)\n53\tconst NEWLINE = 0x0a\n54\t\n55\tfunction message (err:unknown):string {\n56\t    return err instanceof Error ? err.message : String(err)\n57\t}\n58\t\n59\tfunction isCode (err:unknown, code:string):boolean {\n60\t    return (err as NodeJS.ErrnoException)?.code === code\n61\t}\n62\t\n63\tfunction fail (text:string, err:unknown):Error {\n64\t    return new Error(`${text}: ${message(err)}`, { cause:err })\n65\t}\n66\t\n67\tfunction hasHeader (body:Buffer):boolean {\n68\t    return body.subarray(0, HEADER_BYTES.length).equals(HEADER_BYTES)\n69\t}\n70\t\n71\t// Splits on '\\n' like Go strings.Split, keeping the raw bytes.\n72\tfunction splitLines (body:Buffer):Buffer[] {\n73\t    const lines:Buffer[] = []\n74\t    let start = 0\n75\t    for (let i = 0; i < body.length; i++) {\n76\t        if (body[i] === NEWLINE) {\n77\t            lines.push(body.subarray(start, i))\n78\t            start = i + 1\n79\t        }\n80\t    }\n81\t    lines.push(body.subarray(start))\n82\t    return lines\n83\t}\n84\t\n85\tfunction trimmed (line:Buffer):string {\n86\t    return goTrimSpace(line.toString('utf8'))\n87\t}\n88\t\n89\tasync function readFile (file:string):Promise<Buffer> {\n90\t    try {\n91\t        return await fs.readFile(file)\n92\t    } catch (err) {\n93\t        throw fail(`read ${file}`, err)\n94\t    }\n95\t}\n96\t\n97\t// The file's permission bits, or 0o755 when stat fails.\n98\tasync function permOr755 (file:string):Promise<number> {\n99\t    try {\n100\t        return (await fs.stat(file)).mode & 0o777\n101\t    } catch {\n102\t        return 0o755\n103\t    }\n104\t}\n105\t\n106\tconst SHELLS = new Set(['sh', 'bash', 'dash', 'ksh', 'zsh'])\n107\t\n108\t// Go strings.Fields: split on runs of Unicode white space.\n109\tfunction fields (s:string):string[] {\n110\t    const out:string[] = []\n111\t    let cur = ''\n112\t    for (const ch of s) {\n113\t        if (isGoSpace(ch.codePointAt(0) ?? 0)) {\n114\t            if (cur) out.push(cur)\n115\t            cur = ''\n116\t        } else {\n117\t            cur += ch\n118\t        }\n119\t    }\n120\t    if (cur) out.push(cur)\n121\t    return out\n122\t}\n123\t\n124\tconst utf8 = new TextDecoder('utf-8', { fatal:true })\n125\t\n126\t// Whether a foreign hook is a plain shell script Roast can safely add its\n127\t// block to. Conservative: a false negative costs one printed line, a false\n128\t// positive corrupts someone else's hook.\n129\texport function appendable (body:Uint8Array):boolean {\n130\t    if (body.length === 0) return false\n131\t    let text:string\n132\t    try {\n133\t        text = utf8.decode(body)\n134\t    } catch {\n135\t        return false\n136\t    }\n137\t    let line = text.split('\\n', 1)[0]\n138\t    if (line.endsWith('\\r')) line = line.slice(0, -1)\n139\t    line = goTrimSpace(line)\n140\t    if (!line.startsWith('#!')) return false\n141\t    const f = fields(line.slice(2))\n142\t    if (f.length === 0) return false\n143\t    let interp = path.posix.basename(f[0])\n144\t    if (interp === 'env') {\n145\t        if (f.length < 2) return false\n146\t        if (f[1].startsWith('-') || f[1].includes('=')) return false\n147\t        interp = path.posix.basename(f[1])\n148\t    }\n149\t    return SHELLS.has(interp)\n150\t}\n151\t\n152\t// The inclusive line range of a complete block that holds the invocation,\n153\t// or undefined. Markers alone are public comment text, not authorship.\n154\tfunction appendedBlock (lines:Buffer[]):[number, number]|undefined {\n155\t    const invocation = manualLine()\n156\t    let start = -1\n157\t    let hasInvocation = false\n158\t    for (let i = 0; i < lines.length; i++) {\n159\t        const line = trimmed(lines[i])\n160\t        if (line === APPEND_BEGIN) {\n161\t            start = i\n162\t            hasInvocation = false\n163\t        } else if (line === APPEND_END && start >= 0) {\n164\t            if (hasInvocation) return [start, i]\n165\t            start = -1\n166\t        } else if (start >= 0 && line === invocation) {\n167\t            hasInvocation = true\n168\t        }\n169\t    }\n170\t    return undefined\n171\t}\n172\t\n173\tasync function sidecarCurrent (file:string):Promise<boolean> {\n174\t    try {\n175\t        const info = await fs.stat(file)\n176\t        if ((info.mode & 0o100) === 0) return false\n177\t        return (await fs.readFile(file)).equals(SCRIPT_BYTES)\n178\t    } catch {\n179\t        return false\n180\t    }\n181\t}\n182\t\n183\t// Reports the gate state of a repo (a working-tree root). Never mutates.\n184\texport async function inspect (repo:string, env:Env):Promise<GateStatus> {\n185\t    const hookPath = await resolveHookPath(repo, HOOK_NAME, env)\n186\t    const sidecarPath = await resolveHookPath(repo, SIDECAR_NAME, env)\n187\t    const st:GateStatus = {\n188\t        repo,\n189\t        decision:await readDecision(repo, env),\n190\t        hookPath,\n191\t        sidecarPath,\n192\t        shared:await hooksPathConfigured(repo, env),\n193\t        exists:false,\n194\t        ours:false,\n195\t        appended:false,\n196\t        foreign:false,\n197\t        appendable:false,\n198\t        executable:false,\n199\t        stale:false,\n200\t        noticeSent:(await configGet(repo, CONFIG_KEY_NOTICE, env)) !== '',\n201\t    }\n202\t    let info\n203\t    try {\n204\t        info = await fs.lstat(hookPath)\n205\t    } catch (err) {\n206\t        if (isCode(err, 'ENOENT')) return st\n207\t        throw fail(`stat ${hookPath}`, err)\n208\t    }\n209\t    st.exists = true\n210\t    st.executable = (info.mode & 0o100) !== 0\n211\t    // A symlinked hook belongs to whatever put it there.\n212\t    if (info.isSymbolicLink()) {\n213\t        st.foreign = true\n214\t        return st\n215\t    }\n216\t    const body = await readFile(hookPath)\n217\t    if (hasHeader(body)) {\n218\t        st.ours = true\n219\t        st.stale = !body.equals(SCRIPT_BYTES) || !st.executable\n220\t    } else if (appendedBlock(splitLines(body))) {\n221\t        st.appended = true\n222\t        // The foreign file's own mode is not Roast's to repair, so it\n223\t        // feeds isActive, never stale.\n224\t        st.stale = !(await sidecarCurrent(sidecarPath))\n225\t    } else {\n226\t        st.foreign = true\n227\t        st.appendable = appendable(body)\n228\t    }\n229\t    return st\n230\t}\n231\t\n232\t// Consent plus an executable dispatcher.\n233\texport function isActive (s:GateStatus):boolean {\n234\t    return s.decision === 'enabled' && (s.ours || s.appended) &&\n235\t        s.executable\n236\t}\n237\t\n238\t// The one-line state `gate status` prints.\n239\texport function summary (s:GateStatus):string {\n240\t    const p = s.hookPath\n241\t    const mine = s.ours || s.appended\n242\t    if (mine && !s.executable) {\n243\t        return `INSTALLED BUT NOT RUNNING \\u2014 ${p} is not executable, ` +\n244\t            'so git skips it (chmod +x it, or `roast gate enable` for ' +\n245\t            \"roast's own hook)\"\n246\t    }\n247\t    if (mine && s.stale) {\n248\t        return 'installed dispatcher is stale \\u2014 run `roast gate ' +\n249\t            `enable\\` to refresh: ${p}`\n250\t    }\n251\t    if (mine && s.decision === 'declined') {\n252\t        return `declined for this repo; dispatcher retained: ${p}`\n253\t    }\n254\t    if (mine && s.decision !== 'enabled') {\n255\t        return 'dispatcher installed but not enrolled in this repo ' +\n256\t            `(\\`roast gate enable\\` enables it): ${p}`\n257\t    }\n258\t    if (s.ours) return `installed: ${p}`\n259\t    if (s.appended) {\n260\t        return `installed via an appended block in a foreign hook: ${p}`\n261\t    }\n262\t    if (s.foreign && s.decision === 'declined') {\n263\t        return 'declined; a foreign pre-commit hook is present ' +\n264\t            `(untouched): ${p}`\n265\t    }\n266\t    if (s.foreign && s.appendable) {\n267\t        return 'not installed \\u2014 a foreign pre-commit hook is present ' +\n268\t            `(untouched); \\`roast gate enable\\` appends to it: ${p}`\n269\t    }\n270\t    if (s.foreign) {\n271\t        return 'not installed \\u2014 a foreign pre-commit hook is present ' +\n272\t            `and is not an appendable shell script (untouched): ${p}`\n273\t    }\n274\t    if (s.decision === 'declined') {\n275\t        return 'declined for this repo (`roast gate enable` turns it on)'\n276\t    }\n277\t    if (s.decision === 'enabled') {\n278\t        return 'enabled for this repo but the hook is missing \\u2014 run ' +\n279\t            '`roast gate enable` to reinstall'\n280\t    }\n281\t    return 'not enrolled (`roast gate enable` installs it)'\n282\t}\n283\t\n284\t// Writes an executable script, creating its directory.\n285\tasync function writeScript (file:string, body:Uint8Array):Promise<void> {\n286\t    const dir = path.dirname(file)\n287\t    try {\n288\t        await fs.mkdir(dir, { recursive:true, mode:0o755 })\n289\t    } catch (err) {\n290\t        throw fail(`mkdir ${dir}`, err)\n291\t    }\n292\t    await writeFileAtomic(file, body, { mode:0o755 })\n293\t}\n294\t\n295\t// Writes the sidecar only when the path is absent or already Roast's:\n296\t// a file by that name may belong to the repo.\n297\tasync function writeSidecar (file:string):Promise<void> {\n298\t    let info\n299\t    try {\n300\t        info = await fs.lstat(file)\n301\t    } catch (err) {\n302\t        if (!isCode(err, 'ENOENT')) throw fail(`stat ${file}`, err)\n303\t    }\n304\t    if (info?.isSymbolicLink()) {\n305\t        throw new Error(`${file} is a symlink roast did not create; move ` +\n306\t            'it aside and re-run `roast gate enable`')\n307\t    }\n308\t    if (info && !hasHeader(await readFile(file))) {\n309\t        throw new Error(`${file} already exists and was not written by ` +\n310\t            'roast; move it aside and re-run `roast gate enable`')\n311\t    }\n312\t    await writeScript(file, SCRIPT_BYTES)\n313\t}\n314\t\n315\t// Deletes the sidecar only when its header proves Roast wrote it.\n316\tasync function removeOwnedSidecar (file:string):Promise<void> {\n317\t    let info\n318\t    try {\n319\t        info = await fs.lstat(file)\n320\t    } catch (err) {\n321\t        if (isCode(err, 'ENOENT')) return\n322\t        throw fail(`stat ${file}`, err)\n323\t    }\n324\t    if (info.isSymbolicLink()) return\n325\t    if (!hasHeader(await readFile(file))) return\n326\t    try {\n327\t        await fs.rm(file)\n328\t    } catch (err) {\n329\t        if (!isCode(err, 'ENOENT')) throw fail(`remove ${file}`, err)\n330\t    }\n331\t}\n332\t\n333\t// Refreshes an existing Roast-owned regular sidecar; never creates one.\n334\texport async function refreshOwnedSidecar (file:string):Promise<void> {\n335\t    let info\n336\t    try {\n337\t        info = await fs.lstat(file)\n338\t    } catch (err) {\n339\t        if (isCode(err, 'ENOENT')) return\n340\t        throw fail(`stat ${file}`, err)\n341\t    }\n342\t    if (!info.isFile()) return\n343\t    const body = await readFile(file)\n344\t    if (hasHeader(body) && !body.equals(SCRIPT_BYTES)) {\n345\t        await writeSidecar(file)\n346\t    }\n347\t}\n348\t\n349\t// Inserts the block right after the shebang (a tail block would never run\n350\t// in a hook ending in `exit 0`), keeping the hook's mode exactly, so a\n351\t// hook its owner chmod -x'd stays disabled.\n352\tasync function appendBlock (file:string):Promise<void> {\n353\t    let body = await readFile(file)\n354\t    const mode = await permOr755(file)\n355\t    let nl = body.indexOf(NEWLINE)\n356\t    if (nl < 0) {\n357\t        // A one-line hook without a trailing newline.\n358\t        body = Buffer.concat([body, Buffer.from('\\n')])\n359\t        nl = body.length - 1\n360\t    }\n361\t    const block = '\\n' + APPEND_BEGIN + '\\n' +\n362\t        '# Added by `roast gate enable`. Delete this block (or run\\n' +\n363\t        '# `roast gate disable`) to remove the gate; the rest of this ' +\n364\t        'file is yours.\\n' +\n365\t        manualLine() + '\\n' +\n366\t        APPEND_END + '\\n'\n367\t    await writeFileAtomic(file, Buffer.concat([\n368\t        body.subarray(0, nl + 1),\n369\t        Buffer.from(block),\n370\t        body.subarray(nl + 1),\n371\t    ]), { mode })\n372\t}\n373\t\n374\t// Removes the block and the blank line before it; every other byte stays.\n375\tasync function stripBlock (file:string):Promise<void> {\n376\t    const body = await readFile(file)\n377\t    const mode = await permOr755(file)\n378\t    const lines = splitLines(body)\n379\t    const range = appendedBlock(lines)\n380\t    if (!range) {\n381\t        throw new Error(`remove gate from ${file}: the roast block has no ` +\n382\t            'closing marker; left the file untouched (delete the block ' +\n383\t            'by hand)')\n384\t    }\n385\t    let [start] = range\n386\t    const end = range[1]\n387\t    if (start > 0 && trimmed(lines[start - 1]) === '') start--\n388\t    const kept = [...lines.slice(0, start), ...lines.slice(end + 1)]\n389\t    const parts:Buffer[] = []\n390\t    kept.forEach((line, i) => {\n391\t        if (i > 0) parts.push(Buffer.from('\\n'))\n392\t        parts.push(line)\n393\t    })\n394\t    await writeFileAtomic(file, Buffer.concat(parts), { mode })\n395\t}\n396\t\n397\t// Puts the gate in place without clobbering a hook Roast did not write.\n398\t// Records no decision; callers own that. Returns the pre-install status.\n399\texport async function install (\n400\t    repo:string,\n401\t    env:Env\n402\t):Promise<{ action:InstallAction, status:GateStatus }> {\n403\t    const status = await inspect(repo, env)\n404\t    if (status.foreign && !status.appendable) {\n405\t        // The sidecar makes the printed manual line work as-is.\n406\t        await writeSidecar(status.sidecarPath)\n407\t        return { action:'manual', status }\n408\t    }\n409\t    if (status.foreign) {\n410\t        await writeSidecar(status.sidecarPath)\n411\t        await appendBlock(status.hookPath)\n412\t        return { action:'appended', status }\n413\t    }\n414\t    if (status.appended) {\n415\t        if (!status.stale) return { action:'up-to-date', status }\n416\t        await writeSidecar(status.sidecarPath)\n417\t        return { action:'refreshed', status }\n418\t    }\n419\t    if (status.ours) {\n420\t        if (!status.stale) return { action:'up-to-date', status }\n421\t        await writeScript(status.hookPath, SCRIPT_BYTES)\n422\t        return { action:'refreshed', status }\n423\t    }\n424\t    await writeScript(status.hookPath, SCRIPT_BYTES)\n425\t    return { action:'installed', status }\n426\t}\n427\t\n428\t// Deletes Roast's own hook or strips its block. A shared (core.hooksPath)\n429\t// dispatcher is preserved for other repos, only refreshed when stale.\n430\texport async function remove (\n431\t    repo:string,\n432\t    env:Env\n433\t):Promise<{ action:RemoveAction, status:GateStatus }> {\n434\t    const status = await inspect(repo, env)\n435\t    if (status.shared) {\n436\t        // Older dispatchers lack the consent check.\n437\t        if ((status.ours || status.appended) && status.stale) {\n438\t            await install(repo, env)\n439\t        }\n440\t        await refreshOwnedSidecar(status.sidecarPath)\n441\t        return { action:'preserved', status }\n442\t    }\n443\t    let action:RemoveAction = 'nothing'\n444\t    if (status.ours) {\n445\t        try {\n446\t            await fs.rm(status.hookPath)\n447\t        } catch (err) {\n448\t            if (!isCode(err, 'ENOENT')) {\n449\t                throw fail(`remove ${status.hookPath}`, err)\n450\t            }\n451\t        }\n452\t        action = 'removed'\n453\t    } else if (status.appended) {\n454\t        await stripBlock(status.hookPath)\n455\t        action = 'removed'\n456\t    }\n457\t    // A leftover sidecar goes too, but only one Roast provably wrote.\n458\t    await removeOwnedSidecar(status.sidecarPath)\n459\t    return { action, status }\n460\t}\n461\t"}]},"parent_tool_use_id":"toolu_018gF4SKTMT76p6W4DKSyVyJ","agent_id":"a65d44a24feed96f9","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"6275d4e9-16bb-429c-9c62-1834926d307e","timestamp":"2026-11-24T04:04:49.307Z","tool_result_meta":[{"id":"toolu_01Va2ns9UFPHeRVQehw3LCuk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review review cmd/verify/gate"}
