{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kwju2LdFS21JzzHrcaCotJ","type":"tool_result","content":"1\t// `roast runs` and `roast runs show` (spec 10, 2.14 and 2.15), and the\n2\t// snapshot subcommands `runs checkout` and `runs prune` (spec 11).\n3\timport fs from 'node:fs/promises'\n4\timport os from 'node:os'\n5\timport path from 'node:path'\n6\timport type { Argv } from 'yargs'\n7\timport { recordDir } from '../record/dir.js'\n8\timport { readMeta, reportPath, type Meta } from '../record/meta.js'\n9\timport { gitRoot } from '../git/git.js'\n10\timport {\n11\t    formatGoDuration, parseGoDuration, type GoDuration,\n12\t} from '../gocompat/duration.js'\n13\timport { prune, restore } from '../snapshot/snapshot.js'\n14\timport { compareBytes } from '../gocompat/strings.js'\n15\timport { textBytes } from '../textsafe/textsafe.js'\n16\timport type { CommandArgs, CommandDef, RunContext } from './command.js'\n17\timport { UsageError } from './errors.js'\n18\t\n19\tconst DEFAULT_LIMIT = 20\n20\t\n21\t// Go bufio.Scanner's maximum token size as Roast configures it.\n22\tconst MAX_LINE = 16 * 1024 * 1024\n23\t\n24\tconst INT64_MIN = -(2n ** 63n)\n25\tconst INT64_MAX = 2n ** 63n - 1n\n26\t\n27\t// A decimal Go int flag value.\n28\tfunction parseLimit (raw:unknown):number {\n29\t    if (raw === undefined) return DEFAULT_LIMIT\n30\t    const s = String(raw)\n31\t    if (!/^[+-]?[0-9]+$/.test(s)) {\n32\t        throw new UsageError(\n33\t            `invalid argument ${JSON.stringify(s)} for \"--limit\" flag`)\n34\t    }\n35\t    const n = BigInt(s)\n36\t    if (n < INT64_MIN || n > INT64_MAX) {\n37\t        throw new UsageError(`invalid argument ${JSON.stringify(s)} ` +\n38\t            'for \"--limit\" flag: value out of range')\n39\t    }\n40\t    return Number(n)\n41\t}\n42\t\n43\t// Splits like Go's bufio.Scanner with ScanLines: on \\n, dropping one\n44\t// trailing \\r; a final unterminated line counts. A line of MAX_LINE\n45\t// bytes or more stops the scan, keeping the lines before it.\n46\texport function scanLines (data:Buffer):Buffer[] {\n47\t    const lines:Buffer[] = []\n48\t    let start = 0\n49\t    while (start < data.length) {\n50\t        let end = data.indexOf(0x0a, start)\n51\t        const terminated = end !== -1\n52\t        if (!terminated) end = data.length\n53\t        if (end - start >= MAX_LINE) break\n54\t        let line = data.subarray(start, end)\n55\t        if (line.length > 0 && line[line.length - 1] === 0x0d) {\n56\t            line = line.subarray(0, line.length - 1)\n57\t        }\n58\t        lines.push(line)\n59\t        start = end + 1\n60\t    }\n61\t    return lines\n62\t}\n63\t\n64\t// Go `%-Ns`: right-padded to n code points, never truncated.\n65\tfunction pad (s:string, n:number):string {\n66\t    const len = [...s].length\n67\t    return len >= n ? s : s + ' '.repeat(n - len)\n68\t}\n69\t\n70\ttype Json = Record<string, unknown>\n71\t\n72\tfunction str (o:Json, key:string):string {\n73\t    const v = o[key] ?? ''\n74\t    if (typeof v !== 'string') throw new TypeError(key)\n75\t    return v\n76\t}\n77\t\n78\tfunction int (o:Json, key:string):number {\n79\t    const v = o[key] ?? 0\n80\t    if (!Number.isSafeInteger(v)) throw new TypeError(key)\n81\t    return v as number\n82\t}\n83\t\n84\t// One index line in the `runs` listing format, or null when the line\n85\t// does not decode the way Go's json.Unmarshal would accept.\n86\texport function formatRunLine (line:string):string|null {\n87\t    try {\n88\t        const o:unknown = JSON.parse(line)\n89\t        if (o === null) return formatRunLine('{}')\n90\t        if (typeof o !== 'object' || Array.isArray(o)) return null\n91\t        const r = o as Json\n92\t        const quick = r.quick ?? false\n93\t        if (typeof quick !== 'boolean') return null\n94\t        const files = r.files_reviewed ?? []\n95\t        if (!Array.isArray(files) ||\n96\t            files.some(f => f !== null && typeof f !== 'string')) {\n97\t            return null\n98\t        }\n99\t        return `${str(r, 'ts')}  ${pad(str(r, 'run_id'), 25)} ` +\n100\t            `${pad(str(r, 'mode'), 8)} q=${pad(String(quick), 5)} ` +\n101\t            `${pad(str(r, 'assessment'), 30)} ` +\n102\t            `findings=${int(r, 'n_findings')} ` +\n103\t            `refuted=${int(r, 'n_refuted')} files=${files.length}  ` +\n104\t            `${str(r, 'repo')}\\n`\n105\t    } catch {\n106\t        return null\n107\t    }\n108\t}\n109\t\n110\t// Every index line across the monthly files, oldest first.\n111\tasync function indexLines (dir:string):Promise<Buffer[]> {\n112\t    let names:string[]\n113\t    try {\n114\t        names = await fs.readdir(dir)\n115\t    } catch {\n116\t        return []\n117\t    }\n118\t    const files = names\n119\t        .filter(n => n.startsWith('runs-') && n.endsWith('.jsonl'))\n120\t        .sort(compareBytes)\n121\t    const lines:Buffer[] = []\n122\t    for (const name of files) {\n123\t        let data:Buffer\n124\t        try {\n125\t            data = await fs.readFile(path.join(dir, name))\n126\t        } catch {\n127\t            continue\n128\t        }\n129\t        lines.push(...scanLines(data))\n130\t    }\n131\t    return lines\n132\t}\n133\t\n134\tasync function listHandler (\n135\t    args:CommandArgs,\n136\t    ctx:RunContext\n137\t):Promise<void> {\n138\t    const limit = parseLimit(args.limit)\n139\t    const dir = await recordDir(ctx.cwd, {\n140\t        env:ctx.env as NodeJS.ProcessEnv,\n141\t        signal:ctx.signal,\n142\t    })\n143\t    if (!dir) {\n144\t        throw new UsageError('cannot resolve record directory: run ' +\n145\t            'inside a Git repository')\n146\t    }\n147\t    let lines = await indexLines(dir)\n148\t    if (limit > 0 && lines.length > limit) {\n149\t        lines = lines.slice(lines.length - limit)\n150\t    }\n151\t    if (lines.length === 0) {\n152\t        ctx.stderr.write(`roast: no run records in ${dir}\\n`)\n153\t        return\n154\t    }\n155\t    if (args.json) {\n156\t        for (const line of lines) {\n157\t            ctx.stdout.write(Buffer.concat([line, Buffer.from('\\n')]))\n158\t        }\n159\t        return\n160\t    }\n161\t    for (const line of lines) {\n162\t        const out = formatRunLine(line.toString('utf8'))\n163\t        if (out !== null) ctx.stdout.write(out)\n164\t    }\n165\t}\n166\t\n167\tasync function showHandler (\n168\t    args:CommandArgs,\n169\t    ctx:RunContext\n170\t):Promise<void> {\n171\t    const dir = await recordDir(ctx.cwd, {\n172\t        env:ctx.env as NodeJS.ProcessEnv,\n173\t        signal:ctx.signal,\n174\t    })\n175\t    // Plain errors (exit 4), including invalid IDs such as `..`.\n176\t    const file = await reportPath(dir, String(args['run-id']))\n177\t    let content:Buffer\n178\t    try {\n179\t        content = await fs.readFile(file)\n180\t    } catch (err) {\n181\t        const msg = err instanceof Error ? err.message : String(err)\n182\t        throw new Error(`run has no report artifact: ${msg}`,\n183\t            { cause:err })\n184\t    }\n185\t    ctx.stdout.write(textBytes(content))\n186\t}\n187\t\n188\tconst showCommand:CommandDef = {\n189\t    command:'show <run-id>',\n190\t    describe:'Print the stored report of a run',\n191\t    handler:showHandler,\n192\t}\n193\t\n194\tfunction errorMessage (err:unknown):string {\n195\t    return err instanceof Error ? err.message : String(err)\n196\t}\n197\t\n198\t// `runs checkout <run-id> [dir]` (spec 11): restores the run's snapshot\n199\t// into a detached linked worktree; stdout carries only its path.\n200\tasync function checkoutHandler (\n201\t    args:CommandArgs,\n202\t    ctx:RunContext\n203\t):Promise<void> {\n204\t    const env = ctx.env as NodeJS.ProcessEnv\n205\t    const id = String(args['run-id'])\n206\t    let meta:Meta\n207\t    try {\n208\t        const dir = await recordDir(ctx.cwd,\n209\t            { env, signal:ctx.signal })\n210\t        meta = (await readMeta(dir, id)).meta\n211\t    } catch (err) {\n212\t        ctx.signal.throwIfAborted()\n213\t        throw new UsageError(errorMessage(err), { cause:err })\n214\t    }\n215\t    if (!meta.snapshot.captured) {\n216\t        throw new UsageError(`run ${meta.run_id} has no Git snapshot ` +\n217\t            `(${meta.snapshot.reason ?? ''})`)\n218\t    }\n219\t    let dest:string\n220\t    if (args.dir !== undefined) {\n221\t        dest = path.resolve(ctx.cwd, String(args.dir))\n222\t    } else {\n223\t        const tmp = await fs.mkdtemp(\n224\t            path.join(os.tmpdir(), 'roast-checkout-'))\n225\t        dest = path.join(tmp, meta.run_id)\n226\t    }\n227\t    try {\n228\t        await restore(meta.repo, meta.run_id, dest,\n229\t            { env, signal:ctx.signal })\n230\t    } catch (err) {\n231\t        ctx.signal.throwIfAborted()\n232\t        throw new Error(`restore run ${meta.run_id}: ${errorMessage(err)}`,\n233\t            { cause:err })\n234\t    }\n235\t    ctx.stderr.write(`roast: remove with: git -C ${meta.repo} worktree ` +\n236\t        `remove --force ${dest}\\n`)\n237\t    ctx.stdout.write(dest + '\\n')\n238\t}\n239\t\n240\tconst checkoutCommand:CommandDef = {\n241\t    command:'checkout <run-id> [dir]',\n242\t    describe:'Materialize a run\\'s Git snapshot as a linked worktree',\n243\t    handler:checkoutHandler,\n244\t}\n245\t\n246\tconst DEFAULT_OLDER_THAN = '720h'\n247\tconst NS_PER_MS = 1_000_000n\n248\tconst NS_PER_HOUR = 3_600_000_000_000n\n249\tconst MS_PER_HOUR = 3_600_000\n250\t\n251\tfunction parseOlderThan (raw:unknown):GoDuration {\n252\t    const s = raw === undefined ? DEFAULT_OLDER_THAN : String(raw)\n253\t    try {\n254\t        return parseGoDuration(s)\n255\t    } catch (err) {\n256\t        throw new UsageError(`invalid argument ${JSON.stringify(s)} for ` +\n257\t            `\"--older-than\" flag: ${errorMessage(err)}`, { cause:err })\n258\t    }\n259\t}\n260\t\n261\t// Go `age.Round(time.Hour)` (half away from zero), as a Go duration.\n262\tfunction roundedAge (ageMs:number):string {\n263\t    const hours = Math.sign(ageMs) * Math.round(Math.abs(ageMs) /\n264\t        MS_PER_HOUR)\n265\t    return formatGoDuration(BigInt(hours) * NS_PER_HOUR)\n266\t}\n267\t\n268\t// `runs prune [--older-than d] [--dry-run]` (spec 11): deletes aged\n269\t// snapshot refs; run records are never touched.\n270\tasync function pruneHandler (\n271\t    args:CommandArgs,\n272\t    ctx:RunContext\n273\t):Promise<void> {\n274\t    const olderThan = parseOlderThan(args['older-than'])\n275\t    const env = ctx.env as NodeJS.ProcessEnv\n276\t    let repo:string\n277\t    try {\n278\t        repo = await gitRoot(ctx.cwd, { env, signal:ctx.signal })\n279\t    } catch (err) {\n280\t        ctx.signal.throwIfAborted()\n281\t        throw new UsageError(errorMessage(err), { cause:err })\n282\t    }\n283\t    const dryRun = Boolean(args['dry-run'])\n284\t    // Fractional milliseconds keep sub-millisecond thresholds positive.\n285\t    const ms = Number(olderThan / NS_PER_MS) +\n286\t        Number(olderThan % NS_PER_MS) / 1e6\n287\t    const pruned = await prune(repo, ms, dryRun,\n288\t        { env, signal:ctx.signal })\n289\t    if (pruned.length === 0) {\n290\t        ctx.stderr.write('roast: no snapshot refs older than ' +\n291\t            `${formatGoDuration(olderThan)}\\n`)\n292\t        return\n293\t    }\n294\t    const verb = dryRun ? 'would delete' : 'deleted'\n295\t    for (const p of pruned) {\n296\t        ctx.stdout.write(`${verb} ${p.ref} (age ${roundedAge(p.ageMs)})\\n`)\n297\t    }\n298\t}\n299\t\n300\tconst pruneCommand:CommandDef = {\n301\t    command:'prune',\n302\t    describe:'Delete old snapshot refs under refs/roast/snapshots/',\n303\t    builder:(y:Argv) => y\n304\t        .option('older-than', {\n305\t            type:'string',\n306\t            describe:'Delete snapshot refs at least this old',\n307\t            default:undefined,\n308\t            defaultDescription:'720h0m0s',\n309\t        })\n310\t        .option('dry-run', {\n311\t            type:'boolean',\n312\t            default:false,\n313\t            describe:'List refs that would be deleted',\n314\t        }),\n315\t    handler:pruneHandler,\n316\t}\n317\t\n318\t// The `runs` subcommands.\n319\texport const runsSubcommands:CommandDef[] = [\n320\t    showCommand, checkoutCommand, pruneCommand,\n321\t]\n322\t\n323\texport const runsCommand:CommandDef = {\n324\t    command:'runs',\n325\t    subcommands:runsSubcommands,\n326\t    describe:'List past review runs',\n327\t    builder:(y:Argv) => y\n328\t        .option('limit', {\n329\t            type:'string',\n330\t            describe:'Show the last N runs (<= 0 for all)',\n331\t            default:undefined,\n332\t            defaultDescription:String(DEFAULT_LIMIT),\n333\t        })\n334\t        .option('json', {\n335\t            type:'boolean',\n336\t            default:false,\n337\t            describe:'Print raw index lines',\n338\t        }),\n339\t    handler:listHandler,\n340\t}\n341\t"}]},"parent_tool_use_id":"toolu_01Tw6eUvmTfMfsVNapeDwjUZ","agent_id":"acf0b2540a7701a5f","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"b6d5e4de-321d-4123-871c-beeaa47425af","timestamp":"2026-11-24T04:04:00.704Z","tool_result_meta":[{"id":"toolu_01Kwju2LdFS21JzzHrcaCotJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review snapshot/runs/survey"}
