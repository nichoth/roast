{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FmBgCPiFXozrnveKUkfRG1","type":"tool_result","content":"// The per-repository enrollment decision in local git config (spec 12,\n// 2.3). Only --local counts: a global value never enrolls a repo.\nimport {\n    CONFIG_KEY_DECISION,\n    CONFIG_KEY_NOTICE,\n} from './constants.js'\nimport { configGet, configSet, configUnset, type Env } from './git-config.js'\n\nexport type Decision = 'none'|'enabled'|'declined'\n\n// The values the hook script also accepts as consent.\nconst ENABLED = ['enabled', 'enable', 'true', 'yes', 'on', '1']\nconst DECLINED = ['declined', 'disabled', 'false', 'no', 'off', '0']\n\n// An unrecognized value reads as 'none': a typo means \"unanswered\".\nexport async function readDecision (repo:string, env:Env):Promise<Decision> {\n    const v = (await configGet(repo, CONFIG_KEY_DECISION, env))\n        .trim().toLowerCase()\n    if (ENABLED.includes(v)) return 'enabled'\n    if (DECLINED.includes(v)) return 'declined'\n    return 'none'\n}\n\n// Records a decision and clears the hint marker, which exists only for\n// the undecided state.\nexport async function recordDecision (\n    repo:string,\n    d:Decision,\n    env:Env\n):Promise<void> {\n    await configUnset(repo, CONFIG_KEY_NOTICE, env)\n    if (d === 'none') {\n        await configUnset(repo, CONFIG_KEY_DECISION, env)\n        return\n    }\n    await configSet(repo, CONFIG_KEY_DECISION, d, env)\n}\n\n// Remembers that the \"how to enable\" hint was printed for this repo.\nexport function recordNotice (repo:string, env:Env):Promise<void> {\n    return configSet(repo, CONFIG_KEY_NOTICE, 'sent', env)\n}\n// The git calls the gate makes (spec 12, 2.2), all `git -C <repo> ...`\n// through the shared runner with the caller's env.\nimport path from 'node:path'\nimport { git, gitOk } from '../git/git.js'\n\nexport type Env = Readonly<Record<string, string|undefined>>\n\nfunction opts (env:Env):{ env:NodeJS.ProcessEnv } {\n    return { env:env as NodeJS.ProcessEnv }\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\n// A local config value, trimmed; '' when unset or on any failure.\nexport async function configGet (\n    repo:string,\n    key:string,\n    env:Env\n):Promise<string> {\n    try {\n        const out = await git(repo, ['config', '--local', '--get', key],\n            opts(env))\n        return out.toString().trim()\n    } catch {\n        return ''\n    }\n}\n\nexport async function configSet (\n    repo:string,\n    key:string,\n    value:string,\n    env:Env\n):Promise<void> {\n    try {\n        await git(repo, ['config', '--local', key, value], opts(env))\n    } catch (err) {\n        throw new Error(`git config ${key}: ${message(err)}`, { cause:err })\n    }\n}\n\n// Unsets a local key; reports only whether git succeeded (exit 5 means\n// the key was not set, which callers ignore).\nexport function configUnset (\n    repo:string,\n    key:string,\n    env:Env\n):Promise<boolean> {\n    return gitOk(repo, ['config', '--local', '--unset', key], opts(env))\n}\n\n// Whether any config scope sets core.hooksPath (not only --local: a global\n// or system hooks directory is shared too).\nexport function hooksPathConfigured (repo:string, env:Env):Promise<boolean> {\n    return gitOk(repo, ['config', '--get', 'core.hooksPath'], opts(env))\n}\n\n// The absolute path of hooks/<name>. Git honours core.hooksPath and, in a\n// linked worktree, the common git dir.\nexport async function resolveHookPath (\n    repo:string,\n    name:string,\n    env:Env\n):Promise<string> {\n    let out:string\n    try {\n        out = (await git(repo, ['rev-parse', '--git-path', `hooks/${name}`],\n            opts(env))).toString().trim()\n    } catch (err) {\n        throw new Error(`resolve hooks path in ${repo}: ${message(err)}`,\n            { cause:err })\n    }\n    if (out === '') {\n        throw new Error(`resolve hooks path in ${repo}: git returned nothing`)\n    }\n    return path.isAbsolute(out) ? out : path.join(repo, out)\n}","is_error":false}]},"parent_tool_use_id":"toolu_018gF4SKTMT76p6W4DKSyVyJ","agent_id":"a65d44a24feed96f9","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"f900d411-af9f-4473-865b-d768686e3e15","timestamp":"2026-11-24T04:06:56.603Z","tool_result_meta":[{"id":"toolu_01FmBgCPiFXozrnveKUkfRG1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review review cmd/verify/gate"}
