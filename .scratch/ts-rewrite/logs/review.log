{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WEq7NkuPXqgDxuhRcMBEDk","type":"tool_result","content":"1\t// `review` flags (spec 01, 2.6), their value syntax (2.11), and the raw\n2\t// validation that runs before any config is read (2.7).\n3\timport type { Argv } from 'yargs'\n4\timport { Parser } from 'yargs/helpers'\n5\timport { parseGoDuration, type GoDuration } from '../gocompat/duration.js'\n6\timport { goTrimSpace } from '../gocompat/strings.js'\n7\timport { parseSeverity, severityRank } from '../review/types.js'\n8\timport type { CommandArgs } from './command.js'\n9\timport { UsageError } from './errors.js'\n10\t\n11\texport interface RoleFlags {\n12\t    baseUrl?:string;\n13\t    model?:string;\n14\t    protocol?:string;\n15\t    maxOutputTokens?:number;\n16\t}\n17\t\n18\t// Optional fields are undefined when the flag was not given (\"changed\"\n19\t// in Go terms); the documented default applies later.\n20\texport interface ReviewFlags {\n21\t    config:string;\n22\t    base:string;\n23\t    uncommittedOnly:boolean;\n24\t    staged:boolean;\n25\t    task:string;\n26\t    format:string;\n27\t    maxSeverity:string;\n28\t    paths:string[];\n29\t    exclude:string[];\n30\t    includeVendored:boolean;\n31\t    mode:string;\n32\t    quick:boolean;\n33\t    noVerify:boolean;\n34\t    interactive:boolean;\n35\t    maxTurns?:number;\n36\t    deadline?:GoDuration;\n37\t    requestTimeout?:GoDuration;\n38\t    maxTokensTotal?:number;\n39\t    maxVerified?:number;\n40\t    maxAttempts?:number;\n41\t    showDropped:boolean;\n42\t    lang:string[];\n43\t    scope:string;\n44\t    authorModel:string;\n45\t    finder:RoleFlags;\n46\t    verifier:RoleFlags;\n47\t}\n48\t\n49\texport const DEFAULT_MAX_TURNS = 16\n50\texport const SURVEY_MAX_TURNS = 40\n51\texport const DEFAULT_TASK = '(not provided)'\n52\t\n53\tconst BOOLEANS = [\n54\t    'uncommitted-only', 'staged', 'include-vendored', 'quick', 'no-verify',\n55\t    'interactive', 'show-dropped',\n56\t] as const\n57\t\n58\tconst STRINGS = [\n59\t    'config', 'base', 'task', 'format', 'max-severity', 'mode', 'scope',\n60\t    'author-model', 'max-turns', 'deadline', 'request-timeout',\n61\t    'max-tokens-total', 'max-verified', 'max-attempts',\n62\t    'finder-base-url', 'finder-model', 'finder-protocol',\n63\t    'finder-max-output-tokens', 'verifier-base-url', 'verifier-model',\n64\t    'verifier-protocol', 'verifier-max-output-tokens', 'error-format',\n65\t] as const\n66\t\n67\tconst SLICES = ['paths', 'exclude', 'lang'] as const\n68\t\n69\tconst DESCRIBE:Record<string, string> = {\n70\t    config:'Project config path (default: nearest .roast.json up to ' +\n71\t        'the Git toplevel)',\n72\t    base:'Diff base ref',\n73\t    'uncommitted-only':'Review only uncommitted changes',\n74\t    staged:'Review exactly the staged set',\n75\t    task:'What the builder was asked to do',\n76\t    format:'Output format (json|markdown|both)',\n77\t    'max-severity':'Exit 1 when a finding reaches this severity ' +\n78\t        '(INFO|LOW|MEDIUM|HIGH|CRITICAL)',\n79\t    paths:'Limit the review to these Git pathspecs',\n80\t    exclude:'Exclude these Git pathspecs',\n81\t    'include-vendored':'Review vendored and generated files',\n82\t    mode:'Review mode (code|prose|mixed|auto)',\n83\t    quick:'Single-shot finder, no verification',\n84\t    'no-verify':'Skip verification',\n85\t    interactive:'Let the finder navigate the checkout',\n86\t    'max-turns':'Max interactive finder turns (default 16, 40 with ' +\n87\t        '--scope repo)',\n88\t    deadline:'Finder work deadline (default 10m, 25m with --scope ' +\n89\t        'repo; 0 disables)',\n90\t    'request-timeout':'Per inference request timeout (default 10m; 0 ' +\n91\t        'disables)',\n92\t    'max-tokens-total':'Shared token ceiling (default 3000000; 0 disables)',\n93\t    'max-verified':'Max findings sent to the verifier (default 25)',\n94\t    'max-attempts':'Provider and structured-output attempts (default 4)',\n95\t    'show-dropped':'Render malformed and refuted candidates',\n96\t    lang:'Prompt packs (go|react|frontend|web); none disables',\n97\t    scope:'Review scope (diff|repo)',\n98\t    'author-model':'Model or family that wrote the change',\n99\t}\n100\t\n101\tfor (const role of ['finder', 'verifier']) {\n102\t    DESCRIBE[`${role}-base-url`] = `${role} endpoint override`\n103\t    DESCRIBE[`${role}-model`] = `${role} model override`\n104\t    DESCRIBE[`${role}-protocol`] =\n105\t        `${role} protocol override (chat|responses|anthropic)`\n106\t    DESCRIBE[`${role}-max-output-tokens`] = `${role} output token ceiling`\n107\t}\n108\t\n109\tconst DEFAULTS:Record<string, string|boolean> = {\n110\t    config:'',\n111\t    base:'',\n112\t    task:DEFAULT_TASK,\n113\t    format:'both',\n114\t    'max-severity':'',\n115\t    mode:'auto',\n116\t    scope:'diff',\n117\t    'author-model':'',\n118\t}\n119\t\n120\t// Declares every review flag on `y`. Flags whose \"changed\" state matters\n121\t// have no yargs default.\n122\texport function reviewBuilder (y:Argv):Argv {\n123\t    let b = y\n124\t    for (const name of BOOLEANS) {\n125\t        b = b.option(name, {\n126\t            type:'boolean', default:false, describe:DESCRIBE[name],\n127\t        })\n128\t    }\n129\t    for (const name of STRINGS) {\n130\t        if (name === 'error-format') continue\n131\t        b = b.option(name, {\n132\t            type:'string',\n133\t            describe:DESCRIBE[name],\n134\t            ...(name in DEFAULTS ? { default:DEFAULTS[name] } : {}),\n135\t        })\n136\t    }\n137\t    for (const name of SLICES) {\n138\t        b = b.option(name, {\n139\t            type:'string', array:true, nargs:1, describe:DESCRIBE[name],\n140\t        })\n141\t    }\n142\t    return b\n143\t}\n144\t\n145\t// yargs keeps only the last occurrence of a repeated flag, so slice\n146\t// flags are read again from argv with occurrences appended.\n147\tfunction sliceValues (argv:readonly string[]):Record<string, string[]> {\n148\t    const parsed = Parser([...argv], {\n149\t        boolean:[...BOOLEANS, 'help', 'version'],\n150\t        string:[...STRINGS],\n151\t        array:[...SLICES],\n152\t        narg:{ paths:1, exclude:1, lang:1 },\n153\t        configuration:{\n154\t            'boolean-negation':false,\n155\t            'camel-case-expansion':false,\n156\t            'dot-notation':false,\n157\t            'parse-numbers':false,\n158\t            'parse-positional-numbers':false,\n159\t            'duplicate-arguments-array':true,\n160\t            'flatten-duplicate-arrays':true,\n161\t            'greedy-arrays':false,\n162\t        },\n163\t    })\n164\t    const out:Record<string, string[]> = {}\n165\t    for (const name of SLICES) {\n166\t        const raw:unknown = parsed[name]\n167\t        const list = raw === undefined ? [] :\n168\t            Array.isArray(raw) ? raw : [raw]\n169\t        out[name] = list.flatMap(v => String(v).split(','))\n170\t    }\n171\t    return out\n172\t}\n173\t\n174\tfunction str (args:CommandArgs, name:string):string|undefined {\n175\t    const v = args[name]\n176\t    if (v === undefined) return undefined\n177\t    return String(Array.isArray(v) ? v[v.length - 1] : v)\n178\t}\n179\t\n180\t// Decimal integers only, optional sign (spec 2.11).\n181\texport function parseIntFlag (name:string, value:string):number {\n182\t    if (!/^[+-]?[0-9]+$/.test(value)) {\n183\t        throw new UsageError(`invalid argument ${JSON.stringify(value)} ` +\n184\t            `for \"--${name}\" flag: invalid syntax`)\n185\t    }\n186\t    const n = Number(value)\n187\t    if (!Number.isSafeInteger(n)) {\n188\t        throw new UsageError(`invalid argument ${JSON.stringify(value)} ` +\n189\t            `for \"--${name}\" flag: value out of range`)\n190\t    }\n191\t    return n\n192\t}\n193\t\n194\tfunction intFlag (args:CommandArgs, name:string):number|undefined {\n195\t    const v = str(args, name)\n196\t    retu