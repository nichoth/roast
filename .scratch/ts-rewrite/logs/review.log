{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R4xt9MbVNRAEz2m7M7A1xf","type":"tool_result","content":"51:test('a yes on a terminal installs the gate and the review runs',\n86:test('a no is remembered and never asked again', async t => {\n100:test('without terminals the offer is a one-time hint', async t => {\n114:test('GIT_INDEX_FILE suppresses the offer', async t => {\n127:test('gate.offer false neither prompts nor hints', async t => {\n143:test('ROAST_NO_HOOK does not stop the offer', async t => {\n152:test('bare roast offers the gate too', async t => {\n160:test('only a toplevel config gets an offer', async t => {\n184:test('a toplevel config that fails to load gives no offer', async t => {\n208:test('a declined repo gets a stale shared dispatcher refreshed', async t => {\n224:test('an inherited shared gate is not adopted', async t => {\n238:test('a failed bootstrap does not change the exit code', async t => {\n// The bootstrap module seam (spec 12, 2.11), for what the CLI cannot\n// observe through git config alone.\nimport { test } from '../helpers/test.js'\nimport { bootstrap } from '../../src/gate/bootstrap.js'\nimport { gateRepo, localConfig } from './helpers.js'\n\ntest('a non-interactive hint is printed once per repository', async t => {\n    const r = gateRepo(t)\n    const lines:string[] = []\n    const opts = {\n        repo:r.dir,\n        env:r.env,\n        noOffer:false,\n        out:(line:string) => { lines.push(line) },\n    }\n    t.equal(await bootstrap(opts), 'hinted', 'first run hints')\n    t.equal(lines.length, 1, 'one message')\n    t.equal(localConfig(r, 'roast.gate-notice'), 'sent', 'notice recorded')\n    t.equal(await bootstrap(opts), 'quiet', 'second run is quiet')\n    t.equal(lines.length, 1, 'nothing more printed')\n})\ntest/gate/bootstrap.ts","is_error":false}]},"parent_tool_use_id":"toolu_018gF4SKTMT76p6W4DKSyVyJ","agent_id":"a65d44a24feed96f9","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid"