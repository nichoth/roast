{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011GLozFY8AKDiTYMRGdAPiN","type":"tool_result","content":"     1\t// The `anthropic` adapter through `createModelClient` / `createClient`\n     2\t// against fake servers (spec 06, 5: ambient environment, redirects,\n     3\t// signed thinking replay, DeepSeek thinking mode).\n     4\timport { test, type CleanupTest } from '../helpers/test.js'\n     5\timport {\n     6\t    startInferenceServer,\n     7\t    type InferenceServer,\n     8\t    type Script,\n     9\t} from '../helpers/inference-server.js'\n    10\timport {\n    11\t    anthropicCalls,\n    12\t    startBindingServer,\n    13\t    startDeepSeekServer,\n    14\t    thinkingBlock,\n    15\t    toolUseBlock,\n    16\t    type DeepSeekAnswer,\n    17\t} from '../helpers/anthropic-fakes.js'\n    18\timport { createClient, createModelClient } from '../../src/llm/client.js'\n    19\timport { newSessionId } from '../../src/llm/session.js'\n    20\timport {\n    21\t    EndpointError,\n    22\t    errorStatus,\n    23\t    hasSentinel,\n    24\t    isRetryable,\n    25\t} from '../../src/llm/errors.js'\n    26\timport { newLedger } from '../../src/llm/ledger.js'\n    27\timport type {\n    28\t    ClientConfig,\n    29\t    ModelRequest,\n    30\t    Tool,\n    31\t} from '../../src/llm/types.js'\n    32\timport {\n    33\t    failure,\n    34\t    finalTool,\n    35\t    options,\n    36\t    readTool,\n    37\t    recordTool,\n    38\t} from './agent-helpers.js'\n    39\t\n    40\tasync function server (t:CleanupTest, script:Script):Promise<InferenceServer> {\n    41\t    const s = await startInferenceServer(script)\n    42\t    t.cleanup(() => s.close())\n    43\t    return s\n    44\t}\n    45\t\n    46\tfunction cfg (url:string, over:Partial<ClientConfig> = {}):ClientConfig {\n    47\t    return {\n    48\t        role:'finder',\n    49\t        baseUrl:`${url}/v1`,\n    50\t        apiKey:'sk-ant-test',\n    51\t        model:'claude-test',\n    52\t        protocol:'anthropic',\n    53\t        maxOutputTokens:1024,\n    54\t        maxAttempts:2,\n    55\t        requestTimeoutMs:0,\n    56\t        ...over,\n    57\t    }\n    58\t}\n    59\t\n    60\tfunction req ():ModelRequest {\n    61\t    return {\n    62\t        system:'sys',\n    63\t        items:[{ role:'user', text:'review this' }],\n    64\t        tools:[{ name:'read', description:'d', schema:{ type:'object' } }],\n    65\t        sessionId:newSessionId(),\n    66\t        signal:new AbortController().signal,\n    67\t    }\n    68\t}\n    69\t\n    70\tconst ok:Script = () => ({ stream:anthropicCalls([]) })\n    71\t\n    72\tconst AMBIENT:Record<string, string> = {\n    73\t    ANTHROPIC_API_KEY:'sk-ant-ambient',\n    74\t    ANTHROPIC_AUTH_TOKEN:'ambient-token',\n    75\t    ANTHROPIC_CUSTOM_HEADERS:'X-Agent-Session-Id: ambient-session\\n' +\n    76\t        'User-Agent: ambient-ua\\nX-Ambient: yes',\n    77\t    ANTHROPIC_WORKSPACE_ID:'ambient-workspace',\n    78\t    ANTHROPIC_PROFILE:'ambient-profile',\n    79\t    OPENAI_API_KEY:'sk-ambient-openai',\n    80\t}\n    81\t\n    82\tconst TRANSPORT = new Set(['host', 'connection', 'content-length',\n    83\t    'accept-encoding', 'accept-language', 'sec-fetch-mode'])\n    84\t\n    85\ttest('anthropic ignores ambient ANTHROPIC_* variables', async t => {\n    86\t    const s = await server(t, ok)\n    87\t    const decoy = await server(t, ok)\n    88\t    const vars = { ...AMBIENT, ANTHROPIC_BASE_URL:decoy.url }\n    89\t    const saved:Record<string, string|undefined> = {}\n    90\t    for (const [k, v] of Object.entries(vars)) {\n    91\t        saved[k] = process.env[k]\n    92\t        process.env[k] = v\n    93\t    }\n    94\t    t.cleanup(() => {\n    95\t        for (const [k, v] of Object.entries(saved)) {\n    96\t            if (v === undefined) delete process.env[k]\n    97\t            else process.env[k] = v\n    98\t        }\n    99\t    })\n   100\t    const r = req()\n   101\t    await createModelClient(cfg(s.url)).send(r)\n   102\t    t.equal(s.requests.length, 1, 'one request')\n   103\t    t.equal(decoy.requests.length, 0, 'decoy saw nothing')\n   104\t    const got = s.requests[0]\n   105\t    t.equal(got.path, '/v1/messages', 'configured endpoint')\n   106\t    const names = Object.keys(got.headers).filter(n => !TRANSPORT.has(n))\n   107\t    t.deepEqual(names.sort(), ['accept', 'anthropic-version',\n   108\t        'content-type', 'user-agent', 'x-agent-session-id', 'x-api-key'],\n   109\t    'only Roast headers')\n   110\t    t.equal(got.headers['x-api-key'], 'sk-ant-test', 'configured key')\n   111\t    t.ok(String(got.headers['anthropic-version']).length > 0, 'version')\n   112\t    t.ok(String(got.headers['user-agent']).startsWith('roast/'), 'agent')\n   113\t    t.equal(got.headers['x-agent-session-id'], r.sessionId, 'session id')\n   114\t    const values = Object.values(got.headers).join('\\n')\n   115\t    for (const v of Object.values(AMBIENT)) {\n   116\t        t.ok(!values.includes(v), `no ambient value ${v}`)\n   117\t    }\n   118\t})\n   119\t\n   120\ttest('anthropic: a 3xx is refused and sends no key onward', async t => {\n   121\t    const target = await server(t, ok)\n   122\t    for (const status of [301, 302, 307, 308]) {\n   123\t        const s = await server(t, () => ({\n   124\t            status,\n   125\t            headers:{ Location:`${target.url}/v1/messages` },\n   126\t        }))\n   127\t        const client = createModelClient(cfg(s.url, { maxAttempts:3 }))\n   128\t        const err = await failure(client.send(req()))\n   129\t        t.ok(err instanceof EndpointError, `${status}: endpoint error`)\n   130\t        t.ok(hasSentinel(err, 'endpoint'), `${status}: sentinel`)\n   131\t        t.ok(!isRetryable(err), `${status}: not retryable`)\n   132\t        t.equal(errorStatus(err), status, `${status}: status kept`)\n   133\t        t.equal(s.requests.length, 1, `${status}: one request`)\n   134\t    }\n   135\t    t.equal(target.requests.length, 0, 'redirect target never contacted')\n   136\t})\n   137\t\n   138\tfunction submitArgs (summary:string) {\n   139\t    return { summary }\n   140\t}\n   141\t\n   142\ttest('binding fake rejects a changed prefix', async t => {\n   143\t    const s = await startBindingServer(() => [\n   144\t        thinkingBlock(''),\n   145\t        toolUseBlock('toolu-1', 'read', {}),\n   146\t    ])\n   147\t    t.cleanup(() => s.close())\n   148\t    async function post (body:unknown):Promise<number> {\n   149\t        const res = await fetch(`${s.url}/v1/messages`, {\n   150\t            method:'POST',\n   151\t            body:JSON.stringify(body),\n   152\t        })\n   153\t        await res.text()\n   154\t        return res.status\n   155\t    }\n   156\t    const user = {\n   157\t        role:'user',\n   158\t        content:[{ type:'text', text:'a' }, { type:'text', text:'b' }],\n   159\t    }\n   160\t    t.equal(await post({ system:[], tools:[], messages:[user] }), 200,\n   161\t        'first request')\n   162\t    const assistant = {\n   163\t        role:'assistant',\n   164\t        content:[\n   165\t            { signature:'sig-1', thinking:'', type:'thinking' },\n   166\t            { type:'tool_use', id:'toolu-1', name:'read', input:{} },\n   167\t        ],\n   168\t    }\n   169\t    const result = {\n   170\t        role:'user',\n   171\t        content:[{\n   172\t            type:'tool_result',\n   173\t            tool_use_id:'toolu-1',\n   174\t            content:'x'\n   175\t        }],\n   176\t    }\n   177\t    t.equal(await post({\n   178\t        system:[],\n   179\t        tools:[],\n   180\t        messages:[user, assistant, result]\n   181\t    }), 200, 'unchanged replay')\n   182\t    const dropped = { role:'user', content:[{ type:'text', text:'a' }] }\n   183\t    t.equal(await post({\n   184\t        system:[],\n   185\t        tools:[],\n   186\t        messages:[dropped, assistant, result]\n   187\t    }), 400, 'changed prefix')\n   188\t})\n   189\t\n   190\tfunction bindingClient (url:string) {\n   191\t    return createClient(createModelClient(cfg(url)), {\n   192\t        sleep:async () => {},\n   193\t    })\n   194\t}\n   195\t\n   196\tconst signal = () => new AbortController().signal\n   197\t\n   198\ttest('signed thinking replays unchanged to a binding fake', async t => {\n   199\t    type Case = {\n   200\t        name:string,\n   201\t        respond:(n:number) => Record<string, unknown>[],\n   202\t        tools:() => Tool[],\n   203\t        maxTurns:number,\n   204\t        inputByteCeiling?:number,\n   205\t    }\n   206\t    const cases:Case[] = [\n   207\t        {\n   208\t            name:'wrap-up turn',\n   209\t            respond:n => n === 1 ?\n   210\t                [thinkingBlock('look first'),\n   211\t                    toolUseBlock('toolu-1', 'read', { path:'a' })] :\n   212\t                [thinkingBlock(''),\n   213\t                    toolUseBlock('toolu-2', 'submit', submitArgs('done'))],\n   214\t            tools:() => [readTool(), finalTool()],\n   215\t            maxTurns:2,\n   216\t        },\n   217\t        {\n   218\t            name:'interleaved thinking',\n   219\t            respond:n => n === 1 ?\n   220\t                [thinkingBlock('first'),\n   221\t                    toolUseBlock('toolu-a', 'read', { path:'a' }),\n   222\t                    thinkingBlock('between tools'),\n   223\t                    toolUseBlock('toolu-b', 'read', { path:'b' })] :\n   224\t                [toolUseBlock('toolu-c', 'submit', submitArgs('done'))],\n   225\t            tools:() => [readTool(), finalTool()],\n   226\t            maxTurns:4,\n   227\t        },\n   228\t        {\n   229\t            name:'thinking after the call on the final turn',\n   230\t            respond:n => n === 1 ?\n   231\t                [thinkingBlock(''),\n   232\t                    toolUseBlock('toolu-1', 'read', { path:'a' }),\n   233\t                    thinkingBlock('after the call')] :\n   234\t                [toolUseBlock('toolu-2', 'submit', submitArgs('done'))],\n   235\t            tools:() => [readTool(), finalTool()],\n   236\t            maxTurns:1,\n   237\t        },\n   238\t        {\n   239\t            name:'input budget warning',\n   240\t            respond:n => n < 3 ?\n   241\t                [thinkingBlock(''),\n   242\t                    toolUseBlock(`toolu-${n}`, 'read', { path:'a' })] :\n   243\t                [toolUseBlock('toolu-3', 'submit', submitArgs('done'))],\n   244\t            tools:() => [readTool(), finalTool()],\n   245\t            maxTurns:6,\n   246\t            inputByteCeiling:1,\n   247\t        },\n   248\t        {\n   249\t            name:'wrap-up records a result',\n   250\t            respond:n => n === 1 ?\n   251\t                [thinkingBlock('save it first'),\n   252\t                    toolUseBlock('toolu-1', 'report', { title:'a' })] :\n   253\t                [thinkingBlock(''),\n   254\t                    toolUseBlock('toolu-2', 'submit', submitArgs('done'))],\n   255\t            tools:() => [readTool(), recordTool(), finalTool()],\n   256\t            maxTurns:1,\n   257\t        },\n   258\t    ]\n   259\t    for (const c of cases) {\n   260\t        const s = await startBindingServer(c.respond)\n   261\t        t.cleanup(() => s.close())\n   262\t        const out = await bindingClient(s.url).converse('system', 'user',\n   263\t            options(c.tools(), {\n   264\t                maxTurns:c.maxTurns,\n   265\t                inputByteCeiling:c.inputByteCeiling,\n   266\t            }), signal())\n   267\t        t.equal(out.summary, 'done', `${c.name}: answer`)\n   268\t        t.equal(s.rejected, 0, `${c.name}: no rejected replay`)\n   269\t        t.ok(s.requests.length >= 2, `${c.name}: follow-up sent`)\n   270\t    }\n   271\t    const s = await startBindingServer(n => [\n   272\t        thinkingBlock(''),\n   273\t        toolUseBlock(`toolu-${n}`, 'submit', n === 1 ?\n   274\t            { summary:42 } :\n   275\t            submitArgs('done')),\n   276\t    ])\n   277\t    t.cleanup(() => s.close())\n   278\t    const out = await bindingClient(s.url).completeStructured('system',\n   279\t        'user', 'submit', {\n   280\t            schema:finalTool().schema,\n   281\t            decode:options([]).final.decode,\n   282\t        }, signal())\n   283\t    t.equal(out.summary, 'done', 'structured retry: answer')\n   284\t    t.equal(s.rejected, 0, 'structured retry: no rejected replay')\n   285\t})\n   286\t\n   287\ttest('DeepSeek thinking mode: never a forced choice, replay kept',\n   288\t    async t => {\n   289\t        const explore = (_r:unknown, n:number):DeepSeekAnswer => n === 1 ?\n   290\t            { tool:'read', args:{ path:'a.go' } } :\n   291\t            { tool:'submit', args:submitArgs('done') }\n   292\t        const submit = ():DeepSeekAnswer =>\n   293\t            ({ tool:'submit', args:submitArgs('done') })\n   294\t        const proseFirst = (_r:unknown, n:number):DeepSeekAnswer =>\n   295\t            n === 1 ? { tool:'' } : submit()\n   296\t        type Mode = {\n   297\t            name:string,\n   298\t            respond:(r:unknown, n:number) => DeepSeekAnswer,\n   299\t            structured?:boolean,\n   300\t            maxTurns?:number,\n   301\t            deadline?:boolean,\n   302\t            ledger?:boolean,\n   303\t        }\n   304\t        const modes:Mode[] = [\n   305\t            { name:'two-turn', respond:explore, maxTurns:4 },\n   306\t            { name:'wrap-up', respond:explore, maxTurns:2 },\n   307\t            { name:'structured', respond:submit, structured:true },\n   308\t            { name:'structured-retry', respond:proseFirst, structured:true },\n   309\t            { name:'deadline', respond:submit, deadline:true },\n   310\t            { name:'budget', respond:submit, ledger:true },\n   311\t        ]\n   312\t        for (const protocol of ['chat', 'anthropic'] as const) {\n   313\t            for (const m of modes) {\n   314\t                const s = await startDeepSeekServer(protocol, m.respond)\n   315\t                t.cleanup(() => s.close())\n   316\t                const client = createClient(createModelClient(cfg(s.url, {\n   317\t                    protocol,\n   318\t                    model:'deepseek-test',\n   319\t                })), {\n   320\t                    sleep:async () => {},\n   321\t                    ledger:m.ledger ? newLedger(4000) : null,\n   322\t                })\n   323\t                const name = `${protocol}/${m.name}`\n   324\t                const out = m.structured ?\n   325\t                    await client.completeStructured('system', 'user',\n   326\t                        'submit', {\n   327\t                            schema:finalTool().schema,\n   328\t                            decode:options([]).final.decode,\n   329\t                        }, signal()) :\n   330\t                    await client.converse('system', 'user', options(\n   331\t                        [readTool(), finalTool()], {\n   332\t                            maxTurns:m.maxTurns ?? 4,\n   333\t                            workDeadline:m.deadline ?\n   334\t                                Date.now() - 1000 :\n   335\t                                undefined,\n   336\t                        }), signal())\n   337\t                t.equal(out.summary, 'done', `${name}: answer`)\n   338\t                t.equal(s.rejected.length, 0, `${name}: nothing rejected`)\n   339\t            }\n   340\t        }\n   341\t    })","is_error":false}]},"parent_tool_use_id":"toolu_01T6H39Mzrb9HTVEpUPxaMw9","agent_id":"a2d564e3db2c159ee","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"0141d5e1-7ed7-4e19-9571-05fafbd8b2a0","timestamp":"2026-11-24T04:04:59.950Z","tool_result_meta":[{"id":"toolu_011GLozFY8AKDiTYMRGdAPiN","permission_de