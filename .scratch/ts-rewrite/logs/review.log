\t                { type:'text', text:'notice' },\n   181\t            ],\n   182\t        },\n   183\t        {\n   184\t            role:'assistant',\n   185\t            content:[\n   186\t                { type:'text', text:'next' },\n   187\t                { type:'text', text:'more' },\n   188\t            ],\n   189\t        },\n   190\t        { role:'user', content:[{ type:'text', text:'last' }] },\n   191\t    ], 'thinking-only assistant message dropped')\n   192\t})\n   193\t\n   194\ttype Obj = Record<string, unknown>\n   195\t\n   196\tasync function * events (...objs:Obj[]):AsyncGenerator<SseEvent> {\n   197\t    for (const o of objs) {\n   198\t        yield { event:String(o.type), data:JSON.stringify(o) }\n   199\t    }\n   200\t}\n   201\t\n   202\tconst start = (usage:object = { input_tokens:10, output_tokens:0 }) => ({\n   203\t    type:'message_start',\n   204\t    message:{ id:'m', type:'message', role:'assistant', content:[], usage },\n   205\t})\n   206\tconst blockStart = (index:number, block:object) =>\n   207\t    ({ type:'content_block_start', index, content_block:block })\n   208\tconst delta = (index:number, d:object) =>\n   209\t    ({ type:'content_block_delta', index, delta:d })\n   210\tconst blockStop = (index:number) => ({ type:'content_block_stop', index })\n   211\tconst messageDelta = (stop:string|null, usage:object = {}) =>\n   212\t    ({ type:'message_delta', delta:{ stop_reason:stop }, usage })\n   213\tconst stop = { type:'message_stop' }\n   214\t\n   215\tasync function failure (p:Promise<unknown>):Promise<unknown> {\n   216\t    try {\n   217\t        await p\n   218\t    } catch (err) {\n   219\t        return err\n   220\t    }\n   221\t    return undefined\n   222\t}\n   223\t\n   224\ttest('anthropic decodes blocks by index in close order', async t => {\n   225\t    const turn = await decodeAnthropic(events(\n   226\t        start({\n   227\t            input_tokens:10,\n   228\t            cache_read_input_tokens:3,