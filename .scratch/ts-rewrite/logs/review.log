{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FBVeCfWrsu9mUWkaTSBn91","type":"tool_result","content":"     1\t// The `anthropic` protocol (native Messages API; DeepSeek's\n     2\t// Anthropic-compatible endpoint): a pure request encoder and stream\n     3\t// decoder (spec 06, 2.6.3 and 2.8.3).\n     4\t\n     5\timport { trimSlashes, type EncodeConfig, type EncodeRequest } from './chat.js'\n     6\timport {\n     7\t    IncompleteStreamError,\n     8\t    ProviderError,\n     9\t    streamError,\n    10\t} from './errors.js'\n    11\timport { wellFormed } from './json.js'\n    12\timport { anthropicDefaultThinking } from './models.js'\n    13\timport type { SseEvent } from './sse.js'\n    14\timport type {\n    15\t    AssistantPart,\n    16\t    ConversationItem,\n    17\t    FinishReason,\n    18\t    ModelTurn,\n    19\t    ToolDefinition,\n    20\t} from './types.js'\n    21\timport { anthropicUsage, normalizeUsage } from './usage.js'\n    22\t\n    23\ttype Json = Record<string, unknown>\n    24\t\n    25\t// `<base'>/v1/messages`, where base' drops trailing slashes and then one\n    26\t// trailing `/v1`.\n    27\texport function anthropicUrl (baseUrl:string):string {\n    28\t    let base = trimSlashes(baseUrl)\n    29\t    if (base.endsWith('/v1')) base = base.slice(0, -3)\n    30\t    return `${base}/v1/messages`\n    31\t}\n    32\t\n    33\tfunction toolInput (raw:string):Json {\n    34\t    try {\n    35\t        const v:unknown = JSON.parse(raw)\n    36\t        if (v !== null && typeof v === 'object' && !Array.isArray(v)) {\n    37\t            return v as Json\n    38\t        }\n    39\t    } catch {\n    40\t        // Blank or invalid input still pairs with its tool_result.\n    41\t    }\n    42\t    return {}\n    43\t}\n    44\t\n    45\tfunction assistantBlock (p:AssistantPart):Json|null {\n    46\t    if (p.type === 'text') return { type:'text', text:p.text }\n    47\t    if (p.type === 'tool-call') {\n    48\t        return {\n    49\t            type:'tool_use',\n    50\t            id:p.id,\n    51\t            name:p.name,\n    52\t            input:toolInput(p.input)\n    53\t        }\n    54\t    }\n    55\t    if (p.signature) {\n    56\t        return { type:'thinking', thinking:p.text, signature:p.signature }\n    57\t    }\n    58\t    if (p.redactedData) return { type:'redacted_thinking', data:p.redactedData }\n    59\t    return null\n    60\t}\n    61\t\n    62\tfunction userBlocks (item:ConversationItem):Json[] {\n    63\t    if (item.role === 'user') return [{ type:'text', text:item.text }]\n    64\t    if (item.role !== 'tool') return []\n    65\t    return item.results.map(r => {\n    66\t        const block:Json = {\n    67\t            type:'tool_result',\n    68\t            tool_use_id:r.callId,\n    69\t            content:[{ type:'text', text:r.output }],\n    70\t        }\n    71\t        if (r.isError) block.is_error = true\n    72\t        return block\n    73\t    })\n    74\t}\n    75\t\n    76\t// Alternating role blocks: consecutive user texts and tool results merge\n    77\t// into one user message; consecutive assistant turns into one assistant\n    78\t// message, blocks in arrival order. A thinking-only assistant message is\n    79\t// dropped.\n    80\tfunction messages (items:readonly ConversationItem[]):Json[] {\n    81\t    const out:{ role:'user'|'assistant', content:Json[] }[] = []\n    82\t    for (const item of items) {\n    83\t        const role = item.role === 'assistant' ? 'assistant' : 'user'\n    84\t        let last = out[out.length - 1]\n    85\t        if (!last || last.role !== role) {\n    86\t            last = { role, content:[] }\n    87\t            out.push(last)\n    88\t        }\n    89\t        if (item.role === 'assistant') {\n    90\t            for (const p of item.parts) {\n    91\t                const block = assistantBlock(p)\n    92\t                if (block) last.content.push(block)\n    93\t            }\n    94\t        } else {\n    95\t            last.content.push(...userBlocks(item))\n    96\t        }\n    97\t    }\n    98\t    return out.filter(m => m.role === 'user' || m.content.some(b =>\n    99\t        b.type === 'text' || b.type === 'tool_use'))\n   100\t}\n   101\t\n   102\tfunction inputSchema (tool:ToolDefinition):Json {\n   103\t    const schema = structuredClone(tool.schema) as Json\n   104\t    schema.type = 'object'\n   105\t    if (!Array.isArray(schema.required)) schema.required = []\n   106\t    return schema\n   107\t}\n   108\t\n   109\t// The request body. Tool choice is always automatic.\n   110\texport function encodeAnthropic (\n   111\t    config:EncodeConfig,\n   112\t    req:EncodeRequest\n   113\t):Json {\n   114\t    const body:Json = {\n   115\t        model:config.model,\n   116\t        max_tokens:config.maxOutputTokens,\n   117\t        system:[{ type:'text', text:req.system }],\n   118\t        messages:messages(req.items),\n   119\t        stream:true,\n   120\t    }\n   121\t    if (anthropicDefaultThinking(config.model)) {\n   122\t        body.thinking = { type:'adaptive', display:'summarized' }\n   123\t    }\n   124\t    if (req.tools.length > 0) {\n   125\t        body.tools = req.tools.map(tool => ({\n   126\t            name:tool.name,\n   127\t            description:tool.description ?? '',\n   128\t            input_schema:inputSchema(tool),\n   129\t        }))\n   130\t        body.tool_choice = { type:'auto', disable_parallel_tool_use:false }\n   131\t    }\n   132\t    return body\n   133\t}\n   134\t\n   135\tfunction obj (v:unknown):Json {\n   136\t    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n   137\t        v as Json :\n   138\t        {}\n   139\t}\n   140\t\n   141\tfunction str (v:unknown):string {\n   142\t    return typeof v === 'string' ? wellFormed(v) : ''\n   143\t}\n   144\t\n   145\tconst FINISH:Record<string, FinishReason> = {\n   146\t    end_turn:'stop',\n   147\t    pause_turn:'stop',\n   148\t    stop_sequence:'stop',\n   149\t    max_tokens:'length',\n   150\t    model_context_window_exceeded:'length',\n   151\t    tool_use:'tool-calls',\n   152\t    refusal:'content-filter',\n   153\t    content_filtered:'content-filter',\n   154\t    guardrail_intervened:'content-filter',\n   155\t}\n   156\t\n   157\tconst RAW_EXPOSED = new Set<FinishReason>([\n   158\t    'length',\n   159\t    'content-filter',\n   160\t    'unknown',\n   161\t])\n   162\t\n   163\tconst USAGE_FIELDS = [\n   164\t    'input_tokens',\n   165\t    'cache_creation_input_tokens',\n   166\t    'cache_read_input_tokens',\n   167\t] as const\n   168\t\n   169\tinterface OpenBlock {\n   170\t    type:string;\n   171\t    text:string;\n   172\t    signature:string;\n   173\t    data:string;\n   174\t    id:string;\n   175\t    name:string;\n   176\t    input:string;\n   177\t    startInput:unknown;\n   178\t}\n   179\t\n   180\tfunction closeBlock (b:OpenBlock):AssistantPart|null {\n   181\t    switch (b.type) {\n   182\t        case 'text':\n   183\t            return { type:'text', text:b.text }\n   184\t        case 'thinking':\n   185\t            return { type:'reasoning', text:b.text, signature:b.signature }\n   186\t        case 'redacted_thinking':\n   187\t            return { type:'reasoning', text:'', redactedData:b.data }\n   188\t        case 'tool_use': {\n   189\t            let input = b.input\n   190\t            if (input === '') {\n   191\t                const start = obj(b.startInput)\n   192\t                input = Object.keys(start).length > 0 ?\n   193\t                    JSON.stringify(start) :\n   194\t                    '{}'\n   195\t            }\n   196\t            return { type:'tool-call', id:b.id, name:b.name, input }\n   197\t        }\n   198\t        default:\n   199\t            return null\n   200\t    }\n   201\t}\n   202\t\n   203\t// Assembles one turn from Messages stream events (spec 06, 2.8.3).\n   204\t// Throws th