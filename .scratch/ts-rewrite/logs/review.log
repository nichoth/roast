{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fkz5CVrXUyhWzZeGQrZnEU","type":"tool_result","content":"1\t// `roast review`, also the default command: the review orchestration of\n2\t// spec 01, 2.8. Snapshot capture is injectable (see snapshot-meta.ts).\n3\timport type { Writable } from 'node:stream'\n4\timport { buildInfo } from '../buildinfo.js'\n5\timport {\n6\t    type ProjectConfig,\n7\t    credentialEnvNames,\n8\t    promptPath,\n9\t    snapshotEnabled,\n10\t} from '../config/load.js'\n11\timport { DEFAULT_LIMITS } from '../config/defaults.js'\n12\timport { resolveFinderFlip, resolveRole, validateRole }\n13\t    from '../config/role.js'\n14\timport type { ResolvedRole } from '../config/resolved-role.js'\n15\timport { buildFileContext, numberedSnippet } from '../context/snippet.js'\n16\timport { newQuoteGrounder } from '../context/grounding.js'\n17\timport { explorationTools } from '../context/tools.js'\n18\timport {\n19\t    LIVE_TREE,\n20\t    pinIndexTree,\n21\t    pinnedWorktree,\n22\t    type Tree,\n23\t} from '../context/tree.js'\n24\timport { gitRoot } from '../git/git.js'\n25\timport {\n26\t    type GoDuration,\n27\t    formatGoDuration,\n28\t    parseGoDuration,\n29\t    toMillis,\n30\t} from '../gocompat/duration.js'\n31\timport { createClient, createModelClient } from '../llm/client.js'\n32\timport { type Ledger, committed, newLedger } from '../llm/ledger.js'\n33\timport type {\n34\t    Client, ClientConfig, Protocol, RawResponse, RecordUsage, Tool,\n35\t} from '../llm/types.js'\n36\timport { finderSystem, verifierSystem } from '../prompts/index.js'\n37\timport { renderFinderUser, renderVerifierUser } from '../prompts/render.js'\n38\timport { recordDir } from '../record/dir.js'\n39\timport { openFindingSpill } from '../record/findings.js'\n40\timport { appendRunLine, seenBefore } from '../record/index-file.js'\n41\timport {\n42\t    type Meta,\n43\t    type RoleMeta,\n44\t    captureEnv,\n45\t    digest,\n46\t    removeRun,\n47\t    reportPath,\n48\t    resolveRunDir,\n49\t    writeArtifact,\n50\t    writeMeta,\n51\t    writeReport as writeRunReport,\n52\t} from '../record/meta.js'\n53\timport { rfc3339NanoUTC } from '../record/json.js'\n54\timport { ResponseRecorder } from '../record/responses.js'\n55\timport { newRunId } from '../record/run-id.js'\n56\timport { toJSON, toMarkdown, type Report } from '../render/render.js'\n57\timport { writeReport } from '../render/write.js'\n58\timport { classifyMode } from '../review/classify.js'\n59\timport { find } from '../review/find.js'\n60\timport {\n61\t    type Finding, type Result, type WireFinding, maxSeverity,\n62\t} from '../review/types.js'\n63\timport { type VerifiedResult, verify } from '../verify/verify.js'\n64\timport { buildBundle } from '../runbundle/bundle.js'\n65\timport { build, fit, isEmpty, type BuildOpts } from '../scope/index.js'\n66\timport { ExitSignal, UsageError } from './errors.js'\n67\timport type { CommandArgs, CommandDef, RunContext } from './command.js'\n68\timport { loadProjectConfig } from './config.js'\n69\timport { maybeBootstrapGate } from './gate-offer.js'\n70\timport { logf } from './log.js'\n71\timport {\n72\t    DEFAULT_MAX_TURNS,\n73\t    SURVEY_MAX_TURNS,\n74\t    type ReviewFlags,\n75\t    parseReviewFlags,\n76\t    reviewBuilder,\n77\t    validateReviewFlags,\n78\t} from './review-flags.js'\n79\timport {\n80\t    applyRoleFlags,\n81\t    configInt,\n82\t    flagOrConfig,\n83\t    resolveLangs,\n84\t} from './resolve.js'\n85\timport {\n86\t    type SnapshotDeps,\n87\t    type WorktreePin,\n88\t    captureSnapshot,\n89\t    defaultSnapshotDeps,\n90\t} from './snapshot-meta.js'\n91\timport { deleteSnapshot, pinWorktree } from '../snapshot/snapshot.js'\n92\timport { requireTrust } from './trust.js'\n93\t\n94\tconst QUICK_DIFF_BYTES = 200_000\n95\tconst QUICK_FILE_CTX_BYTES = 100_000\n96\tconst SURVEY_DEADLINE = '25m'\n97\tconst INTERACTIVE_MIN_DIFF_LINES = 80\n98\tconst INTERACTIVE_MIN_FILES = 4\n99\tconst VERIFIER_MAX_TURNS = 8\n100\tconst VERIFIER_SNIPPET_BYTES = 60_000\n101\t\n102\t// Swappable for tests: the snapshot area's functions.\n103\texport const reviewHooks:{\n104\t    snapshot:((ctx:RunContext) => SnapshotDeps)|null;\n105\t} = { snapshot:null }\n106\t\n107\t// Exit selection after a completed run (spec 01, 2.2): a finalize\n108\t// failure wins over the severity gate.\n109\texport function reviewExitError (\n110\t    finalErr:Error|null,\n111\t    gateRank:number,\n112\t    maxSev:number,\n113\t    partial:boolean\n114\t):Error|null {\n115\t    if (finalErr) return finalErr\n116\t    if (gateRank >= 0 && maxSev >= gateRank) return new ExitSignal(1)\n117\t    if (partial) return new ExitSignal(4)\n118\t    return null\n119\t}\n120\t\n121\tfunction message (err:unknown):string {\n122\t    return err instanceof Error ? err.message : String(err)\n123\t}\n124\t\n125\t// Config and role failures are usage errors carrying the config area's\n126\t// message.\n127\tfunction asUsage<T> (fn:() => T):T {\n128\t    try {\n129\t        return fn()\n130\t    } catch (err) {\n131\t        if (err instanceof UsageError) throw err\n132\t        throw new UsageError(message(err), { cause:err })\n133\t    }\n134\t}\n135\t\n136\tfunction wrap (prefix:string, err:unknown):Error {\n137\t    return new Error(`${prefix}: ${message(err)}`, { cause:err })\n138\t}\n139\t\n140\tfunction roleMeta (role:ResolvedRole, system:string):RoleMeta {\n141\t    return {\n142\t        profile:role.profile,\n143\t        base_url:role.baseURL,\n144\t        model:role.model,\n145\t        protocol:role.protocol,\n146\t        max_output_tokens:role.maxOutputTokens,\n147\t        session_header:role.sessionHeader,\n148\t        prompt_digest:digest(system),\n149\t    }\n150\t}\n151\t\n152\tfunction clientConfig (\n153\t    name:string,\n154\t    role:ResolvedRole,\n155\t    capture:(raw:RawResponse) => Promise<void>,\n156\t    maxAttempts:number,\n157\t    requestTimeout:GoDuration,\n158\t    fetch:typeof globalThis.fetch\n159\t):ClientConfig {\n160\t    return {\n161\t        role:name,\n162\t        baseUrl:role.baseURL.replace(/\\/+$/, ''),\n163\t        apiKey:role.apiKey,\n164\t        model:role.model,\n165\t        protocol:role.protocol as ''|Protocol,\n166\t        maxOutputTokens:role.maxOutputTokens,\n167\t        sessionHeader:role.sessionHeader,\n168\t        maxAttempts,\n169\t        requestTimeoutMs:toMillis(requestTimeout),\n170\t        captureResponse:capture,\n171\t        fetch,\n172\t    }\n173\t}\n174\t\n175\tfunction newClient (\n176\t    config:ClientConfig,\n177\t    ledger:Ledger|null\n178\t):Client {\n179\t    return createClient(createModelClient(config), { ledger })\n180\t}\n181\t\n182\ttype Format = 'json'|'markdown'|'both'\n183\t\n184\tfunction streams (ctx:RunContext):{ stdout:Writable, stderr:Writable } {\n185\t    return {\n186\t        stdout:ctx.stdout as Writable,\n187\t        stderr:ctx.stderr as Writable,\n188\t    }\n189\t}\n190\t\n191\tfunction countNewlines (s:string):number {\n192\t    let n = 0\n193\t    for (let i = s.indexOf('\\n'); i >= 0; i = s.indexOf('\\n', i + 1)) n++\n194\t    return n\n195\t}\n196\t\n197\tfunction utf8Bytes (s:string):number {\n198\t    return Buffer.byteLength(s, 'utf8')\n199\t}\n200\t\n201\tinterface Roles {\n202\t    finder:ResolvedRole;\n203\t    verifier:ResolvedRole;\n204\t    doVerify:boolean;\n205\t}\n206\t\n207\tfunction resolveRoles (\n208\t    cfg:ProjectConfig,\n209\t    f:ReviewFlags,\n210\t    ctx:RunContext\n211\t):Roles {\n212\t    return asUsage(() => {\n213\t        let finder = resolveRole(cfg, 'finder', ctx.env)\n214\t        let verifier = resolveRole(cfg, 'verifier', ctx.env)\n215\t        finder = applyRoleFlags('finder', finder, f.finder, ctx.env)\n216\t        verifier = applyRoleFlags('verifier', verifier, f.verifier, ctx.env)\n217\t        const flip = resolveFinderFlip(cfg, finder, f.authorModel, ctx.env)\n218\t        if (flip.note) logf(ctx.stderr, flip.note)\n219\t        if (flip.warn) logf(ctx.stderr, flip.warn)\n220\t        finder = flip.role\n221\t        validateRole('finder', finder)\n222\t        const doVerify = !f.quick && !f.noVerify\n223\t        if (doVerify) validateRole('verifier', verifier)\n224\t        return { finder, verifier, doVerify }\n225\t    })\n226\t}\n227\t\n228\texport async function runReview (\n229\t    f:ReviewFlags,\n230\t    ctx:RunContext\n231\t):Promise<void> {\n232\t    const gateRank = validateReviewFlags(f)\n233\t    const gitOpts = { env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal }\n234\t    const cfg = await loadProjectConfig(f.config, ctx)\n235\t    const roles = resolveRoles(cfg, f, ctx)\n236\t    const { doVerify } = roles\n237\t\n238\t    let repo:string\n239\t    try {\n240\t        repo = await gitRoot(ctx.cwd, gitOpts)\n241\t    } catch (err) {\n242\t        if (ctx.signal.aborted) throw err\n243\t        throw new UsageError(message(err), { cause:err })\n244\t    }\n245\t    await requireTrust(repo, cfg, ctx)\n246\t\n247\t    const survey = f.scope === 'repo'\n248\t    const limits = cfg.limits ?? {}\n249\t    const excludes = [...(cfg.review.excludes ?? []), ...f.exclude]\n250\t    const maxDiff = configInt(limits.max_diff_bytes, f.quick ?\n251\t        QUICK_DIFF_BYTES : DEFAULT_LIMITS.max_diff_bytes)\n252\t    const buildOpts:BuildOpts = {\n253\t        base:f.base,\n254\t        uncommittedOnly:f.uncommittedOnly,\n255\t        stagedOnly:f.staged,\n256\t        paths:f.paths,\n257\t        excludes,\n258\t        includeVendored:f.includeVendored,\n259\t        scope:f.scope,\n260\t        maxFileDiffBytes:maxDiff,\n261\t        env:gitOpts.env,\n262\t    }\n263\t    let tree:Tree = LIVE_TREE\n264\t    if (f.staged) {\n265\t        try {\n266\t            tree = await pinIndexTree(repo, ctx.signal, { env:gitOpts.env })\n267\t        } catch (err) {\n268\t            if (ctx.signal.aborted) throw err\n269\t            throw wrap('pin staged tree', err)\n270\t        }\n271\t        buildOpts.stagedTreeOID = tree.oid\n272\t    }\n273\t    let sc = await build(repo, buildOpts, ctx.signal)\n274\t    for (const note of sc.notes) logf(ctx.stderr, note)\n275\t\n276\t    if (isEmpty(sc)) {\n277\t        writeReport(streams(ctx), f.format as Format, f.showDropped, {\n278\t            result:{\n279\t                assessment:'NO_DIFF', findings:[], dropped:[], notes:[],\n280\t            },\n281\t            mode:'code',\n282\t            filesReviewed:[],\n283\t            task:f.task,\n284\t        })\n285\t        return\n286\t    }\n287\t\n288\t    const inputKind = survey ? 'manifest' : 'diff'\n289\t    const reviewedInput = survey ?\n290\t        Buffer.from(sc.manifest, 'utf8') :\n291\t        sc.diffBytes\n292\t    const runId = newRunId()\n293\t    const indexTree = tree.oid\n294\t    let pin:WorktreePin = null\n295\t    if (!sc.staged) {\n296\t        pin = await pinOrLive(repo, ctx)\n297\t        if (pin) tree = pinnedWorktree(pin.tree)\n298\t    }\n299\t    const snapDeps = reviewHooks.snapshot?.(ctx) ??\n300\t        defaultSnapshotDeps(gitOpts)\n301\t    const snap = await captureSnapshot(snapshotEnabled(cfg), repo, runId,\n302\t        sc, indexTree, pin, snapDeps)\n303\t    // Until the run record exists, any exit drops the captured ref so\n304\t    // no orphan is left; after that the snapshot is durable.\n305\t    let durable = false\n306\t    try {\n307\t        const ground = newQuoteGrounder(repo, tree, sc.diffBytes, gitOpts)\n308\t        const originalDiffBytes = sc.diffBytes.length\n309\t        const maxFileContext = configInt(limits.max_file_ctx_bytes, f.quick ?\n310\t            QUICK_FILE_CTX_BYTES : DEFAULT_LIMITS.max_file_ctx_bytes)\n311\t        const fitted = fit(sc, maxDiff)\n312\t        sc = fitted.scope\n313\t        const breakdown = fitted.breakdown ?? []\n314\t\n315\t        let mode = f.mode\n316\t        if (mode === 'auto') mode = classifyMode([...sc.files])\n317\t        if (!['code', 'prose', 'mixed'].includes(mode)) {\n318\t            throw new UsageError(`invalid --mode ${JSON.stringify(f.mode)}`)\n319\t        }\n320\t        const langs = resolveLangs(f.lang, [...sc.files], mode)\n321\t        const overrides = cfg.prompts ?? {}\n322\t        const finderPrompt = (mode === 'prose' ?\n323\t            overrides.finder_prose :\n324\t            overrides.finder_code) ?? ''\n325\t        const system = await finderSystem(mode, f.scope, f.quick, langs,\n326\t            promptPath(cfg, finderPrompt))\n327\t        const verifierPrompt = await verifierSystem(\n328\t            promptPath(cfg, overrides.verifier ?? ''))\n329\t        const user = survey ?\n330\t            renderFinderUser({\n331\t                task:f.task,\n332\t                survey:true,\n333\t                manifest:sc.manifest,\n334\t                diff:'',\n335\t                fileContext:'',\n336\t            }) :\n337\t            renderFinderUser({\n338\t                task:f.task,\n339\t                survey:false,\n340\t                diff:sc.diff,\n341\t                fileContext:await buildFileContext(repo, sc.files,\n342\t                    maxFileContext, tree, gitOpts),\n343\t                manifest:'',\n344\t            })\n345\t\n346\t        const maxTokensTotal = flagOrConfig(f.maxTokensTotal,\n347\t            limits.max_total_tokens, DEFAULT_LIMITS.max_total_tokens)\n348\t        const maxVerified = flagOrConfig(f.maxVerified, limits.max_verified,\n349\t            DEFAULT_LIMITS.max_verified)\n350\t        const requestTimeout = flagOrConfig(f.requestTimeout,\n351\t            limits.request_timeout,\n352\t            parseGoDuration(DEFAULT_LIMITS.request_timeout))\n353\t        const maxAttempts = flagOrConfig(f.maxAttempts, limits.max_attempts,\n354\t            DEFAULT_LIMITS.max_attempts)\n355\t        const ledger = newLedger(maxTokensTotal)\n356\t        let interactive = f.interactive && !f.quick\n357\t        let maxTurns = f.maxTurns ?? DEFAULT_MAX_TURNS\n358\t        if (survey) {\n359\t            interactive = true\n360\t            if (f.maxTurns === undefined) maxTurns = SURVEY_MAX_TURNS\n361\t        }\n362\t        if (interactive && !survey) {\n363\t            const minLines = configInt(cfg.interactive?.min_diff_lines,\n364\t                INTERACTIVE_MIN_DIFF_LINES)\n365\t            const minFiles = configInt(cfg.interactive?.min_files,\n366\t                INTERACTIVE_MIN_FILES)\n367\t            if (countNewlines(sc.diff) < minLines &&\n368\t                sc.files.length < minFiles) {\n369\t                logf(ctx.stderr,\n370\t                    'diff is small; using a single structured finder call')\n371\t                interactive = false\n372\t            }\n373\t        }\n374\t        const deadlineDuration = flagOrConfig(f.deadline, limits.deadline,\n375\t            parseGoDuration(survey ? SURVEY_DEADLINE : DEFAULT_LIMITS.deadline))\n376\t        const deadline = deadlineDuration > 0n ?\n377\t            Date.now() + toMillis(deadlineDuration) :\n378\t            undefined\n379\t        const promptCeiling = configInt(limits.max_prompt_bytes,\n380\t            DEFAULT_LIMITS.max_prompt_bytes)\n381\t        const budgets:Record<string, unknown> = {\n382\t            deadline_duration:formatGoDuration(deadlineDuration),\n383\t            request_timeout:formatGoDuration(requestTimeout),\n384\t            max_total_tokens:maxTokensTotal,\n385\t            verifier_cap:maxVerified,\n386\t            max_turns:maxTurns,\n387\t            max_attempts:maxAttempts,\n388\t            max_prompt_bytes:promptCeiling,\n389\t        }\n390\t        const tools:readonly Tool[] = interactive ?\n391\t            explorationTools(repo, tree, { env:gitOpts.env }) :\n392\t            []\n393\t        const floor = f.quick ?\n394\t            cfg.review.quick_confidence_floor :\n395\t            cfg.review.confidence_floor\n396\t        const promptBytes = utf8Bytes(system) + utf8Bytes(user)\n397\t        if (promptBytes > promptCeiling) {\n398\t            throw new UsageError(`finder prompt is ${promptBytes} bytes, ` +\n399\t                `over the ${promptCeiling}-byte ceiling; narrow the review ` +\n400\t                'scope or adjust limits.max_diff_bytes, ' +\n401\t                'limits.max_file_ctx_bytes, or ' +\n402\t                'limits.max_prompt_bytes in the project config')\n403\t        }\n404\t\n405\t        const meta:Meta = {\n406\t            run_id:runId,\n407\t            ts:rfc3339NanoUTC(new Date()),\n408\t            repo,\n409\t            argv:[...ctx.argv],\n410\t            roast:{ version:buildInfo.version, commit:buildInfo.commit },\n411\t            scope:{\n412\t                kind:f.scope,\n413\t                base:sc.base,\n414\t                uncommitted_only:f.uncommittedOnly,\n415\t                staged_only:f.staged,\n416\t                include_vendored:f.includeVendored,\n417\t                paths:[...f.paths],\n418\t                excludes:[...excludes],\n419\t                base_oid:snap.meta.base ?? '',\n420\t                merge_base_oid:'',\n421\t                head_oid:sc.headOID || (snap.meta.head ?? ''),\n422\t                survey:sc.survey,\n423\t                staged:sc.staged,\n424\t                files:[...sc.files],\n425\t            },\n426\t            derived:{\n427\t                mode,\n428\t                langs:[...langs],\n429\t                quick:f.quick,\n430\t                interactive,\n431\t                max_turns:maxTurns,\n432\t                confidence_floor:floor,\n433\t                do_verify:doVerify,\n434\t                task:f.task,\n435\t                max_severity:f.maxSeverity,\n436\t                max_diff_bytes:maxDiff,\n437\t                max_file_ctx_bytes:maxFileContext,\n438\t            },\n439\t            roles:{\n440\t                finder:roleMeta(roles.finder, system),\n441\t                verifier:roleMeta(roles.verifier, verifierPrompt),\n442\t            },\n443\t            snapshot:snap.meta,\n444\t            digests:{\n445\t                input_kind:inputKind,\n446\t                input:digest(reviewedInput),\n447\t                input_bytes:reviewedInput.length,\n448\t                system_prompt:digest(system),\n449\t                user_prompt:digest(user),\n450\t            },\n451\t            budgets,\n452\t            env_names_only:captureEnv(ctx.env as NodeJS.ProcessEnv,\n453\t                credentialEnvNames(cfg)),\n454\t            caveats:snap.caveats,\n455\t        }\n456\t        const records = await recordDir(repo, gitOpts)\n457\t        await initializeRun(records, meta, {\n458\t            input:reviewedInput,\n459\t            finder_system:system,\n460\t            finder_user:user,\n461\t            verifier_system:verifierPrompt,\n462\t        })\n463\t        durable = true\n464\t\n465\t        const recorder = new ResponseRecorder(records, runId)\n466\t        const capture = (raw:RawResponse):Promise<void> => recorder.append(\n467\t            raw.role, raw.protocol, raw.model, raw.contentType, raw.body)\n468\t        const finder = newClient(clientConfig('finder', roles.finder, capture,\n469\t            maxAttempts, requestTimeout, ctx.fetch), ledger)\n470\t        logf(ctx.stderr, `finder=${roles.finder.model} ` +\n471\t            `profile=${roles.finder.profile} ` +\n472\t            `protocol=${roles.finder.protocol} ` +\n473\t            `endpoint=${roles.finder.baseURL}`)\n474\t        const spill = await openFindingSpill(records, runId)\n475\t        const spilled:Promise<void>[] = []\n476\t        let found:Result\n477\t        try {\n478\t            found = await find(finder, {\n479\t                system,\n480\t                user,\n481\t                quick:f.quick,\n482\t                confidenceFloor:floor,\n483\t                interactive,\n484\t                tools,\n485\t                maxTurns,\n486\t                ground,\n487\t                deadline,\n488\t                survey,\n489\t                capture:spill ?\n490\t                    (w:WireFinding) => { spilled.push(spill(w)) } :\n491\t                    undefined,\n492\t            }, ctx.signal)\n493\t        } finally {\n494\t            await Promise.all(spilled)\n495\t        }\n496\t\n497\t        const usage:Record<string, RecordUsage> = { finder:finder.usage() }\n498\t        let partial = found.incomplete === true\n499\t        let result:VerifiedResult = found\n500\t        if (doVerify && found.findings.length > 0) {\n501\t            const verifier = newClient(clientConfig('verifier',\n502\t                roles.verifier, capture, maxAttempts, requestTimeout,\n503\t                ctx.fetch), ledger)\n504\t            logf(ctx.stderr, `verifying ${found.findings.length} ` +\n505\t                `finding(s) with ${roles.verifier.model} ` +\n506\t                `(profile=${roles.verifier.profile} ` +\n507\t                `protocol=${roles.verifier.protocol})`)\n508\t            result = await verify(ctx.signal, verifier, found, {\n509\t                systemPrompt:verifierPrompt,\n510\t                userPrompt:finding => verifierUser(repo, tree, finding,\n511\t                    gitOpts),\n512\t                tools:explorationTools(repo, tree, { env:gitOpts.env }),\n513\t                maxTurns:VERIFIER_MAX_TURNS,\n514\t                maxVerified,\n515\t                ledger,\n516\t                log:line => { ctx.stderr.write(line + '\\n') },\n517\t            })\n518\t            usage.verifier = verifier.usage()\n519\t            if (result.findings.some(x => x.verdict?.undecided)) {\n520\t                partial = true\n521\t            }\n522\t        }\n523\t\n524\t        let reviewKind:''|'survey_triage' = ''\n525\t        let completion = ''\n526\t        let stopReason = ''\n527\t        if (survey) {\n528\t            reviewKind = 'survey_triage'\n529\t            const r = result.stopReason ?? ''\n530\t            if (result.incomplete || ['deadline', 'token_budget',\n531\t                'budget_exhausted'].includes(r)) {\n532\t                completion = 'partial'\n533\t                stopReason = r || 'incomplete_no_submission'\n534\t            } else {\n535\t                completion = 'complete'\n536\t                stopReason = 'converged'\n537\t                if (result.assessment === 'NO_FINDINGS') {\n538\t                    result.assessment = 'NO_FINDINGS_IN_SAMPLED_AREAS'\n539\t                }\n540\t            }\n541\t        }\n542\t        const { spent, limit } = committed(ledger)\n543\t        if (limit > 0) budgets.ledger_committed_tokens = spent\n544\t        const report:Report = {\n545\t            result,\n546\t            mode,\n547\t            filesReviewed:[...sc.files],\n548\t            task:f.task,\n549\t            runId,\n550\t            budgets,\n551\t            quick:f.quick,\n552\t            verified:doVerify,\n553\t            diffTruncated:breakdown.length > 0,\n554\t            originalDiffBytes,\n555\t            sizeBreakdown:breakdown.map(e => ({ path:e.path, bytes:e.bytes })),\n556\t            usage,\n557\t            promptPacks:langs,\n558\t            reviewKind,\n559\t            completion,\n560\t            manifestFileCount:sc.files.length,\n561\t            stopReason,\n562\t        }\n563\t        report.prior = await priorNotes(records, repo, result)\n564\t        writeReport(streams(ctx), f.format as Format, f.showDropped, report)\n565\t\n566\t        meta.usage = usageMeta(usage)\n567\t        meta.budgets = budgets\n568\t        let finalErr:Error|null = null\n569\t        try {\n570\t            await finalizeRun(records, meta, report, repo)\n571\t            const file = await reportPath(records, runId).catch(() => '')\n572\t            if (file) logf(ctx.stderr, `run ${runId} \\u00b7 report ${file}`)\n573\t        } catch (err) {\n574\t            if (ctx.signal.aborted) throw err\n575\t            finalErr = err as Error\n576\t        }\n577\t        const exit = reviewExitError(finalErr, gateRank, maxSeverity(result),\n578\t            partial)\n579\t        if (exit) throw exit\n580\t    } finally {\n581\t        if (snap.meta.captured && !durable) {\n582\t            await deleteSnapshot(repo, runId, { env:gitOpts.env })\n583\t                .catch(() => {})\n584\t        }\n585\t    }\n586\t}\n587\t\n588\t// The worktree pin every reader uses; null (read live, guarded by the\n589\t// context area) when it fails.\n590\tasync function pinOrLive (\n591\t    repo:string,\n592\t    ctx:RunContext\n593\t):Promise<WorktreePin> {\n594\t    try {\n595\t        return await pinWorktree(repo, {\n596\t            env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal,\n597\t        })\n598\t    } catch (err) {\n599\t        if (ctx.signal.aborted) throw err\n600\t        logf(ctx.stderr, `could not pin the working tree (${message(err)}); ` +\n601\t            'reading it live with .git, ignored, and denylisted paths ' +\n602\t            'blocked')\n603\t        return null\n604\t    }\n605\t}\n606\t\n607\tasync function initializeRun (\n608\t    records:string,\n609\t    meta:Meta,\n610\t    artifacts:Record<string, string|Uint8Array>\n611\t):Promise<void> {\n612\t    try {\n613\t        try {\n614\t            await writeMeta(records, meta)\n615\t        } catch (err) {\n616\t            throw wrap('initialize run record', err)\n617\t        }\n618\t        for (const [name, content] of Object.entries(artifacts)) {\n619\t            try {\n620\t                await writeArtifact(records, meta.run_id, name, content)\n621\t            } catch (err) {\n622\t                throw wrap(`initialize run artifact ${name}`, err)\n623\t            }\n624\t        }\n625\t    } catch (err) {\n626\t        if (records) await removeRun(records, meta.run_id).catch(() => {})\n627\t        throw err\n628\t    }\n629\t}\n630\t\n631\tasync function finalizeRun (\n632\t    records:string,\n633\t    meta:Meta,\n634\t    report:Report,\n635\t    repo:string\n636\t):Promise<void> {\n637\t    try {\n638\t        await writeArtifact(records, meta.run_id, 'result.json',\n639\t            toJSON(report))\n640\t    } catch (err) {\n641\t        throw wrap('finalize run result', err)\n642\t    }\n643\t    try {\n644\t        await writeRunReport(records, meta.run_id, toMarkdown(report, true))\n645\t    } catch (err) {\n646\t        throw wrap('finalize run report', err)\n647\t    }\n648\t    try {\n649\t        await writeMeta(records, meta)\n650\t    } catch (err) {\n651\t        throw wrap('finalize run metadata', err)\n652\t    }\n653\t    let runDir:string\n654\t    try {\n655\t        runDir = await resolveRunDir(records, meta.run_id)\n656\t    } catch (err) {\n657\t        throw wrap('resolve run bundle directory', err)\n658\t    }\n659\t    try {\n660\t        buildBundle(runDir)\n661\t    } catch (err) {\n662\t        throw wrap('build local run bundle', err)\n663\t    }\n664\t    await appendRunLine(records, report, repo, meta.argv ?? null)\n665\t        .catch(() => {})\n666\t}\n667\t\n668\tfunction usageMeta (\n669\t    usage:Record<string, RecordUsage>\n670\t):NonNullable<Meta['usage']> {\n671\t    const out:NonNullable<Meta['usage']> = {}\n672\t    for (const [role, u] of Object.entries(usage)) {\n673\t        out[role] = {\n674\t            uncached_input_tokens:u.uncached_input_tokens,\n675\t            cached_input_tokens:u.cached_input_tokens,\n676\t            cache_write_tokens:u.cache_write_tokens,\n677\t            output_tokens:u.output_tokens,\n678\t            calls:u.calls,\n679\t        }\n680\t    }\n681\t    return out\n682\t}\n683\t\n684\tfunction lineRange (lines:readonly number[]|null):string {\n685\t    if (!lines?.length) return '?'\n686\t    if (lines.length === 1) return String(lines[0])\n687\t    return `${lines[0]}-${lines[lines.length - 1]}`\n688\t}\n689\t\n690\t// The per-finding verifier message: the claim and the cited file, never\n691\t// the finder's reasoning.\n692\tasync function verifierUser (\n693\t    repo:string,\n694\t    tree:Tree,\n695\t    f:Finding,\n696\t    opts:{ env:NodeJS.ProcessEnv, signal:AbortSignal }\n697\t):Promise<string> {\n698\t    return renderVerifierUser({\n699\t        severity:f.severity,\n700\t        confidence:f.confidence,\n701\t        file:f.file,\n702\t        lines:lineRange(f.lines),\n703\t        description:f.description,\n704\t        codeQuote:f.code_quote,\n705\t        fixedCode:f.fixed_code,\n706\t        fileSnippet:await numberedSnippet(repo, f.file,\n707\t            VERIFIER_SNIPPET_BYTES, tree, opts),\n708\t    })\n709\t}\n710\t\n711\tasync function priorNotes (\n712\t    records:string,\n713\t    repo:string,\n714\t    result:Pick<Result, 'findings'>\n715\t):Promise<Map<string, string>|null> {\n716\t    const seen = await seenBefore(records, repo, result.findings, 3)\n717\t        .catch(() => new Map())\n718\t    if (seen.size === 0) return null\n719\t    const out = new Map<string, string>()\n720\t    for (const [fp, sighting] of seen) {\n721\t        let note = `seen previously in run ${sighting.runTS}`\n722\t        if (sighting.dropReason) note += ` (dropped: ${sighting.dropReason})`\n723\t        out.set(fp, note)\n724\t    }\n725\t    return out\n726\t}\n727\t\n728\tasync function insideRepository (ctx:RunContext):Promise<boolean> {\n729\t    try {\n730\t        await gitRoot(ctx.cwd, {\n731\t            env:ctx.env as NodeJS.ProcessEnv,\n732\t            signal:ctx.signal,\n733\t        })\n734\t        return true\n735\t    } catch (err) {\n736\t        if (ctx.signal.aborted) throw err\n737\t        return false\n738\t    }\n739\t}\n740\t\n741\tasync function reviewHandler (\n742\t    args:CommandArgs,\n743\t    ctx:RunContext\n744\t):Promise<void> {\n745\t    await maybeBootstrapGate(ctx)\n746\t    const explicit = ctx.path.length > 0\n747\t    if (!explicit && !(await insideRepository(ctx))) {\n748\t        ctx.stderr.write('roast: not in a Git repository; cd into one to ' +\n749\t            'review, or try `roast doctor` / `roast --help`\\n')\n750\t        ctx.stdout.write(await ctx.rootHelp())\n751\t        return\n752\t    }\n753\t    await runReview(parseReviewFlags(args, ctx.argv), ctx)\n754\t}\n755\t\n756\texport const reviewCommand:CommandDef = {\n757\t    command:['review', '$0'],\n758\t    describe:'Review the current changes (the default command)',\n759\t    builder:reviewBuilder,\n760\t    handler:reviewHandler,\n761\t}\n762\t"}]},"parent_tool_use_id":"toolu_018gF4SKTMT76p6W4DKSyVyJ","agent_id":"a65d44a24feed96f9","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"5770a736-d376-497a-ac72-efccc1ad077b","timestamp":"2026-11-24T04:04:12.210Z","tool_result_meta":[{"id":"toolu_01Fkz5CVrXUyhWzZeGQrZnEU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description":"Review review cmd/verify/gate"}
