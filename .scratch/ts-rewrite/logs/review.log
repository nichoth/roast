+        prompt_tokens_details:{\n+            cached_tokens:obj(u.input_tokens_details).cached_tokens,\n+        },\n+        completion_tokens:u.output_tokens,\n+        completion_tokens_details:{\n+            reasoning_tokens:obj(u.output_tokens_details).reasoning_tokens,\n+        },\n+    })\n+}\n+\n+// Stage 1 for `anthropic`: the usage accumulated over `message_start`\n+// and `message_delta` (spec 06, 2.8.3).\n+export function anthropicUsage (raw:unknown):IntermediateUsage {\n+    const u = obj(raw)\n+    return {\n+        input:num(u.input_tokens),\n+        cacheRead:num(u.cache_read_input_tokens),\n+        cacheWrite:num(u.cache_creation_input_tokens),\n+        output:num(u.output_tokens),\n+    }\n+}\n+\n // Stage 2: clamp every count to >= 0; one call.\n export function normalizeUsage (u:IntermediateUsage):Usage {\n     return {\n src/llm/anthropic.ts            | 298 ++++++++++++++++++++++++++++\n src/llm/client.ts               |  20 ++\n src/llm/responses.ts            | 207 +++++++++++++++++++\n src/llm/usage.ts                |  27 +++\n test/helpers/anthropic-fakes.ts | 290 +++++++++++++++++++++++++++\n test/llm/anthropic-client.ts    | 341 ++++++++++++++++++++++++++++++++\n test/llm/anthropic.ts           | 408 ++++++++++++++++++++++++++++++++++++++\n test/llm/client.ts              |   4 +-\n test/llm/responses-http.ts      | 268 +++++++++++++++++++++++++\n test/llm/responses.ts           | 426 ++++++++++++++++++++++++++++++++++++++++\n 10 files changed, 2288 insertions(+), 1 deletion(-)","is_error":false}]},"parent_tool_use_id":"toolu_01T6H39Mzrb9HTVEpUPxaMw9","agent_id":"a2d564e3db2c159ee","session_id":"88028451-5f39-411f-b6c1-a60f530aedf7","uuid":"e4820064-8af6-49cb-a570-3af4d3d535f6","timestamp":"2026-11-24T04:05:12.481Z","tool_result_meta":[{"id":"toolu_012p98XZkNae3iiYMHosdCAa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"ed3d-basic-agents:opus-general-purpose","task_description