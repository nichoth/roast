\t    if (RAW_EXPOSED.has(finishReason)) turn.rawFinishReason = rawFinish\n   297\t    return turn\n   298\t}\n     1\t// Usage normalization (spec 06, 2.9): provider fields -> disjoint\n     2\t// intermediate counts (stage 1, per protocol) -> Usage (stage 2, shared).\n     3\t// Cached tokens are subtracted exactly once (deliberate change 13).\n     4\t\n     5\timport type { Usage } from './types.js'\n     6\t\n     7\texport interface IntermediateUsage {\n     8\t    input:number;\n     9\t    cacheRead:number;\n    10\t    cacheWrite:number;\n    11\t    output:number;\n    12\t}\n    13\t\n    14\tfunction num (v:unknown):number {\n    15\t    return typeof v === 'number' && Number.isFinite(v) ? v : 0\n    16\t}\n    17\t\n    18\tfunction obj (v:unknown):Record<string, unknown> {\n    19\t    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n    20\t        v as Record<string, unknown> :\n    21\t        {}\n    22\t}\n    23\t\n    24\t// Stage 1 for `chat`: the `usage` object of a completion chunk.\n    25\texport function chatUsage (raw:unknown):IntermediateUsage {\n    26\t    const u = obj(raw)\n    27\t    const prompt = num(u.prompt_tokens)\n    28\t    const cached = num(obj(u.prompt_tokens_details).cached_tokens)\n    29\t    const output = num(u.completion_tokens)\n    30\t    const reasoning = num(obj(u.completion_tokens_details).reasoning_tokens)\n    31\t    return {\n    32\t        input:Math.max(prompt - cached, 0),\n    33\t        cacheRead:cached,\n    34\t        cacheWrite:0,\n    35\t        output:reasoning > output ? output + reasoning : output,\n    36\t    }\n    37\t}\n    38\t\n    39\t// Stage 1 for `responses`: the terminal event's `response.usage`.\n    40\texport function responsesUsage (raw:unknown):IntermediateUsage {\n    41\t    const u = obj(raw)\n    42\t    return chatUsage({\n    43\t        prompt_tokens:u.input_tokens,\n    44\t        prompt_tokens_details:{\n    45\t            cached_tokens:obj(u.i