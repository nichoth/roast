on * ev ():AsyncGenerator<SseEvent> {\n   359\t        yield * events(start(), blockStart(0, { type:'text', text:'' }))\n   360\t        yield {\n   361\t            event:'content_block_delta',\n   362\t            data:'{\"type\":\"content_block_delta\",\"index\":0,' +\n   363\t                '\"delta\":{\"type\":\"text_delta\",\"text\":\"a\\\\ud800b\"}}',\n   364\t        }\n   365\t        yield * events(blockStop(0), messageDelta('end_turn'), stop)\n   366\t    }\n   367\t    const turn = await decodeAnthropic(ev())\n   368\t    t.deepEqual(turn.parts, [{ type:'text', text:'a\\ufffdb' }])\n   369\t})\n   370\t\n   371\tclass Sink implements StreamSink {\n   372\t    headers:Record<string, string> = {}\n   373\t    out = ''\n   374\t    setHeader (name:string, value:string) { this.headers[name] = value }\n   375\t    write (s:string) { this.out += s; return true }\n   376\t    end () {}\n   377\t}\n   378\t\n   379\tasync function * bytes (s:string) { yield new TextEncoder().encode(s) }\n   380\t\n   381\ttest('writeInferenceStream anthropic round-trips through the decoder',\n   382\t    async t => {\n   383\t        const sink = new Sink()\n   384\t        writeInferenceStream(sink, 'anthropic', {\n   385\t            id:'msg',\n   386\t            type:'message',\n   387\t            role:'assistant',\n   388\t            model:'claude-test',\n   389\t            content:[\n   390\t                { type:'thinking', thinking:'hmm', signature:'S' },\n   391\t                { type:'text', text:'hi' },\n   392\t                { type:'tool_use', id:'t', name:'read', input:{ a:1 } },\n   393\t            ],\n   394\t            stop_reason:'tool_use',\n   395\t            usage:{ input_tokens:10, output_tokens:4 },\n   396\t        })\n   397\t        t.equal(sink.headers['Content-Type'], 'text/event-stream')\n   398\t        t.ok(sink.out.startsWith('event: message_start\\ndata: '),\n   399\t            'named events')\n   400\t        const turn = await decode