","-// resolve fills only the values ldflags left at their sentinels, so a","-// stamped release build always wins over the toolchain's embedded metadata.","-func resolve(version, commit, date string, info *debug.BuildInfo) (string, string, string) {","-\tif info == nil {","-\t\treturn version, commit, date","-\t}","-\tif version == unsetVersion {","-\t\t// \"(devel)\" means the toolchain had no module or VCS version to embed.","-\t\tif v := info.Main.Version; v != \"\" && v != \"(devel)\" {","-\t\t\tversion = v","-\t\t}","-\t}","-\tfor _, setting := range info.Settings {","-\t\tswitch setting.Key {","-\t\tcase \"vcs.revision\":","-\t\t\tif commit == unsetValue && setting.Value != \"\" {","-\t\t\t\tcommit = setting.Value[:min(len(setting.Value), shortCommit)]","-\t\t\t}","-\t\tcase \"vcs.time\":","-\t\t\tif date == unsetValue && setting.Value != \"\" {","-\t\t\t\tdate = setting.Value","-\t\t\t}","-\t\t}","-\t}","-\treturn version, commit, date","-}","-","-// String returns a one-line human-readable version string.","-// In development builds: \"dev (commit unknown)\"","-// In `go install` builds: \"v0.1.0 (commit unknown)\"","-// In release builds:      \"v0.1.0 (abc1234, 2026-09-19)\"","-func String() string {","-\tif Version == unsetVersion || Date == unsetValue {","-\t\treturn fmt.Sprintf(\"%s (commit %s)\", Version, Commit)","-\t}","-\treturn fmt.Sprintf(\"%s (%s, %s)\", Version, Commit, Date)","-}"]}],"deleted":true},{"filePath":"/Users/nick/code/roast.ts-rewrite-37-m6-cutover/internal/buildinfo/buildinfo_test.go","hunks":[{"oldStart":1,"oldLines":70,"newStart":0,"newLines":0,"lines":["-package buildinfo","-","-import (","-\t\"runtime/debug\"","-\t\"testing\"","-)","-","-func TestResolve(t *testing.T) {","-\tvcs := []debug.BuildSetting{","-\t\t{Key: \"vcs\", Value: \"git\"},","-\t\t{Key: \"vcs.revision\", Value: \"0123456789abcdef0123456789abcdef01234567\"},","-\t\t{Key: \"vcs.time\", Value: \"2026-10-31T12:00:00Z\"},","-\t\t{Key: \"vcs.modified\", Value: \"fal