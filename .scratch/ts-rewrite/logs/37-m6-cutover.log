ity\n    runs-on: ubuntu-26.04\n    timeout-minutes: 20\n    permissions:\n      contents: read\n    steps:\n      - name: Checkout full history\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Set up Go\n        # Only for the CI tool modules under .github/tools.\n        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n        with:\n          go-version-file: .github/tools/gitleaks/go.mod\n          cache-dependency-path: .github/tools/*/go.sum\n\n      - name: Set up Node\n        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 24\n\n      - name: Check tool module files\n        run: |\n          set -euo pipefail\n          for modfile in .github/tools/*/go.mod; do\n            (cd \"${modfile%/*}\" && go mod tidy)\n          done\n          git diff --exit-code -- .github/tools\n          # git diff alone does not report a missing go.sum recreated by tidy.\n          test -z \"$(git ls-files --others --exclude-standard -- .github/tools)\"\n\n      - name: Scan Git history for secrets\n        run: go tool -modfile=.github/tools/gitleaks/go.mod gitleaks git --redact --no-banner .\n\n      - name: Check workflows\n        run: go tool -modfile=.github/tools/actionlint/go.mod actionlint\n\n      - name: Check the hook script\n        run: shellcheck src/gate/pre-commit.sh\n\n      - name: Install npm dependencies\n        # .npmrc sets package-lock=false, so no lockfile is committed. Write\n        # one from package.json so npm ci can install from it.\n        run: |\n          npm install --package-lock-only --package-lock=true --no-audit --no-fund\n          npm ci --no-audit --no-fund\n\n      - name: Audit npm dependencies\n        # Without --omit=dev: the bundled runtime libraries are\n        # devDependencies.\n        run: npm audit --