 a `Scenario[]` under\n  `test/diff/scenarios/` and list it in `SCENARIOS` (`index.ts`);\n  `server`, `records`, and `requests` turn on the fake server and\n  record/request comparison.\n- A difference caused by a deliberate change goes in `ALLOWLIST`\n  (`allowlist.ts`) naming the change number. Go behavior judged wrong\n  goes in the owning area's Open questions, never patched in the\n  harness.\n- Review scenarios script the fake with `scriptedServer` (`replies.ts`),\n  keyed by `<model>#<turns>` like the request groups. A first finder\n  call has 3 messages, a first verifier call 2; an unscripted key gets\n  a 404 naming it. Credential variables must not start with a scrubbed\n  prefix (`ROAST_`, `OPENAI_`, ...): `scrubbedEnv` drops them.\n- Go-only incidental bytes are normalized, not allowlisted: SDK headers\n  (`X-Stainless-*`), Go's `\\u003c` HTML escaping (records compare as\n  parsed JSON, including `provider-responses.jsonl`), gzip/zstd bytes\n  and the bundle-manifest hashes of compressed members, finding UUIDs\n  and aliases, and the snapshot `commit` / `ref` OIDs.\n- Self-tests that need a one-sided difference wrap the TS CLI: a node\n  script that edits records after `dist/cli.js` exits, or `node\n  --import <hook>` replacing `globalThis.fetch` (the adapters send a\n  `Uint8Array` body).\nsrc/llm:\nagent.ts\ncapture.ts\nchat.ts\nclient.ts\ndeadline.ts\nerrors.ts\nfinal-args.ts\nhttp.ts\njson.ts\nledger.ts\nmessages.ts\nmodels.ts\nretry.ts\nreview.ts\nsession.ts\nsse.ts\ntypes.ts\nusage.ts\n\ntest/diff:\nallowlist.ts\nbaseline.ts\ncompare.ts\nfixture.ts\nindex.ts\nnormalize.ts\nprompts.ts\nrecords.ts\nreplies.ts\nrequests.ts\nscenario.ts\nscenarios/\nselftest/\ntar.ts\n\ntest/diff/scenarios:\nm1.ts\nm3.ts\n\ntest/helpers:\ndoctor-probe.ts\nenv.ts\ninference-server.ts\ninference-stream.ts\nprovider-server.ts\nrepo.ts\nreview.ts\nrun.ts\nspawn.ts\nstreams.ts\nterminal.ts\ntest.ts\n\ntest/llm:\nagent-deadline.ts\nagent-dispatch.ts\nagent-finalization.ts\nagent-helpers.ts\nagent-http.ts\ncapture.ts\nchat-decode.ts\nchat-encode.ts\nclient.ts\nerrors.ts\njson.ts\nledger.ts\nsse.ts\nusage.ts\n     572 src/llm/agent.ts\n     197 src/llm/capture.ts\n     319 src/llm/chat.ts\n     329 src/llm/client.ts\n     108 src/llm/deadline.ts\n     389 src/llm/errors.ts\n      99 src/llm/final-args.ts\n      49 src/llm/http.ts\n      43 src/llm/json.ts\n      98 src/llm/ledger.ts\n      13 src/llm/messages.ts\n      25 src/llm/models.ts\n      53 src/llm/retry.ts\n     212 src/llm/review.ts\n      24 src/llm/session.ts\n      85 src/llm/sse.ts\n     166 src/llm/types.ts\n      75 src/llm/usage.ts\n    2856 total\n00-decisions.md\n01-cli.md\n02-config.md\n03-trust-credentials.md\n04-scope.md\n05-context.md\n06-llm-protocols.md\n07-agent-loop.md\n08-finder-prompts.md\n09-verify-render.md\n10-records.md\n11-snapshot.md\n12-gate.md\n13-login.md\n14-doctor-init-skill.md\n15-packaging.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01W3hWcpp6TD3wsowqww4uuw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLzGrXEY5AzKZMBaV1ec","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KihRdyEtubeUCJojYFn91b","name":"Bash","input":{"command":"cat src/llm/chat.ts src/llm/client.ts src/llm/models.ts src/llm/usage.ts src/llm/http.ts src/llm/types.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5418,"cache_read_input_tokens":53402,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5418},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"1b4bda7e-addc-44ad-990b-3389bdb3c0c3","timestamp":"2026-11-24T02:46:43.075Z","request_id":"req_011ChLzGrP4DDgyYZJxV3cir","wire_tool_inputs":{"toolu_01KihRdyEtubeUCJojYFn91b":{"command":"cat src/llm/chat.ts src/llm/client.ts src/llm/models.ts src/llm/usage.ts src/llm/http.ts src/llm/types.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KihRdyEtubeUCJojYFn91b","type":"tool_result","content":"// The `chat` protocol (OpenAI Chat Completions; OpenRouter, DeepSeek,\n// others): a pure request encoder and stream decoder (spec 06, 2.6.1 and\n// 2.8.1).\n\nimport {\n    IncompleteStreamError,\n    ProviderError,\n    streamError,\n} from './errors.js'\nimport { wellFormed } from './json.js'\nimport { isChatReasoningModel } from './models.js'\nimport type { SseEvent } from './sse.js'\nimport type {\n    AssistantPart,\n    ConversationItem,\n    FinishReason,\n    ModelTurn,\n    ToolDefinition,\n} from './types.js'\nimport { chatUsage, normalizeUsage } from './usage.js'\n\nexport interface EncodeConfig {\n    model:string;\n    maxOutputTokens:number;\n}\n\nexport interface EncodeRequest {\n    system:string;\n    items:readonly ConversationItem[];\n    tools:readonly ToolDefinition[];\n}\n\nexport function trimSlashes (url:string):string {\n    let end = url.length\n    while (end > 0 && url.charCodeAt(end - 1) === 47) end--\n    return url.slice(0, end)\n}\n\nexport function chatUrl (baseUrl:string):string {\n    return `${trimSlashes(baseUrl)}/chat/completions`\n}\n\nfunction assistantMessage (\n    parts:readonly AssistantPart[]\n):Record<string, unknown>|null {\n    const texts:string[] = []\n    const reasoning:string[] = []\n    const calls:unknown[] = []\n    for (const p of parts) {\n        if (p.type === 'text') texts.push(p.text)\n        else if (p.type === 'reasoning') reasoning.push(p.text)\n        else {\n            calls.push({\n                id:p.id,\n                type:'function',\n                function:{ name:p.name, arguments:p.input },\n            })\n        }\n    }\n    if (texts.length === 0 && calls.length === 0) return null\n    const msg:Record<string, unknown> = { role:'assistant' }\n    if (texts.length > 0) msg.content = texts.join('\\n')\n    if (calls.length > 0) msg.tool_calls = calls\n    if (reasoning.length > 0) msg.reasoning_content = reasoning.join('\\n')\n    return msg\n}\n\nfunction messages (req:EncodeRequest):unknown[] {\n    const out:unknown[] = []\n    if (req.system !== '') out.push({ role:'system', content:req.system })\n    for (const item of req.items) {\n        if (item.role === 'user') {\n            out.push({ role:'user', content:item.text })\n        } else if (item.role === 'assistant') {\n            const msg = assistantMessage(item.parts)\n            if (msg) out.push(msg)\n        } else {\n            for (const r of item.results) {\n                out.push({\n                    role:'tool',\n                    tool_call_id:r.callId,\n                    content:r.output,\n                })\n            }\n        }\n    }\n    return out\n}\n\n// The request body. Tool choice is always automatic.\nexport function encodeChat (\n    config:EncodeConfig,\n    req:EncodeRequest\n):Record<string, unknown> {\n    const body:Record<string, unknown> = {\n        model:config.model,\n        messages:messages(req),\n    }\n    if (isChatReasoningModel(config.model)) {\n        body.max_completion_tokens = config.maxOutputTokens\n    } else {\n        body.max_tokens = config.maxOutputTokens\n    }\n    body.stream = true\n    body.stream_options = { include_usage:true }\n    if (req.tools.length > 0) {\n        body.tools = req.tools.map(tool => ({\n            type:'function',\n            function:{\n                name:tool.name,\n                description:tool.description ?? '',\n                parameters:structuredClone(tool.schema),\n                strict:false,\n            },\n        }))\n        body.tool_choice = 'auto'\n    }\n    return body\n}\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\nfunction str (v:unknown):string {\n    return typeof v === 'string' ? wellFormed(v) : ''\n}\n\nfunction protocolError (message:string, cause?:unknown):ProviderError {\n    return new ProviderError(message, { retryable:false, cause })\n}\n\ninterface OpenCall {\n    index:number;\n    id:string;\n    name:string;\n    args:string;\n}\n\nconst FINISH:Record<string, FinishReason> = {\n    stop:'stop',\n    length:'length',\n    content_filter:'content-filter',\n    tool_calls:'tool-calls',\n    function_call:'tool-calls',\n    insufficient_system_resource:'error',\n}\n\nconst RAW_EXPOSED = new Set<FinishReason>([\n    'length',\n    'content-filter',\n    'error',\n    'unknown',\n])\n\nconst SUPPRESS_CALLS = new Set<FinishReason>([\n    'length',\n    'content-filter',\n    'error',\n])\n\nfunction validJson (s:string):boolean {\n    try {\n        JSON.parse(s)\n        return true\n    } catch {\n        return false\n    }\n}\n\n// The provider error carried by a chunk's top-level `error` member.\nfunction chunkError (value:unknown):ProviderError {\n    const e = obj(value)\n    const code = typeof e.code === 'number' ? String(e.code) : str(e.code)\n    const message = str(e.message) ||\n        (typeof value === 'string' ? value : JSON.stringify(value))\n    return streamError(str(e.type), code, message)\n}\n\n// Assembles one turn from chat.completion.chunk events (spec 06, 2.8.1).\n// Stops reading at `[DONE]`; throws the 2.10 error kinds.\nexport async function decodeChat (\n    events:AsyncIterable<SseEvent>\n):Promise<ModelTurn> {\n    const parts:AssistantPart[] = []\n    let text:{ type:'text', text:string }|null = null\n    let reasoning:{ type:'reasoning', text:string }|null = null\n    let reasoningEnded = false\n    const calls = new Map<number, OpenCall>()\n    let rawFinish = ''\n    let usage:unknown\n\n    function openReasoning ():{ type:'reasoning', text:string } {\n        if (!reasoning) {\n            reasoning = { type:'reasoning', text:'' }\n            parts.push(reasoning)\n            text = null\n        }\n        return reasoning\n    }\n\n    function onDelta (delta:Json, finish:string):void {\n        const content = str(delta.content)\n        const toolCalls = Array.isArray(delta.tool_calls) ?\n            delta.tool_calls :\n            []\n        const boundary = content !== '' ||\n            Array.isArray(delta.tool_calls) || finish !== ''\n        const field = delta.reasoning_content ?? delta.reasoning\n        const thought = str(field)\n        if (thought !== '') {\n            openReasoning().text += thought\n        } else if (typeof field === 'string' && !boundary &&\n            !reasoningEnded) {\n            openReasoning()\n        }\n        if (boundary && reasoning) {\n            reasoning = null\n            reasoningEnded = true\n        }\n        if (content !== '') {\n            if (!text) {\n                text = { type:'text', text:'' }\n                parts.push(text)\n            }\n            text.text += content\n        }\n        for (const raw of toolCalls) onToolCall(obj(raw))\n    }\n\n    function onToolCall (tc:Json):void {\n        const index = typeof tc.index === 'number' ? tc.index : 0\n        const fn = obj(tc.function)\n        const name = str(fn.name)\n        const args = str(fn.arguments)\n        const open = calls.get(index)\n        if (open) {\n            open.args += args\n            return\n        }\n        if (name === '' && args === '') return\n        const type = tc.type === undefined || tc.type === null ?\n            'function' :\n            tc.type\n        if (type !== 'function') {\n            throw protocolError(\n                `unsupported tool call type ${JSON.stringify(type)}`)\n        }\n        calls.set(index, {\n            index,\n            id:str(tc.id) || `tool-call-${index}`,\n            name,\n            args,\n        })\n    }\n\n    for await (const ev of events) {\n        if (ev.data.startsWith('[DONE]')) break\n        let chunk:Json\n        try {\n            chunk = obj(JSON.parse(ev.data))\n        } catch (err) {\n            throw protocolError('malformed chat stream event', err)\n        }\n        if ('error' in chunk) throw chunkError(chunk.error)\n        const u = obj(chunk.usage)\n        if (typeof u.total_tokens === 'number' && u.total_tokens > 0) {\n            usage = chunk.usage\n        }\n        const choices = Array.isArray(chunk.choices) ? chunk.choices : []\n        for (const raw of choices) {\n            const choice = obj(raw)\n            const finish = str(choice.finish_reason)\n            onDelta(obj(choice.delta), finish)\n            if (finish !== '') rawFinish = finish\n        }\n    }\n\n    const ordered = [...calls.values()].sort((a, b) => a.index - b.index)\n    let finishReason:FinishReason\n    if (rawFinish !== '') {\n        finishReason = Object.hasOwn(FINISH, rawFinish) ?\n            FINISH[rawFinish] :\n            'unknown'\n    } else if (ordered.length > 0) {\n        if (ordered.some(c => c.args === '' || !validJson(c.args))) {\n            throw new IncompleteStreamError()\n        }\n        finishReason = 'tool-calls'\n    } else {\n        throw new IncompleteStreamError()\n    }\n\n    const turn:ModelTurn = {\n        parts,\n        finishReason,\n        usage:normalizeUsage(chatUsage(usage)),\n    }\n    if (rawFinish !== '' && RAW_EXPOSED.has(finishReason)) {\n        turn.rawFinishReason = rawFinish\n    }\n    if (ordered.length > 0 && SUPPRESS_CALLS.has(finishReason)) {\n        turn.rawFinishReason = rawFinish\n        return turn\n    }\n    for (const c of ordered) {\n        parts.push({\n            type:'tool-call',\n            id:c.id,\n            name:c.name,\n            input:c.args === '' ? '{}' : c.args,\n        })\n    }\n    return turn\n}\n// `createModelClient` and `send` (spec 06, 3.2): one model turn becomes\n// exactly one HTTP request in the profile's protocol. Never retries.\n\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport { abortable, CaptureGate, openCapturedBody } from './capture.js'\nimport { chatUrl, decodeChat, encodeChat } from './chat.js'\nimport {\n    CaptureError,\n    EndpointError,\n    ProviderError,\n    SENTINEL_MESSAGE,\n} from './errors.js'\nimport { currentFetch, requestHeaders } from './http.js'\nimport { parseSse, type SseEvent } from './sse.js'\nimport {\n    DEFAULT_MAX_ATTEMPTS,\n    runConversation,\n    type LoopDeps,\n} from './agent.js'\nimport type { Ledger } from './ledger.js'\nimport type { Sleep } from './retry.js'\nimport type {\n    Client,\n    ClientConfig,\n    ModelRequest,\n    ModelTurn,\n    Protocol,\n    RecordUsage,\n    Usage,\n} from './types.js'\nimport { UsageAccumulator } from './usage.js'\n\nexport { DEFAULT_MAX_ATTEMPTS }\n\n// Error bodies are read at most this far (deliberate change 9).\nexport const MAX_ERROR_BODY = 32 * 1024\n\nexport interface ModelClient {\n    readonly config:Readonly<ClientConfig>;\n    // '' normalized to 'chat'.\n    readonly protocol:Protocol;\n    // <= 0 normalized to DEFAULT_MAX_ATTEMPTS.\n    readonly maxAttempts:number;\n    // One HTTP attempt. Resolves only after capture succeeded.\n    send (request:ModelRequest):Promise<ModelTurn>;\n    // Exact byte length of the request body `send` would post.\n    requestBytes (request:ModelRequest):number;\n    // Accumulated usage across all calls on this client.\n    usage ():Usage;\n}\n\ninterface Adapter {\n    url (baseUrl:string):string;\n    encode (config:ClientConfig, request:ModelRequest):unknown;\n    decode (events:AsyncIterable<SseEvent>):Promise<ModelTurn>;\n}\n\nconst ADAPTERS:Partial<Record<Protocol, Adapter>> = {\n    chat:{\n        url:chatUrl,\n        encode:(config, request) => encodeChat(config, request),\n        decode:decodeChat,\n    },\n}\n\nfunction adapterFor (protocol:string):Adapter {\n    const known = protocol === 'chat' || protocol === 'responses' ||\n        protocol === 'anthropic'\n    const adapter = known ? ADAPTERS[protocol as Protocol] : undefined\n    if (!adapter) {\n        throw new Error(`unsupported inference protocol \"${protocol}\"`)\n    }\n    return adapter\n}\n\n// Best-effort provider error fields from an OpenAI-style\n// `{\"error\":{...}}` or Anthropic `{\"type\":\"error\",\"error\":{...}}` body.\nfunction providerFields (text:string):{\n    type?:string;\n    code?:string;\n    message?:string;\n} {\n    try {\n        const parsed:unknown = JSON.parse(text)\n        if (parsed === null || typeof parsed !== 'object') return {}\n        const e = (parsed as { error?:unknown }).error\n        if (e === null || typeof e !== 'object') return {}\n        const { type, code, message } = e as Record<string, unknown>\n        return {\n            type:typeof type === 'string' ? type : undefined,\n            code:typeof code === 'string' ?\n                code :\n                typeof code === 'number' ? String(code) : undefined,\n            message:typeof message === 'string' ? message : undefined,\n        }\n    } catch {\n        return {}\n    }\n}\n\nasync function readCapped (\n    body:ReadableStream<Uint8Array>|null,\n    limit:number,\n    signal:AbortSignal\n):Promise<Uint8Array> {\n    if (!body) return new Uint8Array(0)\n    const reader = body.getReader()\n    const parts:Uint8Array[] = []\n    let size = 0\n    let eof = false\n    try {\n        while (size < limit) {\n            const r = await abortable(reader.read(), signal)\n            if (r.done) {\n                eof = true\n                break\n            }\n            const take = r.value.subarray(0, limit - size)\n            parts.push(take)\n            size += take.length\n        }\n    } finally {\n        if (!eof) await reader.cancel().catch(() => {})\n    }\n    const out = new Uint8Array(size)\n    let off = 0\n    for (const p of parts) {\n        out.set(p, off)\n        off += p.length\n    }\n    return out\n}\n\nasync function httpError (\n    response:Response,\n    url:string,\n    model:string,\n    signal:AbortSignal\n):Promise<Error> {\n    const bytes = await readCapped(response.body, MAX_ERROR_BODY, signal)\n    const text = new TextDecoder().decode(bytes)\n    const fields = providerFields(text)\n    const headers:Record<string, string> = {}\n    response.headers.forEach((value, name) => { headers[name] = value })\n    const detail = fields.message ?? text.slice(0, 512).trim()\n    const status = `${response.status} ${response.statusText}`.trim()\n    const err = new ProviderError(\n        `POST \"${url}\": ${status}${detail ? `: ${detail}` : ''}`,\n        {\n            status:response.status,\n            headers,\n            providerType:fields.type,\n            providerCode:fields.code,\n            providerMessage:fields.message,\n        })\n    if (response.status >= 300 && response.status < 400) {\n        return new EndpointError(\n            `${SENTINEL_MESSAGE.endpoint}: ${model}: redirect refused: ` +\n                err.message,\n            { cause:err, details:{ model } })\n    }\n    return err\n}\n\nexport function createModelClient (config:ClientConfig):ModelClient {\n    if (!(config.maxOutputTokens > 0)) {\n        throw new Error(`${config.model}: max output tokens must be positive`)\n    }\n    if (goTrimSpace(config.apiKey) === '') {\n        throw new Error(`${config.model}: API key is not configured`)\n    }\n    const protocol = (config.protocol === '' ?\n        'chat' :\n        config.protocol) as Protocol\n    const adapter = adapterFor(protocol)\n    const maxAttempts = config.maxAttempts > 0 ?\n        config.maxAttempts :\n        DEFAULT_MAX_ATTEMPTS\n    const gate = new CaptureGate()\n    const total = new UsageAccumulator()\n    const url = adapter.url(config.baseUrl)\n\n    function encodeBody (request:ModelRequest):Uint8Array {\n        const body = adapter.encode(config, request)\n        return new TextEncoder().encode(JSON.stringify(body))\n    }\n\n    async function attempt (\n        request:ModelRequest,\n        signal:AbortSignal\n    ):Promise<ModelTurn> {\n        const fetchFn = config.fetch ?? currentFetch()\n        const response = await fetchFn(url, {\n            method:'POST',\n            headers:requestHeaders(protocol, config.apiKey,\n                request.sessionId, config.sessionHeader),\n            body:encodeBody(request),\n            redirect:'manual',\n            signal,\n        })\n        if (response.status < 200 || response.status >= 300) {\n            throw await httpError(response, url, config.model, signal)\n        }\n        const body = await openCapturedBody(response, {\n            role:config.role,\n            protocol,\n            model:config.model,\n            captureResponse:config.captureResponse,\n        }, gate, signal)\n        let turn:ModelTurn|undefined\n        let failure:unknown\n        try {\n            turn = await adapter.decode(parseSse(body.chunks))\n        } catch (err) {\n            failure = err\n        }\n        if (turn) {\n            total.add(turn.usage)\n            request.onUsage?.(turn.usage)\n        }\n        // A capture failure here replaces any turn or error.\n        await body.release()\n        if (!turn) throw failure\n        signal.throwIfAborted()\n        return turn\n    }\n\n    return {\n        config,\n        protocol,\n        maxAttempts,\n        requestBytes (request:ModelRequest):number {\n            return encodeBody(request).length\n        },\n        usage ():Usage {\n            return total.total()\n        },\n        async send (request:ModelRequest):Promise<ModelTurn> {\n            if (gate.failure) throw gate.failure\n            request.signal.throwIfAborted()\n            const timeout = config.requestTimeoutMs > 0 ?\n                AbortSignal.timeout(config.requestTimeoutMs) :\n                undefined\n            const signal = timeout ?\n                AbortSignal.any([request.signal, timeout]) :\n                request.signal\n            try {\n                return await attempt(request, signal)\n            } catch (err) {\n                if (err instanceof CaptureError) throw err\n                if (request.signal.aborted) throw request.signal.reason\n                if (timeout?.aborted) {\n                    throw new EndpointError(\n                        `${SENTINEL_MESSAGE.endpoint}: ${config.model}: ` +\n                            'request timed out after ' +\n                            `${config.requestTimeoutMs}ms`,\n                        {\n                            cause:timeout.reason,\n                            details:{ model:config.model },\n                        })\n                }\n                throw err\n            }\n        },\n    }\n}\n\nexport interface CreateClientOptions {\n    // The run's shared ledger; none means unlimited.\n    ledger?:Ledger|null;\n    now?:() => number;\n    sleep?:Sleep;\n    sessionId?:() => string;\n}\n\nfunction recordUsage (u:Usage):RecordUsage {\n    return {\n        uncached_input_tokens:u.uncachedInputTokens,\n        cached_input_tokens:u.cachedInputTokens,\n        cache_write_tokens:u.cacheWriteTokens,\n        output_tokens:u.outputTokens,\n        calls:u.calls,\n    }\n}\n\n// The `Client` the finder and verifier call (spec 07, 3.3): both entry\n// points run the agent loop over `model`; usage accumulates across all\n// of this client's conversations.\nexport function createClient (\n    model:ModelClient,\n    opts:CreateClientOptions = {}\n):Client {\n    const total = new UsageAccumulator()\n    const deps:LoopDeps = {\n        client:model,\n        model:model.config.model,\n        maxOutputTokens:model.config.maxOutputTokens,\n        maxAttempts:model.maxAttempts > 0 ?\n            model.maxAttempts :\n            DEFAULT_MAX_ATTEMPTS,\n        ledger:opts.ledger ?? null,\n        addUsage:u => total.add(u),\n        now:opts.now,\n        sleep:opts.sleep,\n        sessionId:opts.sessionId,\n    }\n    return {\n        name:model.config.model,\n        converse (system, user, converseOpts, signal) {\n            return runConversation(deps, system, user, converseOpts, false,\n                signal)\n        },\n        completeStructured (system, user, schemaName, result, signal) {\n            return runConversation(deps, system, user, {\n                tools:[{\n                    name:schemaName,\n                    description:'Return the requested structured result.',\n                    schema:result.schema,\n                }],\n                finalTool:schemaName,\n                final:{ decode:result.decode },\n                maxTurns:1,\n            }, true, signal)\n        },\n        usage () {\n            return recordUsage(total.total())\n        },\n    }\n}\n// Model-ID rules (spec 06, 2.6).\n\nconst REASONING = /(?:^|[-.])(?:o[134]|oss)|gpt-[5-9]|codex-|computer-use/\nconst CLASSIC_CHAT = /gpt-3|gpt-4|chatgpt-|-chat/\n\n// Chat reasoning models take `max_completion_tokens` instead of\n// `max_tokens`.\nexport function isChatReasoningModel (id:string):boolean {\n    const lower = id.toLowerCase()\n    return REASONING.test(lower) && !CLASSIC_CHAT.test(lower)\n}\n\n// How the `responses` protocol sends the system prompt.\nexport function responsesSystemMode (\n    id:string\n):'system'|'developer'|'remove' {\n    if (CLASSIC_CHAT.test(id.toLowerCase())) return 'system'\n    if (id.includes('o1-mini') || id.includes('o1-preview')) return 'remove'\n    return 'developer'\n}\n\n// Models that get adaptive thinking by default on `anthropic`.\nexport function anthropicDefaultThinking (id:string):boolean {\n    return id.toLowerCase().includes('claude-mythos-preview')\n}\n// Usage normalization (spec 06, 2.9): provider fields -> disjoint\n// intermediate counts (stage 1, per protocol) -> Usage (stage 2, shared).\n// Cached tokens are subtracted exactly once (deliberate change 13).\n\nimport type { Usage } from './types.js'\n\nexport interface IntermediateUsage {\n    input:number;\n    cacheRead:number;\n    cacheWrite:number;\n    output:number;\n}\n\nfunction num (v:unknown):number {\n    return typeof v === 'number' && Number.isFinite(v) ? v : 0\n}\n\nfunction obj (v:unknown):Record<string, unknown> {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Record<string, unknown> :\n        {}\n}\n\n// Stage 1 for `chat`: the `usage` object of a completion chunk.\nexport function chatUsage (raw:unknown):IntermediateUsage {\n    const u = obj(raw)\n    const prompt = num(u.prompt_tokens)\n    const cached = num(obj(u.prompt_tokens_details).cached_tokens)\n    const output = num(u.completion_tokens)\n    const reasoning = num(obj(u.completion_tokens_details).reasoning_tokens)\n    return {\n        input:Math.max(prompt - cached, 0),\n        cacheRead:cached,\n        cacheWrite:0,\n        output:reasoning > output ? output + reasoning : output,\n    }\n}\n\n// Stage 2: clamp every count to >= 0; one call.\nexport function normalizeUsage (u:IntermediateUsage):Usage {\n    return {\n        uncachedInputTokens:Math.max(u.input, 0),\n        cachedInputTokens:Math.max(u.cacheRead, 0),\n        cacheWriteTokens:Math.max(u.cacheWrite, 0),\n        outputTokens:Math.max(u.output, 0),\n        calls:1,\n    }\n}\n\nexport function zeroUsage ():Usage {\n    return {\n        uncachedInputTokens:0,\n        cachedInputTokens:0,\n        cacheWriteTokens:0,\n        outputTokens:0,\n        calls:0,\n    }\n}\n\n// A client's running total across its calls.\nexport class UsageAccumulator {\n    private sum:Usage = zeroUsage()\n\n    add (u:Usage):void {\n        this.sum.uncachedInputTokens += u.uncachedInputTokens\n        this.sum.cachedInputTokens += u.cachedInputTokens\n        this.sum.cacheWriteTokens += u.cacheWriteTokens\n        this.sum.outputTokens += u.outputTokens\n        this.sum.calls += u.calls\n    }\n\n    total ():Usage {\n        return { ...this.sum }\n    }\n}\n// The swappable `fetch` (the TS form of Go's redirectDefaultTransport,\n// shared with login and doctor) and the Roast-controlled request headers\n// (spec 06, 2.3). Nothing here reads the environment.\n\nimport { buildInfo } from '../buildinfo.js'\nimport type { Protocol } from './types.js'\n\nlet override:typeof globalThis.fetch|undefined\n\n// Replaces the fetch every client without its own `fetch` uses (tests).\nexport function setFetch (f:typeof globalThis.fetch):void {\n    override = f\n}\n\nexport function resetFetch ():void {\n    override = undefined\n}\n\nexport function currentFetch ():typeof globalThis.fetch {\n    return override ?? globalThis.fetch\n}\n\nexport function userAgent ():string {\n    return `roast/${buildInfo.version}`\n}\n\n// Every header of one request. The session headers are set last; header\n// names are case-insensitive, so a session header spelled like another\n// header yields one header holding the session ID.\nexport function requestHeaders (\n    protocol:Protocol,\n    apiKey:string,\n    sessionId:string,\n    sessionHeader?:string\n):Headers {\n    const h = new Headers()\n    h.set('Content-Type', 'application/json')\n    h.set('Accept', 'text/event-stream')\n    if (protocol === 'anthropic') {\n        h.set('X-Api-Key', apiKey)\n        h.set('Anthropic-Version', '2023-06-01')\n    } else {\n        h.set('Authorization', `Bearer ${apiKey}`)\n    }\n    h.set('User-Agent', userAgent())\n    h.set('X-Agent-Session-Id', sessionId)\n    if (sessionHeader) h.set(sessionHeader, sessionId)\n    return h\n}\n// Protocol-neutral types for the LLM layer (spec 06, 3.1; spec 07, 3.3).\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\n\nexport interface RawResponse {\n    role:string;\n    protocol:Protocol;\n    model:string;\n    contentType:'application/json'|'text/event-stream';\n    // Exact bytes of the body: no request, no headers.\n    body:Uint8Array;\n}\n\nexport interface ClientConfig {\n    // \"finder\", \"verifier\", or a doctor check name.\n    role:string;\n    baseUrl:string;\n    apiKey:string;\n    // Sent verbatim as the body's `model`.\n    model:string;\n    // \"\" means chat.\n    protocol:''|Protocol;\n    maxOutputTokens:number;\n    // Attempts per model call; <= 0 means DEFAULT_MAX_ATTEMPTS.\n    maxAttempts:number;\n    // Per request; 0 disables.\n    requestTimeoutMs:number;\n    sessionHeader?:string;\n    captureResponse?:(raw:RawResponse) => Promise<void>|void;\n    // Overrides the module-level fetch (http.ts) for this client.\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface ToolDefinition {\n    name:string;\n    description:string;\n    // The complete caller JSON Schema.\n    schema:Record<string, unknown>;\n}\n\n// A tool the agent loop offers the model (spec 07, 3.3). The final tool\n// has no `run`.\nexport interface Tool {\n    name:string;\n    description:string;\n    schema:Record<string, unknown>;\n    run?:(args:Record<string, unknown>, signal:AbortSignal) =>\n        unknown|Promise<unknown>;\n    recordsResult?:boolean;\n}\n\nexport type AssistantPart =\n    | { type:'text', text:string }\n    | {\n        type:'reasoning';\n        text:string;\n        signature?:string;\n        redactedData?:string;\n    }\n    // `input` is the raw argument string as received.\n    | { type:'tool-call', id:string, name:string, input:string }\n\nexport interface ToolResult {\n    callId:string;\n    name:string;\n    output:string;\n    isError:boolean;\n}\n\nexport type ConversationItem =\n    | { role:'user', text:string }\n    | { role:'assistant', parts:AssistantPart[] }\n    | { role:'tool', results:ToolResult[] }\n\nexport interface Usage {\n    uncachedInputTokens:number;\n    cachedInputTokens:number;\n    cacheWriteTokens:number;\n    outputTokens:number;\n    calls:number;\n}\n\nexport interface ModelRequest {\n    system:string;\n    items:ConversationItem[];\n    tools:ToolDefinition[];\n    sessionId:string;\n    // Already composed by the agent loop (caller, deadline, timeout).\n    signal:AbortSignal;\n    onUsage?:(usage:Usage) => void;\n}\n\nexport type FinishReason =\n    'stop'|'length'|'content-filter'|'tool-calls'|'error'|'other'|'unknown'\n\nexport interface ModelTurn {\n    // Arrival order; replayed verbatim.\n    parts:AssistantPart[];\n    finishReason:FinishReason;\n    rawFinishReason?:string;\n    // Normalized, calls: 1.\n    usage:Usage;\n}\n\n// Progress report for one dispatched exploration or record call, or a\n// call to an unknown tool (spec 07, 2.10).\nexport interface TurnInfo {\n    turn:number;\n    tool:string;\n    args:Record<string, unknown>;\n}\n\n// Type validation of the final arguments (spec 07, 2.7). `decode`\n// receives the value parsed with integer preservation (unsafe integers\n// are `bigint`) and the original argument text for lexical checks, and\n// throws an Error whose message is the detail.\nexport interface FinalSpec<T> {\n    decode (value:unknown, rawText?:string):T;\n}\n\nexport interface ConverseOptions<T> {\n    // Exploration, record, and final tools, in order.\n    tools:readonly Tool[];\n    finalTool:string;\n    final:FinalSpec<T>;\n    // Turn at which the final phase starts; <= 0 means 8.\n    maxTurns?:number;\n    onTurn?:(info:TurnInfo) => void;\n    // <= 0 means 3e6.\n    inputByteCeiling?:number;\n    // Absolute time, ms since the epoch.\n    workDeadline?:number;\n    // ms; <= 0 means 90000.\n    wrapUpWindow?:number;\n    onWorkDeadline?:() => void;\n    onBudgetExhausted?:() => void;\n}\n\n// Usage as written into run records: snake_case, disjoint counts.\nexport interface RecordUsage {\n    uncached_input_tokens:number;\n    cached_input_tokens:number;\n    cache_write_tokens:number;\n    output_tokens:number;\n    calls:number;\n}\n\n// One configured model role, as the finder and verifier call it.\nexport interface Client {\n    // The request model name.\n    readonly name:string;\n    converse<T> (\n        system:string,\n        user:string,\n        opts:ConverseOptions<T>,\n        signal:AbortSignal\n    ):Promise<T>;\n    completeStructured<T> (\n        system:string,\n        user:string,\n        schemaName:string,\n        result:{ schema:Record<string, unknown>, decode:FinalSpec<T>['decode'] },\n        signal:AbortSignal\n    ):Promise<T>;\n    usage ():RecordUsage;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"0ebdf31a-3acc-4d14-b249-107a568650a6","timestamp":"2026-11-24T02:46:43.145Z","tool_use_result":{"stdout":"// The `chat` protocol (OpenAI Chat Completions; OpenRouter, DeepSeek,\n// others): a pure request encoder and stream decoder (spec 06, 2.6.1 and\n// 2.8.1).\n\nimport {\n    IncompleteStreamError,\n    ProviderError,\n    streamError,\n} from './errors.js'\nimport { wellFormed } from './json.js'\nimport { isChatReasoningModel } from './models.js'\nimport type { SseEvent } from './sse.js'\nimport type {\n    AssistantPart,\n    ConversationItem,\n    FinishReason,\n    ModelTurn,\n    ToolDefinition,\n} from './types.js'\nimport { chatUsage, normalizeUsage } from './usage.js'\n\nexport interface EncodeConfig {\n    model:string;\n    maxOutputTokens:number;\n}\n\nexport interface EncodeRequest {\n    system:string;\n    items:readonly ConversationItem[];\n    tools:readonly ToolDefinition[];\n}\n\nexport function trimSlashes (url:string):string {\n    let end = url.length\n    while (end > 0 && url.charCodeAt(end - 1) === 47) end--\n    return url.slice(0, end)\n}\n\nexport function chatUrl (baseUrl:string):string {\n    return `${trimSlashes(baseUrl)}/chat/completions`\n}\n\nfunction assistantMessage (\n    parts:readonly AssistantPart[]\n):Record<string, unknown>|null {\n    const texts:string[] = []\n    const reasoning:string[] = []\n    const calls:unknown[] = []\n    for (const p of parts) {\n        if (p.type === 'text') texts.push(p.text)\n        else if (p.type === 'reasoning') reasoning.push(p.text)\n        else {\n            calls.push({\n                id:p.id,\n                type:'function',\n                function:{ name:p.name, arguments:p.input },\n            })\n        }\n    }\n    if (texts.length === 0 && calls.length === 0) return null\n    const msg:Record<string, unknown> = { role:'assistant' }\n    if (texts.length > 0) msg.content = texts.join('\\n')\n    if (calls.length > 0) msg.tool_calls = calls\n    if (reasoning.length > 0) msg.reasoning_content = reasoning.join('\\n')\n    return msg\n}\n\nfunction messages (req:EncodeRequest):unknown[] {\n    const out:unknown[] = []\n    if (req.system !== '') out.push({ role:'system', content:req.system })\n    for (const item of req.items) {\n        if (item.role === 'user') {\n            out.push({ role:'user', content:item.text })\n        } else if (item.role === 'assistant') {\n            const msg = assistantMessage(item.parts)\n            if (msg) out.push(msg)\n        } else {\n            for (const r of item.results) {\n                out.push({\n                    role:'tool',\n                    tool_call_id:r.callId,\n                    content:r.output,\n                })\n            }\n        }\n    }\n    return out\n}\n\n// The request body. Tool choice is always automatic.\nexport function encodeChat (\n    config:EncodeConfig,\n    req:EncodeRequest\n):Record<string, unknown> {\n    const body:Record<string, unknown> = {\n        model:config.model,\n        messages:messages(req),\n    }\n    if (isChatReasoningModel(config.model)) {\n        body.max_completion_tokens = config.maxOutputTokens\n    } else {\n        body.max_tokens = config.maxOutputTokens\n    }\n    body.stream = true\n    body.stream_options = { include_usage:true }\n    if (req.tools.length > 0) {\n        body.tools = req.tools.map(tool => ({\n            type:'function',\n            function:{\n                name:tool.name,\n                description:tool.description ?? '',\n                parameters:structuredClone(tool.schema),\n                strict:false,\n            },\n        }))\n        body.tool_choice = 'auto'\n    }\n    return body\n}\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\nfunction str (v:unknown):string {\n    return typeof v === 'string' ? wellFormed(v) : ''\n}\n\nfunction protocolError (message:string, cause?:unknown):ProviderError {\n    return new ProviderError(message, { retryable:false, cause })\n}\n\ninterface OpenCall {\n    index:number;\n    id:string;\n    name:string;\n    args:string;\n}\n\nconst FINISH:Record<string, FinishReason> = {\n    stop:'stop',\n    length:'length',\n    content_filter:'content-filter',\n    tool_calls:'tool-calls',\n    function_call:'tool-calls',\n    insufficient_system_resource:'error',\n}\n\nconst RAW_EXPOSED = new Set<FinishReason>([\n    'length',\n    'content-filter',\n    'error',\n    'unknown',\n])\n\nconst SUPPRESS_CALLS = new Set<FinishReason>([\n    'length',\n    'content-filter',\n    'error',\n])\n\nfunction validJson (s:string):boolean {\n    try {\n        JSON.parse(s)\n        return true\n    } catch {\n        return false\n    }\n}\n\n// The provider error carried by a chunk's top-level `error` member.\nfunction chunkError (value:unknown):ProviderError {\n    const e = obj(value)\n    const code = typeof e.code === 'number' ? String(e.code) : str(e.code)\n    const message = str(e.message) ||\n        (typeof value === 'string' ? value : JSON.stringify(value))\n    return streamError(str(e.type), code, message)\n}\n\n// Assembles one turn from chat.completion.chunk events (spec 06, 2.8.1).\n// Stops reading at `[DONE]`; throws the 2.10 error kinds.\nexport async function decodeChat (\n    events:AsyncIterable<SseEvent>\n):Promise<ModelTurn> {\n    const parts:AssistantPart[] = []\n    let text:{ type:'text', text:string }|null = null\n    let reasoning:{ type:'reasoning', text:string }|null = null\n    let reasoningEnded = false\n    const calls = new Map<number, OpenCall>()\n    let rawFinish = ''\n    let usage:unknown\n\n    function openReasoning ():{ type:'reasoning', text:string } {\n        if (!reasoning) {\n            reasoning = { type:'reasoning', text:'' }\n            parts.push(reasoning)\n            text = null\n        }\n        return reasoning\n    }\n\n    function onDelta (delta:Json, finish:string):void {\n        const content = str(delta.content)\n        const toolCalls = Array.isArray(delta.tool_calls) ?\n            delta.tool_calls :\n            []\n        const boundary = content !== '' ||\n            Array.isArray(delta.tool_calls) || finish !== ''\n        const field = delta.reasoning_content ?? delta.reasoning\n        const thought = str(field)\n        if (thought !== '') {\n            openReasoning().text += thought\n        } else if (typeof field === 'string' && !boundary &&\n            !reasoningEnded) {\n            openReasoning()\n        }\n        if (boundary && reasoning) {\n            reasoning = null\n            reasoningEnded = true\n        }\n        if (content !== '') {\n            if (!text) {\n                text = { type:'text', text:'' }\n                parts.push(text)\n            }\n            text.text += content\n        }\n        for (const raw of toolCalls) onToolCall(obj(raw))\n    }\n\n    function onToolCall (tc:Json):void {\n        const index = typeof tc.index === 'number' ? tc.index : 0\n        const fn = obj(tc.function)\n        const name = str(fn.name)\n        const args = str(fn.arguments)\n        const open = calls.get(index)\n        if (open) {\n            open.args += args\n            return\n        }\n        if (name === '' && args === '') return\n        const type = tc.type === undefined || tc.type === null ?\n            'function' :\n            tc.type\n        if (type !== 'function') {\n            throw protocolError(\n                `unsupported tool call type ${JSON.stringify(type)}`)\n        }\n        calls.set(index, {\n            index,\n            id:str(tc.id) || `tool-call-${index}`,\n            name,\n            args,\n        })\n    }\n\n    for await (const ev of events) {\n        if (ev.data.startsWith('[DONE]')) break\n        let chunk:Json\n        try {\n            chunk = obj(JSON.parse(ev.data))\n        } catch (err) {\n            throw protocolError('malformed chat stream event', err)\n        }\n        if ('error' in chunk) throw chunkError(chunk.error)\n        const u = obj(chunk.usage)\n        if (typeof u.total_tokens === 'number' && u.total_tokens > 0) {\n            usage = chunk.usage\n        }\n        const choices = Array.isArray(chunk.choices) ? chunk.choices : []\n        for (const raw of choices) {\n            const choice = obj(raw)\n            const finish = str(choice.finish_reason)\n            onDelta(obj(choice.delta), finish)\n            if (finish !== '') rawFinish = finish\n        }\n    }\n\n    const ordered = [...calls.values()].sort((a, b) => a.index - b.index)\n    let finishReason:FinishReason\n    if (rawFinish !== '') {\n        finishReason = Object.hasOwn(FINISH, rawFinish) ?\n            FINISH[rawFinish] :\n            'unknown'\n    } else if (ordered.length > 0) {\n        if (ordered.some(c => c.args === '' || !validJson(c.args))) {\n            throw new IncompleteStreamError()\n        }\n        finishReason = 'tool-calls'\n    } else {\n        throw new IncompleteStreamError()\n    }\n\n    const turn:ModelTurn = {\n        parts,\n        finishReason,\n        usage:normalizeUsage(chatUsage(usage)),\n    }\n    if (rawFinish !== '' && RAW_EXPOSED.has(finishReason)) {\n        turn.rawFinishReason = rawFinish\n    }\n    if (ordered.length > 0 && SUPPRESS_CALLS.has(finishReason)) {\n        turn.rawFinishReason = rawFinish\n        return turn\n    }\n    for (const c of ordered) {\n        parts.push({\n            type:'tool-call',\n            id:c.id,\n            name:c.name,\n            input:c.args === '' ? '{}' : c.args,\n        })\n    }\n    return turn\n}\n// `createModelClient` and `send` (spec 06, 3.2): one model turn becomes\n// exactly one HTTP request in the profile's protocol. Never retries.\n\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport { abortable, CaptureGate, openCapturedBody } from './capture.js'\nimport { chatUrl, decodeChat, encodeChat } from './chat.js'\nimport {\n    CaptureError,\n    EndpointError,\n    ProviderError,\n    SENTINEL_MESSAGE,\n} from './errors.js'\nimport { currentFetch, requestHeaders } from './http.js'\nimport { parseSse, type SseEvent } from './sse.js'\nimport {\n    DEFAULT_MAX_ATTEMPTS,\n    runConversation,\n    type LoopDeps,\n} from './agent.js'\nimport type { Ledger } from './ledger.js'\nimport type { Sleep } from './retry.js'\nimport type {\n    Client,\n    ClientConfig,\n    ModelRequest,\n    ModelTurn,\n    Protocol,\n    RecordUsage,\n    Usage,\n} from './types.js'\nimport { UsageAccumulator } from './usage.js'\n\nexport { DEFAULT_MAX_ATTEMPTS }\n\n// Error bodies are read at most this far (deliberate change 9).\nexport const MAX_ERROR_BODY = 32 * 1024\n\nexport interface ModelClient {\n    readonly config:Readonly<ClientConfig>;\n    // '' normalized to 'chat'.\n    readonly protocol:Protocol;\n    // <= 0 normalized to DEFAULT_MAX_ATTEMPTS.\n    readonly maxAttempts:number;\n    // One HTTP attempt. Resolves only after capture succeeded.\n    send (request:ModelRequest):Promise<ModelTurn>;\n    // Exact byte length of the request body `send` would post.\n    requestBytes (request:ModelRequest):number;\n    // Accumulated usage across all calls on this client.\n    usage ():Usage;\n}\n\ninterface Adapter {\n    url (baseUrl:string):string;\n    encode (config:ClientConfig, request:ModelRequest):unknown;\n    decode (events:AsyncIterable<SseEvent>):Promise<ModelTurn>;\n}\n\nconst ADAPTERS:Partial<Record<Protocol, Adapter>> = {\n    chat:{\n        url:chatUrl,\n        encode:(config, request) => encodeChat(config, request),\n        decode:decodeChat,\n    },\n}\n\nfunction adapterFor (protocol:string):Adapter {\n    const known = protocol === 'chat' || protocol === 'responses' ||\n        protocol === 'anthropic'\n    const adapter = known ? ADAPTERS[protocol as Protocol] : undefined\n    if (!adapter) {\n        throw new Error(`unsupported inference protocol \"${protocol}\"`)\n    }\n    return adapter\n}\n\n// Best-effort provider error fields from an OpenAI-style\n// `{\"error\":{...}}` or Anthropic `{\"type\":\"error\",\"error\":{...}}` body.\nfunction providerFields (text:string):{\n    type?:string;\n    code?:string;\n    message?:string;\n} {\n    try {\n        const parsed:unknown = JSON.parse(text)\n        if (parsed === null || typeof parsed !== 'object') return {}\n        const e = (parsed as { error?:unknown }).error\n        if (e === null || typeof e !== 'object') return {}\n        const { type, code, message } = e as Record<string, unknown>\n        return {\n            type:typeof type === 'string' ? type : undefined,\n            code:typeof code === 'string' ?\n                code :\n                typeof code === 'number' ? String(code) : undefined,\n            message:typeof message === 'string' ? message : undefined,\n        }\n    } catch {\n        return {}\n    }\n}\n\nasync function readCapped (\n    body:ReadableStream<Uint8Array>|null,\n    limit:number,\n    signal:AbortSignal\n):Promise<Uint8Array> {\n    if (!body) return new Uint8Array(0)\n    const reader = body.getReader()\n    const parts:Uint8Array[] = []\n    let size = 0\n    let eof = false\n    try {\n        while (size < limit) {\n            const r = await abortable(reader.read(), signal)\n            if (r.done) {\n                eof = true\n                break\n            }\n            const take = r.value.subarray(0, limit - size)\n            parts.push(take)\n            size += take.length\n        }\n    } finally {\n        if (!eof) await reader.cancel().catch(() => {})\n    }\n    const out = new Uint8Array(size)\n    let off = 0\n    for (const p of parts) {\n        out.set(p, off)\n        off += p.length\n    }\n    return out\n}\n\nasync function httpError (\n    response:Response,\n    url:string,\n    model:string,\n    signal:AbortSignal\n):Promise<Error> {\n    const bytes = await readCapped(response.body, MAX_ERROR_BODY, signal)\n    const text = new TextDecoder().decode(bytes)\n    const fields = providerFields(text)\n    const headers:Record<string, string> = {}\n    response.headers.forEach((value, name) => { headers[name] = value })\n    const detail = fields.message ?? text.slice(0, 512).trim()\n    const status = `${response.status} ${response.statusText}`.trim()\n    const err = new ProviderError(\n        `POST \"${url}\": ${status}${detail ? `: ${detail}` : ''}`,\n        {\n            status:response.status,\n            headers,\n            providerType:fields.type,\n            providerCode:fields.code,\n            providerMessage:fields.message,\n        })\n    if (response.status >= 300 && response.status < 400) {\n        return new EndpointError(\n            `${SENTINEL_MESSAGE.endpoint}: ${model}: redirect refused: ` +\n                err.message,\n            { cause:err, details:{ model } })\n    }\n    return err\n}\n\nexport function createModelClient (config:ClientConfig):ModelClient {\n    if (!(config.maxOutputTokens > 0)) {\n        throw new Error(`${config.model}: max output tokens must be positive`)\n    }\n    if (goTrimSpace(config.apiKey) === '') {\n        throw new Error(`${config.model}: API key is not configured`)\n    }\n    const protocol = (config.protocol === '' ?\n        'chat' :\n        config.protocol) as Protocol\n    const adapter = adapterFor(protocol)\n    const maxAttempts = config.maxAttempts > 0 ?\n        config.maxAttempts :\n        DEFAULT_MAX_ATTEMPTS\n    const gate = new CaptureGate()\n    const total = new UsageAccumulator()\n    const url = adapter.url(config.baseUrl)\n\n    function encodeBody (request:ModelRequest):Uint8Array {\n        const body = adapter.encode(config, request)\n        return new TextEncoder().encode(JSON.stringify(body))\n    }\n\n    async function attempt (\n        request:ModelRequest,\n        signal:AbortSignal\n    ):Promise<ModelTurn> {\n        const fetchFn = config.fetch ?? currentFetch()\n        const response = await fetchFn(url, {\n            method:'POST',\n            headers:requestHeaders(protocol, config.apiKey,\n                request.sessionId, config.sessionHeader),\n            body:encodeBody(request),\n            redirect:'manual',\n            signal,\n        })\n        if (response.status < 200 || response.status >= 300) {\n            throw await httpError(response, url, config.model, signal)\n        }\n        const body = await openCapturedBody(response, {\n            role:config.role,\n            protocol,\n            model:config.model,\n            captureResponse:config.captureResponse,\n        }, gate, signal)\n        let turn:ModelTurn|undefined\n        let failure:unknown\n        try {\n            turn = await adapter.decode(parseSse(body.chunks))\n        } catch (err) {\n            failure = err\n        }\n        if (turn) {\n            total.add(turn.usage)\n            request.onUsage?.(turn.usage)\n        }\n        // A capture failure here replaces any turn or error.\n        await body.release()\n        if (!turn) throw failure\n        signal.throwIfAborted()\n        return turn\n    }\n\n    return {\n        config,\n        protocol,\n        maxAttempts,\n        requestBytes (request:ModelRequest):number {\n            return encodeBody(request).length\n        },\n        usage ():Usage {\n            return total.total()\n        },\n        async send (request:ModelRequest):Promise<ModelTurn> {\n            if (gate.failure) throw gate.failure\n            request.signal.throwIfAborted()\n            const timeout = config.requestTimeoutMs > 0 ?\n                AbortSignal.timeout(config.requestTimeoutMs) :\n                undefined\n            const signal = timeout ?\n                AbortSignal.any([request.signal, timeout]) :\n                request.signal\n            try {\n                return await attempt(request, signal)\n            } catch (err) {\n                if (err instanceof CaptureError) throw err\n                if (request.signal.aborted) throw request.signal.reason\n                if (timeout?.aborted) {\n                    throw new EndpointError(\n                        `${SENTINEL_MESSAGE.endpoint}: ${config.model}: ` +\n                            'request timed out after ' +\n                            `${config.requestTimeoutMs}ms`,\n                        {\n                            cause:timeout.reason,\n                            details:{ model:config.model },\n                        })\n                }\n                throw err\n            }\n        },\n    }\n}\n\nexport interface CreateClientOptions {\n    // The run's shared ledger; none means unlimited.\n    ledger?:Ledger|null;\n    now?:() => number;\n    sleep?:Sleep;\n    sessionId?:() => string;\n}\n\nfunction recordUsage (u:Usage):RecordUsage {\n    return {\n        uncached_input_tokens:u.uncachedInputTokens,\n        cached_input_tokens:u.cachedInputTokens,\n        cache_write_tokens:u.cacheWriteTokens,\n        output_tokens:u.outputTokens,\n        calls:u.calls,\n    }\n}\n\n// The `Client` the finder and verifier call (spec 07, 3.3): both entry\n// points run the agent loop over `model`; usage accumulates across all\n// of this client's conversations.\nexport function createClient (\n    model:ModelClient,\n    opts:CreateClientOptions = {}\n):Client {\n    const total = new UsageAccumulator()\n    const deps:LoopDeps = {\n        client:model,\n        model:model.config.model,\n        maxOutputTokens:model.config.maxOutputTokens,\n        maxAttempts:model.maxAttempts > 0 ?\n            model.maxAttempts :\n            DEFAULT_MAX_ATTEMPTS,\n        ledger:opts.ledger ?? null,\n        addUsage:u => total.add(u),\n        now:opts.now,\n        sleep:opts.sleep,\n        sessionId:opts.sessionId,\n    }\n    return {\n        name:model.config.model,\n        converse (system, user, converseOpts, signal) {\n            return runConversation(deps, system, user, converseOpts, false,\n                signal)\n        },\n        completeStructured (system, user, schemaName, result, signal) {\n            return runConversation(deps, system, user, {\n                tools:[{\n                    name:schemaName,\n                    description:'Return the requested structured result.',\n                    schema:result.schema,\n                }],\n                finalTool:schemaName,\n                final:{ decode:result.decode },\n                maxTurns:1,\n            }, true, signal)\n        },\n        usage () {\n            return recordUsage(total.total())\n        },\n    }\n}\n// Model-ID rules (spec 06, 2.6).\n\nconst REASONING = /(?:^|[-.])(?:o[134]|oss)|gpt-[5-9]|codex-|computer-use/\nconst CLASSIC_CHAT = /gpt-3|gpt-4|chatgpt-|-chat/\n\n// Chat reasoning models take `max_completion_tokens` instead of\n// `max_tokens`.\nexport function isChatReasoningModel (id:string):boolean {\n    const lower = id.toLowerCase()\n    return REASONING.test(lower) && !CLASSIC_CHAT.test(lower)\n}\n\n// How the `responses` protocol sends the system prompt.\nexport function responsesSystemMode (\n    id:string\n):'system'|'developer'|'remove' {\n    if (CLASSIC_CHAT.test(id.toLowerCase())) return 'system'\n    if (id.includes('o1-mini') || id.includes('o1-preview')) return 'remove'\n    return 'developer'\n}\n\n// Models that get adaptive thinking by default on `anthropic`.\nexport function anthropicDefaultThinking (id:string):boolean {\n    return id.toLowerCase().includes('claude-mythos-preview')\n}\n// Usage normalization (spec 06, 2.9): provider fields -> disjoint\n// intermediate counts (stage 1, per protocol) -> Usage (stage 2, shared).\n// Cached tokens are subtracted exactly once (deliberate change 13).\n\nimport type { Usage } from './types.js'\n\nexport interface IntermediateUsage {\n    input:number;\n    cacheRead:number;\n    cacheWrite:number;\n    output:number;\n}\n\nfunction num (v:unknown):number {\n    return typeof v === 'number' && Number.isFinite(v) ? v : 0\n}\n\nfunction obj (v:unknown):Record<string, unknown> {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Record<string, unknown> :\n        {}\n}\n\n// Stage 1 for `chat`: the `usage` object of a completion chunk.\nexport function chatUsage (raw:unknown):IntermediateUsage {\n    const u = obj(raw)\n    const prompt = num(u.prompt_tokens)\n    const cached = num(obj(u.prompt_tokens_details).cached_tokens)\n    const output = num(u.completion_tokens)\n    const reasoning = num(obj(u.completion_tokens_details).reasoning_tokens)\n    return {\n        input:Math.max(prompt - cached, 0),\n        cacheRead:cached,\n        cacheWrite:0,\n        output:reasoning > output ? output + reasoning : output,\n    }\n}\n\n// Stage 2: clamp every count to >= 0; one call.\nexport function normalizeUsage (u:IntermediateUsage):Usage {\n    return {\n        uncachedInputTokens:Math.max(u.input, 0),\n        cachedInputTokens:Math.max(u.cacheRead, 0),\n        cacheWriteTokens:Math.max(u.cacheWrite, 0),\n        outputTokens:Math.max(u.output, 0),\n        calls:1,\n    }\n}\n\nexport function zeroUsage ():Usage {\n    return {\n        uncachedInputTokens:0,\n        cachedInputTokens:0,\n        cacheWriteTokens:0,\n        outputTokens:0,\n        calls:0,\n    }\n}\n\n// A client's running total across its calls.\nexport class UsageAccumulator {\n    private sum:Usage = zeroUsage()\n\n    add (u:Usage):void {\n        this.sum.uncachedInputTokens += u.uncachedInputTokens\n        this.sum.cachedInputTokens += u.cachedInputTokens\n        this.sum.cacheWriteTokens += u.cacheWriteTokens\n        this.sum.outputTokens += u.outputTokens\n        this.sum.calls += u.calls\n    }\n\n    total ():Usage {\n        return { ...this.sum }\n    }\n}\n// The swappable `fetch` (the TS form of Go's redirectDefaultTransport,\n// shared with login and doctor) and the Roast-controlled request headers\n// (spec 06, 2.3). Nothing here reads the environment.\n\nimport { buildInfo } from '../buildinfo.js'\nimport type { Protocol } from './types.js'\n\nlet override:typeof globalThis.fetch|undefined\n\n// Replaces the fetch every client without its own `fetch` uses (tests).\nexport function setFetch (f:typeof globalThis.fetch):void {\n    override = f\n}\n\nexport function resetFetch ():void {\n    override = undefined\n}\n\nexport function currentFetch ():typeof globalThis.fetch {\n    return override ?? globalThis.fetch\n}\n\nexport function userAgent ():string {\n    return `roast/${buildInfo.version}`\n}\n\n// Every header of one request. The session headers are set last; header\n// names are case-insensitive, so a session header spelled like another\n// header yields one header holding the session ID.\nexport function requestHeaders (\n    protocol:Protocol,\n    apiKey:string,\n    sessionId:string,\n    sessionHeader?:string\n):Headers {\n    const h = new Headers()\n    h.set('Content-Type', 'application/json')\n    h.set('Accept', 'text/event-stream')\n    if (protocol === 'anthropic') {\n        h.set('X-Api-Key', apiKey)\n        h.set('Anthropic-Version', '2023-06-01')\n    } else {\n        h.set('Authorization', `Bearer ${apiKey}`)\n    }\n    h.set('User-Agent', userAgent())\n    h.set('X-Agent-Session-Id', sessionId)\n    if (sessionHeader) h.set(sessionHeader, sessionId)\n    return h\n}\n// Protocol-neutral types for the LLM layer (spec 06, 3.1; spec 07, 3.3).\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\n\nexport interface RawResponse {\n    role:string;\n    protocol:Protocol;\n    model:string;\n    contentType:'application/json'|'text/event-stream';\n    // Exact bytes of the body: no request, no headers.\n    body:Uint8Array;\n}\n\nexport interface ClientConfig {\n    // \"finder\", \"verifier\", or a doctor check name.\n    role:string;\n    baseUrl:string;\n    apiKey:string;\n    // Sent verbatim as the body's `model`.\n    model:string;\n    // \"\" means chat.\n    protocol:''|Protocol;\n    maxOutputTokens:number;\n    // Attempts per model call; <= 0 means DEFAULT_MAX_ATTEMPTS.\n    maxAttempts:number;\n    // Per request; 0 disables.\n    requestTimeoutMs:number;\n    sessionHeader?:string;\n    captureResponse?:(raw:RawResponse) => Promise<void>|void;\n    // Overrides the module-level fetch (http.ts) for this client.\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface ToolDefinition {\n    name:string;\n    description:string;\n    // The complete caller JSON Schema.\n    schema:Record<string, unknown>;\n}\n\n// A tool the agent loop offers the model (spec 07, 3.3). The final tool\n// has no `run`.\nexport interface Tool {\n    name:string;\n    description:string;\n    schema:Record<string, unknown>;\n    run?:(args:Record<string, unknown>, signal:AbortSignal) =>\n        unknown|Promise<unknown>;\n    recordsResult?:boolean;\n}\n\nexport type AssistantPart =\n    | { type:'text', text:string }\n    | {\n        type:'reasoning';\n        text:string;\n        signature?:string;\n        redactedData?:string;\n    }\n    // `input` is the raw argument string as received.\n    | { type:'tool-call', id:string, name:string, input:string }\n\nexport interface ToolResult {\n    callId:string;\n    name:string;\n    output:string;\n    isError:boolean;\n}\n\nexport type ConversationItem =\n    | { role:'user', text:string }\n    | { role:'assistant', parts:AssistantPart[] }\n    | { role:'tool', results:ToolResult[] }\n\nexport interface Usage {\n    uncachedInputTokens:number;\n    cachedInputTokens:number;\n    cacheWriteTokens:number;\n    outputTokens:number;\n    calls:number;\n}\n\nexport interface ModelRequest {\n    system:string;\n    items:ConversationItem[];\n    tools:ToolDefinition[];\n    sessionId:string;\n    // Already composed by the agent loop (caller, deadline, timeout).\n    signal:AbortSignal;\n    onUsage?:(usage:Usage) => void;\n}\n\nexport type FinishReason =\n    'stop'|'length'|'content-filter'|'tool-calls'|'error'|'other'|'unknown'\n\nexport interface ModelTurn {\n    // Arrival order; replayed verbatim.\n    parts:AssistantPart[];\n    finishReason:FinishReason;\n    rawFinishReason?:string;\n    // Normalized, calls: 1.\n    usage:Usage;\n}\n\n// Progress report for one dispatched exploration or record call, or a\n// call to an unknown tool (spec 07, 2.10).\nexport interface TurnInfo {\n    turn:number;\n    tool:string;\n    args:Record<string, unknown>;\n}\n\n// Type validation of the final arguments (spec 07, 2.7). `decode`\n// receives the value parsed with integer preservation (unsafe integers\n// are `bigint`) and the original argument text for lexical checks, and\n// throws an Error whose message is the detail.\nexport interface FinalSpec<T> {\n    decode (value:unknown, rawText?:string):T;\n}\n\nexport interface ConverseOptions<T> {\n    // Exploration, record, and final tools, in order.\n    tools:readonly Tool[];\n    finalTool:string;\n    final:FinalSpec<T>;\n    // Turn at which the final phase starts; <= 0 means 8.\n    maxTurns?:number;\n    onTurn?:(info:TurnInfo) => void;\n    // <= 0 means 3e6.\n    inputByteCeiling?:number;\n    // Absolute time, ms since the epoch.\n    workDeadline?:number;\n    // ms; <= 0 means 90000.\n    wrapUpWindow?:number;\n    onWorkDeadline?:() => void;\n    onBudgetExhausted?:() => void;\n}\n\n// Usage as written into run records: snake_case, disjoint counts.\nexport interface RecordUsage {\n    uncached_input_tokens:number;\n    cached_input_tokens:number;\n    cache_write_tokens:number;\n    output_tokens:number;\n    calls:number;\n}\n\n// One configured model role, as the finder and verifier call it.\nexport interface Client {\n    // The request model name.\n    readonly name:string;\n    converse<T> (\n        system:string,\n        user:string,\n        opts:ConverseOptions<T>,\n        signal:AbortSignal\n    ):Promise<T>;\n    completeStructured<T> (\n        system:string,\n        user:string,\n        schemaName:string,\n        result:{ schema:Record<string, unknown>, decode:FinalSpec<T>['decode'] },\n        signal:AbortSignal\n    ):Promise<T>;\n    usage ():RecordUsage;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01KihRdyEtubeUCJojYFn91b","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
