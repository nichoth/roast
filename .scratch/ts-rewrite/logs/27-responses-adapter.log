{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLzmaSAbeydR2qqu5Wbq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Gnf85AWyktdD2HXjV1Zrxp","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-27-responses-adapter/test/diff/scenarios/m4.ts","content":"// M4 scenarios (spec 15, 2.13): the M3 review scenarios rerun with the\n// finder and verifier profiles on the `responses` protocol. Each scripted\n// chat completion is rewritten as the equivalent Responses API response;\n// HTTP error replies are unchanged.\nimport type { Reply } from '../../helpers/inference-server.js'\nimport type { ReplyTable } from '../replies.js'\nimport type { Scenario } from '../scenario.js'\nimport { M3_CASES, review } from './m3.js'\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\n// A chat completion's tool calls and usage as a Responses API response.\nexport function responsesFromChat (chat:unknown):Json {\n    const c = obj(chat)\n    const choice = obj(Array.isArray(c.choices) ? c.choices[0] : undefined)\n    const calls = obj(choice.message).tool_calls\n    const usage = obj(c.usage)\n    return {\n        id:'resp_1',\n        object:'response',\n        model:c.model,\n        status:'completed',\n        output:(Array.isArray(calls) ? calls : []).map((raw, i) => {\n            const call = obj(raw)\n            const fn = obj(call.function)\n            return {\n                type:'function_call',\n                id:`fc_${i}`,\n                call_id:call.id,\n                name:fn.name,\n                arguments:fn.arguments,\n                status:'completed',\n            }\n        }),\n        usage:{\n            input_tokens:usage.prompt_tokens,\n            output_tokens:usage.completion_tokens,\n            total_tokens:usage.total_tokens,\n        },\n    }\n}\n\nfunction toResponses (table:ReplyTable):ReplyTable {\n    const out:Record<string, Reply> = {}\n    for (const [key, reply] of Object.entries(table)) {\n        out[key] = typeof reply === 'object' && 'stream' in reply ?\n            { stream:responsesFromChat(reply.stream) } :\n            reply\n    }\n    return out\n}\n\nexport const M4_SCENARIOS:readonly Scenario[] = M3_CASES.map(c =>\n    review({ ...c, replies:toResponses(c.replies) }, 'responses'))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1485,"cache_read_input_tokens":159149,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1485},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"1f04c3de-5f7c-4cc6-8ead-62ffe5d7eb7c","timestamp":"2026-11-24T02:53:18.281Z","request_id":"req_011ChLzmaDWg5dBBD2rbctko","wire_tool_inputs":{"toolu_01Gnf85AWyktdD2HXjV1Zrxp":{"file_path":"/Users/nick/code/roast.ts-rewrite-27-responses-adapter/test/diff/scenarios/m4.ts","content":"// M4 scenarios (spec 15, 2.13): the M3 review scenarios rerun with the\n// finder and verifier profiles on the `responses` protocol. Each scripted\n// chat completion is rewritten as the equivalent Responses API response;\n// HTTP error replies are unchanged.\nimport type { Reply } from '../../helpers/inference-server.js'\nimport type { ReplyTable } from '../replies.js'\nimport type { Scenario } from '../scenario.js'\nimport { M3_CASES, review } from './m3.js'\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\n// A chat completion's tool calls and usage as a Responses API response.\nexport function responsesFromChat (chat:unknown):Json {\n    const c = obj(chat)\n    const choice = obj(Array.isArray(c.choices) ? c.choices[0] : undefined)\n    const calls = obj(choice.message).tool_calls\n    const usage = obj(c.usage)\n    return {\n        id:'resp_1',\n        object:'response',\n        model:c.model,\n        status:'completed',\n        output:(Array.isArray(calls) ? calls : []).map((raw, i) => {\n            const call = obj(raw)\n            const fn = obj(call.function)\n            return {\n                type:'function_call',\n                id:`fc_${i}`,\n                call_id:call.id,\n                name:fn.name,\n                arguments:fn.arguments,\n                status:'completed',\n            }\n        }),\n        usage:{\n            input_tokens:usage.prompt_tokens,\n            output_tokens:usage.completion_tokens,\n            total_tokens:usage.total_tokens,\n        },\n    }\n}\n\nfunction toResponses (table:ReplyTable):ReplyTable {\n    const out:Record<string, Reply> = {}\n    for (const [key, reply] of Object.entries(table)) {\n        out[key] = typeof reply === 'object' && 'stream' in reply ?\n            { stream:responsesFromChat(reply.stream) } :\n            reply\n    }\n    return out\n}\n\nexport const M4_SCENARIOS:readonly Scenario[] = M3_CASES.map(c =>\n    review({ ...c, replies:toResponses(c.replies) }, 'responses'))\n"}}}
