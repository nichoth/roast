{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hs3BhA6yjv9wwwu4WZ8xkS","type":"tool_result","content":"// pattern: Imperative Shell\n// Chat fake that requires automatic choice and a stable probe prefix.\nimport type { RecordedRequest, Reply, Script }\n    from './inference-server.js'\n\nexport function probeCall (name:string, args:unknown):Reply {\n    return {\n        stream:{\n            choices:[{\n                index:0,\n                message:{\n                    role:'assistant',\n                    tool_calls:[{\n                        id:'doctor-call',\n                        type:'function',\n                        function:{ name, arguments:JSON.stringify(args) },\n                    }]\n                },\n                finish_reason:'tool_calls',\n            }],\n        }\n    }\n}\n\nexport function doctorProbe ():Script {\n    const prefixes = new Map<string, { messages:unknown[], tools:unknown }>()\n    return (req:RecordedRequest) => {\n        const body = req.body as {\n            messages:Record<string, unknown>[],\n            tools:unknown,\n            tool_choice?:unknown,\n        }\n        if (body.tool_choice !== undefined && body.tool_choice !== 'auto') {\n            return { status:400, body:'forced tool choice' }\n        }\n        const messages = body.messages\n        const result = messages.find(m => m.role === 'tool')\n        const key = String(req.headers.authorization)\n        if (!result) {\n            prefixes.set(key, { messages, tools:body.tools })\n            return probeCall('doctor_lookup', {})\n        }\n        const prefix = prefixes.get(key)\n        if (!prefix || JSON.stringify(body.tools) !==\n            JSON.stringify(prefix.tools) ||\n            JSON.stringify(messages.slice(0, prefix.messages.length)) !==\n            JSON.stringify(prefix.messages)) {\n            return { status:400, body:'changed conversation prefix' }\n        }\n        const token = JSON.parse(String(result.content)).token\n        return probeCall('doctor_probe', { ok:true, token })\n    }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"222aa46f-f8de-49a4-882d-c1ded6ee48df","timestamp":"2026-11-24T02:50:24.909Z","tool_use_result":{"stdout":"// pattern: Imperative Shell\n// Chat fake that requires automatic choice and a stable probe prefix.\nimport type { RecordedRequest, Reply, Script }\n    from './inference-server.js'\n\nexport function probeCall (name:string, args:unknown):Reply {\n    return {\n        stream:{\n            choices:[{\n                index:0,\n                message:{\n                    role:'assistant',\n                    tool_calls:[{\n                        id:'doctor-call',\n                        type:'function',\n                        function:{ name, arguments:JSON.stringify(args) },\n                    }]\n                },\n                finish_reason:'tool_calls',\n            }],\n        }\n    }\n}\n\nexport function doctorProbe ():Script {\n    const prefixes = new Map<string, { messages:unknown[], tools:unknown }>()\n    return (req:RecordedRequest) => {\n        const body = req.body as {\n            messages:Record<string, unknown>[],\n            tools:unknown,\n            tool_choice?:unknown,\n        }\n        if (body.tool_choice !== undefined && body.tool_choice !== 'auto') {\n            return { status:400, body:'forced tool choice' }\n        }\n        const messages = body.messages\n        const result = messages.find(m => m.role === 'tool')\n        const key = String(req.headers.authorization)\n        if (!result) {\n            prefixes.set(key, { messages, tools:body.tools })\n            return probeCall('doctor_lookup', {})\n        }\n        const prefix = prefixes.get(key)\n        if (!prefix || JSON.stringify(body.tools) !==\n            JSON.stringify(prefix.tools) ||\n            JSON.stringify(messages.slice(0, prefix.messages.length)) !==\n            JSON.stringify(prefix.messages)) {\n            return { status:400, body:'changed conversation prefix' }\n        }\n        const token = JSON.parse(String(result.content)).token\n        return probeCall('doctor_probe', { ok:true, token })\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Hs3BhA6yjv9wwwu4WZ8xkS","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
