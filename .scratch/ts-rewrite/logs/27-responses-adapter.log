   t.equal(u(80).cachedInputTokens, 80, 'cached 80 cached')\n    t.equal(u(120).uncachedInputTokens, 0, 'cached over prompt clamps')\n})\n\ntest('chat usage counts reasoning tokens above output', t => {\n    const out = (o:number, r:number) => normalizeUsage(chatUsage({\n        prompt_tokens:1,\n        completion_tokens:o,\n        completion_tokens_details:{ reasoning_tokens:r },\n    })).outputTokens\n    t.equal(out(10, 4), 10, 'reasoning included in output')\n    t.equal(out(4, 10), 14, 'reasoning above output is added')\n    t.deepEqual(normalizeUsage(chatUsage(undefined)), {\n        uncachedInputTokens:0,\n        cachedInputTokens:0,\n        cacheWriteTokens:0,\n        outputTokens:0,\n        calls:1,\n    }, 'missing usage is zero')\n})\n\ntest('stage 2 is the identity on disjoint counts', t => {\n    t.deepEqual(normalizeUsage({\n43:import './llm/sse.js'\n44:import './llm/json.js'\n45:import './llm/errors.js'\n46:import './llm/usage.js'\n47:import './llm/chat-encode.js'\n48:import './llm/chat-decode.js'\n49:import './llm/capture.js'\n50:import './llm/client.js'\n51:import './llm/ledger.js'\n52:import './llm/agent-finalization.js'\n53:import './llm/agent-deadline.js'\n54:import './llm/agent-dispatch.js'\n55:import './llm/agent-http.js'","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01V2ii2MMCUkuaZcuDFakDum","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
