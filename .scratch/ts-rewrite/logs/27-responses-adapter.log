{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014wcUtWGGdZ8fLH7zdco8vi","type":"tool_result","content":"// Fixtures for end-to-end review tests (Go settingsRepo, loginRepo):\n// a temporary Git repository with a committed file and an uncommitted\n// change, a project config pointing at a fake chat server, and helpers\n// that read the run record a review wrote.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { gunzipSync } from 'node:zlib'\nimport type { CleanupTest } from './test.js'\nimport { tempRepo, type TempDir } from './repo.js'\nimport { runRoast, type RunRoastResult } from './run.js'\nimport {\n    type InferenceServer,\n    type RecordedRequest,\n    type Script,\n    startInferenceServer,\n} from './inference-server.js'\n\nexport const FINDER_KEY = 'finder-secret-key-do-not-print'\nexport const VERIFIER_KEY = 'verifier-secret-key-do-not-print'\n\nexport interface ReviewRepo extends TempDir {\n    server:InferenceServer;\n    // Runs roast in the repository against the fake server.\n    roast (args:string[], opts?:{\n        cwd?:string,\n        stdin?:string|NodeJS.ReadableStream,\n        signal?:AbortSignal,\n    }):Promise<RunRoastResult>;\n}\n\nexport function gitIn (r:TempDir, args:string[], cwd = r.dir):string {\n    return execFileSync('git', args, { cwd, env:r.env }).toString()\n}\n\nexport type Wire = {\n    severity:string;\n    confidence:number;\n    file:string;\n    lines:number[];\n    code_quote:string;\n    fixed_code:string;\n    description:string;\n    reasoning:string;\n    cwe:string;\n    frontend_category:string;\n}\n\nexport function finding (over:Partial<Wire> = {}):Wire {\n    return {\n        reasoning:'The guard is missing.',\n        severity:'HIGH',\n        confidence:0.9,\n        cwe:'',\n        description:'Missing guard',\n        file:'main.go',\n        lines:[3],\n        code_quote:'return value',\n        fixed_code:'return value + 1',\n        frontend_category:'',\n        ...over,\n    }\n}\n\ntype Call = { name:string, args:unknown }\n\n// A chat completion whose single choice calls `calls`.\nexport function chatCalls (calls:Call[], model = 'finder-model') {\n    return {\n        id:'c1',\n        model,\n        choices:[{\n            index:0,\n            finish_reason:calls.length ? 'tool_calls' : 'stop',\n            message:{\n                role:'assistant',\n                content:calls.length ? '' : 'done',\n                tool_calls:calls.map((c, i) => ({\n                    id:`call-${i}`,\n                    type:'function',\n                    function:{\n                        name:c.name, arguments:JSON.stringify(c.args),\n                    },\n                })),\n            },\n        }],\n        usage:{ prompt_tokens:100, completion_tokens:20, total_tokens:120 },\n    }\n}\n\n// The structured finder answer (one `findings` tool call).\nexport function findingsReply (findings:Wire[] = []) {\n    return {\n        stream:chatCalls([{\n            name:'findings',\n            args:{\n                assessment:findings.length ?\n                    'FINDINGS_PRESENT' :\n                    'NO_FINDINGS',\n                findings,\n            },\n        }]),\n    }\n}\n\n// The name of the final tool a chat request offers ('findings' for a\n// structured call, 'submit_findings' for an interactive one).\nexport function toolNames (req:RecordedRequest):string[] {\n    const body = req.body as { tools?:{ function:{ name:string } }[] }\n    return (body?.tools ?? []).map(t => t.function.name)\n}\n\n// A finder that answers every structured call with `findings`.\nexport function finderScript (findings:Wire[] = []):Script {\n    return () => findingsReply(findings)\n}\n\nexport function profileConfig (url:string, over:object = {}) {\n    return {\n        version:1,\n        inference_profiles:{\n            fake:{\n                model:'finder-model',\n                endpoint:`${url}/v1`,\n                protocol:'chat',\n                api_key_env:'ROAST_FINDER_API_KEY',\n                max_output_tokens:4096,\n            },\n        },\n        roles:{ finder:{ profile:'fake' }, verifier:{ profile:'fake' } },\n        review:{ snapshot:false },\n        ...over,\n    }\n}\n\nexport function writeConfig (dir:string, cfg:object, name = '.roast.json') {\n    fs.mkdirSync(dir, { recursive:true })\n    fs.writeFileSync(path.join(dir, name), JSON.stringify(cfg, null, 2))\n}\n\nconst ORIGINAL = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\treturn value\\n}\\n'\nconst CHANGED = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\tif value < 0 {\\n\\t\\treturn 0\\n\\t}\\n\\treturn value\\n}\\n'\n\n// Go settingsRepo: a repository with one commit and an uncommitted\n// change to main.go, a config on a fake chat server, and finder and\n// verifier keys in the environment. The process chdirs into the\n// repository so nothing leaks into this checkout.\nexport async function settingsRepo (\n    t:CleanupTest,\n    script:Script = finderScript(),\n    opts:{ config?:object|null, approve?:boolean } = {}\n):Promise<ReviewRepo> {\n    const r = tempRepo('roast-review-')\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    const server = await startInferenceServer(script)\n    t.cleanup(() => server.close())\n    r.env.ROAST_FINDER_API_KEY = FINDER_KEY\n    r.env.ROAST_VERIFIER_API_KEY = VERIFIER_KEY\n    fs.writeFileSync(path.join(r.dir, 'main.go'), ORIGINAL)\n    gitIn(r, ['add', 'main.go'])\n    gitIn(r, ['commit', '-q', '-m', 'initial'])\n    fs.writeFileSync(path.join(r.dir, 'main.go'), CHANGED)\n    if (opts.config !== null) {\n        writeConfig(r.dir, opts.config ?? profileConfig(server.url))\n    }\n    const repo:ReviewRepo = {\n        ...r,\n        server,\n        roast:(args, o = {}) => runRoast(args, {\n            cwd:o.cwd ?? r.dir,\n            env:r.env,\n            stdin:o.stdin,\n            signal:o.signal,\n            redirectTo:server.url,\n        }),\n    }\n    if (opts.approve !== false && opts.config !== null) {\n        await approveProjectConfig(repo)\n    }\n    return repo\n}\n\n// `roast trust --yes` for the discovered (or given) config.\nexport async function approveProjectConfig (\n    r:ReviewRepo,\n    args:string[] = [],\n    cwd = r.dir\n):Promise<void> {\n    const res = await runRoast(['trust', '--yes', ...args],\n        { cwd, env:r.env })\n    if (res.code !== 0) throw new Error(`trust failed: ${res.stderr}`)\n}\n\n// Inference requests the fake server received (it serves nothing else).\nexport function requestRecorder (r:ReviewRepo):() => RecordedRequest[] {\nreview-config.ts\nreview-errors.ts\nreview-flags.ts\nreview-records.ts\nreview-snapshot.ts\nreview-survey.ts\nreview-trust.ts\nreview-units.ts\nreview-verify.ts\nreview.ts","is_error":false}]},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"ceded9df-aa95-470a-a023-fae3f1abe5d6","timestamp":"2026-11-24T02:47:03.464Z","tool_use_result":{"stdout":"// Fixtures for end-to-end review tests (Go settingsRepo, loginRepo):\n// a temporary Git repository with a committed file and an uncommitted\n// change, a project config pointing at a fake chat server, and helpers\n// that read the run record a review wrote.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { gunzipSync } from 'node:zlib'\nimport type { CleanupTest } from './test.js'\nimport { tempRepo, type TempDir } from './repo.js'\nimport { runRoast, type RunRoastResult } from './run.js'\nimport {\n    type InferenceServer,\n    type RecordedRequest,\n    type Script,\n    startInferenceServer,\n} from './inference-server.js'\n\nexport const FINDER_KEY = 'finder-secret-key-do-not-print'\nexport const VERIFIER_KEY = 'verifier-secret-key-do-not-print'\n\nexport interface ReviewRepo extends TempDir {\n    server:InferenceServer;\n    // Runs roast in the repository against the fake server.\n    roast (args:string[], opts?:{\n        cwd?:string,\n        stdin?:string|NodeJS.ReadableStream,\n        signal?:AbortSignal,\n    }):Promise<RunRoastResult>;\n}\n\nexport function gitIn (r:TempDir, args:string[], cwd = r.dir):string {\n    return execFileSync('git', args, { cwd, env:r.env }).toString()\n}\n\nexport type Wire = {\n    severity:string;\n    confidence:number;\n    file:string;\n    lines:number[];\n    code_quote:string;\n    fixed_code:string;\n    description:string;\n    reasoning:string;\n    cwe:string;\n    frontend_category:string;\n}\n\nexport function finding (over:Partial<Wire> = {}):Wire {\n    return {\n        reasoning:'The guard is missing.',\n        severity:'HIGH',\n        confidence:0.9,\n        cwe:'',\n        description:'Missing guard',\n        file:'main.go',\n        lines:[3],\n        code_quote:'return value',\n        fixed_code:'return value + 1',\n        frontend_category:'',\n        ...over,\n    }\n}\n\ntype Call = { name:string, args:unknown }\n\n// A chat completion whose single choice calls `calls`.\nexport function chatCalls (calls:Call[], model = 'finder-model') {\n    return {\n        id:'c1',\n        model,\n        choices:[{\n            index:0,\n            finish_reason:calls.length ? 'tool_calls' : 'stop',\n            message:{\n                role:'assistant',\n                content:calls.length ? '' : 'done',\n                tool_calls:calls.map((c, i) => ({\n                    id:`call-${i}`,\n                    type:'function',\n                    function:{\n                        name:c.name, arguments:JSON.stringify(c.args),\n                    },\n                })),\n            },\n        }],\n        usage:{ prompt_tokens:100, completion_tokens:20, total_tokens:120 },\n    }\n}\n\n// The structured finder answer (one `findings` tool call).\nexport function findingsReply (findings:Wire[] = []) {\n    return {\n        stream:chatCalls([{\n            name:'findings',\n            args:{\n                assessment:findings.length ?\n                    'FINDINGS_PRESENT' :\n                    'NO_FINDINGS',\n                findings,\n            },\n        }]),\n    }\n}\n\n// The name of the final tool a chat request offers ('findings' for a\n// structured call, 'submit_findings' for an interactive one).\nexport function toolNames (req:RecordedRequest):string[] {\n    const body = req.body as { tools?:{ function:{ name:string } }[] }\n    return (body?.tools ?? []).map(t => t.function.name)\n}\n\n// A finder that answers every structured call with `findings`.\nexport function finderScript (findings:Wire[] = []):Script {\n    return () => findingsReply(findings)\n}\n\nexport function profileConfig (url:string, over:object = {}) {\n    return {\n        version:1,\n        inference_profiles:{\n            fake:{\n                model:'finder-model',\n                endpoint:`${url}/v1`,\n                protocol:'chat',\n                api_key_env:'ROAST_FINDER_API_KEY',\n                max_output_tokens:4096,\n            },\n        },\n        roles:{ finder:{ profile:'fake' }, verifier:{ profile:'fake' } },\n        review:{ snapshot:false },\n        ...over,\n    }\n}\n\nexport function writeConfig (dir:string, cfg:object, name = '.roast.json') {\n    fs.mkdirSync(dir, { recursive:true })\n    fs.writeFileSync(path.join(dir, name), JSON.stringify(cfg, null, 2))\n}\n\nconst ORIGINAL = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\treturn value\\n}\\n'\nconst CHANGED = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\tif value < 0 {\\n\\t\\treturn 0\\n\\t}\\n\\treturn value\\n}\\n'\n\n// Go settingsRepo: a repository with one commit and an uncommitted\n// change to main.go, a config on a fake chat server, and finder and\n// verifier keys in the environment. The process chdirs into the\n// repository so nothing leaks into this checkout.\nexport async function settingsRepo (\n    t:CleanupTest,\n    script:Script = finderScript(),\n    opts:{ config?:object|null, approve?:boolean } = {}\n):Promise<ReviewRepo> {\n    const r = tempRepo('roast-review-')\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    const server = await startInferenceServer(script)\n    t.cleanup(() => server.close())\n    r.env.ROAST_FINDER_API_KEY = FINDER_KEY\n    r.env.ROAST_VERIFIER_API_KEY = VERIFIER_KEY\n    fs.writeFileSync(path.join(r.dir, 'main.go'), ORIGINAL)\n    gitIn(r, ['add', 'main.go'])\n    gitIn(r, ['commit', '-q', '-m', 'initial'])\n    fs.writeFileSync(path.join(r.dir, 'main.go'), CHANGED)\n    if (opts.config !== null) {\n        writeConfig(r.dir, opts.config ?? profileConfig(server.url))\n    }\n    const repo:ReviewRepo = {\n        ...r,\n        server,\n        roast:(args, o = {}) => runRoast(args, {\n            cwd:o.cwd ?? r.dir,\n            env:r.env,\n            stdin:o.stdin,\n            signal:o.signal,\n            redirectTo:server.url,\n        }),\n    }\n    if (opts.approve !== false && opts.config !== null) {\n        await approveProjectConfig(repo)\n    }\n    return repo\n}\n\n// `roast trust --yes` for the discovered (or given) config.\nexport async function approveProjectConfig (\n    r:ReviewRepo,\n    args:string[] = [],\n    cwd = r.dir\n):Promise<void> {\n    const res = await runRoast(['trust', '--yes', ...args],\n        { cwd, env:r.env })\n    if (res.code !== 0) throw new Error(`trust failed: ${res.stderr}`)\n}\n\n// Inference requests the fake server received (it serves nothing else).\nexport function requestRecorder (r:ReviewRepo):() => RecordedRequest[] {\nreview-config.ts\nreview-errors.ts\nreview-flags.ts\nreview-records.ts\nreview-snapshot.ts\nreview-survey.ts\nreview-trust.ts\nreview-units.ts\nreview-verify.ts\nreview.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014wcUtWGGdZ8fLH7zdco8vi","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLzJUDrUe4FRpHaCwLnM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PiQYPm8z5PHdM9QUJNSYeL","name":"Bash","input":{"command":"sed -n 200,300p test/helpers/review.ts; sed -n 1,80p test/cli/review.ts; grep -n \"^test(\" test/cli/review*.ts | head -60"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2812,"cache_read_input_tokens":89108,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2812},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"ab7c773d-9ee0-46e4-b94f-bcfe4a449861","timestamp":"2026-11-24T02:47:05.304Z","request_id":"req_011ChLzJU3BnWK3mHNUqtDmy","wire_tool_inputs":{"toolu_01PiQYPm8z5PHdM9QUJNSYeL":{"command":"sed -n 200,300p test/helpers/review.ts; sed -n 1,80p test/cli/review.ts; grep -n \"^test(\" test/cli/review*.ts | head -60"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PiQYPm8z5PHdM9QUJNSYeL","type":"tool_result","content":"export function requestRecorder (r:ReviewRepo):() => RecordedRequest[] {\n    const start = r.server.requests.length\n    return () => r.server.requests.slice(start)\n}\n\nexport function runsDir (r:TempDir):string {\n    return path.join(r.dir, '.roast', 'runs')\n}\n\n// The run directories a review wrote, sorted.\nexport function runDirs (r:TempDir):string[] {\n    const dir = runsDir(r)\n    if (!fs.existsSync(dir)) return []\n    return fs.readdirSync(dir, { withFileTypes:true })\n        .filter(e => e.isDirectory())\n        .map(e => path.join(dir, e.name))\n        .sort()\n}\n\n// The parsed meta.json of the only run.\nexport function reviewMeta (r:TempDir):Record<string, any> {\n    const dirs = runDirs(r)\n    if (dirs.length !== 1) {\n        throw new Error(`expected one run, found ${dirs.length}`)\n    }\n    return JSON.parse(fs.readFileSync(path.join(dirs[0], 'meta.json'),\n        'utf8'))\n}\n\nexport function readGz (file:string):string {\n    return gunzipSync(fs.readFileSync(file)).toString('utf8')\n}\n\n// Every file under `dir`, recursively.\nexport function filesUnder (dir:string):string[] {\n    if (!fs.existsSync(dir)) return []\n    return fs.readdirSync(dir, { withFileTypes:true, recursive:true })\n        .filter(e => e.isFile())\n        .map(e => path.join(e.parentPath, e.name))\n}\n// `roast review` end to end on a fake `chat` server (spec 01, 2.8 and\n// section 5 \"Pipeline\").\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport {\n    FINDER_KEY,\n    filesUnder,\n    finderScript,\n    finding,\n    readGz,\n    requestRecorder,\n    reviewMeta,\n    runDirs,\n    runsDir,\n    settingsRepo,\n} from '../helpers/review.js'\nimport { verifyBundle } from '../../src/runbundle/bundle.js'\n\ntest('review --no-verify exits 0 with no findings', async t => {\n    const r = await settingsRepo(t)\n    const requests = requestRecorder(r)\n    const res = await r.roast(['review', '--no-verify', '--format', 'json'])\n    t.equal(res.code, 0, res.stderr)\n    const lines = res.stdout.trimEnd().split('\\n')\n    t.equal(lines.length, 1, 'one JSON line')\n    const report = JSON.parse(lines[0])\n    t.deepEqual(report.findings, [], 'no findings')\n    t.equal(requests().length, 1, 'one structured finder call')\n})\n\ntest('review gates on --max-severity with a HIGH finding', async t => {\n    const r = await settingsRepo(t, finderScript([finding()]))\n    const res = await r.roast(['--no-verify', '--format', 'json',\n        '--max-severity', 'HIGH'])\n    t.equal(res.code, 1, res.stderr)\n    const report = JSON.parse(res.stdout)\n    t.equal(report.findings.length, 1, 'finding reported')\n    t.equal(report.findings[0].severity, 'HIGH', 'severity')\n    t.equal(report.findings[0].file, 'main.go', 'file')\n    const lower = await r.roast(['review', '--no-verify', '--format',\n        'json', '--max-severity', 'critical'])\n    t.equal(lower.code, 0, 'below the threshold exits 0')\n})\n\ntest('review writes a complete run record', async t => {\n    const r = await settingsRepo(t, finderScript([finding()]))\n    const res = await r.roast(['review', '--no-verify', '--format', 'json'])\n    t.equal(res.code, 0, res.stderr)\n    const dirs = runDirs(r)\n    t.equal(dirs.length, 1, 'one run directory')\n    const run = dirs[0]\n    for (const name of ['meta.json', 'input.gz', 'finder_system.gz',\n        'finder_user.gz', 'verifier_system.gz', 'provider-responses.jsonl',\n        'result.json.gz', 'report.md', 'bundle.tar.zst']) {\n        t.ok(fs.existsSync(path.join(run, name)), `${name} written`)\n    }\n    const responses = fs.readFileSync(\n        path.join(run, 'provider-responses.jsonl'), 'utf8')\n        .trimEnd().split('\\n').map(l => JSON.parse(l))\n    t.equal(responses.length, 1, 'one line per finder call')\n    t.equal(responses[0].role, 'finder', 'finder response')\n    const result = JSON.parse(readGz(path.join(run, 'result.json.gz')))\n    t.equal(result.findings.length, 1, 'result artifact holds the finding')\n    t.equal(result.run_id, path.basename(run), 'result names the run')\n    await verifyBundle(path.join(run, 'bundle.tar.zst'))\n    t.ok(true, 'bundle verifies')\n    const index = fs.readdirSync(runsDir(r))\n        .filter(n => n.startsWith('runs-') && n.endsWith('.jsonl'))\n    t.equal(index.length, 1, 'monthly index file')\n    const lines = fs.readFileSync(path.join(runsDir(r), index[0]), 'utf8')\n        .trimEnd().split('\\n')\n    t.equal(lines.length, 1, 'index gains one line')\n    const meta = reviewMeta(r)\n    t.equal(meta.run_id, path.basename(run), 'meta run id')\n    t.equal(meta.roles.finder.protocol, 'chat', 'finder protocol')\n    t.equal(meta.roles.finder.profile, 'fake', 'finder profile')\n    t.equal(meta.roles.finder.model, 'finder-model', 'finder model')\n    t.deepEqual(meta.argv, ['review', '--no-verify', '--format', 'json'],\n        'argv recorded')\ntest/cli/review-errors.ts:34:test('a provider 401 exits 3 with category auth', async t => {\ntest/cli/review-errors.ts:46:test('a provider 500 after retries exits 4 with category endpoint',\ntest/cli/review-errors.ts:74:test('aborting io.signal during the finder exits 5', async t => {\ntest/cli/review-errors.ts:130:test('the built CLI: one SIGINT during the finder exits 5', async t => {\ntest/cli/review-errors.ts:167:test('the built CLI: a second SIGINT exits 130', async t => {\ntest/cli/review-config.ts:32:test('a JSONC config with comments is used', async t => {\ntest/cli/review-config.ts:45:test('the nearest config below the toplevel wins; --config overrides',\ntest/cli/review-config.ts:65:test('invalid and missing configs are usage errors', async t => {\ntest/cli/review-config.ts:79:test('the user config directory is never read', async t => {\ntest/cli/review-config.ts:97:test('prompt overrides resolve against the config directory', async t => {\ntest/cli/review-config.ts:117:test('review outside Git: explicit fails, bare shows help', async t => {\ntest/cli/review-config.ts:131:test('--author-model flips the finder per author routes', async t => {\ntest/cli/review-config.ts:154:test('removed environment variables change nothing', async t => {\ntest/cli/review-survey.ts:38:test('survey sends the manifest with exploration tools', async t => {\ntest/cli/review-survey.ts:63:test('survey honors --max-turns', async t => {\ntest/cli/review-survey.ts:70:test('a converged clean survey is complete', async t => {\ntest/cli/review-survey.ts:82:test('a survey cut off by the token budget is partial', async t => {\ntest/cli/review-survey.ts:92:test('a diff review carries no survey fields', async t => {\ntest/cli/review-survey.ts:104:test('survey of a repository with no commits is NO_DIFF', async t => {\ntest/cli/review-flags.ts:26:test('raw flag validation fails before config and requests', async t => {\ntest/cli/review-flags.ts:61:test('json error output for an invalid --format', async t => {\ntest/cli/review-flags.ts:72:test('list flags append across occurrences', async t => {\ntest/cli/review-flags.ts:87:test('--quick false is read as false', async t => {\ntest/cli/review-flags.ts:97:test('empty diff exits 0 with NO_DIFF and no run', async t => {\ntest/cli/review-flags.ts:114:test('invalid --mode or --lang on a real diff exits 2', async t => {\ntest/cli/review.ts:20:test('review --no-verify exits 0 with no findings', async t => {\ntest/cli/review.ts:32:test('review gates on --max-severity with a HIGH finding', async t => {\ntest/cli/review.ts:46:test('review writes a complete run record', async t => {\ntest/cli/review-trust.ts:34:test('an untrusted config fails closed before any request', async t => {\ntest/cli/review-trust.ts:43:test('legacy and malformed trust records send nothing', async t => {\ntest/cli/review-trust.ts:55:test('a built-in-only config reviews without trust state', async t => {\ntest/cli/review-trust.ts:71:test('the inline trust prompt approves on y and declines otherwise',\ntest/cli/review-trust.ts:89:test('without terminals the review never reads stdin', async t => {\ntest/cli/review-trust.ts:121:test('stored keys: env beats project beats user', async t => {\ntest/cli/review-trust.ts:143:test('a stored key never reaches a custom endpoint', async t => {\ntest/cli/review-trust.ts:161:test('a changed --finder-base-url withholds the ambient key', async t => {\ntest/cli/review-trust.ts:170:test('a readable credentials file fails the review', async t => {\ntest/cli/review-records.ts:43:test('meta budgets with every budget flag at 0', async t => {\ntest/cli/review-records.ts:66:test('config limits apply; flags override for one invocation', async t => {\ntest/cli/review-records.ts:107:test('the session header is sent only by its profile', async t => {\ntest/cli/review-records.ts:131:test('records land under the toplevel from a subdirectory', async t => {\ntest/cli/review-records.ts:146:test('limits.max_diff_bytes truncates the diff sent', async t => {\ntest/cli/review-records.ts:166:test('limits.max_prompt_bytes too small exits 2 before sending', async t => {\ntest/cli/review-records.ts:176:test('a small diff downgrades --interactive; zero thresholds keep it',\ntest/cli/review-records.ts:206:test('review.snapshot false records the disabled snapshot', async t => {\ntest/cli/review-records.ts:216:test('format destinations', async t => {\ntest/cli/review-records.ts:230:test('an incomplete finder result exits 4 after recording', async t => {\ntest/cli/review-snapshot.ts:44:test('the default config captures a snapshot with a ref', async t => {\ntest/cli/review-snapshot.ts:68:test('diff_pair follows the scope', async t => {\ntest/cli/review-snapshot.ts:102:test('an untracked denylisted file is excluded with a caveat', async t => {\ntest/cli/review-snapshot.ts:114:test('ROAST_SNAPSHOT=0 does not disable capture', async t => {\ntest/cli/review-snapshot.ts:153:test('with review.snapshot false the review reads the pinned tree',\ntest/cli/review-snapshot.ts:168:test('with no HEAD the review reads the pinned tree', async t => {\ntest/cli/review-snapshot.ts:186:test('a usage error after capture leaves no snapshot ref', async t => {\ntest/cli/review-snapshot.ts:201:test('a finder failure after run-record init keeps the ref', async t => {\ntest/cli/review-units.ts:20:test('a finalize failure wins over the severity gate', t => {\ntest/cli/review-units.ts:37:test('resolveLangs', t => {\ntest/cli/review-units.ts:55:test('flag -> config -> default resolution', t => {\ntest/cli/review-units.ts:97:test('captureSnapshot: disabled branch', async t => {\ntest/cli/review-units.ts:108:test('captureSnapshot: failure and diff pairs', async t => {","is_error":false}]},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"8ca88ec3-68ae-446f-ba6a-32a9989a76ce","timestamp":"2026-11-24T02:47:05.630Z","tool_use_result":{"stdout":"export function requestRecorder (r:ReviewRepo):() => RecordedRequest[] {\n    const start = r.server.requests.length\n    return () => r.server.requests.slice(start)\n}\n\nexport function runsDir (r:TempDir):string {\n    return path.join(r.dir, '.roast', 'runs')\n}\n\n// The run directories a review wrote, sorted.\nexport function runDirs (r:TempDir):string[] {\n    const dir = runsDir(r)\n    if (!fs.existsSync(dir)) return []\n    return fs.readdirSync(dir, { withFileTypes:true })\n        .filter(e => e.isDirectory())\n        .map(e => path.join(dir, e.name))\n        .sort()\n}\n\n// The parsed meta.json of the only run.\nexport function reviewMeta (r:TempDir):Record<string, any> {\n    const dirs = runDirs(r)\n    if (dirs.length !== 1) {\n        throw new Error(`expected one run, found ${dirs.length}`)\n    }\n    return JSON.parse(fs.readFileSync(path.join(dirs[0], 'meta.json'),\n        'utf8'))\n}\n\nexport function readGz (file:string):string {\n    return gunzipSync(fs.readFileSync(file)).toString('utf8')\n}\n\n// Every file under `dir`, recursively.\nexport function filesUnder (dir:string):string[] {\n    if (!fs.existsSync(dir)) return []\n    return fs.readdirSync(dir, { withFileTypes:true, recursive:true })\n        .filter(e => e.isFile())\n        .map(e => path.join(e.parentPath, e.name))\n}\n// `roast review` end to end on a fake `chat` server (spec 01, 2.8 and\n// section 5 \"Pipeline\").\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport {\n    FINDER_KEY,\n    filesUnder,\n    finderScript,\n    finding,\n    readGz,\n    requestRecorder,\n    reviewMeta,\n    runDirs,\n    runsDir,\n    settingsRepo,\n} from '../helpers/review.js'\nimport { verifyBundle } from '../../src/runbundle/bundle.js'\n\ntest('review --no-verify exits 0 with no findings', async t => {\n    const r = await settingsRepo(t)\n    const requests = requestRecorder(r)\n    const res = await r.roast(['review', '--no-verify', '--format', 'json'])\n    t.equal(res.code, 0, res.stderr)\n    const lines = res.stdout.trimEnd().split('\\n')\n    t.equal(lines.length, 1, 'one JSON line')\n    const report = JSON.parse(lines[0])\n    t.deepEqual(report.findings, [], 'no findings')\n    t.equal(requests().length, 1, 'one structured finder call')\n})\n\ntest('review gates on --max-severity with a HIGH finding', async t => {\n    const r = await settingsRepo(t, finderScript([finding()]))\n    const res = await r.roast(['--no-verify', '--format', 'json',\n        '--max-severity', 'HIGH'])\n    t.equal(res.code, 1, res.stderr)\n    const report = JSON.parse(res.stdout)\n    t.equal(report.findings.length, 1, 'finding reported')\n    t.equal(report.findings[0].severity, 'HIGH', 'severity')\n    t.equal(report.findings[0].file, 'main.go', 'file')\n    const lower = await r.roast(['review', '--no-verify', '--format',\n        'json', '--max-severity', 'critical'])\n    t.equal(lower.code, 0, 'below the threshold exits 0')\n})\n\ntest('review writes a complete run record', async t => {\n    const r = await settingsRepo(t, finderScript([finding()]))\n    const res = await r.roast(['review', '--no-verify', '--format', 'json'])\n    t.equal(res.code, 0, res.stderr)\n    const dirs = runDirs(r)\n    t.equal(dirs.length, 1, 'one run directory')\n    const run = dirs[0]\n    for (const name of ['meta.json', 'input.gz', 'finder_system.gz',\n        'finder_user.gz', 'verifier_system.gz', 'provider-responses.jsonl',\n        'result.json.gz', 'report.md', 'bundle.tar.zst']) {\n        t.ok(fs.existsSync(path.join(run, name)), `${name} written`)\n    }\n    const responses = fs.readFileSync(\n        path.join(run, 'provider-responses.jsonl'), 'utf8')\n        .trimEnd().split('\\n').map(l => JSON.parse(l))\n    t.equal(responses.length, 1, 'one line per finder call')\n    t.equal(responses[0].role, 'finder', 'finder response')\n    const result = JSON.parse(readGz(path.join(run, 'result.json.gz')))\n    t.equal(result.findings.length, 1, 'result artifact holds the finding')\n    t.equal(result.run_id, path.basename(run), 'result names the run')\n    await verifyBundle(path.join(run, 'bundle.tar.zst'))\n    t.ok(true, 'bundle verifies')\n    const index = fs.readdirSync(runsDir(r))\n        .filter(n => n.startsWith('runs-') && n.endsWith('.jsonl'))\n    t.equal(index.length, 1, 'monthly index file')\n    const lines = fs.readFileSync(path.join(runsDir(r), index[0]), 'utf8')\n        .trimEnd().split('\\n')\n    t.equal(lines.length, 1, 'index gains one line')\n    const meta = reviewMeta(r)\n    t.equal(meta.run_id, path.basename(run), 'meta run id')\n    t.equal(meta.roles.finder.protocol, 'chat', 'finder protocol')\n    t.equal(meta.roles.finder.profile, 'fake', 'finder profile')\n    t.equal(meta.roles.finder.model, 'finder-model', 'finder model')\n    t.deepEqual(meta.argv, ['review', '--no-verify', '--format', 'json'],\n        'argv recorded')\ntest/cli/review-errors.ts:34:test('a provider 401 exits 3 with category auth', async t => {\ntest/cli/review-errors.ts:46:test('a provider 500 after retries exits 4 with category endpoint',\ntest/cli/review-errors.ts:74:test('aborting io.signal during the finder exits 5', async t => {\ntest/cli/review-errors.ts:130:test('the built CLI: one SIGINT during the finder exits 5', async t => {\ntest/cli/review-errors.ts:167:test('the built CLI: a second SIGINT exits 130', async t => {\ntest/cli/review-config.ts:32:test('a JSONC config with comments is used', async t => {\ntest/cli/review-config.ts:45:test('the nearest config below the toplevel wins; --config overrides',\ntest/cli/review-config.ts:65:test('invalid and missing configs are usage errors', async t => {\ntest/cli/review-config.ts:79:test('the user config directory is never read', async t => {\ntest/cli/review-config.ts:97:test('prompt overrides resolve against the config directory', async t => {\ntest/cli/review-config.ts:117:test('review outside Git: explicit fails, bare shows help', async t => {\ntest/cli/review-config.ts:131:test('--author-model flips the finder per author routes', async t => {\ntest/cli/review-config.ts:154:test('removed environment variables change nothing', async t => {\ntest/cli/review-survey.ts:38:test('survey sends the manifest with exploration tools', async t => {\ntest/cli/review-survey.ts:63:test('survey honors --max-turns', async t => {\ntest/cli/review-survey.ts:70:test('a converged clean survey is complete', async t => {\ntest/cli/review-survey.ts:82:test('a survey cut off by the token budget is partial', async t => {\ntest/cli/review-survey.ts:92:test('a diff review carries no survey fields', async t => {\ntest/cli/review-survey.ts:104:test('survey of a repository with no commits is NO_DIFF', async t => {\ntest/cli/review-flags.ts:26:test('raw flag validation fails before config and requests', async t => {\ntest/cli/review-flags.ts:61:test('json error output for an invali