{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017agAHhTyQbVHPD7EHuKfky","type":"tool_result","content":"        'pass', 'no proxy')\n})\n\ntest('doctor probes models with each role protocol and no key in output',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:204 })\n        t.cleanup(server.close)\n        r.env.ROAST_FINDER_API_KEY = 'finder-private-key'\n        r.env.ROAST_VERIFIER_API_KEY = 'verifier-private-key'\n        for (const protocol of ['chat', 'responses', 'anthropic']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.json'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{\n                        o:{\n                            model:'m',\n                            protocol,\n                            endpoint:server.url + '/custom/v1///',\n                            session_header:'X-Session',\n                        },\n                    },\n                }))\n            await approveDoctorConfig(r)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, protocol === 'chat' ? 0 : 4,\n                `${protocol} reflects adapter availability`)\n            t.deepEqual(res.rows.filter(x => !x.name.endsWith('-roundtrip'))\n                .slice(4, 10).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'],\n                ['finder-profile', 'pass'],\n                ['finder-endpoint', 'pass'],\n                ['verifier-credential', 'pass'],\n                ['verifier-profile', 'pass'],\n                ['verifier-endpoint', 'pass'],\n            ], 'endpoint checks retain role order')\n            const roundtrips = res.rows.filter(x =>\n                x.name.endsWith('-roundtrip'))\n            t.deepEqual(roundtrips.map(x => x.status),\n                protocol === 'chat' ? ['pass', 'pass'] : ['fail', 'fail'],\n                'missing adapters fail both roundtrips without crashing')\n            if (protocol !== 'chat') {\n                t.ok(roundtrips.every(x =>\n                    x.detail.includes('unsupported inference protocol')),\n                'unavailable adapter has a plain diagnostic')\n            }\n            const requests = server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n            t.equal(requests.length, 2, 'one models probe per role')\n            for (const [i, req] of requests.entries()) {\n                const key = i === 0 ? 'finder-private-key' :\n                    'verifier-private-key'\n                t.equal(req.method, 'GET', 'models uses GET')\n                t.equal(req.path, '/custom/v1/models', 'base slashes removed')","is_error":false}]},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"7e9a11bf-6d50-4b45-b3c4-52ddc32835c7","timestamp":"2026-11-24T02:50:22.186Z","tool_use_result":{"stdout":"        'pass', 'no proxy')\n})\n\ntest('doctor probes models with each role protocol and no key in output',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:204 })\n        t.cleanup(server.close)\n        r.env.ROAST_FINDER_API_KEY = 'finder-private-key'\n        r.env.ROAST_VERIFIER_API_KEY = 'verifier-private-key'\n        for (const protocol of ['chat', 'responses', 'anthropic']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.json'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{\n                        o:{\n                            model:'m',\n                            protocol,\n                            endpoint:server.url + '/custom/v1/