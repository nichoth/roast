{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TnaakkxLdRfFfi6ecg99db","type":"tool_result","content":"const AMBIENT:Record<string, string> = {\n    OPENAI_API_KEY:'sk-ambient-openai',\n    OPENAI_ADMIN_KEY:'sk-ambient-admin',\n    OPENAI_ORG_ID:'org-ambient',\n    OPENAI_PROJECT_ID:'proj-ambient',\n    OPENAI_CUSTOM_HEADERS:'User-Agent: ambient-ua\\nX-Ambient: yes',\n    ANTHROPIC_API_KEY:'sk-ant-ambient',\n    ANTHROPIC_AUTH_TOKEN:'ambient-token',\n    ANTHROPIC_CUSTOM_HEADERS:'X-Agent-Session-Id: ambient-session',\n    ANTHROPIC_WORKSPACE_ID:'ambient-workspace',\n    OPENROUTER_API_KEY:'sk-or-ambient',\n    X_OPENCODE_SESSION:'ambient-session-header',\n}\n\nfunction withAmbient (t:CleanupTest, decoy:string):void {\n    const vars = {\n        ...AMBIENT,\n        OPENAI_BASE_URL:`${decoy}/v1`,\n        ANTHROPIC_BASE_URL:decoy,\n    }\n    const saved:Record<string, string|undefined> = {}\n    for (const [k, v] of Object.entries(vars)) {\n        saved[k] = process.env[k]\n        process.env[k] = v\n    }\n    t.cleanup(() => {\n        for (const [k, v] of Object.entries(saved)) {\n            if (v === undefined) delete process.env[k]\n            else process.env[k] = v\n        }\n    })\n21:export type Step =\n26:export interface Recorded {\n36:export interface FakeModel {\n41:export function fakeModel (\n88:export function usage (over:Partial<Usage> = {}):Usage {\n92:export function turn (\n102:export function callPart (\n116:export function calls (...parts:AssistantPart[]):ModelTurn {\n120:export function call (name:string, input:unknown = {}, id?:string):ModelTurn {\n124:export const FINAL = 'submit'\n126:export function submit (input:unknown = { summary:'ok' }):ModelTurn {\n130:export function prose (text = 'I think it is fine.'):ModelTurn {\n134:export interface Summary {\n139:export const FINAL_SCHEMA = {\n151:export function decodeSummary (value:unknown):Summary {\n173:export function finalTool ():Tool {\n182:export function readTool (log:string[] = []):Tool&{ runs:number } {\n201:export function recordTool (\n219:export function options (\n231:export interface Harness extends FakeModel {\n237:export function harness (\n251:export async function failure (p:Promise<unknown>):Promise<unknown> {\n260:export function signal ():AbortSignal {\n266:export function lastResults (r:Recorded) {\n273:export function aborted (s:AbortSignal):Promise<void> {\n173:export function finalTool ():Tool {\n174-    return {\n175-        name:FINAL,\n176-        description:'Submit the result.',\n177-        schema:structuredClone(FINAL_SCHEMA),\n178-    }\n179-}\n180-\n181-// An exploration tool that counts its runs.\n182:export function readTool (log:string[] = []):Tool&{ runs:number } {\n183-    const tool = {\n184-        name:'read',\n185-        description:'Read a file.',\n186-        schema:{\n187-            type:'object',\n188-            properties:{ path:{ type:'string' } },\n189-        },\n190-        runs:0,\n191-        run (args:Record<string, unknown>) {\n192-            tool.runs++\n193-            log.push(`read:${String(args.path)}`)\n194-            return { text:'contents' }\n195-        },\n196-    }\n197-    return tool\n198-}\n199-\n200-// A record tool that counts its runs.\n201-export function recordTool (\n202-    onRun?:() => void\n203-):Tool&{ runs:number } {\n204-    const tool = {\n205-        name:'report',\n206-        description:'Record one finding.',\n207-        schema:{ type:'object', properties:{ title:{ type:'string' } } },\n--\n219:export function options (\n220-    tools:Tool[],\n221-    over:Partial<ConverseOptions<Summary>> = {}\n222-):ConverseOptions<Summary> {\n223-    return {\n224-        tools,\n225-        finalTool:FINAL,\n226-        final:{ decode:decodeSummary },\n227-        ...over,\n228-    }\n229-}\n230-\n231-export interface Harness extends FakeModel {\n232-    client:Client;\n233-    sleeps:number[];\n234-}\n235-\n236-// A client over a fake model; sleeps are recorded and return at once.\n237-export function harness (\n238-    script:Step[]|((req:ModelRequest, n:number) => Step),\n239-    over:Partial<ClientConfig> = {},\n240-    clientOpts:CreateClientOptions = {}\n241-):Harness {\n242-    const fake = fakeModel(script, over)\n243-    const sleeps:number[] = []\n244-    const client = createClient(fake.model, {\ntest('http: usage normalization through Client.usage()', async t => {\n    const s = await server(t, () => ({\n        stream:{\n            ...toolCall('submit', { summary:'ok' }),\n            usage:{\n                prompt_tokens:8,\n                prompt_tokens_details:{ cached_tokens:4 },\n                completion_tokens:3,\n                total_tokens:11,\n            },\n        },\n    }))\n    const c = client(s.url)\n    await c.converse('sys', 'user', options([finalTool()], { maxTurns:1 }),\n        signal())\n    t.deepEqual(c.usage(), {\n        uncached_input_tokens:4,\n        cached_input_tokens:4,\n        cache_write_tokens:0,\n        output_tokens:3,\n        calls:1,\n    }, 'disjoint counts, cached subtracted once')\n})\n\ntest('http: a truncated response names finish reason length', async t => {\n    const s = await server(t, () => ({\n        stream:response({ content:'partial' }, 'length'),\n    }))\n    const err = await failure(client(s.url).converse('sys', 'user',\n        options([readTool(), finalTool()]), signal()))\n    t.ok(hasSentinel(err, 'no-final-call'), 'no-final-call')\n    t.equal((err as LlmError).details.finishReason, 'length',\n        'details name finish reason length')\n    t.equal((err as LlmError).details.stopCause, 'finish-reason',\n        'stopped on the finish reason')\n    t.equal(s.requests.length, 1, 'not retried')\n})\n\ntest('http: prose names the model and the attempt count', async t => {","is_error":false}]},"parent_tool_use_id":null,"session_id":"c3b53f31-1a37-4344-81e1-3cd017cb5d08","uuid":"28306b66-cac4-4477-b7c9-6c818195905f","time