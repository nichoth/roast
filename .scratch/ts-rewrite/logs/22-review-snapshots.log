{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GekaVVQnNKKp5dJPAnZL1t","type":"tool_result","content":"// The reviewed tree (spec 05, 2.2): live working tree, pinned index tree,\n// or captured worktree tree. Every reader in this area takes one Tree.\nimport fs from 'node:fs/promises'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { git } from '../git/git.js'\nimport type { ContextOpts } from './git.js'\n\nexport type Tree = {\n    // '' means the live working tree.\n    readonly oid:string;\n    // true: captured worktree; false with an oid: index tree.\n    readonly worktree:boolean;\n}\n\nexport const LIVE_TREE:Tree = Object.freeze({ oid:'', worktree:false })\n\nexport function pinned (t:Tree):boolean {\n    return t.oid !== ''\n}\n\nexport function staged (t:Tree):boolean {\n    return pinned(t) && !t.worktree\n}\n\nexport function pinnedWorktree (oid:string):Tree {\n    return { oid, worktree:oid !== '' }\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nasync function copyIndex (src:string, dst:string):Promise<void> {\n    let data:Buffer\n    try {\n        data = await fs.readFile(src)\n    } catch (err) {\n        // Git treats a missing index as an empty one.\n        if ((err as NodeJS.ErrnoException).code === 'ENOENT') return\n        throw new Error(`read ${src}: ${message(err)}`, { cause:err })\n    }\n    let fh:fs.FileHandle\n    try {\n        fh = await fs.open(dst, 'w', 0o600)\n    } catch (err) {\n        throw new Error(`create ${dst}: ${message(err)}`, { cause:err })\n    }\n    try {\n        await fh.writeFile(data)\n    } catch (err) {\n        throw new Error(`copy index: ${message(err)}`, { cause:err })\n    } finally {\n        await fh.close()\n    }\n}\n\n// Writes the current index (honoring GIT_INDEX_FILE) into a tree object\n// through a temporary copy, without touching the live index, any ref, or\n// any commit. `opts.env` is the environment git runs with (and the one\n// GIT_INDEX_FILE is read from); process.env when absent.\nexport async function pinIndexTree (\n    repo:string,\n    signal:AbortSignal,\n    opts:Omit<ContextOpts, 'signal'> = {}\n):Promise<Tree> {\n    const runOpts = { signal, env:opts.env }\n    let gitDir:string\n    try {\n        gitDir = (await git(repo, ['rev-parse', '--absolute-git-dir'],\n            runOpts)).toString().trim()\n    } catch (err) {\n        signal.throwIfAborted()\n        throw new Error(`resolve git dir: ${message(err)}`, { cause:err })\n    }\n    const environment = opts.env ?? process.env\n    let live = environment.GIT_INDEX_FILE ?? ''\n    if (live === '') live = path.join(gitDir, 'index')\n    else if (!path.isAbsolute(live)) live = path.join(repo, live)\n\n    let tmp:string\n    try {\n        tmp = await fs.mkdtemp(path.join(os.tmpdir(), 'roast-pin-'))\n    } catch (err) {\n        throw new Error(`temp dir: ${message(err)}`, { cause:err })\n    }\n    try {\n        const idx = path.join(tmp, 'index')\n        await copyIndex(live, idx)\n        let oid:string\n        try {\n            oid = (await git(repo, ['write-tree'], {\n                ...runOpts,\n                extraEnv:{ GIT_INDEX_FILE:idx },\n            })).toString().trim()\n        } catch (err) {\n            signal.throwIfAborted()\n            throw new Error(`write-tree: ${message(err)}`, { cause:err })\n        }\n        return { oid, worktree:false }\n    } finally {\n        await fs.rm(tmp, { recursive:true, force:true })\n    }\n}\n41:### 2.1 Process entry\n64:### 2.2 Exit codes\n114:### 2.3 Error categories\n132:### 2.4 Error output (`--error-format`)\n163:### 2.5 Command tree\n202:### 2.6 `review` flags\n249:### 2.7 Flag validation (before any config is read)\n279:### 2.8 Review orchestration\n482:### 2.9 Gate bootstrap offer\n495:### 2.10 Version and build info\n505:### 2.11 Value syntax\n535:### 2.12 stdout/stderr discipline\n550:### 2.13 Snapshot cap