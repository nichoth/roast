{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AVyhkx7oqVZ7Ge5fJyx4tU","type":"tool_result","content":"// The snapshot capture decision for a review (spec 01, 2.13). The\n// snapshot area's functions are injected; until that area lands, the\n// default capture fails, which records `captured: false` with a reason.\nimport { git, type GitRunOpts } from '../git/git.js'\nimport type { SnapshotMeta } from '../record/meta-types.js'\nimport type { Scope } from '../scope/index.js'\n\n// A pinned worktree tree (snapshot area PinWorktree); null when none.\nexport type WorktreePin = { readonly tree:string }|null\n\nexport interface CaptureOptions {\n    runId:string;\n    headOID:string;\n    baseOID:string;\n    indexTree:string;\n    worktree:WorktreePin;\n}\n\nexport interface Capture {\n    ref:string;\n    commit:string;\n    indexTree:string;\n    worktreeTree:string;\n    head:string;\n    base:string;\n    excluded:string[];\n}\n\nexport interface SnapshotDeps {\n    capture (repo:string, opts:CaptureOptions):Promise<Capture>;\n    // Each resolves '' when the revision does not resolve.\n    headOID (repo:string):Promise<string>;\n    revOID (repo:string, rev:string):Promise<string>;\n    treeOID (repo:string, rev:string):Promise<string>;\n}\n\nexport const DISABLED_REASON = 'disabled by review.snapshot'\nexport const DISABLED_CAVEAT =\n    'Git snapshot capture was disabled; this run cannot be replayed.'\nexport const FILE_MODES = 'regular and executable files plus symlinks; ' +\n    'empty directories are not represented'\n\nasync function revParse (\n    repo:string,\n    rev:string,\n    opts:GitRunOpts\n):Promise<string> {\n    try {\n        const out = await git(repo,\n            ['rev-parse', '--verify', '--quiet', '--end-of-options', rev],\n            opts)\n        return out.toString('utf8').trim()\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        return ''\n    }\n}\n\nexport function defaultSnapshotDeps (opts:GitRunOpts):SnapshotDeps {\n    return {\n        capture () {\n            return Promise.reject(\n                new Error('snapshot capture is not available yet'))\n        },\n        headOID:repo => revParse(repo, 'HEAD^{commit}', opts),\n        revOID:(repo, rev) => revParse(repo, `${rev}^{commit}`, opts),\n        treeOID:(repo, rev) => revParse(repo, `${rev}^{tree}`, opts),\n    }\n}\n\nexport interface SnapshotDecision {\n    meta:SnapshotMeta;\n    caveats:string[];\n}\n\nexport async function captureSnapshot (\n    enabled:boolean,\n    repo:string,\n    runId:string,\n    scope:Pick<Scope, 'headOID'|'base'|'staged'|'survey'>,\n    indexTree:string,\n    pin:WorktreePin,\n    deps:SnapshotDeps\n):Promise<SnapshotDecision> {\n    if (!enabled) {\n        return {\n            meta:{ captured:false, reason:DISABLED_REASON },\n            caveats:[DISABLED_CAVEAT],\n        }\n    }\n    const head = scope.headOID || await deps.headOID(repo)\n    const base = scope.base !== '' ? await deps.revOID(repo, scope.base) : ''\n    let snap:Capture\n    try {\n        snap = await deps.capture(repo, {\n            runId, headOID:head, baseOID:base, indexTree, worktree:pin,\n        })\n    } catch (err) {\n        const reason = err instanceof Error ? err.message : String(err)\n        return {\n            meta:{ captured:false, reason, head, base },\n            caveats:[`Git snapshot capture failed: ${reason}`],\n        }\n    }\n    const diffPair = scope.staged ? 'head..index' :\n        scope.survey ? 'head' :\n            scope.base === '' ? 'head..worktree' : 'base..worktree'\n    const meta:SnapshotMeta = {\n        captured:true,\n        ref:snap.ref,\n        commit:snap.commit,\n        index_tree:snap.indexTree,\n        worktree_tree:snap.worktreeTree,\n        head:snap.head,\n        base:snap.base,\n        diff_pair:diffPair,\n        file_modes:FILE_MODES,\n        excluded_paths:[...snap.excluded],\n    }\n    const src = diffPair === 'base..worktree' ? base : head\n    if (src !== '') meta.base_tree = await deps.treeOID(repo, src)\n    const caveats = snap.excluded.length > 0 ?\n        [`snapshot excluded ${snap.excluded.length} denylisted untracked ` +\n            'path(s)'] :\n        []\n    return { meta, caveats }\n}\n// The secret denylist (spec 11, \"Secret denylist\"): untracked paths that\n// are never folded into a review diff, captured into a snapshot, or\n// served from the live working tree.\nimport { goPathMatch } from '../gocompat/match.js'\nimport { git } from '../git/git.js'\nimport { compareBytes, decodePaths } from '../scope/text.js'\n\n// SSH keys match by key-type prefix so suffixed names are covered; a bare\n// `id_*` would also drop ordinary sources such as id_map.go.\nexport const DEFAULT_DENYLIST:readonly string[] = Object.freeze([\n    '.env*', '*.pem', '*_rsa', '*.key', 'creds*',\n    'id_rsa*', 'id_dsa*', 'id_ecdsa*', 'id_ed25519*', 'id_xmss*',\n    'credentials.json', '.npmrc', '.pypirc', '.netrc', '_netrc', '.pgpass',\n    '.git-credentials', '*.p12', '*.pfx',\n])\n\nfunction basename (p:string):string {\n    const i = p.lastIndexOf('/')\n    return i === -1 ? p : p.slice(i + 1)\n}\n\n// Whether a repo-relative `/`-separated path matches any pattern, by its\n// basename or its full path, case-insensitively. A malformed pattern\n// never matches.\nexport function denylisted (\n    path:string,\n    patterns:readonly string[] = DEFAULT_DENYLIST\n):boolean {\n    const full = path.toLowerCase()\n    const base = basename(full)\n    return patterns.some(pattern => {\n        const p = pattern.toLowerCase()\n        return goPathMatch(p, base) || goPathMatch(p, full)\n    })\n}\n\nexport interface DenylistedUntrackedOpts {\n    // Omitted means DEFAULT_DENYLIST; an empty list disables filtering.\n    patterns?:readonly string[];\n    signal?:AbortSignal;\n    env?:NodeJS.ProcessEnv;\n}\n\n// The untracked, non-ignored paths matching the denylist, in byte order.\n// Tracked files are never listed: their content is already in history.\nexport async function denylistedUntracked (\n    repo:string,\n    opts:DenylistedUntrackedOpts = {}\n):Promise<string[]> {\n    const patterns = opts.patterns ?? DEFAULT_DENYLIST\n    if (patterns.length === 0) return []\n    const out = await git(repo,\n        ['ls-files', '--others', '--exclude-standard', '-z'],\n        { signal:opts.signal, env:opts.env })\n    return decodePaths(out).paths\n        .filter(p => p !== '' && denylisted(p, patterns))\n        .sort(compareBytes)\n}\n// The one git runner. Every area runs git through here; scope and context\n// add their specialized wrappers (patch capping, streaming) on top.\n\nimport { spawn } from 'node:child_process'\n\nexport class GitError extends Error {\n    exitCode:number|null\n    stderr:string\n\n    constructor (exitCode:number|null, signal:string|null, stderr:string) {\n        const status = exitCode === null ?\n            `signal: ${signal}` :\n            `exit status ${exitCode}`\n        const detail = stderr.trim()\n        super(detail ? `${status}: ${detail}` : status)\n        this.name = 'GitError'\n        this.exitCode = exitCode\n        this.stderr = stderr\n    }\n}\n\nexport interface GitRunOpts {\n    // Kills the child on abort; the call rejects with the signal's reason.\n    signal?:AbortSignal;\n    // The environment git runs with, normally the CLI context's env. Only\n    // when absent is process.env used.\n    env?:NodeJS.ProcessEnv;\n    // Variables merged over `env`.\n    extraEnv?:Record<string, string>;\n    // Written to stdin, which is then closed.\n    input?:Buffer|string;\n}\n\n// How long a child gets after SIGTERM before SIGKILL.\nconst KILL_GRACE_MS = 1000\n\ninterface Exit {\n    code:number|null;\n    signal:string|null;\n    stdout:Buffer;\n    stderr:Buffer;\n}\n\nfunction runGit (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts\n):Promise<Exit> {\n    const { signal } = opts\n    return new Promise((resolve, reject) => {\n        if (signal?.aborted) {\n            reject(signal.reason)\n            return\n        }\n        const env = { ...(opts.env ?? process.env), ...opts.extraEnv }\n        const child = spawn('git', ['-C', repo, ...args], {\n            env,\n            stdio:['pipe', 'pipe', 'pipe'],\n        })\n        const out:Buffer[] = []\n        const err:Buffer[] = []\n        let killTimer:NodeJS.Timeout|undefined\n        let spawnError:Error|undefined\n\n        function onAbort ():void {\n            child.kill('SIGTERM')\n            killTimer = setTimeout(() => child.kill('SIGKILL'),\n                KILL_GRACE_MS)\n        }\n        signal?.addEventListener('abort', onAbort, { once:true })\n\n        child.stdout.on('data', (chunk:Buffer) => out.push(chunk))\n        child.stderr.on('data', (chunk:Buffer) => err.push(chunk))\n        child.on('error', e => { spawnError ??= e })\n        // A child that exits without reading stdin closes the pipe; that\n        // EPIPE is not a git failure.\n        child.stdin.on('error', () => {})\n        if (opts.input !== undefined) child.stdin.end(opts.input)\n        else child.stdin.end()\n\n        child.on('close', (code, sig) => {\n            clearTimeout(killTimer)\n            signal?.removeEventListener('abort', onAbort)\n            if (signal?.aborted) {\n                reject(signal.reason)\n            } else if (spawnError) {\n                reject(spawnError)\n            } else {\n                resolve({\n                    code,\n                    signal:sig,\n                    stdout:Buffer.concat(out),\n                    stderr:Buffer.concat(err),\n                })\n            }\n        })\n    })\n}\n\n// Runs `git -C <repo> <args>` and resolves stdout. A non-zero exit\n// rejects with a GitError.\nexport async function git (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<Buffer> {\n    const exit = await runGit(repo, args, opts)\n    if (exit.code !== 0) {\n        throw new GitError(exit.code, exit.signal, exit.stderr.toString())\n    }\n    return exit.stdout\n}\n\n// Exit status only: false on a non-zero exit. Rejects only on abort or\n// when git cannot be started.\nexport async function gitOk (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<boolean> {\n    const exit = await runGit(repo, args, opts)\n    return exit.code === 0\n}\n\n// The repository toplevel containing `start`.\nexport async function gitRoot (\n    start:string,\n    opts:GitRunOpts = {}\n):Promise<string> {\n    let out:Buffer\n    try {\n        out = await git(start, ['rev-parse', '--show-toplevel'], opts)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error('not inside a git repository', { cause:err })\n    }\n    return out.toString().trim()\n}\n     672 src/cli/review.ts","is_error":false}]},"parent_tool_use_id":null,"session_id":"7ad23c81-404a-48c1-af0c-22c3c0a830e9","uuid":"45406ff1-51a2-4858-bc8a-97f1fd46a152","timestamp":"2026-11-24T01:50:50.597Z","tool_use_result":{"stdout":"// The snapshot capture decision for a review (spec 01, 2.13). The\n// snapshot area's functions are injected; until that area lands, the\n// default capture fails, which records `captured: false` with a reason.\nimport { git, type GitRunOpts } from '../git/git.js'\nimport type { SnapshotMeta } from '../record/meta-types.js'\nimport type { Scope } from '../scope/index.js'\n\n// A pinned worktree tree (snapshot area PinWorktree); null when none.\nexport type WorktreePin = { readonly tree:string }|null\n\nexport interface CaptureOptions {\n    runId:string;\n    headOID:string;\n    baseOID:string;\n    indexTree:string;\n    worktree:WorktreePin;\n}\n\nexport interface Capture {\n    ref:string;\n    commit:string;\n    indexTree:string;\n    worktreeTree:string;\n    head:string;\n    base:string;\n    excluded:string[];\n}\n\ne