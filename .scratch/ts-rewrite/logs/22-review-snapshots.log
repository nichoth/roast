{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VGZEn2t2ovbGwQ4hDGLzzA","type":"tool_result","content":"1\t// `roast review`, also the default command: the review orchestration of\n2\t// spec 01, 2.8. Verification (step 17) and snapshots are other tickets:\n3\t// the verifier step passes the finder result through, and snapshot\n4\t// capture is injected (see snapshot-meta.ts).\n5\timport type { Writable } from 'node:stream'\n6\timport { buildInfo } from '../buildinfo.js'\n7\timport {\n8\t    type ProjectConfig,\n9\t    credentialEnvNames,\n10\t    promptPath,\n11\t    snapshotEnabled,\n12\t} from '../config/load.js'\n13\timport { DEFAULT_LIMITS } from '../config/defaults.js'\n14\timport { resolveFinderFlip, resolveRole, validateRole }\n15\t    from '../config/role.js'\n16\timport type { ResolvedRole } from '../config/resolved-role.js'\n17\timport { buildFileContext } from '../context/snippet.js'\n18\timport { newQuoteGrounder } from '../context/grounding.js'\n19\timport { explorationTools } from '../context/tools.js'\n20\timport { LIVE_TREE, pinIndexTree, type Tree } from '../context/tree.js'\n21\timport { gitRoot } from '../git/git.js'\n22\timport {\n23\t    type GoDuration,\n24\t    formatGoDuration,\n25\t    parseGoDuration,\n26\t    toMillis,\n27\t} from '../gocompat/duration.js'\n28\timport { createClient, createModelClient } from '../llm/client.js'\n29\timport { type Ledger, committed, newLedger } from '../llm/ledger.js'\n30\timport type {\n31\t    Client, ClientConfig, Protocol, RawResponse, RecordUsage, Tool,\n32\t} from '../llm/types.js'\n33\timport { finderSystem, verifierSystem } from '../prompts/index.js'\n34\timport { renderFinderUser } from '../prompts/render.js'\n35\timport { recordDir } from '../record/dir.js'\n36\timport { openFindingSpill } from '../record/findings.js'\n37\timport { appendRunLine, seenBefore } from '../record/index-file.js'\n38\timport {\n39\t    type Meta,\n40\t    type RoleMeta,\n41\t    captureEnv,\n42\t    digest,\n43\t    removeRun,\n44\t    reportPath,\n45\t    resolveRunDir,\n46\t    writeArtifact,\n47\t    writeMeta,\n48\t    writeReport as writeRunReport,\n49\t} from '../record/meta.js'\n50\timport { rfc3339NanoUTC } from '../record/json.js'\n51\timport { ResponseRecorder } from '../record/responses.js'\n52\timport { newRunId } from '../record/run-id.js'\n53\timport { toJSON, toMarkdown, type Report } from '../render/render.js'\n54\timport { writeReport } from '../render/write.js'\n55\timport { classifyMode } from '../review/classify.js'\n56\timport { find } from '../review/find.js'\n57\timport {\n58\t    type Result, type WireFinding, maxSeverity,\n59\t} from '../review/types.js'\n60\timport { buildBundle } from '../runbundle/bundle.js'\n61\timport { build, fit, isEmpty, type BuildOpts } from '../scope/index.js'\n62\timport { ExitSignal, UsageError } from './errors.js'\n63\timport type { CommandArgs, CommandDef, RunContext } from './command.js'\n64\timport { loadProjectConfig } from './config.js'\n65\timport { logf } from './log.js'\n66\timport {\n67\t    DEFAULT_MAX_TURNS,\n68\t    SURVEY_MAX_TURNS,\n69\t    type ReviewFlags,\n70\t    parseReviewFlags,\n71\t    reviewBuilder,\n72\t    validateReviewFlags,\n73\t} from './review-flags.js'\n74\timport {\n75\t    applyRoleFlags,\n76\t    configInt,\n77\t    flagOrConfig,\n78\t    resolveLangs,\n79\t} from './resolve.js'\n80\timport {\n81\t    type SnapshotDeps,\n82\t    captureSnapshot,\n83\t    defaultSnapshotDeps,\n84\t} from './snapshot-meta.js'\n85\timport { requireTrust } from './trust.js'\n86\t\n87\tconst QUICK_DIFF_BYTES = 200_000\n88\tconst QUICK_FILE_CTX_BYTES = 100_000\n89\tconst SURVEY_DEADLINE = '25m'\n90\tconst INTERACTIVE_MIN_DIFF_LINES = 80\n91\tconst INTERACTIVE_MIN_FILES = 4\n92\t\n93\t// Swappable for tests: the snapshot area's functions (ticket 22).\n94\texport const reviewHooks:{\n95\t    snapshot:((ctx:RunContext) => SnapshotDeps)|null;\n96\t} = { snapshot:null }\n97\t\n98\t// Exit selection after a completed run (spec 01, 2.2): a finalize\n99\t// failure wins over the severity gate.\n100\texport function reviewExitError (\n101\t    finalErr:Error|null,\n102\t    gateRank:number,\n103\t    maxSev:number,\n104\t    partial:boolean\n105\t):Error|null {\n106\t    if (finalErr) return finalErr\n107\t    if (gateRank >= 0 && maxSev >= gateRank) return new ExitSignal(1)\n108\t    if (partial) return new ExitSignal(4)\n109\t    return null\n110\t}\n111\t\n112\tfunction message (err:unknown):string {\n113\t    return err instanceof Error ? err.message : String(err)\n114\t}\n115\t\n116\t// Config and role failures are usage errors carrying the config area's\n117\t// message.\n118\tfunction asUsage<T> (fn:() => T):T {\n119\t    try {\n120\t        return fn()\n121\t    } catch (err) {\n122\t        if (err instanceof UsageError) throw err\n123\t        throw new UsageError(message(err), { cause:err })\n124\t    }\n125\t}\n126\t\n127\tfunction wrap (prefix:string, err:unknown):Error {\n128\t    return new Error(`${prefix}: ${message(err)}`, { cause:err })\n129\t}\n130\t\n131\tfunction roleMeta (role:ResolvedRole, system:string):RoleMeta {\n132\t    return {\n133\t        profile:role.profile,\n134\t        base_url:role.baseURL,\n135\t        model:role.model,\n136\t        protocol:role.protocol,\n137\t        max_output_tokens:role.maxOutputTokens,\n138\t        session_header:role.sessionHeader,\n139\t        prompt_digest:digest(system),\n140\t    }\n141\t}\n142\t\n143\tfunction clientConfig (\n144\t    name:string,\n145\t    role:ResolvedRole,\n146\t    capture:(raw:RawResponse) => Promise<void>,\n147\t    maxAttempts:number,\n148\t    requestTimeout:GoDuration,\n149\t    fetch:typeof globalThis.fetch\n150\t):ClientConfig {\n151\t    return {\n152\t        role:name,\n153\t        baseUrl:role.baseURL.replace(/\\/+$/, ''),\n154\t        apiKey:role.apiKey,\n155\t        model:role.model,\n156\t        protocol:role.protocol as ''|Protocol,\n157\t        maxOutputTokens:role.maxOutputTokens,\n158\t        sessionHeader:role.sessionHeader,\n159\t        maxAttempts,\n160\t        requestTimeoutMs:toMillis(requestTimeout),\n161\t        captureResponse:capture,\n162\t        fetch,\n163\t    }\n164\t}\n165\t\n166\tfunction newClient (\n167\t    config:ClientConfig,\n168\t    ledger:Ledger|null\n169\t):Client {\n170\t    return createClient(createModelClient(config), { ledger })\n171\t}\n172\t\n173\ttype Format = 'json'|'markdown'|'both'\n174\t\n175\tfunction streams (ctx:RunContext):{ stdout:Writable, stderr:Writable } {\n176\t    return {\n177\t        stdout:ctx.stdout as Writable,\n178\t        stderr:ctx.stderr as Writable,\n179\t    }\n180\t}\n181\t\n182\tfunction countNewlines (s:string):number {\n183\t    let n = 0\n184\t    for (let i = s.indexOf('\\n'); i >= 0; i = s.indexOf('\\n', i + 1)) n++\n185\t    return n\n186\t}\n187\t\n188\tfunction utf8Bytes (s:string):number {\n189\t    return Buffer.byteLength(s, 'utf8')\n190\t}\n191\t\n192\t// The gate bootstrap offer (spec 01, 2.9) runs here once ticket 30\n193\t// lands; it is a no-op until then.\n194\tasync function maybeBootstrapGate (_ctx:RunContext):Promise<void> {}\n195\t\n196\tinterface Roles {\n197\t    finder:ResolvedRole;\n198\t    verifier:ResolvedRole;\n199\t    doVerify:boolean;\n200\t}\n201\t\n202\tfunction resolveRoles (\n203\t    cfg:ProjectConfig,\n204\t    f:ReviewFlags,\n205\t    ctx:RunContext\n206\t):Roles {\n207\t    return asUsage(() => {\n208\t        let finder = resolveRole(cfg, 'finder', ctx.env)\n209\t        let verifier = resolveRole(cfg, 'verifier', ctx.env)\n210\t        finder = applyRoleFlags('finder', finder, f.finder, ctx.env)\n211\t        verifier = applyRoleFlags('verifier', verifier, f.verifier, ctx.env)\n212\t        const flip = resolveFinderFlip(cfg, finder, f.authorModel, ctx.env)\n213\t        if (flip.note) logf(ctx.stderr, flip.note)\n214\t        if (flip.warn) logf(ctx.stderr, flip.warn)\n215\t        finder = flip.role\n216\t        validateRole('finder', finder)\n217\t        const doVerify = !f.quick && !f.noVerify\n218\t        if (doVerify) validateRole('verifier', verifier)\n219\t        return { finder, verifier, doVerify }\n220\t    })\n221\t}\n222\t\n223\texport async function runReview (\n224\t    f:ReviewFlags,\n225\t    ctx:RunContext\n226\t):Promise<void> {\n227\t    const gateRank = validateReviewFlags(f)\n228\t    const gitOpts = { env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal }\n229\t    const cfg = await loadProjectConfig(f.config, ctx)\n230\t    const roles = resolveRoles(cfg, f, ctx)\n231\t    const { doVerify } = roles\n232\t\n233\t    let repo:string\n234\t    try {\n235\t        repo = await gitRoot(ctx.cwd, gitOpts)\n236\t    } catch (err) {\n237\t        if (ctx.signal.aborted) throw err\n238\t        throw new UsageError(message(err), { cause:err })\n239\t    }\n240\t    await requireTrust(repo, cfg, ctx)\n241\t\n242\t    const survey = f.scope === 'repo'\n243\t    const limits = cfg.limits ?? {}\n244\t    const excludes = [...(cfg.review.excludes ?? []), ...f.exclude]\n245\t    const maxDiff = configInt(limits.max_diff_bytes, f.quick ?\n246\t        QUICK_DIFF_BYTES : DEFAULT_LIMITS.max_diff_bytes)\n247\t    const buildOpts:BuildOpts = {\n248\t        base:f.base,\n249\t        uncommittedOnly:f.uncommittedOnly,\n250\t        stagedOnly:f.staged,\n251\t        paths:f.paths,\n252\t        excludes,\n253\t        includeVendored:f.includeVendored,\n254\t        scope:f.scope,\n255\t        maxFileDiffBytes:maxDiff,\n256\t        env:gitOpts.env,\n257\t    }\n258\t    let tree:Tree = LIVE_TREE\n259\t    if (f.staged) {\n260\t        try {\n261\t            tree = await pinIndexTree(repo, ctx.signal, { env:gitOpts.env })\n262\t        } catch (err) {\n263\t            if (ctx.signal.aborted) throw err\n264\t            throw wrap('pin staged tree', err)\n265\t        }\n266\t        buildOpts.stagedTreeOID = tree.oid\n267\t    }\n268\t    let sc = await build(repo, buildOpts, ctx.signal)\n269\t    for (const note of sc.notes) logf(ctx.stderr, note)\n270\t\n271\t    if (isEmpty(sc)) {\n272\t        writeReport(streams(ctx), f.format as Format, f.showDropped, {\n273\t            result:{\n274\t                assessment:'NO_DIFF', findings:[], dropped:[], notes:[],\n275\t            },\n276\t            mode:'code',\n277\t            filesReviewed:[],\n278\t            task:f.task,\n279\t        })\n280\t        return\n281\t    }\n282\t\n283\t    const inputKind = survey ? 'manifest' : 'diff'\n284\t    const reviewedInput = survey ?\n285\t        Buffer.from(sc.manifest, 'utf8') :\n286\t        sc.diffBytes\n287\t    const runId = newRunId()\n288\t    const indexTree = tree.oid\n289\t    // No worktree pin until the snapshot area lands: non-staged reviews\n290\t    // read the live tree, which the context area guards.\n291\t    const snapDeps = reviewHooks.snapshot?.(ctx) ??\n292\t        defaultSnapshotDeps(gitOpts)\n293\t    const snap = await captureSnapshot(snapshotEnabled(cfg), repo, runId,\n294\t        sc, indexTree, null, snapDeps)\n295\t\n296\t    const ground = newQuoteGrounder(repo, tree, sc.diffBytes, gitOpts)\n297\t    const originalDiffBytes = sc.diffBytes.length\n298\t    const maxFileContext = configInt(limits.max_file_ctx_bytes, f.quick ?\n299\t        QUICK_FILE_CTX_BYTES : DEFAULT_LIMITS.max_file_ctx_bytes)\n300\t    const fitted = fit(sc, maxDiff)\n301\t    sc = fitted.scope\n302\t    const breakdown = fitted.breakdown ?? []\n303\t\n304\t    let mode = f.mode\n305\t    if (mode === 'auto') mode = classifyMode([...sc.files])\n306\t    if (!['code', 'prose', 'mixed'].includes(mode)) {\n307\t        throw new UsageError(`invalid --mode ${JSON.stringify(f.mode)}`)\n308\t    }\n309\t    const langs = resolveLangs(f.lang, [...sc.files], mode)\n310\t    const overrides = cfg.prompts ?? {}\n311\t    const finderPrompt = (mode === 'prose' ?\n312\t        overrides.finder_prose :\n313\t        overrides.finder_code) ?? ''\n314\t    const system = await finderSystem(mode, f.scope, f.quick, langs,\n315\t        promptPath(cfg, finderPrompt))\n316\t    const verifierPrompt = await verifierSystem(\n317\t        promptPath(cfg, overrides.verifier ?? ''))\n318\t    const user = survey ?\n319\t        renderFinderUser({\n320\t            task:f.task,\n321\t            survey:true,\n322\t            manifest:sc.manifest,\n323\t            diff:'',\n324\t            fileContext:'',\n325\t        }) :\n326\t        renderFinderUser({\n327\t            task:f.task,\n328\t            survey:false,\n329\t            diff:sc.diff,\n330\t            fileContext:await buildFileContext(repo, sc.files,\n331\t                maxFileContext, tree, gitOpts),\n332\t            manifest:'',\n333\t        })\n334\t\n335\t    const maxTokensTotal = flagOrConfig(f.maxTokensTotal,\n336\t        limits.max_total_tokens, DEFAULT_LIMITS.max_total_tokens)\n337\t    const maxVerified = flagOrConfig(f.maxVerified, limits.max_verified,\n338\t        DEFAULT_LIMITS.max_verified)\n339\t    const requestTimeout = flagOrConfig(f.requestTimeout,\n340\t        limits.request_timeout,\n341\t        parseGoDuration(DEFAULT_LIMITS.request_timeout))\n342\t    const maxAttempts = flagOrConfig(f.maxAttempts, limits.max_attempts,\n343\t        DEFAULT_LIMITS.max_attempts)\n344\t    const ledger = newLedger(maxTokensTotal)\n345\t    let interactive = f.interactive && !f.quick\n346\t    let maxTurns = f.maxTurns ?? DEFAULT_MAX_TURNS\n347\t    if (survey) {\n348\t        interactive = true\n349\t        if (f.maxTurns === undefined) maxTurns = SURVEY_MAX_TURNS\n350\t    }\n351\t    if (interactive && !survey) {\n352\t        const minLines = configInt(cfg.interactive?.min_diff_lines,\n353\t            INTERACTIVE_MIN_DIFF_LINES)\n354\t        const minFiles = configInt(cfg.interactive?.min_files,\n355\t            INTERACTIVE_MIN_FILES)\n356\t        if (countNewlines(sc.diff) < minLines && sc.files.length < minFiles) {\n357\t            logf(ctx.stderr,\n358\t                'diff is small; using a single structured finder call')\n359\t            interactive = false\n360\t        }\n361\t    }\n362\t    const deadlineDuration = flagOrConfig(f.deadline, limits.deadline,\n363\t        parseGoDuration(survey ? SURVEY_DEADLINE : DEFAULT_LIMITS.deadline))\n364\t    const deadline = deadlineDuration > 0n ?\n365\t        Date.now() + toMillis(deadlineDuration) :\n366\t        undefined\n367\t    const promptCeiling = configInt(limits.max_prompt_bytes,\n368\t        DEFAULT_LIMITS.max_prompt_bytes)\n369\t    const budgets:Record<string, unknown> = {\n370\t        deadline_duration:formatGoDuration(deadlineDuration),\n371\t        request_timeout:formatGoDuration(requestTimeout),\n372\t        max_total_tokens:maxTokensTotal,\n373\t        verifier_cap:maxVerified,\n374\t        max_turns:maxTurns,\n375\t        max_attempts:maxAttempts,\n376\t        max_prompt_bytes:promptCeiling,\n377\t    }\n378\t    const tools:readonly Tool[] = interactive ?\n379\t        explorationTools(repo, tree, { env:gitOpts.env }) :\n380\t        []\n381\t    const floor = f.quick ?\n382\t        cfg.review.quick_confidence_floor :\n383\t        cfg.review.confidence_floor\n384\t    const promptBytes = utf8Bytes(system) + utf8Bytes(user)\n385\t    if (promptBytes > promptCeiling) {\n386\t        throw new UsageError(`finder prompt is ${promptBytes} bytes, over ` +\n387\t            `the ${promptCeiling}-byte ceiling; narrow the review scope or ` +\n388\t            'adjust limits.max_diff_bytes, limits.max_file_ctx_bytes, or ' +\n389\t            'limits.max_prompt_bytes in the project config')\n390\t    }\n391\t\n392\t    const meta:Meta = {\n393\t        run_id:runId,\n394\t        ts:rfc3339NanoUTC(new Date()),\n395\t        repo,\n396\t        argv:[...ctx.argv],\n397\t        roast:{ version:buildInfo.version, commit:buildInfo.commit },\n398\t        scope:{\n399\t            kind:f.scope,\n400\t            base:sc.base,\n401\t            uncommitted_only:f.uncommittedOnly,\n402\t            staged_only:f.staged,\n403\t            include_vendored:f.includeVendored,\n404\t            paths:[...f.paths],\n405\t            excludes:[...excludes],\n406\t            base_oid:snap.meta.base ?? '',\n407\t            merge_base_oid:'',\n408\t            head_oid:sc.headOID || (snap.meta.head ?? ''),\n409\t            survey:sc.survey,\n410\t            staged:sc.staged,\n411\t            files:[...sc.files],\n412\t        },\n413\t        derived:{\n414\t            mode,\n415\t            langs:[...langs],\n416\t            quick:f.quick,\n417\t            interactive,\n418\t            max_turns:maxTurns,\n419\t            confidence_floor:floor,\n420\t            do_verify:doVerify,\n421\t            task:f.task,\n422\t            max_severity:f.maxSeverity,\n423\t            max_diff_bytes:maxDiff,\n424\t            max_file_ctx_bytes:maxFileContext,\n425\t        },\n426\t        roles:{\n427\t            finder:roleMeta(roles.finder, system),\n428\t            verifier:roleMeta(roles.verifier, verifierPrompt),\n429\t        },\n430\t        snapshot:snap.meta,\n431\t        digests:{\n432\t            input_kind:inputKind,\n433\t            input:digest(reviewedInput),\n434\t            input_bytes:reviewedInput.length,\n435\t            system_prompt:digest(system),\n436\t            user_prompt:digest(user),\n437\t        },\n438\t        budgets,\n439\t        env_names_only:captureEnv(ctx.env as NodeJS.ProcessEnv,\n440\t            credentialEnvNames(cfg)),\n441\t        caveats:snap.caveats,\n442\t    }\n443\t    const records = await recordDir(repo, gitOpts)\n444\t    await initializeRun(records, meta, {\n445\t        input:reviewedInput,\n446\t        finder_system:system,\n447\t        finder_user:user,\n448\t        verifier_system:verifierPrompt,\n449\t    })\n450\t\n451\t    const recorder = new ResponseRecorder(records, runId)\n452\t    const capture = (raw:RawResponse):Promise<void> => recorder.append(\n453\t        raw.role, raw.protocol, raw.model, raw.contentType, raw.body)\n454\t    const finder = newClient(clientConfig('finder', roles.finder, capture,\n455\t        maxAttempts, requestTimeout, ctx.fetch), ledger)\n456\t    logf(ctx.stderr, `finder=${roles.finder.model} ` +\n457\t        `profile=${roles.finder.profile} ` +\n458\t        `protocol=${roles.finder.protocol} ` +\n459\t        `endpoint=${roles.finder.baseURL}`)\n460\t    const spill = await openFindingSpill(records, runId)\n461\t    const spilled:Promise<void>[] = []\n462\t    let result:Result\n463\t    try {\n464\t        result = await find(finder, {\n465\t            system,\n466\t            user,\n467\t            quick:f.quick,\n468\t            confidenceFloor:floor,\n469\t            interactive,\n470\t            tools,\n471\t            maxTurns,\n472\t            ground,\n473\t            deadline,\n474\t            survey,\n475\t            capture:spill ?\n476\t                (w:WireFinding) => { spilled.push(spill(w)) } :\n477\t                undefined,\n478\t        }, ctx.signal)\n479\t    } finally {\n480\t        await Promise.all(spilled)\n481\t    }\n482\t\n483\t    const usage:Record<string, RecordUsage> = { finder:finder.usage() }\n484\t    const partial = result.incomplete === true\n485\t    // Step 17 (verification) is ticket 21: the result passes through.\n486\t\n487\t    let reviewKind:''|'survey_triage' = ''\n488\t    let completion = ''\n489\t    let stopReason = ''\n490\t    if (survey) {\n491\t        reviewKind = 'survey_triage'\n492\t        const r = result.stopReason ?? ''\n493\t        if (result.incomplete || ['deadline', 'token_budget',\n494\t            'budget_exhausted'].includes(r)) {\n495\t            completion = 'partial'\n496\t            stopReason = r || 'incomplete_no_submission'\n497\t        } else {\n498\t            completion = 'complete'\n499\t            stopReason = 'converged'\n500\t            if (result.assessment === 'NO_FINDINGS') {\n501\t                result.assessment = 'NO_FINDINGS_IN_SAMPLED_AREAS'\n502\t            }\n503\t        }\n504\t    }\n505\t    const { spent, limit } = committed(ledger)\n506\t    if (limit > 0) budgets.ledger_committed_tokens = spent\n507\t    const report:Report = {\n508\t        result,\n509\t        mode,\n510\t        filesReviewed:[...sc.files],\n511\t        task:f.task,\n512\t        runId,\n513\t        budgets,\n514\t        quick:f.quick,\n515\t        verified:doVerify,\n516\t        diffTruncated:breakdown.length > 0,\n517\t        originalDiffBytes,\n518\t        sizeBreakdown:breakdown.map(e => ({ path:e.path, bytes:e.bytes })),\n519\t        usage,\n520\t        promptPacks:langs,\n521\t        reviewKind,\n522\t        completion,\n523\t        manifestFileCount:sc.files.length,\n524\t        stopReason,\n525\t    }\n526\t    report.prior = await priorNotes(records, repo, result)\n527\t    writeReport(streams(ctx), f.format as Format, f.showDropped, report)\n528\t\n529\t    meta.usage = usageMeta(usage)\n530\t    meta.budgets = budgets\n531\t    let finalErr:Error|null = null\n532\t    try {\n533\t        await finalizeRun(records, meta, report, repo)\n534\t        const file = await reportPath(records, runId).catch(() => '')\n535\t        if (file) logf(ctx.stderr, `run ${runId} \\u00b7 report ${file}`)\n536\t    } catch (err) {\n537\t        if (ctx.signal.aborted) throw err\n538\t        finalErr = err as Error\n539\t    }\n540\t    const exit = reviewExitError(finalErr, gateRank, maxSeverity(result),\n541\t        partial)\n542\t    if (exit) throw exit\n543\t}\n544\t\n545\tasync function initializeRun (\n546\t    records:string,\n547\t    meta:Meta,\n548\t    artifacts:Record<string, string|Uint8Array>\n549\t):Promise<void> {\n550\t    try {\n551\t        try {\n552\t            await writeMeta(records, meta)\n553\t        } catch (err) {\n554\t            throw wrap('initialize run record', err)\n555\t        }\n556\t        for (const [name, content] of Object.entries(artifacts)) {\n557\t            try {\n558\t                await writeArtifact(records, meta.run_id, name, content)\n559\t            } catch (err) {\n560\t                throw wrap(`initialize run artifact ${name}`, err)\n561\t            }\n562\t        }\n563\t    } catch (err) {\n564\t        if (records) await removeRun(records, meta.run_id).catch(() => {})\n565\t        throw err\n566\t    }\n567\t}\n568\t\n569\tasync function finalizeRun (\n570\t    records:string,\n571\t    meta:Meta,\n572\t    report:Report,\n573\t    repo:string\n574\t):Promise<void> {\n575\t    try {\n576\t        await writeArtifact(records, meta.run_id, 'result.json',\n577\t            toJSON(report))\n578\t    } catch (err) {\n579\t        throw wrap('finalize run result', err)\n580\t    }\n581\t    try {\n582\t        await writeRunReport(records, meta.run_id, toMarkdown(report, true))\n583\t    } catch (err) {\n584\t        throw wrap('finalize run report', err)\n585\t    }\n586\t    try {\n587\t        await writeMeta(records, meta)\n588\t    } catch (err) {\n589\t        throw wrap('finalize run metadata', err)\n590\t    }\n591\t    let runDir:string\n592\t    try {\n593\t        runDir = await resolveRunDir(records, meta.run_id)\n594\t    } catch (err) {\n595\t        throw wrap('resolve run bundle directory', err)\n596\t    }\n597\t    try {\n598\t        buildBundle(runDir)\n599\t    } catch (err) {\n600\t        throw wrap('build local run bundle', err)\n601\t    }\n602\t    await appendRunLine(records, report, repo, meta.argv ?? null)\n603\t        .catch(() => {})\n604\t}\n605\t\n606\tfunction usageMeta (\n607\t    usage:Record<string, RecordUsage>\n608\t):NonNullable<Meta['usage']> {\n609\t    const out:NonNullable<Meta['usage']> = {}\n610\t    for (const [role, u] of Object.entries(usage)) {\n611\t        out[role] = {\n612\t            uncached_input_tokens:u.uncached_input_tokens,\n613\t            cached_input_tokens:u.cached_input_tokens,\n614\t            cache_write_tokens:u.cache_write_tokens,\n615\t            output_tokens:u.output_tokens,\n616\t            calls:u.calls,\n617\t        }\n618\t    }\n619\t    return out\n620\t}\n621\t\n622\tasync function priorNotes (\n623\t    records:string,\n624\t    repo:string,\n625\t    result:Result\n626\t):Promise<Map<string, string>|null> {\n627\t    const seen = await seenBefore(records, repo, result.findings, 3)\n628\t        .catch(() => new Map())\n629\t    if (seen.size === 0) return null\n630\t    const out = new Map<string, string>()\n631\t    for (const [fp, sighting] of seen) {\n632\t        let note = `seen previously in run ${sighting.runTS}`\n633\t        if (sighting.dropReason) note += ` (dropped: ${sighting.dropReason})`\n634\t        out.set(fp, note)\n635\t    }\n636\t    return out\n637\t}\n638\t\n639\tasync function insideRepository (ctx:RunContext):Promise<boolean> {\n640\t    try {\n641\t        await gitRoot(ctx.cwd, {\n642\t            env:ctx.env as NodeJS.ProcessEnv,\n643\t            signal:ctx.signal,\n644\t        })\n645\t        return true\n646\t    } catch (err) {\n647\t        if (ctx.signal.aborted) throw err\n648\t        return false\n649\t    }\n650\t}\n651\t\n652\tasync function reviewHandler (\n653\t    args:CommandArgs,\n654\t    ctx:RunContext\n655\t):Promise<void> {\n656\t    await maybeBootstrapGate(ctx)\n657\t    const explicit = ctx.path.length > 0\n658\t    if (!explicit && !(await insideRepository(ctx))) {\n659\t        ctx.stderr.write('roast: not in a Git repository; cd into one to ' +\n660\t            'review, or try `roast doctor` / `roast --help`\\n')\n661\t        ctx.stdout.write(await ctx.rootHelp())\n662\t        return\n663\t    }\n664\t    await runReview(parseReviewFlags(args, ctx.argv), ctx)\n665\t}\n666\t\n667\texport const reviewCommand:CommandDef = {\n668\t    command:['review', '$0'],\n669\t    describe:'Review the current changes (the default command)',\n670\t    builder:reviewBuilder,\n671\t    handler:reviewHandler,\n672\t}\n673\t"}]},"parent_tool_use_id":null,"session_id":"7ad23c81-404a-48c1-af0c-22c3c0a830e9","uuid":"2b0c5b98-707b-46e0-84b8-d72f2c529619","timestamp":"2026-11-24T01:50:51.807Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.ts-rewrite-22-review-snapshots/src/cli/review.ts","content":"// `roast review`, also the default command: the review orchestration of\n// spec 01, 2.8. Verification (step 17) and snapshots are other tickets:\n// the verifier step passes the finder result through, and snapshot\n// capture is injected (see snapshot-meta.ts).\nimport type { Writable } from 'node:stream'\nimport { buildInfo } from '../buildinfo.js'\nimport {\n    type ProjectConfig,\n    credentialEnvNames,\n    promptPath,\n    snapshotEnabled,\n} from '../config/load.js'\nimport { DEFAULT_LIMITS } from '../config/defaults.js'\nimport { resolveFinderFlip, resolveRole, validateRole }\n    from '../config/role.js'\nimport type { ResolvedRole } from '../config/resolved-role.js'\nimport { buildFileContext } from '../context/snippet.js'\nimport { newQuoteGrounder } from '../context/grounding.js'\nimport { explorationTools } from '../context/tools.js'\nimport { LIVE_TREE, pinIndexTree, type Tree } from '../context/tree.js'\nimport { gitRoot } from '../git/git.js'\nimport {\n    type GoDuration,\n    formatGoDuration,\n    parseGoDuration,\n    toMillis,\n} from '../gocompat/duration.js'\nimport { createClient, createModelClient } from '../llm/client.js'\nimport { type Ledger, committed, newLedger } from '../llm/ledger.js'\nimport type {\n    Client, ClientConfig, Protocol, RawResponse, RecordUsage, Tool,\n} from '../llm/types.js'\nimport { finderSystem, verifierSystem } from '../prompts/index.js'\nimport { renderFinderUser } from '../prompts/render.js'\nimport { recordDir } from '../record/dir.js'\nimport { openFindingSpill } from '../record/findings.js'\nimport { appendRunLine, seenBefore } from '../record/index-file.js'\nimport {\n    type Meta,\n    type RoleMeta,\n    captureEnv,\n    digest,\n    removeRun,\n    reportPath,\n    resolveRunDir,\n    writeArtifact,\n    writeMeta,\n    writeReport as writeRunReport,\n} from '../record/meta.js'\nimport { rfc3339NanoUTC } from '../record/json.js'\nimport { ResponseRecorder } from '../record/responses.js'\nimport { newRunId } from '../record/run-id.js'\nimport { toJSON, toMarkdown, type Report } from '../render/render.js'\nimport { writeReport } from '../render/write.js'\nimport { classifyMode } from '../review/classify.js'\nimport { find } from '../review/find.js'\nimport {\n    type Result, type WireFinding, maxSeverity,\n} from '../review/types.js'\nimport { buildBundle } from '../runbundle/bundle.js'\nimport { build, fit, isEmpty, type BuildOpts } from '../scope/index.js'\nimport { ExitSignal, UsageError } from './errors.js'\nimport type { CommandArgs, CommandDef, RunContext } from './command.js'\nimport { loadProjectConfig } from './config.js'\nimport { logf } from './log.js'\nimport {\n    DEFAULT_MAX_TURNS,\n    SURVEY_MAX_TURNS,\n    type ReviewFlags,\n    parseReviewFlags,\n    reviewBuilder,\n    validateReviewFlags,\n} from './review-flags.js'\nimport {\n    applyRoleFlags,\n    configInt,\n    flagOrConfig,\n    resolveLangs,\n} from './resolve.js'\nimport {\n    type SnapshotDeps,\n    captureSnapshot,\n    defaultSnapshotDeps,\n} from './snapshot-meta.js'\nimport { requireTrust } from './trust.js'\n\nconst QUICK_DIFF_BYTES = 200_000\nconst QUICK_FILE_CTX_BYTES = 100_000\nconst SURVEY_DEADLINE = '25m'\nconst INTERACTIVE_MIN_DIFF_LINES = 80\nconst INTERACTIVE_MIN_FILES = 4\n\n// Swappable for tests: the snapshot area's functions (ticket 22).\nexport const reviewHooks:{\n    snapshot:((ctx:RunContext) => SnapshotDeps)|null;\n} = { snapshot:null }\n\n// Exit selection after a completed run (spec 01, 2.2): a finalize\n// failure wins over the severity gate.\nexport function reviewExitError (\n    finalErr:Error|null,\n    gateRank:number,\n    maxSev:number,\n    partial:boolean\n):Error|null {\n    if (finalErr) return finalErr\n    if (gateRank >= 0 && maxSev >= gateRank) return new ExitSignal(1)\n    if (partial) return new ExitSignal(4)\n    return null\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\n// Config and role failures are usage errors carrying the config area's\n// message.\nfunction asUsage<T> (fn:() => T):T {\n    try {\n        return fn()\n    } catch (err) {\n        if (err instanceof UsageError) throw err\n        throw new UsageError(message(err), { cause:err })\n    }\n}\n\nfunction wrap (prefix:string, err:unknown):Error {\n    return new Error(`${prefix}: ${message(err)}`, { cause:err })\n}\n\nfunction roleMeta (role:ResolvedRole, system:string):RoleMeta {\n    return {\n        profile:role.profile,\n        base_url:role.baseURL,\n        model:role.model,\n        protocol:role.protocol,\n        max_output_tokens:role.maxOutputTokens,\n        session_header:role.sessionHeader,\n        prompt_digest:digest(system),\n    }\n}\n\nfunction clientConfig (\n    name:string,\n    role:ResolvedRole,\n    capture:(raw:RawResponse) => Promise<void>,\n    maxAttempts:number,\n    requestTimeout:GoDuration,\n    fetch:typeof globalThis.fetch\n):ClientConfig {\n    return {\n        role:name,\n        baseUrl:role.baseURL.replace(/\\/+$/, ''),\n        apiKey:role.apiKey,\n        model:role.model,\n        protocol:role.protocol as ''|Protocol,\n        maxOutputTokens:role.maxOutputTokens,\n        sessionHeader:role.sessionHeader,\n        maxAttempts,\n        requestTimeoutMs:toMillis(requestTimeout),\n        captureResponse:capture,\n        fetch,\n    }\n}\n\nfunction newClient (\n    config:ClientConfig,\n    ledger:Ledger|null\n):Client {\n    return createClient(createModelClient(config), { ledger })\n}\n\ntype Format = 'json'|'markdown'|'both'\n\nfunction streams (ctx:RunContext):{ stdout:Writable, stderr:Writable } {\n    return {\n        stdout:ctx.stdout as Writable,\n        stderr:ctx.stderr as Writable,\n    }\n}\n\nfunction countNewlines (s:string):number {\n    let n = 0\n    for (let i = s.indexOf('\\n'); i >= 0; i = s.indexOf('\\n', i + 1)) n++\n    return n\n}\n\nfunction utf8Bytes (s:string):number {\n    return Buffer.byteLength(s, 'utf8')\n}\n\n// The gate bootstrap offer (spec 01, 2.9) runs here once ticket 30\n// lands; it is a no-op until then.\nasync function maybeBootstrapGate (_ctx:RunContext):Promise<void> {}\n\ninterface Roles {\n    finder:ResolvedRole;\n    verifier:ResolvedRole;\n    doVerify:boolean;\n}\n\nfunction resolveRoles (\n    cfg:ProjectConfig,\n    f:ReviewFlags,\n    ctx:RunContext\n):Roles {\n    return asUsage(() => {\n        let finder = resolveRole(cfg, 'finder', ctx.env)\n        let verifier = resolveRole(cfg, 'verifier', ctx.env)\n        finder = applyRoleFlags('finder', finder, f.finder, ctx.env)\n        verifier = applyRoleFlags('verifier', verifier, f.verifier, ctx.env)\n        const flip = resolveFinderFlip(cfg, finder, f.authorModel, ctx.env)\n        if (flip.note) logf(ctx.stderr, flip.note)\n        if (flip.warn) logf(ctx.stderr, flip.warn)\n        finder = flip.role\n        validateRole('finder', finder)\n        const doVerify = !f.quick && !f.noVerify\n        if (doVerify) validateRole('verifier', verifier)\n        return { finder, verifier, doVerify }\n    })\n}\n\nexport async function runReview (\n    f:ReviewFlags,\n    ctx:RunContext\n):Promise<void> {\n    const gateRank = validateReviewFlags(f)\n    const gitOpts = { env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal }\n    const cfg = await loadProjectConfig(f.config, ctx)\n    const roles = resolveRoles(cfg, f, ctx)\n    const { doVerify } = roles\n\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, gitOpts)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw new UsageError(message(err), { cause:err })\n    }\n    await requireTrust(repo, cfg, ctx)\n\n    const survey = f.scope === 'repo'\n    const limits = cfg.limits ?? {}\n    const excludes = [...(cfg.review.excludes ?? []), ...f.exclude]\n    const maxDiff = configInt(limits.max_diff_bytes, f.quick ?\n        QUICK_DIFF_BYTES : DEFAULT_LIMITS.max_diff_bytes)\n    const buildOpts:BuildOpts = {\n        base:f.base,\n        uncommittedOnly:f.uncommittedOnly,\n        stagedOnly:f.staged,\n        paths:f.paths,\n        excludes,\n        includeVendored:f.includeVendored,\n        scope:f.scope,\n        maxFileDiffBytes:maxDiff,\n        env:gitOpts.env,\n    }\n    let tree:Tree = LIVE_TREE\n    if (f.staged) {\n        try {\n            tree = await pinIndexTree(repo, ctx.signal, { env:gitOpts.env })\n        } catch (err) {\n            if (ctx.signal.aborted) throw err\n            throw wrap('pin staged tree', err)\n        }\n        buildOpts.stagedTreeOID = tree.oid\n    }\n    let sc = await build(repo, buildOpts, ctx.signal)\n    for (const note of sc.notes) logf(ctx.stderr, note)\n\n    if (isEmpty(sc)) {\n        writeReport(streams(ctx), f.format as Format, f.showDropped, {\n            result:{\n                assessment:'NO_DIFF', findings:[], dropped:[], notes:[],\n            },\n            mode:'code',\n            filesReviewed:[],\n            task:f.task,\n        })\n        return\n    }\n\n    const inputKind = survey ? 'manifest' : 'diff'\n    const reviewedInput = survey ?\n        Buffer.from(sc.manifest, 'utf8') :\n        sc.diffBytes\n    const runId = newRunId()\n    const indexTree = tree.oid\n    // No worktree pin until the snapshot area lands: non-staged reviews\n    // read the live tree, which the context area guards.\n    const snapDeps = reviewHooks.snapshot?.(ctx) ??\n        defaultSnapshotDeps(gitOpts)\n    const snap = await captureSnapshot(snapshotEnabled(cfg), repo, runId,\n        sc, indexTree, null, snapDeps)\n\n    const ground = newQuoteGrounder(repo, tree, sc.diffBytes, gitOpts)\n    const originalDiffBytes = sc.diffBytes.length\n    const maxFileContext = configInt(limits.max_file_ctx_bytes, f.quick ?\n        QUICK_FILE_CTX_BYTES : DEFAULT_LIMITS.max_file_ctx_bytes)\n    const fitted = fit(sc, maxDiff)\n    sc = fitted.scope\n    const breakdown = fitted.breakdown ?? []\n\n    let mode = f.mode\n    if (mode === 'auto') mode = classifyMode([...sc.files])\n    if (!['code', 'prose', 'mixed'].includes(mode)) {\n        throw new UsageError(`invalid --mode ${JSON.stringify(f.mode)}`)\n    }\n    const langs = resolveLangs(f.lang, [...sc.files], mode)\n    const overrides = cfg.prompts ?? {}\n    const finderPrompt = (mode === 'prose' ?\n        overrides.finder_prose :\n        overrides.finder_code) ?? ''\n    const system = await finderSystem(mode, f.scope, f.quick, langs,\n        promptPath(cfg, finderPrompt))\n    const verifierPrompt = await verifierSystem(\n        promptPath(cfg, overrides.verifier ?? ''))\n    const user = survey ?\n        renderFinderUser({\n            task:f.task,\n            survey:true,\n            manifest:sc.manifest,\n            diff:'',\n            fileContext:'',\n        }) :\n        renderFinderUser({\n            task:f.task,\n            survey:false,\n            diff:sc.diff,\n            fileContext:await buildFileContext(repo, sc.files,\n                maxFileContext, tree, gitOpts),\n            manifest:'',\n        })\n\n    const maxTokensTotal = flagOrConfig(f.maxTokensTotal,\n        limits.max_total_tokens, DEFAULT_LIMITS.max_total_tokens)\n    const maxVerified = flagOrConfig(f.maxVerified, limits.max_verified,\n        DEFAULT_LIMITS.max_verified)\n    const requestTimeout = flagOrConfig(f.requestTimeout,\n        limits.request_timeout,\n        parseGoDuration(DEFAULT_LIMITS.request_timeout))\n    const maxAttempts = flagOrConfig(f.maxAttempts, limits.max_attempts,\n        DEFAULT_LIMITS.max_attempts)\n    const ledger = newLedger(maxTokensTotal)\n    let interactive = f.interactive && !f.quick\n    let maxTurns = f.maxTurns ?? DEFAULT_MAX_TURNS\n    if (survey) {\n        interactive = true\n        if (f.maxTurns === undefined) maxTurns = SURVEY_MAX_TURNS\n    }\n    if (interactive && !survey) {\n        const minLines = configInt(cfg.interactive?.min_diff_lines,\n            INTERACTIVE_MIN_DIFF_LINES)\n        const minFiles = configInt(cfg.interactive?.min_files,\n            INTERACTIVE_MIN_FILES)\n        if (countNewlines(sc.diff) < minLines && sc.files.length < minFiles) {\n            logf(ctx.stderr,\n                'diff is small; using a single structured finder call')\n            interactive = false\n        }\n    }\n    const deadlineDuration = flagOrConfig(f.deadline, limits.deadline,\n        parseGoDuration(survey ? SURVEY_DEADLINE : DEFAULT_LIMITS.deadline))\n    const deadline = deadlineDuration > 0n ?\n        Date.now() + toMillis(deadlineDuration) :\n        undefined\n    const promptCeiling = configInt(limits.max_prompt_bytes,\n        DEFAULT_LIMITS.max_prompt_bytes)\n    const budgets:Record<string, unknown> = {\n        deadline_duration:formatGoDuration(deadlineDuration),\n        request_timeout:formatGoDuration(requestTimeout),\n        max_total_tokens:maxTokensTotal,\n        verifier_cap:maxVerified,\n        max_turns:maxTurns,\n        max_attempts:maxAttempts,\n        max_prompt_bytes:promptCeiling,\n    }\n    const tools:readonly Tool[] = interactive ?\n        explorationTools(repo, tree, { env:gitOpts.env }) :\n        []\n    const floor = f.quick ?\n        cfg.review.quick_confidence_floor :\n        cfg.review.confidence_floor\n    const promptBytes = utf8Bytes(system) + utf8Bytes(user)\n    if (promptBytes > promptCeiling) {\n        throw new UsageError(`finder prompt is ${promptBytes} bytes, over ` +\n            `the ${promptCeiling}-byte ceiling; narrow the review scope or ` +\n            'adjust limits.max_diff_bytes, limits.max_file_ctx_bytes, or ' +\n            'limits.max_prompt_bytes in the project config')\n    }\n\n    const meta:Meta = {\n        run_id:runId,\n        ts:rfc3339NanoUTC(new Date()),\n        repo,\n        argv:[...ctx.argv],\n        roast:{ version:buildInfo.version, commit:buildInfo.commit },\n        scope:{\n            kind:f.scope,\n            base:sc.base,\n            uncommitted_only:f.uncommittedOnly,\n            staged_only:f.staged,\n            include_vendored:f.includeVendored,\n            paths:[...f.paths],\n            excludes:[...excludes],\n            base_oid:snap.meta.base ?? '',\n            merge_base_oid:'',\n            head_oid:sc.headOID || (snap.meta.head ?? ''),\n            survey:sc.survey,\n            staged:sc.staged,\n            files:[...sc.files],\n        },\n        derived:{\n            mode,\n            langs:[...langs],\n            quick:f.quick,\n            interactive,\n            max_turns:maxTurns,\n            confidence_floor:floor,\n            do_verify:doVerify,\n            task:f.task,\n            max_severity:f.maxSeverity,\n            max_diff_bytes:maxDiff,\n            max_file_ctx_bytes:maxFileContext,\n        },\n        roles:{\n            finder:roleMeta(roles.finder, system),\n            verifier:roleMeta(roles.verifier, verifierPrompt),\n        },\n        snapshot:snap.meta,\n        digests:{\n            input_kind:inputKind,\n            input:digest(reviewedInput),\n            input_bytes:reviewedInput.length,\n            system_prompt:digest(system),\n            user_prompt:digest(user),\n        },\n        budgets,\n        env_names_only:captureEnv(ctx.env as NodeJS.ProcessEnv,\n            credentialEnvNames(cfg)),\n        caveats:snap.caveats,\n    }\n    const records = await recordDir(repo, gitOpts)\n    await initializeRun(records, meta, {\n        input:reviewedInput,\n        finder_system:system,\n        finder