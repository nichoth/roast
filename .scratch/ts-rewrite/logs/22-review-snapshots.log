{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nq1aaLb8JbSJaV32yopdSp","type":"tool_result","content":"// Temporary Git repositories for scope and denylist tests. Each repo gets\n// its own HOME, XDG_CONFIG_HOME and global config file, so the user's Git\n// config never reaches these tests and a test may write hostile config.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { execFileSync } from 'node:child_process'\n\nexport interface TestRepo {\n    dir:string;\n    env:NodeJS.ProcessEnv;\n    // The isolated global config file (GIT_CONFIG_GLOBAL).\n    globalConfig:string;\n    // Runs git in the repo and returns stdout.\n    git (...args:string[]):string;\n    write (rel:string, content:string|Buffer):void;\n    commitAll (msg?:string):void;\n    cleanup ():void;\n}\n\nexport function tempDir (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\nexport function newRepo (opts:{ commit?:boolean } = {}):TestRepo {\n    const home = tempDir('roast-scope-home-')\n    const dir = tempDir('roast-scope-repo-')\n    const globalConfig = path.join(home, 'gitconfig')\n    fs.writeFileSync(globalConfig, '')\n    const env:NodeJS.ProcessEnv = {\n        PATH:process.env.PATH ?? '/usr/bin:/bin',\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        GIT_CONFIG_GLOBAL:globalConfig,\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_AUTHOR_NAME:'test',\n        GIT_AUTHOR_EMAIL:'test@example.com',\n        GIT_COMMITTER_NAME:'test',\n        GIT_COMMITTER_EMAIL:'test@example.com',\n    }\n    const repo:TestRepo = {\n        dir,\n        env,\n        globalConfig,\n        git (...args) {\n            return execFileSync('git', ['-C', dir, ...args], {\n                env,\n                encoding:'utf8',\n                stdio:['ignore', 'pipe', 'pipe'],\n                maxBuffer:Infinity,\n            })\n        },\n        write (rel, content) {\n            const p = path.join(dir, rel)\n            fs.mkdirSync(path.dirname(p), { recursive:true })\n            fs.writeFileSync(p, content)\n        },\n        commitAll (msg = 'commit') {\n            repo.git('add', '-A')\n            repo.git('commit', '-q', '--allow-empty', '-m', msg)\n        },\n        cleanup () {\n            fs.rmSync(dir, { recursive:true, force:true })\n            fs.rmSync(home, { recursive:true, force:true })\n        },\n    }\n    repo.git('init', '-q', '-b', 'main')\n    if (opts.commit !== false) {\n        repo.write('README.md', 'hello\\n')\n        repo.commitAll('initial')\n    }\n    return repo\n}\n\n// Lines of text, n of them, each distinct.\nexport function lines (n:number, prefix = 'line'):string {\n    let out = ''\n    for (let i = 0; i < n; i++) out += `${prefix} ${i}\\n`\n    return out\n}\n\n// Paths named in `diff --git a/P b/P` headers, in order.\nexport function sectionPaths (diff:string):string[] {\n    const out:string[] = []\n    for (const line of diff.split('\\n')) {\n        const m = /^diff --git a\\/(.*) b\\/(.*)$/.exec(line)\n        if (m) out.push(m[2])\n    }\n    return out\n}\n// Fixtures for end-to-end review tests (Go settingsRepo, loginRepo):\n// a temporary Git repository with a committed file and an uncommitted\n// change, a project config pointing at a fake chat server, and helpers\n// that read the run record a review wrote.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { gunzipSync } from 'node:zlib'\nimport type { CleanupTest } from './test.js'\nimport { tempRepo, type TempDir } from './repo.js'\nimport { runRoast, type RunRoastResult } from './run.js'\nimport {\n    type InferenceServer,\n    type RecordedRequest,\n    type Script,\n    startInferenceServer,\n} from './inference-server.js'\n\nexport const FINDER_KEY = 'finder-secret-key-do-not-print'\nexport const VERIFIER_KEY = 'verifier-secret-key-do-not-print'\n\nexport interface ReviewRepo extends TempDir {\n    server:InferenceServer;\n    // Runs roast in the repository against the fake server.\n    roast (args:string[], opts?:{\n        cwd?:string,\n        stdin?:string|NodeJS.ReadableStream,\n        signal?:AbortSignal,\n    }):Promise<RunRoastResult>;\n}\n\nexport function gitIn (r:TempDir, args:string[], cwd = r.dir):string {\n    return execFileSync('git', args, { cwd, env:r.env }).toString()\n}\n\nexport type Wire = {\n    severity:string;\n    confidence:number;\n    file:string;\n    lines:number[];\n    code_quote:string;\n    fixed_code:string;\n    description:string;\n    reasoning:string;\n    cwe:string;\n    frontend_category:string;\n}\n\nexport function finding (over:Partial<Wire> = {}):Wire {\n    return {\n        reasoning:'The guard is missing.',\n        severity:'HIGH',\n        confidence:0.9,\n        cwe:'',\n        description:'Missing guard',\n        file:'main.go',\n        lines:[3],\n        code_quote:'return value',\n        fixed_code:'return value + 1',\n        frontend_category:'',\n        ...over,\n    }\n}\n\ntype Call = { name:string, args:unknown }\n\n// A chat completion whose single choice calls `calls`.\nexport function chatCalls (calls:Call[], model = 'finder-model') {\n    return {\n        id:'c1',\n        model,\n        choices:[{\n            index:0,\n            finish_reason:calls.length ? 'tool_calls' : 'stop',\n            message:{\n                role:'assistant',\n                content:calls.length ? '' : 'done',\n                tool_calls:calls.map((c, i) => ({\n                    id:`call-${i}`,\n                    type:'function',\n                    function:{\n                        name:c.name, arguments:JSON.stringify(c.args),\n                    },\n                })),\n            },\n        }],\n        usage:{ prompt_tokens:100, completion_tokens:20, total_tokens:120 },\n    }\n}\n\n// The structured finder answer (one `findings` tool call).\nexport function findingsReply (findings:Wire[] = []) {\n    return {\n        stream:chatCalls([{\n            name:'findings',\n            args:{\n                assessment:findings.length ?\n                    'FINDINGS_PRESENT' :\n                    'NO_FINDINGS',\n                findings,\n            },\n        }]),\n    }\n}\n\n// The name of the final tool a chat request offers ('findings' for a\n// structured call, 'submit_findings' for an interactive one).\nexport function toolNames (req:RecordedRequest):string[] {\n    const body = req.body as { tools?:{ function:{ name:string } }[] }\n    return (body?.tools ?? []).map(t => t.function.name)\n}\n\n// A finder that answers every structured call with `findings`.\nexport function finderScript (findings:Wire[] = []):Script {\n    return () => findingsReply(findings)\n}\n\nexport function profileConfig (url:string, over:object = {}) {\n    return {\n        version:1,\n        inference_profiles:{\n            fake:{\n                model:'finder-model',\n                endpoint:`${url}/v1`,\n                protocol:'chat',\n                api_key_env:'ROAST_FINDER_API_KEY',\n                max_output_tokens:4096,\n            },\n        },\n        roles:{ finder:{ profile:'fake' }, verifier:{ profile:'fake' } },\n        review:{ snapshot:false },\n        ...over,\n    }\n}\n\nexport function writeConfig (dir:string, cfg:object, name = '.roast.json') {\n    fs.mkdirSync(dir, { recursive:true })\n    fs.writeFileSync(path.join(dir, name), JSON.stringify(cfg, null, 2))\n}\n\nconst ORIGINAL = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\treturn value\\n}\\n'\nconst CHANGED = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\tif value < 0 {\\n\\t\\treturn 0\\n\\t}\\n\\treturn value\\n}\\n'\n\n// Go settingsRepo: a repository with one commit and an uncommitted\n// change to main.go, a config on a fake chat server, and finder and\n// verifier keys in the environment. The process chdirs into the\n// repository so nothing leaks into this checkout.\nexport async function settingsRepo (\n    t:CleanupTest,\n    script:Script = finderScript(),\n    opts:{ config?:object|null, approve?:boolean } = {}\n):Promise<ReviewRepo> {\n    const r = tempRepo('roast-review-')\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    const server = await startInferenceServer(script)\n    t.cleanup(() => server.close())\n    r.env.ROAST_FINDER_API_KEY = FINDER_KEY\n    r.env.ROAST_VERIFIER_API_KEY = VERIFIER_KEY\n    fs.writeFileSync(path.join(r.dir, 'main.go'), ORIGINAL)\n    gitIn(r, ['add', 'main.go'])\n    gitIn(r, ['commit', '-q', '-m', 'initial'])\n    fs.writeFileSync(path.join(r.dir, 'main.go'), CHANGED)\n    if (opts.config !== null) {\n        writeConfig(r.dir, opts.config ?? profileConfig(server.url))\n    }\n    const repo:ReviewRepo = {\n        ...r,\n        server,\n        roast:(args, o = {}) => runRoast(args, {\n            cwd:o.cwd ?? r.dir,\n            env:r.env,\n            stdin:o.stdin,\n            signal:o.signal,\n            redirectTo:server.url,\n        }),\n    }\n    if (opts.approve !== false && opts.config !== null) {\n        await approveProjectConfig(repo)\n    }\n    return repo\n}\n\n// `roast trust --yes` for the discovered (or given) config.\nexport async function approveProjectConfig (\n    r:ReviewRepo,\n    args:string[] = [],\n    cwd = r.dir\n):Promise<void> {\n    const res = await runRoast(['trust', '--yes', ...args],\n        { cwd, env:r.env })\n    if (res.code !== 0) throw new Error(`trust failed: ${res.stderr}`)\n}\n\n// Inference requests the fake server received (it serves nothing else).\nexport function requestRecorder (r:ReviewRepo):() => RecordedRequest[] {\n    const start = r.server.requests.length\n    return () => r.server.requests.slice(start)\n}\n\nexport function runsDir (r:TempDir):string {\n    return path.join(r.dir, '.roast', 'runs')\n}\n\n// The run directories a review wrote, sorted.\nexport function runDirs (r:TempDir):string[] {\n    const dir = runsDir(r)\n    if (!fs.existsSync(dir)) return []\n    return fs.readdirSync(dir, { withFileTypes:true })\n        .filter(e => e.isDirectory())\n        .map(e => path.join(dir, e.name))\n        .sort()\n}\n\n// The parsed meta.json of the only run.\nexport function reviewMeta (r:TempDir):Record<string, any> {\n    const dirs = runDirs(r)\n    if (dirs.length !== 1) {\n        throw new Error(`expected one run, found ${dirs.length}`)\n    }\n    return JSON.parse(fs.readFileSync(path.join(dirs[0], 'meta.json'),\n        'utf8'))\n}\n\nexport function readGz (file:string):string {\n    return gunzipSync(fs.readFileSync(file)).toString('utf8')\n}\n\n// Every file under `dir`, recursively.\nexport function filesUnder (dir:string):string[] {\n    if (!fs.existsSync(dir)) return []\n    return fs.readdirSync(dir, { withFileTypes:true, recursive:true })\n        .filter(e => e.isFile())\n        .map(e => path.join(e.parentPath, e.name))\n}\ntest/cli/review-config.ts:179:    t.equal(meta.snapshot.captured, false, 'snapshot still disabled')\ntest/cli/review-trust.ts:61:        review:{ snapshot:false },\ntest/cli/review-trust.ts:112:        review:{ snapshot:false },\ntest/cli/review-units.ts:2:// resolution helpers (2.8 step 11, 2.14), and the snapshot decision\ntest/cli/review-units.ts:16:    captureSnapshot,\ntest/cli/review-units.ts:17:} from '../../src/cli/snapshot-meta.js'\ntest/cli/review-units.ts:97:test('captureSnapshot: disabled branch', async t => {\ntest/cli/review-units.ts:99:    const res = await captureSnapshot(false, '/repo', 'run', SCOPE, '',\ntest/cli/review-units.ts:102:        captured:false, reason:'disabled by review.snapshot',\ntest/cli/review-units.ts:108:test('captureSnapshot: failure and diff pairs', async t => {\ntest/cli/review-units.ts:109:    const failed = await captureSnapshot(true, '/repo', 'run',\ntest/cli/review-units.ts:133:        const res = await captureSnapshot(true, '/repo', 'run',\ntest/cli/review-records.ts:206:test('review.snapshot false records the disabled snapshot', async t => {\ntest/cli/review-records.ts:210:    t.equal(meta.snapshot.captured, false, 'not captured')\ntest/cli/review-records.ts:211:    t.equal(meta.snapshot.reason, 'disabled by review.snapshot', 'reason')","is_error":false}]},"parent_tool_use_id":null,"session_id":"7ad23c81-404a-48c1-af0c-22c3c0a830e9","uuid":"940af143-817d-4328-97b9-9ad6755f4b7a","timestamp":"2026-11-24T01:51:06.101Z","tool_use_result":{"stdout":"// Temporary Git repositories for scope and denylist tests. Each repo gets\n// its own HOME, XDG_CONFIG_HOME and global config file, so the user's Git\n// config never reaches these tests and a test may write hostile config.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { execFileSync } from 'node:child_process'\n\nexport interface TestRepo {\n    dir:string;\n    env:NodeJS.ProcessEnv;\n    // The isolated global config file (GIT_CONFIG_GLOBAL).\n    globalConfig:string;\n    // Runs git in the repo and returns stdout.\n    git (...args:string[]):string;\n    write (rel:string, content:string|Buffer):void;\n    commitAll (msg?:string):void;\n    cleanup ():void;\n}\n\nexport function tempDir (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\nexport function newRepo (opts:{ commit?:boolean } = {}):TestRepo {\n    const home = tempDir('roast-scope-home-')\n    const dir = tempDir('roast-scope-repo-')\n    const globalConfig = path.join(home, 'gitconfig')\n    fs.writeFileSync(globalConfig, '')\n    const env:NodeJS.ProcessEnv = {\n        PATH:process.env.PATH ?? '/usr/bin:/bin',\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        GIT_CONFIG_GLOBAL:globalConfig,\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_AUTHOR_NAME:'test',\n        GIT_AUTHOR_EMAIL:'test@example.com',\n        GIT_COMMITTER_NAME:'test',\n        GIT_COMMITTER_EMAIL:'test@example.com',\n    }\n    const repo:TestRepo = {\n        dir,\n        env,\n        globalConfig,\n        git (...args) {\n            return execFileSync('git', ['-C', dir, ...args], {\n                env,\n                encoding:'utf8',\n                stdio:['ignore', 'pipe', 'pipe'],\n                maxBuffer:Infinity,\n            })\n        },\n        write (rel, content) {\n            const p = path.join(dir, rel)\n            fs.mkdirSync(path.dirname(p), { recursive:true })\n            fs.writeFileSync(p, content)\n        },\n        commitAll (msg = 'commit') {\n            repo.git('add', '-A')\n            repo.git('commit', '-q', '--allow-empty', '-m', msg)\n        },\n        cleanup () {\n            fs.rmSync(dir, { recursive:true, force:true })\n            fs.rmSync(home, { recursive:true, force:true })\n        },\n    }\n    repo.git('init', '-q', '-b', 'main')\n    if (opts.commit !== false) {\n        repo.write('README.md', 'hello\\n')\n        repo.commitAll('initial')\n    }\n    return repo\n}\n\n// Lines of text, n of them, each distinct.\nexport function lines (n:number, prefix = 'line'):string {\n    let out = ''\n    for (let i = 0; i < n; i++) out += `${prefix} ${i}\\n`\n    return out\n}\n\n// Paths named in `diff --git a/P b/P` headers, in order.\nexport function sectionPaths (diff:string):string[] {\n    const out:string[] = []\n    for (const line of diff.split('\\n')) {\n        const m = /^diff --git a\\/(.*) b\\/(.*)$/.exec(line)\n        if (m) out.push(m[2])\n    }\n    return out\n}\n// Fixtures for end-to-end review tests (Go settingsRepo, loginRepo):\n// a temporary Git repository with a committed file and an uncommitted\n// change, a project config pointing at a fake chat server, and helpers\n// that read the run record a review wrote.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { gunzipSync } from 'node:zlib'\nimport type { CleanupTest } from './test.js'\nimport { tempRepo, type TempDir } from './repo.js'\nimport { runRoast, type RunRoastResult } from './run.js'\nimport {\n    type InferenceServer,\n    type RecordedRequest,\n    type Script,\n    startInferenceServer,\n} from './inference-server.js'\n\nexport const FINDER_KEY = 'finder-secret-key-do-not-print'\nexport const VERIFIER_KEY = 'verifier-secret-key-do-not-print'\n\nexport interface ReviewRepo extends TempDir {\n    server:InferenceServer;\n    // Runs roast in the repository against the fake server.\n    roast (args:string[], opts?:{\n        cwd?:string,\n        stdin?:string|NodeJS.ReadableStream,\n        signal?:AbortSignal,\n    }):Promise<RunRoastResult>;\n}\n\nexport function gitIn (r:TempDir, args:string[], cwd = r.dir):string {\n    return execFileSync('git', args, { cwd, env:r.env }).toString()\n}\n\nexport type Wire = {\n    severity:string;\n    confidence:number;\n    file:string;\n    lines:number[];\n    code_quote:string;\n    fixed_code:string;\n    description:string;\n    reasoning:string;\n    cwe:string;\n    frontend_category:string;\n}\n\nexport function finding (over:Partial<Wire> = {}):Wire {\n    return {\n        reasoning:'The guard is missing.',\n        severity:'HIGH',\n        confidence:0.9,\n        cwe:'',\n        description:'Missing guard',\n        file:'main.go',\n        lines:[3],\n        code_quote:'return value',\n        fixed_code:'return value + 1',\n        frontend_category:'',\n        ...over,\n    }\n}\n\ntype Call = { name:string, args:unknown }\n\n// A chat completion whose single choice calls `calls`.\nexport function chatCalls (calls:Call[], model = 'finder-model') {\n    return {\n        id:'c1',\n        model,\n        choices:[{\n            index:0,\n            finish_reason:calls.length ? 'tool_calls' : 'stop',\n            message:{\n                role:'assistant',\n                content:calls.length ? '' : 'done',\n                tool_calls:calls.map((c, i) => ({\n                    id:`call-${i}`,\n                    type:'function',\n                    function:{\n                        name:c.name, arguments:JSON.stringify(c.args),\n                    },\n                })),\n            },\n        }],\n        usage:{ prompt_tokens:100, completion_tokens:20, total_tokens:120 },\n    }\n}\n\n// The structured finder answer (one `findings` tool call).\nexport function findingsReply (findings:Wire[] = []) {\n    return {\n        stream:chatCalls([{\n            name:'findings',\n            args:{\n                assessment:findings.length ?\n                    'FINDINGS_PRESENT' :\n                    'NO_FINDINGS',\n                findings,\n            },\n        }]),\n    }\n}\n\n// The name of the final tool a chat request offers ('findings' for a\n// structured call, 'submit_findings' for an interactive one).\nexport function toolNames (req:RecordedRequest):string[] {\n    const body = req.body as { tools?:{ function:{ name:string } }[] }\n    return (body?.tools ?? []).map(t => t.function.name)\n}\n\n// A finder that answers every structured call with `findings`.\nexport function finderScript (findings:Wire[] = []):Script {\n    return () => findingsReply(findings)\n}\n\nexport function profileConfig (url:string, over:object = {}) {\n    return {\n        version:1,\n        inference_profiles:{\n            fake:{\n                model:'finder-model',\n                endpoint:`${url}/v1`,\n                protocol:'chat',\n                api_key_env:'ROAST_FINDER_API_KEY',\n                max_output_tokens:4096,\n            },\n        },\n        roles:{ finder:{ profile:'fake' }, verifier:{ profile:'fake' } },\n        review:{ snapshot:false },\n        ...over,\n    }\n}\n\nexport function writeConfig (dir:string, cfg:object, name = '.roast.json') {\n    fs.mkdirSync(dir, { recursive:true })\n    fs.writeFileSync(path.join(dir, name), JSON.stringify(cfg, null, 2))\n}\n\nconst ORIGINAL = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\treturn value\\n}\\n'\nconst CHANGED = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\tif value < 0 {\\n\\t\\treturn 0\\n\\t}\\n\\treturn value\\n}\\n'\n\n// Go settingsRepo: a repository with one commit and an uncommitted\n// change to main.go, a config on a fake chat server, and finder and\n// verifier keys in the environment. The process chdirs into the\n// repository so nothing leaks into this checkout.\nexport async function settingsRepo (\n    t:CleanupTest,\n    script:Script = finderScript(),\n    opts:{ config?:object|null, approve?:boolean } = {}\n):Promise<ReviewRepo> {\n    const r = tempRepo('roast-review-')\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    const server = await startInferenceServer(script)\n    t.cleanup(() => server.close())\n    r.env.ROAST_FINDER_API_KEY = FINDER_KEY\n    r.env.ROAST_VERIFIER_API_KEY = VERIFIER_KEY\n    fs.writeFileSync(path.join(r.dir, 'main.go'), ORIGINAL)\n    gitIn(r, ['add', 'main.go'])\n    gitIn(r, ['commit', '-q', '-m', 'initial'])\n    fs.writeFileSync(path.join(r.dir, 'main.go'), CHANGED)\n    if (opts.config !== null) {\n        writeConfig(r.dir, opts.config ?? profileConfig(server.url))\n    }\n    const repo:ReviewRepo = {\n        ...r,\n        server,\n        roast:(args, o = {}) => runRoast(args, {\n            cwd:o.cwd ?? r.dir,\n            env:r.env,\n            stdin:o.stdin,\n            signal:o.signal,\n            redirectTo:server.url,\n        }),\n    }\n    if (opts.approve !== false && opts.config !== null) {\n        await approveProjectConfig(repo)\n    }\n    return repo\n}\n\n// `roast trust --yes` for the discovered (or given) config.\nexport async function approveProjectConfig (\n    r:ReviewRepo,\n    args:string[] = [],\n    cwd = r.dir\n):Promise<void> {\n    const res = await runRoast(['trust', '--yes', ...args],\n        { cwd, env:r.env })\n    if (res.code !== 0) throw new Error(`trust failed: ${res.stderr}`)\n}\n\n// Inference requests the fake server received (it serves nothing else).\nexport function requestRecorder (r:ReviewRepo):() => RecordedRequest[] {\n    const start = r.server.requests.length\n    return () => r.server.requests.slice(start)\n}\n\nexport function runsDir (r:TempDir):string {\n    return path.join(r.dir, '.roast', 'runs')\n}\n\n// The run directories a review wrote, sorted.\nexport function runDirs (r:TempDir):string[] {\n    const dir = runsDir(r)\n    if (!fs.existsSync(dir)) return []\n    return fs.readdirSync(dir, { withFileTypes:true })\n        .filter(e => e.isDirectory())\n        .map(e => path.join(dir, e.name))\n        .sort()\n}\n\n// The parsed meta.json of the only run.\nexport function reviewMeta (r:TempDir):Record<string, any> {\n    const dirs = runDirs(r)\n    if (dirs.length !== 1) {\n        throw new Error(`expected one run, found ${dirs.length}`)\n    }\n    return JSON.parse(fs.readFileSync(path.join(dirs[0], 'meta.json'),\n        'utf8'))\n}\n\nexport function readGz (file:string):string {\n    return gunzipSync(fs.readFileSync(file)).toString('utf8')\n}\n\n// Every file under `dir`, recursively.\nexport function filesUnder (dir:string):string[] {\n    if (!fs.existsSync(dir)) return []\n    return fs.readdirSync(dir, { withFileTypes:true, recursive:true })\n        .filter(e => e.isFile())\n        .map(e => path.join(e.parentPath, e.name))\n}\ntest/cli/review-config.ts:179:    t.equal(meta.snapshot.captured, false, 'snapshot still disabled')\ntest/cli/review-trust.ts:61:        review:{ snapshot:false },\ntest/cli/review-trust.ts:112:        review:{ snapshot:false },\ntest/cli/review-units.ts:2:// resolution helpers (2.8 step 11, 2.14), and the snapshot decision\ntest/cli/review-units.ts:16:    captureSnapshot,\ntest/cli/review-units.ts:17:} from '../../src/cli/snapshot-meta.js'\ntest/cli/review-units.ts:97:test('captureSnapshot: disabled branch', async t => {\ntest/cli/review-units.ts:99:    const res = await captureSnapshot(false, '/repo', 'run', SCOPE, '',\ntest/cli/review-units.ts:102:        captured:false, reason:'disabled by review.snapshot',\ntest/cli/review-units.ts:108:test('captureSnapshot: failure and diff pairs', async t => {\ntest/cli/review-units.ts:109:    const failed = await captureSnapshot(true, '/repo', 'run',\ntest/cli/review-units.ts:133:        const res = await captureSnapshot(true, '/repo', 'run',\ntest/cli/review-records.ts:206:test('review.snapshot false records the disabled snapshot', async t => {\ntest/cli/review-records.ts:210:    t.equal(meta.snapshot.captured, false, 'not captured')\ntest/cli/review-records.ts:211:    t.equal(meta.snapshot.reason, 'disabled by review.snapshot', 'reason')","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Nq1aaLb8JbSJaV32yopdSp","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
