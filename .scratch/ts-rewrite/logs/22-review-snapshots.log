rents', '-n1', one.commit).trim(),","+            `${one.commit} ${tip}`, 'same base adds no parent')","+        t.equal(r.git('log', '-1', '--format=%s', one.commit).trim(),","+            'roast run one', 'commit message')","+        t.equal(await revOid(r.dir, 'refs/roast/snapshots/one',","+            { env:r.env }), one.commit, 'revOid resolves the ref')","+        t.equal(await treeOid(r.dir, 'HEAD', { env:r.env }),","+            r.git('rev-parse', 'HEAD^{tree}').trim(), 'treeOid')","+    })","+","+test('snapshot objects survive git gc --prune=now', async t => {","+    const r = messyRepo(t)","+    const snap = await capture(r.dir, {","+        runId:'run-1', headOid:head(r), baseOid:'', env:r.env,","+    })","+    r.git('gc', '-q', '--prune=now')","+    for (const oid of [snap.commit, snap.indexTree, snap.worktreeTree]) {","+        t.ok(r.git('cat-file', '-t', oid).trim() !== '', `kept ${oid}`)","+    }","+    t.ok(r.git('cat-file', '-p', `${snap.worktreeTree}:untracked.go`)","+        .includes('untracked'), 'untracked blob kept')","+})","+","+test('capture honors GIT_INDEX_FILE as the live index', async t => {","+    const r = repoFor(t)","+    r.write('a.txt', 'a\\n')","+    r.write('b.txt', 'b\\n')","+    r.git('add', 'a.txt')","+    const alt = path.join(r.dir, '.git', 'alt-index')","+    execFileSync('git', ['-C', r.dir, 'read-tree', 'HEAD'],","+        { env:{ ...r.env, GIT_INDEX_FILE:alt } })","+    execFileSync('git', ['-C', r.dir, 'add', 'b.txt'],","+        { env:{ ...r.env, GIT_INDEX_FILE:alt } })","+    // Relative to the toplevel.","+    const env = { ...r.env, GIT_INDEX_FILE:'.git/alt-index' }","+    const snap = await capture(r.dir, {","+        runId:'run-1', headOid:head(r), baseOid:'', env,","+    })","+    const paths = treePaths(r, snap.indexTree)","+    t.ok(paths.includes('b.txt'), 'alternate index staged b.txt')","+    t.ok(!paths.includes('a.txt'), 'live .git/index not used')","+})","+","+test('a pin and a capture given that pin record the same tree',","+    async t => {","+        const r = messyRepo(t)","+        const pin = await pinWorktree(r.dir, { env:r.env })","+        // Edits after the pin must not reach the capture.","+        r.write('untracked.go', 'package untracked // later\\n')","+        const snap = await capture(r.dir, {","+            runId:'run-1', headOid:head(r), baseOid:'', worktree:pin,","+            env:r.env,","+        })","+        t.equal(snap.worktreeTree, pin.tree, 'same worktree tree')","+        t.deepEqual(snap.excluded, pin.excluded, 'same excluded list')","+        const own = await capture(r.dir, {","+            runId:'run-2', headOid:head(r), baseOid:'', env:r.env,","+        })","+        t.ok(own.worktreeTree !== pin.tree, 'an unpinned capture reads now')","+    })","+","+test('pinWorktree works without HEAD', async t => {","+    const r = repoFor(t, { commit:false })","+    r.write('a.go', 'package a\\n')","+    const pin = await pinWorktree(r.dir, { env:r.env })","+    t.deepEqual(treePaths(r, pin.tree), ['a.go'], 'worktree pinned')","+    t.equal(refs(r), '', 'no ref')","+})","+","+test('pinWorktree resolves an unmerged index in a private copy',","+    async t => {","+        const r = unmergedRepo(t)","+        const index = indexBytes(r)","+        const pin = await pinWorktree(r.dir, { env:r.env })","+        t.ok(r.git('show', `${pin.tree}:conflict.txt`).includes('<<<<<<<'),","+            'conflicted file pinned as on disk')","+        t.ok(indexBytes(r).equals(index), 'live index untouched')","+        t.ok(r.git('ls-files', '-u').trim() !== '', 'still unmerged')","+    })","+","+test('capture uses roast identity without user.email', async t => {","+    const r = repoFor(t)","+    r.write('a.go', 'package a\\n')","+    const env = { ...r.env }","+    for (const k of ['GIT_AUTHOR_NAME', 'GIT_AUTHOR_EMAIL',","+        'GIT_COMMITTER_NAME', 'GIT_COMMITTER_EMAIL']) delete env[k]","+    // No user.email anywhere, and no guessing from the host name.","+    fs.writeFileSync(r.globalConfig, '[user]\\n\\tuseConfigOnly = true\\n')","+    const snap = await capture(r.dir, {","+        runId:'run-1', headOid:head(r), baseOid:'', env,","+    })","+    t.equal(r.git('log', '-1', '--format=%an <%ae>|%cn <%ce>', snap.commit)","+        .trim(), 'roast <roast@localhost>|roast <roast@localhost>',","+    'author and committer')","+})","+","+test('deleteSnapshot removes the ref', async t => {","+    const r = repoFor(t)","+    await capture(r.dir, {","+        runId:'run-1', headOid:head(r), baseOid:'', env:r.env,","+    })","+    t.ok(refs(r) !== '', 'ref written')","+    await deleteSnapshot(r.dir, 'run-1', { env:r.env })","+    t.equal(refs(r), '', 'ref deleted')","+})"]}]}],"moreFiles":0,"changedFiles":["/Users/nick/code/roast.ts-rewrite-22-review-snapshots/test/snapshot/snapshot.ts"]}},"tool_result_meta":[{"id":"toolu_017hnUSmwsKwCDddY2NHHg3j","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
