// The baseline Go CLI the harness compares against (spec 15, 2.13):
// built once from a detached worktree at the baseline commit and cached
// under node_modules/.cache, reused on later runs.
import { spawn } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { ROOT } from '../helpers/spawn.js'

export const BASELINE_REV = 'cd08f10'

export const DEFAULT_CACHE_PATH = path.join(ROOT, 'node_modules', '.cache',
    'roast-diff', `roast-go-${BASELINE_REV}`)

const VERSION_FLAG = '-X github.com/bluesky-social/roast/internal/' +
    'buildinfo.Version=baseline'

export interface BaselineOpts {
    // The repository holding the baseline commit.
    root:string;
    rev:string;
    cachePath:string;
    env:NodeJS.ProcessEnv;
    // Where the temporary worktree goes; the OS temp dir by default.
    tmpRoot?:string;
}

export type Baseline =
    | { kind:'binary', path:string, built:boolean }
    | { kind:'no-go' }

// Whether `command` resolves to an executable file on `PATH`.
export function onPath (command:string, PATH:string|undefined):boolean {
    for (const dir of (PATH ?? '').split(path.delimiter)) {
        if (dir === '') continue
        try {
            fs.accessSync(path.join(dir, command), fs.constants.X_OK)
            return true
        } catch {
            // not here
        }
    }
    return false
}

interface Exec {
    code:number|null;
    stderr:string;
}

function exec (
    command:string,
    args:string[],
    opts:{ cwd:string, env:NodeJS.ProcessEnv }
):Promise<Exec> {
    return new Promise((resolve, reject) => {
        const child = spawn(command, args, {
            cwd:opts.cwd,
            env:opts.env,
            stdio:['ignore', 'ignore', 'pipe'],
        })
        let stderr = ''
        child.stderr.setEncoding('utf8')
        child.stderr.on('data', chunk => { stderr += chunk })
        child.on('error', reject)
        child.on('close', code => resolve({ code, stderr }))
    })
}

async function mustExec (
    command:string,
    args:string[],
    opts:{ cwd:string, env:NodeJS.ProcessEnv }
):Promise<void> {
    const r = await exec(command, args, opts)
    if (r.code !== 0) {
        throw new Error(`${command} ${args.join(' ')} exited ${r.code}: ` +
            r.stderr.trim())
    }
}

// The cached baseline binary, building it first when the cache is
// empty. `{kind:'no-go'}` when `go` is not on the environment's PATH.
export async function ensureBaseline (opts:BaselineOpts):Promise<Baseline> {
    // Without Go every scenario skips, even with a cached binary, so a
    // machine without Go never runs a stale baseline.
    if (!onPath('go', opts.env.PATH)) return { kind:'no-go' }
    if (fs.existsSync(opts.cachePath)) {
        return { kind:'binary', path:opts.cachePath, built:false }
    }

    fs.mkdirSync(path.dirname(opts.cachePath), { recursive:true })
    const tmp = fs.mkdtempSync(path.join(opts.tmpRoot ?? os.tmpdir(),
        'roast-diff-go-'))
    const worktree = path.join(tmp, 'roast-go')
    const staging = `${opts.cachePath}.tmp-${process.pid}`
    const gitEnv = opts.env
    try {
        await mustExec('git', ['-C', opts.root, 'worktree', 'add', '-q',
            '--detach', worktree, opts.rev], { cwd:opts.root, env:gitEnv })
        const goEnv:NodeJS.ProcessEnv = { ...opts.env, CGO_ENABLED:'0' }
        delete goEnv.GOFLAGS
        await mustExec('go', ['build', '-trimpath', '-ldflags', VERSION_FLAG,
            '-o', staging, './cmd/roast'], { cwd:worktree, env:goEnv })
        fs.renameSync(staging, opts.cachePath)
    } finally {
        fs.rmSync(staging, { force:true })
        // Remove the worktree even when the build failed; a failure here
        // must not hide the build error, so it is only reported.
        const r = await exec('git', ['-C', opts.root, 'worktree', 'remove',
            '--force', worktree], { cwd:opts.root, env:gitEnv })
        if (r.code !== 0 && fs.existsSync(worktree)) {
            process.stderr.write(`# could not remove worktree ${worktree}: ` +
                `${r.stderr.trim()}\n`)
        }
        fs.rmSync(tmp, { recursive:true, force:true })
    }
    return { kind:'binary', path:opts.cachePath, built:true }
}
