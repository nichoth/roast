    // Even a cached binary is not used: without Go every scenario skips.
    fs.mkdirSync(path.dirname(f.cachePath), { recursive:true })
    fs.writeFileSync(f.cachePath, '#!/bin/sh\n', { mode:0o755 })
    const result = await ensureBaseline({
        root:f.repo,
        rev:'HEAD',
        cachePath:f.cachePath,
        env:{ ...f.env, PATH:path.join(f.root, 'empty') },
        tmpRoot:f.tmpRoot,
    })
    t.equal(result.kind, 'no-go', 'reports that go is missing')
    t.equal(logLines(f).length, 0, 'go did not run')
