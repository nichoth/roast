    stdout:string;
    stderr:string;
}

// Runs a command to completion and collects its output.
export function run (
    command:string,
    args:string[],
    opts:{ cwd?:string, env?:NodeJS.ProcessEnv } = {}
):Promise<SpawnResult> {
    return new Promise((resolve, reject) => {
        const child = spawn(command, args, {
            cwd:opts.cwd ?? ROOT,
            env:opts.env ?? process.env,
            stdio:['ignore', 'pipe', 'pipe'],
        })
        let stdout = ''
        let stderr = ''
        child.stdout.setEncoding('utf8')
        child.stderr.setEncoding('utf8')
        child.stdout.on('data', chunk => { stdout += chunk })
        child.stderr.on('data', chunk => { stderr += chunk })
        child.on('error', reject)
        child.on('close', code => resolve({ code, stdout, stderr }))
    })
}
// Self-tests for the Go baseline build, driven by a fake `go` first on
// PATH and a temporary repository standing in for this checkout.
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { test } from '../../helpers/test.js'
import { ensureBaseline } from '../baseline.js'

interface Fixture {
    root:string;
    repo:string;
    bin:string;
    log:string;
    tmpRoot:string;
    cachePath:string;
    env:NodeJS.ProcessEnv;
    remove ():void;
}

function git (repo:string, args:string[], env:NodeJS.ProcessEnv):string {
    return execFileSync('git', ['-C', repo, ...args], {
        env,
        encoding:'utf8',
    })
}

// A repository with one commit, a fake `go` that logs its working
// directory, arguments, CGO_ENABLED, and GOFLAGS, then writes the `-o`
// file (or fails when `fail` is set).
function fixture (fail:boolean):Fixture {
    const root = fs.realpathSync(fs.mkdtempSync(
        path.join(os.tmpdir(), 'roast-diff-baseline-')))
    const repo = path.join(root, 'repo')
    const bin = path.join(root, 'bin')
    const log = path.join(root, 'go.log')
    const tmpRoot = path.join(root, 'tmp')
    fs.mkdirSync(repo)
    fs.mkdirSync(bin)
    fs.mkdirSync(tmpRoot)
    const env:NodeJS.ProcessEnv = {
        PATH:`${bin}${path.delimiter}${process.env.PATH ?? ''}`,
        HOME:root,
        GIT_CONFIG_NOSYSTEM:'1',
        GIT_CONFIG_GLOBAL:'/dev/null',
        GIT_AUTHOR_NAME:'t',
        GIT_AUTHOR_EMAIL:'t@example.com',
        GIT_COMMITTER_NAME:'t',
        GIT_COMMITTER_EMAIL:'t@example.com',
        GOFLAGS:'-race',
        CGO_ENABLED:'1',
    }
    git(repo, ['init', '-q'], env)
    fs.writeFileSync(path.join(repo, 'file.txt'), 'x\n')
    git(repo, ['add', '.'], env)
    git(repo, ['commit', '-q', '-m', 'one'], env)
    const script = [
        '#!/bin/sh',
        `echo "$PWD|$*|CGO=$CGO_ENABLED|GOFLAGS=\${GOFLAGS-unset}" >> '${log}'`,
        fail ? 'echo "build failed" >&2; exit 1' : '',
        'out=""',
        'while [ $# -gt 0 ]; do',
        '  if [ "$1" = "-o" ]; then out="$2"; fi',
        '  shift',
        'done',
        'printf "#!/bin/sh\\n" > "$out"',
    ].join('\n')
    fs.writeFileSync(path.join(bin, 'go'), script + '\n', { mode:0o755 })
    return {
        root,
        repo,
        bin,
        log,
        tmpRoot,
        cachePath:path.join(root, 'cache', 'roast-go-test'),
        env,
        remove:() => fs.rmSync(root, { recursive:true, force:true }),
    }
}

function logLines (f:Fixture):string[] {
    if (!fs.existsSync(f.log)) return []
    return fs.readFileSync(f.log, 'utf8').split('\n').filter(Boolean)
}

function worktrees (f:Fixture):number {
    return git(f.repo, ['worktree', 'list', '--porcelain'], f.env)
        .split('\n').filter(l => l.startsWith('worktree ')).length
}

test('baseline: builds once, then reuses the cached binary', async t => {
    const f = fixture(false)
    t.cleanup(() => f.remove())
    const opts = {
        root:f.repo,
        rev:'HEAD',
        cachePath:f.cachePath,
        env:f.env,
        tmpRoot:f.tmpRoot,
    }
    const first = await ensureBaseline(opts)
    t.equal(first.kind, 'binary', 'the first call yields a binary')
    t.ok(first.kind === 'binary' && first.built, 'and builds it')
    t.ok(fs.existsSync(f.cachePath), 'the binary is at the cache path')
    const lines = logLines(f)
    t.equal(lines.length, 1, 'go ran once')
    const [cwd, args, cgo, goflags] = lines[0].split('|')
    t.ok(cwd !== f.repo && !cwd.startsWith(f.repo + path.sep),
        'go ran in a separate worktree')
    t.ok(args.includes('build') && args.includes('-trimpath'),
        'with go build -trimpath')
    t.ok(args.includes('buildinfo.Version=baseline'),
        'with the baseline version ldflag')
    t.ok(args.endsWith('./cmd/roast'), 'building ./cmd/roast')
    t.equal(cgo, 'CGO=0', 'with CGO_ENABLED=0')
    t.equal(goflags, 'GOFLAGS=unset', 'and GOFLAGS removed')
    t.equal(worktrees(f), 1, 'the temporary worktree is removed')
    t.deepEqual(fs.readdirSync(f.tmpRoot), [],
        'the temporary directory is removed')

    const second = await ensureBaseline(opts)
    t.ok(second.kind === 'binary' && !second.built,
        'the second call reuses the binary')
    t.equal(logLines(f).length, 1, 'without running go again')
})

test('baseline: a failing build removes the worktree', async t => {
    const f = fixture(true)
    t.cleanup(() => f.remove())
    let err:unknown
    try {
        await ensureBaseline({
            root:f.repo,
            rev:'HEAD',
            cachePath:f.cachePath,
            env:f.env,
            tmpRoot:f.tmpRoot,
        })
    } catch (e) {
        err = e
    }
    t.ok(err instanceof Error, 'the build failure is an error')
    t.ok(String(err).includes('build failed'), 'carrying go\'s stderr')
    t.equal(logLines(f).length, 1, 'go ran')
    t.equal(worktrees(f), 1, 'the temporary worktree is removed')
    t.deepEqual(fs.readdirSync(f.tmpRoot), [],
        'the temporary directory is removed')
    t.ok(!fs.existsSync(f.cachePath), 'no binary is cached')
})

