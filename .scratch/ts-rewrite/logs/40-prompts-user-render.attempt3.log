+    const [cwd, args, cgo, goflags] = logLines(f)[0].split('|')
+    t.ok(cwd !== f.repo, 'helper builds in the detached worktree')
+    t.ok(args.endsWith('./roast-diff-helper.go'), 'build targets the helper')
+    const copied = f.log + '.source'
+    t.equal(fs.existsSync(copied) ? fs.readFileSync(copied, 'utf8') : '',
+        source, 'go sees the supplied helper source')
+    t.equal(cgo, 'CGO=0', 'CGO is disabled')
+    t.equal(goflags, 'GOFLAGS=unset', 'GOFLAGS is removed')
+    t.equal(worktrees(f), 1, 'temporary worktree is removed')
+    t.deepEqual(fs.readdirSync(f.tmpRoot), [], 'temporary directory is empty')
+})
+
