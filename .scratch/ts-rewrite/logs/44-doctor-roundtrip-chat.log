## 7. Resolved

1. Build info is injected by esbuild `define` (version, commit, date);
   from source it is `dev` and keeps the warning (spec.md, "Runtime").
2. `config-trust` says "approved by an older Roast" for a v1 record and
   names `npx roast trust` (spec.md, decision 4).
3. Doctor checks only user-level skill installs: Go parity, kept
   (spec.md, "Further Notes").
4. Hints say bare `roast skill install`: Go parity, kept (spec.md,
   "Further Notes").
5. `init` writes `.roast.json` in the working directory: Go parity, kept
   (spec.md, "Further Notes").
6. New `proxy-env` check warns when `HTTPS_PROXY`/`https_proxy` is set
   without `NODE_USE_ENV_PROXY=1` (spec.md, "Network").
7. Windows-specific behavior removed (spec.md, decision 2).
// Protocol-neutral types for the LLM layer (spec 06, 3.1; spec 07, 3.3).

export type Protocol = 'chat'|'responses'|'anthropic'

export interface RawResponse {
    role:string;
    protocol:Protocol;
    model:string;
    contentType:'application/json'|'text/event-stream';
    // Exact bytes of the body: no request, no headers.
    body:Uint8Array;
}

export interface ClientConfig {
    // "finder", "verifier", or a doctor check name.
    role:string;
    baseUrl:string;
    apiKey:string;
    // Sent verbatim as the body's `model`.
    model:string;
    // "" means chat.
    protocol:''|Protocol;
    maxOutputTokens:number;
    // Attempts per model call; <= 0 means DEFAULT_MAX_ATTEMPTS.
    maxAttempts:number;
    // Per request; 0 disables.
    requestTimeoutMs:number;
    sessionHeader?:string;
    captureResponse?:(raw:RawResponse) => Promise<void>|void;
    // Overrides the module-level fetch (http.ts) for this client.
    fetch?:typeof globalThis.fetch;
}

export interface ToolDefinition {
    name:string;
    description:string;
    // The complete caller JSON Schema.
    schema:Record<string, unknown>;
}

// A tool the agent loop offers the model (spec 07, 3.3). The final tool
// has no `run`.
export interface Tool {
    name:string;
    description:string;
    schema:Record<string, unknown>;
    run?:(args:Record<string, unknown>, signal:AbortSignal) =>
        unknown|Promise<unknown>;
    recordsResult?:boolean;
}

export type AssistantPart =
    | { type:'text', text:string }
    | {
        type:'reasoning';
        text:string;
        signature?:string;
        redactedData?:string;
    }
    // `input` is the raw argument string as received.
    | { type:'tool-call', id:string, name:string, input:string }

export interface ToolResult {
    callId:string;
    name:string;
    output:string;
    isError:boolean;
}

export type ConversationItem =
    | { role:'user', text:string }
    | { role:'assistant', parts:AssistantPart[] }
    | { role:'tool', results:ToolResult[] }

export interface Usage {
    uncachedInputTokens:number;
    cachedInputTokens:number;
    cacheWriteTokens:number;
    outputTokens:number;
    calls:number;
}

export interface ModelRequest {
    system:string;
    items:ConversationItem[];
    tools:ToolDefinition[];
    sessionId:string;
    // Already composed by the agent loop (caller, deadline, timeout).
    signal:AbortSignal;
    onUsage?:(usage:Usage) => void;
}

export type FinishReason =
    'stop'|'length'|'content-filter'|'tool-calls'|'error'|'other'|'unknown'

export interface ModelTurn {
    // Arrival order; replayed verbatim.
    parts:AssistantPart[];
    finishReason:FinishReason;
    rawFinishReason?:string;
    // Normalized, calls: 1.
    usage:Usage;
}

// Progress report for one dispatched exploration or record call, or a
// call to an unknown tool (spec 07, 2.10).
export interface TurnInfo {
    turn:number;
    tool:string;
    args:Record<string, unknown>;
}

// Type validation of the final arguments (spec 07, 2.7). `decode`
// receives the value parsed with integer preservation (unsafe integers
// are `bigint`) and throws an Error whose message is the detail.
export interface FinalSpec<T> {
    decode (value:unknown):T;
}

export interface ConverseOptions<T> {
    // Exploration, record, and final tools, in order.
    tools:readonly Tool[];
    finalTool:string;
    final:FinalSpec<T>;
    // Turn at which the final phase starts; <= 0 means 8.
    maxTurns?:number;
    onTurn?:(info:TurnInfo) => void;
    // <= 0 means 3e6.
    inputByteCeiling?:number;
    // Absolute time, ms since the epoch.
    workDeadline?:number;
    // ms; <= 0 means 90000.
    wrapUpWindow?:number;
    onWorkDeadline?:() => void;
    onBudgetExhausted?:() => void;
}

// Usage as written into run records: snake_case, disjoint counts.
export interface RecordUsage {
    uncached_input_tokens:number;
    cached_input_tokens:number;
    cache_write_tokens:number;
    output_tokens:number;
    calls:number;
}

// One configured model role, as the finder and verifier call it.
export interface Client {
    // The request model name.
    readonly name:string;
    converse<T> (
        system:string,
        user:string,
        opts:ConverseOptions<T>,
        signal:AbortSignal
    ):Promise<T>;
    completeStructured<T> (
        system:string,
        user:string,
        schemaName:string,
        result:{ schema:Record<string, unknown>, decode:FinalSpec<T>['decode'] },
        signal:AbortSignal
    ):Promise<T>;
    usage ():RecordUsage;
}
// `createModelClient` and `send` (spec 06, 3.2): one model turn becomes
// exactly one HTTP request in the profile's protocol. Never retries.

import { goTrimSpace } from '../gocompat/strings.js'
import { abortable, CaptureGate, openCapturedBody } from './capture.js'
import { chatUrl, decodeChat, encodeChat } from './chat.js'
import {
    CaptureError,
    EndpointError,
    ProviderError,
    SENTINEL_MESSAGE,
} from './errors.js'
import { currentFetch, requestHeaders } from './http.js'
import { parseSse, type SseEvent } from './sse.js'
import {
    DEFAULT_MAX_ATTEMPTS,
    runConversation,
    type LoopDeps,
} from './agent.js'
import type { Ledger } from './ledger.js'
import type { Sleep } from './retry.js'
import type {
    Client,
    ClientConfig,
    ModelRequest,
    ModelTurn,
    Protocol,
    RecordUsage,
    Usage,
} from './types.js'
import { UsageAccumulator } from './usage.js'

export { DEFAULT_MAX_ATTEMPTS }

// Error bodies are read at most this far (deliberate change 9).
export const MAX_ERROR_BODY = 32 * 1024

export interface ModelClient {
    readonly config:Readonly<ClientConfig>;
    // '' normalized to 'chat'.
    readonly protocol:Protocol;
    // <= 0 normalized to DEFAULT_MAX_ATTEMPTS.
    readonly maxAttempts:number;
    // One HTTP attempt. Resolves only after capture succeeded.
    send (request:ModelRequest):Promise<ModelTurn>;
    // Exact byte length of the request body `send` would post.
    requestBytes (request:ModelRequest):number;
    // Accumulated usage across all calls on this client.
    usage ():Usage;
}

interface Adapter {
    url (baseUrl:string):string;
    encode (config:ClientConfig, request:ModelRequest):unknown;
    decode (events:AsyncIterable<SseEvent>):Promise<ModelTurn>;
}

const ADAPTERS:Partial<Record<Protocol, Adapter>> = {
    chat:{
        url:chatUrl,
        encode:(config, request) => encodeChat(config, request),
        decode:decodeChat,
    },
}

function adapterFor (protocol:string):Adapter {
    const known = protocol === 'chat' || protocol === 'responses' ||
        protocol === 'anthropic'
    const adapter = known ? ADAPTERS[protocol as Protocol] : undefined
    if (!adapter) {
        throw new Error(`unsupported inference protocol "${protocol}"`)
    }
    return adapter
}

// Best-effort provider error fields from an OpenAI-style
// `{"error":{...}}` or Anthropic `{"type":"error","error":{...}}` body.
function providerFields (text:string):{
    type?:string;
    code?:string;
    message?:string;
} {
    try {
        const parsed:unknown = JSON.parse(text)
        if (parsed === null || typeof parsed !== 'object') return {}
        const e = (parsed as { error?:unknown }).error
        if (e === null || typeof e !== 'object') return {}
        const { type, code, message } = e as Record<string, unknown>
        return {
            type:typeof type === 'string' ? type : undefined,
            code:typeof code === 'string' ?
                code :
                typeof code === 'number' ? String(code) : undefined,
            message:typeof message === 'string' ? message : undefined,
        }
    } catch {
        return {}
    }
}

async function readCapped (
    body:ReadableStream<Uint8Array>|null,
    limit:number,
    signal:AbortSignal
):Promise<Uint8Array> {
    if (!body) return new Uint8Array(0)
    const reader = body.getReader()
    const parts:Uint8Array[] = []
    let size = 0
    let eof = false
    try {
        while (size < limit) {
            const r = await abortable(reader.read(), signal)
            if (r.done) {
                eof = true
                break
            }
            const take = r.value.subarray(0, limit - size)
            parts.push(take)
            size += take.length
        }
    } finally {
        if (!eof) await reader.cancel().catch(() => {})
    }
    const out = new Uint8Array(size)
    let off = 0
    for (const p of parts) {
        out.set(p, off)
        off += p.length
    }
    return out
}

async function httpError (
    response:Response,
    url:string,
    model:string,
    signal:AbortSignal
):Promise<Error> {
    const bytes = await readCapped(response.body, MAX_ERROR_BODY, signal)
    const text = new TextDecoder().decode(bytes)
    const fields = providerFields(text)
    const headers:Record<string, string> = {}
    response.headers.forEach((value, name) => { headers[name] = value })
    const detail = fields.message ?? text.slice(0, 512).trim()
    const status = `${response.status} ${response.statusText}`.trim()
    const err = new ProviderError(
        `POST "${url}": ${status}${detail ? `: ${detail}` : ''}`,
        {
            status:response.status,
            headers,
            providerType:fields.type,
            providerCode:fields.code,
            providerMessage:fields.message,
        })
    if (response.status >= 300 && response.status < 400) {
        return new EndpointError(
            `${SENTINEL_MESSAGE.endpoint}: ${model}: redirect refused: ` +
                err.message,
            { cause:err, details:{ model } })
    }
    return err
}

export function createModelClient (config:ClientConfig):ModelClient {
    if (!(config.maxOutputTokens > 0)) {
        throw new Error(`${config.model}: max output tokens must be positive`)
    }
    if (goTrimSpace(config.apiKey) === '') {
        throw new Error(`${config.model}: API key is not configured`)
    }
    const protocol = (config.protocol === '' ?
        'chat' :
        config.protocol) as Protocol
    const adapter = adapterFor(protocol)
    const maxAttempts = config.maxAttempts > 0 ?
        config.maxAttempts :
        DEFAULT_MAX_ATTEMPTS
    const gate = new CaptureGate()
    const total = new UsageAccumulator()
    const url = adapter.url(config.baseUrl)

    function encodeBody (request:ModelRequest):Uint8Array {
        const body = adapter.encode(config, request)
        return new TextEncoder().encode(JSON.stringify(body))
    }

    async function attempt (
        request:ModelRequest,
        signal:AbortSignal
    ):Promise<ModelTurn> {
        const fetchFn = config.fetch ?? currentFetch()
        const response = await fetchFn(url, {
            method:'POST',
            headers:requestHeaders(protocol, config.apiKey,
                request.sessionId, config.sessionHeader),
            body:encodeBody(request),
            redirect:'manual',
            signal,
        })
        if (response.status < 200 || response.status >= 300) {
            throw await httpError(response, url, config.model, signal)
        }
        const body = await openCapturedBody(response, {
            role:config.role,
            protocol,
            model:config.model,
            captureResponse:config.captureResponse,
        }, gate, signal)
        let turn:ModelTurn|undefined
        let failure:unknown
        try {
            turn = await adapter.decode(parseSse(body.chunks))
        } catch (err) {
            failure = err
        }
        if (turn) {
            total.add(turn.usage)
            request.onUsage?.(turn.usage)
        }
        // A capture failure here replaces any turn or error.
        await body.release()
        if (!turn) throw failure
        signal.throwIfAborted()
        return turn
    }

    return {
        config,
        protocol,
        maxAttempts,
        requestBytes (request:ModelRequest):number {
            return encodeBody(request).length
        },
        usage ():Usage {
            return total.total()
        },
        async send (request:ModelRequest):Promise<ModelTurn> {
            if (gate.failure) throw gate.failure
            request.signal.throwIfAborted()
            const timeout = config.requestTimeoutMs > 0 ?
                AbortSignal.timeout(config.requestTimeoutMs) :
                undefined
            const signal = timeout ?
                AbortSignal.any([request.signal, timeout]) :
                request.signal
            try {
                return await attempt(request, signal)
            } catch (err) {
                if (err instanceof CaptureError) throw err
                if (request.signal.aborted) throw request.signal.reason
                if (timeout?.aborted) {
                    throw new EndpointError(
                        `${SENTINEL_MESSAGE.endpoint}: ${config.model}: ` +
                            'request timed out after ' +
                            `${config.requestTimeoutMs}ms`,
                        {
                            cause:timeout.reason,
                            details:{ model:config.model },
                        })
                }
                throw err
            }
        },
    }
}

export interface CreateClientOptions {
    // The run's shared ledger; none means unlimited.
    ledger?:Ledger|null;
    now?:() => number;
    sleep?:Sleep;
    sessionId?:() => string;
}

function recordUsage (u:Usage):RecordUsage {
    return {
        uncached_input_tokens:u.uncachedInputTokens,
        cached_input_tokens:u.cachedInputTokens,
        cache_write_tokens:u.cacheWriteTokens,
        output_tokens:u.outputTokens,
        calls:u.calls,
    }
}

// The `Client` the finder and verifier call (spec 07, 3.3): both entry
// points run the agent loop over `model`; usage accumulates across all
// of this client's conversations.
export function createClient (
    model:ModelClient,
    opts:CreateClientOptions = {}
):Client {
    const total = new UsageAccumulator()
    const deps:LoopDeps = {
        client:model,
        model:model.config.model,
        maxOutputTokens:model.config.maxOutputTokens,
        maxAttempts:model.maxAttempts > 0 ?
            model.maxAttempts :
            DEFAULT_MAX_ATTEMPTS,
        ledger:opts.ledger ?? null,
        addUsage:u => total.add(u),
        now:opts.now,
        sleep:opts.sleep,
        sessionId:opts.sessionId,
    }
    return {
        name:model.config.model,
        converse (system, user, converseOpts, signal) {
            return runConversation(deps, system, user, converseOpts, false,
                signal)
        },
        completeStructured (system, user, schemaName, result, signal) {
            return runConversation(deps, system, user, {
                tools:[{
                    name:schemaName,
                    description:'Return the requested structured result.',
                    schema:result.schema,
                }],
                finalTool:schemaName,
                final:{ decode:result.decode },
                maxTurns:1,
            }, true, signal)
        },
        usage () {
            return recordUsage(total.total())
        },
    }
}
// Roast's agent loop (spec 07): a multi-turn tool conversation that ends
// when the model calls the final tool with arguments that validate. An
// imperative shell around the pure review (review.ts), the ledger, and
// the work deadline. Governing invariant: no stop path discards
// accumulated work; the budget and the deadline never cancel the wrap-up
// call, and record tools always run.

import type { ModelClient } from './client.js'
import { WorkDeadline } from './deadline.js'
import {
    CaptureError,
    cutoffError,
    FinalArgumentsError,
    hasSentinel,
    NoFinalCallError,
    normalizeProviderError,
    SENTINEL_MESSAGE,
    type ErrorDetails,
} from './errors.js'
import { checkRequired, decodeArgs, typeValidate } from './final-args.js'
import { encodeToolResult } from './json.js'
import { reserve, type Ledger } from './ledger.js'
import { transcriptBytes } from './messages.js'
import { withStepRetry, type Sleep } from './retry.js'
import {
    reviewResponse,
    type ReviewCall,
    type ReviewDecision,
    type StopCause,
} from './review.js'
import { newSessionId } from './session.js'
import type {
    AssistantPart,
    ConversationItem,
    ConverseOptions,
    FinishReason,
    ModelRequest,
    ModelTurn,
    Tool,
    ToolDefinition,
    ToolResult,
    Usage,
} from './types.js'
import { zeroUsage } from './usage.js'

export { DEFAULT_WRAP_UP_WINDOW } from './deadline.js'

export const NUDGE_TOOL_NAME = '__roast_continue'
export const DEFAULT_MAX_TURNS = 8
export const DEFAULT_INPUT_BYTE_CEILING = 3_000_000
export const DEFAULT_MAX_ATTEMPTS = 4
// Added to the request body size for ledger admission.
export const REQUEST_OVERHEAD_BYTES = 2048

const NUDGE_TOOL:ToolDefinition = {
    name:NUDGE_TOOL_NAME,
    description:'Continue the Roast tool loop after a free-form response.',
    schema:{
        type:'object',
        properties:{ message:{ type:'string' } },
        required:['message'],
    },
}

export interface LoopDeps {
    client:ModelClient;
    // Request model name, used in error messages.
    model:string;
    maxOutputTokens:number;
    // Already normalized (<= 0 -> DEFAULT_MAX_ATTEMPTS).
    maxAttempts:number;
    ledger:Ledger|null;
    // The client's usage accumulator.
    addUsage:(usage:Usage) => void;
    now?:() => number;
    sleep?:Sleep;
    sessionId?:() => string;
}

type Cutoff = 'work-deadline'|'budget-exhausted'

interface StepOutcome {
    dispatched:boolean;
    stopRequested:boolean;
}

class Conversation<T> {
    private readonly items:ConversationItem[]
    private readonly tools:ReadonlyMap<string, Tool>
    private readonly toolNames:ReadonlySet<string>
    private readonly recordTools:ReadonlySet<string>
    private readonly definitions:readonly ToolDefinition[]
    private readonly deadline:WorkDeadline
    private readonly sessionId:string
    private readonly maxTurns:number
    private readonly ceiling:number

    private turn = 0
    private finalPhase:boolean
    private cutoff:Cutoff|null = null
    private noticeSent = false
    private inputWarned = false
    private budgetNotified = false
    private done = false
    private result?:T
    private finalErr:string|null = null
    private validationExhausted = false
    private halt = false
    private stopCause:StopCause|null = null
    private finish?:{ reason:FinishReason, raw?:string }
    private submissionAttempts = 0
    private recordRounds = 0

    constructor (
        private readonly deps:LoopDeps,
        private readonly system:string,
        user:string,
        private readonly opts:ConverseOptions<T>,
        private readonly structured:boolean,
        private readonly signal:AbortSignal
    ) {
        this.items = [{ role:'user', text:user }]
        const tools = new Map<string, Tool>()
        const records = new Set<string>()
        for (const tool of opts.tools) {
            tools.set(tool.name, tool)
            if (tool.recordsResult && tool.name !== opts.finalTool) {
                records.add(tool.name)
            }
        }
        this.tools = tools
        this.recordTools = records
        this.toolNames = new Set([...tools.keys(), NUDGE_TOOL_NAME])
        this.definitions = [
            ...opts.tools.map(t => ({
                name:t.name,
                description:t.description,
                schema:t.schema,
            })),
            NUDGE_TOOL,
        ]
        this.deadline = new WorkDeadline({
            deadline:opts.workDeadline,
            window:opts.wrapUpWindow,
            onFire:opts.onWorkDeadline,
            now:deps.now,
        })
        this.sessionId = (deps.sessionId ?? newSessionId)()
        this.maxTurns = opts.maxTurns !== undefined && opts.maxTurns > 0 ?
            opts.maxTurns :
            DEFAULT_MAX_TURNS
        this.ceiling = opts.inputByteCeiling !== undefined &&
            opts.inputByteCeiling > 0 ?
            opts.inputByteCeiling :
            DEFAULT_INPUT_BYTE_CEILING
        this.finalPhase = structured
    }

    async run ():Promise<T> {
        let failure:unknown
        let failed = false
        for (;;) {
            this.prepare()
            let outcome:StepOutcome
            try {
                const turn = await withStepRetry(() => this.call(), {
                    maxRetries:this.deps.maxAttempts - 1,
                    signal:this.signal,
                    sleep:this.deps.sleep,
                })
                outcome = await this.process(turn)
            } catch (err) {
                failure = err
                failed = true
                break
            }
            if (this.shouldStop()) break
            if (!outcome.dispatched || outcome.stopRequested) break
            if (this.signal.aborted) {
                failure = this.signal.reason
                failed = true
                break
            }
        }
        return this.conclude(failed, failure)
    }

    // Turn preparation (2.5).
    private prepare ():void {
        this.turn++
        if (this.turn > 1 && !this.inputWarned &&
            transcriptBytes(this.system, this.items) > this.ceiling) {
            this.inputWarned = true
            this.items.push({
                role:'user',
                text:'INPUT BUDGET EXHAUSTED. Do not request more files. ' +
                    `Call \`${this.opts.finalTool}\` now with what you ` +
                    'have \u2014 partial results beat none.',
            })
        }
        if (this.deadline.check()) this.forceFinal('work-deadline')
        if (this.turn >= this.maxTurns) this.forceFinal(null)
        this.sendNotice()
    }

    private forceFinal (cutoff:Cutoff|null):void {
        this.finalPhase = true
        if (cutoff && !this.cutoff) this.cutoff = cutoff
    }

    private notifyBudget ():void {
        if (this.budgetNotified) return
        this.budgetNotified = true
        this.opts.onBudgetExhausted?.()
    }

    private notice ():string {
        const f = '`' + this.opts.finalTool + '`'
        if (this.structured) {
            return `Return the requested structured result via the ${f} ` +
                'tool call. Do not answer in prose.'
        }
        const tail = ` \u2014 call ${f} NOW with everything you have; ` +
            'partial results beat none.'
        if (this.cutoff === 'budget-exhausted') {
            return 'TOKEN BUDGET EXHAUSTED' + tail
        }
        if (this.cutoff === 'work-deadline' && this.deadline.fired) {
            return 'WORK DEADLINE REACHED' + tail
        }
        return 'Exploration budget exhausted' + tail
    }

    private sendNotice ():void {
        if (!this.finalPhase || this.noticeSent) return
        this.noticeSent = true
        this.items.push({ role:'user', text:this.notice() })
    }

    private request (signal:AbortSignal):ModelRequest {
        return {
            system:this.system,
            items:[...this.items],
            tools:this.definitions.map(d => ({
                name:d.name,
                description:d.description,
                schema:structuredClone(d.schema),
            })),
            sessionId:this.sessionId,
            signal,
        }
    }

    // One model call, with the in-step switch to wrap-up on a budget
    // refusal or an in-flight deadline (2.9).
    private async call ():Promise<ModelTurn> {
        const final = this.finalPhase
        const signal = this.deadline.callSignal(this.signal)
        const request = this.request(signal)
        const bytes = this.deps.client.requestBytes(request) +
            REQUEST_OVERHEAD_BYTES
        const release = reserve(this.deps.ledger, bytes,
            this.deps.maxOutputTokens, final)
        if (!release) {
            if (final) {
                if (!this.cutoff) {
                    this.cutoff = 'budget-exhausted'
                    this.notifyBudget()
                }
                throw cutoffError(this.cutoff, 'no headroom for the wrap-up ' +
                    'call', new Error(SENTINEL_MESSAGE['budget-exhausted']),
                this.details())
            }
            this.forceFinal('budget-exhausted')
            this.notifyBudget()
            this.sendNotice()
            return this.call()
        }
        let turn:ModelTurn
        try {
            turn = await this.deps.client.send(request)
            // A response buffered before an abort is never dispatched.
            signal.throwIfAborted()
        } catch (err) {
            release(zeroUsage())
            const deadlineReached = this.deadline.check()
            if (err instanceof CaptureError) throw err
            if (!final && deadlineReached && !this.signal.aborted) {
                this.forceFinal('work-deadline')
                this.sendNotice()
                return this.call()
            }
            if (final && this.cutoff) {
                throw cutoffError(this.cutoff, 'wrap-up call failed',
                    normalizeProviderError(this.signal, this.deps.model, err),
                    this.details())
            }
            throw err
        }
        release(turn.usage)
        this.deps.addUsage(turn.usage)
        this.deadline.check()
        return turn
    }

    // Processing one complete response (2.6) and its dispatch (2.7).
    private async process (turn:ModelTurn):Promise<StepOutcome> {
        if (turn.finishReason !== 'stop' &&
            turn.finishReason !== 'tool-calls') {
            this.abnormalFinish(turn)
            return { dispatched:false, stopRequested:false }
        }
        const calls:ReviewCall[] = []
        for (const p of turn.parts) {
            if (p.type === 'tool-call') {
                calls.push({ id:p.id, name:p.name, input:p.input })
            }
        }
        this.stopCause = null
        const d = reviewResponse({
            calls,
            finalTool:this.opts.finalTool,
            toolNames:this.toolNames,
            recordTools:this.recordTools,
            finalPhase:this.finalPhase,
            turn:this.turn,
            submissionAttempts:this.submissionAttempts,
            recordRounds:this.recordRounds,
            maxAttempts:this.deps.maxAttempts,
            mayContinue:() => this.mayContinueFinalization(),
            validateFinal:input => {
                const v = typeValidate(input, this.opts.final)
                return v.ok ? null : v.error
            },
        })
        for (const call of d.unknownCalls) {
            this.opts.onTurn?.({
                turn:this.turn,
                tool:call.name,
                args:decodeArgs(call.input),
            })
        }
        this.submissionAttempts = d.submissionAttempts
        this.recordRounds = d.recordRounds
        this.stopCause = d.stopCause
        if (d.finalErr !== undefined) this.finalErr = d.finalErr
        if (d.validationExhausted) this.validationExhausted = true
        if (d.halt) this.halt = true
        if (!d.dispatch) return { dispatched:false, stopRequested:false }

        const parts:AssistantPart[] = [...turn.parts]
        const all = [...calls]
        if (d.nudge) {
            const nudge:ReviewCall = {
                id:d.nudge.id,
                name:NUDGE_TOOL_NAME,
                input:JSON.stringify({ message:d.nudge.message }),
            }
            parts.push({ type:'tool-call', ...nudge })
            all.push(nudge)
        }
        this.items.push({ role:'assistant', parts })
        const results:ToolResult[] = []
        let stopRequested = false
        for (const call of all) {
            const r = await this.dispatch(call, d)
            results.push(r.result)
            if (r.stop) stopRequested = true
        }
        this.items.push({ role:'tool', results })
        return { dispatched:all.length > 0, stopRequested }
    }

    private abnormalFinish (turn:ModelTurn):void {
        const reason = turn.finishReason
        let text = `the response ended with finish reason "${reason}"`
        if (turn.rawFinishReason && turn.rawFinishReason !== reason) {
            text += ` (the provider sent "${turn.rawFinishReason}")`
        }
        if (reason === 'length') {
            text += '; raise max_output_tokens if the output was cut off'
        }
        this.stopCause = { kind:'finish-reason', text }
        this.finish = { reason, raw:turn.rawFinishReason }
    }

    private mayContinueFinalization ():boolean {
        if (this.deadline.check()) this.forceFinal('work-deadline')
        return this.cutoff === null
    }

    // One call: required-field validation, then the tool's own handling.
    private async dispatch (
        call:ReviewCall,
        d:ReviewDecision
    ):Promise<{ result:ToolResult, stop?:boolean }> {
        const ok = (output:string):ToolResult => ({
            callId:call.id,
            name:call.name,
            output,
            isError:false,
        })
        const fail = (output:string):ToolResult => ({
            callId:call.id,
            name:call.name,
            output,
            isError:true,
        })
        const tool = this.tools.get(call.name)
        if (!tool && call.name !== NUDGE_TOOL_NAME) {
            return {
                result:fail(`tool not found: ${call.name}. Available ` +
                    `tools: ${this.definitions.map(t => t.name).join(', ')}`),
            }
        }
        const schema = tool?.schema ?? NUDGE_TOOL.schema
        const invalid = checkRequired(schema, call.input)
        if (invalid !== null) return { result:fail(invalid) }

        if (!tool) {
            const message = decodeArgs(call.input).message
            return { result:ok(typeof message === 'string' ? message : '') }
        }
        if (call.name === this.opts.finalTool) {
            return this.dispatchFinal(call, d, ok, fail)
        }
        const record = this.recordTools.has(call.name)
        if (d.blockExploration && !record) {
            return { result:fail(d.blockExploration) }
        }
        const args = decodeArgs(call.input)
        const outcome = await this.deadline.runTool(tool, args, this.signal)
        const value = 'error' in outcome ?
            { error:outcome.error.message } :
            outcome.value
        this.opts.onTurn?.({ turn:this.turn, tool:tool.name, args })
        let text:string
        try {
            text = encodeToolResult(value ?? null) ?? 'null'
        } catch (err) {
            const message = err instanceof Error ? err.message : String(err)
            text = encodeToolResult({ error:message })
        }
        return { result:ok(text) }
    }

    private dispatchFinal (
        call:ReviewCall,
        d:ReviewDecision,
        ok:(output:string) => ToolResult,
        fail:(output:string) => ToolResult
    ):{ result:ToolResult, stop?:boolean } {
        if (this.finalErr !== null) {
            return { result:fail(this.finalErr), stop:true }
        }
        if (d.rejectFinal) return { result:fail(d.rejectFinal) }
        if (this.done) return { result:ok('Already submitted.'), stop:true }
        const accepted = d.accept
        if (!accepted || accepted.id !== call.id ||
            accepted.input !== call.input) {
            return {
                result:fail('Not accepted: call `' + this.opts.finalTool +
                    '` once per response.'),
            }
        }
        const v = typeValidate(call.input, this.opts.final)
        if (!v.ok) {
            this.finalErr = v.error
            return { result:fail(v.error), stop:true }
        }
        this.result = v.value
        this.done = true
        return { result:ok(call.input), stop:true }
    }

    // Stop conditions (2.10).
    private shouldStop ():boolean {
        if (this.done || this.validationExhausted || this.halt) return true
        if (this.finalPhase &&
            this.submissionAttempts >= this.deps.maxAttempts) {
            return true
        }
        if (this.finalPhase && this.deadline.check()) {
            this.forceFinal('work-deadline')
            if (!this.stopCause) {
                this.stopCause = {
                    kind:'deadline-during-finalization',
                    text:'the work deadline passed before `' +
                        this.opts.finalTool + '` was called',
                }
            }
            return true
        }
        return false
    }

    private details ():ErrorDetails {
        const d:ErrorDetails = {
            model:this.deps.model,
            submissionAttempts:this.submissionAttempts,
            recordRounds:this.recordRounds,
        }
        if (this.stopCause) d.stopCause = this.stopCause.kind
        if (this.finish) {
            d.finishReason = this.finish.reason
            if (this.finish.raw !== undefined) {
                d.rawFinishReason = this.finish.raw
            }
        }
        return d
    }

    // Result precedence (2.14).
    private conclude (failed:boolean, failure:unknown):T {
        if (this.done) return this.result as T
        const model = this.deps.model
        const final = this.opts.finalTool
        if (this.finalErr !== null) {
            const err = new FinalArgumentsError(
                `${model}: ${final} arguments did not satisfy the schema ` +
                    `(${this.finalErr}); if truncated, raise max_output_tokens`,
                { ...this.details(), stopCause:'invalid-arguments' })
            if (this.cutoff) {
                throw cutoffError(this.cutoff, 'wrap-up submission was ' +
                    'invalid', err)
            }
            throw err
        }
        if (failed) {
            if (hasSentinel(failure, 'no-final-call')) throw failure
            if (this.cutoff) {
                throw cutoffError(this.cutoff, 'wrap-up turn failed', failure,
                    this.details())
            }
            throw normalizeProviderError(this.signal, model, failure)
        }
        const cause = this.stopCause ?
            new Error(`${model}: ${this.stopCause.text}`) :
            undefined
        if (this.cutoff) {
            throw cutoffError(this.cutoff, 'wrap-up turn produced no ' +
                'submission', cause, this.details())
        }
        const head = SENTINEL_MESSAGE['no-final-call']
        throw new NoFinalCallError(
            cause ? `${head}: ${cause.message}` : head,
            { details:this.details() })
    }
}

// Runs one conversation (`converse`, or `completeStructured` when
// `structured`) to its accepted final call.
export async function runConversation<T> (
    deps:LoopDeps,
    system:string,
    user:string,
    opts:ConverseOptions<T>,
    structured:boolean,
    signal:AbortSignal
):Promise<T> {
    if (!opts.tools.some(t => t.name === opts.finalTool)) {
        throw new Error(`final tool "${opts.finalTool}" is not configured`)
    }
    return new Conversation(deps, system, user, opts, structured, signal)
        .run()
}
// A `node:http` fake inference server (Go httptest plus providerServer):
// it records every request and answers from a script that looks at the
// request (path, body, headers) and the request's position.
import {
    createServer,
    type IncomingHttpHeaders,
    type ServerResponse,
} from 'node:http'
import type { AddressInfo } from 'node:net'
import { writeInferenceStream } from './inference-stream.js'

export interface RecordedRequest {
    method:string;
    path:string;
    headers:IncomingHttpHeaders;
    // Header names and values exactly as sent, in order.
    rawHeaders:string[];
    rawBody:Buffer;
    // The parsed JSON body; undefined when it is not JSON.
    body:unknown;
}

export type Reply =
    // A complete response object, streamed in the protocol's SSE format;
    // the protocol defaults to the one the request path implies.
    | { stream:unknown, protocol?:string }
    | { status:number, headers?:Record<string, string>, body?:string|Buffer }
    // Full control: write the response yourself.
    | ((res:ServerResponse, req:RecordedRequest) => void|Promise<void>)

// Picks the reply for the n-th request (0-based).
export type Script = (req:RecordedRequest, n:number) => Reply

export interface InferenceServer {
    // `http://127.0.0.1:<port>`.
    url:string;
    requests:RecordedRequest[];
    close ():Promise<void>;
}

export function protocolForPath (path:string):string {
    if (path.endsWith('/chat/completions')) return 'chat'
    if (path.endsWith('/responses')) return 'responses'
    if (path.endsWith('/v1/messages')) return 'anthropic'
    return ''
}

async function reply (res:ServerResponse, req:RecordedRequest, r:Reply) {
    if (typeof r === 'function') {
        await r(res, req)
        return
    }
    if ('stream' in r) {
        writeInferenceStream(res, r.protocol ?? protocolForPath(req.path),
            r.stream)
        return
    }
    res.writeHead(r.status, r.headers ?? {})
    res.end(r.body ?? '')
}

export async function startInferenceServer (
    script:Script
):Promise<InferenceServer> {
    const requests:RecordedRequest[] = []
    const server = createServer((req, res) => {
        const parts:Buffer[] = []
        req.on('data', (c:Buffer) => parts.push(c))
        req.on('end', () => {
            const rawBody = Buffer.concat(parts)
            let body:unknown
            try {
                body = JSON.parse(rawBody.toString('utf8'))
            } catch {
                body = undefined
            }
            const rec:RecordedRequest = {
                method:req.method ?? '',
                path:req.url ?? '',
                headers:req.headers,
                rawHeaders:req.rawHeaders,
                rawBody,
                body,
            }
            const n = requests.length
            requests.push(rec)
            Promise.resolve()
                .then(() => reply(res, rec, script(rec, n)))
                .catch((err:unknown) => {
                    if (!res.headersSent) res.writeHead(500)
                    res.end(String(err))
                })
        })
    })
    await new Promise<void>(resolve => {
        server.listen(0, '127.0.0.1', resolve)
    })
    const { port } = server.address() as AddressInfo
    return {
        url:`http://127.0.0.1:${port}`,
        requests,
        close () {
            server.closeAllConnections()
            return new Promise<void>(resolve => server.close(() => resolve()))
        },
    }
}
// Fixture writer for fake inference servers (spec 01, 3.8; Go
// testutil.WriteInferenceStream): from a complete response object, emit
// the protocol's native SSE stream. Only `chat` exists so far; the
// `responses` and `anthropic` formats join it in later tickets.

// The part of `http.ServerResponse` the writer uses.
export interface StreamSink {
    setHeader (name:string, value:string):unknown;
    write (chunk:string):unknown;
    end ():unknown;
}

type Json = Record<string, unknown>

function obj (v:unknown):Json {
    return v !== null && typeof v === 'object' && !Array.isArray(v) ?
        v as Json :
        {}
}

function event (data:unknown, name?:string):string {
    const head = name ? `event: ${name}\n` : ''
    const body = typeof data === 'string' ? data : JSON.stringify(data)
    return `${head}data: ${body}\n\n`
}

// Three chunks (delta, finish, usage) and `[DONE]`.
function chatEvents (response:Json):string[] {
    const base = {
        id:response.id,
        object:'chat.completion.chunk',
        created:1,
        model:response.model,
    }
    const choices = Array.isArray(response.choices) ? response.choices : []
    const deltas = choices.map((c:unknown) => {
        const choice = obj(c)
        const delta = { ...obj(choice.message) }
        if (Array.isArray(delta.tool_calls)) {
            delta.tool_calls = delta.tool_calls.map((tc:unknown, i:number) => (
                { ...obj(tc), index:i }
            ))
        }
        return { index:choice.index, delta, finish_reason:null }
    })
    const finishes = choices.map((c:unknown) => {
        const choice = obj(c)
        return {
            index:choice.index,
            delta:{},
            finish_reason:choice.finish_reason,
        }
    })
    return [
        event({ ...base, choices:deltas }),
        event({ ...base, choices:finishes }),
        event({ ...base, choices:[], usage:response.usage }),
        event('[DONE]'),
    ]
}

export function writeInferenceStream (
    res:StreamSink,
    protocol:string,
    response:unknown
):void {
    let events:string[]
    if (protocol === 'chat') events = chatEvents(obj(response))
    else throw new Error(`unsupported inference protocol "${protocol}"`)
    res.setHeader('Content-Type', 'text/event-stream')
    for (const e of events) res.write(e)
    res.end()
}

// `writeInferenceStream` from a JSON string.
export function writeJSONStream (
    res:StreamSink,
    protocol:string,
    body:string
):void {
    writeInferenceStream(res, protocol, JSON.parse(body))
}
