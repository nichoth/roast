rts the fake inference server shared by both CLIs.\n    server?:() => Promise<InferenceServer>;\n    records?:boolean;\n    requests?:boolean;\n}\n\nexport interface CliRun {\n    trustExit?:number|string;\n    exit:number|string;\n    stdout:string;\n    stderr:string;\n    records:Map<string, Decoded>;\n    requests:RecordedRequest[];\n    ctx:NormalizeContext;\n}\n\nexport interface ScenarioResult {\n    diffs:Difference[];\n    unexplained:Difference[];\n    go:CliRun;\n    ts:CliRun;\n}\n\nconst RUN_TIMEOUT_MS = 120_000\n\ninterface Exec {\n    exit:number|string;\n    stdout:string;\n    stderr:string;\n}\n\nfunction exec (\n    cli:Cli,\n    argv:string[],\n    cwd:string,\n    env:Record<string, string>\n):Promise<Exec> {\n    return new Promise((resolve, reject) => {\n        const child = spawn(cli.command, [...cli.args, ...argv], {\n            cwd,\n            env,\n            stdio:['ignore', 'pipe', 'pipe'],\n        })\n        let stdout = ''\n        let stderr = ''\n        let timedOut = false\n        const timer = setTimeout(() => {\n            timedOut = true\n            child.kill('SIGKILL')\n        }, RUN_TIMEOUT_MS)\n        child.stdout.setEncoding('utf8')\n        child.stderr.setEncoding('utf8')\n        child.stdout.on('data', chunk => { stdout += chunk })\n        child.stderr.on('data', chunk => { stderr += chunk })\n        child.on('error', err => {\n            clearTimeout(timer)\n            reject(err)\n        })\n        child.on('close', (code, signal) => {\n            clearTimeout(timer)\n            const exit = timedOut ?\n                'timeout' :\n                code ?? `signal ${signal ?? 'unknown'}`\n            resolve({ exit, stdout, stderr })\n        })\n    })\n}\n\nasync function runSide (\n    cli:Cli,\n    s:Scenario,\n    root:string,\n    server:InferenceServer|undefined\n):Promise<CliRun> {\n    const side = path.join(root, cli.name)\n    const repo = path.join(side, 'repo')\n    const home = path.join(side, 'home')\n    const sctx:ScenarioContext = { url:server?.url ?? '' }\n    const env = { ...scrubbedEnv(process.env, home), ...s.env?.(sctx) }\n    const files = typeof s.files === 'function' ? s.files(sctx) : s.files\n    buildFixture(repo, files, env)\n    const cwd = path.join(repo, s.cwd ?? '')\n    const before = server?.requests.length ?? 0\n    let trustExit:number|string|undefined\n    if (s.trust) trustExit = (await exec(cli, s.trust, cwd, env)).exit\n    const r = await exec(cli, s.argv, cwd, env)\n    return {\n        trustExit,\n        exit:r.exit,\n        stdout:r.stdout,\n        stderr:r.stderr,\n        records:s.records ? readRecords(repo) : new Map(),\n        requests:server?.requests.slice(before) ?? [],\n        ctx:{ paths:[repo, home] },\n    }\n}\n\nfunction parseStdout (\n    format:'json'|'kv',\n    text:string,\n    ctx:NormalizeContext\n):unknown {\n    const parsed = format === 'json' ?\n        parseJsonOutput(text) :\n        parseKeyValues(text)\n    return normalize(parsed, ctx)\n}\n\nexport function compareRuns (s:Scenario, go:CliRun, ts:CliRun):Difference[] {\n    const out:Difference[] = []\n    if (go.trustExit !== ts.trustExit) {\n        out.push({ path:'trust.exit', go:go.trustExit, ts:ts.trustExit })\n    }\n    if (go.exit !== ts.exit) out.push({ path:'exit', go:go.exit, ts:ts.exit })\n    if (s.stdout) {\n        deepDiff(parseStdout(s.stdout, go.stdout, go.ctx),\n            parseStdout(s.stdout, ts.stdout, ts.ctx), 'stdout', out)\n    }\n    if (s.records) {\n        out.push(...compareRecords(go.records, ts.records, go.ctx, ts.ctx))\n    }\n    if (s.requests) {\n        out.push(...compareRequests(go.requests, ts.requests, go.ctx,\n            ts.ctx))\n    }\n    return out\n}\n\n// Runs `s` with `go` then `ts`, each in its own fixture repository and\n// home under one temporary directory, sharing one fake server.\nexport async function runScenario (\n    s:Scenario,\n    clis:{ go:Cli, ts:Cli }\n):Promise<ScenarioResult> {\n    const root = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-')))\n    const server = s.server ? await s.server() : undefined\n    try {\n        const go = await runSide({ ...clis.go, name:'go' }, s, root, server)\n        const ts = await runSide({ ...clis.ts, name:'ts' }, s, root, server)\n        const diffs = compareRuns(s, go, ts)\n        return { diffs, unexplained:unexplained(s.name, diffs), go, ts }\n    } finally {\n        await server?.close()\n        fs.rmSync(root, { recursive:true, force:true })\n    }\n}\n// Entry of the Go-vs-TS differential harness (spec 15, 2.13), bundled to\n// test/diff-bundle.js by `node scripts/bundle.ts --diff` and run by `npm\n// run test:diff` after `npm run bundle`. Temporary: deleted at M6.\n// test/index.ts never imports it.\n//\n// The self-tests run first and need no Go. Every scenario then runs the\n// baseline Go CLI and `node dist/cli.js`; without `go` on PATH each\n// scenario is a TAP skip.\nimport './selftest/baseline.js'\nimport './selftest/compare.js'\nimport './selftest/harness.js'\nimport './prompts.js'\nimport { test } from '../helpers/test.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport {\n    BASELINE_REV,\n    type Baseline,\n    DEFAULT_CACHE_PATH,\n    ensureBaseline,\n} from './baseline.js'\nimport { type Scenario, TS_CLI, goCli, runScenario } from './scenario.js'\nimport { M1_SCENARIOS } from './scenarios/m1.js'\n\nconst SCENARIOS:readonly Scenario[] = [...M1_SCENARIOS]\n\nlet baseline:Promise<Baseline>|undefined\nfunction getBaseline ():Promise<Baseline> {\n    baseline ??= ensureBaseline({\n        root:ROOT,\n        rev:BASELINE_REV,\n        cachePath:DEFAULT_CACHE_PATH,\n        env:process.env,\n    })\n    return baseline\n}\n\nfor (const s of SCENARIOS) {\n    test(s.name, async t => {\n        const b = await getBaseline()\n        if (b.kind === 'no-go') {\n            t.ok(true, `${s.name} # SKIP go is not on PATH`)\n            return\n        }\n        const r = await runScenario(s, { go:goCli(b.path), ts:TS_CLI })\n        t.comment(`exit go=${r.go.exit} ts=${r.ts.exit}`)\n        t.deepEqual(r.unexplained, [], 'no difference outside the allowlist')\n        if (r.unexplained.length > 0) {\n            t.comment(`go stderr: ${r.go.stderr.trim()}`)\n            t.comment(`ts stderr: ${r.ts.stderr.trim()}`)\n        }\n    })\n}\n// M1 scenarios (config, trust, credentials): every config case runs\n// through the two config-reading commands that exist at M1, `gate\n// settings` (stdout compared as key=value lines) and `trust --yes` (exit\n// code only; trust output and trust.json differ by design).\nimport type { Scenario } from '../scenario.js'\n\ninterface ConfigCase {\n    name:string;\n    files:Record<string, string>;\n    cwd?:string;\n    // Extra arguments for both commands (`--config <path>`).\n    args?:string[];\n}\n\nconst CUSTOM_GATE = `{\n    \"version\": 1,\n    \"gate\": {\"timeout_seconds\": 42, \"severity\": \"medium\"}\n}\n`\n\nconst JSONC = `// Project config\n{\n    \"version\": 1,\n    /* the gate */\n    \"gate\": {\n        \"timeout_seconds\": 7, // seconds\n        \"severity\": \"LOW\",\n    },\n}\n`\n\nconst GATEWAY = `{\n    \"version\": 1,\n    \"inference_profiles\": {\n        \"gw\": {\n            \"endpoint\": \"https://gateway.example.com/v1\",\n            \"model\": \"m\",\n            \"protocol\": \"chat\",\n            \"api_key_env\": \"GATEWAY_KEY\"\n        }\n    },\n    \"roles\": {\"finder\": {\"profile\": \"gw\"}, \"verifier\": {\"profile\": \"gw\"}},\n    \"gate\": {\"severity\": \"critical\"}\n}\n`\n\nconst config = (text:string):Record<string, string> => ({\n    '.roast.json':text,\n})\n\nconst VALID:ConfigCase[] = [\n    { name:'defaults only', files:config('{\"version\": 1}\\n') },\n    { name:'custom gate section', files:config(CUSTOM_GATE) },\n    { name:'JSONC with comments and a trailing comma', files:config(JSONC) },\n    {\n        name:'config in a subdirectory',\n        files:{ 'sub/.roast.json':CUSTOM_GATE },\n        cwd:'sub',\n    },\n    {\n        name:'nearest config wins over the toplevel',\n        files:{ '.roast.json':JSONC, 'sub/.roast.json':CUSTOM_GATE },\n        cwd:'sub',\n    },\n    {\n        name:'toplevel config found from a subdirectory',\n        files:{ '.roast.json':CUSTOM_GATE, 'sub/file.txt':'x\\n' },\n        cwd:'sub',\n    },\n    {\n        name:'explicit --config',\n        files:{ 'conf/roast.json':CUSTOM_GATE },\n        args:['--config', 'conf/roast.json'],\n    },\n    { name:'profile on a custom endpoint', files:config(GATEWAY) },\n]\n\nconst INVALID:ConfigCase[] = [\n    { name:'missing version', files:config('{}\\n') },\n    { name:'version 2', files:config('{\"version\": 2}\\n') },\n    {\n        name:'unknown top-level field',\n        files:config('{\"version\": 1, \"bogus\": true}\\n'),\n    },\n    {\n        name:'unknown nested field',\n        files:config('{\"version\": 1, \"gate\": {\"timeout\": 5}}\\n'),\n    },\n    {\n        name:'field name in another case',\n        files:config('{\"version\": 1, \"Gate\": {\"severity\": \"LOW\"}}\\n'),\n    },\n    {\n        name:'wrong JSON type',\n        files:config('{\"version\": 1, \"gate\": {\"timeout_seconds\": \"30\"}}\\n'),\n    },\n    {\n        name:'literal api_key',\n        files:config(`{\n            \"version\": 1,\n            \"inference_profiles\": {\n                \"p\": {\"model\": \"m\", \"protocol\": \"chat\", \"api_key\": \"sk-x\"}\n            }\n        }\\n`),\n    },\n    { name:'malformed JSONC', files:config('{\"version\": 1,,}\\n') },\n    { name:'unterminated JSONC', files:config('{\"version\": 1\\n') },\n    { name:'trailing content', files:config('{\"version\": 1} {}\\n') },\n    {\n        name:'invalid duration string',\n        files:config('{\"version\": 1, \"limits\": {\"deadline\": \"5 minutes\"}}\\n'),\n    },\n    {\n        name:'negative gate timeout',\n        files:config('{\"version\": 1, \"gate\": {\"timeout_seconds\": -1}}\\n'),\n    },\n    {\n        name:'unknown gate severity',\n        files:config('{\"version\": 1, \"gate\": {\"severity\": \"SEVERE\"}}\\n'),\n    },\n    {\n        name:'non-integer lexeme in an integer field',\n        files:config('{\"version\": 1, \"gate\": {\"timeout_seconds\": 1.0}}\\n'),\n    },\n    {\n        name:'unknown role name',\n        files:config(`{\n            \"version\": 1,\n            \"inference_profiles\": {\"p\": {\"model\": \"m\", \"protocol\": \"chat\"}},\n            \"roles\": {\"reviewer\": {\"profile\": \"p\"}}\n        }\\n`),\n    },\n    { name:'missing config', files:{ 'README.md':'no config\\n' } },\n    {\n        name:'--config names a missing file',\n        files:config('{\"version\": 1}\\n'),\n        args:['--config', 'missing.json'],\n    },\n]\n\nfunction scenarios (c:ConfigCase):Scenario[] {\n    const args = c.args ?? []\n    return [\n        {\n            name:`gate settings: ${c.name}`,\n            files:c.files,\n            cwd:c.cwd,\n            argv:['gate', 'settings', ...args],\n            stdout:'kv',\n        },\n        {\n            name:`trust --yes: ${c.name}`,\n            files:c.files,\n            cwd:c.cwd,\n            argv:['trust', '--yes', ...args],\n        },\n    ]\n}\n\nexport const M1_SCENARIOS:readonly Scenario[] = [...VALID, ...INVALID]\n    .flatMap(scenarios)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PGw6QLagTPDFJbZY6wVBMz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017vAENFsXXqS792J6jHrJaU","type":"tool_result","content":"test/diff/allowlist.ts\ntest/diff/baseline.ts\ntest/diff/compare.ts\ntest/diff/fixture.ts\ntest/diff/index.ts\ntest/diff/normalize.ts\ntest/diff/prompts.ts\ntest/diff/records.ts\ntest/diff/requests.ts\ntest/diff/scenario.ts\ntest/diff/tar.ts\n\ntest/diff:\nallowlist.ts\nbaseline.ts\ncompare.ts\nfixture.ts\nindex.ts\nnormalize.ts\nprompts.ts\nrecords.ts\nrequests.ts\nscenario.ts\nscenarios/\nselftest/\ntar.ts\n\ntest/diff/scenarios:\nm1.ts\n\ntest/diff/selftest:\nbaseline.ts\ncompare.ts\nharness.ts\n      40 test/diff/allowlist.ts\n     127 test/diff/baseline.ts\n      81 test/diff/compare.ts\n      67 test/diff/fixture.ts\n      52 test/diff/index.ts\n      65 test/diff/normalize.ts\n     181 test/diff/prompts.ts\n     213 test/diff/records.ts\n      96 test/diff/requests.ts\n     208 test/diff/scenario.ts\n      75 test/diff/tar.ts\n     161 test/diff/scenarios/m1.ts\n     196 test/diff/selftest/baseline.ts\n     271 test/diff/selftest/compare.ts\n     128 test/diff/selftest/harness.ts\n    1961 total\n{\n  \"name\": \"@substrate-system/roast\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Adversarial review\",\n  \"license\": \"(MIT OR Apache-2.0)\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"roast\": \"dist/launcher.js\"\n  },\n  \"files\": [\n    \"dist/\",\n    \"roast.schema.json\",\n    \"LICENSE.txt\",\n    \"LICENSE-MIT.txt\",\n    \"LICENSE-APACHE.txt\"\n  ],\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"devEngines\": {\n    \"runtime\": {\n      \"name\": \"node\",\n      \"version\": \">=22.18\"\n    }\n  },\n  \"scripts\": {\n    \"toc\": \"markdown-toc --maxdepth 3 -i README.md\",\n    \"lint\": \"node --import ./scripts/eslint-ts6.ts node_modules/eslint/bin/eslint.js src test scripts eslint.config.js --ignore-pattern 'src/launcher.ts' --ignore-pattern 'test/*.test.ts' --ignore-pattern 'test/release-fixture.ts' --ignore-pattern 'scripts/build.ts' --ignore-pattern 'scripts/check-pack.ts' --ignore-pattern 'scripts/check-release.ts' --ignore-pattern 'scripts/platforms.ts' --ignore-pattern 'scripts/release.ts' --ignore-pattern 'scripts/version.ts'\",\n    \"typecheck\": \"tsc -p tsconfig.json\",\n    \"build\": \"npm run schema && node scripts/build.ts\",\n    \"bundle\": \"npm run schema && node scripts/bundle.ts\",\n    \"schema\": \"node scripts/schema.ts\",\n    \"build:launcher\": \"tsc -p tsconfig.launcher.json\",\n    \"build:test\": \"node scripts/bundle.ts --test\",\n    \"test\": \"npm run typecheck && npm run bundle && npm run build:test && npm run test:tap\",\n    \"test:go\": \"go test ./... && npm run build:launcher && node --test \\\"test/**/*.test.ts\\\"\",\n    \"test:tap\": \"bash -o pipefail -c 'node test/test-bundle.js | tap-spec'\",\n# TypeScript rewrite\n\nApplies to `src/`, `test/`, and `scripts/`. Notes for one area are in\nthat area's file (index in `AGENTS.md`).\n\n## Tooling\n\n- `npm test` runs `typecheck`, then bundles and runs the tapzero suite.\n  A new test module must be imported from `test/index.ts`. esbuild drops\n  unused imports without resolving them, so only `typecheck` catches a\n  broken import.\n- `npm run test:one -- test/<area>/<file>.ts` bundles one test module\n  to `test/one-bundle.js` and runs it through tap-spec. Test modules\n  cannot run directly under Node: their `.js` import specifiers only\n  resolve once bundled. It does not typecheck; run `typecheck` too.\n- Lint with `npm run lint`: it preloads `scripts/eslint-ts6.ts`, which\n  gives eslint the TypeScript 6 API because typescript-eslint throws on\n  the TypeScript 7 that `typecheck` uses.\n- Legacy launcher and release files are excluded by name from lint (the\n  `--ignore-pattern` list) and typecheck (`tsconfig.json` `exclude`);\n  the launcher compiles with `tsconfig.launcher.json`.\n- Node runs `scripts/` directly (type stripping), so they use only\n  erasable syntax: no enums, namespaces, or parameter properties.\n- `baseOptions` in `scripts/esbuild-options.ts` holds the esbuild\n  options every bundle shares (text loaders for `.tmpl`, `.md`, `.sh`;\n  `mainFields: ['module', 'main']`, which `jsonc-parser`'s UMD build\n  needs); `scripts/bundle.ts` adds the `require` shim banner. A test\n  that bundles code itself uses both.\n- `npm run bundle` also writes `dist/THIRD_PARTY_LICENSES.txt`\n  (`scripts/licenses.ts`) and fails, naming the package, when a bundled\n  package lacks an allowlisted `license` field or a license file. A new\n  runtime dependency must pass it; extending `ALLOWED_LICENSES` needs\n  maintainer approval. `@substrate-system/debug` fails it today, so no\n  `src/` module may import it yet.\n\n## Source conventions\n\n- Keep source ASCII: write `\\uXXXX` escapes. Some editing tools decode\n  escapes into literal characters when writing; check with\n  `grep -nP '[^\\x00-\\x7f]'` after writing a file. eslint `--fix`\n  (quote-props) rewrites a quoted `'\\u00e9'` object key into a literal\n  non-ASCII identifier; put such keys in a const and use a computed key.\n- eslint rejects control characters in regex literals\n  (`no-control-regex`) and labeled statements (`no-labels`); scan char\n  codes and use helper functions instead.\n- Startup guards live in `src/startup.ts`, not `src/cli.ts`: importing\n  the entry runs the CLI, so testable helpers sit in other modules.\n- Module-level swappable functions use a mutable hooks object plus a\n  delegating export (`terminalHooks`, `skillHooks.lookPath`), because\n  tests cannot reassign an ESM `let` export. Swap the object's field\n  and restore it in `t.cleanup`.\n- Shared helpers; import these, never re-implement:\n  `src/gocompat/` (`strings.ts`: Go TrimSpace/Ext/`%.2f`/strconv.Quote/\n  byte-order sort and `truncateUtf8`; `duration.ts`: Go durations as\n  bigint nanoseconds; `match.ts`: Go `path.Match`),\n  `src/textsafe/textsafe.ts`, `src/fsutil/atomic.ts`\n  (`writeFileAtomic`, options cover trust, credentials, and gate temp\n  names and error messages), `src/git/git.ts` (the only git runner;\n  pass the CLI context's `env`, it reads `process.env` only when none is\n  given), `src/util/pool.ts` (`mapPool`).\n\n## CLI core (`src/cli/`)\n\n- Commands are `CommandDef`s (`command.ts`) listed in `commands.ts`;\n  `run.ts` builds the yargs tree from that list plus `registerCommand`\n  (tests), and calls the handler only after parsing succeeds.\n- A handler gets a `RunContext` (cwd, env, signal, fetch, one shared\n  `LineReader`) and throws `UsageError` / `ExitSignal` / any error; it\n  never writes the error itself or reads process globals.\n- A group with `subcommands` and no handler prints its help.\n- yargs number parsing is off (`parse-numbers: false`). Declare an\n  integer flag as `type:'string'` and parse decimal digits in the\n  handler, throwing `UsageError` on a bad value (see `parseLimit` in\n  `runs.ts`).\n- Terminal detection and browser opening are swapped through\n  `terminalHooks` (`terminal.ts`).\n- With only the default `$0` command registered, yargs omits the\n  Commands section from root help; it appears once a second command\n  registers.","is_error":false}]},"parent_tool_use_id":null,"session_id":"ca44731d-7017-4aec-9d20-b88aa7cfd62f","uuid":"abbeb3fb-ccfa-4347-83df-dc7a7984083d","timestamp":"2026-11-24T02:27:40.256Z","tool_use_result":{"stdout":"test/diff/allowlist.ts\ntest/diff/baseline.ts\ntest/diff/compare.ts\ntest/diff/fixture.ts\ntest/diff/index.ts\ntest/diff/normalize.ts\ntest/diff/prompts.ts\ntest/diff/records.ts\ntest/diff/requests.ts\ntest/diff/scenario.ts\ntest/diff/tar.ts\n\ntest/diff:\nallowlist.ts\nbaseline.ts\ncompare.ts\nfixture.ts\nindex.ts\nnormalize.ts\nprompts.ts\nrecords.ts\nrequests.ts\nscenario.ts\nscenarios/\nselftest/\ntar.ts\n\ntest/diff/scenarios:\nm1.ts\n\ntest/diff/selftest:\nbaseline.ts\ncompare.ts\nharness.ts\n      40 test/diff/allo