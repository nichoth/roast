hema,\\n20\\t    type RawConfig,\\n21\\t    type RawProfile,\\n22\\t    type RawRole,\\n23\\t    SEVERITIES,\\n24\\t} from './schema.js'\\n25\\t\\n26\\timport {\\n27\\t    DEFAULT_CONFIDENCE_FLOOR, DEFAULT_QUICK_CONFIDENCE_FLOOR,\\n28\\t    DEFAULT_SNAPSHOT, DEFAULT_GATE_OFFER,\\n29\\t} from './defaults.js'\\n30\\texport {\\n31\\t    DEFAULT_CONFIDENCE_FLOOR, DEFAULT_QUICK_CONFIDENCE_FLOOR,\\n32\\t} from './defaults.js'\\n33\\t\\n34\\texport type { StoredCredentials }\\n35\\t\\n36\\texport const PROJECT_CONFIG_NAME = '.roast.json'\\n37\\t\\n38\\t// Every config discovery, parse, and validation failure. The CLI wraps\\n39\\t// it as a usage error.\\n40\\texport class ConfigError extends Error {\\n41\\t    constructor (message:string, opts?:{ cause?:unknown }) {\\n42\\t        super(message, opts)\\n43\\t        this.name = 'ConfigError'\\n44\\t    }\\n45\\t}\\n46\\t\\n47\\tfunction causeText (err:unknown):string {\\n48\\t    return err instanceof Error ? err.message : String(err)\\n49\\t}\\n50\\t\\n51\\tfunction findError (err:unknown):ConfigError {\\n52\\t    return new ConfigError(`find project config: ${causeText(err)}`,\\n53\\t        { cause:err })\\n54\\t}\\n55\\t\\n56\\tfunction isNotFound (err:unknown):boolean {\\n57\\t    const code = (err as NodeJS.ErrnoException|undefined)?.code\\n58\\t    return code === 'ENOENT' || code === 'ENOTDIR'\\n59\\t}\\n60\\t\\n61\\t// The nearest .roast.json at or above `start`, never looking above\\n62\\t// `stop`, or '' when there is none. Directories compare by realpath (on\\n63\\t// macOS a temp dir is /var/... while git prints /private/var/...), but\\n64\\t// the returned path is spelled through `start`.\\n65\\texport function findConfig (start:string, stop:string):string {\\n66\\t    let dir = path.resolve(start)\\n67\\t    let stopCanonical:string\\n68\\t    try {\\n69\\t        stopCanonical = fs.realpathSync(path.resolve(stop))\\n70\\t    } catch (err) {\\n71\\t        throw findError(err)\\n72\\t    }\\n73\\t    for (;;) {\\n74\\t        const candidate = path.join(dir, PROJECT_CONFIG_NAME)\\n75\\t        try {\\n76\\t            if (!fs.statSync(candidate).isDirectory()) return candidate\\n77\\t        } catch (err) {\\n78\\t            if (!isNotFound(err)) throw findError(err)\\n79\\t        }\\n80\\t        let canonical:string\\n81\\t        try {\\n82\\t            canonical = fs.realpathSync(dir)\\n83\\t        } catch (err) {\\n84\\t            throw findError(err)\\n85\\t        }\\n86\\t        const parent = path.dirname(dir)\\n87\\t        if (canonical === stopCanonical || parent === dir) return ''\\n88\\t        dir = parent\\n89\\t    }\\n90\\t}\\n91\\t\\n92\\texport const CURRENT_VERSION = 1\\n93\\texport const DEFAULT_MAX_OUTPUT_TOKENS = 32768\\n94\\tconst MAX_SESSION_HEADER_LENGTH = 64\\n95\\t\\n96\\texport interface NormalizedProfile extends RawProfile {\\n97\\t    protocol:string;\\n98\\t    max_output_tokens:number;\\n99\\t}\\n100\\t\\n101\\texport interface NormalizedLimits extends Omit<\\n102\\t    NonNullable<RawConfig['limits']>, 'deadline'|'request_timeout'\\n103\\t> {\\n104\\t    deadline?:GoDuration;\\n105\\t    request_timeout?:GoDuration;\\n106\\t}\\n107\\t\\n108\\texport interface NormalizedConfig extends Omit<\\n109\\t    RawConfig, 'inference_profiles'|'roles'|'limits'\\n110\\t> {\\n111\\t    inference_profiles:Record<string, NormalizedProfile>;\\n112\\t    roles:{ finder?:RawRole, verifier?:RawRole };\\n113\\t    review:NonNullable<RawConfig['review']>&{\\n114\\t        confidence_floor:number;\\n115\\t        quick_confidence_floor:number;\\n116\\t    };\\n117\\t    limits?:NormalizedLimits;\\n118\\t}\\n119\\t\\n120\\texport interface ProjectConfig extends NormalizedConfig {\\n121\\t    // The directory holding the config file; '' when not loaded from one.\\n122\\t    readonly dir:string;\\n123\\t    readonly stored?:StoredCredentials;\\n124\\t}\\n125\\t\\n126\\ttype Path = readonly (string|number)[]\\n127\\t\\n128\\tfunction dotted (at:Path):string {\\n129\\t    return at.map(String).join('.')\\n130\\t}\\n131\\t\\n132\\t// Step 2: the value is an object whose version is 1.\\n133\\tfunction checkVersion (value:JsonValue):asserts value is JsonObject {\\n134\\t    if (!isJsonObject(value)) {\\n135\\t        const got = Array.isArray(value) ? 'array' : typeof value\\n136\\t        throw new ConfigError(`config must be a JSON object (got ${got})`)\\n137\\t    }\\n138\\t    const version = Object.hasOwn(value, 'version') ?\\n139\\t        value.version :\\n140\\t        null\\n141\\t    if (version === null) {\\n142\\t        throw new ConfigError('version is required (set \\\"version\\\": 1)')\\n143\\t    }\\n144\\t    if (typeof version !== 'number' || !Number.isInteger(version)) {\\n145\\t        throw new ConfigError(\\n146\\t            `version must be an integer (got ${JSON.stringify(version)})`)\\n147\\t    }\\n148\\t    if (version !== CURRENT_VERSION) {\\n149\\t        throw new ConfigError(`unsupported config version ${version} ` +\\n150\\t            `(this build supports version ${CURRENT_VERSION})`)\\n151\\t    }\\n152\\t}\\n153\\t\\n154\\t// Step 3: a profile never holds a credential.\\n155\\tfunction rejectLiteralCredentials (value:JsonObject):void {\\n156\\t    const profiles = value.inference_profiles\\n157\\t    if (!isJsonObject(profiles)) return\\n158\\t    for (const [name, profile] of Object.entries(profiles)) {\\n159\\t        if (isJsonObject(profile) && Object.hasOwn(profile, 'api_key')) {\\n160\\t            throw new ConfigError(`inference_profiles.${name}.api_key is ` +\\n161\\t                'not allowed: a project config never holds a credential; ' +\\n162\\t                'name its environment variable with api_key_env')\\n163\\t        }\\n164\\t    }\\n165\\t}\\n166\\t\\n167\\t// Maps whose values are objects or strings: a null value there is the\\n168\\t// zero value, not an absent key (Go map decoding).\\n169\\tconst MAP_ZERO:Record<string, () => JsonValue> = {\\n170\\t    inference_profiles:newObject,\\n171\\t    roles:newObject,\\n172\\t    author_routes:() => '',\\n173\\t}\\n174\\t\\n175\\t// Step 4: Go parity for null. In fixed-shape objects a null property is\\n176\\t// deleted; in maps a null value becomes the zero value; a null array\\n177\\t// element becomes \\\"\\\".\\n178\\tfunction nullsAsUnset (value:JsonValue, mapKey?:string):JsonValue {\\n179\\t    if (Array.isArray(value)) {\\n180\\t        return value.map(v => v === null ? '' : nullsAsUnset(v))\\n181\\t    }\\n182\\t    if (!isJsonObject(value)) return value\\n183\\t    const out = newObject()\\n184\\t    const zero = mapKey === undefined ? undefined : MAP_ZERO[mapKey]\\n185\\t    for (const [key, v] of Object.entries(value)) {\\n186\\t        if (v === null) {\\n187\\t            if (zero) setKey(out, key, zero())\\n188\\t            continue\\n189\\t        }\\n190\\t        // inference_profiles and roles hold objects, whose own keys are\\n191\\t        // fixed-shape again; author_routes is a map at any depth.\\n192\\t        const childMap = zero ? undefined : (key in MAP_ZERO ? key : undefined)\\n193\\t        setKey(out, key, nullsAsUnset(v, childMap))\\n194\\t    }\\n195\\t    return out\\n196\\t}\\n197\\t\\n198\\tfunction hasLoneSurrogate (s:string):boolean {\\n199\\t    for (let i = 0; i < s.length; i++) {\\n200\\t        const c = s.charCodeAt(i)\\n201\\t        if (c >= 0xd800 && c <= 0xdbff) {\\n202\\t            const next = s.charCodeAt(i + 1)\\n203\\t            if (next >= 0xdc00 && next <= 0xdfff) {\\n204\\t                i++\\n205\\t                continue\\n206\\t            }\\n207\\t            return true\\n208\\t        }\\n209\\t        if (c >= 0xdc00 && c <= 0xdfff) return true\\n210\\t    }\\n211\\t    return false\\n212\\t}\\n213\\t\\n214\\t// Step 5a: every key and string is well-formed UTF-16, so the trust hash\\n215\\t// is always defined.\\n216\\tfunction rejectLoneSurrogates (value:JsonValue, at:Path = []):void {\\n217\\t    if (typeof value === 'string') {\\n218\\t        if (hasLoneSurrogate(value)) {\\n219\\t            throw new ConfigError(`${dotted(at) || 'config'}: string ` +\\n220\\t                'contains a lone UTF-16 surrogate')\\n221\\t        }\\n222\\t        return\\n223\\t    }\\n224\\t    if (Array.isArray(value)) {\\n225\\t        value.forEach((v, i) => rejectLoneSurrogates(v, [...at, i]))\\n226\\t        return\\n227\\t    }\\n228\\t    if (!isJsonObject(value)) return\\n229\\t    for (const [key, v] of Object.entries(value)) {\\n230\\t        if (hasLoneSurrogate(key)) {\\n231\\t            throw new ConfigError(`${dotted(at) || 'config'}: key ` +\\n232\\t                'contains a lone UTF-16 surrogate')\\n233\\t        }\\n234\\t        rejectLoneSurrogates(v, [...at, key])\\n235\\t    }\\n236\\t}\\n237\\t\\n238\\tinterface ZodDefLike {\\n239\\t    type:string;\\n240\\t    innerType?:ZodLike;\\n241\\t    shape?:Record<string, ZodLike>;\\n242\\t    valueType?:ZodLike;\\n243\\t    element?:ZodLike;\\n244\\t    format?:string;\\n245\\t}\\n246\\t\\n247\\tinterface ZodLike {\\n248\\t    _zod:{ def:ZodDefLike };\\n249\\t}\\n250\\t\\n251\\t// Whether `at` names an integer field of the schema.\\n252\\tfunction isIntegerField (at:Path):boolean {\\n253\\t    let s:ZodLike|undefined = ConfigSchema as unknown as ZodLike\\n254\\t    let i = 0\\n255\\t    while (s) {\\n256\\t        const def:ZodDefLike = s._zod.def\\n257\\t        if (def.type === 'optional') {\\n258\\t            s = def.innerType\\n259\\t            continue\\n260\\t        }\\n261\\t        if (i === at.length) {\\n262\\t            // `version` is the integer literal 1.\\n263\\t            return (def.type === 'number' && def.format === 'safeint') ||\\n264\\t                def.type === 'literal'\\n265\\t        }\\n266\\t        const key = at[i++]\\n267\\t        if (def.type === 'object') s = def.shape?.[String(key)]\\n268\\t        else if (def.type === 'record') s = def.valueType\\n269\\t        else if (def.type === 'array') s = def.element\\n270\\t        else return false\\n271\\t    }\\n272\\t    return false\\n273\\t}\\n274\\t\\n275\\tfunction issueMessage (issue:z.core.$ZodIssue):string {\\n276\\t    const at = dotted(issue.path as Path)\\n277\\t    if (issue.code === 'unrecognized_keys') {\\n278\\t        const key = issue.keys[0]\\n279\\t        if (at === 'roles') {\\n280\\t            return `roles.${key} is not a role (finder or verifier)`\\n281\\t        }\\n282\\t        return `${at ? `${at}: ` : ''}unknown field ${JSON.stringify(key)}`\\n283\\t    }\\n284\\t    return `${at || 'config'}: ${issue.message}`\\n285\\t}\\n286\\t\\n287\\t// Parses and structurally validates config text (spec 02, section 3,\\n288\\t// steps 1 to 5). Errors are thrown as ConfigError without a path prefix.\\n289\\texport function decode (text:string):RawConfig {\\n290\\t    let parsed:ReturnType<typeof parseJsonc>\\n291\\t    try {\\n292\\t        parsed = parseJsonc(text)\\n293\\t    } catch (err) {\\n294\\t        throw new ConfigError((err as Error).message, { cause:err })\\n295\\t    }\\n296\\t    const { value, nonIntegerLexemes } = parsed\\n297\\t    checkVersion(value)\\n298\\t    rejectLiteralCredentials(value)\\n299\\t    const cleaned = nullsAsUnset(value)\\n300\\t    rejectLoneSurrogates(cleaned)\\n301\\t    const result = ConfigSchema.safeParse(cleaned)\\n302\\t    if (!result.success) {\\n303\\t        throw new ConfigError(issueMessage(result.error.issues[0]))\\n304\\t    }\\n305\\t    for (const at of nonIntegerLexemes) {\\n306\\t        if (isIntegerField(at)) {\\n307\\t            throw new ConfigError(`${dotted(at)}: expected an integer ` +\\n308\\t                'without a fraction or exponent')\\n309\\t        }\\n310\\t    }\\n311\\t    // zod's output object would turn a `__proto__` key into a prototype,\\n312\\t    // so the validated input (null-prototype objects) is the config.\\n313\\t    return cleaned as RawConfig\\n314\\t}\\n315\\t\\n316\\tfunction isTokenChar (c:number):boolean {\\n317\\t    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||\\n318\\t        (c >= 48 && c <= 57) || \\\"!#$%&'*+-.^_`|~\\\".includes(\\n319\\t        String.fromCharCode(c))\\n320\\t}\\n321\\t\\n322\\tconst RESERVED_SESSION_HEADERS = [\\n323\\t    'Authorization', 'X-Api-Key', 'Proxy-Authorization', 'Cookie', 'Host',\\n324\\t    'Content-Type', 'Content-Length', 'Content-Encoding',\\n325\\t    'Transfer-Encoding', 'Connection', 'Keep-Alive', 'Proxy-Connection',\\n326\\t    'TE', 'Trailer', 'Upgrade', 'Expect', 'Accept', 'Accept-Encoding',\\n327\\t    'User-Agent', 'X-Agent-Session-Id', 'Anthropic-Version',\\n328\\t    'Anthropic-Beta', 'Anthropic-Workspace-Id', 'OpenAI-Organization',\\n329\\t    'OpenAI-Project',\\n330\\t].map(h => h.toLowerCase())\\n331\\t\\n332\\tfunction checkSessionHeader (field:string, name:string):void {\\n333\\t    let ok = name.length <= MAX_SESSION_HEADER_LENGTH\\n334\\t    for (let i = 0; ok && i < name.length; i++) {\\n335\\t        ok = isTokenChar(name.charCodeAt(i))\\n336\\t    }\\n337\\t    if (!ok) {\\n338\\t        throw new ConfigError(`${field} must be an HTTP header name of at ` +\\n339\\t            `most ${MAX_SESSION_HEADER_LENGTH} letters, digits, or ` +\\n340\\t            \\\"!#$%&'*+-.^_`|~ characters\\\")\\n341\\t    }\\n342\\t    const lower = name.toLowerCase()\\n343\\t    if (lower.startsWith('x-stainless-') ||\\n344\\t        RESERVED_SESSION_HEADERS.includes(lower)) {\\n345\\t        throw new ConfigError(`${field} cannot be ${JSON.stringify(name)}, ` +\\n346\\t            'which is reserved for credentials, request framing, or a ' +\\n347\\t            'header Roast or the provider SDK sets')\\n348\\t    }\\n349\\t}\\n350\\t\\n351\\tconst API_KEY_ENV = /^[A-Za-z_][A-Za-z0-9_]*$/\\n352\\t\\n353\\tfunction normalizeProfile (name:string, p:RawProfile):NormalizedProfile {\\n354\\t    if (name.trim() === '') {\\n355\\t        throw new ConfigError('inference profile names cannot be empty')\\n356\\t    }\\n357\\t    const field = `inference_profiles.${name}`\\n358\\t    const out:NormalizedProfile = {\\n359\\t        ...p,\\n360\\t        protocol:p.protocol || DEFAULT_PROTOCOL,\\n361\\t        max_output_tokens:p.max_output_tokens || DEFAULT_MAX_OUTPUT_TOKENS,\\n362\\t    }\\n363\\t    if (p.api_key_env && !API_KEY_ENV.test(p.api_key_env)) {\\n364\\t        throw new ConfigError(`${field}.api_key_env is not a valid ` +\\n365\\t            'environment variable name')\\n366\\t    }\\n367\\t    const problem = endpointProblem(field,\\n368\\t        p.endpoint || defaultBaseURL(out.protocol), out.protocol,\\n369\\t        out.max_output_tokens)\\n370\\t    if (problem) throw new ConfigError(problem)\\n371\\t    if (p.session_header) {\\n372\\t        checkSessionHeader(`${field}.session_header`, p.session_header)\\n373\\t    }\\n374\\t    return out\\n375\\t}\\n376\\t\\n377\\tfunction normalizeRole (\\n378\\t    name:string,\\n379\\t    role:RawRole,\\n380\\t    profiles:Record<string, NormalizedProfile>\\n381\\t):RawRole {\\n382\\t    if (!role.profile) {\\n383\\t        throw new ConfigError(`roles.${name}.profile is required`)\\n384\\t    }\\n385\\t    if (!Object.hasOwn(profiles, role.profile)) {\\n386\\t        throw new ConfigError(`roles.${name}.profile references unknown ` +\\n387\\t            `inference profile ${JSON.stringify(role.profile)}`)\\n388\\t    }\\n389\\t    if (!role.author_routes) return role\\n390\\t    const routes = newObject<string>()\\n391\\t    for (const [rawKey, target] of Object.entries(role.author_routes)) {\\n392\\t        const key = canonicalFamily(rawKey.trim().toLowerCase())\\n393\\t        if (key === '') {\\n394\\t            throw new ConfigError(`roles.${name}.author_routes contains ` +\\n395\\t                'empty model family')\\n396\\t        }\\n397\\t        if (!Object.hasOwn(profiles, target)) {\\n398\\t            throw new ConfigError(`roles.${name}.author_routes.${key} ` +\\n399\\t                'references unknown inference profile ' +\\n400\\t                JSON.stringify(target))\\n401\\t        }\\n402\\t        if (Object.hasOwn(routes, key)) {\\n403\\t            throw new ConfigError(`roles.${name}.author_routes contains ` +\\n404\\t                `duplicate family ${JSON.stringify(key)}`)\\n405\\t        }\\n406\\t        setKey(routes, key, target)\\n407\\t    }\\n408\\t    return { ...role, author_routes:routes }\\n409\\t}\\n410\\t\\n411\\tfunction checkFloor (key:string, v:number|undefined):void {\\n412\\t    if (v !== undefined && (v < 0 || v > 1)) {\\n413\\t        throw new ConfigError(`${key} must be between 0 and 1 (got ${v})`)\\n414\\t    }\\n415\\t}\\n416\\t\\n417\\tfunction parseDuration (key:string, s:string|undefined):GoDuration|undefined {\\n418\\t    if (s === undefined) return undefined\\n419\\t    let d:GoDuration\\n420\\t    try {\\n421\\t        d = parseGoDuration(s)\\n422\\t    } catch (err) {\\n423\\t        throw new ConfigError(`${key}: invalid duration ${JSON.stringify(s)}`,\\n424\\t            { cause:err })\\n425\\t    }\\n426\\t    if (d < 0n) throw new ConfigError(`${key} cannot be negative`)\\n427\\t    return d\\n428\\t}\\n429\\t\\n430\\t// Settings checks in Go's fixed order (spec 02, 2.4).\\n431\\tfunction validateSettings (raw:RawConfig):void {\\n432\\t    const ints:[string, number|undefined, number][] = [\\n433\\t        ['limits.max_total_tokens', raw.limits?.max_total_tokens, 0],\\n434\\t        ['limits.max_diff_bytes', raw.limits?.max_diff_bytes, 1],\\n435\\t        ['limits.max_prompt_bytes', raw.limits?.max_prompt_bytes, 1],\\n436\\t        ['limits.max_file_ctx_bytes', raw.limits?.max_file_ctx_bytes, 1],\\n437\\t        ['limits.max_attempts', raw.limits?.max_attempts, 1],\\n438\\t        ['limits.max_verified', raw.limits?.max_verified, 0],\\n439\\t        ['interactive.min_files', raw.interactive?.min_files, 0],\\n440\\t        ['interactive.min_diff_lines', raw.interactive?.min_diff_lines, 0],\\n441\\t        ['gate.timeout_seconds', raw.gate?.timeout_seconds, 0],\\n442\\t    ]\\n443\\t    for (const [key, v, min] of ints) {\\n444\\t        if (v !== undefined && v < min) {\\n445\\t            throw new ConfigError(\\n446\\t                `${key} must be an integer >= ${min} (got ${v})`)\\n447\\t        }\\n448\\t    }\\n449\\t    parseDuration('limits.deadline', raw.limits?.deadline)\\n450\\t    parseDuration('limits.request_timeout', raw.limits?.request_timeout)\\n451\\t    const severity = raw.gate?.severity\\n452\\t    if (severity &&\\n453\\t        !(SEVERITIES as readonly string[]).includes(severity.toUpperCase())) {\\n454\\t        throw new ConfigError('gate.severity must be INFO, LOW, MEDIUM, ' +\\n455\\t            `HIGH, or CRITICAL (got ${JSON.stringify(severity)})`)\\n456\\t    }\\n457\\t}\\n458\\t\\n459\\t// Applies defaults and the checks zod does not express, in Go's order:\\n460\\t// profiles, roles, confidence floors, then settings.\\n461\\texport function normalize (raw:RawConfig, dir:string):ProjectConfig {\\n462\\t    const profiles = newObject<NormalizedProfile>()\\n463\\t    for (const [name, p] of Object.entries(raw.inference_profiles ?? {})) {\\n464\\t        setKey(profiles, name, normalizeProfile(name, p))\\n465\\t    }\\n466\\t    const roles:NormalizedConfig['roles'] = {}\\n467\\t    for (const name of Object.keys(raw.roles ?? {})) {\\n468\\t        const role = raw.roles?.[name as 'finder'|'verifier']\\n469\\t        if (role) {\\n470\\t            roles[name as 'finder'|'verifier'] =\\n471\\t                normalizeRole(name, role, profiles)\\n472\\t        }\\n473\\t    }\\n474\\t    const review = raw.review ?? {}\\n475\\t    checkFloor('confidence_floor', review.confidence_floor)\\n476\\t    checkFloor('quick_confidence_floor', review.quick_confidence_floor)\\n477\\t    validateSettings(raw)\\n478\\t    const limits:NormalizedLimits|undefined = raw.limits && {\\n479\\t        ...raw.limits,\\n480\\t        deadline:parseDuration('limits.deadline', raw.limits.deadline),\\n481\\t        request_timeout:parseDuration('limits.request_timeout',\\n482\\t            raw.limits.request_timeout),\\n483\\t    }\\n484\\t    if (limits?.deadline === undefined) delete limits?.deadline\\n485\\t    if (limits?.request_timeout === undefined) delete limits?.request_timeout\\n486\\t    return {\\n487\\t        ...raw,\\n488\\t        inference_profiles:profiles,\\n489\\t        roles,\\n490\\t        review:{\\n491\\t            ...review,\\n492\\t            confidence_floor:review.confidence_floor ||\\n493\\t                DEFAULT_CONFIDENCE_FLOOR,\\n494\\t            quick_confidence_floor:review.quick_confidence_floor ||\\n495\\t                DEFAULT_QUICK_CONFIDENCE_FLOOR,\\n496\\t        },\\n497\\t        limits,\\n498\\t        dir,\\n499\\t    }\\n500\\t}\\n501\\t\\n502\\t// Reads, parses, and validates the config at `file`.\\n503\\texport function loadConfig (file:string):ProjectConfig {\\n504\\t    let text:string\\n505\\t    try {\\n506\\t        text = fs.readFileSync(file, 'utf8')\\n507\\t    } catch (err) {\\n508\\t        throw new ConfigError(`open config ${file}: ${causeText(err)}`,\\n509\\t            { cause:err })\\n510\\t    }\\n511\\t    let raw:RawConfig\\n512\\t    try {\\n513\\t        raw = decode(text)\\n514\\t    } catch (err) {\\n515\\t        throw new ConfigError(`parse config ${file}: ${causeText(err)}`,\\n516\\t            { cause:err })\\n517\\t    }\\n518\\t    return normalize(raw, path.resolve(path.dirname(file)))\\n519\\t}\\n520\\t\\n521\\texport function withStoredCredentials (\\n522\\t    cfg:ProjectConfig,\\n523\\t    stored:StoredCredentials\\n524\\t):ProjectConfig {\\n525\\t    return { ...cfg, stored }\\n526\\t}\\n527\\t\\n528\\t// The file a prompt override names: relative paths resolve against the\\n529\\t// config file's directory, so the same file is read wherever Roast runs.\\n530\\texport function promptPath (cfg:ProjectConfig, p:string):string {\\n531\\t    if (p === '' || path.isAbsolute(p) || cfg.dir === '') return p\\n532\\t    return path.join(cfg.dir, p)\\n533\\t}\\n534\\t\\n535\\t// Every credential variable a profile names, in document order.\\n536\\texport function credentialEnvNames (cfg:ProjectConfig):string[] {\\n537\\t    return Object.values(cfg.inference_profiles)\\n538\\t        .map(p => p.api_key_env ?? '')\\n539\\t        .filter(name => name !== '')\\n540\\t}\\n541\\t\\n542\\texport function snapshotEnabled (cfg:ProjectConfig):boolean {\\n543\\t    return cfg.review.snapshot ?? DEFAULT_SNAPSHOT\\n544\\t}\\n545\\t\\n546\\texport function gateOffers (cfg:ProjectConfig):boolean {\\n547\\t    return cfg.gate?.offer ?? DEFAULT_GATE_OFFER\\n548\\t}\\n549\\t\"}]},\"parent_tool_use_id\":\"toolu_01LzsVJpZ7Vs94dW34UXwttk\",\"agent_id\":\"a883dd28f064c36e5\",\"session_id\":\"8ab738d1-8d93-4956-976f-24d0ec7e1ea8\",\"uuid\":\"17158cfc-676a-4e2d-bc89-62ae9da880a7\",\"timestamp\":\"2026-11-24T00:56:13.355Z\",\"tool_result_meta\":[{\"id\":\"toolu_01Sh4M2DRdSKNQNKaZMTGTnt\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"mode\"}}],\"subagent_type\":\"fork\",\"task_description\":\"Read spec and source files\"}\n.scratch/ts-rewrite/logs/20-review-tracer-bullet-chat.log:210:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01LaEaC7sdSsyFnKjaddDRQE\",\"type\":\"tool_result\",\"content\":\"1\\t// Project config discovery and loading (spec 02, 2.2 to 2.4 and 2.8).\\n2\\timport fs from 'node:fs'\\n3\\timport path from 'node:path'\\n4\\timport type { z } from 'zod'\\n5\\timport { type GoDuration, parseGoDuration } from '../gocompat/duration.js'\\n6\\timport { DEFAULT_PROTOCOL, endpointProblem } from './endpoint.js'\\n7\\timport type { StoredCredentials } from './credential.js'\\n8\\timport { canonicalFamily } from './family.js'\\n9\\timport { defaultBaseURL } from './provider.js'\\n10\\timport {\\n11\\t    type JsonObject,\\n12\\t    type JsonValue,\\n13\\t    isJsonObject,\\n14\\t    newObject,\\n15\\t    parseJsonc,\\n16\\t    setKey,\\n17\\t} from './jsonc.js'\\n18\\timport {\\n19\\t    ConfigSchema,\\n20\\t    type RawConfig,\\n21\\t    type RawProfile,\\n22\\t    type RawRole,\\n23\\t    SEVERITIES,\\n24\\t} from './schema.js'\\n25\\t\\n26\\timport {\\n27\\t    DEFAULT_CONFIDENCE_FLOOR, DEFAULT_QUICK_CONFIDENCE_FLOOR,\\n28\\t    DEFAULT_SNAPSHOT, DEFAULT_GATE_OFFER,\\n29\\t} from './defaults.js'\\n30\\texport {\\n31\\t    DEFAULT_CONFIDENCE_FLOOR, DEFAULT_QUICK_CONFIDENCE_FLOOR,\\n32\\t} from './defaults.js'\\n33\\t\\n34\\texport type { StoredCredentials }\\n35\\t\\n36\\texport const PROJECT_CONFIG_NAME = '.roast.json'\\n37\\t\\n38\\t// Every config discovery, parse, and validation failure. The CLI wraps\\n39\\t// it as a usage error.\\n40\\texport class ConfigError extends Error {\\n41\\t    constructor (message:string, opts?:{ cause?:unknown }) {\\n42\\t        super(message, opts)\\n43\\t        this.name = 'ConfigError'\\n44\\t    }\\n45\\t}\\n46\\t\\n47\\tfunction causeText (err:unknown):string {\\n48\\t    return err instanceof Error ? err.message : String(err)\\n49\\t}\\n50\\t\\n51\\tfunction findError (err:unknown):ConfigError {\\n52\\t    return new ConfigError(`find project config: ${causeText(err)}`,\\n53\\t        { cause:err })\\n54\\t}\\n55\\t\\n56\\tfunction isNotFound (err:unknown):boolean {\\n57\\t    const code = (err as NodeJS.ErrnoException|undefined)?.code\\n58\\t    return code === 'ENOENT' || code === 'ENOTDIR'\\n59\\t}\\n60\\t\\n61\\t// The nearest .roast.json at or above `start`, never looking above\\n62\\t// `stop`, or '' when there is none. Directories compare by realpath (on\\n63\\t// macOS a temp dir is /var/... while git prints /private/var/...), but\\n64\\t// the returned path is spelled through `start`.\\n65\\texport function findConfig (start:string, stop:string):string {\\n66\\t    let dir = path.resolve(start)\\n67\\t    let stopCanonical:string\\n68\\t    try {\\n69\\t        stopCanonical = fs.realpathSync(path.resolve(stop))\\n70\\t    } catch (err) {\\n71\\t        throw findError(err)\\n72\\t    }\\n73\\t    for (;;) {\\n74\\t        const candidate = path.join(dir, PROJECT_CONFIG_NAME)\\n75\\t        try {\\n76\\t            if (!fs.statSync(candidate).isDirectory()) return candidate\\n77\\t        } catch (err) {\\n78\\t            if (!isNotFound(err)) throw findError(err)\\n79\\t        }\\n80\\t        let canonical:string\\n81\\t        try {\\n82\\t            canonical = fs.realpathSync(dir)\\n83\\t        } catch (err) {\\n84\\t            throw findError(err)\\n85\\t        }\\n86\\t        const parent = path.dirname(dir)\\n87\\t        if (canonical === stopCanonical || parent === dir) return ''\\n88\\t        dir = parent\\n89\\t    }\\n90\\t}\\n91\\t\\n92\\texport const CURRENT_VERSION = 1\\n93\\texport const DEFAULT_MAX_OUTPUT_TOKENS = 32768\\n94\\tconst MAX_SESSION_HEADER_LENGTH = 64\\n95\\t\\n96\\texport interface NormalizedProfile extends RawProfile {\\n97\\t    protocol:string;\\n98\\t    max_output_tokens:number;\\n99\\t}\\n100\\t\\n101\\texport interface NormalizedLimits extends Omit<\\n102\\t    NonNullable<RawConfig['limits']>, 'deadline'|'request_timeout'\\n103\\t> {\\n104\\t    deadline?:GoDuration;\\n105\\t    request_timeout?:GoDuration;\\n106\\t}\\n107\\t\\n108\\texport interface NormalizedConfig extends Omit<\\n109\\t    RawConfig, 'inference_profiles'|'roles'|'limits'\\n110\\t> {\\n111\\t    inference_profiles:Record<string, NormalizedProfile>;\\n112\\t    roles:{ finder?:RawRole, verifier?:RawRole };\\n113\\t    review:NonNullable<RawConfig['review']>&{\\n114\\t        confidence_floor:number;\\n115\\t        quick_confidence_floor:number;\\n116\\t    };\\n117\\t    limits?:NormalizedLimits;\\n118\\t}\\n119\\t\\n120\\texport interface ProjectConfig extends NormalizedConfig {\\n121\\t    // The directory holding the config file; '' when not loaded from one.\\n122\\t    readonly dir:string;\\n123\\t    readonly stored?:StoredCredentials;\\n124\\t}\\n125\\t\\n126\\ttype Path = readonly (string|number)[]\\n127\\t\\n128\\tfunction dotted (at:Path):string {\\n129\\t    return at.map(String).join('.')\\n130\\t}\\n131\\t\\n132\\t// Step 2: the value is an object whose version is 1.\\n133\\tfunction checkVersion (value:JsonValue):asserts value is JsonObject {\\n134\\t    if (!isJsonObject(value)) {\\n135\\t        const got = Array.isArray(value) ? 'array' : typeof value\\n136\\t        throw new ConfigError(`config must be a JSON object (got ${got})`)\\n137\\t    }\\n138\\t    const version = Object.hasOwn(value, 'version') ?\\n139\\t        value.version :\\n140\\t        null\\n141\\t    if (version === null) {\\n142\\t        throw new ConfigError('version is required (set \\\"version\\\": 1)')\\n143\\t    }\\n144\\t    if (typeof version !== 'number' || !Number.isInteger(version)) {\\n145\\t        throw new ConfigError(\\n146\\t            `version must be an integer (got ${JSON.stringify(version)})`)\\n147\\t    }\\n148\\t    if (version !== CURRENT_VERSION) {\\n149\\t        throw new ConfigError(`unsupported config version ${version} ` +\\n150\\t            `(this build supports version ${CURRENT_VERSION})`)\\n151\\t    }\\n152\\t}\\n153\\t\\n154\\t// Step 3: a profile never holds a credential.\\n155\\tfunction rejectLiteralCredentials (value:JsonObject):void {\\n156\\t    const profiles = value.inference_profiles\\n157\\t    if (!isJsonObject(profiles)) return\\n158\\t    for (const [name, profile] of Object.entries(profiles)) {\\n159\\t        if (isJsonObject(profile) && Object.hasOwn(profile, 'api_key')) {\\n160\\t            throw new ConfigError(`inference_profiles.${name}.api_key is ` +\\n161\\t                'not allowed: a project config never holds a credential; ' +\\n162\\t                'name its environment variable with api_key_env')\\n163\\t        }\\n164\\t    }\\n165\\t}\\n166\\t\\n167\\t// Maps whose values are object