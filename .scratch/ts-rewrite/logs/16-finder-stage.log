package review

import (
	"context"
	"encoding/json"
	"fmt"
	"net/http"
	"net/http/httptest"
	"sync/atomic"
	"testing"

	"github.com/bluesky-social/roast/internal/llm"
	"github.com/bluesky-social/roast/internal/testutil"
)

type scriptedCall struct {
	name string
	args any
}

// scriptedChatClient serves one scripted assistant turn per request over the
// chat protocol. A turn with no calls answers in prose.
func scriptedChatClient(t *testing.T, turns ...[]scriptedCall) (llm.Client, *atomic.Int32) {
	t.Helper()
	var requests atomic.Int32
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		n := int(requests.Add(1))
		if n > len(turns) {
			t.Errorf("unexpected request %d", n)
			http.Error(w, "script exhausted", http.StatusBadRequest)
			return
		}
		message := map[string]any{"role": "assistant"}
		finish := "stop"
		if len(turns[n-1]) == 0 {
			message["content"] = "I have nothing more to add."
		} else {
			finish = "tool_calls"
			var calls []any
			for i, call := range turns[n-1] {
				args, _ := json.Marshal(call.args)
				calls = append(calls, map[string]any{
					"id": fmt.Sprintf("call-%d-%d", n, i), "type": "function",
					"function": map[string]any{"name": call.name, "arguments": string(args)},
				})
			}
			message["tool_calls"] = calls
		}
		_ = testutil.WriteInferenceStream(w, "chat", map[string]any{
			"id": "chat", "object": "chat.completion", "model": "finder-test",
			"choices": []any{map[string]any{"index": 0, "finish_reason": finish, "message": message}},
			"usage":   map[string]any{"prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15},
		})
	}))
	t.Cleanup(server.Close)
	client, err := llm.New(t.Context(), llm.ClientConfig{
		BaseURL: server.URL + "/v1", APIKey: "fixture-key", Model: "finder-test",
		Protocol: "chat", MaxOutputTokens: 1024, MaxAttempts: 1,
	})
	if err != nil {
		t.Fatal(err)
	}
	return client, &requests
}

func wrapUpFinding(file string) WireFinding {
	return WireFinding{
		Reasoning: "reasoning for " + file, Severity: SeverityMedium, Confidence: 0.9,
		Description: "defect in " + file, File: file, Lines: []int{3},
		CodeQuote: "x := 1", FixedCode: "x := 2",
	}
}

// The wrap-up turn keeps every tool on offer so replayed thinking stays
// valid. A finding recorded there must be kept, and recording it must not use
// up the bounded submission attempts; only exploration is refused.
func TestWrapUpTurnKeepsReportedFindings(t *testing.T) {
	a, b := wrapUpFinding("a.go"), wrapUpFinding("b.go")
	submit := func(findings ...WireFinding) scriptedCall {
		return scriptedCall{"submit_findings", FindingsResponse{Assessment: AssessmentFindings, Findings: findings}}
	}
	report := scriptedCall{"report_finding", a}
	explore := scriptedCall{"read_file", map[string]any{"path": "a.go"}}
	cases := []struct {
		name       string
		turns      [][]scriptedCall
		files      []string
		incomplete bool
	}{
		{"report-then-submit", [][]scriptedCall{{report}, {submit(b)}}, []string{"a.go", "b.go"}, false},
		{"report-and-submit-together", [][]scriptedCall{{report, submit(b)}}, []string{"a.go", "b.go"}, false},
		{"report-only", [][]scriptedCall{{report}, {}}, []string{"a.go"}, true},
		{"report-with-exploration", [][]scriptedCall{{explore, report}}, []string{"a.go"}, true},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			client, requests := scriptedChatClient(t, tc.turns...)
			result, err := Find(t.Context(), client, FindInput{
				System: "system", User: "user", Interactive: true, MaxTurns: 1,
				Tools: []llm.Tool{{
					Name: "read_file", Schema: map[string]any{"type": "object"},
					Run: func(context.Context, map[string]any) (any, error) {
						t.Error("exploration ran on the wrap-up turn")
						return nil, nil
					},
				}},
			})
			if err != nil {
				t.Fatal(err)
			}
			var files []string
			for _, f := range result.Findings {
				files = append(files, f.File)
			}
			if fmt.Sprint(files) != fmt.Sprint(tc.files) || result.Incomplete != tc.incomplete || int(requests.Load()) != len(tc.turns) {
				t.Fatalf("findings=%v incomplete=%v requests=%d notes=%q", files, result.Incomplete, requests.Load(), result.Notes)
			}
		})
	}
}
// A `node:http` fake inference server (Go httptest plus providerServer):
// it records every request and answers from a script that looks at the
// request (path, body, headers) and the request's position.
import {
    createServer,
    type IncomingHttpHeaders,
    type ServerResponse,
} from 'node:http'
import type { AddressInfo } from 'node:net'
import { writeInferenceStream } from './inference-stream.js'

export interface RecordedRequest {
    method:string;
    path:string;
    headers:IncomingHttpHeaders;
    // Header names and values exactly as sent, in order.
    rawHeaders:string[];
    rawBody:Buffer;
    // The parsed JSON body; undefined when it is not JSON.
    body:unknown;
}

export type Reply =
    // A complete response object, streamed in the protocol's SSE format;
    // the protocol defaults to the one the request path implies.
    | { stream:unknown, protocol?:string }
    | { status:number, headers?:Record<string, string>, body?:string|Buffer }
    // Full control: write the response yourself.
    | ((res:ServerResponse, req:RecordedRequest) => void|Promise<void>)

// Picks the reply for the n-th request (0-based).
export type Script = (req:RecordedRequest, n:number) => Reply

export interface InferenceServer {
    // `http://127.0.0.1:<port>`.
    url:string;
    requests:RecordedRequest[];
    close ():Promise<void>;
}

export function protocolForPath (path:string):string {
    if (path.endsWith('/chat/completions')) return 'chat'
    if (path.endsWith('/responses')) return 'responses'
    if (path.endsWith('/v1/messages')) return 'anthropic'
    return ''
}

async function reply (res:ServerResponse, req:RecordedRequest, r:Reply) {
    if (typeof r === 'function') {
        await r(res, req)
        return
    }
    if ('stream' in r) {
        writeInferenceStream(res, r.protocol ?? protocolForPath(req.path),
            r.stream)
        return
    }
    res.writeHead(r.status, r.headers ?? {})
    res.end(r.body ?? '')
}

export async function startInferenceServer (
    script:Script
):Promise<InferenceServer> {
    const requests:RecordedRequest[] = []
    const server = createServer((req, res) => {
        const parts:Buffer[] = []
        req.on('data', (c:Buffer) => parts.push(c))
        req.on('end', () => {
            const rawBody = Buffer.concat(parts)
            let body:unknown
            try {
                body = JSON.parse(rawBody.toString('utf8'))
            } catch {
                body = undefined
            }
            const rec:RecordedRequest = {
                method:req.method ?? '',
                path:req.url ?? '',
                headers:req.headers,
                rawHeaders:req.rawHeaders,
                rawBody,
                body,
            }
            const n = requests.length
            requests.push(rec)
            Promise.resolve()
                .then(() => reply(res, rec, script(rec, n)))
                .catch((err:unknown) => {
                    if (!res.headersSent) res.writeHead(500)
                    res.end(String(err))
                })
        })
    })
    await new Promise<void>(resolve => {
        server.listen(0, '127.0.0.1', resolve)
    })
    const { port } = server.address() as AddressInfo
    return {
        url:`http://127.0.0.1:${port}`,
        requests,
        close () {
            server.closeAllConnections()
            return new Promise<void>(resolve => server.close(() => resolve()))
        },
    }
}
// Step retries (spec 07, 2.11): a turn's request is retried on retryable
// errors, never on aborts, capture failures, or cutoff errors.

import { isRetryable, retryDelayMs } from './errors.js'

export const INITIAL_BACKOFF_MS = 5000

export type Sleep = (ms:number, signal:AbortSignal) => Promise<void>

export function defaultSleep (ms:number, signal:AbortSignal):Promise<void> {
    return new Promise<void>((resolve, reject) => {
        if (signal.aborted) {
            reject(signal.reason)
            return
        }
        const onAbort = () => {
            clearTimeout(timer)
            reject(signal.reason)
        }
        const timer = setTimeout(() => {
            signal.removeEventListener('abort', onAbort)
            resolve()
        }, ms)
        signal.addEventListener('abort', onAbort, { once:true })
    })
}

// The delay before the next attempt: the provider's hint, else backoff.
export function retryDelay (err:unknown, backoffMs:number):number {
    return retryDelayMs(err, backoffMs)
}

// Runs `attempt`, retrying a retryable failure up to `maxRetries` times
// with doubling backoff. The last attempt's error is thrown.
export async function withStepRetry<R> (
    attempt:() => Promise<R>,
    opts:{ maxRetries:number, signal:AbortSignal, sleep?:Sleep }
):Promise<R> {
    const sleep = opts.sleep ?? defaultSleep
    let backoff = INITIAL_BACKOFF_MS
    for (let retries = 0; ; retries++) {
        try {
            return await attempt()
        } catch (err) {
            if (opts.signal.aborted || retries >= opts.maxRetries ||
                !isRetryable(err)) {
                throw err
            }
            await sleep(retryDelay(err, backoff), opts.signal)
            backoff *= 2
        }
    }
}
// Model-ID rules (spec 06, 2.6).

const REASONING = /(?:^|[-.])(?:o[134]|oss)|gpt-[5-9]|codex-|computer-use/
const CLASSIC_CHAT = /gpt-3|gpt-4|chatgpt-|-chat/

// Chat reasoning models take `max_completion_tokens` instead of
// `max_tokens`.
export function isChatReasoningModel (id:string):boolean {
    const lower = id.toLowerCase()
    return REASONING.test(lower) && !CLASSIC_CHAT.test(lower)
}

// How the `responses` protocol sends the system prompt.
export function responsesSystemMode (
    id:string
):'system'|'developer'|'remove' {
    if (CLASSIC_CHAT.test(id.toLowerCase())) return 'system'
    if (id.includes('o1-mini') || id.includes('o1-preview')) return 'remove'
    return 'developer'
}

// Models that get adaptive thinking by default on `anthropic`.
export function anthropicDefaultThinking (id:string):boolean {
    return id.toLowerCase().includes('claude-mythos-preview')
}

