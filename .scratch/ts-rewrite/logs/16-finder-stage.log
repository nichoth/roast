diff --git a/test/review/find-http.ts b/test/review/find-http.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ae4748e14b751adb4051e2c570005bf62ade5393
--- /dev/null
+++ b/test/review/find-http.ts
@@ -0,0 +1,78 @@
+import { test } from '../helpers/test.js'
+import { startInferenceServer } from '../helpers/inference-server.js'
+import { createClient, createModelClient } from '../../src/llm/client.js'
+import { find } from '../../src/review/find.js'
+import { wire } from './fixtures.js'
+import { signal } from '../llm/agent-helpers.js'
+
+type Call = { name:string, args:unknown }
+
+function stream (calls:Call[]) {
+    return {
+        id:'c1', model:'finder-test',
+        choices:[{
+            index:0,
+            finish_reason:calls.length ? 'tool_calls' : 'stop',
+            message:{
+                role:'assistant', content:calls.length ? '' : 'finished',
+                tool_calls:calls.map((c, i) => ({
+                    id:`call-${i}`, type:'function',
+                    function:{ name:c.name, arguments:JSON.stringify(c.args) },
+                })),
+            },
+        }],
+        usage:{ prompt_tokens:10, completion_tokens:5, total_tokens:15 },
+    }
+}
+
+const report:Call = { name:'report_finding', args:wire() }
+const submit:Call = { name:'submit_findings', args:{
+    assessment:'FINDINGS_PRESENT', findings:[wire({ file:'b.ts' })],
+} }
+const explore:Call = { name:'read_file', args:{ path:'a.ts' } }
+
+const cases = [
+    { name:'report then submit', turns:[[report], [submit]],
+        files:['a.ts', 'b.ts'], incomplete:false },
+    { name:'report and submit together', turns:[[report, submit]],
+        files:['a.ts', 'b.ts'], incomplete:false },
+    { name:'report only', turns:[[report], []],
+        files:['a.ts'], incomplete:true },
+    { name:'report beside refused exploration', turns:[[explore, report]],
+        files:['a.ts'], incomplete:true },
+]
+
+for (const c of cases) {
+    test(`finder HTTP wrap-up: ${c.name}`, async t => {
+        const s = await startInferenceServer((_req, n) => {
+            const calls = c.turns[n]
+            if (!calls) return { status:400, body:'script exhausted' }
+            return { stream:stream(calls) }
+        })
+        t.cleanup(() => s.close())
+        const client = createClient(createModelClient({
+            role:'finder', baseUrl:s.url + '/v1', apiKey:'test-key',
+            model:'finder-test', protocol:'chat', maxOutputTokens:1024,
+            maxAttempts:1, requestTimeoutMs:0,
+        }))
+        let explorations = 0
+        const captured:string[] = []
+        const r = await find(client, {
+            system:'sys', user:'user', confidenceFloor:0.6,
+            interactive:true, maxTurns:1,
+            capture:w => captured.push(w.file),
+            tools:[{
+                name:'read_file', description:'Read a file.',
+                schema:{ type:'object' },
+                run () { explorations++; return {} },
+            }],
+        }, signal())
+        t.deepEqual(r.findings.map(f => f.file), c.files)
+        t.equal(r.incomplete ?? false, c.incomplete)
+        t.equal(r.assessment, 'FINDINGS_PRESENT')
+        t.equal(explorations, 0)
+        t.equal(s.requests.length, c.turns.length)
+        t.ok(captured.includes('a.ts'), 'early report captured')
+        if (c.incomplete) t.equal(r.stopReason, 'budget_exhausted')
+    })
+}
diff --git a/test/review/find.ts b/test/review/find.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8d8240fa8665c15c530a96ee71bd8d93b5bb70b6
--- /dev/null
+++ b/test/review/find.ts
@@ -0,0 +1,145 @@
+import { test } from '../helpers/test.js'
+import {
+    find, FindingAccumulator, type FindInput,
+} from '../../src/review/find.js'
+import { wire } from './fixtures.js'
+import {
+    call, harness, signal, prose, lastResults, failure,
+} from '../llm/agent-helpers.js'
+import { newLedger } from '../../src/llm/ledger.js'
+import type { WireFinding } from '../../src/review/types.js'
+import { AuthError } from '../../src/llm/errors.js'
+
+function input (over:Partial<FindInput> = {}):FindInput {
+    return { system:'sys', user:'diff', confidenceFloor:0.6, ...over }
+}
+
+test('finder validates single-shot and interactive structured submissions',
+    async t => {
+        for (const interactive of [false, true]) {
+            const h = harness([call(interactive ?
+                'submit_findings' : 'findings', {
+                assessment:'NO_FINDINGS',
+                findings:[wire({ severity:'low' }),
+                    wire({ file:'b.ts', fixed_code:'' })],
+            })])
+            const r = await find(h.client, input({ interactive }), signal())
+            t.equal(r.assessment, 'FINDINGS_PRESENT')
+            t.equal(r.findings[0].severity, 'LOW')
+            t.equal(r.dropped[0]._drop_reason, 'missing_fixed_code')
+            t.ok(!r.incomplete)
+            t.equal(h.requests.length, 1)
+            t.equal(h.requests[0].system, 'sys')
+            t.deepEqual(h.requests[0].tools
+                .filter(tool => tool.name !== '__roast_continue')
+                .map(tool => tool.name),
+                interactive ? ['report_finding', 'submit_findings'] :
+                    ['findings'])
+        }
+    })
+
+test('early reports reach capture immediately and survive a cutoff', async t => {
+    for (const fixed_code of ['return value ?? 0', '']) {
+        const captured:WireFinding[] = []
+        const h = harness([
+            call('report_finding', wire({ fixed_code })),
+            () => {
+                t.equal(captured.length, 1, 'captured before the next call')
+                return prose('unfinished')
+            },
+        ], { maxAttempts:1 })
+        const r = await find(h.client, input({ interactive:true, maxTurns:1,
+            capture:w => captured.push(w) }), signal())
+        t.equal(captured.length, 1)
+        t.equal(r.incomplete, true)
+        t.equal(r.stopReason, 'budget_exhausted')
+        t.equal(r.assessment, fixed_code ? 'FINDINGS_PRESENT' :
+            'INCOMPLETE_NO_SUBMISSION')
+        t.equal(r.findings.length, fixed_code ? 1 : 0)
+        t.equal(r.dropped.length, fixed_code ? 0 : 1)
+        t.equal(r.notes.length, 2)
+    }
+})
+
+test('accumulator and submissions merge last content in first-seen order',
+    async t => {
+        const a = wire({ description:'first' })
+        const b = wire({ file:'b.ts', description:'second' })
+        const refined = wire({ severity:'LOW', description:'refined',
+            code_quote:'return\tvalue' })
+        const submitted = wire({ description:'final' })
+        const seen:WireFinding[] = []
+        const acc = new FindingAccumulator(w => seen.push(w))
+        for (const w of [a, b, refined]) acc.add(w)
+        t.deepEqual(acc.ordered(), [refined, b])
+        t.equal(acc.count, 2)
+        t.deepEqual(seen, [a, b, refined])
+        const captured:WireFinding[] = []
+        const h = harness([
+            call('report_finding', a), call('report_finding', b),
+            call('report_finding', refined),
+            call('submit_findings', { assessment:'NO_FINDINGS',
+                findings:[submitted] }),
+        ])
+        const r = await find(h.client, input({ interactive:true,
+            capture:w => captured.push(w) }), signal())
+        t.deepEqual(r.findings.map(f => f.description), ['final', 'second'])
+        t.deepEqual(captured.map(f => f.description),
+            ['first', 'second', 'refined', 'final'])
+        t.equal(r.assessment, 'FINDINGS_PRESENT')
+        t.ok(!r.incomplete)
+        for (const [i, count] of [1, 2, 2].entries()) {
+            t.deepEqual(JSON.parse(lastResults(h.requests[i + 1])[0].output),
+                { recorded:true, reported_so_far:count })
+        }
+    })
+
+test('successful deadline wrap-up remains incomplete', async t => {
+    const h = harness([call('submit_findings', {
+        assessment:'NO_FINDINGS', findings:[wire()],
+    })], {}, { now:() => 100 })
+    const r = await find(h.client, input({ interactive:true, deadline:50 }),
+        signal())
+    t.equal(r.assessment, 'FINDINGS_PRESENT')
+    t.equal(r.incomplete, true)
+    t.equal(r.stopReason, 'deadline')
+    t.equal(r.notes.length, 1)
+    t.equal(h.requests.length, 1)
+})
+
+test('non-cutoff client errors and caller cancellation propagate unchanged',
+    async t => {
+        for (const interactive of [false, true]) {
+            const error = new AuthError('rejected key')
+            const h = harness([error])
+            t.equal(await failure(find(h.client, input({ interactive }),
+                signal())), error)
+            const controller = new AbortController()
+            const canceled = new Error('caller canceled')
+            controller.abort(canceled)
+            t.equal(await failure(find(h.client, input({ interactive }),
+                controller.signal)), canceled)
+        }
+    })
+
+test('unsubmitted conversations keep cause and map all graceful cutoffs',
+    async t => {
+        for (const reason of ['deadline', 'token_budget', 'budget_exhausted']) {
+            const h = harness([prose('unfinished')], { maxAttempts:1 }, {
+                now:() => 100,
+                ledger:reason === 'token_budget' ? newLedger(1) : undefined,
+            })
+            const r = await find(h.client, input({
+                interactive:true,
+                maxTurns:1,
+                deadline:reason === 'deadline' ? 50 : undefined,
+            }), signal())
+            t.equal(r.assessment, 'INCOMPLETE_NO_SUBMISSION')
+            t.equal(r.incomplete, true)
+            t.equal(r.stopReason, reason)
+            t.deepEqual(r.findings, [])
+            t.ok(r.notes[0].includes('cause: '))
+            t.ok(r.notes[0].includes(reason === 'token_budget' ?
+                'run token budget exhausted' : h.client.name))
+        }
+    })
diff --git a/test/review/fingerprint.ts b/test/review/fingerprint.ts
new file mode 100644
index 0000000000000000000000000000000000000000..76db19797d39abb340df7dc5cf3e42c6d0a599d3
--- /dev/null
+++ b/test/review/fingerprint.ts
@@ -0,0 +1,25 @@
+import { test } from '../helpers/test.js'
+import {
+    collapseWhitespace, fingerprint,
+} from '../../src/review/fingerprint.js'
+import { wire } from './fixtures.js'
+
+test('fingerprints match Go and use only file and collapsed code', t => {
+    // Go sha256 + strings.Fields, independently computed baseline vector.
+    const expected = 'PLACEHOLDER'
+    const f = wire()
+    t.equal(fingerprint(f), expected)
+    t.equal(fingerprint(wire({ code_quote:' \treturn\u0085value\n' })),
+        expected)
+    t.equal(fingerprint(wire({ description:'different', severity:'LOW',
+        lines:[99] })), expected)
+    t.ok(fingerprint(wire({ file:'b.ts' })) !== expected)
+    t.ok(fingerprint(wire({ code_quote:'return other' })) !== expected)
+    t.ok(fingerprint(wire({ code_quote:'return\ufeffvalue' })) !== expected)
+    t.ok(/^[a-f0-9]{16}$/.test(fingerprint(f)))
+    for (const s of ['', ' \t\u0085', '\ufeff', ' a\n b ', '\u{1f600}']) {
+        t.equal(collapseWhitespace(collapseWhitespace(s)),
+            collapseWhitespace(s), 'normalization is idempotent')
+    }
+    t.equal(collapseWhitespace('\u0085a\ufeff b\u3000'), 'a\ufeff b')
+})
