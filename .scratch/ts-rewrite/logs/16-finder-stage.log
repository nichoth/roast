@@ -1,4 +1,6 @@
 // pattern: Functional Core
+import { wellFormed } from '../llm/json.js'
+import type { WireFinding, FindingsResponse } from './types.js'
 
 function freeze<T extends object> (value:T):T {
     for (const v of Object.values(value)) {
@@ -92,3 +94,128 @@
     required:['assessment', 'findings'],
     type:'object',
 })
+
+export type Decoded<T> =
+    | { ok:true, value:T }
+    | { ok:false, error:string }
+
+// Retain numeric spelling only for direct submission decoding. Reported
+// arguments have already been parsed as float64 by the agent loop.
+class NumericLiteral {
+    readonly value:number
+    readonly source:string
+
+    constructor (value:number, source:string) {
+        this.value = value
+        this.source = source
+    }
+}
+
+function parseRaw (text:string):unknown {
+    return JSON.parse(text, (_key:string, value:unknown,
+        context?:{ source?:string }) => {
+        return typeof value === 'number' && context?.source !== undefined ?
+            new NumericLiteral(value, context.source) : value
+    })
+}
+
+function object (v:unknown):Record<string, unknown> {
+    if (v === null) return {}
+    if (typeof v !== 'object' || Array.isArray(v) ||
+        v instanceof NumericLiteral) {
+        throw new Error('expected an object')
+    }
+    return v as Record<string, unknown>
+}
+
+function field (v:Record<string, unknown>, key:string):unknown {
+    return Object.hasOwn(v, key) ? v[key] : null
+}
+
+function string (value:unknown):string {
+    if (value === null || value === undefined) return ''
+    if (typeof value !== 'string') throw new Error('expected a string')
+    return wellFormed(value)
+}
+
+function number (value:unknown):number {
+    if (value === null || value === undefined) return 0
+    if (value instanceof NumericLiteral) value = value.value
+    if (typeof value === 'bigint') value = Number(value)
+    if (typeof value !== 'number' || !Number.isFinite(value)) {
+        throw new Error('expected a finite number')
+    }
+    return value
+}
+
+function line (value:unknown):number {
+    let exact:bigint
+    if (value instanceof NumericLiteral) {
+        if (!/^-?\d+$/.test(value.source)) {
+            throw new Error('expected an integer literal in lines')
+        }
+        exact = BigInt(value.source)
+    } else if (typeof value === 'bigint') exact = value
+    else {
+        const n = number(value)
+        if (!Number.isInteger(n)) throw new Error('expected integer in lines')
+        exact = BigInt(n)
+    }
+    if (exact < -9223372036854775808n || exact > 9223372036854775807n) {
+        throw new Error('line outside int64 range')
+    }
+    return Number(exact)
+}
+
+function wire (raw:unknown):WireFinding {
+    const v = object(raw)
+    const lines = field(v, 'lines')
+    if (lines != null && !Array.isArray(lines)) {
+        throw new Error('expected an array in lines')
+    }
+    return {
+        reasoning:string(field(v, 'reasoning')),
+        severity:string(field(v, 'severity')),
+        confidence:number(field(v, 'confidence')),
+        cwe:string(field(v, 'cwe')),
+        description:string(field(v, 'description')),
+        file:string(field(v, 'file')),
+        lines:lines == null ? null : lines.map(line),
+        code_quote:string(field(v, 'code_quote')),
+        fixed_code:string(field(v, 'fixed_code')),
+        frontend_category:string(field(v, 'frontend_category')),
+    }
+}
+
+function decode<T> (fn:() => T):Decoded<T> {
+    try {
+        return { ok:true, value:fn() }
+    } catch (err) {
+        return { ok:false, error:err instanceof Error ?
+            err.message : String(err) }
+    }
+}
+
+export function decodeWireFinding (
+    raw:unknown,
+    rawText?:string
+):Decoded<WireFinding> {
+    return decode(() => wire(rawText === undefined ? raw : parseRaw(rawText)))
+}
+
+export function decodeFindingsResponse (
+    raw:unknown,
+    rawText?:string
+):Decoded<FindingsResponse> {
+    return decode(() => {
+        const v = object(rawText === undefined ? raw : parseRaw(rawText))
+        const findings = field(v, 'findings')
+        if (findings != null && !Array.isArray(findings)) {
+            throw new Error('expected an array in findings')
+        }
+        return {
+            assessment:string(field(v, 'assessment')),
+            findings:findings == null ? [] : findings.map(wire),
+        }
+    })
+}
diff --git a/src/review/types.ts b/src/review/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..454f702a5cd263b99eef5810dec623b4e0b02594
--- /dev/null
+++ b/src/review/types.ts
@@ -0,0 +1,103 @@
+// pattern: Functional Core
+import { goTrimSpace } from '../gocompat/strings.js'
+
+export const SEVERITIES = [
+    'INFO', 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL',
+] as const
+
+export type Severity = typeof SEVERITIES[number]
+
+export function severityRank (severity:string):number {
+    const rank = SEVERITIES.findIndex(s => s === severity)
+    return Math.max(0, rank)
+}
+
+export function parseSeverity (value:string):Severity|null {
+    const canonical = goTrimSpace(value).toUpperCase()
+    return SEVERITIES.find(s => s === canonical) ?? null
+}
+
+export type WireFinding = {
+    reasoning:string;
+    severity:string;
+    confidence:number;
+    cwe:string;
+    description:string;
+    file:string;
+    lines:number[]|null;
+    code_quote:string;
+    fixed_code:string;
+    frontend_category:string;
+}
+
+// The verifier owns the remaining verdict fields (ticket 21).
+export type Verdict = {
+    status:string;
+    recalibrated_severity?:string;
+}
+
+export type Finding = WireFinding & {
+    verdict?:Verdict;
+    _drop_reason?:string;
+    id?:string;
+    alias?:string;
+}
+
+export type FindingsResponse = {
+    assessment:string;
+    findings:WireFinding[];
+}
+
+export type Result = {
+    findings:Finding[];
+    dropped:Finding[];
+    assessment:string;
+    notes:string[];
+    incomplete?:boolean;
+    stopReason?:string;
+}
+
+export const ASSESSMENT = {
+    FINDINGS_PRESENT:'FINDINGS_PRESENT',
+    NO_FINDINGS:'NO_FINDINGS',
+    NO_DIFF:'NO_DIFF',
+    INCOMPLETE_NO_SUBMISSION:'INCOMPLETE_NO_SUBMISSION',
+    NO_FINDINGS_IN_SAMPLED_AREAS:'NO_FINDINGS_IN_SAMPLED_AREAS',
+} as const
+
+export const DROP = {
+    INVALID_SEVERITY:'invalid_severity',
+    MISSING_CODE_QUOTE:'missing_code_quote',
+    MISSING_FIXED_CODE:'missing_fixed_code',
+    UNGROUNDED_CODE_QUOTE:'ungrounded_code_quote',
+    BELOW_CONFIDENCE_FLOOR:'below_confidence_floor',
+    REFUTED_BY_VERIFIER:'refuted_by_verifier',
+} as const
+
+export function toFinding (w:WireFinding):Finding {
+    return {
+        reasoning:w.reasoning,
+        severity:w.severity,
+        confidence:w.confidence,
+        cwe:w.cwe,
+        description:w.description,
+        file:w.file,
+        lines:w.lines?.length ? [...w.lines] : null,
+        code_quote:w.code_quote,
+        fixed_code:w.fixed_code,
+        frontend_category:w.frontend_category,
+    }
+}
+
+export function effectiveSeverity (f:Finding):string {
+    if (f.verdict?.status !== 'confirmed') return f.severity
+    const recalibrated = parseSeverity(f.verdict.recalibrated_severity ?? '')
+    return recalibrated !== null &&
+        severityRank(recalibrated) < severityRank(f.severity) ?
+        recalibrated : f.severity
+}
+
+export function maxSeverity (result:Pick<Result, 'findings'>):number {
+    return result.findings.reduce((max, f) =>
+        Math.max(max, severityRank(effectiveSeverity(f))), -1)
+}
