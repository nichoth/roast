        opts:ConverseOptions<T>,
        signal:AbortSignal
    ):Promise<T>;
    completeStructured<T> (
        system:string,
        user:string,
        schemaName:string,
        result:{ schema:Record<string, unknown>, decode:FinalSpec<T>['decode'] },
        signal:AbortSignal
    ):Promise<T>;
    usage ():RecordUsage;
