diff --git a/test/review/schema.ts b/test/review/schema.ts
new file mode 100644
index 0000000000000000000000000000000000000000..70386dd95dc80ef36ff44319515a44b83d91dbe7
--- /dev/null
+++ b/test/review/schema.ts
@@ -0,0 +1,93 @@
+import { test } from '../helpers/test.js'
+import baseline from './schemas.json'
+import {
+    WIRE_FINDING_SCHEMA, FINDINGS_RESPONSE_SCHEMA,
+    decodeWireFinding, decodeFindingsResponse,
+} from '../../src/review/schema.js'
+import { wire } from './fixtures.js'
+import { typeValidate } from '../../src/llm/final-args.js'
+
+test('tool schemas match the baseline JSON and are deeply frozen', t => {
+    t.deepEqual(WIRE_FINDING_SCHEMA, baseline.wire)
+    t.deepEqual(FINDINGS_RESPONSE_SCHEMA, baseline.response)
+    function check (v:unknown):void {
+        if (v === null || typeof v !== 'object') return
+        t.ok(Object.isFrozen(v))
+        if (!Array.isArray(v)) {
+            t.deepEqual(Object.keys(v), Object.keys(v).sort())
+        }
+        Object.values(v).forEach(check)
+    }
+    check(WIRE_FINDING_SCHEMA)
+    check(FINDINGS_RESPONSE_SCHEMA)
+})
+
+test('finding decoding uses exact keys, null zeros and typed fields', t => {
+    const wrong = decodeWireFinding({ Severity:'HIGH' })
+    t.ok(wrong.ok)
+    if (wrong.ok) t.equal(wrong.value.severity, '')
+    const zero = decodeWireFinding(null)
+    t.deepEqual(zero, decodeWireFinding({
+        reasoning:null, severity:null, confidence:null, lines:null,
+    }))
+    const decoded = decodeFindingsResponse({
+        assessment:null,
+        findings:[{ ...wire(), lines:[null, -1, 3],
+            description:'\ud800', frontend_category:'unknown', confidence:2 }],
+        Findings:[wire()],
+    })
+    t.ok(decoded.ok)
+    if (decoded.ok) {
+        t.equal(decoded.value.assessment, '')
+        t.deepEqual(decoded.value.findings[0].lines, [0, -1, 3])
+        t.equal(decoded.value.findings[0].description, '\ufffd')
+        t.equal(decoded.value.findings[0].confidence, 2)
+        t.equal(decoded.value.findings[0].frontend_category, 'unknown')
+    }
+    for (const field of Object.keys(wire())) {
+        t.ok(!decodeWireFinding({ [field]:true }).ok, field)
+    }
+    for (const value of [[], '', 3, true]) {
+        t.ok(!decodeWireFinding(value).ok)
+        t.ok(!decodeFindingsResponse(value).ok)
+    }
+    t.ok(!decodeFindingsResponse({ assessment:3 }).ok)
+    t.ok(!decodeFindingsResponse({ findings:{} }).ok)
+    t.ok(!decodeFindingsResponse({ findings:[true] }).ok)
+    t.deepEqual(decodeFindingsResponse(null), {
+        ok:true, value:{ assessment:'', findings:[] },
+    })
+    t.deepEqual(decodeFindingsResponse({ findings:null }),
+        decodeFindingsResponse(null))
+})
+
+test('direct final decoding preserves integer lexemes and int64 bounds', t => {
+    for (const literal of ['3.0', '1e2', '3.5',
+        '9223372036854775808', '-9223372036854775809']) {
+        const raw = `{"findings":[{"lines":[${literal}]}]}`
+        t.ok(!decodeFindingsResponse(JSON.parse(raw), raw).ok, literal)
+    }
+    for (const literal of ['3', '-1', '9223372036854775807',
+        '-9223372036854775808', 'null']) {
+        const raw = `{"findings":[{"lines":[${literal}]}]}`
+        t.ok(decodeFindingsResponse(JSON.parse(raw), raw).ok, literal)
+    }
+    const raw = '{"findings":[{"confidence":1e2,"lines":[3]}]}'
+    t.ok(decodeFindingsResponse(JSON.parse(raw), raw).ok)
+    t.ok(decodeWireFinding({ lines:[3.0, 1e2] }).ok,
+        'reported map already passed through float64')
+    t.ok(!decodeWireFinding({ lines:[3.5] }).ok)
+    t.ok(!decodeWireFinding({ lines:[Number(9223372036854775807n)] }).ok)
+    const checked = typeValidate('{"findings":[{"lines":[3.0]}]}', {
+        decode (value, raw) {
+            const result = decodeFindingsResponse(value, raw)
+            if (!result.ok) throw new Error(result.error)
+            return result.value
+        },
+    })
+    t.ok(!checked.ok, 'client final hook passes raw numeric spelling')
+    const duplicates = '{"severity":"LOW","severity":"HIGH"}'
+    const last = decodeWireFinding(JSON.parse(duplicates), duplicates)
+    t.ok(last.ok)
+    if (last.ok) t.equal(last.value.severity, 'HIGH')
+})
diff --git a/test/review/types.ts b/test/review/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1e7a36ae0d92ffcc5a6651baa5cff4aed7ff69b5
--- /dev/null
+++ b/test/review/types.ts
@@ -0,0 +1,53 @@
+import { test } from '../helpers/test.js'
+import {
+    parseSeverity, severityRank, SEVERITIES,
+    effectiveSeverity, maxSeverity, toFinding,
+} from '../../src/review/types.js'
+import { wire } from './fixtures.js'
+
+test('severity parsing accepts Go whitespace and canonicalizes case', t => {
+    for (const severity of SEVERITIES) {
+        t.equal(parseSeverity(`\u0085 ${severity.toLowerCase()}\n`), severity)
+    }
+    for (const value of ['', ' ', 'unknown', '\ufeffHIGH']) {
+        t.equal(parseSeverity(value), null)
+    }
+    t.deepEqual(SEVERITIES.map(severityRank), [0, 1, 2, 3, 4])
+    for (const value of ['', 'high', 'unknown']) {
+        t.equal(severityRank(value), 0)
+    }
+})
+
+test('finding conversion copies lines and serializes empty lines as null',
+    t => {
+        const w = wire()
+        const f = toFinding(w)
+        w.lines!.push(99)
+        t.deepEqual(f.lines, [3])
+        for (const lines of [null, []]) {
+            const converted = toFinding(wire({ lines }))
+            t.equal(JSON.parse(JSON.stringify(converted)).lines, null)
+            t.deepEqual(Object.keys(converted), [
+                'reasoning', 'severity', 'confidence', 'cwe', 'description',
+                'file', 'lines', 'code_quote', 'fixed_code',
+                'frontend_category',
+            ])
+        }
+    })
+
+test('only confirmed lower recalibrations affect severity and maximum', t => {
+    const f = toFinding(wire())
+    t.equal(effectiveSeverity(f), 'HIGH')
+    for (const status of ['confirmed', 'refuted', 'insufficient_context']) {
+        for (const severity of ['low', 'HIGH', 'CRITICAL', 'bad', '']) {
+            f.verdict = { status, recalibrated_severity:severity }
+            t.equal(effectiveSeverity(f),
+                status === 'confirmed' && severity === 'low' ? 'LOW' : 'HIGH')
+        }
+    }
+    t.equal(maxSeverity({ findings:[] }), -1)
+    f.verdict = { status:'confirmed', recalibrated_severity:'low' }
+    t.equal(maxSeverity({ findings:[f] }), 1)
+    const medium = toFinding(wire({ severity:'MEDIUM' }))
+    t.equal(maxSeverity({ findings:[f, medium] }), 2)
+})
diff --git a/test/review/validate.ts b/test/review/validate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7d665e1e386ba3b427750f311be076daf9e5aa4b
--- /dev/null
+++ b/test/review/validate.ts
@@ -0,0 +1,95 @@
+import { test } from '../helpers/test.js'
+import { assignIdentity, validate } from '../../src/review/validate.js'
+import { wire } from './fixtures.js'
+
+test('validation applies forcing functions in order and keeps the floor',
+    t => {
+    const seen:string[] = []
+    const result = validate({
+        assessment:'NO_FINDINGS',
+        findings:[
+            wire({ severity:'bad', code_quote:'', fixed_code:'' }),
+            wire({ code_quote:' \u0085', fixed_code:'' }),
+            wire({ fixed_code:'\t\u3000', confidence:0 }),
+            wire({ file:'ungrounded', confidence:0 }),
+            wire({ confidence:0.599999 }),
+            wire({ code_quote:' return value ', confidence:0.6 }),
+        ],
+    }, 0.6, (file, quote) => {
+        seen.push(quote)
+        return file !== 'ungrounded'
+    })
+    t.deepEqual(result.dropped.map(f => f._drop_reason), [
+        'invalid_severity', 'missing_code_quote', 'missing_fixed_code',
+        'ungrounded_code_quote', 'below_confidence_floor',
+    ])
+    t.deepEqual(seen, ['return value', 'return value', ' return value '])
+    t.equal(result.findings.length, 1)
+    t.equal(result.findings[0].confidence, 0.6)
+    t.equal(result.assessment, 'FINDINGS_PRESENT')
+    t.deepEqual(result.notes, [])
+})
+
+test('identities are v4 UUIDs and aliases include dropped ids in collisions',
+    t => {
+        const r = validate({
+            assessment:'',
+            findings:[
+                wire(), wire({ severity:'bad' }), wire(),
+            ]
+        }, 0)
+        const all = [...r.findings, ...r.dropped]
+        for (const f of all) {
+            const uuid = new RegExp('^[\\da-f]{8}-[\\da-f]{4}-' +
+                '4[\\da-f]{3}-[89ab][\\da-f]{3}-[\\da-f]{12}$')
+            t.ok(uuid.test(f.id!))
+            delete f.id
+        }
+        const ids = [
+            'abcdef00-0000-4000-8000-000000000000',
+            'abcdef10-0000-4000-8000-000000000000',
+            'abcdef01-0000-4000-8000-000000000000',
+        ]
+        assignIdentity(r, () => ids.shift()!)
+        t.deepEqual(all.map(f => f.alias), [
+            'R-abcdef00', 'R-abcdef1', 'R-abcdef01',
+        ])
+        for (const f of all) {
+            const prefix = f.alias!.slice(2)
+            t.ok(prefix.length >= 6)
+            t.equal(all.filter(other =>
+                other.id!.replaceAll('-', '').startsWith(prefix)).length, 1)
+        }
+        const before = all.map(f => f.id)
+        assignIdentity(r, () => { throw new Error('must preserve ids') })
+        t.deepEqual(all.map(f => f.id), before)
+    })
+
+test('validation canonicalizes known severities and preserves invalid ones',
+    t => {
+        const input = [
+            wire({ severity:' high ' }), wire({ severity:'not-real' }),
+            wire({ severity:' low ', fixed_code:'' }),
+        ]
+        const r = validate({ assessment:'', findings:input }, 0)
+        t.equal(r.findings[0].severity, 'HIGH')
+        t.equal(r.dropped[0].severity, 'not-real')
+        t.equal(r.dropped[0]._drop_reason, 'invalid_severity')
+        t.equal(r.dropped[1].severity, 'LOW')
+        t.equal(input[0].severity, ' high ', 'wire data is not mutated')
+    })
+
+test('validation demotes only FINDINGS_PRESENT when none survive', t => {
+    for (const assessment of [
+        'FINDINGS_PRESENT', 'NO_FINDINGS', '', 'unknown',
+        'INCOMPLETE_NO_SUBMISSION',
+    ]) {
+        const result = validate({ assessment, findings:[] }, 0.6)
+        t.equal(result.assessment, assessment === 'FINDINGS_PRESENT' ?
+            'NO_FINDINGS' : assessment)
+        t.deepEqual(result.findings, [])
+        t.deepEqual(result.dropped, [])
+    }
+    t.equal(validate({ assessment:'', findings:[wire()] }, 0).findings.length,
+        1, 'grounding may be disabled')
+})

