    t.equal(await p, 'sk-secreT', 'backspace edits, result trimmed')
    t.deepEqual(stdin.rawCalls, [true, false], 'raw mode on, then off')
    t.ok(!out.text().includes('sk-'), 'the secret is not echoed')
