test('readSecret on a TTY reads raw without echo', async t => {
    const stdin = fakeTTY()
    const out = new BufferStream()
    const lines = new LineReader(stdin)
    const p = readSecret(out, stdin, lines, 'key: ')
    stdin.write(' sk-se')
