import { PassThrough } from 'node:stream'
import { test } from '@substrate-system/tapzero'
import {
    LineReader,
    promptYesDefault,
    readSecret,
    interactiveTerminals,
} from '../../src/cli/terminal.js'
import { CancelledError, exitCode } from '../../src/cli/errors.js'
import { BufferStream, inputStream } from '../helpers/streams.js'

// A stdin that looks like a TTY: isTTY plus setRawMode recording calls.
function fakeTTY ():PassThrough&{ rawCalls:boolean[] } {
    const s = new PassThrough() as PassThrough&{
        isTTY:boolean;
        rawCalls:boolean[];
        setRawMode (on:boolean):void;
    }
    s.isTTY = true
    s.rawCalls = []
    s.setRawMode = (on:boolean) => { s.rawCalls.push(on) }
    return s
}

test('promptYesDefault answers', async t => {
    const cases:[string, boolean][] = [
        ['\n', true],
        ['y\n', true],
        ['Y\n', true],
        ['yes\n', true],
        ['  YES  \n', true],
        ['n\n', false],
        ['no\n', false],
        ['sure\n', false],
        ['', false],
    ]
    for (const [input, want] of cases) {
        const out = new BufferStream()
        const lines = new LineReader(inputStream(input))
        const got = await promptYesDefault(out, lines, 'Continue?')
        t.equal(got, want, JSON.stringify(input))
        t.ok(out.text().length > 0, 'the question is written')
    }
})

test('consecutive prompts share one LineReader', async t => {
    const out = new BufferStream()
    const stdin = inputStream('a\nb\n')
    const lines = new LineReader(stdin)
    t.equal(await readSecret(out, stdin, lines, 'key: '), 'a', 'first')
    t.equal(await readSecret(out, stdin, lines, 'key: '), 'b', 'second')
    let err:unknown
    try {
        await readSecret(out, stdin, lines, 'key: ')
    } catch (e) {
        err = e
    }
    t.ok(err instanceof Error, 'EOF with no text is an error')
})

test('promptYesDefault then readSecret on one reader', async t => {
    const out = new BufferStream()
    const stdin = inputStream('y\nsk-test\n')
    const lines = new LineReader(stdin)
    t.equal(await promptYesDefault(out, lines, 'Log in?'), true, 'yes')
    t.equal(await readSecret(out, stdin, lines, 'key: '), 'sk-test',
        'the buffered second answer survives')
})

test('readSecret on a TTY reads raw without echo', async t => {
    const stdin = fakeTTY()
    const out = new BufferStream()
    const lines = new LineReader(stdin)
    const p = readSecret(out, stdin, lines, 'key: ')
    stdin.write(' sk-se')
    stdin.write('cret\x7fT \r')
    t.equal(await p, 'sk-secreT', 'backspace edits, result trimmed')
    t.deepEqual(stdin.rawCalls, [true, false], 'raw mode on, then off')
    t.ok(!out.text().includes('sk-'), 'the secret is not echoed')
})

test('readSecret on a TTY treats Ctrl-C as cancellation', async t => {
    const stdin = fakeTTY()
    const out = new BufferStream()
    const lines = new LineReader(stdin)
    const p = readSecret(out, stdin, lines, 'key: ')
    stdin.write('sk\x03')
    let err:unknown
    try {
        await p
    } catch (e) {
        err = e
    }
    t.ok(err instanceof CancelledError, 'a CancelledError')
    t.equal(exitCode(err), 5, 'exits 5')
    t.deepEqual(stdin.rawCalls, [true, false], 'raw mode restored')
})

test('default interactiveTerminals rejects non-file streams', t => {
    const tty = fakeTTY()
    t.equal(interactiveTerminals(inputStream(), new BufferStream()), false,
        'buffers are not terminals')
    t.equal(interactiveTerminals(tty, new BufferStream()), false,
        'an isTTY flag without a file descriptor is not a terminal')
})


FILE test/helpers/provider-server.ts
// pattern: Imperative Shell
// Shared provider fake for login and init. Inference replies can be
// supplied by callers when they also exercise a model request.
import {
    startInferenceServer,
    type Script,
} from './inference-server.js'

export async function providerServer (inference?:Script) {
    const credentials:string[] = []
    const hooks = {
        answerModels:(key:string):number => key === '' ? 401 : 200,
    }
    const server = await startInferenceServer((req, n) => {
        const key = String(req.headers['x-api-key'] ??
            req.headers.authorization ?? '')
        credentials.push(key)
        if (req.method === 'GET' && req.path === '/v1/models') {
            if (req.headers['x-api-key'] &&
                req.headers['anthropic-version'] !== '2023-06-01') {
                return { status:400 }
            }
            return { status:hooks.answerModels(key), body:'{}' }
        }
        return inference?.(req, n) ?? { status:404 }
    })
    return { ...server, credentials, hooks }
}


FILE test/helpers/terminal.ts
// Swaps the terminal hooks for a test and restores them at test end.
import { terminalHooks } from '../../src/cli/terminal.js'

interface Cleanup {
    cleanup (fn:() => void):void;
}

// Makes interactiveTerminals answer `value` until the test ends.
export function simulateTerminals (t:Cleanup, value:boolean):void {
    const saved = terminalHooks.interactiveTerminals
    terminalHooks.interactiveTerminals = () => value
    t.cleanup(() => { terminalHooks.interactiveTerminals = saved })
}

// Replaces openBrowser with a recorder; returns the URLs it was asked to
// open. Nothing is launched.
export function captureBrowser (t:Cleanup, error?:Error):string[] {
    const saved = terminalHooks.openBrowser
    const opened:string[] = []
    terminalHooks.openBrowser = async url => {
        opened.push(url)
        return error
    }
    t.cleanup(() => { terminalHooks.openBrowser = saved })
    return opened
}


FILE test/helpers/run.ts
// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a
// temporary Git repository as cwd, a clean environment, and optionally a
// fetch that sends every request to a fake server.
import { run, type RunResult } from '../../src/cli/run.js'
import { BufferStream, inputStream } from './streams.js'
import { tempRepo } from './repo.js'

export interface RunRoastOpts {
    // Working directory; a fresh temporary repository when absent.
    cwd?:string;
    // The environment; the repository's isolated env when absent.
    env?:Record<string, string>;
    stdin?:NodeJS.ReadableStream|string;
    signal?:AbortSignal;
    // Origin (`http://127.0.0.1:port`) every request is redirected to.
    redirectTo?:string;
}

export interface RunRoastResult extends RunResult {
    stdout:string;
    stderr:string;
    // The original host of every redirected request, in order.
    hosts:string[];
}

// A fetch that rewrites each URL's origin to `origin`, recording the
// original host (Go redirectDefaultTransport).
export function redirectingFetch (
    origin:string,
    hosts:string[]
):typeof globalThis.fetch {
    return (input, init) => {
        const req = new Request(input, init)
        const url = new URL(req.url)
        hosts.push(url.host)
        const target = new URL(url.pathname + url.search, origin)
        return globalThis.fetch(new Request(target, req))
    }
}

export async function runRoast (
    args:string[],
    opts:RunRoastOpts = {}
):Promise<RunRoastResult> {
    let cwd = opts.cwd
    let env = opts.env
    let remove:(() => void)|undefined
    if (cwd === undefined) {
        const repo = tempRepo()
        cwd = repo.dir
        env ??= repo.env
        remove = repo.remove
    }
    const stdout = new BufferStream()
    const stderr = new BufferStream()
    const hosts:string[] = []
    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?
        inputStream(opts.stdin ?? '') :
        opts.stdin
    try {
        const res = await run(args, {
            stdin,
            stdout,
            stderr,
            env:env ?? {},
            cwd,
            signal:opts.signal,
            fetch:opts.redirectTo ?
                redirectingFetch(opts.redirectTo, hosts) :
                undefined,
        })
        return {
            ...res,
            stdout:stdout.text(),
            stderr:stderr.text(),
            hosts,
        }
    } finally {
        remove?.()
    }
}


