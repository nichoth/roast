{"type":"tool_execution_end","toolCallId":"hPUPxBwCa8ykSsVyqYaiDLXEzOiLoxkk","toolName":"read","result":{"content":[{"type":"text","text":"// The built-in provider registry (spec 02, 2.7): the one place that says\n// which endpoint, protocols, standard key variable, key page, and login\n// method each provider has. Trust standardness, ambient credentials, the\n// `init` starter, and login all consult it.\nimport { goTrimSpace } from '../gocompat/strings.js'\n\nexport const DEFAULT_OPENAI_BASE_URL = 'https://api.openai.com/v1'\nexport const DEFAULT_ANTHROPIC_BASE_URL = 'https://api.anthropic.com/v1'\nexport const OPENROUTER_BASE_URL = 'https://openrouter.ai/api/v1'\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\nexport type LoginMethod = 'paste'|'browser'\n\nexport interface BuiltinProvider {\n    readonly name:string;\n    readonly endpoint:string;\n    // The first is the one starter profiles use.\n    readonly protocols:readonly Protocol[];\n    readonly keyEnv:string;\n    readonly keyPage:string;\n    readonly login:LoginMethod;\n}\n\n// No two entries share an (endpoint, protocol) pair, so providerAt finds\n// at most one. Order matters for withheldKey and listings.\nconst REGISTRY:readonly BuiltinProvider[] = Object.freeze([\n    {\n        name:'openai',\n        endpoint:DEFAULT_OPENAI_BASE_URL,\n        protocols:['responses', 'chat'],\n        keyEnv:'OPENAI_API_KEY',\n        keyPage:'https://platform.openai.com/api-keys',\n        login:'paste',\n    },\n    {\n        name:'anthropic',\n        endpoint:DEFAULT_ANTHROPIC_BASE_URL,\n        protocols:['anthropic'],\n        keyEnv:'ANTHROPIC_API_KEY',\n        keyPage:'https://console.anthropic.com/settings/keys',\n        login:'paste',\n    },\n    {\n        name:'openrouter',\n        endpoint:OPENROUTER_BASE_URL,\n        protocols:['chat', 'responses'],\n        keyEnv:'OPENROUTER_API_KEY',\n        keyPage:'https://openrouter.ai/settings/keys',\n        login:'browser',\n    },\n].map(p => Object.freeze({\n    ...p,\n    protocols:Object.freeze([...p.protocols]) as readonly Protocol[],\n} as BuiltinProvider)))\n\nfunction copy (p:BuiltinProvider):BuiltinProvider {\n    return { ...p, protocols:[...p.protocols] }\n}\n\n// Copies of the registry, in registry order.\nexport function builtinProviders ():BuiltinProvider[] {\n    return REGISTRY.map(copy)\n}\n\n// The provider with exactly this name (case-sensitive).\nexport function lookupProvider (name:string):BuiltinProvider|undefined {\n    const p = REGISTRY.find(p => p.name === name)\n    return p && copy(p)\n}\n\n// The provider that accepts `protocol` at `endpoint`.\nexport function providerAt (\n    endpoint:string,\n    protocol:string\n):BuiltinProvider|undefined {\n    const p = REGISTRY.find(p =>\n        (p.protocols as readonly string[]).includes(protocol) &&\n        sameEndpoint(p.endpoint, endpoint))\n    return p && copy(p)\n}\n\n// The implicit endpoint of a profile that sets none. OpenRouter is never\n// one.\nexport function defaultBaseURL (protocol:string):string {\n    return protocol === 'anthropic' ?\n        DEFAULT_ANTHROPIC_BASE_URL :\n        DEFAULT_OPENAI_BASE_URL\n}\n\n// Parses an endpoint with WHATWG URL, or null when it does not parse or\n// has an empty host. WHATWG repairs `https:///v1` and `https:v1` into a\n// host; Go sees an empty one, so text after the scheme must start with\n// `//` and a non-empty authority.\nexport function parseEndpoint (s:string):URL|null {\n    const colon = s.indexOf(':')\n    if (colon < 0) return null\n    const rest = s.slice(colon + 1)\n    if (!rest.startsWith('//')) return null\n    const end = rest.slice(2).search(/[/?#]/)\n    const authority = end < 0 ? rest.slice(2) : rest.slice(2, 2 + end)\n    // Userinfo alone (`https://u@/v1`) leaves no host either.\n    if (authority.slice(authority.lastIndexOf('@') + 1) === '') return null\n    let u:URL\n    try {\n        u = new URL(s)\n    } catch {\n        return null\n    }\n    return u.host === '' ? null : u\n}\n\nfunction stripTrailingSlashes (p:string):string {\n    let end = p.length\n    while (end > 0 && p[end - 1] === '/') end--\n    return p.slice(0, end)\n}\n\n// Endpoints compare by scheme and host (case-insensitive), path without\n// trailing slashes, raw query, and userinfo. Unparseable values never\n// match.\nexport function sameEndpoint (a:string, b:string):boolean {\n    const left = parseEndpoint(goTrimSpace(a))\n    const right = parseEndpoint(goTrimSpace(b))\n    if (!left || !right) return false\n    return left.protocol === right.protocol &&\n        left.host === right.host &&\n        stripTrailingSlashes(left.pathname) ===\n            stripTrailingSlashes(right.pathname) &&\n        left.search === right.search &&\n        left.username === right.username &&\n        left.password === right.password\n}\n"}],"structuredContent":"// The built-in provider registry (spec 02, 2.7): the one place that says\n// which endpoint, protocols, standard key variable, key page, and login\n// method each provider has. Trust standardness, ambient credentials, the\n// `init` starter, and login all consult it.\nimport { goTrimSpace } from '../gocompat/strings.js'\n\nexport const DEFAULT_OPENAI_BASE_URL = 'https://api.openai.com/v1'\nexport const DEFAULT_ANTHROPIC_BASE_URL = 'https://api.anthropic.com/v1'\nexport const OPENROUTER_BASE_URL = 'https://openrouter.ai/api/v1'\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\nexport type LoginMethod = 'paste'|'browser'\n\nexport interface BuiltinProvider {\n    readonly name:string;\n    readonly endpoint:string;\n    // The first is the one starter profiles use.\n    readonly protocols:readonly Protocol[];\n    readonly keyEnv:string;\n    readonly keyPage:string;\n    readonly login:LoginMethod;\n}\n\n// No two entries share an (endpoint, protocol) pair, so providerAt finds\n// at most one. Order matters for withheldKey and listings.\nconst REGISTRY:readonly BuiltinProvider[] = Object.freeze([\n    {\n        name:'openai',\n        endpoint:DEFAULT_OPENAI_BASE_URL,\n        protocols:['responses', 'chat'],\n        keyEnv:'OPENAI_API_KEY',\n        keyPage:'https://platform.openai.com/api-keys',\n        login:'paste',\n    },\n    {\n        name:'anthropic',\n        endpoint:DEFAULT_ANTHROPIC_BASE_URL,\n        protocols:['anthropic'],\n        keyEnv:'ANTHROPIC_API_KEY',\n        keyPage:'https://console.anthropic.com/settings/keys',\n        login:'paste',\n    },\n    {\n        name:'openrouter',\n        endpoint:OPENROUTER_BASE_URL,\n        protocols:['chat', 'responses'],\n        keyEnv:'OPENROUTER_API_KEY',\n        keyPage:'https://openrouter.ai/settings/keys',\n        login:'browser',\n    },\n].map(p => Object.freeze({\n    ...p,\n    protocols:Object.freeze([...p.protocols]) as readonly Protocol[],\n} as BuiltinProvider)))\n\nfunction copy (p:BuiltinProvider):BuiltinProvider {\n    return { ...p, protocols:[...p.protocols] }\n}\n\n// Copies of the registry, in registry order.\nexport function builtinProviders ():BuiltinProvider[] {\n    return REGISTRY.map(copy)\n}\n\n// The provider with exactly this name (case-sensitive).\nexport function lookupProvider (name:string):BuiltinProvider|undefined {\n    const p = REGISTRY.find(p => p.name === name)\n    return p && copy(p)\n}\n\n// The provider that accepts `protocol` at `endpoint`.\nexport function providerAt (\n    endpoint:string,\n    protocol:string\n):BuiltinProvider|undefined {\n    const p = REGISTRY.find(p =>\n        (p.protocols as readonly string[]).includes(protocol) &&\n        sameEndpoint(p.endpoint, endpoint))\n    return p && copy(p)\n}\n\n// The implicit endpoint of a profile that sets none. OpenRouter is never\n// one.\nexport function defaultBaseURL (protocol:string):string {\n    return protocol === 'anthropic' ?\n        DEFAULT_ANTHROPIC_BASE_URL :\n        DEFAULT_OPENAI_BASE_URL\n}\n\n// Parses an endpoint with WHATWG URL, or null when it does not parse or\n// has an empty host. WHATWG repairs `https:///v1` and `https:v1` into a\n// host; Go sees an empty one, so text after the scheme must start with\n// `//` and a non-empty authority.\nexport function parseEndpoint (s:string):URL|null {\n    const colon = s.indexOf(':')\n    if (colon < 0) return null\n    const rest = s.slice(colon + 1)\n    if (!rest.startsWith('//')) return null\n    const end = rest.slice(2).search(/[/?#]/)\n    const authority = end < 0 ? rest.slice(2) : rest.slice(2, 2 + end)\n    // Userinfo alone (`https://u@/v1`) leaves no host either.\n    if (authority.slice(authority.lastIndexOf('@') + 1) === '') return null\n    let u:URL\n    try {\n        u = new URL(s)\n    } catch {\n        return null\n    }\n    return u.host === '' ? null : u\n}\n\nfunction stripTrailingSlashes (p:string):string {\n    let end = p.length\n    while (end > 0 && p[end - 1] === '/') end--\n    return p.slice(0, end)\n}\n\n// Endpoints compare by scheme and host (case-insensitive), path without\n// trailing slashes, raw query, and userinfo. Unparseable values never\n// match.\nexport function sameEndpoint (a:string, b:string):boolean {\n    const left = parseEndpoint(goTrimSpace(a))\n    const right = parseEndpoint(goTrimSpace(b))\n    if (!left || !right) return false\n    return left.protocol === right.protocol &&\n        left.host === right.host &&\n        stripTrailingSlashes(left.pathname) ===\n            stripTrailingSlashes(right.pathname) &&\n        left.search === right.search &&\n        left.username === right.username &&\n        left.password === right.password\n}\n"},"isError":false,"durationMs":6}
{"type":"tool_execution_end","toolCallId":"SqnuM6PbkfJfix6pF9KvFpc4DaAnl9qm","toolName":"read","result":{"content":[{"type":"text","text":"// How the CLI finds and loads the project config (spec 02, 2.2). Every\n// command loads it through loadProjectConfig; failures are usage errors.\nimport { gitRoot } from '../git/git.js'\nimport { openCredentialStore } from '../credentials/credentials.js'\nimport {\n    type ProjectConfig,\n    findConfig,\n    loadConfig,\n    withStoredCredentials,\n} from '../config/load.js'\nimport type { RunContext } from './command.js'\nimport { UsageError } from './errors.js'\n\nexport const NO_PROJECT_CONFIG = 'no project config (.roast.json) found ' +\n    'between here and the Git toplevel; run `npx roast init` to create one'\n\nexport const NO_GATE_CONFIG = 'the pre-commit gate runs from the Git ' +\n    'toplevel and finds no .roast.json there; put the project config at ' +\n    'the toplevel (`npx roast init`) before enabling the gate'\n\ntype ConfigContext = Pick<RunContext, 'cwd'|'env'|'signal'>\n\nfunction usage (err:unknown):UsageError {\n    const message = err instanceof Error ? err.message : String(err)\n    return new UsageError(message, { cause:err })\n}\n\n// The config path: `explicit` (--config) unchanged when set, else the\n// nearest .roast.json from the working directory up to the Git toplevel\n// (the working directory itself outside a repository). '' when none.\nexport async function projectConfigPath (\n    explicit:string,\n    ctx:ConfigContext\n):Promise<string> {\n    if (explicit !== '') return explicit\n    let stop = ctx.cwd\n    try {\n        stop = await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n    }\n    return findConfig(ctx.cwd, stop)\n}\n\n// The config the pre-commit hook sees: only <toplevel>/.roast.json.\nexport function gateConfigPath (repo:string):string {\n    return findConfig(repo, repo)\n}\n\nexport async function loadProjectConfig (\n    explicit:string,\n    ctx:ConfigContext\n):Promise<ProjectConfig> {\n    let file:string\n    try {\n        file = await projectConfigPath(explicit, ctx)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw usage(err)\n    }\n    if (file === '') throw new UsageError(NO_PROJECT_CONFIG)\n    let cfg:ProjectConfig\n    try {\n        cfg = loadConfig(file)\n    } catch (err) {\n        throw usage(err)\n    }\n    // Every loaded config carries the stored-credentials store for the\n    // working directory; roles read its files only when they reach the\n    // stored step.\n    const stored = await openCredentialStore(ctx.cwd, ctx.env,\n        { signal:ctx.signal })\n    return withStoredCredentials(cfg, stored)\n}\n"}],"structuredContent":"// How the CLI finds and loads the project config (spec 02, 2.2). Every\n// command loads it through loadProjectConfig; failures are usage errors.\nimport { gitRoot } from '../git/git.js'\nimport { openCredentialStore } from '../credentials/credentials.js'\nimport {\n    type ProjectConfig,\n    findConfig,\n    loadConfig,\n    withStoredCredentials,\n} from '../config/load.js'\nimport type { RunContext } from './command.js'\nimport { UsageError } from './errors.js'\n\nexport const NO_PROJECT_CONFIG = 'no project config (.roast.json) found ' +\n    'between here and the Git toplevel; run `npx roast init` to create one'\n\nexport const NO_GATE_CONFIG = 'the pre-commit gate runs from the Git ' +\n    'toplevel and finds no .roast.json there; put the project config at ' +\n    'the toplevel (`npx roast init`) before enabling the gate'\n\ntype ConfigContext = Pick<RunContext, 'cwd'|'env'|'signal'>\n\nfunction usage (err:unknown):UsageError {\n    const message = err instanceof Error ? err.message : String(err)\n    return new UsageError(message, { cause:err })\n}\n\n// The config path: `explicit` (--config) unchanged when set, else the\n// nearest .roast.json from the working directory up to the Git toplevel\n// (the working directory itself outside a repository). '' when none.\nexport async function projectConfigPath (\n    explicit:string,\n    ctx:ConfigContext\n):Promise<string> {\n    if (explicit !== '') return explicit\n    let stop = ctx.cwd\n    try {\n        stop = await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n    }\n    return findConfig(ctx.cwd, stop)\n}\n\n// The config the pre-commit hook sees: only <toplevel>/.roast.json.\nexport function gateConfigPath (repo:string):string {\n    return findConfig(repo, repo)\n}\n\nexport async function loadProjectConfig (\n    explicit:string,\n    ctx:ConfigContext\n):Promise<ProjectConfig> {\n    let file:string\n    try {\n        file = await projectConfigPath(explicit, ctx)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw usage(err)\n    }\n    if (file === '') throw new UsageError(NO_PROJECT_CONFIG)\n    let cfg:ProjectConfig\n    try {\n        cfg = loadConfig(file)\n    } catch (err) {\n        throw usage(err)\n    }\n    // Every loaded config carries the stored-credentials store for the\n    // working directory; roles read its files only when they reach the\n    // stored step.\n    const stored = await openCredentialStore(ctx.cwd, ctx.env,\n        { signal:ctx.signal })\n    return withStoredCredentials(cfg, stored)\n}\n"},"isError":false,"durationMs":6}
