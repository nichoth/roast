rovider) bool {\n\t\t\t\treturn p.Name == provider.Name\n\t\t\t}) {\n\t\t\tcontinue\n\t\t}\n\t\tout = append(out, provider)\n\t}\n\treturn out, nil\n}\n\n// loginProvider obtains a key for provider and stores it at path. lines\n// reads stdin when it is not a terminal; callers share one across logins\n// and prompts so buffered input survives.\nfunc loginProvider(ctx context.Context, provider config.BuiltinProvider,\n\tflags loginFlags, path, scopeName string, stdin io.Reader,\n\tlines *bufio.Reader, stdout, stderr io.Writer) error {\n\tvar key string\n\tvar err error\n\tswitch provider.Login {\n\tcase config.LoginPaste:\n\t\tkey, err = pasteLogin(ctx, provider, flags, stdin, lines, stderr)\n\tcase config.LoginBrowser:\n\t\tkey, err = browserLogin(ctx, provider, flags, lines, stderr)\n\tdefault:\n\t\treturn fmt.Errorf(\"login to %s is not supported; set %s\",\n\t\t\tprovider.Name, provider.KeyEnv)\n\t}\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := credentials.Save(path, provider.Name, key,\n\t\ttime.Now()); err != nil {\n\t\treturn err\n\t}\n\tfmt.Fprintf(stdout, \"stored %s credential (%s scope)\\n\", provider.Name,\n\t\tscopeName)\n\treturn nil\n}\n\n// loginPath returns the credentials file and scope login writes to.\nfunc loginPath(global bool) (string, string, error) {\n\tif global {\n\t\tpath, err := credentials.UserPath()\n\t\treturn path, credentials.ScopeUser, err\n\t}\n\tpath, err := credentials.ProjectPath(\".\")\n\tif err != nil {\n\t\treturn \"\", \"\", &usageError{msg: \"not in a Git repository; \" +\n\t\t\t\"use --global to store the key for the user\"}\n\t}\n\treturn path, credentials.ScopeProject, nil\n}\n\nfunc providerNames() string {\n\tvar names []string\n\tfor _, p := range config.BuiltinProviders() {\n\t\tnames = append(names, p.Name)\n\t}\n\treturn strings.Join(names, \", \")\n}\n\n// pasteLogin sends the user to the provider's key page and reads a pasted\n// key, asking again when the provider rejects it. It returns only a key the\n// provider accepted.\nfunc pasteLogin(ctx context.Context, provider config.BuiltinProvider,\n\tflags loginFlags, stdin io.Reader, lines *bufio.Reader,\n\tstderr io.Writer) (string, error) {\n\tfmt.Fprintf(stderr, \"Create a %s API key at:\\n  %s\\n\", provider.Name,\n\t\tprovider.KeyPage)\n\tif !flags.noBrowser {\n\t\tif err := openBrowser(provider.KeyPage); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"could not open a browser (%v); \"+\n\t\t\t\t\"open the URL above\\n\", err)\n\t\t}\n\t}\n\tfor range pasteAttempts {\n\t\tkey, err := readSecret(stderr, stdin, lines, \"Paste the key: \")\n\t\tif err != nil {\n\t\t\treturn \"\", fmt.Errorf(\"read key: %w\", err)\n\t\t}\n\t\tif key == \"\" {\n\t\t\tfmt.Fprintln(stderr, \"no key entered\")\n\t\t\tcontinue\n\t\t}\n\t\terr = validateKey(ctx, provider, key)\n\t\tif errors.Is(err, errKeyRejected) {\n\t\t\tfmt.Fprintf(stderr, \"%s rejected the key; try again\\n\",\n\t\t\t\tprovider.Name)\n\t\t\tcontinue\n\t\t}\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\treturn key, nil\n\t}\n\treturn \"\", fmt.Errorf(\"%w: no accepted %s key after %d tries; \"+\n\t\t\"nothing stored\", llm.ErrAuth, provider.Name, pasteAttempts)\n}\n\n// validateKey checks key with a cheap authenticated request at the\n// provider's built-in endpoint (keyCheckPath). A 401 or 403 is\n// errKeyRejected; a network failure or any other unsuccessful status is an\n// endpoint error.\nfunc validateKey(ctx context.Context, provider config.BuiltinProvider,\n\tkey string) error {\n\tendpoint := strings.TrimRight(provider.Endpoint, \"/\") +\n\t\tkeyCheckPath(provider)\n\tctx, cancel := context.WithTimeout(ctx, validateTimeout)\n\tdefer cancel()\n\treq, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint,\n\t\tnil)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif provider.Protocols[0] == \"anthropic\" {\n\t\treq.Header.Set(\"x-api-key\", key)\n\t\treq.Header.Set(\"anthropic-version\", \"2023-06-01\")\n\t} else {\n\t\treq.Header.Set(\"Authorization\", \"Bearer \"+key)\n\t}\n\t// The zero client uses http.DefaultTransport, which tests redirect.\n\tresp, err := (&http.Client{}).Do(req)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"%w: check key at %s: %v\", llm.ErrEndpoint,\n\t\t\tendpoint, err)\n\t}\n\tdefer func() { _ = resp.Body.Close() }()\n\t_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 32<<10))\n\tswitch {\n\tcase resp.StatusCode >= 200 && resp.StatusCode < 300:\n\t\treturn nil\n\tcase resp.StatusCode == http.StatusUnauthorized ||\n\t\tresp.StatusCode == http.StatusForbidden:\n\t\treturn errKeyRejected\n\tdefault:\n\t\treturn fmt.Errorf(\"%w: check key at %s: HTTP %s\", llm.ErrEndpoint,\n\t\t\tendpoint, resp.Status)\n\t}\n}\n\n// keyCheckPath is the path, below the provider's endpoint, of a request\n// that succeeds only with a valid key. OpenRouter lists models without\n// one, so it is checked at its current-key endpoint instead.\nfunc keyCheckPath(provider config.BuiltinProvider) string {\n\tif provider.Name == \"openrouter\" {\n\t\treturn \"/key\"\n\t}\n\treturn \"/models\"\n}\n"}],"isError":false,"durationMs":4,"timestamp":1795227879607}]}
