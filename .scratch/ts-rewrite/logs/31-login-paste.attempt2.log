{"type":"tool_execution_end","toolCallId":"JmXbHDl1x0vRFLq1sYTDDbsle1TSR2Zz","toolName":"read","result":{"content":[{"type":"text","text":"// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\n"}],"structuredContent":"// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\n"},"isError":false,"durationMs":3}
{"type":"tool_execution_end","toolCallId":"2OhSK4StnfOOJct8c6EIGuAdUs343zlg","toolName":"read","result":{"content":[{"type":"text","text":"// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a\n// temporary Git repository as cwd, a clean environment, and optionally a\n// fetch that sends every request to a fake server.\nimport { run, type RunResult } from '../../src/cli/run.js'\nimport { BufferStream, inputStream } from './streams.js'\nimport { tempRepo } from './repo.js'\n\nexport interface RunRoastOpts {\n    // Working directory; a fresh temporary repository when absent.\n    cwd?:string;\n    // The environment; the repository's isolated env when absent.\n    env?:Record<string, string>;\n    stdin?:NodeJS.ReadableStream|string;\n    signal?:AbortSignal;\n    // Origin (`http://127.0.0.1:port`) every request is redirected to.\n    redirectTo?:string;\n}\n\nexport interface RunRoastResult extends RunResult {\n    stdout:string;\n    stderr:string;\n    // The original host of every redirected request, in order.\n    hosts:string[];\n}\n\n// A fetch that rewrites each URL's origin to `origin`, recording the\n// original host (Go redirectDefaultTransport).\nexport function redirectingFetch (\n    origin:string,\n    hosts:string[]\n):typeof globalThis.fetch {\n    return (input, init) => {\n        const req = new Request(input, init)\n        const url = new URL(req.url)\n        hosts.push(url.host)\n        const target = new URL(url.pathname + url.search, origin)\n        return globalThis.fetch(new Request(target, req))\n    }\n}\n\nexport async function runRoast (\n    args:string[],\n    opts:RunRoastOpts = {}\n):Promise<RunRoastResult> {\n    let cwd = opts.cwd\n    let env = opts.env\n    let remove:(() => void)|undefined\n    if (cwd === undefined) {\n        const repo = tempRepo()\n        cwd = repo.dir\n        env ??= repo.env\n        remove = repo.remove\n    }\n    const stdout = new BufferStream()\n    const stderr = new BufferStream()\n    const hosts:string[] = []\n    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?\n        inputStream(opts.stdin ?? '') :\n        opts.stdin\n    try {\n        const res = await run(args, {\n            stdin,\n            stdout,\n            stderr,\n            env:env ?? {},\n            cwd,\n            signal:opts.signal,\n            fetch:opts.redirectTo ?\n                redirectingFetch(opts.redirectTo, hosts) :\n                undefined,\n        })\n        return {\n            ...res,\n            stdout:stdout.text(),\n            stderr:stderr.text(),\n            hosts,\n        }\n    } finally {\n        remove?.()\n    }\n}\n"}],"structuredContent":"// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a\n// temporary Git repository as cwd, a clean environment, and optionally a\n// fetch that sends every request to a fake server.\nimport { run, type RunResult } from '../../src/cli/run.js'\nimport { BufferStream, inputStream } from './streams.js'\nimport { tempRepo } from './repo.js'\n\nexport interface RunRoastOpts {\n    // Working directory; a fresh temporary repository when absent.\n    cwd?:string;\n    // The environment; the repository's isolated env when absent.\n    env?:Record<string, string>;\n    stdin?:NodeJS.ReadableStream|string;\n    signal?:AbortSignal;\n    // Origin (`http://127.0.0.1:port`) every request is redirected to.\n    redirectTo?:string;\n}\n\nexport interface RunRoastResult extends RunResult {\n    stdout:string;\n    stderr:string;\n    // The original host of every redirected request, in order.\n    hosts:string[];\n}\n\n// A fetch that rewrites each URL's origin to `origin`, recording the\n// original host (Go redirectDefaultTransport).\nexport function redirectingFetch (\n    origin:string,\n    hosts:string[]\n):typeof globalThis.fetch {\n    return (input, init) => {\n        const req = new Request(input, init)\n        const url = new URL(req.url)\n        hosts.push(url.host)\n        const target = new URL(url.pathname + url.search, origin)\n        return globalThis.fetch(new Request(target, req))\n    }\n}\n\nexport async function runRoast (\n    args:string[],\n    opts:RunRoastOpts = {}\n):Promise<RunRoastResult> {\n    let cwd = opts.cwd\n    let env = opts.env\n    let remove:(() => void)|undefined\n    if (cwd === undefined) {\n        const repo = tempRepo()\n        cwd = repo.dir\n        env ??= repo.env\n        remove = repo.remove\n    }\n    const stdout = new BufferStream()\n    const stderr = new BufferStream()\n    const hosts:string[] = []\n    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?\n        inputStream(opts.stdin ?? '') :\n        opts.stdin\n    try {\n        const res = await run(args, {\n            stdin,\n            stdout,\n            stderr,\n            env:env ?? {},\n            cwd,\n            signal:opts.signal,\n            fetch:opts.redirectTo ?\n                redirectingFetch(opts.redirectTo, hosts) :\n                undefined,\n        })\n        return {\n            ...res,\n            stdout:stdout.text(),\n            stderr:stderr.text(),\n            hosts,\n        }\n    } finally {\n        remove?.()\n    }\n}\n"},"isError":false,"durationMs":3}
{"type":"tool_execution_end","toolCallId":"lcxTiR4JSbpywgqVS18U9PVSGHKoO1RI","toolName":"read","result":{"content":[{"type":"text","text":"// Swaps the terminal hooks for a test and restores them at test end.\nimport { terminalHooks } from '../../src/cli/terminal.js'\n\ninterface Cleanup {\n    cleanup (fn:() => void):void;\n}\n\n// Makes interactiveTerminals answer `value` until the test ends.\nexport function simulateTerminals (t:Cleanup, value:boolean):void {\n    const saved = terminalHooks.interactiveTerminals\n    terminalHooks.interactiveTerminals = () => value\n    t.cleanup(() => { terminalHooks.interactiveTerminals = saved })\n}\n\n// Replaces openBrowser with a recorder; returns the URLs it was asked to\n// open. Nothing is launched.\nexport function captureBrowser (t:Cleanup):string[] {\n    const saved = terminalHooks.openBrowser\n    const opened:string[] = []\n    terminalHooks.openBrowser = async url => {\n        opened.push(url)\n        return undefined\n    }\n    t.cleanup(() => { terminalHooks.openBrowser = saved })\n    return opened\n}\n"}],"structuredContent":"// Swaps the terminal hooks for a test and restores them at test end.\nimport { terminalHooks } from '../../src/cli/terminal.js'\n\ninterface Cleanup {\n    cleanup (fn:() => void):void;\n}\n\n// Makes interactiveTerminals answer `value` until the test ends.\nexport function simulateTerminals (t:Cleanup, value:boolean):void {\n    const saved = terminalHooks.interactiveTerminals\n    terminalHooks.interactiveTerminals = () => value\n    t.cleanup(() => { terminalHooks.interactiveTerminals = saved })\n}\n\n// Replaces openBrowser with a recorder; returns the URLs it was asked to\n// open. Nothing is launched.\nexport function captureBrowser (t:Cleanup):string[] {\n    const saved = terminalHooks.openBrowser\n    const opened:string[] = []\n    terminalHooks.openBrowser = async url => {\n        opened.push(url)\n        return undefined\n    }\n    t.cleanup(() => { terminalHooks.openBr