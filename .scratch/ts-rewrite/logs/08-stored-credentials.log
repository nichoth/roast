provider))\n    }\n    if (goTrimSpace(key) === '') {\n        throw new Error('save credential: empty key')\n    }\n    const entries = await loadCredentials(file)\n    entries.set(provider, { key, storedAt:formatStoredAt(storedAt) })\n    await writeCredentials(file, entries)\n}\n\n// Removes `provider`'s entry. A missing file or entry writes nothing.\nexport async function deleteCredential (\n    file:string,\n    provider:string\n):Promise<void> {\n    const entries = await loadCredentials(file)\n    if (!entries.delete(provider)) return\n    await writeCredentials(file, entries)\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3125,"cache_read_input_tokens":106562,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3125},"output_tokens":9,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2b2ffa6-15d5-4c22-b042-75e0dc4ef2c9","uuid":"be019d69-367c-4620-9232-42b307673ac6","timestamp":"2026-11-18T20:41:01.381Z","request_id":"req_011ChB3LPJoFuqCRLozJUs1B","wire_tool_inputs":{"toolu_014a7gVvP9FucgHSesRsbJFL":{"file_path":"/Users/nick/code/roast.ts-rewrite-08-stored-credentials/src/credentials/credentials.ts","old_string":"export async function loadCredentials (\n    file:string\n):Promise<Map<string, Entry>> {\n    return loadCredentialsSync(file)\n}\n","new_string":"export async function loadCredentials (\n    file:string\n):Promise<Map<string, Entry>> {\n    return loadCredentialsSync(file)\n}\n\n// Go's RFC3339Nano in UTC: the fraction only when non-zero, trailing\n// zeros trimmed.\nfunction formatStoredAt (d:Date):string {\n    return d.toISOString().replace(/\\.(\\d*?)0*Z$/, (_, frac:string) =>\n        frac === '' ? 'Z' : `.${frac}Z`)\n}\n\nasync function writeCredentials (\n    file:st