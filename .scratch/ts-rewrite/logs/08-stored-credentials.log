t over the target. Used for the trust record, stored\n// credentials, hook scripts, and run records.\n\nimport fs from 'node:fs/promises'\nimport path from 'node:path'\nimport { randomBytes } from 'node:crypto'\n\nexport interface AtomicWriteOpts {\n    // Final file mode, applied with fchmod before the rename. Default 0o600.\n    mode?:number;\n    // Temp name is `<tempPrefix><random><tempSuffix>` in the target's\n    // directory. Default prefix `.<basename>.roast-`, suffix empty.\n    tempPrefix?:string;\n    tempSuffix?:string;\n    // When set, the parent is created with `mkdir -p` and this mode.\n    dirMode?:number;\n    // Also chmod an existing parent to `dirMode` (credentials tighten a\n    // shared state directory to 0o700).\n    chmodDir?:boolean;\n    // When set, every failure is `<errorPrefix>: <cause>`. Otherwise each\n    // step names itself: `create temp file for <path>: ...`, `write <tmp>:\n    // ...`, `chmod <tmp>: ...`, `close <tmp>: ...`, `replace <path>: ...`.\n    errorPrefix?:string;\n}\n\nconst MAX_TRIES = 100\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nfunction isCode (err:unknown, code:string):boolean {\n    return (err as NodeJS.ErrnoException)?.code === code\n}\n\nexport async function writeFileAtomic (\n    target:string,\n    body:string|Uint8Array,\n    opts:AtomicWriteOpts = {}\n):Promise<void> {\n    const dir = path.dirname(target)\n    const prefix = opts.tempPrefix ?? `.${path.basename(target)}.roast-`\n    const suffix = opts.tempSuffix ?? ''\n    const mode = opts.mode ?? 0o600\n\n    // Runs one step, mapping its failure to the configured message.\n    async function step<T> (label:string, fn:() => Promise<T>):Promise<T> {\n        try {\n            return await fn()\n        } catch (err) {\n            const text = opts.errorPrefix ?\n                `${opts.errorPrefix}: ${message(err)}` :\n                `${label}: ${message(err)}`\n            throw new Error(text, { cause:err })\n        }\n    }\n\n    if (opts.dirMode !== undefined) {\n        const dirMode = opts.dirMode\n        await step(`mkdir ${dir}`, async () => {\n            await fs.mkdir(dir, { recursive:true, mode:dirMode })\n            if (opts.chmodDir) await fs.chmod(dir, dirMode)\n        })\n    }\n\n    const [handle, tmp] = await step(`create temp file for ${target}`,\n        async ():Promise<[fs.FileHandle, string]> => {\n            for (let i = 0; ; i++) {\n                const name = prefix + randomBytes(8).toString('hex') + suffix\n                const tmp = path.join(dir, name)\n                try {\n                    return [await fs.open(tmp, 'wx', 0o600), tmp]\n                } catch (err) {\n                    if (!isCode(err, 'EEXIST') || i + 1 >= MAX_TRIES) {\n                        throw err\n                    }\n                }\n            }\n        })\n\n    let closed = false\n    try {\n        await step(`write ${tmp}`, () => handle.writeFile(body))\n        await step(`chmod ${tmp}`, () => handle.chmod(mode))\n        closed = true\n        await step(`close ${tmp}`, () => handle.close())\n        await step(`replace ${target}`, () => fs.rename(tmp, target))\n    } catch (err) {\n        if (!closed) await handle.close().catch(() => {})\n        await fs.rm(tmp, { force:true }).catch(() => {})\n        throw err\n    }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"d2b2ffa6-15d5-4c22-b042-75e0dc4ef2c9","uuid":"37f52bc8-77f9-4f38-beba-d814458fc10a","timestamp":"2026-11-18T20:38:14.208Z","tool_use_result":{"stdout":"// Credential resolution and endpoint overrides (spec 02, 2.6 and 2.9).\n// `env` is always passed in; nothing here reads process.env. A key never\n// appears in a CredentialSource or an error message.\nimport { ConfigError } from './load.js'\nimport {\n    builtinProviders,\n    defaultBaseURL,\n    providerAt,\n    sameEndpoint,\n} from './provider.js'\nimport { type ResolvedRole, updateRole } from './resolved-role.js'\n\nexport type Env = Readonly<Record<string, string|undefined>>\n\n// The stored-credential store a loaded config carries (filled by the\n// credentials area; config never imports it).\nexport interface StoredCredentials {\n    // null or a '' key when none is stored. Throws when a credentials file\n    // cannot be used; it never skips a bad file.\n    lookup (provider:string):{\n        key:string,\n        scope:'project'|'user'|'',\n    }|null;\n}\n\nexport type CredentialKind =\n    'role_env'|'profile_env'|'provider_env'|'stored'|'none'\n\nexport interface CredentialSource {\n    readonly kind:CredentialKind;\n    // The variable read, for env kinds.\n    readonly env?:string;\n    // stored: provider name and scope ('project' or 'user').\n    readonly provider?:string;\n    readonly scope?:string;\n    // none: a set provider key that was not sent.\n    readonly withheld?:string;\n}\n\nexport interface Credential {\n    key:string;\n    source:CredentialSource;\n}\n\n// A variable counts only when it is set to a non-empty string.\nexport function envValue (env:Env, name:string):string {\n    if (name === '' || !Object.hasOwn(env, name)) return ''\n    const v = env[name]\n    return typeof v === 'string' ? v : ''\n}\n\nexport function roleKeyVar (role:string):string {\n    return `ROAST_${role.toUpperCase()}_API_KEY`\n}\n\n// Where a credential came from, never the credential itself.\nexport function describeSource (s:CredentialSource):string {\n    switch (s.kind) {\n        case 'role_env': return `${s.env} (role override)`\n        case 'profile_env': return `${s.env} (profile api_key_env)`\n        case 'provider_env': return `${s.env} (ambient provider key)`\n        case 'stored':\n            return `stored ${s.scope} credential for ${s.provider}`\n        default:\n            return s.withheld ?\n                `none; ${s.withheld} is set but is sent only to its ` +\n                    \"provider's default endpoint\" :\n                'none'\n    }\n}\n\nfunction wrap (roleName:string, err:unknown):ConfigError {\n    const cause = err instanceof Error ? err.message : String(err)\n    return new ConfigError(`role ${roleName}: ${cause}`, { cause:err })\n}\n\n// A set standard key variable of a built-in provider, preferring the\n// provider at the protocol's default endpoint, or ''. Called only after no\n// key was sent, so any variable it names was withheld.\nfunction withheldKey (protocol:string, env:Env):string {\n    const providers = builtinProviders()\n    const preferred = providers.find(p =>\n        sameEndpoint(p.endpoint, defaultBaseURL(protocol)))\n    const candidates = [\n        ...(preferred ? [preferred.keyEnv] : []),\n        ...providers.map(p => p.keyEnv),\n    ]\n    return candidates.find(name => envValue(env, name) !== '') ?? ''\n}\n\n// The stored key of the built-in provider at endpoint and protocol. The\n// registry alone decides the provider, so a custom endpoint never\n// receives a stored key.\nfunction storedCredential (\n    stored:StoredCredentials|undefined,\n    protocol:string,\n    endpoint:string\n):Credential|null {\n    const provider = providerAt(endpoint, protocol)\n    if (!provider || !stored) return null\n    const found = stored.lookup(provider.name)\n    if (!found || found.key === '') return null\n    return {\n        key:found.key,\n        source:{ kind:'stored', provider:provider.name, scope:found.scope },\n    }\n}\n\n// A built-in provider's standard key, else its stored key, only when the\n// role is on that provider's endpoint with a protocol it accepts there.\n// Throws when the store is reached and unusable.\nexport function ambientCredential (\n    protocol:string,\n    endpoint:string,\n    stored:StoredCredentials|undefined,\n    env:Env\n):Credential {\n    const provider = providerAt(endpoint, protocol)\n    if (provider) {\n        const key = envValue(env, provider.keyEnv)\n        if (key !== '') {\n            return { key, source:{ kind:'provider_env', env:provider.keyEnv } }\n        }\n        const fromStore = storedCredential(stored, protocol, endpoint)\n        if (fromStore) return fromStore\n    }\n    const withheld = withheldKey(protocol, env)\n    return { key:'', source:{ kind:'none', withheld } }\n}\n\n// The credential of a freshly resolved role: the role variable, the\n// profile's variable, then the ambient provider key or stored key.\nexport function resolveCredential (\n    roleName:string,\n    apiKeyEnv:string,\n    role:Pick<ResolvedRole, 'protocol'|'baseURL'|'stored'>,\n    env:Env\n):Credential {\n    const roleVar = roleKeyVar(roleName)\n    const roleKey = envValue(env, roleVar)\n    if (roleKey !== '') {\n        return { key:roleKey, source:{ kind:'role_env', env:roleVar } }\n    }\n    try {\n        if (apiKeyEnv !== '') {\n            const source:CredentialSource = {\n                kind:'profile_env',\n                env:apiKeyEnv,\n            }\n            const key = envValue(env, apiKeyEnv)\n            if (key !== '') return { key, source }\n            // An unset profile variable on a built-in endpoint falls back\n            // to the provider's variable, then its stored key, as\n            // rebindCredential does after an override.\n            const ambient = ambientCredential(role.protocol, role.baseURL,\n                role.stored, env)\n            return ambient.key === '' ? { key:'', source } : ambient\n        }\n        return ambientCredential(role.protocol, role.baseURL, role.stored,\n            env)\n    } catch (err) {\n        throw wrap(roleName, err)\n    }\n}\n\ninterface Overrides {\n    baseURL?:string;\n    protocol?:string;\n}\n\n// Applies the protocol, then the endpoint override. Returns the moved\n// role and whether the protocol override moved it from one provider's\n// default endpoint to another's.\nfunction applyEndpointOverrides (\n    role:ResolvedRole,\n    { baseURL, protocol }:Overrides\n):{ role:ResolvedRole, crossed:boolean } {\n    let crossed = false\n    let next = role\n    if (protocol !== undefined) {\n        const previousDefault = defaultBaseURL(role.protocol)\n        const nextDefault = defaultBaseURL(protocol)\n        next = updateRole(next, { protocol })\n        if (nextDefault !== previousDefault &&\n            (!role.explicitEndpoint ||\n                sameEndpoint(role.baseURL, previousDefault))) {\n            next = updateRole(next, { baseURL:nextDefault })\n            crossed = true\n        }\n    }\n    if (baseURL !== undefined) {\n        next = updateRole(next, { baseURL, explicitEndpoint:true })\n        crossed = false\n    }\n    return { role:next, crossed }\n}\n\n// Re-resolves a credential after the endpoint or protocol changed. A role\n// key, or a profile key on an endpoint that did not cross providers,\n// follows the override; any other key is checked again.\nfunction rebindCredential (\n    roleName:string,\n    role:ResolvedRole,\n    crossed:boolean,\n    env:Env\n):ResolvedRole {\n    const kind = role.credential.kind\n    if (kind === 'role_env') return role\n    if (kind === 'profile_env' && !crossed) return role\n    const roleVar = roleKeyVar(roleName)\n    const roleKey = envValue(env, roleVar)\n    if (roleKey !== '') {\n        return updateRole(role, {\n            apiKey:roleKey,\n            credential:{ kind:'role_env', env:roleVar },\n        })\n    }\n    let found:Credential\n    try {\n        found = ambientCredential(role.protocol, role.baseURL, role.stored,\n            env)\n    } catch (err) {\n        throw wrap(roleName, err)\n    }\n    return updateRole(role, { apiKey:found.key, credential:found.source })\n}\n\n// Applies `--<role>-base-url` / `--<role>-protocol` (undefined = flag not\n// given) and re-binds the credential through the same path as initial\n// resolution. Throws only when a needed stored credential is unusable.\nexport function overrideEndpoint (\n    roleName:string,\n    role:ResolvedRole,\n    overrides:Overrides,\n    env:Env\n):ResolvedRole {\n    const moved = applyEndpointOverrides(role, overrides)\n    return rebindCredential(roleName, moved.role, moved.crossed, env)\n}\n\n// Exposed for the override matrix tests only.\nexport const internal = { applyEndpointOverrides, rebindCredential }\n// How the CLI finds and loads the project config (spec 02, 2.2). Every\n// command loads it through loadProjectConfig; failures are usage errors.\nimport { gitRoot } from '../git/git.js'\nimport {\n    type ProjectConfig,\n    type StoredCredentials,\n    findConfig,\n    loadConfig,\n    withStoredCredentials,\n} from '../config/load.js'\nimport type { RunContext } from './command.js'\nimport { UsageError } from './errors.js'\n\nexport const NO_PROJECT_CONFIG = 'no project config (.roast.json) found ' +\n    'between here and the Git toplevel; run `npx roast init` to create one'\n\nexport const NO_GATE_CONFIG = 'the pre-commit gate runs from the Git ' +\n    'toplevel and finds no .roast.json there; put the project config at ' +\n    'the toplevel (`npx roast init`) before enabling the gate'\n\ntype ConfigContext = Pick<RunContext, 'cwd'|'env'|'signal'>\n\n// The store attached to every loaded config. The stored-credentials area\n// sets it; until then configs carry none.\nexport const configHooks:{\n    storedCredentials?:(ctx:ConfigContext) => StoredCredentials;\n} = {}\n\nfunction usage (err:unknown):UsageError {\n    const message = err instanceof Error ? err.message : String(err)\n    return new UsageError(message, { cause:err })\n}\n\n// The config path: `explicit` (--config) unchanged when set, else the\n// nearest .roast.json from the working directory up to the Git toplevel\n// (the working directory itself outside a repository). '' when none.\nexport async function projectConfigPath (\n    explicit:string,\n    ctx:ConfigContext\n):Promise<string> {\n    if (explicit !== '') return explicit\n    let stop = ctx.cwd\n    try {\n        stop = await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n    }\n    return findConfig(ctx.cwd, stop)\n}\n\n// The config the pre-commit hook sees: only <toplevel>/.roast.json.\nexport function gateConfigPath (repo:string):string {\n    return findConfig(repo, repo)\n}\n\nexport async function loadProjectConfig (\n    explicit:string,\n    ctx:ConfigContext\n):Promise<ProjectConfig> {\n    let file:string\n    try {\n        file = await projectConfigPath(explicit, ctx)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw usage(err)\n    }\n    if (file === '') throw new UsageError(NO_PROJECT_CONFIG)\n    let cfg:ProjectConfig\n    try {\n        cfg = loadConfig(file)\n    } catch (err) {\n        throw usage(err)\n    }\n    const stored = configHooks.storedCredentials?.(ctx)\n    return stored ? withStoredCredentials(cfg, stored) : cfg\n}\n// Per-clone approvals of project configs (spec 03, 2.5 and 2.6). The\n// record lives under the Git common directory, which `git clone` never\n// copies, so a repository cannot ship its own approval.\nimport fs from 'node:fs/promises'\nimport path from 'node:path'\nimport { git } from '../git/git.js'\nimport { writeFileAtomic } from '../fsutil/atomic.js'\n\nexport const TRUST_FILE = 'trust.json'\nconst CURRENT_VERSION = 2\nconst LEGACY_VERSION = 1\n\nexport interface TrustOpts {\n    signal?:AbortSignal;\n    // The git environment, normally the CLI context's env.\n    env?:NodeJS.ProcessEnv;\n}\n\nexport type TrustRecord =\n    { kind:'current', approved:string[] }|{ kind:'legacy' }\n\nexport type ApprovalState = 'approved'|'not-approved'|'legacy'\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\n// <git-common-dir>/roast for the repository containing `dir`. Linked\n// worktrees share the main repository's.\nexport async function stateDir (\n    dir:string,\n    opts:TrustOpts = {}\n):Promise<string> {\n    let out:Buffer\n    try {\n        out = await git(dir, ['rev-parse', '--path-format=absolute',\n            '--git-common-dir'], opts)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error('not inside a git repository', { cause:err })\n    }\n    return path.join(out.toString('utf8').trim(), 'roast')\n}\n\nexport async function trustPath (\n    dir:string,\n    opts:TrustOpts = {}\n):Promise<string> {\n    try {\n        return path.join(await stateDir(dir, opts), TRUST_FILE)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error(`trust: ${message(err)}`, { cause:err })\n    }\n}\n\nfunction isObject (v:unknown):v is Record<string, unknown> {\n    return typeof v === 'object' && v !== null && !Array.isArray(v)\n}\n\n// Reads the record at `file`. An absent file is an empty current record;\n// a version 1 file (Go era) is legacy; anything else is an error.\nexport async function readTrustRecord (file:string):Promise<TrustRecord> {\n    let text:string\n    try {\n        text = await fs.readFile(file, 'utf8')\n    } catch (err) {\n        if ((err as NodeJS.ErrnoException).code === 'ENOENT') {\n            return { kind:'current', approved:[] }\n        }\n        throw new Error(`read trust record: ${message(err)}`, { cause:err })\n    }\n    const invalid = (cause:string):Error =>\n        new Error(`read trust record ${file}: ${cause}`)\n    let doc:unknown\n    try {\n        doc = JSON.parse(text)\n    } catch (err) {\n        throw invalid(message(err))\n    }\n    if (!isObject(doc)) throw invalid('not a JSON object')\n    const version = doc.version\n    if (version === LEGACY_VERSION) return { kind:'legacy' }\n    if (version !== CURRENT_VERSION) {\n        const shown = version === undefined ? 0 : JSON.stringify(version)\n        throw new Error(`trust record ${file} has unsupported version ` +\n            `${shown}`)\n    }\n    const approved = doc.approved ?? []\n    if (!Array.isArray(approved) ||\n        !approved.every(h => typeof h === 'string')) {\n        throw invalid('approved must be an array of strings')\n    }\n    return { kind:'current', approved }\n}\n\nexport async function isApproved (\n    dir:string,\n    hash:string,\n    opts:TrustOpts = {}\n):Promise<ApprovalState> {\n    const rec = await readTrustRecord(await trustPath(dir, opts))\n    if (rec.kind === 'legacy') return 'legacy'\n    return rec.approved.includes(hash) ? 'approved' : 'not-approved'\n}\n\n// Records `hash` for this clone. A legacy record is replaced, not\n// migrated; a malformed one aborts with the file untouched.\nexport async function approve (\n    dir:string,\n    hash:string,\n    opts:TrustOpts = {}\n):Promise<void> {\n    const file = await trustPath(dir, opts)\n    const rec = await readTrustRecord(file)\n    let approved = [hash]\n    if (rec.kind === 'current') {\n        if (rec.approved.includes(hash)) return\n        approved = [...rec.approved, hash]\n    }\n    const body = { version:CURRENT_VERSION, approved }\n    await writeFileAtomic(file, JSON.stringify(body, null, 2) + '\\n', {\n        mode:0o600,\n        tempPrefix:'trust-',\n        tempSuffix:'.json',\n        dirMode:0o755,\n        errorPrefix:'write trust record',\n    })\n}\n// Atomic file replacement: write a fresh temp file beside the target, then\n// rename it over the target. Used for the trust record, stored\n// credentials, hook scripts, and run records.\n\nimport fs from 'node:fs/promises'\nimport path from 'node:path'\nimport { randomBytes } from 'node:crypto'\n\nexport interface AtomicWriteOpts {\n    // Final file mode, applied with fchmod before the rename. Default 0o600.\n    mode?:number;\n    // Temp name is `<tempPrefix><random><tempSuffix>` in the target's\n    // directory. Default prefix `.<basename>.roast-`, suffix empty.\n    tempPrefix?:string;\n    tempSuffix?:string;\n    // When set, the parent is created with `mkdir -p` and this mode.\n    dirMode?:number;\n    // Also chmod an existing parent to `dirMode` (credentials tighten a\n    // shared state directory to 0o700).\n    chmodDir?:boolean;\n    // When set, every failure is `<errorPrefix>: <cause>`. Otherwise each\n    // step names itself: `create temp file for <path>: ...`, `write <tmp>:\n    // ...`, `chmod <tmp>: ...`, `close <tmp>: ...`, `replace <path>: ...`.\n    errorPrefix?:string;\n}\n\nconst MAX_TRIES = 100\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nfunction isCode (err:unknown, code:string):boolean {\n    return (err as NodeJS.ErrnoException)?.code === code\n}\n\nexport async function writeFileAtomic (\n    target:string,\n    body:string|Uint8Array,\n    opts:AtomicWriteOpts = {}\n):Promise<void> {\n    const dir = path.dirname(target)\n    const prefix = opts.tempPrefix ?? `.${path.basename(target)}.roast-`\n    const suffix = opts.tempSuffix ?? ''\n    const mode = opts.mode ?? 0o600\n\n    // Runs one step, mapping its failure to the configured message.\n    async function step<T> (label:string, fn:() => Promise<T>):Promise<T> {\n        try {\n            return await fn()\n        } catch (err) {\n            const text = opts.errorPrefix ?\n                `${opts.errorPrefix}: ${message(err)}` :\n                `${label}: ${message(err)}`\n            throw new Error(text, { cause:err })\n        }\n    }\n\n    if (opts.dirMode !== undefined) {\n        const dirMode = opts.dirMode\n        await step(`mkdir ${dir}`, async () => {\n            await fs.mkdir(dir, { recursive:true, mode:dirMode })\n            if (opts.chmodDir) await fs.chmod(dir, dirMode)\n        })\n    }\n\n    const [handle, tmp] = await step(`create temp file for ${target}`,\n        async ():Promise<[fs.FileHandle, string]> => {\n            for (let i = 0; ; i++) {\n                const name = prefix + randomBytes(8).toString('hex') + suffix\n                const tmp = path.join(dir, name)\n                try {\n                    return [await fs.open(tmp, 'wx', 0o600), tmp]\n                } catch (err) {\n                    if (!isCode(err, 'EEXIST') || i + 1 >= MAX_TRIES) {\n                        throw err\n                    }\n                }\n            }\n        })\n\n    let closed = false\n    try {\n        await step(`write ${tmp}`, () => handle.writeFile(body))\n        await step(`chmod ${tmp}`, () => handle.chmod(mode))\n        closed = true\n        await step(`close ${tmp}`, () => handle.close())\n        await step(`replace ${target}`, () => fs.rename(tmp, target))\n    } catch (err) {\n        if (!closed) await handle.close().catch(() => {})\n        await fs.rm(tmp, { force:true }).catch(() => {})\n        throw err\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FbSb8rt3avG2cVFoBTi5uu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
