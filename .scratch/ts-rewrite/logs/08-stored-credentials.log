{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChB3DJJUvZAPRXMsWK3Rh","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017QDETaSup8KQukQa6tooQU","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-08-stored-credentials/src/credentials/credentials.ts","content":"// Stored provider keys (spec 03, 2.12 and 2.13, ADR-0002). Keys saved by\n// `login` live in credentials.json in two scopes: project, under the Git\n// common directory beside trust.json, and user, under the XDG config\n// directory. A key never appears in an error message.\nimport path from 'node:path'\nimport { stateDir, type TrustOpts } from '../trust/trust.js'\n\nexport const CREDENTIALS_FILE = 'credentials.json'\n\nexport type CredentialScope = 'project'|'user'\n\nexport type Env = Readonly<Record<string, string|undefined>>\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nfunction envValue (env:Env, name:string):string {\n    const v = Object.hasOwn(env, name) ? env[name] : undefined\n    return typeof v === 'string' ? v : ''\n}\n\n// <git-common-dir>/roast/credentials.json for the repository holding dir.\nexport async function projectCredentialsPath (\n    dir:string,\n    opts:TrustOpts = {}\n):Promise<string> {\n    try {\n        return path.join(await stateDir(dir, opts), CREDENTIALS_FILE)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error(`project credentials: ${message(err)}`,\n            { cause:err })\n    }\n}\n\n// $XDG_CONFIG_HOME/roast/credentials.json, else\n// $HOME/.config/roast/credentials.json, both read from `env` (never the\n// passwd entry, which would defeat test isolation).\nexport function userCredentialsPath (env:Env):string {\n    const xdg = envValue(env, 'XDG_CONFIG_HOME')\n    if (xdg !== '') return path.join(xdg, 'roast', CREDENTIALS_FILE)\n    const home = envValue(env, 'HOME')\n    if (home === '') {\n        throw new Error('user credentials: $HOME is not defined')\n    }\n    return path.join(home, '.config', 'roast', CREDENTIALS_FILE)\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":712,"cache_read_input_tokens":94928,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":712},"output_tokens":32,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2b2ffa6-15d5-4c22-b042-75e0dc4ef2c9","uuid":"e73ed90d-e542-4744-b676-6cb81912ef09","timestamp":"2026-11-18T20:39:24.282Z","request_id":"req_011ChB3DJ4qn7e5wtLkgcdYb","wire_tool_inputs":{"toolu_017QDETaSup8KQukQa6tooQU":{"file_path":"/Users/nick/code/roast.ts-rewrite-08-stored-credentials/src/credentials/credentials.ts","content":"// Stored provider keys (spec 03, 2.12 and 2.13, ADR-0002). Keys saved by\n// `login` live in credentials.json in two scopes: project, under the Git\n// common directory beside trust.json, and user, under the XDG config\n// directory. A key never appears in an error message.\nimport path from 'node:path'\nimport { stateDir, type TrustOpts } from '../trust/trust.js'\n\nexport const CREDENTIALS_FILE = 'credentials.json'\n\nexport type CredentialScope = 'project'|'user'\n\nexport type Env = Readonly<Record<string, string|undefined>>\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nfunction envValue (env:Env, name:string):string {\n    const v = Object.hasOwn(env, name) ? env[name] : undefined\n    return typeof v === 'string' ? v : ''\n}\n\n// <git-common-dir>/roast/credentials.json for the repository holding dir.\nexport async function projectCredentialsPath (\n    dir:string,\n    opts:TrustOpts = {}\n):Promise<string> {\n    try {\n        return path.join(await stateDir(dir, opts), CREDENTIALS_FILE)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error(`project credentials: ${message(err)}`,\n            { cause:err })\n    }\n}\n\n// $XDG_CONFIG_HOME/roast/credentials.json, else\n// $HOME/.config/roast/credentials.json, both read from `env` (never the\n// passwd entry, which would defeat test isolation).\nexport function userCredentialsPath (env:Env):string {\n    const xdg = envValue(env, 'XDG_CONFIG_HOME')\n    if (xdg !== '') return path.join(xdg, 'roast', CREDENTIALS_FILE)\n    const home = envValue(env, 'HOME')\n    if (home === '') {\n        throw new Error('user credentials: $HOME is not defined')\n    }\n    return path.join(home, '.config', 'roast', CREDENTIALS_FILE)\n}\n"}}}
