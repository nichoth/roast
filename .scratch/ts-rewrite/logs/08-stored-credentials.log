{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChB3BAkVejipBrG7Uup1q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ArX2jZqvYXHgt1NUyktMxm","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-08-stored-credentials/test/credentials/credentials.ts","content":"// Stored credential files and the credential store (spec 03, 2.12, 2.13,\n// 5.5), in temporary Git repositories with an isolated HOME.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempRepo, tempDir, type TempDir } from '../helpers/repo.js'\nimport {\n    projectCredentialsPath,\n    userCredentialsPath,\n} from '../../src/credentials/credentials.js'\n\nfunction repo (t:CleanupTest):TempDir {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    return r\n}\n\nasync function rejects (p:Promise<unknown>):Promise<Error|undefined> {\n    try {\n        await p\n    } catch (err) {\n        return err as Error\n    }\n    return undefined\n}\n\nfunction thrown (fn:() => unknown):Error|undefined {\n    try {\n        fn()\n    } catch (err) {\n        return err as Error\n    }\n    return undefined\n}\n\ntest('project credentials live in the Git common directory', async t => {\n    const r = repo(t)\n    const want = path.join(r.dir, '.git', 'roast', 'credentials.json')\n    const sub = path.join(r.dir, 'a')\n    fs.mkdirSync(sub)\n    t.equal(await projectCredentialsPath(sub, { env:r.env }), want,\n        'from a subdirectory')\n\n    const git = (...args:string[]) => execFileSync('git', args,\n        { cwd:r.dir, env:r.env, stdio:'ignore' })\n    git('commit', '-q', '--allow-empty', '-m', 'init')\n    const linked = path.join(path.dirname(r.dir), 'linked')\n    git('worktree', 'add', '-q', linked)\n    t.equal(await projectCredentialsPath(linked, { env:r.env }), want,\n        'from a linked worktree')\n\n    const outside = tempDir()\n    t.cleanup(outside.remove)\n    t.ok(await rejects(projectCredentialsPath(outside.dir,\n        { env:outside.env })), 'outside a repository throws')\n})\n\ntest('user credentials follow XDG_CONFIG_HOME, else HOME', t => {\n    t.equal(userCredentialsPath({ XDG_CONFIG_HOME:'/x', HOME:'/h' }),\n        path.join('/x', 'roast', 'credentials.json'), 'XDG_CONFIG_HOME')\n    t.equal(userCredentialsPath({ XDG_CONFIG_HOME:'', HOME:'/h' }),\n        path.join('/h', '.config', 'roast', 'credentials.json'),\n        'empty XDG_CONFIG_HOME falls back to HOME')\n    t.equal(userCredentialsPath({ HOME:'/h' }),\n        path.join('/h', '.config', 'roast', 'credentials.json'), 'HOME')\n    t.ok(thrown(() => userCredentialsPath({})), 'neither set throws')\n    t.ok(thrown(() => userCredentialsPath({ HOME:'', XDG_CONFIG_HOME:'' })),\n        'both empty throws')\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3162,"cache_read_input_tokens":87298,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3162},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2b2ffa6-15d5-4c22-b042-75e0dc4ef2c9","uuid":"b2272a5c-8eed-475c-8d52-c05e90587536","timestamp":"2026-11-18T20:38:58.956Z","request_id":"req_011ChB3BAY6BPTSdb3yvM63s","wire_tool_inputs":{"toolu_01ArX2jZqvYXHgt1NUyktMxm":{"file_path":"/Users/nick/code/roast.ts-rewrite-08-stored-credentials/test/credentials/credentials.ts","content":"// Stored credential files and the credential store (spec 03, 2.12, 2.13,\n// 5.5), in temporary Git repositories with an isolated HOME.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempRepo, tempDir, type TempDir } from '../helpers/repo.js'\nimport {\n    projectCredentialsPath,\n    userCredentialsPath,\n} from '../../src/credentials/credentials.js'\n\nfunction repo (t:CleanupTest):TempDir {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    return r\n}\n\nasync function rejects (p:Promise<unknown>):Promise<Error|undefined> {\n    try {\n        await p\n    } catch (err) {\n        return err as Error\n    }\n    return undefined\n}\n\nfunction thrown (fn:() => unknown):Error|undefined {\n    try {\n        fn()\n    } catch (err) {\n        return err as Error\n    }\n    return undefined\n}\n\ntest('project credentials live in the Git common directory', async t => {\n    const r = repo(t)\n    const want = path.join(r.dir, '.git', 'roast', 'credentials.json')\n    const sub = path.join(r.dir, 'a')\n    fs.mkdirSync(sub)\n    t.equal(await projectCredentialsPath(sub, { env:r.env }), want,\n        'from a subdirectory')\n\n    const git = (...args:string[]) => execFileSync('git', args,\n        { cwd:r.dir, env:r.env, stdio:'ignore' })\n    git('commit', '-q', '--allow-empty', '-m', 'init')\n    const linked = path.join(path.dirname(r.dir), 'linked')\n    git('worktree', 'add', '-q', linked)\n    t.equal(await projectCredentialsPath(linked, { env:r.env }), want,\n        'from a linked worktree')\n\n    const outside = tempDir()\n    t.cleanup(outside.remove)\n    t.ok(await rejects(projectCredentialsPath(outside.dir,\n        { env:outside.env })), 'outside a repository throws')\n})\n\ntest('user credentials follow XDG_CONFIG_HOME, else HOME', t => {\n    t.equal(userCredentialsPath({ XDG_CONFIG_HOME:'/x', HOME:'/h' }),\n        path.join('/x', 'roast', 'credentials.json'), 'XDG_CONFIG_HOME')\n    t.equal(userCredentialsPath({ XDG_CONFIG_HOME:'', HOME:'/h' }),\n        path.join('/h', '.config', 'roast', 'credentials.json'),\n        'empty XDG_CONFIG_HOME falls back to HOME')\n    t.equal(userCredentialsPath({ HOME:'/h' }),\n        path.join('/h', '.config', 'roast', 'credentials.json'), 'HOME')\n    t.ok(thrown(() => userCredentialsPath({})), 'neither set throws')\n    t.ok(thrown(() => userCredentialsPath({ HOME:'', XDG_CONFIG_HOME:'' })),\n        'both empty throws')\n})\n"}}}
