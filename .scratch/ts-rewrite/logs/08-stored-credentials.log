{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012fTsGr3XAEZtiH864ZKpwR","type":"tool_result","content":"// Temporary directories and Git repositories for CLI tests, with an\n// environment that isolates the user's home and config directories and\n// gives Git an identity (CI runners have none).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { cleanEnv } from './env.js'\n\nexport interface TempDir {\n    dir:string;\n    env:Record<string, string>;\n    remove ():void;\n}\n\nfunction makeTemp (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\n// The base test environment: the process env without provider or roast\n// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside\n// `root`, a Git identity, and no Git discovery above `root`.\nexport function isolatedEnv (root:string):Record<string, string> {\n    const home = path.join(root, '.home')\n    fs.mkdirSync(home, { recursive:true })\n    return {\n        ...cleanEnv(process.env),\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n        GIT_AUTHOR_NAME:'Roast Test',\n        GIT_AUTHOR_EMAIL:'roast-test@example.com',\n        GIT_COMMITTER_NAME:'Roast Test',\n        GIT_COMMITTER_EMAIL:'roast-test@example.com',\n        GIT_CEILING_DIRECTORIES:path.dirname(root),\n        GIT_CONFIG_NOSYSTEM:'1',\n    }\n}\n\n// A temporary directory that is not inside any Git repository. The test\n// working directory is `dir/work`.\nexport function tempDir (prefix = 'roast-dir-'):TempDir {\n    const root = makeTemp(prefix)\n    const dir = path.join(root, 'work')\n    fs.mkdirSync(dir)\n    return {\n        dir,\n        env:isolatedEnv(root),\n        remove:() => fs.rmSync(root, { recursive:true, force:true }),\n    }\n}\n\n// A temporary Git repository at `dir` (realpath, so it compares equal to\n// what Git prints).\nexport function tempRepo (prefix = 'roast-repo-'):TempDir {\n    const t = tempDir(prefix)\n    execFileSync('git', ['init', '-q', t.dir], { env:t.env })\n    return t\n}\n// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\n// The trust record (spec 03, 2.5, 2.6, 5.3) in a temporary Git repository.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempRepo, tempDir } from '../helpers/repo.js'\nimport {\n    approve,\n    isApproved,\n    stateDir,\n    trustPath,\n} from '../../src/trust/trust.js'\n\nconst H1 = 'sha256:' + '1'.repeat(64)\nconst H2 = 'sha256:' + '2'.repeat(64)\n\nfunction repo (t:CleanupTest) {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n    return { ...r, file, opts:{ env:r.env } }\n}\n\nfunction readJson (file:string):unknown {\n    return JSON.parse(fs.readFileSync(file, 'utf8'))\n}\n\nasync function rejects (p:Promise<unknown>):Promise<Error|undefined> {\n    try {\n        await p\n    } catch (err) {\n        return err as Error\n    }\n    return undefined\n}\n\ntest('trust record lives in the Git common directory', async t => {\n    const r = repo(t)\n    const sub = path.join(r.dir, 'a')\n    fs.mkdirSync(sub)\n    t.equal(await stateDir(sub, r.opts), path.join(r.dir, '.git', 'roast'),\n        'state dir')\n    t.equal(await trustPath(r.dir, r.opts), r.file, 'trust path')\n    const outside = tempDir()\n    t.cleanup(outside.remove)\n    t.ok(await rejects(trustPath(outside.dir, { env:outside.env })),\n        'outside a repository throws')\n})\n\ntest('absent record is not approved; approve writes version 2',\n    async t => {\n        const r = repo(t)\n        t.equal(await isApproved(r.dir, H1, r.opts), 'not-approved',\n            'not approved')\n        t.ok(!fs.existsSync(path.dirname(r.file)), 'nothing created')\n        await approve(r.dir, H1, r.opts)\n        t.deepEqual(readJson(r.file), { version:2, approved:[H1] },\n            'version 2 with one hash')\n        t.equal(fs.statSync(r.file).mode & 0o777, 0o600, 'mode 0600')\n        t.equal(await isApproved(r.dir, H1, r.opts), 'approved', 'approved')\n        t.equal(await isApproved(r.dir, H2, r.opts), 'not-approved',\n65:export function resolveRole (\n93:export function resolveFinderFlip (\n157:export function isPlaceholderModel (model:string):boolean {\n163:export function validateEndpoint (\n202:export function validateRole (name:string, role:ResolvedRole):void {\nsrc/cli/config.ts:25:export const configHooks:{\nsrc/cli/config.ts:77:    const stored = configHooks.storedCredentials?.(ctx)","is_error":false}]},"parent_tool_use_id":null,"session_id":"d2b2ffa6-15d5-4c22-b042-75e0dc4ef2c9","uuid":"4845c8bf-ae90-4def-b659-0b368b823796","timestamp":"2026-11-18T20:38:25.785Z","tool_use_result":{"stdout":"// Temporary directories and Git repositories for CLI tests, with an\n// environment that isolates the user's home and config directories and\n// gives Git an identity (CI runners have none).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { cleanEnv } from