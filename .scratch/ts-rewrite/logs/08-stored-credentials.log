group or other user may access is an error, never skipped.","+export function loadCredentialsSync (file:string):Map<string, Entry> {","+    let fd:number","+    try {","+        fd = fs.openSync(file, 'r')","+    } catch (err) {","+        if (isCode(err, 'ENOENT')) return new Map()","+        throw new Error(`read credentials: ${message(err)}`, { cause:err })","+    }","+    let text:string","+    try {","+        const perm = fs.fstatSync(fd).mode & 0o777","+        if ((perm & 0o077) !== 0) {","+            throw new Error(`credentials file ${file} is readable by ` +","+                `other users (mode ${permString(perm)}); run ` +","+                `\\`chmod 600 ${file}\\``)","+        }","+        try {","+            text = fs.readFileSync(fd, 'utf8')","+        } catch (err) {","+            throw new Error(`read credentials: ${message(err)}`,","+                { cause:err })","+        }","+    } finally {","+        fs.closeSync(fd)","+    }","+    try {","+        return decode(text)","+    } catch (err) {","+        throw new Error(`credentials file ${file}: ${message(err)}`)","+    }","+}","+","+export async function loadCredentials (","+    file:string","+):Promise<Map<string, Entry>> {","+    return loadCredentialsSync(file)","+}"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01YKnduZvWrCcx1vhkDbntzY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
