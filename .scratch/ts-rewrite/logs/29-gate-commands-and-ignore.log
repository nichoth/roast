{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChB13qukNzhK873EqTUrV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Kq7193gwaKtGUie91ATC8s","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-29-gate-commands-and-ignore/test/cli/gate.ts","content":"// `roast gate enable|disable|status` (spec 12, 2.4 to 2.10), driven\n// through the in-process CLI in isolated temp repositories.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport { runRoast } from '../helpers/run.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport {\n    gateRepo,\n    localConfig,\n    modeOf,\n    read,\n    type GateRepo,\n} from '../gate/helpers.js'\n\n// The shipped script, read from disk as the independent source of truth.\nconst SCRIPT = fs.readFileSync(\n    path.join(ROOT, 'internal', 'gate', 'pre-commit.sh'), 'utf8')\n\nfunction gate (r:GateRepo, ...args:string[]) {\n    return runRoast(['gate', ...args], { cwd:r.dir, env:r.env })\n}\n\ntest('gate enable installs an executable hook and records consent',\n    async t => {\n        const r = gateRepo(t)\n        const res = await gate(r, 'enable')\n        t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n        t.equal(read(r.hook), SCRIPT, 'the hook is the shipped script')\n        t.equal(modeOf(r.hook), 0o755, 'mode 0755')\n        t.equal(localConfig(r, 'roast.gate'), 'enabled', 'records enabled')\n    })\n\ntest('gate enable without a toplevel config is a usage error', async t => {\n    const r = gateRepo(t, false)\n    const sub = path.join(r.dir, 'sub')\n    fs.mkdirSync(sub)\n    fs.writeFileSync(path.join(sub, '.roast.json'), '{\"version\": 1}')\n    for (const cwd of [r.dir, sub]) {\n        const res = await runRoast(['gate', 'enable'], { cwd, env:r.env })\n        t.equal(res.code, 2, 'exits 2')\n        t.ok(!fs.existsSync(r.hook), 'writes no hook')\n        t.equal(localConfig(r, 'roast.gate'), '', 'records nothing')\n    }\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":696,"cache_read_input_tokens":136016,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":696},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"776ac9e1-0ccd-4600-8cd0-2b17f1742875","uuid":"6f7c59bd-6a39-411c-8c9b-ad78b81e6eda","timestamp":"2026-11-18T20:11:03.164Z","request_id":"req_011ChB13qgbVRZQAwHsnTick","wire_tool_inputs":{"toolu_01Kq7193gwaKtGUie91ATC8s":{"file_path":"/Users/nick/code/roast.ts-rewrite-29-gate-commands-and-ignore/test/cli/gate.ts","content":"// `roast gate enable|disable|status` (spec 12, 2.4 to 2.10), driven\n// through the in-process CLI in isolated temp repositories.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport { runRoast } from '../helpers/run.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport {\n    gateRepo,\n    localConfig,\n    modeOf,\n    read,\n    type GateRepo,\n} from '../gate/helpers.js'\n\n// The shipped script, read from disk as the independent source of truth.\nconst SCRIPT = fs.readFileSync(\n    path.join(ROOT, 'internal', 'gate', 'pre-commit.sh'), 'utf8')\n\nfunction gate (r:GateRepo, ...args:string[]) {\n    return runRoast(['gate', ...args], { cwd:r.dir, env:r.env })\n}\n\ntest('gate enable installs an executable hook and records consent',\n    async t => {\n        const r = gateRepo(t)\n        const res = await gate(r, 'enable')\n        t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n        t.equal(read(r.hook), SCRIPT, 'the hook is the shipped script')\n        t.equal(modeOf(r.hook), 0o755, 'mode 0755')\n        t.equal(localConfig(r, 'roast.gate'), 'enabled', 'records enabled')\n    })\n\ntest('gate enable without a toplevel config is a usage error', async t => {\n    const r = gateRepo(t, false)\n    const sub = path.join(r.dir, 'sub')\n    fs.mkdirSync(sub)\n    fs.writeFileSync(path.join(sub, '.roast.json'), '{\"version\": 1}')\n    for (const cwd of [r.dir, sub]) {\n        const res = await runRoast(['gate', 'enable'], { cwd, env:r.env })\n        t.equal(res.code, 2, 'exits 2')\n        t.ok(!fs.existsSync(r.hook), 'writes no hook')\n        t.equal(localConfig(r, 'roast.gate'), '', 'records nothing')\n    }\n})\n"}}}
