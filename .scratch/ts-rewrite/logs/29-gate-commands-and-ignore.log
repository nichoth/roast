"+    t.equal(read(r.sidecar), SCRIPT, 'sidecar for the manual line')","+","+    const s = gateRepo(t)","+    const target = path.join(scratch(t), 'husky-hook')","+    const shell = '#!/bin/sh\\nnpx lint-staged\\n'","+    writeHook(target, shell)","+    fs.mkdirSync(path.dirname(s.hook), { recursive:true })","+    fs.symlinkSync(target, s.hook)","+    res = await gate(s, 'enable')","+    t.equal(res.code, 0, 'symlinked enable exits 0')","+    t.ok(fs.lstatSync(s.hook).isSymbolicLink(), 'still a symlink')","+    t.equal(fs.readlinkSync(s.hook), target, 'same link target')","+    t.equal(read(target), shell, 'target untouched')","+    t.equal(localConfig(s, 'roast.gate'), 'enabled', 'consent recorded')","+})","+","+test('gate disable removes only what Roast wrote', async t => {","+    // Own hook: deleted.","+    const own = gateRepo(t)","+    await gate(own, 'enable')","+    let res = await gate(own, 'disable')","+    t.equal(res.code, 0, 'exits 0')","+    t.ok(!fs.existsSync(own.hook), 'own hook deleted')","+    t.equal(localConfig(own, 'roast.gate'), 'declined', 'records declined')","+","+    // Appended: only the block goes, and the sidecar with it.","+    const app = gateRepo(t)","+    const foreign = '#!/bin/sh\\r\\n# theirs\\nmake lint\\nexit 0'","+    writeHook(app.hook, foreign, 0o750)","+    await gate(app, 'enable')","+    t.ok(read(app.hook).includes(INVOKE), 'block appended first')","+    res = await gate(app, 'disable')","+    t.equal(res.code, 0, 'exits 0')","+    t.equal(read(app.hook), foreign, 'remainder byte-identical')","+    t.equal(modeOf(app.hook), 0o750, 'mode kept')","+    t.ok(!fs.existsSync(app.sidecar), 'owned sidecar removed')","+","+    // Untouched foreign hook: left alone.","+    const other = gateRepo(t)","+    writeHook(other.hook, '#!/bin/sh\\nmake lint\\n')","+    res = await gate(other, 'disable')","+    t.equal(res.code, 0, 'exits 0')","+    t.equal(read(other.hook), '#!/bin/sh\\nmake lint\\n', 'foreign kept')","+    t.equal(localConfig(other, 'roast.gate'), 'declined', 'declined')","+})","+","+test('ownership is anchored', async t => {","+    const cases = {","+        'marker text mid-file':","+            '#!/bin/sh\\necho \"#!/bin/sh\"\\n# roast-gate-hook: v1\\nmake\\n',","+        'begin without end':","+            `#!/bin/sh\\n${BEGIN}\\n${INVOKE}\\nmake lint\\n`,","+        'marker pair without invocation':","+            `#!/bin/sh\\n${BEGIN}\\n# gone\\n${END}\\nmake lint\\n`,","+    }","+    for (const [name, body] of Object.entries(cases)) {","+        const r = gateRepo(t)","+        writeHook(r.hook, body)","+        const res = await gate(r, 'disable')","+        t.equal(res.code, 0, `${name}: disable exits 0`)","+        t.equal(read(r.hook), body, `${name}: never stripped or deleted`)","+    }","+})","+","+test('a foreign file at the sidecar path is never clobbered', async t => {","+    const r = gateRepo(t)","+    const theirs = '#!/bin/sh\\n# their own roast-pre-commit\\n'","+    writeHook(r.sidecar, theirs)","+    writeHook(r.hook, '#!/bin/sh\\nmake lint\\n')","+    const res = await gate(r, 'enable')","+    t.equal(res.code, 4, 'enable fails rather than overwrite')","+    t.equal(read(r.sidecar), theirs, 'sidecar untouched by enable')","+    t.equal(read(r.hook), '#!/bin/sh\\nmake lint\\n', 'hook untouched')","+","+    const off = await gate(r, 'disable')","+    t.equal(off.code, 0, 'disable exits 0')","+    t.equal(read(r.sidecar), theirs, 'sidecar untouched by disable')","+})","+","+test('hook writes do not follow planted temp symlinks', async t => {","+    const r = gateRepo(t)","+    git(r.dir, r.env, 'config', 'core.hooksPath', '.githooks')","+    const hooks = path.join(r.dir, '.githooks')","+    fs.mkdirSync(hooks)","+    const victim = path.join(scratch(t), 'precious')","+    fs.writeFileSync(victim, 'do not touch\\n')","+    fs.symlinkSync(victim, path.join(hooks, 'pre-commit.roast-tmp'))","+    for (let i = 0; i < 16; i++) {","+        fs.symlinkSync(victim,","+            path.join(hooks, `.pre-commit.roast-${i.toString(16)}`))","+    }","+    const res = await gate(r, 'enable')","+    t.equal(res.code, 0, `exits 0 ${res.stderr}`)","+    t.equal(read(victim), 'do not touch\\n', 'victim untouched')","+    t.equal(read(path.join(hooks, 'pre-commit')), SCRIPT, 'hook written')","+})","+","+test('core.hooksPath is honoured', async t => {","+    const r = gateRepo(t)","+    git(r.dir, r.env, 'config', 'core.hooksPath', 'custom-hooks')","+    const res = await gate(r, 'enable')","+    t.equal(res.code, 0, 'exits 0')","+    t.equal(read(path.join(r.dir, 'custom-hooks', 'pre-commit')), SCRIPT,","+        'hook written under core.hooksPath')","+    t.ok(!fs.existsSync(r.hook), 'not in .git/hooks')","+})","+","+test('gate status prints three lines and never mutates', async t => {","+    const r = gateRepo(t)","+    for (const step of [[], ['enable'], ['disable']]) {","+        if (step.length) await gate(r, ...step)","+        const before = localConfig(r, 'roast.gate')","+        const hook = fs.existsSync(r.hook) ? read(r.hook) : ''","+        const res = await gate(r, 'status')","+        t.equal(res.code, 0, 'exits 0')","+        t.equal(res.stdout.trimEnd().split('\\n').length, 3, 'three lines')","+        t.equal(localConfig(r, 'roast.gate'), before, 'no decision change')","+        t.equal(fs.existsSync(r.hook) ? read(r.hook) : '', hook,","+            'hook unchanged')","+    }","+})","+","+test('gate subcommand arguments', async t => {","+    const r = gateRepo(t)","+    for (const sub of ['enable', 'disable', 'status']) {","+        const res = await gate(r, sub, 'extra')","+        t.equal(res.code, 2, `${sub} with an extra argument exits 2`)","+    }","+    t.ok(!fs.existsSync(r.hook), 'nothing installed')","+    const bare = await gate(r)","+    t.equal(bare.code, 0, 'bare gate exits 0')","+    const outside = scratch(t)","+    for (const sub of ['enable', 'disable', 'status']) {","+        const res = await runRoast(['gate', sub],","+            { cwd:outside, env:r.env })","+        t.equal(res.code, 2, `${sub} outside a repository exits 2`)","+    }","+})"]}],"originalFile":"// `roast gate enable|disable|status` (spec 12, 2.4 to 2.10), driven\n// through the in-process CLI in isolated temp repositories.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport { runRoast } from '../helpers/run.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport {\n    gateRepo,\n    localConfig,\n    modeOf,\n    read,\n    type GateRepo,\n} from '../gate/helpers.js'\n\n// The shipped script, read from disk as the independent source of truth.\nconst SCRIPT = fs.readFileSync(\n    path.join(ROOT, 'internal', 'gate', 'pre-commit.sh'), 'utf8')\n\nfunction gate (r:GateRepo, ...args:string[]) {\n    return runRoast(['gate', ...args], { cwd:r.dir, env:r.env })\n}\n\ntest('gate enable installs an executable hook and records consent',\n    async t => {\n        const r = gateRepo(t)\n        const res = await gate(r, 'enable')\n        t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n        t.equal(read(r.hook), SCRIPT, 'the hook is the shipped script')\n        t.equal(modeOf(r.hook), 0o755, 'mode 0755')\n        t.equal(localConfig(r, 'roast.gate'), 'enabled', 'records enabled')\n    })\n\ntest('gate enable without a toplevel config is a usage error', async t => {\n    const r = gateRepo(t, false)\n    const sub = path.join(r.dir, 'sub')\n    fs.mkdirSync(sub)\n    fs.writeFileSync(path.join(sub, '.roast.json'), '{\"version\": 1}')\n    for (const cwd of [r.dir, sub]) {\n        const res = await runRoast(['gate', 'enable'], { cwd, env:r.env })\n        t.equal(res.code, 2, 'exits 2')\n        t.ok(!fs.existsSync(r.hook), 'writes no hook')\n        t.equal(localConfig(r, 'roast.gate'), '', 'records nothing')\n    }\n})\n","userModified":false},"tool_result_meta":[{"id":"toolu_017Jo8jrwCMzFgmH2vopdtVW","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
