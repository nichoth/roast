DERR) {\n            t.ok(out.includes(extra.STUB_STDERR), `${name}: stderr shown`)\n        }\n    }\n})\n\ntest('a missing project roast allows the commit', async t => {\n    const r = seededRepo(t)\n    await enable(t, r)\n    // A roast on PATH must never stand in for the project one.\n    const bin = scratch(t)\n    const onPath = newStub(t, bin)\n    fs.renameSync(projectRoast(bin), path.join(bin, 'roast'))\n    const { ok } = commit(r, onPath, {\n        PATH:`${bin}:${r.env.PATH ?? ''}`,\n        STUB_EXIT:'1',\n        STUB_STDOUT:BLOCKING,\n    })\n    t.ok(ok, 'commit allowed')\n    t.equal(onPath.ran(), '', 'no roast from PATH ran')\n})\n\ntest('failing gate settings allow the commit without a review',\n    async t => {\n        const r = seededRepo(t)\n        await enable(t, r)\n        const s = newStub(t, r.dir)\n        const { ok, out } = commit(r, s, {\n            STUB_SETTINGS_EXIT:'2',\n            STUB_SETTINGS_STDERR:'MARKER-no-config',\n            STUB_EXIT:'1',\n            STUB_STDOUT:BLOCKING,\n        })\n        t.ok(ok, 'commit allowed')\n        t.ok(out.includes('MARKER-no-config'), 'settings stderr shown')\n        t.equal(s.ran(), '', 'no review ran')\n    })\n\ntest('severity comes from gate settings, not the environment',\n    async t => {\n        const r = seededRepo(t)\n        await enable(t, r)\n        const s = newStub(t, r.dir)\n        const { ok } = commit(r, s, {\n            STUB_STDOUT:CLEAN,\n            STUB_SEVERITY:'MEDIUM',\n            ROAST_GATE_SEVERITY:'CRITICAL',\n        })\n        t.ok(ok, 'commit succeeds')\n        t.ok(logLine(s.ran(), 'ARGS: ').includes('--max-severity MEDIUM'),\n            'the review threshold is the settings severity')\n    })\n\nif (!SKIP_SLOW) {\n    test('a review past the timeout allows the commit', async t => {\n        const r = seededRepo(t)\n        await enable(t, r)\n        const s = newStub(t, r.dir)\n        const started = Date.now()\n        const { ok } = commit(r, s, {\n            STUB_SLEEP:'10',\n            STUB_STDOUT:BLOCKING,\n            STUB_EXIT:'1',\n            STUB_TIMEOUT:'1',\n        })\n        t.ok(ok, 'commit allowed')\n        t.ok(Date.now() - started < 9000, 'the review was cut short')\n    })\n\n    test('the timeout comes from gate settings, not the environment',\n        async t => {\n            const r = seededRepo(t)\n            await enable(t, r)\n            const s = newStub(t, r.dir)\n            const { ok } = commit(r, s, {\n                STUB_SLEEP:'3',\n                STUB_STDOUT:BLOCKING,\n                STUB_EXIT:'1',\n                STUB_TIMEOUT:'0',\n                ROAST_GATE_TIMEOUT:'1',\n            })\n            t.ok(!ok, 'the review ran to completion and blocked')\n        })\n}\n\ntest('the appended block runs alongside a foreign hook', async t => {\n    const r = seededRepo(t)\n    const marker = path.join(scratch(t), 'foreign-ran')\n    writeHook(r.hook, `#!/bin/sh\\ntouch \"${marker}\"\\n`)\n    await enable(t, r)\n    const s = newStub(t, r.dir)\n\n    let res = commit(r, s, {\n        STUB_STDOUT:BLOCKING,\n        STUB_STDERR:'MARKER-R-deadbe',\n        STUB_EXIT:'1',\n    })\n    t.ok(!res.ok, 'blocking review fails the commit')\n    t.ok(res.out.includes('MARKER-R-deadbe'), 'findings shown')\n\n    res = commit(r, s, { STUB_STDOUT:CLEAN })\n    t.ok(res.ok, `clean review commits ${res.out}`)\n    t.ok(fs.existsSync(marker), 'the foreign hook ran too')\n})\n\ntest('the block runs in a foreign hook that exits early', async t => {\n    const r = seededRepo(t)\n    writeHook(r.hook, '#!/bin/sh\\nexit 0\\n')\n    await enable(t, r)\n    const s = newStub(t, r.dir)\n    const { ok } = commit(r, s, { STUB_STDOUT:BLOCKING, STUB_EXIT:'1' })\n    t.ok(!ok, 'commit blocked')\n    t.ok(s.ran() !== '', 'the review ran')\n})\n\ntest('a non-executable hook does not run', async t => {\n    const r = seededRepo(t)\n    writeHook(r.hook, '#!/bin/sh\\nmake lint\\n')\n    await enable(t, r)\n    fs.chmodSync(r.hook, 0o644)\n    const status = await runRoast(['gate', 'status'],\n        { cwd:r.dir, env:r.env })\n    t.equal(status.code, 0, 'status exits 0')\n    const s = newStub(t, r.dir)\n    const { ok } = commit(r, s, { STUB_EXIT:'1' })\n    t.ok(ok, 'commit succeeds')\n    t.equal(s.ran(), '', 'git skipped the hook')\n})\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018D15CFeaTaXuern7xo4yFz","type":"tool_result","content":"File created successfully at: /Users/nick/code/roast.ts-rewrite-29-gate-commands-and-ignore/test/gate/exec.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"776ac9e1-0ccd-4600-8cd0-2b17f1742875","uuid":"0b9f1076-34f4-4d79-9edd-c6757d240ed2","timestamp":"2026-11-18T20:15:19.041Z","tool_use_result":{"type":"create","filePath":"/Users/nick/code/roast.ts-rewrite-29-gate-commands-and-ignore/test/gate/exec.ts","content":"// The installed hook driven through a real `git commit` (spec 12, 5,\n// \"Hook execution\"), with a shell stub at node_modules/.bin/roast so no\n// model is called. The hook is installed with `roast gate enable`, so\n// these prove the TS install path writes a working hook.\n//\n// ROAST_TEST_SKIP_GATE_TIMEOUT=1 skips the tests that sleep.\nimport { spawnSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { runRoast } from '../helpers/run.js'\nimport {\n    gateRepo,\n    git,\n    scratch,\n    writeHook,\n    type GateRepo,\n} from './helpers.js'\n\n// Ported verbatim from internal/gate/hook_exec_test.go.\nconst STUB_SCRIPT = `#!/bin/sh\nif [ \"$1 $2\" = \"gate settings\" ]; then\n  if [ -n \"\\${STUB_SETTINGS_STDERR:-}\" ]; then\n    printf '%s\\\\n' \"$STUB_SETTINGS_STDERR\" >&2\n  fi\n  printf 'timeout_seconds=%s\\\\nseverity=%s\\\\n' \\\\\n    \"\\${STUB_TIMEOUT:-180}\" \"\\${STUB_SEVERITY:-HIGH}\"\n  exit \"\\${STUB_SETTINGS_EXIT:-0}\"\nfi\n{\n  echo \"ARGS: $*\"\n  echo \"NAMES: $(git -C \"$(pwd)\" diff --cached --name-only HEAD | tr '\\\\n' ' ')\"\n  echo \"DIFF-START\"\n  git -C \"$(pwd)\" diff --cached HEAD\n  echo \"DIFF-END\"\n} >> \"$STUB_LOG\"\nif [ -n \"\\${STUB_SLEEP:-}\" ]; then sleep \"$STUB_SLEEP\"; fi\nif [ -n \"\\${STUB_STDOUT:-}\" ]; then printf '%s\\\\n' \"$STUB_STDOUT\"; fi\nif [ -n \"\\${STUB_STDERR:-}\" ]; then printf '%s\\\\n' \"$STUB_STDERR\" >&2; fi\nexit \"\\${STUB_EXIT:-0}\"\n`\n\nconst SKIP_SLOW = process.env.ROAST_TEST_SKIP_GATE_TIMEOUT === '1'\n\nconst CLEAN = '{\"findings\":[]}'\nconst BLOCKING = '{\"findings\":[{\"severity\":\"HIGH\"}]}'\n\ninterface Stub {\n    log:string;\n    // The stub's observations, '' when no review ran.\n    ran ():string;\n}\n\nfunction projectRoast (repo:string):string {\n    return path.join(repo, 'node_modules', '.bin', 'roast')\n}\n\n// Installs the stub as the project roast in each repo, one shared log.\nfunction newStub (t:CleanupTest, ...repos:string[]):Stub {\n    const log = path.join(scratch(t), 'scope.log')\n    for (const r of repos) writeHook(projectRoast(r), STUB_SCRIPT, 0o755)\n    return {\n        log,\n        ran:() => fs.existsSync(log) ? fs.readFileSync(log, 'utf8') : '',\n    }\n}\n\n// A repo with a.txt and b.txt committed, both modified, a.txt staged,\n// and the gate consented to. The hook is not installed yet.\nfunction seededRepo (t:CleanupTest):GateRepo {\n    const r = gateRepo(t)\n    fs.writeFileSync(path.join(r.dir, 'a.txt'), 'a-committed\\n')\n    fs.writeFileSync(path.join(r.dir, 'b.txt'), 'b-committed\\n')\n    // Keep the stub and config out of the commits.\n    fs.writeFileSync(path.join(r.dir, '.git', 'info', 'exclude'),\n        'node_modules/\\n.roast.json\\n')\n    git(r.dir, r.env, 'add', '-A')\n    git(r.dir, r.env, 'commit', '-qm', 'seed')\n    fs.writeFileSync(path.join(r.dir, 'a.txt'), 'a-STAGED-NOT-COMMITTED\\n')\n    fs.writeFileSync(path.join(r.dir, 'b.txt'), 'b-IN-THIS-COMMIT\\n')\n    git(r.dir, r.env, 'add', 'a.txt')\n    git(r.dir, r.env, 'config', '--local', 'roast.gate', 'enabled')\n    return r\n}\n\nasync function enable (t:CleanupTest, r:GateRepo):Promise<void> {\n    const res = await runRoast(['gate', 'enable'], { cwd:r.dir, env:r.env })\n    t.equal(res.code, 0, `gate enable exits 0 ${res.stderr}`)\n}\n\n// A real path-scoped commit of b.txt.\nfunction commit (\n    r:GateRepo,\n    s:Stub,\n    extra:Record<string, string> = {}\n):{ ok:boolean, out:string } {\n    const res = spawnSync('git',\n        ['-C', r.dir, 'commit', 'b.txt', '-m', 'scoped'], {\n            env:{ ...r.env, STUB_LOG:s.log, ...extra },\n            encoding:'utf8',\n        })\n    return { ok:res.status === 0, out:res.stdout + res.stderr }\n}\n\nfunction logLine (seen:string, prefix:string):string {\n    const line = seen.split('\\n').find(l => l.startsWith(prefix))\n    return line === undefined ? '' : line.slice(prefix.length).trim()\n}\n\ntest('the gate reviews only the path-scoped commit content', async t => {\n    const r = seededRepo(t)\n    await enable(t, r)\n    const s = newStub(t, r.dir)\n    const { ok, out } = commit(r, s, { STUB_STDOUT:CLEAN })\n    t.ok(ok, `commit succeeds ${out}`)\n    const seen = s.ran()\n    t.equal(logLine(seen, 'NAMES: '), 'b.txt', 'scope is exactly b.txt')\n    t.ok(seen.includes('b-IN-THIS-COMMIT'), 'sees the committed content')\n    t.ok(!seen.includes('a-STAGED-NOT-COMMITTED'),\n        'does not see staged content outside the commit')\n    t.equal(git(r.dir, r.env, 'diff', '--cached', '--name-only'), 'a.txt',\n        'a.txt is still staged')\n})\n\ntest('findings block the commit and reach the user', async t => {\n    const r = seededRepo(t)\n    await enable(t, r)\n    const s = newStub(t, r.dir)\n    const { ok, out } = commit(r, s, {\n        STUB_STDOUT:BLOCKING,\n        STUB_STDERR:'MARKER-R-abc123',\n        STUB_EXIT:'1',\n    })\n    t.ok(!ok, 'commit blocked')\n    t.ok(out.includes('MARKER-R-abc123'), 'the stub stderr is shown')\n    t.equal(git(r.dir, r.env, 'rev-list', '--count', 'HEAD'), '1',\n        'nothing committed')\n})\n\ntest('ROAST_SKIP bypasses the gate entirely', async t => {\n    const r = seededRepo(t)\n    await enable(t, r)\n    const s = newStub(t, r.dir)\n    const { ok } = commit(r, s, { ROAST_SKIP:'1', STUB_EXIT:'1' })\n    t.ok(ok, 'commit succeeds')\n    t.equal(s.ran(), '', 'no review ran')\n})\n\ntest('operational failures allow the commit', async t => {\n    const cases:[string, Record<string, string>][] = [\n        ['empty stdout, exit 0', { STUB_EXIT:'0' }],\n        ['empty stdout, exit 3', { STUB_EXIT:'3' }],\n        ['exit 4', {\n            STUB_STDOUT:CLEAN, STUB_STDERR:'MARKER-unreachable',\n            STUB_EXIT:'4',\n        }],\n        ['exit 2', {\n            STUB_STDERR:'MARKER-untrusted', STUB_EXIT:'2',\n        }],\n    ]\n    for (const [name, extra] of cases) {\n        const r = seededRepo(t)\n        await enable(t, r)\n        const s = newStub(t, r.dir)\n        const { ok, out } = commit(r, s, extra)\n        t.ok(ok, `${name}: commit allowed`)\n        t.ok(s.ran() !== '', `${name}: the review ran`)\n        if (extra.STUB_STDERR) {\n            t.ok(out.includes(extra.STUB_STDERR), `${name}: stderr shown`)\n        }\n    }\n})\n\ntest('a missing project roast allows the commit', async t => {\n    const r = seededRepo(t)\n    await enable(t, r)\n    // A roast on PATH must never stand in for the project one.\n    const bin = scratch(t)\n    const onPath = newStub(t, bin)\n    fs.renameSync(projectRoast(bin), path.join(bin, 'roast'))\n    const { ok } = commit(r, onPath, {\n        PATH:`${bin}:${r.env.PATH ?? ''}`,\n        STUB_EXIT:'1',\n        STUB_STDOUT:BLOCKING,\n    })\n    t.ok(ok, 'commit allowed')\n    t.equal(onPath.ran(), '', 'no roast from PATH ran')\n})\n\ntest('failing gate settings allow the commit without a review',\n    async t => {\n        const r = seededRepo(t)\n        await enable(t, r)\n        const s = newStub(t, r.dir)\n        const { ok, out } = commit(r, s, {\n            STUB_SETTINGS_EXIT:'2',\n            STUB_SETTINGS_STDERR:'MARKER-no-config',\n            STUB_EXIT:'1',\n            STUB_STDOUT:BLOCKING,\n        })\n        t.ok(ok, 'commit allowed')\n        t.ok(out.includes('MARKER-no-config'), 'settings stderr shown')\n        t.equal(s.ran(), '', 'no review ran')\n    })\n\ntest('severity comes from gate settings, not the environment',\n    async t => {\n        const r = seededRepo(t)\n        await enable(t, r)\n        const s = newStub(t, r.dir)\n        const { ok } = commit(r, s, {\n            STUB_STDOUT:CLEAN,\n            STUB_SEVERITY:'MEDIUM',\n            ROAST_GATE_SEVERITY:'CRITICAL',\n        })\n        t.ok(ok, 'commit succeeds')\n        t.ok(logLine(s.ran(), 'ARGS: ').includes('--max-severity MEDIUM'),\n            'the review threshold is the settings severity')\n    })\n\nif (!SKIP_SLOW) {\n    test('a review past the timeout allows the commit', async t => {\n        const r = seededRepo(t)\n        await enable(t, r)\n        const s = newStub(t, r.dir)\n        const started = Date.now()\n        const { ok } = commit(r, s, {\n            STUB_SLEEP:'10',\n            STUB_STDOUT:BLOCKING,\n            STUB_EXIT:'1',\n            STUB_TIMEOUT:'1',\n        })\n        t.ok(ok, 'commit allowed')\n        t.ok(Date.now() - started < 9000, 'the review was cut short')\n    })\n\n    test('the timeout comes from gate settings, not the environment',\n        async t => {\n            const r = seededRepo(t)\n            await enable(t, r)\n            const s = newStub(t, r.dir)\n            const { ok } = commit(r, s, {\n                STUB_SLEEP:'3',\n                STUB_STDOUT:BLOCKING,\n                STUB_EXIT:'1',\n                STUB_TIMEOUT:'0',\n                ROAST_GATE_TIMEOUT:'1',\n            })\n            t.ok(!ok, 'the review ran to completion and blocked')\n        })\n}\n\ntest('the appended block runs alongside a foreign hook', async t => {\n    const r = seededRepo(t)\n    const marker = path.join(scratch(t), 'foreign-ran')\n    writeHook(r.hook, `#!/bin/sh\\ntouch \"${marker}\"\\n`)\n    await enable(t, r)\n    const s = newStub(t, r.dir)\n\n    let res = commit(r, s, {\n        STUB_STDOUT:BLOCKING,\n        STUB_STDERR:'MARKER-R-deadbe',\n        STUB_EXIT:'1',\n    })\n    t.ok(!res.ok, 'blocking review fails the commit')\n    t.ok(res.out.includes('MARKER-R-deadbe'), 'findings shown')\n\n    res = commit(r, s, { STUB_STDOUT:CLEAN })\n    t.ok(res.ok, `clean review commits ${res.out}`)\n    t.ok(fs.existsSync(marker), 'the foreign hook ran too')\n})\n\ntest('the block runs in a foreign hook that exits early', async t => {\n    const r = seededRepo(t)\n    writeHook(r.hook, '#!/bin/sh\\nexit 0\\n')\n    await enable(t, r)\n    const s = newStub(t, r.dir)\n    const { ok } = commit(r, s, { STUB_STDOUT:BLOCKING, STUB_EXIT:'1' })\n    t.ok(!ok, 'commit blocked')\n    t.ok(s.ran() !== '', 'the review ran')\n})\n\ntest('a non-executable hook does not run', async t => {\n    const r = seededRepo(t)\n    writeHook(r.hook, '#!/bin/sh\\nmake lint\\n')\n    await enable(t, r)\n    fs.chmodSync(r.hook, 0o644)\n    const status = await runRoast(['gate', 'status'],\n        { cwd:r.dir, env:r.env })\n    t.equal(status.code, 0, 'status exits 0')\n    const s = newStub(t, r.dir)\n    const { ok } = commit(r, s, { STUB_EXIT:'1' })\n    t.ok(ok, 'commit succeeds')\n    t.equal(s.ran(), '', 'git skipped the hook')\n})\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_018D15CFeaTaXuern7xo4yFz","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
