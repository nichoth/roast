{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T8AjUYpwgSgA6hVwc2HTTE","type":"tool_result","content":"package cli\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/spf13/cobra\"\n\n\t\"github.com/bluesky-social/roast/internal/gate\"\n\t\"github.com/bluesky-social/roast/internal/scope\"\n)\n\nfunc newGateCommand(stdout io.Writer) *cobra.Command {\n\tcmd := &cobra.Command{\n\t\tUse: \"gate\", Short: \"Manage the native Git pre-commit review gate\",\n\t\tLong: \"The gate reviews exactly the staged commit. Findings at HIGH or above block; operational failures fail open with a warning.\",\n\t\tArgs: noArgs, SilenceUsage: true, SilenceErrors: true, RunE: showHelp,\n\t}\n\tcmd.AddCommand(newGateStatusCommand(stdout), newGateEnableCommand(stdout), newGateDisableCommand(stdout),\n\t\tnewGateSettingsCommand(stdout))\n\treturn cmd\n}\n\n// Gate defaults, used when the project config leaves a setting unset.\nconst (\n\tdefaultGateTimeoutSeconds = 180\n\tdefaultGateSeverity       = \"HIGH\"\n)\n\n// newGateSettingsCommand prints the project config's gate settings as\n// key=value lines for the pre-commit hook, which runs the project-installed\n// binary so the settings come from the same Roast version as the review.\nfunc newGateSettingsCommand(stdout io.Writer) *cobra.Command {\n\tvar configPath string\n\tcmd := &cobra.Command{\n\t\tUse: \"settings\", Short: \"Print the gate settings the pre-commit hook uses\",\n\t\tArgs: noArgs, Hidden: true, SilenceUsage: true, SilenceErrors: true,\n\t\tRunE: func(_ *cobra.Command, _ []string) error {\n\t\t\tcfg, err := loadProjectConfig(configPath)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\ttimeout := defaultGateTimeoutSeconds\n\t\t\tif cfg.Gate.TimeoutSeconds != nil {\n\t\t\t\ttimeout = *cfg.Gate.TimeoutSeconds\n\t\t\t}\n\t\t\tseverity := defaultGateSeverity\n\t\t\tif cfg.Gate.Severity != \"\" {\n\t\t\t\tseverity = strings.ToUpper(cfg.Gate.Severity)\n\t\t\t}\n\t\t\tfmt.Fprintf(stdout, \"timeout_seconds=%d\\nseverity=%s\\n\",\n\t\t\t\ttimeout, severity)\n\t\t\treturn nil\n\t\t},\n\t}\n\tcmd.Flags().StringVar(&configPath, \"config\", \"\",\n\t\t\"project config file (default: nearest .roast.json)\")\n\treturn cmd\n}\n\nfunc newGateStatusCommand(stdout io.Writer) *cobra.Command {\n\treturn &cobra.Command{\n\t\tUse: \"status\", Short: \"Report gate status for this repository\", Args: noArgs,\n\t\tSilenceUsage: true, SilenceErrors: true,\n\t\tRunE: func(_ *cobra.Command, _ []string) error {\n\t\t\trepo, err := scope.GitRoot(\".\")\n\t\t\tif err != nil {\n\t\t\t\treturn &usageError{msg: \"not inside a Git repository\"}\n\t\t\t}\n\t\t\tstatus, err := gate.Inspect(repo)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tdecision := string(status.Decision)\n\t\t\tif decision == \"\" {\n\t\t\t\tdecision = \"none recorded\"\n\t\t\t}\n\t\t\tfmt.Fprintf(stdout, \"repo:     %s\\ngate:     %s\\ndecision: %s\\n\", status.Repo, status.Summary(), decision)\n\t\t\treturn nil\n\t\t},\n\t}\n}\n\nfunc newGateEnableCommand(stdout io.Writer) *cobra.Command {\n\treturn &cobra.Command{\n\t\tUse: \"enable\", Short: \"Install the pre-commit gate in this repository\", Args: noArgs,\n\t\tSilenceUsage: true, SilenceErrors: true,\n\t\tRunE: func(_ *cobra.Command, _ []string) error {\n\t\t\trepo, err := scope.GitRoot(\".\")\n\t\t\tif err != nil {\n\t\t\t\treturn &usageError{msg: \"not inside a Git repository\"}\n\t\t\t}\n\t\t\tpath, err := gateConfigPath(repo)\n\t\t\tif err != nil {\n\t\t\t\treturn &usageError{msg: err.Error()}\n\t\t\t}\n\t\t\tif path == \"\" {\n\t\t\t\treturn errNoGateConfig\n\t\t\t}\n\t\t\taction, status, err := gate.Install(repo)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif err := gate.RecordDecision(repo, gate.DecisionEnabled); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif action == gate.ActionManual {\n\t\t\t\tfmt.Fprintf(stdout, \"%s is not an appendable shell script; Roast left it untouched.\\nAdd this line manually:\\n\\n    %s\\n\", status.HookPath, gate.ManualLine())\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\tswitch action {\n\t\t\tcase gate.ActionInstalled:\n\t\t\t\tfmt.Fprintf(stdout, \"gate installed: %s\\n\", status.HookPath)\n\t\t\tcase gate.ActionAppended:\n\t\t\t\tfmt.Fprintf(stdout, \"gate appended to existing hook: %s\\n\", status.HookPath)\n\t\t\tcase gate.ActionRefreshed:\n\t\t\t\tfmt.Fprintf(stdout, \"gate refreshed: %s\\n\", status.HookPath)\n\t\t\tcase gate.ActionUpToDate:\n\t\t\t\tfmt.Fprintf(stdout, \"gate already up to date: %s\\n\", status.HookPath)\n\t\t\t}\n\t\t\tfmt.Fprintln(stdout, \"bypass one commit with: ROAST_SKIP=1 git commit ...\")\n\t\t\treturn nil\n\t\t},\n\t}\n}\n\nfunc newGateDisableCommand(stdout io.Writer) *cobra.Command {\n\treturn &cobra.Command{\n\t\tUse: \"disable\", Short: \"Disable the Roast pre-commit gate in this repository\", Args: noArgs,\n\t\tSilenceUsage: true, SilenceErrors: true,\n\t\tRunE: func(_ *cobra.Command, _ []string) error {\n\t\t\trepo, err := scope.GitRoot(\".\")\n\t\t\tif err != nil {\n\t\t\t\treturn &usageError{msg: \"not inside a Git repository\"}\n\t\t\t}\n\t\t\taction, status, err := gate.Remove(repo)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif err := gate.RecordDecision(repo, gate.DecisionDeclined); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif action == gate.ActionRemoved {\n\t\t\t\tfmt.Fprintf(stdout, \"gate removed from %s\\n\", status.HookPath)\n\t\t\t} else if action == gate.ActionPreserved {\n\t\t\t\tfmt.Fprintf(stdout, \"gate disabled for this repository; shared dispatcher preserved at %s\\n\", status.HookPath)\n\t\t\t} else {\n\t\t\t\tfmt.Fprintln(stdout, \"no Roast gate was installed; recorded the decline\")\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t}\n}\npackage cli\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/spf13/cobra\"\n\n\t\"github.com/bluesky-social/roast/internal/record\"\n\t\"github.com/bluesky-social/roast/internal/scope\"\n)\n\n// stateIgnoreEntry is the toplevel .gitignore line for Roast's project-local\n// state directory.\nconst stateIgnoreEntry = \"/\" + record.StateDir + \"/\"\n\nfunc newIgnoreCommand(stdout io.Writer) *cobra.Command {\n\treturn &cobra.Command{\n\t\tUse:   \"ignore\",\n\t\tShort: \"Add \" + stateIgnoreEntry + \" to the toplevel .gitignore\",\n\t\tArgs:  noArgs, SilenceUsage: true, SilenceErrors: true,\n\t\tRunE: func(_ *cobra.Command, _ []string) error {\n\t\t\trepo, err := scope.GitRoot(\".\")\n\t\t\tif err != nil {\n\t\t\t\treturn &usageError{msg: err.Error()}\n\t\t\t}\n\t\t\tpath, added, err := ensureStateIgnored(repo)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif added {\n\t\t\t\tfmt.Fprintf(stdout, \"added %s to %s\\n\", stateIgnoreEntry, path)\n\t\t\t} else {\n\t\t\t\tfmt.Fprintf(stdout, \"%s already ignores %s\\n\",\n\t\t\t\t\tpath, stateIgnoreEntry)\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t}\n}\n\n// ensureStateIgnored appends stateIgnoreEntry to repo/.gitignore unless an\n// equivalent entry is already present. It creates the file when missing and\n// terminates an unterminated last line before appending. It reports the\n// file's path and whether it changed the file.\nfunc ensureStateIgnored(repo string) (string, bool, error) {\n\tpath := filepath.Join(repo, \".gitignore\")\n\tdata, err := os.ReadFile(path)\n\tif err != nil && !os.IsNotExist(err) {\n\t\treturn path, false, fmt.Errorf(\"read %s: %w\", path, err)\n\t}\n\tif ignoresState(string(data)) {\n\t\treturn path, false, nil\n\t}\n\taddition := stateIgnoreEntry + \"\\n\"\n\tif len(data) > 0 && data[len(data)-1] != '\\n' {\n\t\taddition = \"\\n\" + addition\n\t}\n\tfile, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)\n\tif err != nil {\n\t\treturn path, false, fmt.Errorf(\"open %s: %w\", path, err)\n\t}\n\tif _, err := file.WriteString(addition); err != nil {\n\t\t_ = file.Close()\n\t\treturn path, false, fmt.Errorf(\"append %s: %w\", path, err)\n\t}\n\tif err := file.Close(); err != nil {\n\t\treturn path, false, fmt.Errorf(\"close %s: %w\", path, err)\n\t}\n\treturn path, true, nil\n}\n\n// ignoresState reports whether a .gitignore body already has a line that\n// ignores the toplevel state directory: the anchored or unanchored name,\n// with or without a trailing slash.\nfunc ignoresState(body string) bool {\n\tname := record.StateDir\n\tfor line := range strings.Lines(body) {\n\t\tswitch strings.TrimSpace(line) {\n\t\tcase \"/\" + name + \"/\", \"/\" + name, name + \"/\", name:\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/bluesky-social/roast/internal/gate\"\n)\n\nfunc TestGateCommandsKeepSharedDispatcher(t *testing.T) {\n\tt.Setenv(\"GIT_CONFIG_GLOBAL\", os.DevNull)\n\tt.Setenv(\"GIT_CONFIG_SYSTEM\", os.DevNull)\n\tt.Setenv(\"GIT_CONFIG_NOSYSTEM\", \"1\")\n\trepo, hooks := t.TempDir(), t.TempDir()\n\tfor _, args := range [][]string{{\"init\", \"-q\"}, {\"config\", \"core.hooksPath\", hooks}} {\n\t\tif out, err := exec.Command(\"git\", append([]string{\"-C\", repo}, args...)...).CombinedOutput(); err != nil {\n\t\t\tt.Fatalf(\"git setup: %v, %s\", err, out)\n\t\t}\n\t}\n\twriteFile(t, filepath.Join(repo, \".roast.json\"),\n\t\tprojectConfig(\"https://gw.example\", \"m\"))\n\tt.Chdir(repo)\n\tvar stdout, stderr bytes.Buffer\n\tfor _, command := range []string{\"enable\", \"disable\"} {\n\t\tstdout.Reset()\n\t\tcode, err := ExecuteContext(t.Context(), []string{\"gate\", command}, &stdout, &stderr)\n\t\tif err != nil || code != ExitClean {\n\t\t\tt.Fatalf(\"%s code=%d err=%v stdout=%s stderr=%s\", command, code, err, stdout.String(), stderr.String())\n\t\t}\n\t}\n\tif !strings.Contains(stdout.String(), \"shared dispatcher preserved\") {\n\t\tt.Fatalf(\"disable output = %q\", stdout.String())\n\t}\n\tstatus, err := gate.Inspect(repo)\n\tif err != nil || status.Decision != gate.DecisionDeclined || status.Active() || !status.Ours {\n\t\tt.Fatalf(\"disabled shared status = %#v, %v\", status, err)\n\t}\n\tif _, err := os.Stat(filepath.Join(hooks, gate.HookName)); err != nil {\n\t\tt.Fatal(\"shared dispatcher removed:\", err)\n\t}\n}\n\nfunc TestManualGateEnableRecordsConsent(t *testing.T) {\n\tt.Setenv(\"GIT_CONFIG_GLOBAL\", os.DevNull)\n\tt.Setenv(\"GIT_CONFIG_SYSTEM\", os.DevNull)\n\tt.Setenv(\"GIT_CONFIG_NOSYSTEM\", \"1\")\n\trepo := t.TempDir()\n\tif out, err := exec.Command(\"git\", \"-C\", repo, \"init\", \"-q\").CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git setup: %v, %s\", err, out)\n\t}\n\thook := filepath.Join(repo, \".git\", \"hooks\", gate.HookName)\n\tconst foreign = \"#!/usr/bin/env python3\\nprint('foreign hook')\\n\"\n\tif err := os.WriteFile(hook, []byte(foreign), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\twriteFile(t, filepath.Join(repo, \".roast.json\"),\n\t\tprojectConfig(\"https://gw.example\", \"m\"))\n\tt.Chdir(repo)\n\tvar stdout, stderr bytes.Buffer\n\tcode, err := ExecuteContext(t.Context(), []string{\"gate\", \"enable\"}, &stdout, &stderr)\n\tif err != nil || code != ExitClean || !strings.Contains(stdout.String(), \"manually\") {\n\t\tt.Fatalf(\"enable code=%d err=%v stdout=%s stderr=%s\", code, err, stdout.String(), stderr.String())\n\t}\n\tstatus, err := gate.Inspect(repo)\n\tif err != nil || status.Decision != gate.DecisionEnabled || !status.Foreign {\n\t\tt.Fatalf(\"manual gate status = %#v, %v\", status, err)\n\t}\n\tif body, err := os.ReadFile(hook); err != nil || string(body) != foreign {\n\t\tt.Fatalf(\"foreign hook was modified: %v\", err)\n\t}\n}\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\nfunc runIgnore(t *testing.T) {\n\tt.Helper()\n\tvar stdout, stderr bytes.Buffer\n\tcode, err := ExecuteContext(t.Context(), []string{\"ignore\"},\n\t\t&stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"ignore code=%d err=%v stderr=%s\", code, err, stderr.String())\n