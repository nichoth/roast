ler,\n        },\n        {\n            command:'enable',\n            describe:'Install the pre-commit gate in this repository',\n            handler:enableHandler,\n        },\n        {\n            command:'disable',\n            describe:'Disable the Roast pre-commit gate in this repository',\n            handler:disableHandler,\n        },\n        settingsCommand,\n    ],\n}\"\"\")\nopen(p,'w').write(s)\nEOF\nnode .redeye/one.ts test/cli/gate.ts 2>&1 | tail -6"}},"wire_ingest_context":{"toolu_016pLaLfJKP4UJYwEiCRFrrb":{"cwd":"/Users/nick/code/roast.ts-rewrite-29-gate-commands-and-ignore"}}}
