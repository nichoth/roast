ing subdirectory\")\n\t}\n}\n\nfunc TestIgnoreAppendsToExistingGitignore(t *testing.T) {\n\tfor name, test := range map[string]struct{ before, after string }{\n\t\t\"trailing newline\": {\n\t\t\tbefore: \"node_modules/\\n\",\n\t\t\tafter:  \"node_modules/\\n/.roast/\\n\",\n\t\t},\n\t\t\"no trailing newline\": {\n\t\t\tbefore: \"node_modules/\\ndist\",\n\t\t\tafter:  \"node_modules/\\ndist\\n/.roast/\\n\",\n\t\t},\n\t\t\"empty\": {before: \"\", after: \"/.roast/\\n\"},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01T8AjUYpwgSgA6hVwc2HTTE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
