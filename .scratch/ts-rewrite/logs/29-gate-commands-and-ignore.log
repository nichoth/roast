egression for roast\n539-// finding R-742ef8: the markers are public comment text, so a copy-pasted\n540-// pair with no gate invocation between them is not roast's block.\n541-func TestMarkerPairWithoutInvocationIsForeign(t *testing.T) {\n542-\trepo := newRepo(t)\n543-\thook := filepath.Join(repo, \".git\", \"hooks\", \"pre-commit\")\n544-\tforeign := \"#!/bin/sh\\n\" + appendBegin + \"\\n# we deleted roast's line\\n\" + appendEnd + \"\\nmake lint\\n\"\n545-\twriteHook(t, hook, foreign, 0o755)\n546-\n547-\tst, err := Inspect(repo)\n548-\tif err != nil {\n549-\t\tt.Fatal(err)\n550-\t}\n551-\tif st.Appended {\n552-\t\tt.Fatalf(\"a marker pair with no invocation read as roast's block: %+v\", st)\n553-\t}\n554-\tif action, _, err := Remove(repo); err != nil || action != ActionNothing {\n555-\t\tt.Fatalf(\"remove = %q (%v), want %q\", action, err, ActionNothing)\n556-\t}\n557-\tif read(t, hook) != foreign {\n558-\t\tt.Error(\"disable deleted a region of a foreign hook\")\n559-\t}\n560-}\n561-\n562-func TestDecisionRoundTrip(t *testing.T) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01UiTqEBiJ5nT2WPmQAEhMsH","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
