{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DApPnz8GADVJgAEyPn5sts","type":"tool_result","content":"// The one git runner. Every area runs git through here; scope and context\n// add their specialized wrappers (patch capping, streaming) on top.\n\nimport { spawn } from 'node:child_process'\n\nexport class GitError extends Error {\n    exitCode:number|null\n    stderr:string\n\n    constructor (exitCode:number|null, signal:string|null, stderr:string) {\n        const status = exitCode === null ?\n            `signal: ${signal}` :\n            `exit status ${exitCode}`\n        const detail = stderr.trim()\n        super(detail ? `${status}: ${detail}` : status)\n        this.name = 'GitError'\n        this.exitCode = exitCode\n        this.stderr = stderr\n    }\n}\n\nexport interface GitRunOpts {\n    // Kills the child on abort; the call rejects with the signal's reason.\n    signal?:AbortSignal;\n    // The environment git runs with, normally the CLI context's env. Only\n    // when absent is process.env used.\n    env?:NodeJS.ProcessEnv;\n    // Variables merged over `env`.\n    extraEnv?:Record<string, string>;\n    // Written to stdin, which is then closed.\n    input?:Buffer|string;\n}\n\n// How long a child gets after SIGTERM before SIGKILL.\nconst KILL_GRACE_MS = 1000\n\ninterface Exit {\n    code:number|null;\n    signal:string|null;\n    stdout:Buffer;\n    stderr:Buffer;\n}\n\nfunction runGit (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts\n):Promise<Exit> {\n    const { signal } = opts\n    return new Promise((resolve, reject) => {\n        if (signal?.aborted) {\n            reject(signal.reason)\n            return\n        }\n        const env = { ...(opts.env ?? process.env), ...opts.extraEnv }\n        const child = spawn('git', ['-C', repo, ...args], {\n            env,\n            stdio:['pipe', 'pipe', 'pipe'],\n        })\n        const out:Buffer[] = []\n        const err:Buffer[] = []\n        let killTimer:NodeJS.Timeout|undefined\n        let spawnError:Error|undefined\n\n        function onAbort ():void {\n            child.kill('SIGTERM')\n            killTimer = setTimeout(() => child.kill('SIGKILL'),\n                KILL_GRACE_MS)\n        }\n        signal?.addEventListener('abort', onAbort, { once:true })\n\n        child.stdout.on('data', (chunk:Buffer) => out.push(chunk))\n        child.stderr.on('data', (chunk:Buffer) => err.push(chunk))\n        child.on('error', e => { spawnError ??= e })\n        // A child that exits without reading stdin closes the pipe; that\n        // EPIPE is not a git failure.\n        child.stdin.on('error', () => {})\n        if (opts.input !== undefined) child.stdin.end(opts.input)\n        else child.stdin.end()\n\n        child.on('close', (code, sig) => {\n            clearTimeout(killTimer)\n            signal?.removeEventListener('abort', onAbort)\n            if (signal?.aborted) {\n                reject(signal.reason)\n            } else if (spawnError) {\n                reject(spawnError)\n            } else {\n                resolve({\n                    code,\n                    signal:sig,\n                    stdout:Buffer.concat(out),\n                    stderr:Buffer.concat(err),\n                })\n            }\n        })\n    })\n}\n\n// Runs `git -C <repo> <args>` and resolves stdout. A non-zero exit\n// rejects with a GitError.\nexport async function git (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<Buffer> {\n    const exit = await runGit(repo, args, opts)\n    if (exit.code !== 0) {\n        throw new GitError(exit.code, exit.signal, exit.stderr.toString())\n    }\n    return exit.stdout\n}\n\n// Exit status only: false on a non-zero exit. Rejects only on abort or\n// when git cannot be started.\nexport async function gitOk (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<boolean> {\nsrc/config/provider.ts:7:export const DEFAULT_OPENAI_BASE_URL = 'https://api.openai.com/v1'\nsrc/config/provider.ts:8:export const DEFAULT_ANTHROPIC_BASE_URL = 'https://api.anthropic.com/v1'\nsrc/config/provider.ts:9:export const OPENROUTER_BASE_URL = 'https://openrouter.ai/api/v1'\nsrc/config/provider.ts:11:export type Protocol = 'chat'|'responses'|'anthropic'\nsrc/config/provider.ts:12:export type LoginMethod = 'paste'|'browser'\nsrc/config/provider.ts:14:export interface BuiltinProvider {\nsrc/config/provider.ts:61:export function builtinProviders ():BuiltinProvider[] {\nsrc/config/provider.ts:66:export function lookupProvider (name:string):BuiltinProvider|undefined {\nsrc/config/provider.ts:72:export function providerAt (\nsrc/config/provider.ts:84:export function defaultBaseURL (protocol:string):string {\nsrc/config/provider.ts:94:export function parseEndpoint (s:string):URL|null {\nsrc/config/provider.ts:121:export function sameEndpoint (a:string, b:string):boolean {\nsrc/textsafe/textsafe.ts:116:export function text (s:string):string {\nsrc/textsafe/textsafe.ts:122:export function line (s:string):string {\nsrc/textsafe/textsafe.ts:128:export function textBytes (b:Uint8Array):string {\nsrc/textsafe/textsafe.ts:133:export function lineBytes (b:Uint8Array):string {\nsrc/config/load.ts:26:export type { StoredCredentials }\nsrc/config/load.ts:28:export const PROJECT_CONFIG_NAME = '.roast.json'\nsrc/config/load.ts:32:export class ConfigError extends Error {\nsrc/config/load.ts:57:export function findConfig (start:string, stop:string):string {\nsrc/config/load.ts:84:export const CURRENT_VERSION = 1\nsrc/config/load.ts:85:export const DEFAULT_MAX_OUTPUT_TOKENS = 32768\nsrc/config/load.ts:86:export const DEFAULT_CONFIDENCE_FLOOR = 0.6\nsrc/config/load.ts:87:export const DEFAULT_QUICK_CONFIDENCE_FLOOR = 0.8\nsrc/config/load.ts:90:export interface NormalizedProfile extends RawProfile {\nsrc/config/load.ts:95:export interface NormalizedLimits extends Omit<\nsrc/config/load.ts:102:export interface NormalizedConfig extends Omit<\nsrc/config/load.ts:114:export interface ProjectConfig extends NormalizedConfig {\nsrc/config/load.ts:283:export function decode (text:string):RawConfig {\nsrc/config/load.ts:455:export function normalize (raw:RawConfig, dir:string):ProjectConfig {\nsrc/config/load.ts:497:export function loadConfig (file:string):ProjectConfig {\nsrc/config/load.ts:515:export function withStoredCredentials (\nsrc/config/load.ts:524:export function promptPath (cfg:ProjectConfig, p:string):string {\nsrc/config/load.ts:530:export function credentialEnvNames (cfg:ProjectConfig):string[] {\nsrc/config/load.ts:536:export function snapshotEnabled (cfg:ProjectConfig):boolean {\nsrc/config/load.ts:540:export function gateOffers (cfg:ProjectConfig):boolean {\n// `roast ignore` (spec 12, 2.13): adds the run-record state directory to\n// the toplevel .gitignore. `init` reuses ensureStateIgnored.\nimport fs from 'node:fs/promises'\nimport path from 'node:path'\nimport { gitRoot } from '../git/git.js'\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport type { CommandArgs, CommandDef, RunContext } from './command.js'\nimport { UsageError } from './errors.js'\n\n// Roast's project-local state directory at the Git toplevel.\nconst STATE_DIR = '.roast'\n\nexport const STATE_IGNORE_ENTRY = `/${STATE_DIR}/`\n\n// Lines that already ignore the toplevel state directory.\nconst EQUIVALENT = new Set([\n    `/${STATE_DIR}/`, `/${STATE_DIR}`, `${STATE_DIR}/`, STATE_DIR,\n])\n\nfunction fail (text:string, err:unknown):Error {\n    const msg = err instanceof Error ? err.message : String(err)\n    return new Error(`${text}: ${msg}`, { cause:err })\n}\n\n// Appends STATE_IGNORE_ENTRY to <repo>/.gitignore unless an equivalent\n// line is present, creating the file and terminating an unterminated last\n// line first. Reports the path and whether the file changed.\nexport async function ensureStateIgnored (\n    repo:string\n):Promise<{ path:string, added:boolean }> {\n    const file = path.join(repo, '.gitignore')\n    let data = Buffer.alloc(0)\n    try {\n        data = await fs.readFile(file)\n    } catch (err) {\n        if ((err as NodeJS.ErrnoException).code !== 'ENOENT') {\n            throw fail(`read ${file}`, err)\n        }\n    }\n    const lines = data.toString('utf8').split('\\n')\n    if (lines.some(line => EQUIVALENT.has(goTrimSpace(line)))) {\n        return { path:file, added:false }\n    }\n    let addition = `${STATE_IGNORE_ENTRY}\\n`\n    if (data.length > 0 && data[data.length - 1] !== 0x0a) {\n        addition = '\\n' + addition\n    }\n    let handle:fs.FileHandle\n    try {\n        handle = await fs.open(file, 'a', 0o644)\n    } catch (err) {\n        throw fail(`open ${file}`, err)\n    }\n    try {\n        await handle.write(addition)\n    } catch (err) {\n        await handle.close().catch(() => {})\n        throw fail(`append ${file}`, err)\n    }\n    try {\n        await handle.close()\n    } catch (err) {\n        throw fail(`close ${file}`, err)\n    }\n    return { path:file, added:true }\n}\n\nasync function ignoreHandler (\n    _args:CommandArgs,\n    ctx:RunContext\n):Promise<void> {\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        const msg = err instanceof Error ? err.message : String(err)\n        throw new UsageError(msg, { cause:err })\n    }\n    const { path:file, added } = await ensureStateIgnored(repo)\n    ctx.stdout.write(added ?\n        `added ${STATE_IGNORE_ENTRY} to ${file}\\n` :\n        `${file} already ignores ${STATE_IGNORE_ENTRY}\\n`)\n}\n\nexport const ignoreCommand:CommandDef = {\n    command:'ignore',\n    describe:`Add ${STATE_IGNORE_ENTRY} to the toplevel .gitignore`,\n    handler:ignoreHandler,\n}\n// `roast ignore` (spec 12, 2.13): /.roast/ in the toplevel .gitignore.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport { runRoast } from '../helpers/run.js'\nimport { gateRepo, read, scratch, type GateRepo } from '../gate/helpers.js'\n\nfunction ignore (r:GateRepo, cwd = r.dir) {\n    return runRoast(['ignore'], { cwd, env:r.env })\n}\n\ntest('ignore creates the toplevel .gitignore', async t => {\n    const r = gateRepo(t, false)\n    const sub = path.join(r.dir, 'a', 'b')\n    fs.mkdirSync(sub, { recursive:true })\n    const res = await ignore(r, sub)\n    t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n    t.equal(read(path.join(r.dir, '.gitignore')), '/.roast/\\n', 'created')\n    t.equal((fs.statSync(path.join(r.dir, '.gitignore')).mode & 0o777) &\n        0o644, 0o644, 'readable by everyone')\n    t.ok(!fs.existsSync(path.join(sub, '.gitignore')), 'not in the subdir')\n})\n\ntest('ignore appends to an existing .gitignore', async t => {\n    const cases:[string, string][] = [\n        ['node_modules/\\n', 'node_modules/\\n/.roast/\\n'],\n        ['node_modules/\\ndist', 'node_modules/\\ndist\\n/.roast/\\n'],\n        ['', '/.roast/\\n'],\n    ]\n    for (const [before, after] of cases) {\n        const r = gateRepo(t, false)\n        const file = path.join(r.dir, '.gitignore')\n        fs.writeFileSync(file, before)\n        const res = await ignore(r)\n        t.equal(res.code, 0, 'exits 0')\n        t.equal(read(file), after, `${JSON.stringify(before)} appended`)\n    }\n})\n\ntest('ignore leaves an equivalent entry unchanged', async t => {\n    for (const entry of ['/.roast/', '/.roast', '.roast/', '.roast',\n        '  .roast/  ']) {\n        const r = gateRepo(t, false)\n        const file = path.join(r.dir, '.gitignore')\n        const body = `dist\\n${entry}\\nnode_modules`\n        fs.writeFileSync(file, body)\n        const res = await ignore(r)\n        t.equal(res.code, 0, 'exits 0')\n        t.equal(read(file), body, `${JSON.stringify(entry)} kept as is`)\n    }\n})\n\ntest('