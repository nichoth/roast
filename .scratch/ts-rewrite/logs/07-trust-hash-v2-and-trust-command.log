{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JpL5dngiEnYHqzmiLLuJqm","type":"tool_result","content":"1\t// The trust projection (ADR-0001) and approval hash v2 (ADR-0003, spec\n2\t// 03 sections 2.2 to 2.4). Pure: no I/O.\n3\timport type { NormalizedProfile, ProjectConfig } from './load.js'\n4\timport { defaultBaseURL, providerAt } from './provider.js'\n5\t\n6\t// One profile a role or author route selects, reduced to where requests\n7\t// go, how, and which variable supplies the credential.\n8\texport interface TrustedProfile {\n9\t    // \"roles.finder\" or \"roles.finder.author_routes.<family>\".\n10\t    selector:string;\n11\t    profile:string;\n12\t    // The endpoint as configured, or the protocol default; not normalized.\n13\t    endpoint:string;\n14\t    protocol:string;\n15\t    // The profile's credential variable; '' when none applies.\n16\t    credentialEnv:string;\n17\t}\n18\t\n19\texport interface PromptOverride {\n20\t    // \"prompts.finder_code\", \"prompts.finder_prose\", or \"prompts.verifier\".\n21\t    name:string;\n22\t    // The raw string from the config, unresolved.\n23\t    path:string;\n24\t}\n25\t\n26\texport interface TrustProjection {\n27\t    profiles:TrustedProfile[];\n28\t    promptOverrides:PromptOverride[];\n29\t}\n30\t\n31\texport interface HashDocument {\n32\t    destinations:{\n33\t        credential_env:string;\n34\t        endpoint:string;\n35\t        protocol:string;\n36\t    }[];\n37\t    prompts:{ name:string, path:string }[];\n38\t}\n39\t\n40\tconst PROMPT_NAMES = ['finder_code', 'finder_prose', 'verifier'] as const\n41\t\n42\tfunction byCodeUnits (a:string, b:string):number {\n43\t    return a < b ? -1 : a > b ? 1 : 0\n44\t}\n45\t"}]},"parent_tool_use_id":null,"session_id":"29c699d6-6603-42f0-a998-14114bd781a8","uuid":"b33d47fd-cc50-4f1e-9b25-ce8908420fdd","timestamp":"2026-11-18T20:30:39.757Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.ts-rewrite-07-trust-hash-v2-and-trust-command/src/config/trust.ts","content":"// The trust projection (ADR-0001) and approval hash v2 (ADR-0003, spec\n// 03 sections 2.2 to 2.4). Pure: no I/O.\nimport type { NormalizedProfile, ProjectConfig } from './load.js'\nimport { defaultBaseURL, providerAt } from './provider.js'\n\n// One profile a role or author route selects, reduced to where requests\n// go, how, and which variable supplies the credential.\nexport interface TrustedProfile {\n    // \"roles.finder\" or \"roles.finder.author_routes.<family>\".\n    selector:string;\n    profile:string;\n    // The endpoint as configured, or the protocol default; not normalized.\n    endpoint:string;\n    protocol:string;\n    // The profile's credential variable; '' when none applies.\n    credentialEnv:string;\n}\n\nexport interface PromptOverride {\n    // \"prompts.finder_code\", \"prompts.finder_prose\", or \"prompts.verifier\".\n    name:string;\n    // The raw string from the config, unresolved.\n    path:string;\n}\n\nexport interface TrustProjection {\n    profiles:TrustedProfile[];\n    promptOverrides:PromptOverride[];\n}\n\nexport interface HashDocument {\n    destinations:{\n        credential_env:string;\n        endpoint:string;\n        protocol:string;\n    }[];\n    prompts:{ name:string, path:string }[];\n}\n\nconst PROMPT_NAMES = ['finder_code', 'finder_prose', 'verifier'] as const\n\nfunction byCodeUnits (a:string, b:string):number {\n    return a < b ? -1 : a > b ? 1 : 0\n}\n","numLines":45,"startLine":1,"totalLines":98}},"tool_result_meta":[{"id":"toolu_01JpL5dngiEnYHqzmiLLuJqm","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
