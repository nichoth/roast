\n    profile:Record<string, unknown>,\n    env:Env,\n    store?:StoredCredentials\n):ResolvedRole {\n    return resolveRole(finderConfig(profile, store), 'finder', env)\n}\n\n// Answers lookups from fixed maps, project scope first, as the real\n// credentials store does; records every provider asked for.\nexport class FakeStore implements StoredCredentials {\n    lookups:string[] = []\n    constructor (\n        readonly project:Record<string, string> = {},\n        readonly user:Record<string, string> = {},\n        readonly err?:Error\n    ) {}\n\n    lookup (provider:string):{ key:string, scope:'project'|'user' }|null {\n        this.lookups.push(provider)\n        if (this.err) throw this.err\n        if (Object.hasOwn(this.project, provider)) {\n            return { key:this.project[provider], scope:'project' }\n        }\n        if (Object.hasOwn(this.user, provider)) {\n            return { key:this.user[provider], scope:'user' }\n        }\n        return null\n    }\n}\n\n// A project and a user key for every built-in provider.\nexport function bothStored ():FakeStore {\n    const project:Record<string, string> = {}\n    const user:Record<string, string> = {}\n    for (const name of ['openai', 'anthropic', 'openrouter']) {\n        project[name] = `project-${name}`\n        user[name] = `user-${name}`\n    }\n    return new FakeStore(project, user)\n}\n\n// The error `fn` throws, or undefined.\nexport function thrown (fn:() => unknown):Error|undefined {\n    try {\n        fn()\n    } catch (err) {\n        return err as Error\n    }\n    return undefined\n}\n25:test('promptYesDefault answers', async t => {\n46:test('consecutive prompts share one LineReader', async t => {\n61:test('promptYesDefault then readSecret on one reader', async t => {\n70:test('readSecret on a TTY reads raw without echo', async t => {\n82:test('readSecret on a TTY treats Ctrl-C as cancellation', async t => {\n99:test('default interactiveTerminals rejects non-file streams', t => {\n// Temporary directories and Git repositories for CLI tests, with an\n// environment that isolates the user's home and config directories and\n// gives Git an identity (CI runners have none).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { cleanEnv } from './env.js'\n\nexport interface TempDir {\n    dir:string;\n    env:Record<string, string>;\n    remove ():void;\n}\n\nfunction makeTemp (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\n// The base test environment: the process env without provider or roast\n// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside\n// `root`, a Git identity, and no Git discovery above `root`.\nexport function isolatedEnv (root:string):Record<string, string> {\n    const home = path.join(root, '.home')\n    fs.mkdirSync(home, { recursive:true })\n    return {\n        ...cleanEnv(process.env),\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n        GIT_AUTHOR_NAME:'Roast Test',\n        GIT_AUTHOR_EMAIL:'roast-test@example.com',\n        GIT_COMMITTER_NAME:'Roast Test',\n        GIT_COMMITTER_EMAIL:'roast-test@example.com',\n        GIT_CEILING_DIRECTORIES:path.dirname(root),\n        GIT_CONFIG_NOSYSTEM:'1',\n    }\n}\n\n// A temporary directory that is not inside any Git repository. The test\n// working directory is `dir/work`.\nexport function tempDir (prefix = 'roast-dir-'):TempDir {\n    const root = makeTemp(prefix)\n    const dir = path.join(root, 'work')\n    fs.mkdirSync(dir)\n    return {\n        dir,\n        env:isolatedEnv(root),\n        remove:() => fs.rmSync(root, { recursive:true, force:true }),\n    }\n}\n\n// A temporary Git repository at `dir` (realpath, so it compares equal to\n// what Git prints).\nexport function tempRepo (prefix = 'roast-repo-'):TempDir {\n    const t = tempDir(prefix)\n    execFileSync('git', ['init', '-q', t.dir], { env:t.env })\n    return t\n}\n// Copies of the registry, in registry order.\nexport function builtinProviders ():BuiltinProvider[] {\n    return REGISTRY.map(copy)\n}\n\n// The provider with exactly this name (case-sensitive).\nexport function lookupProvider (name:string):BuiltinProvider|undefined {\n    const p = REGISTRY.find(p => p.name === name)\n    return p && copy(p)\n}\n\n// The provider that accepts `protocol` at `endpoint`.\nexport function providerAt (\n    endpoint:string,\n    protocol:string\n):BuiltinProvider|undefined {\n    const p = REGISTRY.find(p =>\n        (p.protocols as readonly string[]).includes(protocol) &&\n        sameEndpoint(p.endpoint, endpoint))\n    return p && copy(p)\n}\n\n// The implicit endpoint of a profile that sets none. OpenRouter is never\n// one.\nexport function defaultBaseURL (protocol:string):string {\n    return protocol === 'anthropic' ?\n        DEFAULT_ANTHROPIC_BASE_URL :\n        DEFAULT_OPENAI_BASE_URL\n}\n\n// Parses an endpoint with WHATWG URL, or null when it does not parse or\n// has an empty host. WHATWG repairs `https:///v1` and `https:v1` into a\n// host; Go sees an empty one, so text after the scheme must start with\n// `//` and a non-empty authority.\nexport function parseEndpoint (s:string):URL|null {\n    const colon = s.indexOf(':')\n    if (colon < 0) return null\n    const rest = s.slice(colon + 1)\n    if (!rest.startsWith('//')) return null\n    const end = rest.slice(2).search(/[/?#]/)\n    const authority = end < 0 ? rest.slice(2) : rest.slice(2, 2 + end)\n    // Userinfo alone (`https://u@/v1`) leaves no host either.\n    if (authority.slice(authority.lastIndexOf('@') + 1) === '') return null\n    let u:URL\n    try {\n        u = new URL(s)\n    } catch {\n        return null\n    }\n    return u.host === '' ? null : u\n}\n\nfunction stripTrailingSlashes (p:string):string {\n    let end = p.length\n    while (end > 0 && p[end - 1] === '/') end--\n    return p.slice(0, end)\n}\n\n// Endpoints compare by scheme and host (case-insensitive), path without\n// trailing slashes, raw query, and userinfo. Unparseable values never\n// match.\nexport function sameEndpoint (a:string, b:string):boolean {\n    const left = parseEndpoint(goTrimSpace(a))\n    const right = parseEndpoint(goTrimSpace(b))\n    if (!left || !right) return false\n    return left.protocol === right.protocol &&\n        left.host === right.host &&\n        stripTrailingSlashes(left.pathname) ===\n            stripTrailingSlashes(right.pathname) &&\n        left.search === right.search &&\n        left.username === right.username &&\n        left.password === right.password\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HbJWSXS1y6qmEegjRjpZHA","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
