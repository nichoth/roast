 UsageError('not inside a Git repository', { cause:err })\n    }\nimport { PassThrough, Writable } from 'node:stream'\n\n// A writable that keeps everything written to it.\nexport class BufferStream extends Writable {\n    chunks:Buffer[] = []\n\n    _write (\n        chunk:Buffer|string,\n        _enc:BufferEncoding,\n        done:(err?:Error|null) => void\n    ):void {\n        this.chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk))\n        done()\n    }\n\n    text ():string {\n        return Buffer.concat(this.chunks).toString('utf8')\n    }\n}\n\n// A readable stdin fed with fixed text, then EOF.\nexport function inputStream (text = ''):NodeJS.ReadableStream {\n    const s = new PassThrough()\n    s.end(text)\n    return s\n}\n            ((b2 & 0x3f) << 6) | (b3 & 0x3f), 4]\n    }\n    return [-1, 1]\n}\n\nfunction byteUnits (b:Uint8Array):Unit[] {\n    const units:Unit[] = []\n    for (let i = 0; i < b.length;) {\n        const [cp, size] = decodeRune(b, i)\n        units.push(cp < 0 ? -(b[i] + 1) : cp)\n        i += size\n    }\n    return units\n}\n\n// Multi-line sanitizing of a string.\nexport function text (s:string):string {\n    if (isClean(s, false)) return s\n    return escapeUnits(stringUnits(s), false)\n}\n\n// Single-line sanitizing of a string.\nexport function line (s:string):string {\n    if (isClean(s, true)) return s\n    return escapeUnits(stringUnits(s), true)\n}\n\n// Multi-line sanitizing of raw bytes, escaping each invalid UTF-8 byte.\nexport function textBytes (b:Uint8Array):string {\n    return escapeUnits(byteUnits(b), false)\n}\n\n// Single-line sanitizing of raw bytes.\nexport function lineBytes (b:Uint8Array):string {\n    return escapeUnits(byteUnits(b), true)\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"29c699d6-6603-42f0-a998-14114bd781a8","uuid":"6102a5e6-b76a-4179-8525-560c4fc3c988","timestamp":"2026-11-18T20:32:40.647Z","tool_use_result":{"stdout":"// `roast gate enable|disable|status` and th