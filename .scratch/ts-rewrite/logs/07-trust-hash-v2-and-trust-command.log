    await approve(r.dir, H1, r.opts)\n    t.deepEqual(readJson(r.file), { version:2, approved:[H1] },\n        'unknown members dropped on write')\n})\nEOF\nsed -i '' \"s#^import './config/canonical.js'#import './config/canonical.js'\\nimport './trust/trust.js'#\" test/index.ts\n/tmp/roast07/t.sh test/trust/trust.ts 2>&1 | grep ERROR | head -2"}},"wire_ingest_context":{"toolu_01Bv5vYHoxJNrtbA74F3zpoU":{"cwd":"/Users/nick/code/roast.ts-rewrite-07-trust-hash-v2-and-trust-command"}}}
