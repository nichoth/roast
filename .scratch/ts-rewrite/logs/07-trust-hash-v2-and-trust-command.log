nai.com/v1\",\"protocol\":\"responses\"},' +\n        '{\"credential_env\":\"\",\"endpoint\":\"https://gw.example/v1\",' +\n        '\"protocol\":\"chat\"}],\"prompts\":[]}', 'canonical text')\n    t.equal(trustHash(p), 'sha256:7ac3826edbb00b7b8294e6117b0fa3c70fd4e994' +\n        'de107bf41a23324761252d5c', 'hash')\n})\nEOF\nsed -i '' \"s#^import './config/trust.js'#import './config/trust.js'\\nimport './config/canonical.js'#\" test/index.ts\n/tmp/roast07/t.sh test/config/canonical.ts 2>&1| grep ERROR | head -3"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":368,"cache_read_input_tokens":118725,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":368},"output_tokens":82,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"29c699d6-6603-42f0-a998-14114bd781a8","uuid":"df38594b-cce6-45d3-bffc-cd0a927252b0","timestamp":"2026-11-18T20:30:32.259Z","request_id":"req_011ChB2XvSVa7BHS54JyBJCL","wire_tool_inputs":{"toolu_012MhR7L9qHGyNGpzEAjpKN4":{"command":"cd /Users/nick/code/roast.ts-rewrite-07-trust-hash-v2-and-trust-command && cat > test/config/canonical.ts <<'EOF'\n// Trust hash v2 (spec 03, 2.4, 5.2): canonical JSON and known answers.\nimport { test } from '@substrate-system/tapzero'\nimport { canonicalJson } from '../../src/config/canonical.js'\nimport {\n    type TrustProjection,\n    trustHash,\n    trustHashDocument,\n} from '../../src/config/trust.js'\n\nfunction projection (\n    destinations:[string, string, string][],\n    prompts:[string, string][] = []\n):TrustProjection {\n    return {\n        profiles:destinations.map(([endpoint, protocol, credentialEnv], i) =>\n            ({ selector:`roles.r${i}`, profile:`p${i}`, endpoint, protocol,\n                credentialEnv })),\n        promptOve