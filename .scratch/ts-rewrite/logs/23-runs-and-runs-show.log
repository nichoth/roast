{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HAHMrUfViWeY8yKv1DPz6E","type":"tool_result","content":"// `roast ignore` (spec 12, 2.13): adds the run-record state directory to\n// the toplevel .gitignore. `init` reuses ensureStateIgnored.\nimport fs from 'node:fs/promises'\nimport path from 'node:path'\nimport { gitRoot } from '../git/git.js'\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport type { CommandArgs, CommandDef, RunContext } from './command.js'\nimport { UsageError } from './errors.js'\n\n// Roast's project-local state directory at the Git toplevel.\nconst STATE_DIR = '.roast'\n\nexport const STATE_IGNORE_ENTRY = `/${STATE_DIR}/`\n\n// Lines that already ignore the toplevel state directory.\nconst EQUIVALENT = new Set([\n    `/${STATE_DIR}/`, `/${STATE_DIR}`, `${STATE_DIR}/`, STATE_DIR,\n])\n\nfunction fail (text:string, err:unknown):Error {\n    const msg = err instanceof Error ? err.message : String(err)\n    return new Error(`${text}: ${msg}`, { cause:err })\n}\n\n// Appends STATE_IGNORE_ENTRY to <repo>/.gitignore unless an equivalent\n// line is present, creating the file and terminating an unterminated last\n// line first. Reports the path and whether the file changed.\nexport async function ensureStateIgnored (\n    repo:string\n):Promise<{ path:string, added:boolean }> {\n    const file = path.join(repo, '.gitignore')\n    let data = Buffer.alloc(0)\n    try {\n        data = await fs.readFile(file)\n    } catch (err) {\n        if ((err as NodeJS.ErrnoException).code !== 'ENOENT') {\n            throw fail(`read ${file}`, err)\n        }\n    }\n    const lines = data.toString('utf8').split('\\n')\n    if (lines.some(line => EQUIVALENT.has(goTrimSpace(line)))) {\n        return { path:file, added:false }\n    }\n    let addition = `${STATE_IGNORE_ENTRY}\\n`\n    if (data.length > 0 && data[data.length - 1] !== 0x0a) {\n        addition = '\\n' + addition\n    }\n    let handle:fs.FileHandle\n    try {\n        handle = await fs.open(file, 'a', 0o644)\n    } catch (err) {\n        throw fail(`open ${file}`, err)\n    }\n    try {\n        await handle.write(addition)\n    } catch (err) {\n        await handle.close().catch(() => {})\n        throw fail(`append ${file}`, err)\n    }\n    try {\n        await handle.close()\n    } catch (err) {\n        throw fail(`close ${file}`, err)\n    }\n    return { path:file, added:true }\n}\n\nasync function ignoreHandler (\n    _args:CommandArgs,\n    ctx:RunContext\n):Promise<void> {\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        const msg = err instanceof Error ? err.message : String(err)\n        throw new UsageError(msg, { cause:err })\n    }\n    const { path:file, added } = await ensureStateIgnored(repo)\n    ctx.stdout.write(added ?\n        `added ${STATE_IGNORE_ENTRY} to ${file}\\n` :\n        `${file} already ignores ${STATE_IGNORE_ENTRY}\\n`)\n}\n\nexport const ignoreCommand:CommandDef = {\n    command:'ignore',\n    describe:`Add ${STATE_IGNORE_ENTRY} to the toplevel .gitignore`,\n    handler:ignoreHandler,\n}\n// pattern: Imperative Shell\nimport path from 'node:path'\nimport fs from 'node:fs/promises'\nimport { git } from '../git/git.js'\nimport type { GitRunOpts } from '../git/git.js'\nimport { goTrimSpace } from '../gocompat/strings.js'\n\nexport const STATE_DIR = '.roast'\n\nexport class NoRecordDirError extends Error {\n    constructor () {\n        super('resolve record directory: run inside a Git repository')\n        this.name = 'NoRecordDirError'\n    }\n}\n\nexport function isValidName (name:string):boolean {\n    return name !== '' && name !== '.' && name !== '..' &&\n        !name.includes('/') && !name.includes('\\\\') && !name.includes('\\0')\n}\n\nexport async function ensureDir (dir:string):Promise<void> {\n    if (!dir) throw new NoRecordDirError()\n    const state = path.dirname(dir)\n    try {\n        await fs.lstat(state)\n    } catch (err) {\n        if ((err as NodeJS.ErrnoException).code !== 'ENOENT') throw err\n        await fs.mkdir(state, { recursive:true, mode:0o700 })\n        await fs.writeFile(path.join(state, '.gitignore'), '*\\n', {\n            mode:0o644,\n        })\n    }\n    await fs.mkdir(dir, { recursive:true, mode:0o700 })\n}\n\nexport async function makeRunDir (\n    dir:string,\n    runId:string\n):Promise<string> {\n    if (!isValidName(runId)) {\n        throw new Error(`invalid run id ${JSON.stringify(runId)}`)\n    }\n    await ensureDir(dir)\n    const runDir = path.join(dir, runId)\n    await fs.mkdir(runDir, { recursive:true, mode:0o700 })\n    for (const target of [dir, runDir]) await fs.chmod(target, 0o700)\n    return runDir\n}\n\nexport async function openPrivate (\n    file:string,\n    flags:string|number\n):Promise<fs.FileHandle> {\n    const handle = await fs.open(file, flags, 0o600)\n    try {\n        await handle.chmod(0o600)\n        return handle\n    } catch (err) {\n        await handle.close().catch(() => {})\n        throw err\n    }\n}\n\nexport async function writePrivate (\n    file:string,\n    data:string|Uint8Array\n):Promise<void> {\n    const handle = await openPrivate(file, 'w')\n    try {\n        await handle.writeFile(data)\n    } finally {\n        await handle.close()\n    }\n}\n\nexport async function recordDir (\n    cwd:string,\n    opts:GitRunOpts = {}\n):Promise<string> {\n    try {\n        const out = await git(cwd, ['rev-parse', '--show-toplevel'], opts)\n        const top = goTrimSpace(out.toString())\n        return top ? path.join(top, STATE_DIR, 'runs') : ''\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        return ''\n    }\n}\nsrc/record/dir.ts:8:export const STATE_DIR = '.roast'\nsrc/record/dir.ts:10:export class NoRecordDirError extends Error {\nsrc/record/dir.ts:17:exp