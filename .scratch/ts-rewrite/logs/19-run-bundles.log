// Run from the repository root: go run test/runbundle/fixtures/capture.go
package main

import (
	"archive/tar"
	"bytes"
	"os"
	"path/filepath"
	"strings"
	"time"

	"github.com/bluesky-social/roast/internal/runbundle"
)

func main() {
	dir := "test/runbundle/fixtures"
	for _, item := range []struct{ label, name, data string }{
		{"meta", "meta.json", "metadata\n"},
		{"long", strings.Repeat("a", 150), "long content"},
		{"unicode", "caf\u00e9.txt", "non-ascii\n"},
	} {
		var out bytes.Buffer
		tw := tar.NewWriter(&out)
		must(tw.WriteHeader(&tar.Header{Name: item.name, Mode: 0600,
			Size: int64(len(item.data)), ModTime: time.Unix(0, 0).UTC()}))
		_, err := tw.Write([]byte(item.data))
		must(err)
		must(tw.Close())
		must(os.WriteFile(filepath.Join(dir, item.label+".tar"), out.Bytes(), 0600))
	}
	run, err := os.MkdirTemp(dir, "capture-")
	must(err)
	defer os.RemoveAll(run)
	must(os.WriteFile(filepath.Join(run, "meta.json"), []byte("metadata\n"), 0600))
	path, _, _, err := runbundle.Build(run)
	must(err)
	data, err := os.ReadFile(path)
	must(err)
	must(os.WriteFile(filepath.Join(dir, "go-bundle.tar.zst"), data, 0600))
}
func must(err error) {
	if err != nil {
		panic(err)
	}
}
