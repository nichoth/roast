// Run bundle: build and verify deterministic .tar.zst archives of run directories.

import * as fs from 'node:fs'
import * as path from 'node:path'
import { zstdCompressSync, zstdDecompressSync } from 'node:zlib'
import type { TarFile } from './tar.js'
import { writeTar, readTar, NULL_TYPEFLAG } from './tar.js'
import { digest } from '../record/meta-json.js'
import { compareBytes } from '../gocompat/strings.js'

export const BUNDLE_FILE = 'bundle.tar.zst'
export const MANIFEST_FILE = 'bundle-manifest.json'
export const FORMAT = 'roast-run-bundle'
export const VERSION = 1

const MAX_MANIFEST_BYTES = 1 << 20 // 1 MiB
const STALE_LOCK_AGE_MS = 10 * 60 * 1000 // 10 minutes

/** A manifest entry describing one archived file. */
export interface ManifestEntry {
    path:string
    sha256:string
    size:number
}

/** The versioned, deterministic inventory embedded in a bundle. */
export interface Manifest {
    format:string
    version:number
    files:ManifestEntry[]|null
}

/** Error thrown when another process is building the bundle. */
export class BundleBuildInProgressError extends Error {
    constructor () {
        super('bundle build already in progress by another process')
    }
}

// === Build ===================================================================

/** Build a deterministic run bundle and return its path, digest, and size. */
export function buildBundle (runDir:string):{ path:string; sha256:string; size:number } {
    // Protect the run directory.
    fs.chmodSync(runDir, 0o700)

    const bundlePath = path.join(runDir, BUNDLE_FILE)

    // Check for an existing valid bundle.
    try {
        const st = fs.lstatSync(bundlePath)
        if (!st.isDirectory()) {
            if (!st.isFile()) {
                throw new Error(`existing bundle ${bundlePath} is not a regular file`)
            }
            fs.chmodSync(bundlePath, 0o600)
            verifyBundle(bundlePath)
            return { path:bundlePath, sha256:hashFile(bundlePath), size:st.size }
        }
    } catch (err:unknown) {
        if (!isEnoent(err)) throw err
    }

    // No existing bundle; build a new one.
    const tmpPath = bundlePath + '.tmp'
    acquireBundleLock(tmpPath)

    try {
        const archiveFiles = collectArchiveFiles(runDir, bundlePath)
        writeBundle(tmpPath, archiveFiles)
        fs.renameSync(tmpPath, bundlePath)
    } catch (err) {
        try { fs.unlinkSync(tmpPath) } catch { /* ignore */ }
        throw err
    }

    // Verify the newly built bundle and return.
    const st = fs.statSync(bundlePath)
    verifyBundle(bundlePath)
    return { path:bundlePath, sha256:hashFile(bundlePath), size:st.size }
}

// === Lock ====================================================================

function acquireBundleLock (tmp:string):void {
    try {
        fs.writeFileSync(tmp, '', { mode:0o600 })
        return
    } catch (err:unknown) {
        if (!(err instanceof Error) || !('code' in err && err.code === 'EEXIST')) {
            throw new Error(`create bundle lock ${tmp}: ${getErrorMessage(err)}`)
        }
        // E_EXIST means the file already exists. Check age.
    }

    let st:fs.Stats
    try {
        st = fs.statSync(tmp)
    } catch (err:unknown) {
        if (isEnoent(err)) throw new BundleBuildInProgressError()
        throw new Error(`stat bundle lock ${tmp}: ${getErrorMessage(err)}`)
    }

    const age = Date.now() - st.mtimeMs
    if (age < STALE_LOCK_AGE_MS) {
        throw new BundleBuildInProgressError()
    }

    // Stale: remove and recreate.
    try {
        fs.unlinkSync(tmp)
    } catch (err:unknown) {
        if (!isEnoent(err)) {
            throw new Error(`reclaim stale bundle lock ${tmp}: ${getErrorMessage(err)}`)
        }
        // File vanished; try creating again.
        try {
            fs.writeFileSync(tmp, '', { mode:0o600 })
            return
        } catch (err2:unknown) {
            if (isEExist(err2)) throw new BundleBuildInProgressError()
            throw err2
        }
    }

    try {
        fs.writeFileSync(tmp, '', { mode:0o600 })
    } catch (err:unknown) {
        if (isEExist(err)) throw new BundleBuildInProgressError()
        throw err
    }
}

// === File Collection =========================================================

function collectArchiveFiles (runDir:string, _bundlePath:string):TarFile[] {
    const entries = fs.readdirSync(runDir, { withFileTypes:true })

    // Sort bytewise by name.
    entries.sort((a, b) => compareBytes(a.name, b.name))

    const files:TarFile[] = []

    for (const entry of entries) {
        const name = entry.name

        // Skip directories, the bundle file, and .tmp names.
        if (entry.isDirectory()) continue
        if (name === BUNDLE_FILE) continue
        if (name.endsWith('.tmp')) continue

        // Reject reserved bundle-manifest.json.
        if (name === MANIFEST_FILE) {
            throw new Error(
                `run directory contains reserved bundle path ${MANIFEST_FILE}`
            )
        }

        const filePath = path.join(runDir, name)
        const data = readRegularArtifact(filePath, name)
        files.push({ name, data })
    }

    // Build the manifest.
    const manifestEntries:ManifestEntry[] = []
    for (const file of files) {
        const data = file.data as Uint8Array
        manifestEntries.push({
            path:file.name,
            sha256:digest(data),
            size:data.length,
        })
    }

    // Sort manifest entries bytewise by path.
    manifestEntries.sort((a, b) => compareBytes(a.path, b.path))

    const manifestJson = JSON.stringify({
        format:FORMAT,
        version:VERSION,
        files:manifestEntries.length > 0 ? manifestEntries : null,
    }, null, 2) + '\n'

    const allFiles = [...files]
    allFiles.push({ name:MANIFEST_FILE, data:Buffer.from(manifestJson) })

    // Sort all archive files bytewise by name.
    allFiles.sort((a, b) => compareBytes(a.name, b.name))

    return allFiles
}

function readRegularArtifact (filePath:string, name:string):Uint8Array {
    const st = fs.lstatSync(filePath)

    if (st.isSymbolicLink()) {
        throw new Error(
            `run artifact ${name} is a symlink; only regular files may be bundled`
        )
    }

    if (!st.isFile()) {
        throw new Error(`run artifact ${name} is not a regular file`)
    }

    const data = fs.readFileSync(filePath)

    // Verify the file didn't change during reading (dev + inode check).
    const st2 = fs.statSync(filePath)
    if (st.ino !== st2.ino || st.dev !== st2.dev) {
        throw new Error(
            `run artifact ${name} changed while the bundle was being built`
        )
    }

    return data as Uint8Array
}

// === Compression ============================================================

function writeBundle (filePath:string, files:TarFile[]):void {
    const fd = fs.openSync(filePath, 'w')
    try {
        fs.fchmodSync(fd, 0o600)
        const tarBytes = Buffer.from(writeTar(files as any))
        const compressed = zstdCompressSync(
            tarBytes,
            // @ts-expect-error — Node's zstd convenience method accepts
            // { compressionLevel } but @types/node doesn't expose it.
            { compressionLevel:3 }
        )
        fs.writeSync(fd, compressed)
    } finally {
        fs.closeSync(fd)
    }
}

// === Verify ==================================================================

/** Verify a bundle's format and contents; return the manifest. */
export function verifyBundle (filePath:string):Manifest {
    // Read the entire file.
    const fd = fs.openSync(filePath, 'r')
    let data:Buffer
    try {
        const size = fs.fstatSync(fd).size
        data = Buffer.alloc(size)
        let offset = 0
        while (offset < size) {
            const n = fs.readSync(fd, data, offset, size - offset, offset)
            if (n === 0) break
            offset += n
        }
    } finally {
        fs.closeSync(fd)
    }

    // Decompress zstd.
    let decompressed:Buffer
    try {
        decompressed = zstdDecompressSync(
            data as unknown as Buffer
        )
    } catch (err:unknown) {
        throw new Error(`open zstd stream: ${getErrorMessage(err)}`)
    }

    // Read tar entries.
    const entries = readTar(decompressed)

    // Validate and collect actual files.
    type ActualFile = { sha256:string; size:number }
    const actual:Record<string, ActualFile> = {}
    let manifestData:Uint8Array|null = null

    for (const entry of entries) {
        if (entry.typeflag !== '0' && entry.typeflag !== NULL_TYPEFLAG) {
            throw new Error(`bundle entry "${entry.name}" is not a regular file`)
        }

        if (!isValidName(entry.name)) {
            throw new Error(`bundle entry "${entry.name}" is not a flat path`)
        }

        if (entry.name in actual) {
            throw new Error(`bundle contains duplicate entry "${entry.name}"`)
        }

        if (entry.name === MANIFEST_FILE) {
            if (entry.size > MAX_MANIFEST_BYTES) {
                throw new Error('bundle manifest is larger than 1048576 bytes')
            }
            manifestData = entry.data
            continue
        }

        const hash = digest(Buffer.from(entry.data))
        actual[entry.name] = { sha256:hash, size:entry.size }
    }

    if (!manifestData) {
        throw new Error('bundle has no bundle-manifest.json')
    }

    // Parse manifest strictly.
    const content = Buffer.from(manifestData).toString('utf-8')
    let raw:unknown
    try {
        raw = JSON.parse(content)
    } catch (err:unknown) {
        const msg = err instanceof Error ? err.message : String(err)
        throw new Error(`parse bundle manifest: ${msg}`)
    }
    if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) {
        throw new Error('parse bundle manifest: expected an object')
    }
    const m = raw as Record<string, unknown>

    // Strict key check: only "format", "version", "files" are allowed.
    for (const key of Object.keys(m)) {
        if (!['format', 'version', 'files'].includes(key)) {
            throw new Error(`parse bundle manifest: unknown key "${key}"`)
        }
    }

    // Validate types.
    const format = m.format
    if (typeof format !== 'string') {
        throw new Error('parse bundle manifest: format must be a string')
    }
    const version = m.version
    if (typeof version !== 'number' || !Number.isInteger(version)) {
        throw new Error('parse bundle manifest: version must be an integer')
    }
    if (format !== FORMAT) {
        throw new Error(`unsupported bundle format "${format}"`)
    }
    if (version !== VERSION) {
        throw new Error(`unsupported bundle version ${version}`)
    }

    // Files: null or array of {path, sha256, size}.
    const rawFiles = m.files ?? null
    if (rawFiles !== null && !Array.isArray(rawFiles)) {
        throw new Error('parse bundle manifest: files must be an array or null')
    }
    const fileEntries:ManifestEntry[] = Array.isArray(rawFiles) ? rawFiles : []
    if (fileEntries.length !== Object.keys(actual).length) {
        throw new Error(
            `bundle manifest lists ${fileEntries.length} files but archive contains ${Object.keys(actual).length}`
        )
    }

    // Validate each manifest entry.
    let previousPath = ''
    for (const expected of fileEntries) {
        if (!expected.path || !isValidName(expected.path) || expected.path === MANIFEST_FILE) {
            throw new Error(`bundle manifest contains invalid path "${expected.path}"`)
        }

        if (previousPath && compareBytes(previousPath, expected.path) >= 0) {
            throw new Error('bundle manifest paths are not strictly sorted')
        }
        previousPath = expected.path

        if (!/^[a-f0-9]{64}$/.test(expected.sha256)) {
            throw new Error(`bundle manifest has invalid sha256 for ${expected.path}`)
        }

        if (typeof expected.size !== 'number' || !Number.isInteger(expected.size) || expected.size < 0) {
            throw new Error(`bundle manifest has invalid size for ${expected.path}`)
        }

        const actualFile = actual[expected.path]
        if (!actualFile) {
            throw new Error(`bundle manifest entry ${expected.path} is missing from archive`)
        }

        if (actualFile.size !== expected.size) {
            throw new Error(
                `bundle entry ${expected.path} size is ${actualFile.size}, manifest says ${expected.size}`
            )
        }

        if (actualFile.sha256 !== expected.sha256) {
            throw new Error(`bundle entry ${expected.path} digest does not match manifest`)
        }
    }

    const result:Manifest = {
        format,
        version,
        files:fileEntries.length > 0 ? fileEntries : null,
    }
    return result
}

// === Helpers =================================================================

function isEnoent (err:unknown):boolean {
    if (err instanceof Error && 'code' in err) return (err as any).code === 'ENOENT'
    return false
}

function isEExist (err:unknown):boolean {
    if (err instanceof Error && 'code' in err) return (err as any).code === 'EEXIST'
    return false
}

function getErrorMessage (err:unknown):string {
    return err instanceof Error ? err.message : String(err)
}

function isValidName (name:string):boolean {
    if (!name || name.includes('/') || name === '.' || name === '..') return false
    return true
}

function hashFile (filePath:string):string {
    const data = fs.readFileSync(filePath)
    return digest(data)
}
