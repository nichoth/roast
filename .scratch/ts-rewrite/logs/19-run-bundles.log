test('bundle build rejects non-regular files as artifacts', async t => {
    const dir = tempDir()
    writeFiles(dir, { 'meta.json':'metadata\n' })

    // Create a block device node - not a regular file.
    // We try to create one using mknod; skip if it fails (needs root).
    const blockPath = path.join(dir, 'sdb1')
    const { execSync } = await import('node:child_process')
    try {
        // shell-quote: wrap in single quotes, escaping any internal single quotes.
        const q = (s:string) => "'" + s.replace(/'/g, "'\\''") + "'"
        execSync(`mknod ${q(blockPath)} b 8 0`, { stdio:'pipe' })
    } catch {
        // Cannot create device node; skip.
        return
    }

    const st = fs.statSync(blockPath)
    if (st.isBlockDevice()) {
        t.throws(() => buildBundle(dir), /not a regular file/, 'block device is rejected')
    } else {
        // Not a block device; still test with the file.
        fs.unlinkSync(blockPath)
    }
})

