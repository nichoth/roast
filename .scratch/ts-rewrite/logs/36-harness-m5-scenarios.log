{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DNHJN4kfwEz4gMW2NLzCx6","type":"tool_result","content":"// M3 scenarios (spec 15, 2.13): `roast review` on the `chat` protocol,\n// finder plus verifier unless noted, against one fake server whose\n// replies are keyed by (model, turn count). Every scenario compares exit\n// codes, requests, and run records; JSON-output scenarios also compare\n// stdout.\nimport type { Reply } from '../../helpers/inference-server.js'\nimport {\n    type Wire,\n    chatCalls,\n    finding,\n    findingsReply,\n} from '../../helpers/review.js'\nimport { type ReplyTable, scriptedServer } from '../replies.js'\nimport type { Scenario, ScenarioContext } from '../scenario.js'\n\nexport const FINDER_MODEL = 'finder-model'\nexport const VERIFIER_MODEL = 'verifier-model'\n// Credential variables named outside the scrubbed prefixes.\nconst FINDER_KEY_ENV = 'DIFF_FINDER_KEY'\nconst VERIFIER_KEY_ENV = 'DIFF_VERIFIER_KEY'\n\n// Group keys (model#turns) of each role's first call: the finder sends\n// a system prompt and two user turns, the verifier one user turn.\nexport const FINDER_FIRST = `${FINDER_MODEL}#3`\nexport const VERIFIER_FIRST = `${VERIFIER_MODEL}#2`\n\nconst ORIGINAL = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\treturn value\\n}\\n'\nconst CHANGED = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\tif value < 0 {\\n\\t\\treturn 0\\n\\t}\\n\\treturn value\\n}\\n'\n\nfunction config (url:string):string {\n    const profile = (model:string, keyEnv:string) => ({\n        model,\n        endpoint:`${url}/v1`,\n        protocol:'chat',\n        api_key_env:keyEnv,\n        max_output_tokens:4096,\n    })\n    return JSON.stringify({\n        version:1,\n        inference_profiles:{\n            finder:profile(FINDER_MODEL, FINDER_KEY_ENV),\n            verifier:profile(VERIFIER_MODEL, VERIFIER_KEY_ENV),\n        },\n        roles:{ finder:{ profile:'finder' }, verifier:{ profile:'verifier' } },\n    }, null, 2) + '\\n'\n}\n\nfunction files (ctx:ScenarioContext):Record<string, string> {\n    return { '.roast.json':config(ctx.url), 'main.go':ORIGINAL }\n}\n\nfunction env ():Record<string, string> {\n    return {\n        [FINDER_KEY_ENV]:'diff-finder-key',\n        [VERIFIER_KEY_ENV]:'diff-verifier-key',\n    }\n}\n\nexport function verdictReply (status = 'confirmed'):Reply {\n    return {\n        stream:chatCalls([{\n            name:'submit_verdict',\n            args:{\n                reasoning:'checked the guard',\n                status,\n                confidence:0.9,\n                grounding:'line 4 returns value unchecked',\n            },\n        }], VERIFIER_MODEL),\n    }\n}\n\nexport const TWO_FINDINGS:Wire[] = [\n    finding(),\n    finding({\n        severity:'MEDIUM',\n        lines:[4],\n        code_quote:'if value < 0 {',\n        description:'Negative input clamps silently',\n    }),\n]\n\ninterface ReviewCase {\n    name:string;\n    argv:string[];\n    replies:ReplyTable;\n    stdout?:'json';\n    stage?:boolean;\n}\n\nfunction review (c:ReviewCase):Scenario {\n    return {\n        name:`review: ${c.name}`,\n        files,\n        changes:{ 'main.go':CHANGED },\n        stage:c.stage,\n        trust:['trust', '--yes'],\n        argv:['review', ...c.argv],\n        stdout:c.stdout,\n        env,\n        server:() => scriptedServer(c.replies),\n        records:true,\n        requests:true,\n    }\n}\n\nexport const CONFIRMED:ReplyTable = {\n    [FINDER_FIRST]:findingsReply(TWO_FINDINGS),\n    [VERIFIER_FIRST]:verdictReply(),\n}\n\nconst ONE_HIGH:ReplyTable = {\n    [FINDER_FIRST]:findingsReply([finding()]),\n    [VERIFIER_FIRST]:verdictReply(),\n}\n\nconst FAIL_500:Reply = {\n    status:500,\n    headers:{ 'Content-Type':'application/json' },\n    body:'{\"error\":{\"message\":\"upstream exploded\",\"type\":\"server_error\"}}',\n}\n\nconst FAIL_401:Reply = {\n    status:401,\n    headers:{ 'Content-Type':'application/json' },\n    body:'{\"error\":{\"message\":\"bad key\",\"type\":\"invalid_request_error\"}}',\n}\n\nexport const M3_CASES:readonly ReviewCase[] = [\n    {\n        name:'clean review',\n        argv:[],\n        replies:{ [FINDER_FIRST]:findingsReply([]) },\n    },\n    {\n        name:'findings confirmed by the verifier',\n        argv:[],\n        replies:CONFIRMED,\n    },\n    {\n        name:'--format json',\n        argv:['--format', 'json'],\n        replies:CONFIRMED,\n        stdout:'json',\n    },\n    {\n        name:'--staged',\n        argv:['--staged', '--format', 'json'],\n        replies:CONFIRMED,\n        stdout:'json',\n        stage:true,\n    },\n    {\n        name:'--max-severity trips',\n        argv:['--format', 'json', '--max-severity', 'HIGH'],\n        replies:ONE_HIGH,\n        stdout:'json',\n    },\n    {\n        name:'--max-severity does not trip',\n        argv:['--format', 'json', '--max-severity', 'CRITICAL'],\n        replies:ONE_HIGH,\n        stdout:'json',\n    },\n    {\n        name:'provider HTTP 500 after retries',\n        argv:['--format', 'json', '--max-attempts', '2'],\n        replies:{ [FINDER_FIRST]:FAIL_500 },\n        stdout:'json',\n    },\n    {\n        name:'provider HTTP 401',\n        argv:['--format', 'json'],\n        replies:{ [FINDER_FIRST]:FAIL_401 },\n        stdout:'json',\n    },\n]\n\nexport const M3_SCENARIOS:readonly Scenario[] = M3_CASES.map(review)\n\nexport function m3Scenario (name:string):Scenario {\n    const s = M3_SCENARIOS.find(x => x.name === `review: ${name}`)\n    if (!s) throw new Error(`no M3 scenario ${name}`)\n    return s\n}\n// Self-tests for the scenario runner: it detects an injected\n// divergence, and two runs of one CLI compare equal after normalization.\n// They use the TS CLI and stub CLIs, so they need no Go.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { test } from '../../helpers/test.js'\nimport { startInferenceServer } from '../../helpers/inference-server.js'\nimport { type Cli, type Scenario, TS_CLI, runScenario } from '../scenario.js'\nimport { M1_SCENARIOS } from '../scenarios/m1.js'\n\nfunction stubDir ():{ dir:string, remove ():void } {\n    const dir = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-stub-')))\n    return { dir, remove:() => fs.rmSync(dir, { recursive:true }) }\n}\n\nfunction shellStub (dir:string, body:string):Cli {\n    const file = path.join(dir, 'stub.sh')\n    fs.writeFileSync(file, `#!/bin/sh\\n${body}\\n`, { mode:0o755 })\n    return { name:'stub', command:file, args:[] }\n}\n\nfunction scenario (name:string):Scenario {\n    const s = M1_SCENARIOS.find(x => x.name === name)\n    if (!s) throw new Error(`no scenario ${name}`)\n    return s\n}\n\ntest('harness: the TS CLI against itself has no differences', async t => {\n    const s = scenario('gate settings: custom gate section')\n    const r = await runScenario(s, { go:TS_CLI, ts:TS_CLI })\n    t.equal(r.go.exit, 0, 'the scenario succeeds')\n    t.deepEqual(r.diffs, [], 'and both sides compare equal')\n})\n\ntest('harness: a stub that exits with another code is a divergence',\n    async t => {\n        const d = stubDir()\n        t.cleanup(() => d.remove())\n        const stub = shellStub(d.dir,\n            'printf \"timeout_seconds=42\\\\nseverity=MEDIUM\\\\n\"; exit 3')\n        const s = scenario('gate settings: custom gate section')\n        const r = await runScenario(s, { go:TS_CLI, ts:stub })\n        t.deepEqual(r.unexplained.map(x => x.path), ['exit'],\n            'the exit code difference is unexplained')\n    })\n\ntest('harness: a stub with other settings is a divergence', async t => {\n    const d = stubDir()\n    t.cleanup(() => d.remove())\n    const stub = shellStub(d.dir,\n        'printf \"timeout_seconds=42\\\\nseverity=HIGH\\\\n\"')\n    const s = scenario('gate settings: custom gate section')\n    const r = await runScenario(s, { go:TS_CLI, ts:stub })\n    t.deepEqual(r.unexplained.map(x => x.path), ['stdout.severity'],\n        'the stdout difference is unexplained')\n})\n\n// A CLI whose every run has a fresh run ID, timestamp, build identity,\n// duration, User-Agent, and session ID, writes records naming its\n// repository, and sends one request to the fake server.\nconst VOLATILE_STUB = `\nimport crypto from 'node:crypto'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport zlib from 'node:zlib'\nconst rand = n => crypto.randomBytes(n).toString('hex')\nconst now = new Date(Date.now() + crypto.randomInt(1e9))\nconst id = now.toISOString().replace(/[-:]/g, '').replace(/\\\\.\\\\d+Z$/, 'Z') +\n    '-' + rand(4)\nconst ts = now.toISOString()\nconst cwd = process.cwd()\nconst runs = path.join(cwd, '.roast', 'runs')\nconst run = path.join(runs, id)\nfs.mkdirSync(run, { recursive:true })\nfs.writeFileSync(path.join(run, 'meta.json'), JSON.stringify({\n    run_id:id, ts, repo:cwd, duration_ms:crypto.randomInt(1e6),\n    roast:{ version:rand(3), commit:rand(4) },\n}))\nfs.writeFileSync(path.join(run, 'result.json.gz'),\n    zlib.gzipSync(JSON.stringify({ run_id:id, report:path.join(run, 'r') })))\nfs.writeFileSync(path.join(runs, 'runs-2026-01.jsonl'),\n    JSON.stringify({ run_id:id, ts }) + '\\\\n')\nconst b32 = 'abcdefghijklmnopqrstuvwxyz234567'\nlet session = 'roast-'\nfor (let i = 0; i < 26; i++) session += b32[crypto.randomInt(32)]\nawait fetch(process.env.STUB_URL + '/v1/chat/completions', {\n    method:'POST',\n    headers:{\n        'content-type':'application/json',\n        'user-agent':'stub/' + rand(2),\n        'x-agent-session-id':session,\n        authorization:'Bearer k',\n    },\n    body:JSON.stringify({\n        model:'m',\n        messages:[{ role:'user', content:'review ' + cwd + ' ' + session }],\n    }),\n})\nprocess.stdout.write(JSON.stringify({ run_id:id, ts, dir:run }) + '\\\\n')\n`\n\ntest('harness: normalization makes two runs of one CLI equal', async t => {\n    const d = stubDir()\n    t.cleanup(() => d.remove())\n    const file = path.join(d.dir, 'stub.mjs')\n    fs.writeFileSync(file, VOLATILE_STUB)\n    const cli:Cli = { name:'stub', command:process.execPath, args:[file] }\n    const s:Scenario = {\n        name:'self: volatile stub',\n        files:{ 'README.md':'fixture\\n' },\n        argv:[],\n        stdout:'json',\n        env:ctx => ({ STUB_URL:ctx.url }),\n        server:() => startInferenceServer(() => ({ status:200, body:'{}' })),\n        records:true,\n        requests:true,\n    }\n    const r = await runScenario(s, { go:cli, ts:cli })\n    t.equal(r.go.exit, 0, 'the first run succeeds')\n    t.equal(r.ts.exit, 0, 'the second run succeeds')\n    t.ok(r.go.stdout !== r.ts.stdout, 'the raw outputs differ')\n    t.equal(r.go.records.size, 3, 'records were read')\n    t.equal(r.go.requests.length, 1, 'the first run\\'s request')\n    t.equal(r.ts.requests.length, 1, 'the second run\\'s request')\n    t.deepEqual(r.diffs, [], 'nothing differs after normalization')\n})\n// Self-tests for the M3 review scenarios, run with the TS CLI on both\n// sides so they need no Go: a scenario compares equal against itself,\n// reply selection ignores completion order, and a one-field difference\n// injected on one side -- in `meta.json` or in a request body -- fails\n// the comparison and names where.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { test } from '../../helpers/test.js'\nimport {\n    type RecordedRequest,\n    startInferenceServer,\n} from '../../helpers/inference-server.js'\nimport { writeInferenceStream } from '../../helpers/inference-stream.js'\nimport { ROOT } from '../../helpers/spawn.js'\nimport { replyFor } from '../replies.js'\nimport { groupKey } from '../requests.js'\nimport { type Cli, type Scenario, TS_CLI, runScenario } from '../scenario.js'\nimport {\n    CONFIRMED,\n    FINDER_FIRST,\n    VERIFIER_FIRST,\n    m3Scenario,\n} from '../scenarios/m3.js'\n\nconst CLI_JS = path.join(ROOT, 'dist', 'cli.js')\n\nfunction stubDir ():{ dir:string, remove ():void } {\n    const dir = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-m3-')))\n    return { dir, remove:() => fs.rmSync(dir, { recursive:true }) }\n}\n\ntest('m3: a review scenario run on the TS CLI twice compares equal',\n    async t => {\n        const r = await runScenario(m3Scenario('--format json'),\n            { go:TS_CLI, ts:TS_CLI })\n        t.equal(r.go.exit, 0, 'the review succeeds')\n        t.ok(r.go.records.size > 0, 'records were written')\n        t.ok(r.go.requests.some(q => groupKey(q) === VERIFIER_FIRST),\n            'the verifier was called')\n        t.deepEqual(r.diffs, [], 'and both sides compare equal')\n    })\n\ntest('m3: reordering verifier completions does not change the result',\n    async t => {\n        // Verifier requests in arrival order across both sides: the first\n        // side's first and the second side's second are held back, so\n        // the two sides see their completions in opposite orders.\n        let verifierSeen = 0\n        const finished:number[] = []\n        const server = () => startInferenceServer(req => {\n            const reply = replyFor(CONFIRMED, req)\n            if (groupKey(req) !== VERIFIER_FIRST) return reply\n            const k = verifierSeen++\n            const delay = k === 0 || k === 3 ? 400 : 0\n            return async res => {\n                await new Promise(resolve => setTimeout(resolve, delay))\n                if (!('stream' in reply)) throw new Error('want a stream')\n                writeInferenceStream(res, 'chat', reply.stream)\n                finished.push(k)\n            }\n        })\n        const s:Scenario = {\n            ...m3Scenario('findings confirmed by the verifier'),\n            server,\n        }\n        const r = await runScenario(s, { go:TS_CLI, ts:TS_CLI })\n        t.equal(r.go.exit, 0, 'the review succeeds')\n        t.deepEqual(finished, [1, 0, 2, 3],\n            'completions arrived in opposite orders on the two sides')\n        t.deepEqual(r.diffs, [], 'the comparison still finds no difference')\n    })\n\n// Runs the TS CLI, then changes one budget value in the run's meta.json.\nconst META_WRAPPER = `\nimport { spawnSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nconst r = spawnSync(process.execPath, [process.env.CLI_JS,\n    ...process.argv.slice(2)], { stdio:'inherit' })\nconst runs = path.join(process.cwd(), '.roast', 'runs')\nif (process.argv[2] === 'review' && fs.existsSync(runs)) {\n    for (const id of fs.readdirSync(runs)) {\n        const file = path.join(runs, id, 'meta.json')\n        if (!fs.existsSync(file)) continue\n        const meta = JSON.parse(fs.readFileSync(file, 'utf8'))\n        meta.budgets.max_turns += 1\n        fs.writeFileSync(file, JSON.stringify(meta))\n    }\n}\nprocess.exit(r.status ?? 1)\n`\n\ntest('m3: a changed meta.json value names the file and JSON path',\n    async t => {\n        const d = stubDir()\n        t.cleanup(() => d.remove())\n        const file = path.join(d.dir, 'wrapper.mjs')\n        fs.writeFileSync(file, META_WRAPPER)\n        const wrapped:Cli = {\n            name:'wrapped', command:process.execPath, args:[file],\n        }\n        const base = m3Scenario('--format json')\n        const s:Scenario = {\n            ...base,\n            env:ctx => ({ ...base.env?.(ctx), CLI_JS }),\n        }\n        const r = await runScenario(s, { go:TS_CLI, ts:wrapped })\n        t.deepEqual(r.unexplained.map(x => x.path),\n            ['records/<RUN_ID>/meta.json.budgets.max_turns'],\n            'exactly the changed field is reported')\n    })\n\n// Preloaded into the TS CLI: adds one field to every JSON request body.\nconst FETCH_HOOK = `\nconst original = globalThis.fetch\nglobalThis.fetch = (input, init) => {\n    const raw = init?.body\n    if (typeof raw === 'string' || raw instanceof Uint8Array) {\n        const body = JSON.parse(Buffer.from(raw).toString('utf8'))\n        body.injected = true\n        init = { ...init, body:JSON.stringify(body) }\n    }\n    return original(input, init)\n}\n`\n\ntest('m3: a changed request body field names its (model, turns) group',\n    async t => {\n        const d = stubDir()\n        t.cleanup(() => d.remove())\n        const hook = path.join(d.dir, 'hook.mjs')\n        fs.writeFileSync(hook, FETCH_HOOK)\n        const injected:Cli = {\n            name:'injected',\n            command:process.execPath,\n            args:['--import', hook, CLI_JS],\n        }\n        const r = await runScenario(m3Scenario('clean review'),\n            { go:TS_CLI, ts:injected })\n        const sent:RecordedRequest[] = r.ts.requests\n        t.ok(sent.some(q => groupKey(q) === FINDER_FIRST),\n            'the finder request was sent')\n        t.deepEqual(r.unexplained.map(x => x.path),\n            [`requests[${FINDER_FIRST}][0].body.injected`],\n            'the difference names the group and the field')\n    })\n// A fake inference server for review scenarios (spec 15, 2.13 step 1):\n// each reply is chosen by request content -- the model name plus the\n// number of conversation turns, the same key the request comparison\n// groups by -- never by arrival order, because finder and verifier\n// calls may interleave differently on the two CLIs.\nimport {\n    type InferenceServer,\n    type Reply,\n    type RecordedRequest,\n    startInferenceServer,\n} from '../helpers/inference-server.js'\nimport { groupKey } from './requests.js'\n\n// Replies by `<model>#<turns>`.\nexport type ReplyTable = Readonly<Record<string, Reply>>\n\n// A request without a scripted reply gets a 404 naming its key, so a\n// scenario that drifts fails loudly on both sides.\nexport function replyFor (table:ReplyTable, req:RecordedRequest):Reply {\n    const key = groupKey(req)\n    const r = Object.hasOwn(table, key) ? table[key] : undefined\n    if (r === undefined) {\n        return { status:404, body:`no scripted reply for ${key}` }\n    }\n    return r\n}\n\nexport function scriptedServer (table:ReplyTable):Promise<InferenceServer> {\n    return startInferenceServer(req => replyFor(table, req))\n}\n983f518 redeye: update ticket checklists\n67b0d54 redeye: 26-harness-m3-review-scenarios.md done\nf2e98ef redeye: 24-runs-checkout-and-prune.md done\n4e2ee7d docs: harness review-scenario notes; spec 07 open question on the nudge tool\n4f150e1 diff harness: M3 review scenarios on chat\n8e36075 diff harness: normalize finding identity, snapshot OIDs, SDK headers, compressed bytes\nc7d7bdc Merge branch 'roast--ts-rewrite-24-runs-checkout-and-prune' into wip\nc95b1b6 redeye: update ticket checklists","is_error":false}]},"parent_tool_use_id":null,"session_id":"7a121785-8a13-4050-8d25-20fb8f8a9a84","uuid":"a3e8d60e-590d-4a29-b5bd-c6008228a645","timestamp":"2026-11-24T02:46:52.690Z","tool_use_result":{"stdout":"// M3 scenarios (spec 15, 2.13): `roast review` on the `chat` protocol,\n// finder plus verifier unless noted, against one fake server whose\n// replies are keyed by (model, turn count). Every scenario compares exit\n// codes, requests, and run records; JSON-output scenarios also compare\n// stdout.\nimport type { Reply } from '../../helpers/inference-server.js'\nimport {\n    type Wire,\n    chatCalls,\n    finding,\n    findingsReply,\n} from '../../helpers/review.js'\nimport { type ReplyTable, scriptedServer } from '../replies.js'\nimport type { Scenario, ScenarioContext } from '../scenario.js'\n\nexport const FINDER_MODEL = 'finder-model'\nexport const VERIFIER_MODEL = 'verifier-model'\n// Credential variables named outside the scrubbed prefixes.\nconst FINDER_KEY_ENV = 'DIFF_FINDER_KEY'\nconst VERIFIER_KEY_ENV = 'DIFF_VERIFIER_KEY'\n\n// Group keys (model#turns) of each role's first call: the finder sends\n// a system prompt and two user turns, the verifier one user turn.\nexport const FINDER_FIRST = `${FINDER_MODEL}#3`\nexport const VERIFIER_FIRST = `${VERIFIER_MODEL}#2`\n\nconst ORIGINAL = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\treturn value\\n}\\n'\nconst CHANGED = 'package main\\n\\nfunc f(value int) int {\\n' +\n    '\\tif value < 0 {\\n\\t\\treturn 0\\n\\t}\\n\\treturn value\\n}\\n'\n\nfunction config (url:string):string {\n    const profile = (model:string, keyEnv:string) => ({\n        model,\n        endpoint:`${url}/v1`,\n        protocol:'chat',\n        api_key_env:keyEnv,\n        max_output_tokens:4096,\n    })\n    return JSON.stringify({\n        version:1,\n        inference_profiles:{\n            finder:profile(FINDER_MODEL, FINDER_KEY_ENV),\n            verifier:profile(VERIFIER_MODEL, VERIFIER_KEY_ENV),\n        },\n        roles:{ finder:{ profile:'finder' }, verifier:{ profile:'verifier' } },\n    }, null, 2) + '\\n'\n}\n\nfunction files (ctx:ScenarioContext):Record<string, string> {\n    return { '.roast.json':config(ctx.url), 'main.go':ORIGINAL }\n}\n\nfunction env ():Record<string, string> {\n    return {\n        [FINDER_KEY_ENV]:'diff-finder-key',\n        [VERIFIER_KEY_ENV]:'diff-verifier-key',\n    }\n}\n\nexport function verdictReply (status = 'confirmed'):Reply {\n    return {\n        stream:chatCalls([{\n            name:'submit_verdict',\n            args:{\n                reasoning:'checked the guard',\n                status,\n                confidence:0.9,\n                grounding:'line 4 returns value unchecked',\n            },\n        }], VERIFIER_MODEL),\n    }\n}\n\nexport const TWO_FINDINGS:Wire[] = [\n    finding(),\n    finding({\n        severity:'MEDIUM',\n        lines:[4],\n        code_quote:'if value < 0 {',\n        description:'Negative input clamps silently',\n    }),\n]\n\ninterface ReviewCase {\n    name:string;\n    argv:string[];\n    replies:ReplyTable;\n    stdout?:'json';\n    stage?:boolean;\n}\n\nfunction review (c:ReviewCase):Scenario {\n    return {\n        name:`review: ${c.name}`,\n        files,\n        changes:{ 'main.go':CHANGED },\n        stage:c.stage,\n        trust:['trust', '--yes'],\n        argv:['review', ...c.argv],\n        stdout:c.stdout,\n        env,\n        server:() => scriptedServer(c.replies),\n        records:true,\n        requests:true,\n    }\n}\n\nexport const CONFIRMED:ReplyTable = {\n    [FINDER_FIRST]:findingsReply(TWO_FINDINGS),\n    [VERIFIER_FIRST]:verdictReply(),\n}\n\nconst ONE_HIGH:ReplyTable = {\n    [FINDER_FIRST]:findingsReply([finding()]),\n    [VERIFIER_FIRST]:verdictReply(),\n}\n\nconst FAIL_500:Reply = {\n    status:500,\n    headers:{ 'Content-Type':'application/json' },\n    body:'{\"error\":{\"message\":\"upstream exploded\",\"type\":\"server_error\"}}',\n}\n\nconst FAIL_401:Reply = {\n    status:401,\n    headers:{ 'Content-Type':'application/json' },\n    body:'{\"error\":{\"message\":\"bad key\",\"type\":\"invalid_request_error\"}}',\n}\n\nexport const M3_CASES:readonly ReviewCase[] = [\n    {\n        name:'clean review',\n        argv:[],\n        replies:{ [FINDER_FIRST]:findingsReply([]) },\n    },\n    {\n        name:'findings confirmed by the verifier',\n        argv:[],\n        replies:CONFIRMED,\n    },\n    {\n        name:'--format json',\n        argv:['--format', 'json'],\n        replies:CONFIRMED,\n        stdout:'json',\n    },\n    {\n        name:'--staged',\n        argv:['--staged', '--format', 'json'],\n        replies:CONFIRMED,\n        stdout:'json',\n        stage:true,\n    },\n    {\n        name:'--max-severity trips',\n        argv:['--format', 'json', '--max-severity', 'HIGH'],\n        replies:ONE_HIGH,\n        stdout:'json',\n    },\n    {\n        name:'--max-severity does not trip',\n        argv:['--format', 'json', '--max-severity', 'CRITICAL'],\n        replies:ONE_HIGH,\n        stdout:'json',\n    },\n    {\n        name:'provider HTTP 500 after retries',\n        argv:['--format', 'json', '--max-attempts', '2'],\n        replies:{ [FINDER_FIRST]:FAIL_500 },\n        stdout:'json',\n    },\n    {\n        name:'provider HTTP 401',\n        argv:['--format', 'json'],\n        replies:{ [FINDER_FIRST]:FAIL_401 },\n        stdout:'json',\n    },\n]\n\nexport const M3_SCENARIOS:readonly Scenario[] = M3_CASES.map(review)\n\nexport function m3Scenario (name:string):Scenario {\n    const s = M3_SCENARIOS.find(x => x.name === `review: ${name}`)\n    if (!s) throw new Error(`no M3 scenario ${name}`)\n    return s\n}\n// Self-tests for the scenario runner: it detects an injected\n// divergence, and two runs of one CLI compare equal after normalization.\n// They use the TS CLI and stub CLIs, so they need no Go.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { test } from '../../helpers/test.js'\nimport { startInferenceServer } from '../../helpers/inference-server.js'\nimport { type Cli, type Scenario, TS_CLI, runScenario } from '../scenario.js'\nimport { M1_SCENARIOS } from '../scenarios/m1.js'\n\nfunction stubDir ():{ dir:string, remove ():void } {\n    const dir = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-stub-')))\n    return { dir, remove:() => fs.rmSync(dir, { recursive:true }) }\n}\n\nfunction shellStub (dir:string, body:string):Cli {\n    const file = path.join(dir, 'stub.sh')\n    fs.writeFileSync(file, `#!/bin/sh\\n${body}\\n`, { mode:0o755 })\n    return { name:'stub', command:file, args:[] }\n}\n\nfunction scenario (name:string):Scenario {\n    const s = M1_SCENARIOS.find(x => x.name === name)\n    if (!s) throw new Error(`no scenario ${name}`)\n    return s\n}\n\ntest('harness: the TS CLI against itself has no differences', async t => {\n    const s = scenario('gate settings: custom gate section')\n    const r = await runScenario(s, { go:TS_CLI, ts:TS_CLI })\n    t.equal(r.go.exit, 0, 'the scenario succeeds')\n    t.deepEqual(r.diffs, [], 'and both sides compare equal')\n})\n\ntest('harness: a stub that exits with another code is a divergence',\n    async t => {\n        const d = stubDir()\n        t.cleanup(() => d.remove())\n        const stub = shellStub(d.dir,\n            'printf \"timeout_seconds=42\\\\nseverity=MEDIUM\\\\n\"; exit 3')\n        const s = scenario('gate settings: custom gate section')\n        const r = await runScenario(s, { go:TS_CLI, ts:stub })\n        t.deepEqual(r.unexplained.map(x => x.path), ['exit'],\n            'the exit code difference is unexplained')\n    })\n\ntest('harness: a stub with other settings is a divergence', async t => {\n    const d = stubDir()\n    t.cleanup(() => d.remove())\n    const stub = shellStub(d.dir,\n        'printf \"timeout_seconds=42\\\\nseverity=HIGH\\\\n\"')\n    const s = scenario('gate settings: custom gate section')\n    const r = await runScenario(s, { go:TS_CLI, ts:stub })\n    t.deepEqual(r.unexplained.map(x => x.path), ['stdout.severity'],\n        'the stdout difference is unexplained')\n})\n\n// A CLI whose every run has a fresh run ID, timestamp, build identity,\n// duration, User-Agent, and session ID, writes records naming its\n// repository, and sends one request to the fake server.\nconst VOLATILE_STUB = `\nimport crypto from 'node:crypto'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport zlib from 'node:zlib'\nconst rand = n => crypto.randomBytes(n).toString('hex')\nconst now = new Date(Date.now() + crypto.randomInt(1e9))\nconst id = now.toISOString().replace(/[-:]/g, '').replace(/\\\\.\\\\d+Z$/, 'Z') +\n    '-' + rand(4)\nconst ts = now.toISOString()\nconst cwd = process.cwd()\nconst runs = path.join(cwd, '.roast', 'runs')\nconst run = path.join(runs, id)\nfs.mkdirSync(run, { recursive:true })\nfs.writeFileSync(path.join(run, 'meta.json'), JSON.stringify({\n    run_id:id, ts, repo:cwd, duration_ms:crypto.randomInt(1e6),\n    roast:{ version:rand(3), commit:rand(4) },\n}))\nfs.writeFileSync(path.join(run, 'result.json.gz'),\n    zlib.gzipSync(JSON.stringify({ run_id:id, report:path.join(run, 'r') })))\nfs.writeFileSync(path.join(runs, 'runs-2026-01.jsonl'),\n    JSON.stringify({ run_id:id, ts }) + '\\\\n')\nconst b32 = 'abcdefghijklmnopqrstuvwxyz234567'\nlet session = 'roast-'\nfor (let i = 0; i < 26; i++) session += b32[crypto.randomInt(32)]\nawait fetch(process.env.STUB_URL + '/v1/chat/completions', {\n    method:'POST',\n    headers:{\n        'content-type':'application/json',\n        'user-agent':'stub/' + rand(2),\n        'x-agent-session-id':session,\n        authorization:'Bearer k',\n    },\n    body:JSON.stringify({\n        model:'m',\n        messages:[{ role:'user', content:'review ' + cwd + ' ' + session }],\n    }),\n})\nprocess.stdout.write(JSON.stringify({ run_id:id, ts, dir:run }) + '\\\\n')\n`\n\ntest('harness: normalization makes two runs of one CLI equal', async t => {\n    const d = stubDir()\n    t.cleanup(() => d.remove())\n    const file = path.join(d.dir, 'stub.mjs')\n    fs.writeFileSync(file, VOLATILE_STUB)\n    const cli:Cli = { name:'stub', command:process.execPath, args:[file] }\n    const s:Scenario = {\n        name:'self: volatile stub',\n        files:{ 'README.md':'fixture\\n' },\n        argv:[],\n        stdout:'json',\n        env:ctx => ({ STUB_URL:ctx.url }),\n        server:() => startInferenceServer(() => ({ status:200, body:'{}' })),\n        records:true,\n        requests:true,\n    }\n    const r = await runScenario(s, { go:cli, ts:cli })\n    t.equal(r.go.exit, 0, 'the first run succeeds')\n    t.equal(r.ts.exit, 0, 'the second run succeeds')\n    t.ok(r.go.stdout !== r.ts.stdout, 'the raw outputs differ')\n    t.equal(r.go.records.size, 3, 'records were read')\n    t.equal(r.go.requests.length, 1, 'the first run\\'s request')\n    t.equal(r.ts.requests.length, 1, 'the second run\\'s request')\n    t.deepEqual(r.diffs, [], 'nothing differs after normalization')\n})\n// Self-tests for the M3 review scenarios, run with the TS CLI on both\n// sides so they need no Go: a scenario compares equal against itself,\n// reply selection ignores completion order, and a one-field difference\n// injected on one side -- in `meta.json` or in a request body -- fails\n// the comparison and names where.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { test } from '../../helpers/test.js'\nimport {\n    type RecordedRequest,\n    startInferenceServer,\n} from '../../helpers/inference-server.js'\nimport { writeInferenceStream } from '../../helpers/inference-stream.js'\nimport { ROOT } from '../../helpers/spawn.js'\nimport { replyFor } from '../replies.js'\nimport { groupKey } from '../requests.js'\nimport { type Cli, type Scenario, TS_CLI, runScenario } from '../scenario.js'\nimport {\n    CONFIRMED,\n    FINDER_FIRST,\n    VERIFIER_FIRST,\n    m3Scenario,\n} from '../scenarios/m3.js'\n\nconst CLI_JS = path.join(ROOT, 'dist', 'cli.js')\n\nfunction stubDir ():{ dir:string, remove ():void } {\n    const dir = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-m3-')))\n    return { dir, remove:() => fs.rmSync(dir, { recursive:true }) }\n}\n\ntest('m3: a review scenario run on the TS CLI twice compares equal',\n    async t => {\n        const r = await runScenario(m3Scenario('--format json'),\n            { go:TS_CLI, ts:TS_CLI })\n        t.equal(r.go.exit, 0, 'the review succeeds')\n        t.ok(r.go.records.size > 0, 'records were written')\n        t.ok(r.go.requests.some(q => groupKey(q) === VERIFIER_FIRST),\n            'the verifier was called')\n        t.deepEqual(r.diffs, [], 'and both sides compare equal')\n    })\n\ntest('m3: reordering verifier completions does not change the result',\n    async t => {\n        // Verifier requests in arrival order across both sides: the first\n        // side's first and the second side's second are held back, so\n        // the two sides see their completions in opposite orders.\n        let verifierSeen = 0\n        const finished:number[] = []\n        const server = () => startInferenceServer(req => {\n            const reply = replyFor(CONFIRMED, req)\n            if (groupKey(req) !== VERIFIER_FIRST) return reply\n            const k = verifierSeen++\n            const delay = k === 0 || k === 3 ? 400 : 0\n            return async res => {\n                await new Promise(resolve => setTimeout(resolve, delay))\n                if (!('stream' in reply)) throw new Error('want a stream')\n                writeInferenceStream(res, 'chat', reply.stream)\n                finished.push(k)\n            }\n        })\n        const s:Scenario = {\n            ...m3Scenario('findings confirmed by the verifier'),\n            server,\n        }\n        const r = await runScenario(s, { go:TS_CLI, ts:TS_CLI })\n        t.equal(r.go.exit, 0, 'the review succeeds')\n        t.deepEqual(finished, [1, 0, 2, 3],\n            'completions arrived in opposite orders on the two sides')\n        t.deepEqual(r.diffs, [], 'the comparison still finds no difference')\n    })\n\n// Runs the TS CLI, then changes one budget value in the run's meta.json.\nconst META_WRAPPER = `\nimport { spawnSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nconst r = spawnSync(process.execPath, [process.env.CLI_JS,\n    ...process.argv.slice(2)], { stdio:'inherit' })\nconst runs = path.join(process.cwd(), '.roast', 'runs')\nif (process.argv[2] === 'review' && fs.existsSync(runs)) {\n    for (const id of fs.readdirSync(runs)) {\n        const file = path.join(runs, id, 'meta.json')\n        if (!fs.existsSync(file)) continue\n        const meta = JSON.parse(fs.readFileSync(file, 'utf8'))\n        meta.budgets.max_turns += 1\n        fs.writeFileSync(file, JSON.stringify(meta))\n    }\n}\nprocess.exit(r.status ?? 1)\n`\n\ntest('m3: a changed meta.json value names the file and JSON path',\n    async t => {\n        const d = stubDir()\n        t.cleanup(() => d.remove())\n        const file = path.join(d.dir, 'wrapper.mjs')\n        fs.writeFileSync(file, META_WRAPPER)\n        const wrapped:Cli = {\n            name:'wrapped', command:process.execPath, args:[file],\n        }\n        const base = m3Scenario('--format json')\n        const s:Scenario = {\n            ...base,\n            env:ctx => ({ ...base.env?.(ctx), CLI_JS }),\n        }\n        const r = await runScenario(s, { go:TS_CLI, ts:wrapped })\n        t.deepEqual(r.unexplained.map(x => x.path),\n            ['records/<RUN_ID>/meta.json.budgets.max_turns'],\n            'exactly the changed field is reported')\n    })\n\n// Preloaded into the TS CLI: adds one field to every JSON request body.\nconst FETCH_HOOK = `\nconst original = globalThis.fetch\nglobalThis.fetch = (input, init) => {\n    const raw = init?.body\n    if (typeof raw === 'string' || raw instanceof Uint8Array) {\n        const body = JSON.parse(Buffer.from(raw).toString('utf8'))\n        body.injected = true\n        init = { ...init, body:JSON.stringify(body) }\n    }\n    return original(input, init)\n}\n`\n\ntest('m3: a changed request body field names its (model, turns) group',\n    async t => {\n        const d = stubDir()\n        t.cleanup(() => d.remove())\n        const hook = path.join(d.dir, 'hook.mjs')\n        fs.writeFileSync(hook, FETCH_HOOK)\n        const injected:Cli = {\n            name:'injected',\n            command:process.execPath,\n            args:['--import', hook, CLI_JS],\n        }\n        const r = await runScenario(m3Scenario('clean review'),\n            { go:TS_CLI, ts:injected })\n        const sent:RecordedRequest[] = r.ts.requests\n        t.ok(sent.some(q => groupKey(q) === FINDER_FIRST),\n            'the finder request was sent')\n        t.deepEqual(r.unexplained.map(x => x.path),\n            [`requests[${FINDER_FIRST}][0].body.injected`],\n            'the difference names the group and the field')\n    })\n// A fake inference server for review scenarios (spec 15, 2.13 step 1):\n// each reply is chosen by request content -- the model name plus the\n// number of conversation turns, the same key the request comparison\n// groups by -- never by arrival order, because finder and verifier\n// calls may interleave differently on the two CLIs.\nimport {\n    type InferenceServer,\n    type Reply,\n    type RecordedRequest,\n    startInferenceServer,\n} from '../helpers/inference-server.js'\nimport { groupKey } from './requests.js'\n\n// Replies by `<model>#<turns>`.\nexport type ReplyTable = Readonly<Record<string, Reply>>\n\n// A request without a scripted reply gets a 404 naming its key, so a\n// scenario that drifts fails loudly on both sides.\nexport function replyFor (table:ReplyTable, req:RecordedRequest):Reply {\n    const key = groupKey(req)\n    const r = Object.hasOwn(table, key) ? table[key] : undefined\n    if (r === undefined) {\n        return { status:404, body:`no scripted reply for ${key}` }\n    }\n    return r\n}\n\nexport function scriptedServer (table:ReplyTable):Promise<InferenceServer> {\n    return startInferenceServer(req => replyFor(table, req))\n}\n983f518 redeye: update ticket checklists\n67b0d54 redeye: 26-harness-m3-review-scenarios.md done\nf2e98ef redeye: 24-runs-checkout-and-prune.md done\n4e2ee7d docs: harness review-scenario notes; spec 07 open question on the nudge tool\n4f150e1 diff harness: M3 review scenarios on chat\n8e36075 diff harness: normalize finding identity, snapshot OIDs, SDK headers, compressed bytes\nc7d7bdc Merge branch 'roast--ts-rewrite-24-runs-checkout-and-prune' into wip\nc95b1b6 redeye: update ticket checklists","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DNHJN4kfwEz4gMW2NLzCx6","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
