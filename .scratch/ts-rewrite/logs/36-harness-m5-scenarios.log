{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EZXKFeiEhcGF8tz93Dcd36","type":"tool_result","content":"38\t\n39\t// Untracked files the snapshot captures (`notes.txt`) or must leave out\n40\t// (secret denylist, spec 11).\n41\tconst UNTRACKED = { 'notes.txt':'kept\\n' }\n42\tconst SECRETS = ['server.pem', 'id_rsa', 'creds.txt']\n43\t\n44\tfunction withSecrets ():Record<string, string> {\n45\t    const out:Record<string, string> = { 'main.go':CHANGED, ...UNTRACKED }\n46\t    for (const name of SECRETS) out[name] = `secret ${name}\\n`\n47\t    return out\n48\t}\n49\t\n50\tconst CHECKOUT:Scenario = {\n51\t    ...afterTwoReviews('runs checkout', {\n52\t        // Relative to the repository (the working directory), so the\n53\t        // target lands beside it in the side's private directory.\n54\t        argv:side => ['runs', 'checkout', side.runIds[0] ?? 'missing',\n55\t            '../checkout'],\n56\t        tree:'checkout',\n57\t        absent:SECRETS,\n58\t    }),\n59\t    changes:withSecrets(),\n60\t}\n61\t\n62\tconst SNAPSHOT_REFS = 'refs/roast/snapshots/'\n63\t// The second review's snapshot commit is dated in the future, so it is\n64\t// never old enough to prune; the first carries the fixture's fixed\n65\t// committer date, months in the past.\n66\tconst FUTURE = { env:{ GIT_COMMITTER_DATE:'2099-01-01T00:00:00Z' } }\n67\t\n68\t// Human-readable output (`runs`, and the Markdown report `runs show`\n69\t// prints) is never compared (2.13 step 6); only exit codes are.\n70\texport const M5_SCENARIOS:readonly Scenario[] = [\n71\t    afterTwoReviews('runs', { argv:['runs'] }),\n72\t    afterTwoReviews('runs --json', {\n73\t        argv:['runs', '--json'],\n74\t        stdout:'jsonl',\n75\t    }),\n76\t    afterTwoReviews('runs --limit 1 --json', {\n77\t        argv:['runs', '--limit', '1', '--json'],\n78\t        stdout:'jsonl',\n79\t    }),\n80\t    afterTwoReviews('runs show', {\n81\t        argv:side => ['runs', 'show', side.runIds[0] ?? 'missing'],\n82\t    }),\n83\t    CHECKOUT,\n84\t    afterTwoReviews('runs prune --dry-run', {\n85\t        argv:['runs', 'prune', '--dry-run'],\n86\t        refs:SNAPSHOT_REFS,\n87\t    }),\n88\t    afterTwoReviews('runs prune --older-than', {\n89\t        argv:['runs', 'prune', '--older-than', '24h'],\n90\t        refs:SNAPSHOT_REFS,\n91\t    }, FUTURE),\n92\t    ...INIT_SCENARIOS,\n93\t]\n94\t\n95\t// `init --no-login` in a fresh repository: no server, no trust step.\n96\t// Model IDs need only be placeable; init never calls the provider.\n97\tfunction init (\n98\t    name:string,\n99\t    finder:string,\n100\t    verifier:string,\n101\t    files:Record<string, string>\n102\t):Scenario {\n103\t    return {\n104\t        name:`init: ${name}`,\n105\t        files:{ 'README.md':'fixture\\n', ...files },\n106\t        argv:['init', '--finder-model', finder, '--verifier-model', verifier,\n107\t            '--no-login'],\n108\t        written:['.roast.json', '.gitignore'],\n109\t    }\n110\t}\n111\t\n112\tconst INIT_SCENARIOS:readonly Scenario[] = [\n113\t    init('OpenAI and Anthropic', 'gpt-fake-1', 'claude-fake-1', {}),\n114\t    // An existing .gitignore without a final newline is appended to.\n115\t    init('OpenRouter', 'fakevendor/fake-model', 'otherfake/model-2',\n116\t        { '.gitignore':'node_modules/' }),\n117\t    init('unplaceable model', 'Not A Model', 'claude-fake-1',\n118\t        { '.gitignore':'node_modules/\\n' }),\n119\t]\n120\t\n121\texport function m5Scenario (name:string):Scenario {\n122\t    const s = M5_SCENARIOS.find(x => x.name === name)\n123\t    if (!s) throw new Error(`no M5 scenario ${name}`)\n124\t    return s\n125\t}\n126\t"}]},"parent_tool_use_id":null,"session_id":"7a121785-8a13-4050-8d25-20fb8f8a9a84","uuid":"e769b977-1dd3-432f-a91d-dca1558e8a4c","timestamp":"2026-11-24T03:02:53.578Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.ts-rewrite-36-harness-m5-scenarios/test/diff/scenarios/m5.ts","content":"\n// Untracked files the snapshot captures (`notes.txt`) or must leave out\n// (secret denylist, spec 11).\nconst UNTRACKED = { 'notes.txt':'kept\\n' }\nconst SECRETS = ['server.pem', 'id_rsa', 'creds.txt']\n\nfunction withSecrets ():Record<string, string> {\n    const out:Record<string, string> = { 'main.go':CHANGED, ...UNTRACKED }\n    for (const name of SECRETS) out[name] = `secret ${name}\\n`\n    return out\n}\n\nconst CHECKOUT:Scenario = {\n    ...afterTwoReviews('runs checkout', {\n        // Relative to the repository (the working directory), so the\n        // target lands beside it in the side's private directory.\n        argv:side => ['runs', 'checkout', side.runIds[0] ?? 'missing',\n            '../checkout'],\n        tree:'checkout',\n        absent:SECRETS,\n    }),\n    changes:withSecrets(),\n}\n\nconst SNAPSHOT_REFS = 'refs/roast/snapshots/'\n// The second review's snapshot commit is dated in the future, so it is\n// never old enough to prune; the first carries the fixture's fixed\n// committer date, months in the past.\nconst FUTURE = { env:{ GIT_COMMITTER_DATE:'2099-01-01T00:00:00Z' } }\n\n// Human-readable output (`runs`, and the Markdown report `runs show`\n// prints) is never compared (2.13 step 6); only exit codes are.\nexport const M5_SCENARIOS:readonly Scenario[] = [\n    afterTwoReviews('runs', { argv:['runs'] }),\n    afterTwoReviews('runs --json', {\n        argv:['runs', '--json'],\n        stdout:'jsonl',\n    }),\n    afterTwoReviews('runs --limit 1 --json', {\n        argv:['runs', '--limit', '1', '--json'],\n        stdout:'jsonl',\n    }),\n    afterTwoReviews('runs show', {\n        argv:side => ['runs', 'show', side.runIds[0] ?? 'missing'],\n    }),\n    CHECKOUT,\n    afterTwoReviews('runs prune --dry-run', {\n        argv:['runs', 'prune', '--dry-run'],\n        refs:SNAPSHOT_REFS,\n    }),\n    afterTwoReviews('runs prune --older-than', {\n        argv:['runs', 'prune', '--older-than', '24h'],\n        refs:SNAPSHOT_REFS,\n    }, FUTURE),\n    ...INIT_SCENARIOS,\n]\n\n// `init --no-login` in a fresh repository: no server, no trust step.\n// Model IDs need only be placeable; init never calls the provider.\nfunction init (\n    name:string,\n    finder:string,\n    verifier:string,\n    files:Record<string, string>\n):Scenario {\n    return {\n        name:`init: ${name}`,\n        files:{ 'README.md':'fixture\\n', ...files },\n        argv:['init', '--finder-model', finder, '--verifier-model', verifier,\n            '--no-login'],\n        written:['.roast.json', '.gitignore'],\n    }\n}\n\nconst INIT_SCENARIOS:readonly Scenario[] = [\n    init('OpenAI and Anthropic', 'gpt-fake-1', 'claude-fake-1', {}),\n    // An existing .gitignore without a final newline is appended to.\n    init('OpenRouter', 'fakevendor/fake-model', 'otherfake/model-2',\n        { '.gitignore':'node_modules/' }),\n    init('unplaceable model', 'Not A Model', 'claude-fake-1',\n        { '.gitignore':'node_modules/\\n' }),\n]\n\nexport function m5Scenario (name:string):Scenario {\n    const s = M5_SCENARIOS.find(x => x.name === name)\n    if (!s) throw new Error(`no M5 scenario ${name}`)\n    return s\n}\n","numLines":89,"startLine":38,"totalLines":126}},"tool_result_meta":[{"id":"toolu_01EZXKFeiEhcGF8tz93Dcd36","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
