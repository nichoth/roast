xport const M5_SCENARIOS:readonly Scenario[] = [\n    afterTwoReviews('runs', { argv:['runs'] }),\n    afterTwoReviews('runs --json', {\n        argv:['runs', '--json'],\n        stdout:'jsonl',\n    }),\n    afterTwoReviews('runs --limit 1 --json', {\n        argv:['runs', '--limit', '1', '--json'],\n        stdout:'jsonl',\n    }),\n    afterTwoReviews('runs show', {\n        argv:side => ['runs', 'show', side.runIds[0] ?? 'missing'],\n    }),\n]\n\nexport function m5Scenario (name:string):Scenario {\n    const s = M5_SCENARIOS.find(x => x.name === name)\n    if (!s) throw new Error(`no M5 scenario ${name}`)\n    return s\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_013aAHPEYz6QkpHGpEeiUKFs","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
