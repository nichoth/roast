{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAzy8H6mBHyDbSbnj3Cx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PbnrswMTXWXJUrZbpUwW1Z","name":"Bash","input":{"command":"cat src/llm/types.ts src/llm/client.ts src/llm/errors.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24457,"cache_read_input_tokens":65199,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24457},"output_tokens":32,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"79353e88-0eda-49f3-aae4-5b092ab34fc4","uuid":"b5c56616-911d-477b-a478-f1f67d76d3eb","timestamp":"2026-11-18T20:09:53.198Z","request_id":"req_011ChAzy7VU6914mngcSh2x5","wire_tool_inputs":{"toolu_01PbnrswMTXWXJUrZbpUwW1Z":{"command":"cd /Users/nick/code/roast.ts-rewrite-14-agent-loop-token-ledger && cat src/llm/types.ts src/llm/client.ts src/llm/errors.ts"}},"wire_ingest_context":{"toolu_01PbnrswMTXWXJUrZbpUwW1Z":{"cwd":"/Users/nick/code/roast.ts-rewrite-14-agent-loop-token-ledger"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PbnrswMTXWXJUrZbpUwW1Z","type":"tool_result","content":"// Protocol-neutral types for the LLM layer (spec 06, 3.1; spec 07, 3.3).\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\n\nexport interface RawResponse {\n    role:string;\n    protocol:Protocol;\n    model:string;\n    contentType:'application/json'|'text/event-stream';\n    // Exact bytes of the body: no request, no headers.\n    body:Uint8Array;\n}\n\nexport interface ClientConfig {\n    // \"finder\", \"verifier\", or a doctor check name.\n    role:string;\n    baseUrl:string;\n    apiKey:string;\n    // Sent verbatim as the body's `model`.\n    model:string;\n    // \"\" means chat.\n    protocol:''|Protocol;\n    maxOutputTokens:number;\n    // Attempts per model call; <= 0 means DEFAULT_MAX_ATTEMPTS.\n    maxAttempts:number;\n    // Per request; 0 disables.\n    requestTimeoutMs:number;\n    sessionHeader?:string;\n    captureResponse?:(raw:RawResponse) => Promise<void>|void;\n    // Overrides the module-level fetch (http.ts) for this client.\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface ToolDefinition {\n    name:string;\n    description:string;\n    // The complete caller JSON Schema.\n    schema:Record<string, unknown>;\n}\n\n// A tool the agent loop offers the model (spec 07, 3.3). The final tool\n// has no `run`.\nexport interface Tool {\n    name:string;\n    description:string;\n    schema:Record<string, unknown>;\n    run?:(args:Record<string, unknown>, signal:AbortSignal) =>\n        unknown|Promise<unknown>;\n    recordsResult?:boolean;\n}\n\nexport type AssistantPart =\n    | { type:'text', text:string }\n    | {\n        type:'reasoning';\n        text:string;\n        signature?:string;\n        redactedData?:string;\n    }\n    // `input` is the raw argument string as received.\n    | { type:'tool-call', id:string, name:string, input:string }\n\nexport interface ToolResult {\n    callId:string;\n    name:string;\n    output:string;\n    isError:boolean;\n}\n\nexport type ConversationItem =\n    | { role:'user', text:string }\n    | { role:'assistant', parts:AssistantPart[] }\n    | { role:'tool', results:ToolResult[] }\n\nexport interface Usage {\n    uncachedInputTokens:number;\n    cachedInputTokens:number;\n    cacheWriteTokens:number;\n    outputTokens:number;\n    calls:number;\n}\n\nexport interface ModelRequest {\n    system:string;\n    items:ConversationItem[];\n    tools:ToolDefinition[];\n    sessionId:string;\n    // Already composed by the agent loop (caller, deadline, timeout).\n    signal:AbortSignal;\n    onUsage?:(usage:Usage) => void;\n}\n\nexport type FinishReason =\n    'stop'|'length'|'content-filter'|'tool-calls'|'error'|'other'|'unknown'\n\nexport interface ModelTurn {\n    // Arrival order; replayed verbatim.\n    parts:AssistantPart[];\n    finishReason:FinishReason;\n    rawFinishReason?:string;\n    // Normalized, calls: 1.\n    usage:Usage;\n}\n// `createModelClient` and `send` (spec 06, 3.2): one model turn becomes\n// exactly one HTTP request in the profile's protocol. Never retries.\n\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport { abortable, CaptureGate, openCapturedBody } from './capture.js'\nimport { chatUrl, decodeChat, encodeChat } from './chat.js'\nimport {\n    CaptureError,\n    EndpointError,\n    ProviderError,\n    SENTINEL_MESSAGE,\n} from './errors.js'\nimport { currentFetch, requestHeaders } from './http.js'\nimport { parseSse, type SseEvent } from './sse.js'\nimport type {\n    ClientConfig,\n    ModelRequest,\n    ModelTurn,\n    Protocol,\n    Usage,\n} from './types.js'\nimport { UsageAccumulator } from './usage.js'\n\nexport const DEFAULT_MAX_ATTEMPTS = 4\n\n// Error bodies are read at most this far (deliberate change 9).\nexport const MAX_ERROR_BODY = 32 * 1024\n\nexport interface ModelClient {\n    readonly config:Readonly<ClientConfig>;\n    // '' normalized to 'chat'.\n    readonly protocol:Protocol;\n    // <= 0 normalized to DEFAULT_MAX_ATTEMPTS.\n    readonly maxAttempts:number;\n    // One HTTP attempt. Resolves only after capture succeeded.\n    send (request:ModelRequest):Promise<ModelTurn>;\n    // Exact byte length of the request body `send` would post.\n    requestBytes (request:ModelRequest):number;\n    // Accumulated usage across all calls on this client.\n    usage ():Usage;\n}\n\ninterface Adapter {\n    url (baseUrl:string):string;\n    encode (config:ClientConfig, request:ModelRequest):unknown;\n    decode (events:AsyncIterable<SseEvent>):Promise<ModelTurn>;\n}\n\nconst ADAPTERS:Partial<Record<Protocol, Adapter>> = {\n    chat:{\n        url:chatUrl,\n        encode:(config, request) => encodeChat(config, request),\n        decode:decodeChat,\n    },\n}\n\nfunction adapterFor (protocol:string):Adapter {\n    const known = protocol === 'chat' || protocol === 'responses' ||\n        protocol === 'anthropic'\n    const adapter = known ? ADAPTERS[protocol as Protocol] : undefined\n    if (!adapter) {\n        throw new Error(`unsupported inference protocol \"${protocol}\"`)\n    }\n    return adapter\n}\n\n// Best-effort provider error fields from an OpenAI-style\n// `{\"error\":{...}}` or Anthropic `{\"type\":\"error\",\"error\":{...}}` body.\nfunction providerFields (text:string):{\n    type?:string;\n    code?:string;\n    message?:string;\n} {\n    try {\n        const parsed:unknown = JSON.parse(text)\n        if (parsed === null || typeof parsed !== 'object') return {}\n        const e = (parsed as { error?:unknown }).error\n        if (e === null || typeof e !== 'object') return {}\n        const { type, code, message } = e as Record<string, unknown>\n        return {\n            type:typeof type === 'string' ? type : undefined,\n            code:typeof code === 'string' ?\n                code :\n                typeof code === 'number' ? String(code) : undefined,\n            message:typeof message === 'string' ? message : undefined,\n        }\n    } catch {\n        return {}\n    }\n}\n\nasync function readCapped (\n    body:ReadableStream<Uint8Array>|null,\n    limit:number,\n    signal:AbortSignal\n):Promise<Uint8Array> {\n    if (!body) return new Uint8Array(0)\n    const reader = body.getReader()\n    const parts:Uint8Array[] = []\n    let size = 0\n    let eof = false\n    try {\n        while (size < limit) {\n            const r = await abortable(reader.read(), signal)\n            if (r.done) {\n                eof = true\n                break\n            }\n            const take = r.value.subarray(0, limit - size)\n            parts.push(take)\n            size += take.length\n        }\n    } finally {\n        if (!eof) await reader.cancel().catch(() => {})\n    }\n    const out = new Uint8Array(size)\n    let off = 0\n    for (const p of parts) {\n        out.set(p, off)\n        off += p.length\n    }\n    return out\n}\n\nasync function httpError (\n    response:Response,\n    url:string,\n    model:string,\n    signal:AbortSignal\n):Promise<Error> {\n    const bytes = await readCapped(response.body, MAX_ERROR_BODY, signal)\n    const text = new TextDecoder().decode(bytes)\n    const fields = providerFields(text)\n    const headers:Record<string, string> = {}\n    response.headers.forEach((value, name) => { headers[name] = value })\n    const detail = fields.message ?? text.slice(0, 512).trim()\n    const status = `${response.status} ${response.statusText}`.trim()\n    const err = new ProviderError(\n        `POST \"${url}\": ${status}${detail ? `: ${detail}` : ''}`,\n        {\n            status:response.status,\n            headers,\n            providerType:fields.type,\n            providerCode:fields.code,\n            providerMessage:fields.message,\n        })\n    if (response.status >= 300 && response.status < 400) {\n        return new EndpointError(\n            `${SENTINEL_MESSAGE.endpoint}: ${model}: redirect refused: ` +\n                err.message,\n            { cause:err, details:{ model } })\n    }\n    return err\n}\n\nexport function createModelClient (config:ClientConfig):ModelClient {\n    if (!(config.maxOutputTokens > 0)) {\n        throw new Error(`${config.model}: max output tokens must be positive`)\n    }\n    if (goTrimSpace(config.apiKey) === '') {\n        throw new Error(`${config.model}: API key is not configured`)\n    }\n    const protocol = (config.protocol === '' ?\n        'chat' :\n        config.protocol) as Protocol\n    const adapter = adapterFor(protocol)\n    const maxAttempts = config.maxAttempts > 0 ?\n        config.maxAttempts :\n        DEFAULT_MAX_ATTEMPTS\n    const gate = new CaptureGate()\n    const total = new UsageAccumulator()\n    const url = adapter.url(config.baseUrl)\n\n    function encodeBody (request:ModelRequest):Uint8Array {\n        const body = adapter.encode(config, request)\n        return new TextEncoder().encode(JSON.stringify(body))\n    }\n\n    async function attempt (\n        request:ModelRequest,\n        signal:AbortSignal\n    ):Promise<ModelTurn> {\n        const fetchFn = config.fetch ?? currentFetch()\n        const response = await fetchFn(url, {\n            method:'POST',\n            headers:requestHeaders(protocol, config.apiKey,\n                request.sessionId, config.sessionHeader),\n            body:encodeBody(request),\n            redirect:'manual',\n            signal,\n        })\n        if (response.status < 200 || response.status >= 300) {\n            throw await httpError(response, url, config.model, signal)\n        }\n        const body = await openCapturedBody(response, {\n            role:config.role,\n            protocol,\n            model:config.model,\n            captureResponse:config.captureResponse,\n        }, gate, signal)\n        let turn:ModelTurn|undefined\n        let failure:unknown\n        try {\n            turn = await adapter.decode(parseSse(body.chunks))\n        } catch (err) {\n            failure = err\n        }\n        if (turn) {\n            total.add(turn.usage)\n            request.onUsage?.(turn.usage)\n        }\n        // A capture failure here replaces any turn or error.\n        await body.release()\n        if (!turn) throw failure\n        signal.throwIfAborted()\n        return turn\n    }\n\n    return {\n        config,\n        protocol,\n        maxAttempts,\n        requestBytes (request:ModelRequest):number {\n            return encodeBody(request).length\n        },\n        usage ():Usage {\n            return total.total()\n        },\n        async send (request:ModelRequest):Promise<ModelTurn> {\n            if (gate.failure) throw gate.failure\n            request.signal.throwIfAborted()\n            const timeout = config.requestTimeoutMs > 0 ?\n                AbortSignal.timeout(config.requestTimeoutMs) :\n                undefined\n            const signal = timeout ?\n                AbortSignal.any([request.signal, timeout]) :\n                request.signal\n            try {\n                return await attempt(request, signal)\n            } catch (err) {\n                if (err instanceof CaptureError) throw err\n                if (request.signal.aborted) throw request.signal.reason\n                if (timeout?.aborted) {\n                    throw new EndpointError(\n                        `${SENTINEL_MESSAGE.endpoint}: ${config.model}: ` +\n                            'request timed out after ' +\n                            `${config.requestTimeoutMs}ms`,\n                        {\n                            cause:timeout.reason,\n                            details:{ model:config.model },\n                        })\n                }\n                throw err\n            }\n        },\n    }\n}\n// The llm area's error vocabulary (spec 06, 2.10 and 3.4; spec 07, 3.4).\n// The CLI maps errors to exit codes and categories by walking an error's\n// `cause` chain (src/cli/errors.ts); callers test sentinels with\n// `hasSentinel`.\n\nimport type { FinishReason } from './types.js'\n\nexport type LlmErrorKind =\n    'auth'|'endpoint'|'budget_exhausted'|'work_deadline'|'no_final_call'\n\nexport type Sentinel = 'no-final-call'|'work-deadline'|\n    'budget-exhausted'|'auth'|'endpoint'\n\nexport interface ErrorDetails {\n    model?:string;\n    finishReason?:FinishReason;\n    rawFinishReason?:string;\n    submissionAttempts?:number;\n    recordRounds?:number;\n    stopCause?:string;\n}\n\nexport interface LlmErrorOptions extends ErrorOptions {\n    details?:ErrorDetails;\n    // Extra sentinels besides the kind's own (cutoff errors).\n    sentinels?:Sentinel[];\n}\n\nconst KIND_SENTINEL:Record<LlmErrorKind, Sentinel> = {\n    auth:'auth',\n    endpoint:'endpoint',\n    budget_exhausted:'budget-exhausted',\n    work_deadline:'work-deadline',\n    no_final_call:'no-final-call',\n}\n\n// Go sentinel messages (spec 07, 2.14).\nexport const SENTINEL_MESSAGE:Record<Sentinel, string> = {\n    'no-final-call':'llm: tool loop ended without a final tool call',\n    'work-deadline':'llm: work deadline reached',\n    'budget-exhausted':'llm: run token budget exhausted',\n    auth:'llm: authentication failed',\n    endpoint:'llm: inference endpoint failure',\n}\n\nexport class LlmError extends Error {\n    readonly kind:LlmErrorKind\n    readonly sentinels:ReadonlySet<Sentinel>\n    readonly details:ErrorDetails\n\n    constructor (\n        kind:LlmErrorKind,\n        message:string,\n        options?:LlmErrorOptions\n    ) {\n        super(message, options)\n        this.kind = kind\n        this.name = 'LlmError'\n        this.sentinels = new Set([\n            KIND_SENTINEL[kind],\n            ...(options?.sentinels ?? []),\n        ])\n        this.details = { ...options?.details }\n    }\n}\n\n// The provider rejected the credential (401 or 403).\nexport class AuthError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('auth', message, options)\n        this.name = 'AuthError'\n    }\n}\n\n// The endpoint failed: transport errors, redirects, 5xx, bad responses.\nexport class EndpointError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('endpoint', message, options)\n        this.name = 'EndpointError'\n    }\n}\n\n// The token budget ran out.\nexport class BudgetExhaustedError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('budget_exhausted', message, options)\n        this.name = 'BudgetExhaustedError'\n    }\n}\n\n// The work deadline passed.\nexport class WorkDeadlineError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('work_deadline', message, options)\n        this.name = 'WorkDeadlineError'\n    }\n}\n\n// The agent loop ended without the required final tool call.\nexport class NoFinalCallError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('no_final_call', message, options)\n        this.name = 'NoFinalCallError'\n    }\n}\n\nexport interface ProviderErrorOptions extends ErrorOptions {\n    status?:number;\n    // Lowercased names.\n    headers?:Record<string, string>;\n    providerType?:string;\n    providerCode?:string;\n    providerMessage?:string;\n    retryable?:boolean;\n}\n\n// One failed model call: an HTTP error, an error inside a 200 stream, an\n// incomplete stream, a transport failure, or a protocol error.\nexport class ProviderError extends Error {\n    readonly status?:number\n    readonly headers?:Record<string, string>\n    readonly providerType?:string\n    readonly providerCode?:string\n    readonly providerMessage?:string\n    readonly retryable:boolean\n\n    constructor (message:string, options:ProviderErrorOptions = {}) {\n        super(message, options)\n        this.name = 'ProviderError'\n        this.status = options.status\n        this.headers = options.headers\n        this.providerType = options.providerType\n        this.providerCode = options.providerCode\n        this.providerMessage = options.providerMessage\n        this.retryable = options.retryable ??\n            (options.status !== undefined &&\n                httpRetryable(options.status, options.headers ?? {}))\n    }\n}\n\n// The body ended cleanly without the protocol's terminal signal.\nexport class IncompleteStreamError extends ProviderError {\n    constructor () {\n        super('stream transport error: unexpected EOF', { retryable:true })\n        this.name = 'IncompleteStreamError'\n    }\n}\n\n// Capturing a raw response failed. Permanent: never retried, and it\n// disables the client.\nexport class CaptureError extends Error {\n    constructor (message:string, options?:ErrorOptions) {\n        super(message, options)\n        this.name = 'CaptureError'\n    }\n}\n\nconst PARSE_BOOL_TRUE = new Set(['1', 't', 'T', 'true', 'TRUE', 'True'])\n\nfunction httpRetryable (\n    status:number,\n    headers:Record<string, string>\n):boolean {\n    const should = headers['x-should-retry']\n    if (should !== undefined && PARSE_BOOL_TRUE.has(should)) return true\n    return status === 408 || status === 409 || status === 429 ||\n        status >= 500\n}\n\nconst TRANSIENT_STREAM_TYPES = new Set([\n    'server_error',\n    'internal_error',\n    'overloaded_error',\n    'api_error',\n    'rate_limit_error',\n])\n\n// An error delivered inside a 200 stream; retryable for transient\n// provider types (the code stands in when the type is empty).\nexport function streamError (\n    type:string,\n    code:string,\n    message:string\n):ProviderError {\n    const kind = type || code\n    const label = kind ? `${kind}: ${message}` : message\n    return new ProviderError(`stream error: ${label}`, {\n        providerType:type || undefined,\n        providerCode:code || undefined,\n        providerMessage:message,\n        retryable:TRANSIENT_STREAM_TYPES.has(kind),\n    })\n}\n\n// Each error in `err`'s cause chain, outermost first; cycle safe.\nfunction * chain (err:unknown):Generator<Error> {\n    const seen = new Set<unknown>()\n    let cur = err\n    while (cur instanceof Error && !seen.has(cur)) {\n        seen.add(cur)\n        yield cur\n        cur = cur.cause\n    }\n}\n\nexport function hasSentinel (err:unknown, s:Sentinel):boolean {\n    for (const e of chain(err)) {\n        if (e instanceof LlmError && e.sentinels.has(s)) return true\n    }\n    return false\n}\n\nfunction isAbortLike (e:Error):boolean {\n    return e.name === 'AbortError' || e.name === 'TimeoutError'\n}\n\nconst TRANSPORT_CODES = new Set([\n    'ECONNRESET',\n    'ECONNREFUSED',\n    'ENOTFOUND',\n    'EAI_AGAIN',\n    'ETIMEDOUT',\n    'EPIPE',\n    'ECONNABORTED',\n    'EHOSTUNREACH',\n    'ENETUNREACH',\n    'ERR_STREAM_PREMATURE_CLOSE',\n])\n\nfunction isTransport (e:Error):boolean {\n    const code = (e as { code?:unknown }).code\n    if (typeof code !== 'string') return false\n    return TRANSPORT_CODES.has(code) || code.startsWith('UND_ERR_')\n}\n\nexport function isRetryable (err:unknown):boolean {\n    const errs = [...chain(err)]\n    if (errs.some(e => isAbortLike(e) || e instanceof CaptureError)) {\n        return false\n    }\n    const provider = errs.find(e => e instanceof ProviderError)\n    if (provider) return provider.retryable\n    return errs.some(isTransport)\n}\n\nconst MAX_HINT_MS = 60_000\n\nfunction headerHintMs (\n    headers:Record<string, string>,\n    now:number\n):number|undefined {\n    const ms = parseNumber(headers['retry-after-ms'])\n    if (ms !== undefined) return ms\n    const after = headers['retry-after']\n    if (after === undefined) return undefined\n    const secs = parseNumber(after)\n    if (secs !== undefined) return secs * 1000\n    const date = Date.parse(after)\n    return Number.isNaN(date) ? undefined : date - now\n}\n\nfunction parseNumber (s:string|undefined):number|undefined {\n    if (s === undefined || s.trim() === '') return undefined\n    const n = Number(s)\n    return Number.isFinite(n) ? n : undefined\n}\n\n// The delay before the next attempt: the provider's hint when it is\n// positive and under 60 s or under the backoff, else the backoff.\nexport function retryDelayMs (\n    err:unknown,\n    backoffMs:number,\n    now:number = Date.now()\n):number {\n    for (const e of chain(err)) {\n        if (!(e instanceof ProviderError) || !e.headers) continue\n        const hint = headerHintMs(e.headers, now)\n        if (hint !== undefined && hint > 0 &&\n            (hint < MAX_HINT_MS || hint < backoffMs)) {\n            return hint\n        }\n        break\n    }\n    return backoffMs\n}\n\nexport function errorStatus (err:unknown):number|undefined {\n    for (const e of chain(err)) {\n        const status = (e as { status?:unknown }).status\n        if (typeof status === 'number') return status\n    }\n    return undefined\n}\n\nfunction endpointFailure (model:string, err:unknown):EndpointError {\n    const msg = err instanceof Error ? err.message : String(err)\n    return new EndpointError(\n        `${SENTINEL_MESSAGE.endpoint}: ${model}: ${msg}`,\n        { cause:err, details:{ model } })\n}\n\n// Maps an error that escapes the agent loop (spec 06, 2.10).\nexport function normalizeProviderError (\n    outer:AbortSignal,\n    model:string,\n    err:unknown\n):unknown {\n    if (outer.aborted) return outer.reason\n    if ([...chain(err)].some(isAbortLike)) return endpointFailure(model, err)\n    if (hasSentinel(err, 'auth') || hasSentinel(err, 'endpoint') ||\n        hasSentinel(err, 'budget-exhausted')) {\n        return err\n    }\n    const status = errorStatus(err)\n    if (status === 401 || status === 403) {\n        const msg = err instanceof Error ? err.message : String(err)\n        return new AuthError(\n            `${SENTINEL_MESSAGE.auth}: ${msg}; check the configured API key`,\n            { cause:err, details:{ model } })\n    }\n    return endpointFailure(model, err)\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"79353e88-0eda-49f3-aae4-5b092ab34fc4","uuid":"320bf807-af1e-4024-86b9-9debab73cb58","timestamp":"2026-11-18T20:09:53.262Z","tool_use_result":{"stdout":"// Protocol-neutral types for the LLM layer (spec 06, 3.1; spec 07, 3.3).\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\n\nexport interface RawResponse {\n    role:string;\n    protocol:Protocol;\n    model:string;\n    contentType:'application/json'|'text/event-stream';\n    // Exact bytes of the body: no request, no headers.\n    body:Uint8Array;\n}\n\nexport interface ClientConfig {\n    // \"finder\", \"verifier\", or a doctor check name.\n    role:string;\n    baseUrl:string;\n    apiKey:string;\n    // Sent verbatim as the body's `model`.\n    model:string;\n    // \"\" means chat.\n    protocol:''|Protocol;\n    maxOutputTokens:number;\n    // Attempts per model call; <= 0 means DEFAULT_MAX_ATTEMPTS.\n    maxAttempts:number;\n    // Per request; 0 disables.\n    requestTimeoutMs:number;\n    sessionHeader?:string;\n    captureResponse?:(raw:RawResponse) => Promise<void>|void;\n    // Overrides the module-level fetch (http.ts) for this client.\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface ToolDefinition {\n    name:string;\n    description:string;\n    // The complete caller JSON Schema.\n    schema:Record<string, unknown>;\n}\n\n// A tool the agent loop offers the model (spec 07, 3.3). The final tool\n// has no `run`.\nexport interface Tool {\n    name:string;\n    description:string;\n    schema:Record<string, unknown>;\n    run?:(args:Record<string, unknown>, signal:AbortSignal) =>\n        unknown|Promise<unknown>;\n    recordsResult?:boolean;\n}\n\nexport type AssistantPart =\n    | { type:'text', text:string }\n    | {\n        type:'reasoning';\n        text:string;\n        signature?:string;\n        redactedData?:string;\n    }\n    // `input` is the raw argument string as received.\n    | { type:'tool-call', id:string, name:string, input:string }\n\nexport interface ToolResult {\n    callId:string;\n    name:string;\n    output:string;\n    isError:boolean;\n}\n\nexport type ConversationItem =\n    | { role:'user', text:string }\n    | { role:'assistant', parts:AssistantPart[] }\n    | { role:'tool', results:ToolResult[] }\n\nexport interface Usage {\n    uncachedInputTokens:number;\n    cachedInputTokens:number;\n    cacheWriteTokens:number;\n    outputTokens:number;\n    calls:number;\n}\n\nexport interface ModelRequest {\n    system:string;\n    items:ConversationItem[];\n    tools:ToolDefinition[];\n    sessionId:string;\n    // Already composed by the agent loop (caller, deadline, timeout).\n    signal:AbortSignal;\n    onUsage?:(usage:Usage) => void;\n}\n\nexport type FinishReason =\n    'stop'|'length'|'content-filter'|'tool-calls'|'error'|'other'|'unknown'\n\nexport interface ModelTurn {\n    // Arrival order; replayed verbatim.\n    parts:AssistantPart[];\n    finishReason:FinishReason;\n    rawFinishReason?:string;\n    // Normalized, calls: 1.\n    usage:Usage;\n}\n// `createModelClient` and `send` (spec 06, 3.2): one model turn becomes\n// exactly one HTTP request in the profile's protocol. Never retries.\n\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport { abortable, CaptureGate, openCapturedBody } from './capture.js'\nimport { chatUrl, decodeChat, encodeChat } from './chat.js'\nimport {\n    CaptureError,\n    EndpointError,\n    ProviderError,\n    SENTINEL_MESSAGE,\n} from './errors.js'\nimport { currentFetch, requestHeaders } from './http.js'\nimport { parseSse, type SseEvent } from './sse.js'\nimport type {\n    ClientConfig,\n    ModelRequest,\n    ModelTurn,\n    Protocol,\n    Usage,\n} from './types.js'\nimport { UsageAccumulator } from './usage.js'\n\nexport const DEFAULT_MAX_ATTEMPTS = 4\n\n// Error bodies are read at most this far (deliberate change 9).\nexport const MAX_ERROR_BODY = 32 * 1024\n\nexport interface ModelClient {\n    readonly config:Readonly<ClientConfig>;\n    // '' normalized to 'chat'.\n    readonly protocol:Protocol;\n    // <= 0 normalized to DEFAULT_MAX_ATTEMPTS.\n    readonly maxAttempts:number;\n    // One HTTP attempt. Resolves only after capture succeeded.\n    send (request:ModelRequest):Promise<ModelTurn>;\n    // Exact byte length of the request body `send` would post.\n    requestBytes (request:ModelRequest):number;\n    // Accumulated usage across all calls on this client.\n    usage ():Usage;\n}\n\ninterface Adapter {\n    url (baseUrl:string):string;\n    encode (config:ClientConfig, request:ModelRequest):unknown;\n    decode (events:AsyncIterable<SseEvent>):Promise<ModelTurn>;\n}\n\nconst ADAPTERS:Partial<Record<Protocol, Adapter>> = {\n    chat:{\n        url:chatUrl,\n        encode:(config, request) => encodeChat(config, request),\n        decode:decodeChat,\n    },\n}\n\nfunction adapterFor (protocol:string):Adapter {\n    const known = protocol === 'chat' || protocol === 'responses' ||\n        protocol === 'anthropic'\n    const adapter = known ? ADAPTERS[protocol as Protocol] : undefined\n    if (!adapter) {\n        throw new Error(`unsupported inference protocol \"${protocol}\"`)\n    }\n    return adapter\n}\n\n// Best-effort provider error fields from an OpenAI-style\n// `{\"error\":{...}}` or Anthropic `{\"type\":\"error\",\"error\":{...}}` body.\nfunction providerFields (text:string):{\n    type?:string;\n    code?:string;\n    message?:string;\n} {\n    try {\n        const parsed:unknown = JSON.parse(text)\n        if (parsed === null || typeof parsed !== 'object') return {}\n        const e = (parsed as { error?:unknown }).error\n        if (e === null || typeof e !== 'object') return {}\n        const { type, code, message } = e as Record<string, unknown>\n        return {\n            type:typeof type === 'string' ? type : undefined,\n            code:typeof code === 'string' ?\n                code :\n                typeof code === 'number' ? String(code) : undefined,\n            message:typeof message === 'string' ? message : undefined,\n        }\n    } catch {\n        return {}\n    }\n}\n\nasync function readCapped (\n    body:ReadableStream<Uint8Array>|null,\n    limit:number,\n    signal:AbortSignal\n):Promise<Uint8Array> {\n    if (!body) return new Uint8Array(0)\n    const reader = body.getReader()\n    const parts:Uint8Array[] = []\n    let size = 0\n    let eof = false\n    try {\n        while (size < limit) {\n            const r = await abortable(reader.read(), signal)\n            if (r.done) {\n                eof = true\n                break\n            }\n            const take = r.value.subarray(0, limit - size)\n            parts.push(take)\n            size += take.length\n        }\n    } finally {\n        if (!eof) await reader.cancel().catch(() => {})\n    }\n    const out = new Uint8Array(size)\n    let off = 0\n    for (const p of parts) {\n        out.set(p, off)\n        off += p.length\n    }\n    return out\n}\n\nasync function httpError (\n    response:Response,\n    url:string,\n    model:string,\n    signal:AbortSignal\n):Promise<Error> {\n    const bytes = await readCapped(response.body, MAX_ERROR_BODY, signal)\n    const text = new TextDecoder().decode(bytes)\n    const fields = providerFields(text)\n    const headers:Record<string, string> = {}\n    response.headers.forEach((value, name) => { headers[name] = value })\n    const detail = fields.message ?? text.slice(0, 512).trim()\n    const status = `${response.status} ${response.statusText}`.trim()\n    const err = new ProviderError(\n        `POST \"${url}\": ${status}${detail ? `: ${detail}` : ''}`,\n        {\n            status:response.status,\n            headers,\n            providerType:fields.type,\n            providerCode:fields.code,\n            providerMessage:fields.message,\n        })\n    if (response.status >= 300 && response.status < 400) {\n        return new EndpointError(\n            `${SENTINEL_MESSAGE.endpoint}: ${model}: redirect refused: ` +\n                err.message,\n            { cause:err, details:{ model } })\n    }\n    return err\n}\n\nexport function createModelClient (config:ClientConfig):ModelClient {\n    if (!(config.maxOutputTokens > 0)) {\n        throw new Error(`${config.model}: max output tokens must be positive`)\n    }\n    if (goTrimSpace(config.apiKey) === '') {\n        throw new Error(`${config.model}: API key is not configured`)\n    }\n    const protocol = (config.protocol === '' ?\n        'chat' :\n        config.protocol) as Protocol\n    const adapter = adapterFor(protocol)\n    const maxAttempts = config.maxAttempts > 0 ?\n        config.maxAttempts :\n        DEFAULT_MAX_ATTEMPTS\n    const gate = new CaptureGate()\n    const total = new UsageAccumulator()\n    const url = adapter.url(config.baseUrl)\n\n    function encodeBody (request:ModelRequest):Uint8Array {\n        const body = adapter.encode(config, request)\n        return new TextEncoder().encode(JSON.stringify(body))\n    }\n\n    async function attempt (\n        request:ModelRequest,\n        signal:AbortSignal\n    ):Promise<ModelTurn> {\n        const fetchFn = config.fetch ?? currentFetch()\n        const response = await fetchFn(url, {\n            method:'POST',\n            headers:requestHeaders(protocol, config.apiKey,\n                request.sessionId, config.sessionHeader),\n            body:encodeBody(request),\n            redirect:'manual',\n            signal,\n        })\n        if (response.status < 200 || response.status >= 300) {\n            throw await httpError(response, url, config.model, signal)\n        }\n        const body = await openCapturedBody(response, {\n            role:config.role,\n            protocol,\n            model:config.model,\n            captureResponse:config.captureResponse,\n        }, gate, signal)\n        let turn:ModelTurn|undefined\n        let failure:unknown\n        try {\n            turn = await adapter.decode(parseSse(body.chunks))\n        } catch (err) {\n            failure = err\n        }\n        if (turn) {\n            total.add(turn.usage)\n            request.onUsage?.(turn.usage)\n        }\n        // A capture failure here replaces any turn or error.\n        await body.release()\n        if (!turn) throw failure\n        signal.throwIfAborted()\n        return turn\n    }\n\n    return {\n        config,\n        protocol,\n        maxAttempts,\n        requestBytes (request:ModelRequest):number {\n            return encodeBody(request).length\n        },\n        usage ():Usage {\n            return total.total()\n        },\n        async send (request:ModelRequest):Promise<ModelTurn> {\n            if (gate.failure) throw gate.failure\n            request.signal.throwIfAborted()\n            const timeout = config.requestTimeoutMs > 0 ?\n                AbortSignal.timeout(config.requestTimeoutMs) :\n                undefined\n            const signal = timeout ?\n                AbortSignal.any([request.signal, timeout]) :\n                request.signal\n            try {\n                return await attempt(request, signal)\n            } catch (err) {\n                if (err instanceof CaptureError) throw err\n                if (request.signal.aborted) throw request.signal.reason\n                if (timeout?.aborted) {\n                    throw new EndpointError(\n                        `${SENTINEL_MESSAGE.endpoint}: ${config.model}: ` +\n                            'request timed out after ' +\n                            `${config.requestTimeoutMs}ms`,\n                        {\n                            cause:timeout.reason,\n                            details:{ model:config.model },\n                        })\n                }\n                throw err\n            }\n        },\n    }\n}\n// The llm area's error vocabulary (spec 06, 2.10 and 3.4; spec 07, 3.4).\n// The CLI maps errors to exit codes and categories by walking an error's\n// `cause` chain (src/cli/errors.ts); callers test sentinels with\n// `hasSentinel`.\n\nimport type { FinishReason } from './types.js'\n\nexport type LlmErrorKind =\n    'auth'|'endpoint'|'budget_exhausted'|'work_deadline'|'no_final_call'\n\nexport type Sentinel = 'no-final-call'|'work-deadline'|\n    'budget-exhausted'|'auth'|'endpoint'\n\nexport interface ErrorDetails {\n    model?:string;\n    finishReason?:FinishReason;\n    rawFinishReason?:string;\n    submissionAttempts?:number;\n    recordRounds?:number;\n    stopCause?:string;\n}\n\nexport interface LlmErrorOptions extends ErrorOptions {\n    details?:ErrorDetails;\n    // Extra sentinels besides the kind's own (cutoff errors).\n    sentinels?:Sentinel[];\n}\n\nconst KIND_SENTINEL:Record<LlmErrorKind, Sentinel> = {\n    auth:'auth',\n    endpoint:'endpoint',\n    budget_exhausted:'budget-exhausted',\n    work_deadline:'work-deadline',\n    no_final_call:'no-final-call',\n}\n\n// Go sentinel messages (spec 07, 2.14).\nexport const SENTINEL_MESSAGE:Record<Sentinel, string> = {\n    'no-final-call':'llm: tool loop ended without a final tool call',\n    'work-deadline':'llm: work deadline reached',\n    'budget-exhausted':'llm: run token budget exhausted',\n    auth:'llm: authentication failed',\n    endpoint:'llm: inference endpoint failure',\n}\n\nexport class LlmError extends Error {\n    readonly kind:LlmErrorKind\n    readonly sentinels:ReadonlySet<Sentinel>\n    readonly details:ErrorDetails\n\n    constructor (\n        kind:LlmErrorKind,\n        message:string,\n        options?:LlmErrorOptions\n    ) {\n        super(message, options)\n        this.kind = kind\n        this.name = 'LlmError'\n        this.sentinels = new Set([\n            KIND_SENTINEL[kind],\n            ...(options?.sentinels ?? []),\n        ])\n        this.details = { ...options?.details }\n    }\n}\n\n// The provider rejected the credential (401 or 403).\nexport class AuthError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('auth', message, options)\n        this.name = 'AuthError'\n    }\n}\n\n// The endpoint failed: transport errors, redirects, 5xx, bad responses.\nexport class EndpointError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('endpoint', message, options)\n        this.name = 'EndpointError'\n    }\n}\n\n// The token budget ran out.\nexport class BudgetExhaustedError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('budget_exhausted', message, options)\n        this.name = 'BudgetExhaustedError'\n    }\n}\n\n// The work deadline passed.\nexport class WorkDeadlineError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('work_deadline', message, options)\n        this.name = 'WorkDeadlineError'\n    }\n}\n\n// The agent loop ended without the required final tool call.\nexport class NoFinalCallError extends LlmError {\n    constructor (message:string, options?:LlmErrorOptions) {\n        super('no_final_call', message, options)\n        this.name = 'NoFinalCallError'\n    }\n}\n\nexport interface ProviderErrorOptions extends ErrorOptions {\n    status?:number;\n    // Lowercased names.\n    headers?:Record<string, string>;\n    providerType?:string;\n    providerCode?:string;\n    providerMessage?:string;\n    retryable?:boolean;\n}\n\n// One failed model call: an HTTP error, an error inside a 200 stream, an\n// incomplete stream, a transport failure, or a protocol error.\nexport class ProviderError extends Error {\n    readonly status?:number\n    readonly headers?:Record<string, string>\n    readonly providerType?:string\n    readonly providerCode?:string\n    readonly providerMessage?:string\n    readonly retryable:boolean\n\n    constructor (message:string, options:ProviderErrorOptions = {}) {\n        super(message, options)\n        this.name = 'ProviderError'\n        this.status = options.status\n        this.headers = options.headers\n        this.providerType = options.providerType\n        this.providerCode = options.providerCode\n        this.providerMessage = options.providerMessage\n        this.retryable = options.retryable ??\n            (options.status !== undefined &&\n                httpRetryable(options.status, options.headers ?? {}))\n    }\n}\n\n// The body ended cleanly without the protocol's terminal signal.\nexport class IncompleteStreamError extends ProviderError {\n    constructor () {\n        super('stream transport error: unexpected EOF', { retryable:true })\n        this.name = 'IncompleteStreamError'\n    }\n}\n\n// Capturing a raw response failed. Permanent: never retried, and it\n// disables the client.\nexport class CaptureError extends Error {\n    constructor (message:string, options?:ErrorOptions) {\n        super(message, options)\n        this.name = 'CaptureError'\n    }\n}\n\nconst PARSE_BOOL_TRUE = new Set(['1', 't', 'T', 'true', 'TRUE', 'True'])\n\nfunction httpRetryable (\n    status:number,\n    headers:Record<string, string>\n):boolean {\n    const should = headers['x-should-retry']\n    if (should !== undefined && PARSE_BOOL_TRUE.has(should)) return true\n    return status === 408 || status === 409 || status === 429 ||\n        status >= 500\n}\n\nconst TRANSIENT_STREAM_TYPES = new Set([\n    'server_error',\n    'internal_error',\n    'overloaded_error',\n    'api_error',\n    'rate_limit_error',\n])\n\n// An error delivered inside a 200 stream; retryable for transient\n// provider types (the code stands in when the type is empty).\nexport function streamError (\n    type:string,\n    code:string,\n    message:string\n):ProviderError {\n    const kind = type || code\n    const label = kind ? `${kind}: ${message}` : message\n    return new ProviderError(`stream error: ${label}`, {\n        providerType:type || undefined,\n        providerCode:code || undefined,\n        providerMessage:message,\n        retryable:TRANSIENT_STREAM_TYPES.has(kind),\n    })\n}\n\n// Each error in `err`'s cause chain, outermost first; cycle safe.\nfunction * chain (err:unknown):Generator<Error> {\n    const seen = new Set<unknown>()\n    let cur = err\n    while (cur instanceof Error && !seen.has(cur)) {\n        seen.add(cur)\n        yield cur\n        cur = cur.cause\n    }\n}\n\nexport function hasSentinel (err:unknown, s:Sentinel):boolean {\n    for (const e of chain(err)) {\n        if (e instanceof LlmError && e.sentinels.has(s)) return true\n    }\n    return false\n}\n\nfunction isAbortLike (e:Error):boolean {\n    return e.name === 'AbortError' || e.name === 'TimeoutError'\n}\n\nconst TRANSPORT_CODES = new Set([\n    'ECONNRESET',\n    'ECONNREFUSED',\n    'ENOTFOUND',\n    'EAI_AGAIN',\n    'ETIMEDOUT',\n    'EPIPE',\n    'ECONNABORTED',\n    'EHOSTUNREACH',\n    'ENETUNREACH',\n    'ERR_STREAM_PREMATURE_CLOSE',\n])\n\nfunction isTransport (e:Error):boolean {\n    const code = (e as { code?:unknown }).code\n    if (typeof code !== 'string') return false\n    return TRANSPORT_CODES.has(code) || code.startsWith('UND_ERR_')\n}\n\nexport function isRetryable (err:unknown):boolean {\n    const errs = [...chain(err)]\n    if (errs.some(e => isAbortLike(e) || e instanceof CaptureError)) {\n        return false\n    }\n    const provider = errs.find(e => e instanceof ProviderError)\n    if (provider) return provider.retryable\n    return errs.some(isTransport)\n}\n\nconst MAX_HINT_MS = 60_000\n\nfunction headerHintMs (\n    headers:Record<string, string>,\n    now:number\n):number|undefined {\n    const ms = parseNumber(headers['retry-after-ms'])\n    if (ms !== undefined) return ms\n    const after = headers['retry-after']\n    if (after === undefined) return undefined\n    const secs = parseNumber(after)\n    if (secs !== undefined) return secs * 1000\n    const date = Date.parse(after)\n    return Number.isNaN(date) ? undefined : date - now\n}\n\nfunction parseNumber (s:string|undefined):number|undefined {\n    if (s === undefined || s.trim() === '') return undefined\n    const n = Number(s)\n    return Number.isFinite(n) ? n : undefined\n}\n\n// The delay before the next attempt: the provider's hint when it is\n// positive and under 60 s or under the backoff, else the backoff.\nexport function retryDelayMs (\n    err:unknown,\n    backoffMs:number,\n    now:number = Date.now()\n):number {\n    for (const e of chain(err)) {\n        if (!(e instanceof ProviderError) || !e.headers) continue\n        const hint = headerHintMs(e.headers, now)\n        if (hint !== undefined && hint > 0 &&\n            (hint < MAX_HINT_MS || hint < backoffMs)) {\n            return hint\n        }\n        break\n    }\n    return backoffMs\n}\n\nexport function errorStatus (err:unknown):number|undefined {\n    for (const e of chain(err)) {\n        const status = (e as { status?:unknown }).status\n        if (typeof status === 'number') return status\n    }\n    return undefined\n}\n\nfunction endpointFailure (model:string, err:unknown):EndpointError {\n    const msg = err instanceof Error ? err.message : String(err)\n    return new EndpointError(\n        `${SENTINEL_MESSAGE.endpoint}: ${model}: ${msg}`,\n        { cause:err, details:{ model } })\n}\n\n// Maps an error that escapes the agent loop (spec 06, 2.10).\nexport function normalizeProviderError (\n    outer:AbortSignal,\n    model:string,\n    err:unknown\n):unknown {\n    if (outer.aborted) return outer.reason\n    if ([...chain(err)].some(isAbortLike)) return endpointFailure(model, err)\n    if (hasSentinel(err, 'auth') || hasSentinel(err, 'endpoint') ||\n        hasSentinel(err, 'budget-exhausted')) {\n        return err\n    }\n    const status = errorStatus(err)\n    if (status === 401 || status === 403) {\n        const msg = err instanceof Error ? err.message : String(err)\n        return new AuthError(\n            `${SENTINEL_MESSAGE.auth}: ${msg}; check the configured API key`,\n            { cause:err, details:{ model } })\n    }\n    return endpointFailure(model, err)\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PbnrswMTXWXJUrZbpUwW1Z","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
