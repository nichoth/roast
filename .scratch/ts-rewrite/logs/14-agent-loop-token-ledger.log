{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017tHbg6a4zMvBDmbLgcD56P","type":"tool_result","content":"// Usage normalization (spec 06, 2.9): provider fields -> disjoint\n// intermediate counts (stage 1, per protocol) -> Usage (stage 2, shared).\n// Cached tokens are subtracted exactly once (deliberate change 13).\n\nimport type { Usage } from './types.js'\n\nexport interface IntermediateUsage {\n    input:number;\n    cacheRead:number;\n    cacheWrite:number;\n    output:number;\n}\n\nfunction num (v:unknown):number {\n    return typeof v === 'number' && Number.isFinite(v) ? v : 0\n}\n\nfunction obj (v:unknown):Record<string, unknown> {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Record<string, unknown> :\n        {}\n}\n\n// Stage 1 for `chat`: the `usage` object of a completion chunk.\nexport function chatUsage (raw:unknown):IntermediateUsage {\n    const u = obj(raw)\n    const prompt = num(u.prompt_tokens)\n    const cached = num(obj(u.prompt_tokens_details).cached_tokens)\n    const output = num(u.completion_tokens)\n    const reasoning = num(obj(u.completion_tokens_details).reasoning_tokens)\n    return {\n        input:Math.max(prompt - cached, 0),\n        cacheRead:cached,\n        cacheWrite:0,\n        output:reasoning > output ? output + reasoning : output,\n    }\n}\n\n// Stage 2: clamp every count to >= 0; one call.\nexport function normalizeUsage (u:IntermediateUsage):Usage {\n    return {\n        uncachedInputTokens:Math.max(u.input, 0),\n        cachedInputTokens:Math.max(u.cacheRead, 0),\n        cacheWriteTokens:Math.max(u.cacheWrite, 0),\n        outputTokens:Math.max(u.output, 0),\n        calls:1,\n    }\n}\n\nexport function zeroUsage ():Usage {\n    return {\n        uncachedInputTokens:0,\n        cachedInputTokens:0,\n        cacheWriteTokens:0,\n        outputTokens:0,\n        calls:0,\n    }\n}\n\n// A client's running total across its calls.\nexport class UsageAccumulator {\n    private sum:Usage = zeroUsage()\n\n    add (u:Usage):void {\n        this.sum.uncachedInputTokens += u.uncachedInputTokens\n        this.sum.cachedInputTokens += u.cachedInputTokens\n        this.sum.cacheWriteTokens += u.cacheWriteTokens\n        this.sum.outputTokens += u.outputTokens\n        this.sum.calls += u.calls\n    }\n\n    total ():Usage {\n        return { ...this.sum }\n    }\n}\n// Conversation session IDs (spec 06, 2.3): `roast-` plus 26 characters of\n// the RFC 4648 base32 alphabet, 128 bits from a CSPRNG (Go\n// `\"roast-\" + rand.Text()`).\n\nconst ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'\n\n// Unpadded base32 of 16 random bytes.\nexport function newSessionId ():string {\n    const bytes = crypto.getRandomValues(new Uint8Array(16))\n    let out = ''\n    let acc = 0\n    let bits = 0\n    for (const b of bytes) {\n        acc = (acc << 8) | b\n        bits += 8\n        while (bits >= 5) {\n            bits -= 5\n            out += ALPHABET[(acc >>> bits) & 31]\n        }\n        acc &= (1 << bits) - 1\n    }\n    if (bits > 0) out += ALPHABET[(acc << (5 - bits)) & 31]\n    return `roast-${out}`\n}\n// The one tool-result JSON encoder, and decoding of model text (spec 06,\n// 3.5; spec.md cross-cutting \"JSON encoding\" and \"Bytes and text\").\n\n// Object keys sorted in UTF-16 code-unit order at every depth, matching\n// Go's map ordering so prompts stay stable. JSON.stringify never escapes\n// `<`, `>`, `&`, U+2028 or U+2029.\nexport function encodeToolResult (value:unknown):string {\n    return JSON.stringify(value, (_key, v:unknown) => {\n        if (v === null || typeof v !== 'object' || Array.isArray(v)) {\n            return v\n        }\n        const sorted:Record<string, unknown> = {}\n        for (const k of Object.keys(v).sort()) {\n            sorted[k] = (v as Record<string, unknown>)[k]\n        }\n        return sorted\n    })\n}\n\n// `s` with every lone UTF-16 surrogate replaced by U+FFFD.\nexport function wellFormed (s:string):string {\n    let out = ''\n    let start = 0\n    for (let i = 0; i < s.length; i++) {\n        const c = s.charCodeAt(i)\n        if (c < 0xd800 || c > 0xdfff) continue\n        if (c <= 0xdbff && i + 1 < s.length) {\n            const d = s.charCodeAt(i + 1)\n            if (d >= 0xdc00 && d <= 0xdfff) {\n                i++\n                continue\n            }\n        }\n        out += s.slice(start, i) + '\\ufffd'\n        start = i + 1\n    }\n    return start === 0 ? s : out + s.slice(start)\n}\n\n// UTF-8 bytes from a provider as text: invalid sequences become U+FFFD.\nexport function decodeModelText (bytes:Uint8Array):string {\n    return wellFormed(new TextDecoder('utf-8').decode(bytes))\n}\n// Model-ID rules (spec 06, 2.6).\n\nconst REASONING = /(?:^|[-.])(?:o[134]|oss)|gpt-[5-9]|codex-|computer-use/\nconst CLASSIC_CHAT = /gpt-3|gpt-4|chatgpt-|-chat/\n\n// Chat reasoning models take `max_completion_tokens` instead of\n// `max_tokens`.\nexport function isChatReasoningModel (id:string):boolean {\n    const lower = id.toLowerCase()\n    return REASONING.test(lower) && !CLASSIC_CHAT.test(lower)\n}\n\n// How the `responses` protocol sends the system prompt.\nexport function responsesSystemMode (\n    id:string\n):'system'|'developer'|'remove' {\n    if (CLASSIC_CHAT.test(id.toLowerCase())) return 'system'\n    if (id.includes('o1-mini') || id.includes('o1-preview')) return 'remove'\n    return 'developer'\n}\n\n// Models that get adaptive thinking by default on `anthropic`.\nexport function anthropicDefaultThinking (id:string):boolean {\n    return id.toLowerCase().includes('claude-mythos-preview')\n}\n// The `chat` protocol (OpenAI Chat Completions; OpenRouter, DeepSeek,\n// others): a pure request encoder and stream decoder (spec 06, 2.6.1 and\n// 2.8.1).\n\nimport {\n    IncompleteStreamError,\n    ProviderError,\n    streamError,\n} from './errors.js'\nimport { wellFormed } from './json.js'\nimport { isChatReasoningModel } from './models.js'\nimport type { SseEvent } from './sse.js'\nimport type {\n    AssistantPart,\n    ConversationItem,\n    FinishReason,\n    ModelTurn,\n    ToolDefinition,\n} from './types.js'\nimport { chatUsage, normalizeUsage } from './usage.js'\n\nexport interface EncodeConfig {\n    model:string;\n    maxOutputTokens:number;\n}\n\nexport interface EncodeRequest {\n    system:string;\n    items:readonly ConversationItem[];\n    tools:readonly ToolDefinition[];\n}\n\nexport function trimSlashes (url:string):string {\n    let end = url.length\n    while (end > 0 && url.charCodeAt(end - 1) === 47) end--\n    return url.slice(0, end)\n}\n\nexport function chatUrl (baseUrl:string):string {\n    return `${trimSlashes(baseUrl)}/chat/completions`\n}\n\nfunction assistantMessage (\n    parts:readonly AssistantPart[]\n):Record<string, unknown>|null {\n    const texts:string[] = []\n    const reasoning:string[] = []\n    const calls:unknown[] = []\n    for (const p of parts) {\n        if (p.type === 'text') texts.push(p.text)\n        else if (p.type === 'reasoning') reasoning.push(p.text)\n        else {\n            calls.push({\n                id:p.id,\n                type:'function',\n                function:{ name:p.name, arguments:p.input },\n            })\n        }\n    }\n    if (texts.length === 0 && calls.length === 0) return null\n    const msg:Record<string, unknown> = { role:'assistant' }\n    if (texts.length > 0) msg.content = texts.join('\\n')\n    if (calls.length > 0) msg.tool_calls = calls\n    if (reasoning.length > 0) msg.reasoning_content = reasoning.join('\\n')\n    return msg\n}\n\nfunction messages (req:EncodeRequest):unknown[] {\n    const out:unknown[] = []\n    if (req.system !== '') out.push({ role:'system', content:req.system })\n    for (const item of req.items) {\n        if (item.role === 'user') {\n            out.push({ role:'user', content:item.text })\n        } else if (item.role === 'assistant') {\n            const msg = assistantMessage(item.parts)\n            if (msg) out.push(msg)\n        } else {\n            for (const r of item.results) {\n                out.push({\n                    role:'tool',\n                    tool_call_id:r.callId,\n                    content:r.output,\n                })\n            }\n        }\n    }\n    return out\n}\n\n// The request body. Tool choice is always automatic.\nexport function encodeChat (\n    config:EncodeConfig,\n    req:EncodeRequest\n):Record<string, unknown> {\n    const body:Record<string, unknown> = {\n        model:config.model,\n        messages:messages(req),\n    }\n    if (isChatReasoningModel(config.model)) {\n        body.max_completion_tokens = config.maxOutputTokens\n    } else {\n        body.max_tokens = config.maxOutputTokens\n    }\n    body.stream = true\n    body.stream_options = { include_usage:true }\n    if (req.tools.length > 0) {\n        body.tools = req.tools.map(tool => ({\n            type:'function',\n            function:{\n                name:tool.name,\n                description:tool.description ?? '',\n                parameters:structuredClone(tool.schema),\n                strict:false,\n            },\n        }))\n        body.tool_choice = 'auto'\n    }\n    return body\n}\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\nfunction str (v:unknown):string {\n    return typeof v === 'string' ? wellFormed(v) : ''\n}\n\nfunction protocolError (message:string, cause?:unknown):ProviderError {\n    return new ProviderError(message, { retryable:false, cause })\n}\n\ninterface OpenCall {\n    index:number;\n    id:string;\n    name:string;\n// The single test entry: imports every test module.\nimport './tooling/buildinfo.js'\nimport './tooling/startup.js'\nimport './tooling/bundle.js'\nimport './tooling/run-import.js'\nimport './tooling/assets.js'\nimport './tooling/test-tap.js'\nimport './tooling/licenses.js'\nimport './tooling/check-package.js'\nimport './textsafe/textsafe.js'\nimport './gocompat/strings.js'\nimport './gocompat/duration.js'\nimport './gocompat/match.js'\nimport './fsutil/atomic.js'\nimport './git/git.js'\nimport './util/pool.js'\nimport './snapshot/denylist.js'\nimport './scope/glob.js'\nimport './scope/patch.js'\nimport './scope/build.js'\nimport './scope/names.js'\nimport './scope/renames.js'\nimport './scope/fit.js'\nimport './scope/staged.js'\nimport './scope/huge.js'\nimport './scope/hardening.js'\nimport './scope/linguist.js'\nimport './scope/abort.js'\nimport './scope/bytes.js'\nimport './cli/errors.js'\nimport './cli/terminal.js'\nimport './cli/env.js'\nimport './cli/run.js'\nimport './cli/process.js'\nimport './cli/log.js'\nimport './skill/assets.js'\nimport './skill/skill.js'\nimport './cli/skill.js'\nimport './llm/sse.js'\nimport './llm/json.js'\nimport './llm/errors.js'\nimport './llm/usage.js'\nimport './llm/chat-encode.js'\nimport './llm/chat-decode.js'\nimport './llm/capture.js'\nimport './llm/client.js'\nimport './context/paths.js'\nimport './context/normalize.js'\nimport './context/grounding.js'\nimport './context/snippet.js'\nimport './context/tree.js'\nimport './context/hardening.js'\nimport './context/bounds.js'\nimport './config/find.js'\nimport './config/load.js'\nimport './config/schema.js'\nimport './tooling/schema.js'\nimport './cli/gate-settings.js'\n// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"79353e88-0eda-49f3-aae4-5b092ab34fc4","uuid":"40584a1a-65d6-405a-9c59-7daae5871c95","timestamp":"2026-11-18T20:10:00.166Z","tool_use_result":{"stdout":"// Usage normalization (spec 06, 2.9): provider fields -> disjoint\n// intermediate counts (stage 1, per protocol) -> Usage (stage 2, shared).\n// Cached tokens are subtracted exactly once (deliberate change 13).\n\nimport type { Usage } from './types.js'\n\nexport interface IntermediateUsage {\n    input:number;\n    cacheRead:number;\n    cacheWrite:number;\n    output:number;\n}\n\nfunction num (v:unknown):number {\n    return typeof v === 'number' && Number.isFinite(v) ? v : 0\n}\n\nfunction obj (v:unknown):Record<string, unknown> {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Record<string, unknown> :\n        {}\n}\n\n// Stage 1 for `chat`: the `usage` object of a completion chunk.\nexport function chatUsage (raw:unknown):IntermediateUsage {\n    const u = obj(raw)\n    const prompt = num(u.prompt_tokens)\n    const cached = num(obj(u.prompt_tokens_details).cached_tokens)\n    const output = num(u.completion_tokens)\n    const reasoning = num(obj(u.completion_tokens_details).reasoning_tokens)\n    return {\n        input:Math.max(prompt - cached, 0),\n        cacheRead:cached,\n        cacheWrite:0,\n        output:reasoning > output ? output + reasoning : output,\n    }\n}\n\n// Stage 2: clamp every count to >= 0; one call.\nexport function normalizeUsage (u:IntermediateUsage):Usage {\n    return {\n        uncachedInputTokens:Math.max(u.input, 0),\n        cachedInputTokens:Math.max(u.cacheRead, 0),\n        cacheWriteTokens:Math.max(u.cacheWrite, 0),\n        outputTokens:Math.max(u.output, 0),\n        calls:1,\n    }\n}\n\nexport function zeroUsage ():Usage {\n    return {\n        uncachedInputTokens:0,\n        cachedInputTokens:0,\n        cacheWriteTokens:0,\n        outputTokens:0,\n        calls:0,\n    }\n}\n\n// A client's running total across its calls.\nexport class UsageAccumulator {\n    private sum:Usage = zeroUsage()\n\n    add (u:Usage):void {\n        this.sum.uncachedInputTokens += u.uncachedInputTokens\n        this.sum.cachedInputTokens += u.cachedInputTokens\n        this.sum.cacheWriteTokens += u.cacheWriteTokens\n        this.sum.outputTokens += u.outputTokens\n        this.sum.calls += u.calls\n    }\n\n    total ():Usage {\n        return { ...this.sum }\n    }\n}\n// Conversation session IDs (spec 06, 2.3): `roast-` plus 26 characters of\n// the RFC 4648 base32 alphabet, 128 bits from a CSPRNG (Go\n// `\"roast-\" + rand.Text()`).\n\nconst ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'\n\n// Unpadded base32 of 16 random bytes.\nexport function newSessionId ():string {\n    const bytes = crypto.getRandomValues(new Uint8Array(16))\n    let out = ''\n    let acc = 0\n    let bits = 0\n    for (const b of bytes) {\n        acc = (acc << 8) | b\n        bits += 8\n        while (bits >= 5) {\n            bits -= 5\n            out += ALPHABET[(acc >>> bits) & 31]\n        }\n        acc &= (1 << bits) - 1\n    }\n    if (bits > 0) out += ALPHABET[(acc << (5 - bits)) & 31]\n    return `roast-${out}`\n}\n// The one tool-result JSON encoder, and decoding of model text (spec 06,\n// 3.5; spec.md cross-cutting \"JSON encoding\" and \"Bytes and text\").\n\n// Object keys sorted in UTF-16 code-unit order at every depth, matching\n// Go's map ordering so prompts stay stable. JSON.stringify never escapes\n// `<`, `>`, `&`, U+2028 or U+2029.\nexport function encodeToolResult (value:unknown):string {\n    return JSON.stringify(value, (_key, v:unknown) => {\n        if (v === null || typeof v !== 'object' || Array.isArray(v)) {\n            return v\n        }\n        const sorted:Record<string, unknown> = {}\n        for (const k of Object.keys(v).sort()) {\n            sorted[k] = (v as Record<string, unknown>)[k]\n        }\n        return sorted\n    })\n}\n\n// `s` with every lone UTF-16 surrogate replaced by U+FFFD.\nexport function wellFormed (s:string):string {\n    let out = ''\n    let start = 0\n    for (let i = 0; i < s.length; i++) {\n        const c = s.charCodeAt(i)\n        if (c < 0xd800 || c > 0xdfff) continue\n        if (c <= 0xdbff && i + 1 < s.length) {\n            const d = s.charCodeAt(i + 1)\n            if (d >= 0xdc00 && d <= 0xdfff) {\n                i++\n                continue\n            }\n        }\n        out += s.slice(start, i) + '\\ufffd'\n        start = i + 1\n    }\n    return start === 0 ? s : out + s.slice(start)\n}\n\n// UTF-8 bytes from a provider as text: invalid sequences become U+FFFD.\nexport function decodeModelText (bytes:Uint8Array):string {\n    return wellFormed(new TextDecoder('utf-8').decode(bytes))\n}\n// Model-ID rules (spec 06, 2.6).\n\nconst REASONING = /(?:^|[-.])(?:o[134]|oss)|gpt-[5-9]|codex-|computer-use/\nconst CLASSIC_CHAT = /gpt-3|gpt-4|chatgpt-|-chat/\n\n// Chat reasoning models take `max_completion_tokens` instead of\n// `max_tokens`.\nexport function isChatReasoningModel (id:string):boolean {\n    const lower = id.toLowerCase()\n    return REASONING.test(lower) && !CLASSIC_CHAT.test(lower)\n}\n\n// How the `responses` protocol sends the system prompt.\nexport function responsesSystemMode (\n    id:string\n):'system'|'developer'|'remove' {\n    if (CLASSIC_CHAT.test(id.toLowerCase())) return 'system'\n    if (id.includes('o1-mini') || id.includes('o1-preview')) return 'remove'\n    return 'developer'\n}\n\n// Models that get adaptive thinking by default on `anthropic`.\nexport function anthropicDefaultThinking (id:string):boolean {\n    return id.toLowerCase().includes('claude-mythos-preview')\n}\n// The `chat` protocol (OpenAI Chat Completions; OpenRouter, DeepSeek,\n// others): a pure request encoder and stream decoder (spec 06, 2.6.1 and\n// 2.8.1).\n\nimport {\n    IncompleteStreamError,\n    ProviderError,\n    streamError,\n} from './errors.js'\nimport { wellFormed } from './json.js'\nimport { isChatReasoningModel } from './models.js'\nimport type { SseEvent } from './sse.js'\nimport type {\n    AssistantPart,\n    ConversationItem,\n    FinishReason,\n    ModelTurn,\n    ToolDefinition,\n} from './types.js'\nimport { chatUsage, normalizeUsage } from './usage.js'\n\nexport interface EncodeConfig {\n    model:string;\n    maxOutputTokens:number;\n}\n\nexport interface EncodeRequest {\n    system:string;\n    items:readonly ConversationItem[];\n    tools:readonly ToolDefinition[];\n}\n\nexport function trimSlashes (url:string):string {\n    let end = url.length\n    while (end > 0 && url.charCodeAt(end - 1) === 47) end--\n    return url.slice(0, end)\n}\n\nexport function chatUrl (baseUrl:string):string {\n    return `${trimSlashes(baseUrl)}/chat/completions`\n}\n\nfunction assistantMessage (\n    parts:readonly AssistantPart[]\n):Record<string, unknown>|null {\n    const texts:string[] = []\n    const reasoning:string[] = []\n    const calls:unknown[] = []\n    for (const p of parts) {\n        if (p.type === 'text') texts.push(p.text)\n        else if (p.type === 'reasoning') reasoning.push(p.text)\n        else {\n            calls.push({\n                id:p.id,\n                type:'function',\n                function:{ name:p.name, arguments:p.input },\n            })\n        }\n    }\n    if (texts.length === 0 && calls.length === 0) return null\n    const msg:Record<string, unknown> = { role:'assistant' }\n    if (texts.length > 0) msg.content = texts.join('\\n')\n    if (calls.length > 0) msg.tool_calls = calls\n    if (reasoning.length > 0) msg.reasoning_content = reasoning.join('\\n')\n    return msg\n}\n\nfunction messages (req:EncodeRequest):unknown[] {\n    const out:unknown[] = []\n    if (req.system !== '') out.push({ role:'system', content:req.system })\n    for (const item of req.items) {\n        if (item.role === 'user') {\n            out.push({ role:'user', content:item.text })\n        } else if (item.role === 'assistant') {\n            const msg = assistantMessage(item.parts)\n            if (msg) out.push(msg)\n        } else {\n            for (const r of item.results) {\n                out.push({\n                    role:'tool',\n                    tool_call_id:r.callId,\n                    content:r.output,\n                })\n            }\n        }\n    }\n    return out\n}\n\n// The request body. Tool choice is always automatic.\nexport function encodeChat (\n    config:EncodeConfig,\n    req:EncodeRequest\n):Record<string, unknown> {\n    const body:Record<string, unknown> = {\n        model:config.model,\n        messages:messages(req),\n    }\n    if (isChatReasoningModel(config.model)) {\n        body.max_completion_tokens = config.maxOutputTokens\n    } else {\n        body.max_tokens = config.maxOutputTokens\n    }\n    body.stream = true\n    body.stream_options = { include_usage:true }\n    if (req.tools.length > 0) {\n        body.tools = req.tools.map(tool => ({\n            type:'function',\n            function:{\n                name:tool.name,\n                description:tool.description ?? '',\n                parameters:structuredClone(tool.schema),\n                strict:false,\n            },\n        }))\n        body.tool_choice = 'auto'\n    }\n    return body\n}\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\nfunction str (v:unknown):string {\n    return typeof v === 'string' ? wellFormed(v) : ''\n}\n\nfunction protocolError (message:string, cause?:unknown):ProviderError {\n    return new ProviderError(message, { retryable:false, cause })\n}\n\ninterface OpenCall {\n    index:number;\n    id:string;\n    name:string;\n// The single test entry: imports every test module.\nimport './tooling/buildinfo.js'\nimport './tooling/startup.js'\nimport './tooling/bundle.js'\nimport './tooling/run-import.js'\nimport './tooling/assets.js'\nimport './tooling/test-tap.js'\nimport './tooling/licenses.js'\nimport './tooling/check-package.js'\nimport './textsafe/textsafe.js'\nimport './gocompat/strings.js'\nimport './gocompat/duration.js'\nimport './gocompat/match.js'\nimport './fsutil/atomic.js'\nimport './git/git.js'\nimport './util/pool.js'\nimport './snapshot/denylist.js'\nimport './scope/glob.js'\nimport './scope/patch.js'\nimport './scope/build.js'\nimport './scope/names.js'\nimport './scope/renames.js'\nimport './scope/fit.js'\nimport './scope/staged.js'\nimport './scope/huge.js'\nimport './scope/hardening.js'\nimport './scope/linguist.js'\nimport './scope/abort.js'\nimport './scope/bytes.js'\nimport './cli/errors.js'\nimport './cli/terminal.js'\nimport './cli/env.js'\nimport './cli/run.js'\nimport './cli/process.js'\nimport './cli/log.js'\nimport './skill/assets.js'\nimport './skill/skill.js'\nimport './cli/skill.js'\nimport './llm/sse.js'\nimport './llm/json.js'\nimport './llm/errors.js'\nimport './llm/usage.js'\nimport './llm/chat-encode.js'\nimport './llm/chat-decode.js'\nimport './llm/capture.js'\nimport './llm/client.js'\nimport './context/paths.js'\nimport './context/normalize.js'\nimport './context/grounding.js'\nimport './context/snippet.js'\nimport './context/tree.js'\nimport './context/hardening.js'\nimport './context/bounds.js'\nimport './config/find.js'\nimport './config/load.js'\nimport './config/schema.js'\nimport './tooling/schema.js'\nimport './cli/gate-settings.js'\n// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017tHbg6a4zMvBDmbLgcD56P","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
