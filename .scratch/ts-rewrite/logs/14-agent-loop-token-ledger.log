{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G8zQoMh1gyvGK6EDvi9ov2","type":"tool_result","content":"1\tpackage llm\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"crypto/rand\"\n6\t\t\"encoding/json\"\n7\t\t\"errors\"\n8\t\t\"fmt\"\n9\t\t\"reflect\"\n10\t\t\"sync\"\n11\t\n12\t\t\"charm.land/fantasy\"\n13\t\tjsonschema \"github.com/invopop/jsonschema\"\n14\t)\n15\t\n16\tconst nudgeToolName = \"__roast_continue\"\n17\t\n18\ttype agentRunState struct {\n19\t\topts        ConverseOpts\n20\t\tmodel       string\n21\t\twd          *workDeadlineState\n22\t\tturn        int\n23\t\tfinalTurn   bool\n24\t\tcutoff      error\n25\t\tnoticeSent  bool\n26\t\tinputWarn   bool\n27\t\tfinalDone   bool\n28\t\tfinalErr    error\n29\t\tstructured  bool\n30\t\tout         any\n31\t\tactive      []string\n32\t\ttoolNames   map[string]bool\n33\t\ttoolSchemas map[string]map[string]any\n34\t\n35\t\t// Count all final-phase responses, even ones Fantasy rejects before dispatch.\n36\t\tsubmissionAttempts  int\n37\t\tvalidationExhausted bool\n38\t\tbudgetOnce          sync.Once\n39\t\n40\t\t// Signed reasoning (Claude 5.1 and later) is bound to the system prompt,\n41\t\t// the tool set, and every earlier message, and the provider rejects a\n42\t\t// replay whose prefix changed. Fantasy rebuilds each step from its own\n43\t\t// history, which never includes messages Roast adds, so each added message\n44\t\t// is pinned after the Fantasy messages that preceded it when first sent.\n45\t\tbase     fantasy.Prompt\n46\t\tinjected []injectedMessage\n47\t\n48\t\t// Dispatch policy for the response being processed, decided once it is\n49\t\t// complete. Corrections travel as tool results so the replayed assistant\n50\t\t// turn stays exactly what the model produced.\n51\t\tblockExploration string\n52\t\trejectFinal      string\n53\t\tacceptFinal      *fantasy.ToolCallContent\n54\t\t// stopCause says why the latest response produced no submission.\n55\t\tstopCause string\n56\t\n57\t\t// recordTools only save part of the result; they run even on the wrap-up\n58\t\t// turn. recordRounds counts wrap-up responses that only recorded: they\n59\t\t// never use submission attempts, and past their own allowance the run\n60\t\t// stops after recording.\n61\t\trecordTools  map[string]bool\n62\t\trecordRounds int\n63\t\t// halt ends the loop once the current response's tools have run.\n64\t\thalt bool\n65\t}\n66\t\n67\ttype injectedMessage struct {\n68\t\tat      int\n69\t\tmessage fantasy.Message\n70\t}\n71\t\n72\tfunc (s *agentRunState) inject(message fantasy.Message) {\n73\t\ts.injected = append(s.injected, injectedMessage{at: len(s.base), message: message})\n74\t}\n75\t\n76\t// messages returns this step's conversation: Fantasy's history with every\n77\t// message Roast added restored at its original position.\n78\tfunc (s *agentRunState) messages() fantasy.Prompt {\n79\t\tout := make(fantasy.Prompt, 0, len(s.base)+len(s.injected))\n80\t\tnext := 0\n81\t\tfor i, message := range s.base {\n82\t\t\tfor ; next < len(s.injected) && s.injected[next].at <= i; next++ {\n83\t\t\t\tout = append(out, s.injected[next].message)\n84\t\t\t}\n85\t\t\tout = append(out, message)\n86\t\t}\n87\t\tfor ; next < len(s.injected); next++ {\n88\t\t\tout = append(out, s.injected[next].message)\n89\t\t}\n90\t\treturn out\n91\t}\n92\t\n93\tfunc (s *agentRunState) notifyBudget() {\n94\t\ts.budgetOnce.Do(func() {\n95\t\t\tif s.opts.OnBudgetExhausted != nil {\n96\t\t\t\ts.opts.OnBudgetExhausted()\n97\t\t\t}\n98\t\t})\n99\t}\n100\t\n101\tfunc (s *agentRunState) forceFinal(cause error) {\n102\t\ts.finalTurn = true\n103\t\tif cause != nil && s.cutoff == nil {\n104\t\t\ts.cutoff = cause\n105\t\t}\n106\t}\n107\t\n108\t// deadlinePassedDuringFinalization ends a final phase that is already under\n109\t// way once the work deadline has passed, including while the last response's\n110\t// tools ran: the wrap-up window is spent, so no further call opens.\n111\tfunc (s *agentRunState) deadlinePassedDuringFinalization() bool {\n112\t\tif !s.finalTurn || !s.wd.check() {\n113\t\t\treturn false\n114\t\t}\n115\t\ts.forceFinal(ErrWorkDeadline)\n116\t\tif s.stopCause == \"\" {\n117\t\t\ts.stopCause = \"the work deadline passed before `\" + s.opts.FinalTool + \"` was called\"\n118\t\t}\n119\t\treturn true\n120\t}\n121\t\n122\tfunc (s *agentRunState) notice() string {\n123\t\tswitch {\n124\t\tcase errors.Is(s.cutoff, ErrBudgetExhausted):\n125\t\t\treturn \"TOKEN BUDGET EXHAUSTED — call `\" + s.opts.FinalTool + \"` NOW with everything you have; partial results beat none.\"\n126\t\tcase errors.Is(s.cutoff, ErrWorkDeadline):\n127\t\t\treturn s.wd.wrapUpNotice(s.opts.FinalTool)\n128\t\tdefault:\n129\t\t\treturn \"Exploration budget exhausted — call `\" + s.opts.FinalTool + \"` NOW with everything you have; partial results beat none.\"\n130\t\t}\n131\t}\n132\t\n133\tfunc (s *agentRunState) cutoffError(what string, cause error) error {\n134\t\tsentinel := s.cutoff\n135\t\tif sentinel == nil {\n136\t\t\tsentinel = ErrNoFinalCall\n137\t\t}\n138\t\tif cause != nil {\n139\t\t\treturn fmt.Errorf(\"%w; %s: %w: %v\", sentinel, what, ErrNoFinalCall, cause)\n140\t\t}\n141\t\treturn fmt.Errorf(\"%w; %s: %w\", sentinel, what, ErrNoFinalCall)\n142\t}\n143\t\n144\tfunc (s *agentRunState) prepareStep(ctx context.Context, opts fantasy.PrepareStepFunctionOptions) (context.Context, fantasy.PrepareStepResult, error) {\n145\t\ts.turn++\n146\t\ts.base = opts.Messages\n147\t\tceiling := s.opts.InputByteCeiling\n148\t\tif ceiling <= 0 {\n149\t\t\tceiling = defaultInputByteCeiling\n150\t\t}\n151\t\tif s.turn > 1 && !s.inputWarn && fantasyConversationBytes(s.messages()) > ceiling {\n152\t\t\ts.inputWarn = true\n153\t\t\ts.inject(fantasy.NewUserMessage(\n154\t\t\t\t\"INPUT BUDGET EXHAUSTED. Do not request more files. Call `\" + s.opts.FinalTool + \"` now with what you have — partial results beat none.\",\n155\t\t\t))\n156\t\t}\n157\t\tif s.wd.check() {\n158\t\t\ts.forceFinal(ErrWorkDeadline)\n159\t\t}\n160\t\tif s.turn >= normalizedMaxTurns(s.opts.MaxTurns) {\n161\t\t\ts.forceFinal(nil)\n162\t\t}\n163\t\tif s.finalTurn && !s.noticeSent {\n164\t\t\ts.noticeSent = true\n165\t\t\tnotice := s.notice()\n166\t\t\tif s.structured {\n167\t\t\t\tnotice = \"Return the requested structured result via the `\" + s.opts.FinalTool + \"` tool call. Do not answer in prose.\"\n168\t\t\t}\n169\t\t\ts.inject(fantasy.NewUserMessage(notice))\n170\t\t}\n171\t\t// The tool set is part of the signed-reasoning prefix too, so it never\n172\t\t// narrows for finalization; tool results enforce the final phase instead.\n173\t\treturn ctx, fantasy.PrepareStepResult{Messages: s.messages(), ActiveTools: s.active}, nil\n174\t}\n175\t\n176\ttype managedModel struct {\n177\t\tclient *client\n178\t\tstate  *agentRunState\n179\t}\n180\t\n181\tfunc (m *managedModel) Provider() string { return m.client.model.Provider() }\n182\tfunc (m *managedModel) Model() string    { return m.client.model.Model() }\n183\t\n184\tfunc (m *managedModel) Generate(context.Context, fantasy.Call) (*fantasy.Response, error) {\n185\t\treturn nil, errors.New(\"roast agent runtime requires streaming\")\n186\t}\n187\t\n188\tfunc (m *managedModel) Stream(ctx context.Context, call fantasy.Call) (fantasy.StreamResponse, error) {\n189\t\t// Fantasy's AgentTool API keeps only properties and required. Restore the\n190\t\t// complete caller-supplied JSON Schema at the model boundary so providers\n191\t\t// that accept it retain top-level constraints such as additionalProperties.\n192\t\t// Fantasy's Anthropic adapter currently keeps type, properties, and required\n193\t\t// but discards other top-level keywords, so this restoration is best-effort\n194\t\t// for providers that accept the complete schema.\n195\t\tfor i, tool := range call.Tools {\n196\t\t\tfunctionTool, ok := tool.(fantasy.FunctionTool)\n197\t\t\tif !ok {\n198\t\t\t\tcontinue\n199\t\t\t}\n200\t\t\tif schema := m.state.toolSchemas[functionTool.Name]; schema != nil {\n201\t\t\t\tfunctionTool.InputSchema = cloneSchema(schema)\n202\t\t\t\tcall.Tools[i] = functionTool\n203\t\t\t}\n204\t\t}\n205\t\tfinal := m.state.finalTurn\n206\t\t// Never force a tool choice: thinking-mode providers (DeepSeek, Claude\n207\t\t// with thinking) reject it. Finalization relies on the notice, schema\n208\t\t// validation, and bounded reminders instead.\n209\t\tchoice := fantasy.ToolChoiceAuto\n210\t\tcall.ToolChoice = &choice\n211\t\treturn func(yield func(fantasy.StreamPart) bool) {\n212\t\t\ttoolJSON, _ := json.Marshal(call.Tools)\n213\t\t\trelease, err := m.client.cfg.Ledger.Reserve(fantasyConversationBytes(call.Prompt)+len(toolJSON)+2048, m.client.cfg.MaxOutputTokens, final)\n214\t\t\tif err != nil {\n215\t\t\t\tif final {\n216\t\t\t\t\tif m.state.cutoff == nil {\n217\t\t\t\t\t\tm.state.forceFinal(ErrBudgetExhausted)\n218\t\t\t\t\t\tm.state.notifyBudget()\n219\t\t\t\t\t}\n220\t\t\t\t\tyield(fantasy.StreamPart{Type: fantasy.StreamPartTypeError, Error: m.state.cutoffError(\"no headroom for the wrap-up call\", err)})\n221\t\t\t\t\treturn\n222\t\t\t\t}\n223\t\t\t\tm.state.forceFinal(ErrBudgetExhausted)\n224\t\t\t\tm.state.notifyBudget()\n225\t\t\t\tm.streamFinal(ctx, call, yield)\n226\t\t\t\treturn\n227\t\t\t}\n228\t\n229\t\t\terr = m.streamCall(ctx, call, release, yield)\n230\t\t\tdeadlineReached := m.state.wd.check()\n231\t\t\tif err == nil || errors.Is(err, errStreamStopped) {\n232\t\t\t\treturn\n233\t\t\t}\n234\t\t\tvar captureErr *captureError\n235\t\t\tif errors.As(err, &captureErr) {\n236\t\t\t\terr = permanentModelError{err: err}\n237\t\t\t} else if !final && deadlineReached && ctx.Err() == nil {\n238\t\t\t\tm.state.forceFinal(ErrWorkDeadline)\n239\t\t\t\tm.streamFinal(ctx, call, yield)\n240\t\t\t\treturn\n241\t\t\t} else if final && m.state.cutoff != nil {\n242\t\t\t\terr = m.state.cutoffError(\"wrap-up call failed\", normalizeProviderError(ctx, m.client.cfg.Model, err))\n243\t\t\t}\n244\t\t\tyield(fantasy.StreamPart{Type: fantasy.StreamPartTypeError, Error: err})\n245\t\t}, nil\n246\t}\n247\t\n248\tvar errStreamStopped = errors.New(\"stream consumer stopped\")\n249\t\n250\tfunc (m *managedModel) streamFinal(ctx context.Context, call fantasy.Call, yield func(fantasy.StreamPart) bool) {\n251\t\tstream, err := m.Stream(ctx, m.finalCall(call, m.state.notice()))\n252\t\tif err != nil {\n253\t\t\tyield(fantasy.StreamPart{Type: fantasy.StreamPartTypeError, Error: err})\n254\t\t\treturn\n255\t\t}\n256\t\tfor part := range stream {\n257\t\t\tif !yield(part) {\n258\t\t\t\treturn\n259\t\t\t}\n260\t\t}\n261\t}\n262\t\n263\tfunc (m *managedModel) streamCall(ctx context.Context, call fantasy.Call, release func(Usage), yield func(fantasy.StreamPart) bool) (callErr error) {\n264\t\tcallCtx, cancel := context.WithCancel(ctx)\n265\t\tdefer cancel()\n266\t\tcallCtx, workCancel := m.state.wd.callCtx(callCtx)\n267\t\tdefer workCancel()\n268\t\tif m.client.cfg.RequestTimeout > 0 {\n269\t\t\tvar deadlineCancel context.CancelFunc\n270\t\t\tcallCtx, deadlineCancel = context.WithTimeout(callCtx, m.client.cfg.RequestTimeout)\n271\t\t\tdefer deadlineCancel()\n272\t\t}\n273\t\tbody := &responseBody{}\n274\t\tcallCtx = context.WithValue(callCtx, responseBodyKey{}, body)\n275\t\tvar finish *fantasy.StreamPart\n276\t\tdefer func() {\n277\t\t\tusage := Usage{}\n278\t\t\tif finish != nil {\n279\t\t\t\tusage = m.client.addUsage(finish.Usage)\n280\t\t\t}\n281\t\t\trelease(usage)\n282\t\t}()\n283\t\tdefer func() {\n284\t\t\tcancel()\n285\t\t\t_ = body.close()\n286\t\t\tif err := m.client.transport.failure(); err != nil {\n287\t\t\t\tcallErr = err\n288\t\t\t}\n289\t\t}()\n290\t\tm.state.blockExploration, m.state.rejectFinal, m.state.acceptFinal = \"\", \"\", nil\n291\t\tstream, err := m.client.model.Stream(callCtx, call)\n292\t\tif err != nil {\n293\t\t\treturn err\n294\t\t}\n295\t\t// From the first tool call on, hold every part until the response is\n296\t\t// complete. Releasing them in arrival order keeps the replayed turn\n297\t\t// identical to what the provider sent (a thinking block after a tool call\n298\t\t// is signed over that call), and nothing is dispatched before capture.\n299\t\tvar held []fantasy.StreamPart\n300\t\tvar calls []fantasy.ToolCallContent\n301\t\t// Fantasy maps provider finish reasons to a few categories. Some adapters\n302\t\t// (chat, as of v0.46) also keep the provider's own string, but only on the\n303\t\t// warning they attach to an abnormal finish.\n304\t\tvar rawFinish string\n305\t\tfor part := range stream {\n306\t\t\tif part.Type == fantasy.StreamPartTypeWarnings {\n307\t\t\t\tfor _, warning := range part.Warnings {\n308\t\t\t\t\tif warning.RawFinishReason != \"\" {\n309\t\t\t\t\t\trawFinish = warning.RawFinishReason\n310\t\t\t\t\t}\n311\t\t\t\t}\n312\t\t\t}\n313\t\t\tswitch part.Type {\n314\t\t\tcase fantasy.StreamPartTypeError:\n315\t\t\t\treturn part.Error\n316\t\t\tcase fantasy.StreamPartTypeFinish:\n317\t\t\t\tfinish = &part\n318\t\t\tcase fantasy.StreamPartTypeToolCall:\n319\t\t\t\tcalls = append(calls, fantasy.ToolCallContent{ToolCallID: part.ID, ToolName: part.ToolCallName, Input: part.ToolCallInput})\n320\t\t\t\theld = append(held, part)\n321\t\t\tdefault:\n322\t\t\t\tif len(held) > 0 {\n323\t\t\t\t\theld = append(held, part)\n324\t\t\t\t\tcontinue\n325\t\t\t\t}\n326\t\t\t\tif !yield(part) {\n327\t\t\t\t\treturn errStreamStopped\n328\t\t\t\t}\n329\t\t\t}\n330\t\t}\n331\t\t// Capture must succeed before Fantasy is allowed to dispatch any tool, even\n332\t\t// if the SDK stopped at a terminal event without reading through EOF.\n333\t\t_ = body.close()\n334\t\tif err := m.client.transport.failure(); err != nil {\n335\t\t\treturn err\n336\t\t}\n337\t\tif err := callCtx.Err(); err != nil {\n338\t\t\treturn err\n339\t\t}\n340\t\tif finish == nil {\n341\t\t\treturn fantasy.NewIncompleteStreamError()\n342\t\t}\n343\t\treason := finish.FinishReason\n344\t\tvar appended []fantasy.ToolCallContent\n345\t\t// Let Fantasy reject incomplete/truncated/filtered turns. Rewriting their\n346\t\t// finish reason to tool_calls could execute a partial tool invocation.\n347\t\tif reason == fantasy.FinishReasonToolCalls || reason == fantasy.FinishReasonStop {\n348\t\t\tappended, reason = m.reviewResponse(calls)\n349\t\t} else {\n350\t\t\tm.state.stopCause = fmt.Sprintf(\"the response ended with finish reason %q\", reason)\n351\t\t\tif rawFinish != \"\" && rawFinish != string(reason) {\n352\t\t\t\tm.state.stopCause += fmt.Sprintf(\" (the provider sent %q)\", rawFinish)\n353\t\t\t}\n354\t\t\tif reason == fantasy.FinishReasonLength {\n355\t\t\t\tm.state.stopCause += \"; raise max_output_tokens if the output was cut off\"\n356\t\t\t}\n357\t\t}\n358\t\tfor _, part := range held {\n359\t\t\tif !yield(part) {\n360\t\t\t\treturn errStreamStopped\n361\t\t\t}\n362\t\t}\n363\t\tfor _, tool := range appended {\n364\t\t\tif !yield(fantasy.StreamPart{\n365\t\t\t\tType: fantasy.StreamPartTypeToolCall, ID: tool.ToolCallID,\n366\t\t\t\tToolCallName: tool.ToolName, ToolCallInput: tool.Input,\n367\t\t\t}) {\n368\t\t\t\treturn errStreamStopped\n369\t\t\t}\n370\t\t}\n371\t\tfinish.FinishReason = reason\n372\t\tif !yield(*finish) {\n373\t\t\treturn errStreamStopped\n374\t\t}\n375\t\treturn nil\n376\t}\n377\t\n378\ttype permanentModelError struct{ err error }\n379\t\n380\tfunc (e permanentModelError) Error() string { return e.err.Error() }\n381\t\n382\tfunc (m *managedModel) GenerateObject(context.Context, fantasy.ObjectCall) (*fantasy.ObjectResponse, error) {\n383\t\treturn nil, errors.New(\"roast agent runtime does not generate objects directly\")\n384\t}\n385\t\n386\tfunc (m *managedModel) StreamObject(context.Context, fantasy.ObjectCall) (fantasy.ObjectStreamResponse, error) {\n387\t\treturn nil, errors.New(\"roast agent runtime does not stream objects\")\n388\t}\n389\t\n390\t// finalCall turns this step's call into the wrap-up call. The notice joins\n391\t// the conversation for good (a Fantasy retry of this step resends it, and\n392\t// later steps keep it), and the tool set is left as sent.\n393\tfunc (m *managedModel) finalCall(call fantasy.Call, notice string) fantasy.Call {\n394\t\tm.state.finalTurn = true\n395\t\tif !m.state.noticeSent {\n396\t\t\tm.state.noticeSent = true\n397\t\t\tm.state.inject(fantasy.NewUserMessage(notice))\n398\t\t}\n399\t\tcall.Prompt = m.state.messages()\n400\t\treturn call\n401\t}\n402\t\n403\t// mayContinueFinalization reports whether finalization may make another call.\n404\t// Never reopen exploration or start another wrap-up window after a cutoff.\n405\t// Every reminder still goes through the normal token admission and deadlines.\n406\tfunc (m *managedModel) mayContinueFinalization() bool {\n407\t\tif m.state.wd.check() {\n408\t\t\tm.state.forceFinal(ErrWorkDeadline)\n409\t\t}\n410\t\treturn m.state.cutoff == nil\n411\t}\n412\t\n413\tfunc (m *managedModel) canRetrySubmission() bool {\n414\t\treturn m.mayContinueFinalization() && m.state.submissionAttempts < maxAttempts(m.client.cfg)\n415\t}\n416\t\n417\t// reviewResponse decides how a complete response is dispatched. It never\n418\t// edits, drops, or reorders what the model produced: a later signed thinking\n419\t// block may be bound to any of it. It returns synthetic nudge calls to append\n420\t// after the model's content, and the finish reason to report.\n421\tfunc (m *managedModel) reviewResponse(calls []fantasy.ToolCallContent) ([]fantasy.ToolCallContent, fantasy.FinishReason) {\n422\t\ts := m.state\n423\t\ts.stopCause = \"\"\n424\t\tvar final *fantasy.ToolCallContent\n425\t\trecords := 0\n426\t\tfor i, call := range calls {\n427\t\t\tswitch {\n428\t\t\tcase call.ToolName == s.opts.FinalTool:\n429\t\t\t\tfinal = &calls[i]\n430\t\t\tcase s.recordTools[call.ToolName]:\n431\t\t\t\trecords++\n432\t\t\tcase !s.toolNames[call.ToolName] && s.opts.OnTurn != nil:\n433\t\t\t\t// Fantasy answers unknown tools with an error result; report them\n434\t\t\t\t// as turns because nothing else will.\n435\t\t\t\ts.opts.OnTurn(TurnInfo{Turn: s.turn, Tool: call.ToolName, Args: decodeArgs(call.Input)})\n436\t\t\t}\n437\t\t}\n438\t\n439\t\tif s.finalTurn && final == nil && records > 0 && records == len(calls) {\n440\t\t\t// Recording results on the wrap-up turn is never a failed submission.\n441\t\t\t// Run the calls; hand the turn back only within the recording\n442\t\t\t// allowance and never past a cutoff, otherwise stop after them.\n443\t\t\ts.recordRounds++\n444\t\t\tswitch {\n445\t\t\tcase !m.mayContinueFinalization():\n446\t\t\t\ts.halt = true\n447\t\t\t\ts.stopCause = \"the model recorded results but did not call `\" + s.opts.FinalTool + \"` before the cutoff\"\n448\t\t\tcase s.recordRounds > maxAttempts(m.client.cfg):\n449\t\t\t\ts.halt = true\n450\t\t\t\ts.stopCause = fmt.Sprintf(\"the model kept recording results without calling `%s` (%d recording rounds)\", s.opts.FinalTool, s.recordRounds)\n451\t\t\t}\n452\t\t\treturn nil, fantasy.FinishReasonToolCalls\n453\t\t}\n454\t\tif s.finalTurn {\n455\t\t\ts.submissionAttempts++\n456\t\t}\n457\t\tif final != nil {\n458\t\t\ts.blockExploration = \"Not executed: this response also called `\" + s.opts.FinalTool + \"`, which ends the run.\"\n459\t\t\tvalidationErr := validateFinalArguments(final.Input, s.out)\n460\t\t\tif validationErr != nil && s.finalTurn && m.canRetrySubmission() {\n461\t\t\t\t// This failure is provisional. Do not let it mask a provider error\n462\t\t\t\t// from the follow-up call.\n463\t\t\t\ts.finalErr = nil\n464\t\t\t\ts.rejectFinal = fmt.Sprintf(\"your previous response was not valid JSON matching the schema: %v. Call `%s` again with valid arguments.\", validationErr, s.opts.FinalTool)\n465\t\t\t\ts.stopCause = \"the last `\" + s.opts.FinalTool + \"` call did not match the schema\"\n466\t\t\t\treturn nil, fantasy.FinishReasonToolCalls\n467\t\t\t}\n468\t\t\ts.finalErr = validationErr\n469\t\t\tif validationErr != nil {\n470\t\t\t\ts.validationExhausted = true\n471\t\t\t}\n472\t\t\taccepted := *final\n473\t\t\ts.acceptFinal = &accepted\n474\t\t\t// Fantasy still validates required fields before dispatch; if it\n475\t\t\t// rejects the call, the run can end here without a submission.\n476\t\t\ts.stopCause = \"the last `\" + s.opts.FinalTool + \"` call did not pass tool-call validation\"\n477\t\t\treturn nil, fantasy.FinishReasonToolCalls\n478\t\t}\n479\t\n480\t\tif s.finalTurn {\n481\t\t\t// Auto tool selection can produce prose or other tool calls. Only a\n482\t\t\t// validated final submission may finish successfully; never dispatch\n483\t\t\t// exploration tools, even ones Fantasy still knows how to execute.\n484\t\t\t// Recording tools still run.\n485\t\t\ts.blockExploration = \"Not executed: exploration is finished.\"\n486\t\t\tif m.canRetrySubmission() {\n487\t\t\t\treturn []fantasy.ToolCallContent{nudgeCall(fmt.Sprintf(\"roast-final-%d\", s.submissionAttempts),\n488\t\t\t\t\t\"Exploration is finished. Return the result via the `\"+s.opts.FinalTool+\"` tool call, not prose or another tool.\")}, fantasy.FinishReasonToolCalls\n489\t\t\t}\n490\t\t\ts.stopCause = \"the model answered without calling `\" + s.opts.FinalTool + \"`\"\n491\t\t\tif len(calls) > 0 {\n492\t\t\t\ts.stopCause = \"the model called other tools instead of `\" + s.opts.FinalTool + \"`\"\n493\t\t\t}\n494\t\t\tattempts := \"attempts\"\n495\t\t\tif s.submissionAttempts == 1 {\n496\t\t\t\tattempts = \"attempt\"\n497\t\t\t}\n498\t\t\ts.stopCause += fmt.Sprintf(\" (%d submission %s)\", s.submissionAttempts, attempts)\n499\t\t\tif records > 0 {\n500\t\t\t\t// Keep what the model recorded: dispatch, then stop.\n501\t\t\t\ts.halt = true\n502\t\t\t\treturn nil, fantasy.FinishReasonToolCalls\n503\t\t\t}\n504\t\t\treturn nil, fantasy.FinishReasonStop\n505\t\t}\n506\t\n507\t\tif len(calls) > 0 {\n508\t\t\treturn nil, fantasy.FinishReasonToolCalls\n509\t\t}\n510\t\treturn []fantasy.ToolCallContent{nudgeCall(fmt.Sprintf(\"roast-nudge-%d\", s.turn),\n511\t\t\t\"Results must be delivered via the `\"+s.opts.FinalTool+\"` tool call. If you have enough context call it now; otherwise call an exploration tool.\")}, fantasy.FinishReasonToolCalls\n512\t}\n513\t\n514\tfunc (c *client) CompleteStructured(ctx context.Context, system, user string, schemaName string, out any) error {\n515\t\treturn runAgent(ctx, c, system, user, ConverseOpts{\n516\t\t\tTools:     []Tool{{Name: schemaName, Description: \"Return the requested structured result.\", Schema: reflectSchema(out)}},\n517\t\t\tFinalTool: schemaName,\n518\t\t\tMaxTurns:  1,\n519\t\t}, out, true)\n520\t}\n521\t\n522\tfunc (c *client) Converse(ctx context.Context, system, user string, opts ConverseOpts, out any) error {\n523\t\treturn runAgent(ctx, c, system, user, opts, out, false)\n524\t}\n525\t\n526\tfunc runAgent(ctx context.Context, c *client, system, user string, opts ConverseOpts, out any, structured bool) error {\n527\t\tif findTool(opts.Tools, opts.FinalTool) == nil {\n528\t\t\treturn fmt.Errorf(\"final tool %q is not configured\", opts.FinalTool)\n529\t\t}\n530\t\tstate := &agentRunState{\n531\t\t\topts: opts, model: c.cfg.Model, wd: newWorkDeadlineState(opts), structured: structured, out: out,\n532\t\t\ttoolNames: make(map[string]bool, len(opts.Tools)+1), toolSchemas: make(map[string]map[string]any, len(opts.Tools)),\n533\t\t\trecordTools: make(map[string]bool),\n534\t\t}\n535\t\tif structured {\n536\t\t\tstate.finalTurn = true\n537\t\t}\n538\t\n539\t\ttools := make([]fantasy.AgentTool, 0, len(opts.Tools)+1)\n540\t\tfor i := range opts.Tools {\n541\t\t\tinfo, schema, err := fantasyToolInfo(opts.Tools[i])\n542\t\t\tif err != nil {\n543\t\t\t\treturn fmt.Errorf(\"tool %s schema: %w\", opts.Tools[i].Name, err)\n544\t\t\t}\n545\t\t\tstate.toolSchemas[opts.Tools[i].Name] = schema\n546\t\t\tstate.toolNames[opts.Tools[i].Name] = true\n547\t\t\tstate.active = append(state.active, opts.Tools[i].Name)\n548\t\t\tif opts.Tools[i].Name == opts.FinalTool {\n549\t\t\t\ttools = append(tools, finalFantasyTool(info, state))\n550\t\t\t\tcontinue\n551\t\t\t}\n552\t\t\tif opts.Tools[i].RecordsResult {\n553\t\t\t\tstate.recordTools[opts.Tools[i].Name] = true\n554\t\t\t}\n555\t\t\ttools = append(tools, explorationFantasyTool(info, opts.Tools[i], state))\n556\t\t}\n557\t\tstate.toolNames[nudgeToolName] = true\n558\t\ttools = append(tools, nudgeFantasyTool())\n559\t\n560\t\tmanaged := &managedModel{client: c, state: state}\n561\t\tagent := fantasy.NewAgent(managed,\n562\t\t\tfantasy.WithSystemPrompt(system),\n563\t\t\tfantasy.WithMaxOutputTokens(int64(c.cfg.MaxOutputTokens)),\n564\t\t\tfantasy.WithTools(tools...),\n565\t\t\tfantasy.WithMaxRetries(maxAttempts(c.cfg)-1),\n566\t\t\tfantasy.WithPrepareStep(state.prepareStep),\n567\t\t\tfantasy.WithRepairToolCall(func(context.Context, fantasy.ToolCallRepairOptions) (*fantasy.ToolCallContent, error) {\n568\t\t\t\treturn nil, errors.New(\"tool-call repair disabled\")\n569\t\t\t}),\n570\t\t\tfantasy.WithStopConditions(func([]fantasy.StepResult) bool {\n571\t\t\t\treturn state.finalDone || state.validationExhausted || state.halt ||\n572\t\t\t\t\t(state.finalTurn && state.submissionAttempts >= maxAttempts(c.cfg)) ||\n573\t\t\t\t\tstate.deadlinePassedDuringFinalization()\n574\t\t\t}),\n575\t\t)\n576\t\n577\t\tctx = context.WithValue(ctx, sessionContextKey{}, \"roast-\"+rand.Text())\n578\t\t_, runErr := agent.Stream(ctx, fantasy.AgentStreamCall{Prompt: user})\n579\t\tvar permanent permanentModelError\n580\t\tif errors.As(runErr, &permanent) {\n581\t\t\t// permanentModelError is intentionally opaque while Fantasy classifies\n582\t\t\t// retries. Restore its cause once that layer has finished.\n583\t\t\trunErr = permanent.err\n584\t\t}\n585\t\tif state.finalDone {\n586\t\t\treturn nil\n587\t\t}\n588\t\tif state.finalErr != nil {\n589\t\t\terr := fmt.Errorf(\"%s: %s arguments did not satisfy the schema (%v); if truncated, raise max_output_tokens\", state.model, opts.FinalTool, state.finalErr)\n590\t\t\tif state.cutoff != nil {\n591\t\t\t\treturn state.cutoffError(\"wrap-up submission was invalid\", err)\n592\t\t\t}\n593\t\t\treturn err\n594\t\t}\n595\t\tif runErr != nil {\n596\t\t\tif errors.Is(runErr, ErrNoFinalCall) {\n597\t\t\t\t// The wrap-up call already explained itself, provider error included.\n598\t\t\t\treturn runErr\n599\t\t\t}\n600\t\t\tif state.cutoff != nil {\n601\t\t\t\treturn state.cutoffError(\"wrap-up turn failed\", runErr)\n602\t\t\t}\n603\t\t\treturn normalizeProviderError(ctx, c.cfg.Model, runErr)\n604\t\t}\n605\t\tvar cause error\n606\t\tif state.stopCause != \"\" {\n607\t\t\tcause = fmt.Errorf(\"%s: %s\", state.model, state.stopCause)\n608\t\t}\n609\t\tif state.cutoff != nil {\n610\t\t\treturn state.cutoffError(\"wrap-up turn produced no submission\", cause)\n611\t\t}\n612\t\tif cause != nil {\n613\t\t\treturn fmt.Errorf(\"%w: %v\", ErrNoFinalCall, cause)\n614\t\t}\n615\t\treturn ErrNoFinalCall\n616\t}\n617\t\n618\ttype roastFantasyTool struct {\n619\t\tinfo fantasy.ToolInfo\n620\t\trun  func(context.Context, fantasy.ToolCall) (fantasy.ToolResponse, error)\n621\t\topts fantasy.ProviderOptions\n622\t}\n623\t\n624\tfunc (t *roastFantasyTool) Info() fantasy.ToolInfo { return t.info }\n625\tfunc (t *roastFantasyTool) Run(ctx context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {\n626\t\treturn t.run(ctx, call)\n627\t}\n628\tfunc (t *roastFantasyTool) ProviderOptions() fantasy.ProviderOptions        { return t.opts }\n629\tfunc (t *roastFantasyTool) SetProviderOptions(opts fantasy.ProviderOptions) { t.opts = opts }\n630\t\n631\tfunc explorationFantasyTool(info fantasy.ToolInfo, definition Tool, state *agentRunState) fantasy.AgentTool {\n632\t\treturn &roastFantasyTool{info: info, run: func(ctx context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {\n633\t\t\tif state.blockExploration != \"\" && !definition.RecordsResult {\n634\t\t\t\treturn fantasy.NewTextErrorResponse(state.blockExploration), nil\n635\t\t\t}\n636\t\t\targs := decodeArgs(call.Input)\n637\t\t\tvar result any\n638\t\t\tvar err error\n639\t\t\tif definition.Run == nil {\n640\t\t\t\terr = errors.New(\"tool has no implementation\")\n641\t\t\t} else {\n642\t\t\t\tresult, err = state.wd.runTool(ctx, &definition, args)\n643\t\t\t}\n644\t\t\tif err != nil {\n645\t\t\t\tresult = map[string]any{\"error\": err.Error()}\n646\t\t\t}\n647\t\t\tif state.opts.OnTurn != nil {\n648\t\t\t\tstate.opts.OnTurn(TurnInfo{Turn: state.turn, Tool: definition.Name, Args: args})\n649\t\t\t}\n650\t\t\tdata, marshalErr := json.Marshal(result)\n651\t\t\tif marshalErr != nil {\n652\t\t\t\tdata, _ = json.Marshal(map[string]any{\"error\": marshalErr.Error()})\n653\t\t\t}\n654\t\t\treturn fantasy.NewTextResponse(string(data)), nil\n655\t\t}}\n656\t}\n657\t\n658\tfunc finalFantasyTool(info fantasy.ToolInfo, state *agentRunState) fantasy.AgentTool {\n659\t\treturn &roastFantasyTool{info: info, run: func(_ context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {\n660\t\t\t// Fantasy may repair malformed JSON locally. A final submission that\n661\t\t\t// Roast already rejected must not become successful after that repair.\n662\t\t\tif state.finalErr != nil {\n663\t\t\t\tresp := fantasy.NewTextErrorResponse(state.finalErr.Error())\n664\t\t\t\tresp.StopTurn = true\n665\t\t\t\treturn resp, nil\n666\t\t\t}\n667\t\t\tif state.rejectFinal != \"\" {\n668\t\t\t\treturn fantasy.NewTextErrorResponse(state.rejectFinal), nil\n669\t\t\t}\n670\t\t\tif state.finalDone {\n671\t\t\t\tresp := fantasy.NewTextResponse(\"Already submitted.\")\n672\t\t\t\tresp.StopTurn = true\n673\t\t\t\treturn resp, nil\n674\t\t\t}\n675\t\t\t// A response may carry several submissions; only the one that was\n676\t\t\t// validated is accepted.\n677\t\t\tif accepted := state.acceptFinal; accepted == nil || accepted.ToolCallID != call.ID || accepted.Input != call.Input {\n678\t\t\t\treturn fantasy.NewTextErrorResponse(\"Not accepted: call `\" + info.Name + \"` once per response.\"), nil\n679\t\t\t}\n680\t\t\tresp := fantasy.NewTextResponse(call.Input)\n681\t\t\tresp.StopTurn = true\n682\t\t\tif err := json.Unmarshal([]byte(call.Input), state.out); err != nil {\n683\t\t\t\tstate.finalErr = err\n684\t\t\t\tresp = fantasy.NewTextErrorResponse(err.Error())\n685\t\t\t\tresp.StopTurn = true\n686\t\t\t\treturn resp, nil\n687\t\t\t}\n688\t\t\tstate.finalErr = nil\n689\t\t\tstate.finalDone = true\n690\t\t\treturn resp, nil\n691\t\t}}\n692\t}\n693\t\n694\tfunc nudgeFantasyTool() fantasy.AgentTool {\n695\t\treturn &roastFantasyTool{\n696\t\t\tinfo: fantasy.ToolInfo{\n697\t\t\t\tName: nudgeToolName, Description: \"Continue the Roast tool loop after a free-form response.\",\n698\t\t\t\tParameters: map[string]any{\"message\": map[string]any{\"type\": \"string\"}}, Required: []string{\"message\"},\n699\t\t\t},\n700\t\t\trun: func(_ context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {\n701\t\t\t\tvar payload struct {\n702\t\t\t\t\tMessage string `json:\"message\"`\n703\t\t\t\t}\n704\t\t\t\t_ = json.Unmarshal([]byte(call.Input), &payload)\n705\t\t\t\treturn fantasy.NewTextResponse(payload.Message), nil\n706\t\t\t},\n707\t\t}\n708\t}\n709\t\n710\tfunc nudgeCall(id, message string) fantasy.ToolCallContent {\n711\t\tdata, _ := json.Marshal(map[string]string{\"message\": message})\n712\t\treturn fantasy.ToolCallContent{ToolCallID: id, ToolName: nudgeToolName, Input: string(data)}\n713\t}\n714\t\n715\tfunc decodeArgs(arguments string) map[string]any {\n716\t\tvar args map[string]any\n717\t\tif err := json.Unmarshal([]byte(arguments), &args); err != nil {\n718\t\t\treturn map[string]any{\"error\": fmt.Sprintf(\"args parse error: %v\", err)}\n719\t\t}\n720\t\treturn args\n721\t}\n722\t\n723\tfunc fantasyToolInfo(t Tool) (fantasy.ToolInfo, map[string]any, error) {\n724\t\tdata, err := json.Marshal(t.Schema)\n725\t\tif err != nil {\n726\t\t\treturn fantasy.ToolInfo{}, nil, err\n727\t\t}\n728\t\tvar schema map[string]any\n729\t\tif err := json.Unmarshal(data, &schema); err != nil {\n730\t\t\treturn fantasy.ToolInfo{}, nil, err\n731\t\t}\n732\t\tparameters, _ := schema[\"properties\"].(map[string]any)\n733\t\tif parameters == nil {\n734\t\t\tparameters = map[string]any{}\n735\t\t}\n736\t\tvar required []string\n737\t\tif raw, ok := schema[\"required\"].([]any); ok {\n738\t\t\tfor _, item := range raw {\n739\t\t\t\tif name, ok := item.(string); ok {\n740\t\t\t\t\trequired = append(required, name)\n741\t\t\t\t}\n742\t\t\t}\n743\t\t}\n744\t\treturn fantasy.ToolInfo{Name: t.Name, Description: t.Description, Parameters: parameters, Required: required}, schema, nil\n745\t}\n746\t\n747\t// cloneSchema returns a deep copy of schema for one request. Fantasy's\n748\t// Anthropic adapter reads a required list only as []string and sends an empty\n749\t// one for any other shape, so every required list the JSON round trip decoded\n750\t// as []any is restored to []string.\n751\tfunc cloneSchema(schema map[string]any) map[string]any {\n752\t\tdata, _ := json.Marshal(schema)\n753\t\tvar clone map[string]any\n754\t\t_ = json.Unmarshal(data, &clone)\n755\t\trestoreRequiredLists(clone)\n756\t\treturn clone\n757\t}\n758\t\n759\tfunc restoreRequiredLists(node any) {\n760\t\tswitch node := node.(type) {\n761\t\tcase map[string]any:\n762\t\t\tfor key, child := range node {\n763\t\t\t\tif list, ok := child.([]any); ok && key == \"required\" {\n764\t\t\t\t\tif names, ok := stringList(list); ok {\n765\t\t\t\t\t\tnode[key] = names\n766\t\t\t\t\t\tcontinue\n767\t\t\t\t\t}\n768\t\t\t\t}\n769\t\t\t\trestoreRequiredLists(child)\n770\t\t\t}\n771\t\tcase []any:\n772\t\t\tfor _, item := range node {\n773\t\t\t\trestoreRequiredLists(item)\n774\t\t\t}\n775\t\t}\n776\t}\n777\t\n778\tfunc stringList(items []any) ([]string, bool) {\n779\t\tnames := make([]string, 0, len(items))\n780\t\tfor _, item := range items {\n781\t\t\tname, ok := item.(string)\n782\t\t\tif !ok {\n783\t\t\t\treturn nil, false\n784\t\t\t}\n785\t\t\tnames = append(names, name)\n786\t\t}\n787\t\treturn names, true\n788\t}\n789\t\n790\tfunc reflectSchema(v any) map[string]any {\n791\t\tr := &jsonschema.Reflector{Anonymous: true, AllowAdditionalProperties: false, DoNotReference: true}\n792\t\ts := r.Reflect(v)\n793\t\ts.Version = \"\"\n794\t\tdata, _ := json.Marshal(s)\n795\t\tvar out map[string]any\n796\t\t_ = json.Unmarshal(data, &out)\n797\t\treturn out\n798\t}\n799\t\n800\tfunc validateFinalArguments(arguments string, out any) error {\n801\t\tdata := json.RawMessage(arguments)\n802\t\tif !json.Valid(data) {\n803\t\t\treturn errors.New(\"invalid JSON\")\n804\t\t}\n805\t\tt := reflect.TypeOf(out)\n806\t\tif t == nil || t.Kind() != reflect.Pointer {\n807\t\t\treturn errors.New(\"output must be a pointer\")\n808\t\t}\n809\t\tscratch := reflect.New(t.Elem()).Interface()\n810\t\treturn json.Unmarshal(data, scratch)\n811\t}\n812\t\n813\tfunc normalizedMaxTurns(turns int) int {\n814\t\tif turns <= 0 {\n815\t\t\treturn 8\n816\t\t}\n817\t\treturn turns\n818\t}\n819\t\n820\tfunc findTool(tools []Tool, name string) *Tool {\n821\t\tfor i := range tools {\n822\t\t\tif tools[i].Name == name {\n823\t\t\t\treturn &tools[i]\n824\t\t\t}\n825\t\t}\n826\t\treturn nil\n827\t}\n828\t\n829\tfunc fantasyConversationBytes(messages fantasy.Prompt) int {\n830\t\tdata, _ := json.Marshal(messages)\n831\t\treturn len(data)\n832\t}\n833\t"}]},"parent_tool_use_id":null,"session_id":"79353e88-0eda-49f3-aae4-5b092ab34fc4","uuid":"b3209534-26ad-4b9e-ae65-8144b235f1d6","timestamp":"2026-11-18T20:10:11.143Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.ts-rewrite-14-agent-loop-token-ledger/internal/llm/agent.go","content":"package llm\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"reflect\"\n\t\"sync\"\n\n\t\"charm.land/fantasy\"\n\tjsonschema \"github.com/invopop/jsonschema\"\n)\n\nconst nudgeToolName = \"__roast_continue\"\n\ntype agentRunState struct {\n\topts        ConverseOpts\n\tmodel       string\n\twd          *workDeadlineState\n\tturn        int\n\tfinalTurn   bool\n\tcutoff      error\n\tnoticeSent  bool\n\tinputWarn   bool\n\tfinalDone   bool\n\tfinalErr    error\n\tstructured  bool\n\tout         any\n\tactive      []string\n\ttoolNames   map[string]bool\n\ttoolSchemas map[string]map[string]any\n\n\t// Count all final-phase responses, even ones Fantasy rejects before dispatch.\n\tsubmissionAttempts  int\n\tvalidationExhausted bool\n\tbudgetOnce          sync.Once\n\n\t// Signed reasoning (Claude 5.1 and later) is bound to the system prompt,\n\t// the tool set, and every earlier message, and the provider rejects a\n\t// replay whose prefix changed. Fantasy rebuilds each step from its own\n\t// history, which never includes messages Roast adds, so each added message\n\t// is pinned after the Fantasy messages that preceded it when first sent.\n\tbase     fantasy.Prompt\n\tinjected []injectedMessage\n\n\t// Dispatch policy for the response being processed, decided once it is\n\t// complete. Corrections travel as tool results so the replayed assistant\n\t// turn stays exactly what the model produced.\n\tblockExploration string\n\trejectFinal      string\n\tacceptFinal      *fantasy.ToolCallContent\n\t// stopCause says why the latest response produced no submission.\n\tstopCause string\n\n\t// recordTools only save part of the result; they run even on the wrap-up\n\t// turn. recordRounds counts wrap-up responses that only recorded: they\n\t// never use submission attempts, and past their own allowance the run\n\t// stops after recording.\n\trecordTools  map[string]bool\n\trecordRounds int\n\t// halt ends the loop once the current response's tools have run.\n\thalt bool\n}\n\ntype injectedMessage struct {\n\tat      int\n\tmessage fantasy.Message\n}\n\nfunc (s *agentRunState) inject(message fantasy.Message) {\n\ts.injected = append(s.injected, injectedMessage{at: len(s.base), message: message})\n}\n\n// messages returns this step's conversation: Fantasy's history with every\n// message Roast added restored at its original position.\nfunc (s *agentRunState) messages() fantasy.Prompt {\n\tout := make(fantasy.Prompt, 0, len(s.base)+len(s.injected))\n\tnext := 0\n\tfor i, message := range s.base {\n\t\tfor ; next < len(s.injected) && s.injected[next].at <= i; next++ {\n\t\t\tout = append(out, s.injected[next].message)\n\t\t}\n\t\tout = append(out, message)\n\t}\n\tfor ; next < len(s.injected); next++ {\n\t\tout = append(out, s.injected[next].message)\n\t}\n\treturn out\n}\n\nfunc (s *agentRunState) notifyBudget() {\n\ts.budgetOnce.Do(func() {\n\t\tif s.opts.OnBudgetExhausted != nil {\n\t\t\ts.opts.OnBudgetExhausted()\n\t\t}\n\t})\n}\n\nfunc (s *agentRunState) forceFinal(cause error) {\n\ts.finalTurn = true\n\tif cause != nil && s.cutoff == nil {\n\t\ts.cutoff = cause\n\t}\n}\n\n// deadlinePassedDuringFinalization ends a final phase that is already under\n// way once the work deadline has passed, including while the last response's\n// tools ran: the wrap-up window is spent, so no further call opens.\nfunc (s *agentRunState) deadlinePassedDuringFinalization() bool {\n\tif !s.finalTurn || !s.wd.check() {\n\t\treturn false\n\t}\n\ts.forceFinal(ErrWorkDeadline)\n\tif s.stopCause == \"\" {\n\t\ts.stopCause = \"the work deadline passed before `\" + s.opts.FinalTool + \"` was called\"\n\t}\n\treturn true\n}\n\nfunc (s *agentRunState) notice() string {\n\tswitch {\n\tcase errors.Is(s.cutoff, ErrBudgetExhausted):\n\t\treturn \"TOKEN BUDGET EXHAUSTED — call `\" + s.opts.FinalTool + \"` NOW with everything you have; partial results beat none.\"\n\tcase errors.Is(s.cutoff, ErrWorkDeadline):\n\t\treturn s.wd.wrapUpNotice(s.opts.FinalTool)\n\tdefault:\n\t\treturn \"Exploration budget exhausted — call `\" + s.opts.FinalTool + \"` NOW with everything you have; partial results beat none.\"\n\t}\n}\n\nfunc (s *agentRunState) cutoffError(what string, cause error) error {\n\tsentinel := s.cutoff\n\tif sentinel == nil {\n\t\tsentinel = ErrNoFinalCall\n\t}\n\tif cause != nil {\n\t\treturn fmt.Errorf(\"%w; %s: %w: %v\", sentinel, what, ErrNoFinalCall, cause)\n\t}\n\treturn fmt.Errorf(\"%w; %s: %w\", sentinel, what, ErrNoFinalCall)\n}\n\nfunc (s *agentRunState) prepareStep(ctx context.Context, opts fantasy.PrepareStepFunctionOptions) (context.Context, fantasy.PrepareStepResult, error) {\n\ts.turn++\n\ts.base = opts.Messages\n\tceiling := s.opts.InputByteCeiling\n\tif ceiling <= 0 {\n\t\tceiling = defaultInputByteCeiling\n\t}\n\tif s.turn > 1 && !s.inputWarn && fantasyConversationBytes(s.messages()) > ceiling {\n\t\ts.inputWarn = true\n\t\ts.inject(fantasy.NewUserMessage(\n\t\t\t\"INPUT BUDGET EXHAUSTED. Do not request more files. Call `\" + s.opts.FinalTool + \"` now with what you have — partial results beat none.\",\n\t\t))\n\t}\n\tif s.wd.check() {\n\t\ts.forceFinal(ErrWorkDeadline)\n\t}\n\tif s.turn >= normalizedMaxTurns(s.opts.MaxTurns) {\n\t\ts.forceFinal(nil)\n\t}\n\tif s.finalTurn && !s.noticeSent {\n\t\ts.noticeSent = true\n\t\tnotice := s.notice()\n\t\tif s.structured {\n\t\t\tnotice = \"Return the requested structured result via the `\" + s.opts.FinalTool + \"` tool call. Do not answer in prose.\"\n\t\t}\n\t\ts.inject(fantasy.NewUserMessage(notice))\n\t}\n\t// The tool set is part of the signed-reasoning prefix too, so it never\n\t// narrows for finalization; tool results enforce the final phase instead.\n\treturn ctx, fantasy.PrepareStepResult{Messages: s.messages(), ActiveTools: s.active}, nil\n}\n\ntype managedModel struct {\n\tclient *client\n\tstate  *agentRunState\n}\n\nfunc (m *managedModel) Provider() string { return m.client.model.Provider() }\nfunc (m *managedModel) Model() string    { return m.client.model.Model() }\n\nfunc (m *managedModel) Generate(context.Context, fantasy.Call) (*fantasy.Response, error) {\n\treturn nil, errors.New(\"roast agent runtime requires streaming\")\n}\n\nfunc (m *managedModel) Stream(ctx context.Context, call fantasy.Call) (fantasy.StreamResponse, error) {\n\t// Fantasy's AgentTool API keeps only properties and required. Restore the\n\t// complete caller-supplied JSON Schema at the model boundary so providers\n\t// that accept it retain top-level constraints such as additionalProperties.\n\t// Fantasy's Anthropic adapter currently keeps type, properties, and required\n\t// but discards other top-level keywords, so this restoration is best-effort\n\t// for providers that accept the complete schema.\n\tfor i, tool := range call.Tools {\n\t\tfunctionTool, ok := tool.(fantasy.FunctionTool)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif schema := m.state.toolSchemas[functionTool.Name]; schema != nil {\n\t\t\tfunctionTool.InputSchema = cloneSchema(schema)\n\t\t\tcall.Tools[i] = functionTool\n\t\t}\n\t}\n\tfinal := m.state.finalTurn\n\t// Never force a tool choice: thinking-mode providers (DeepSeek, Claude\n\t// with thinking) reject it. Finalization relies on the notice, schema\n\t// validation, and bounded reminders instead.\n\tchoice := fantasy.ToolChoiceAuto\n\tcall.ToolChoice = &choice\n\treturn func(yield func(fantasy.StreamPart) bool) {\n\t\ttoolJSON, _ := json.Marshal(call.Tools)\n\t\trelease, err := m.client.cfg.Ledger.Reserve(fantasyConversationBytes(call.Prompt)+len(toolJSON)+2048, m.client.cfg.MaxOutputTokens, final)\n\t\tif err != nil {\n\t\t\tif final {\n\t\t\t\tif m.state.cutoff == nil {\n\t\t\t\t\tm.state.forceFinal(ErrBudgetExhausted)\n\t\t\t\t\tm.state.notifyBudget()\n\t\t\t\t}\n\t\t\t\tyield(fantasy.StreamPart{Type: fantasy.StreamPartTypeError, Error: m.state.cutoffError(\"no headroom for the wrap-up call\", err)})\n\t\t\t\treturn\n\t\t\t}\n\t\t\tm.state.forceFinal(ErrBudgetExhausted)\n\t\t\tm.state.notifyBudget()\n\t\t\tm.streamFinal(ctx, call, yield)\n\t\t\treturn\n\t\t}\n\n\t\terr = m.streamCall(ctx, call, release, yield)\n\t\tdeadlineReached := m.state.wd.check()\n\t\tif err == nil || errors.Is(err, errStreamStopped) {\n\t\t\treturn\n\t\t}\n\t\tvar captureErr *captureError\n\t\tif errors.As(err, &captureErr) {\n\t\t\terr = permanentModelError{err: err}\n\t\t} else if !final && deadlineReached && ctx.Err() == nil {\n\t\t\tm.state.forceFinal(ErrWorkDeadline)\n\t\t\tm.streamFinal(ctx, call, yield)\n\t\t\treturn\n\t\t} else if final && m.state.cutoff != nil {\n\t\t\terr = m.state.cutoffError(\"wrap-up call failed\", normalizeProviderError(ctx, m.client.cfg.Model, err))\n\t\t}\n\t\tyield(fantasy.StreamPart{Type: fantasy.StreamPartTypeError, Error: err})\n\t}, nil\n}\n\nvar errStreamStopped = errors.New(\"stream consumer stopped\")\n\nfunc (m *managedModel) streamFinal(ctx context.Context, call fantasy.Call, yield func(fantasy.StreamPart) bool) {\n\tstream, err := m.Stream(ctx, m.finalCall(call, m.state.notice()))\n\tif err != nil {\n\t\tyield(fantasy.StreamPart{Type: fantasy.StreamPartTypeError, Error: err})\n\t\treturn\n\t}\n\tfor part := range stream {\n\t\tif !yield(part) {\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc (m *managedModel) streamCall(ctx context.Context, call fantasy.Call, release func(Usage), yield func(fantasy.StreamPart) bool) (callErr error) {\n\tcallCtx, cancel := context.WithCancel(ctx)\n\tdefer cancel()\n\tcallCtx, workCancel := m.state.wd.callCtx(callCtx)\n\tdefer workCancel()\n\tif m.client.cfg.RequestTimeout > 0 {\n\t\tvar deadlineCancel context.CancelFunc\n\t\tcallCtx, deadlineCancel = context.WithTimeout(callCtx, m.client.cfg.RequestTimeout)\n\t\tdefer deadlineCancel()\n\t}\n\tbody := &responseBody{}\n\tcallCtx = context.WithValue(callCtx, responseBodyKey{}, body)\n\tvar finish *fantasy.StreamPart\n\tdefer func() {\n\t\tusage := Usage{}\n\t\tif finish != nil {\n\t\t\tusage = m.client.addUsage(finish.Usage)\n\t\t}\n\t\trelease(usage)\n\t}()\n\tdefer func() {\n\t\tcancel()\n\t\t_ = body.close()\n\t\tif err := m.client.transport.failure(); err != nil {\n\t\t\tcallErr = err\n\t\t}\n\t}()\n\tm.state.blockExploration, m.state.rejectFinal, m.state.acceptFinal = \"\", \"\", nil\n\tstream, err := m.client.model.Stream(callCtx, call)\n\tif err != nil {\n\t\treturn err\n\t}\n\t// From the first tool call on, hold every part until the response is\n\t// complete. Releasing them in arrival order keeps the replayed turn\n\t// identical to what the provider sent (a thinking block after a tool call\n\t// is signed over that call), and nothing is dispatched before capture.\n\tvar held []fantasy.StreamPart\n\tvar calls []fantasy.ToolCallContent\n\t// Fantasy maps provider finish reasons to a few categories. Some adapters\n\t// (chat, as of v0.46) also keep the provider's own string, but only on the\n\t// warning they attach to an abnormal finish.\n\tvar rawFinish string\n\tfor part := range stream {\n\t\tif part.Type == fantasy.StreamPartTypeWarnings {\n\t\t\tfor _, warning := range part.Warnings {\n\t\t\t\tif warning.RawFinishReason != \"\" {\n\t\t\t\t\trawFinish = warning.RawFinishReason\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tswitch part.Type {\n\t\tcase fantasy.StreamPartTypeError:\n\t\t\treturn part.Error\n\t\tcase fantasy.StreamPartTypeFinish:\n\t\t\tfinish = &part\n\t\tcase fantasy.StreamPartTypeToolCall:\n\t\t\tcalls = append(calls, fantasy.ToolCallContent{ToolCallID: part.ID, ToolName: part.ToolCallName, Input: part.ToolCallInput})\n\t\t\theld = append(held, part)\n\t\tdefault:\n\t\t\tif len(held) > 0 {\n\t\t\t\theld = append(held, part)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif !yield(part) {\n\t\t\t\treturn errStreamStopped\n\t\t\t}\n\t\t}\n\t}\n\t// Capture must succeed before Fantasy is allowed to dispatch any tool, even\n\t// if the SDK stopped at a terminal event without reading through EOF.\n\t_ = body.close()\n\tif err := m.client.transport.failure(); err != nil {\n\t\treturn err\n\t}\n\tif err := callCtx.Err(); err != nil {\n\t\treturn err\n\t}\n\tif finish == nil {\n\t\treturn fantasy.NewIncompleteStreamError()\n\t}\n\treason := finish.FinishReason\n\tvar appended []fantasy.ToolCallContent\n\t// Let Fantasy reject incomplete/truncated/filtered turns. Rewriting their\n\t// finish reason to tool_calls could execute a partial tool invocation.\n\tif reason == fantasy.FinishReasonToolCalls || reason == fantasy.FinishReasonStop {\n\t\tappended, reason = m.reviewResponse(calls)\n\t} else {\n\t\tm.state.stopCause = fmt.Sprintf(\"the response ended with finish reason %q\", reason)\n\t\tif rawFinish != \"\" && rawFinish != string(reason) {\n\t\t\tm.state.stopCause += fmt.Sprintf(\" (the provider sent %q)\", rawFinish)\n\t\t}\n\t\tif reason == fantasy.FinishReasonLength {\n\t\t\tm.state.stopCause += \"; raise max_output_tokens if the output was cut off\"\n\t\t}\n\t}\n\tfor _, part := range held {\n\t\tif !yield(part) {\n\t\t\treturn errStreamStopped\n\t\t}\n\t}\n\tfor _, tool := range appended {\n\t\tif !yield(fantasy.StreamPart{\n\t\t\tType: fantasy.StreamPartTypeToolCall, ID: tool.ToolCallID,\n\t\t\tToolCallName: tool.ToolName, ToolCallInput: tool.Input,\n\t\t}) {\n\t\t\treturn errStreamStopped\n\t\t}\n\t}\n\tfinish.FinishReason = reason\n\tif !yield(*finish) {\n\t\treturn errStreamStopped\n\t}\n\treturn nil\n}\n\ntype permanentModelError struct{ err error }\n\nfunc (e permanentModelError) Error() string { return e.err.Error() }\n\nfunc (m *managedModel) GenerateObject(context.Context, fantasy.ObjectCall) (*fantasy.ObjectResponse, error) {\n\treturn nil, errors.New(\"roast agent runtime does not generate objects directly\")\n}\n\nfunc (m *managedModel) StreamObject(context.Context, fantasy.ObjectCall) (fantasy.ObjectStreamResponse, error) {\n\treturn nil, errors.New(\"roast agent runtime does not stream objects\")\n}\n\n// finalCall turns this step's call into the wrap-up call. The notice joins\n// the conversation for good (a Fantasy retry of this step resends it, and\n// later steps keep it), and the tool set is left as sent.\nfunc (m *managedModel) finalCall(call fantasy.Call, notice string) fantasy.Call {\n\tm.state.finalTurn = true\n\tif !m.state.noticeSent {\n\t\tm.state.noticeSent = true\n\t\tm.state.inject(fantasy.NewUserMessage(notice))\n\t}\n\tcall.Prompt = m.state.messages()\n\treturn call\n}\n\n// mayContinueFinalization reports whether finalization may make another call.\n// Never reopen exploration or start another wrap-up window after a cutoff.\n// Every reminder still goes through the normal token admission and deadlines.\nfunc (m *managedModel) mayContinueFinalization() bool {\n\tif m.state.wd.check() {\n\t\tm.state.forceFinal(ErrWorkDeadline)\n\t}\n\treturn m.state.cutoff == nil\n}\n\nfunc (m *managedModel) canRetrySubmission() bool {\n\treturn m.mayContinueFinalization() && m.state.submissionAttempts < maxAttempts(m.client.cfg)\n}\n\n// reviewResponse decides how a complete response is dispatched. It never\n// edits, drops, or reorders what the model produced: a later signed thinking\n// block may be bound to any of it. It returns synthetic nudge calls to append\n// after the model's content, and the finish reason to report.\nfunc (m *managedModel) reviewResponse(calls []fantasy.ToolCallContent) ([]fantasy.ToolCallContent, fantasy.FinishReason) {\n\ts := m.state\n\ts.stopCause = \"\"\n\tvar final *fantasy.ToolCallContent\n\trecords := 0\n\tfor i, call := range calls {\n\t\tswitch {\n\t\tcase call.ToolName == s.opts.FinalTool:\n\t\t\tfinal = &calls[i]\n\t\tcase s.recordTools[call.ToolName]:\n\t\t\trecords++\n\t\tcase !s.toolNames[call.ToolName] && s.opts.OnTurn != nil:\n\t\t\t// Fantasy answers unknown tools with an error result; report them\n\t\t\t// as turns because nothing else will.\n\t\t\ts.opts.OnTurn(TurnInfo{Turn: s.turn, Tool: call.ToolName, Args: decodeArgs(call.Input)})\n\t\t}\n\t}\n\n\tif s.finalTurn && final == nil && records > 0 && records == len(calls) {\n\t\t// Recording results on the wrap-up turn is never a failed submission.\n\t\t// Run the calls; hand the turn back only within the recording\n\t\t// allowance and never past a cutoff, otherwise stop after them.\n\t\ts.recordRounds++\n\t\tswitch {\n\t\tcase !m.mayContinueFinalization():\n\t\t\ts.halt = true\n\t\t\ts.stopCause = \"the model recorded results but did not call `\" + s.opts.FinalTool + \"` before the cutoff\"\n\t\tcase s.recordRounds > maxAttempts(m.client.cfg):\n\t\t\ts.halt = true\n\t\t\ts.stopCause = fmt.Sprintf(\"the model kept recording results without calling `%s` (%d recording rounds)\", s.opts.FinalTool, s.recordRounds)\n\t\t}\n\t\treturn nil, fantasy.FinishReasonToolCalls\n\t}\n\tif s.finalTurn {\n\t\ts.submissionAttempts++\n\t}\n\tif final != nil {\n\t\ts.blockExploration = \"Not executed: this response also called `\" + s.opts.FinalTool + \"`, which ends the run.\"\n\t\tvalidationErr := validateFinalArguments(final.Input, s.out)\n\t\tif validationErr != nil && s.finalTurn && m.canRetrySubmission() {\n\t\t\t// This failure is provisional. Do not let it mask a provider error\n\t\t\t// from the follow-up call.\n\t\t\ts.finalErr = nil\n\t\t\ts.rejectFinal = fmt.Sprintf(\"your previous response was not valid JSON matching the schema: %v. Call `%s` again with valid arguments.\", validationErr, s.opts.FinalTool)\n\t\t\ts.stopCause = \"the last `\" + s.opts.FinalTool + \"` call did not match the schema\"\n\t\t\treturn nil, fantasy.FinishReasonToolCalls\n\t\t}\n\t\ts.finalErr = validationErr\n\t\tif validationErr != nil {\n\t\t\ts.validationExhausted = true\n\t\t}\n\t\taccepted := *final\n\t\ts.acceptFinal = &accepted\n\t\t// Fantasy still validates required fields before dispatch; if it\n\t\t// rejects the call, the run can end here without a submission.\n\t\ts.stopCause = \"the last `\" + s.opts.FinalTool + \"` call did not pass tool-call validation\"\n\t\treturn nil, fantasy.FinishReasonToolCalls\n\t}\n\n\tif s.finalTurn {\n\t\t// Auto tool selection can produce prose or other tool calls. Only a\n\t\t// validated final submission may finish successfully; never dispatch\n\t\t// exploration tools, even ones Fantasy still knows how to execute.\n\t\t// Recording tools still run.\n\t\ts.blockExploration = \"Not executed: exploration is finished.\"\n\t\tif m.canRetrySubmission() {\n\t\t\treturn []fantasy.ToolCallContent{nudgeCall(fmt.Sprintf(\"roast-final-%d\", s.submissionAttempts),\n\t\t\t\t\"Exploration is finished. Return the result via the `\"+s.opts.FinalTool+\"` tool call, not prose or another tool.\")}, fantasy.FinishReasonToolCalls\n\t\t}\n\t\ts.stopCause = \"the model answered without calling `\" + s.opts.FinalTool + \"`\"\n\t\tif len(calls) > 0 {\n\t\t\ts.stopCause = \"the model called other tools instead of `\" + s.opts.FinalTool + \"`\"\n\t\t}\n\t\tattempts := \"attempts\"\n\t\tif s.submissionAttempts == 1 {\n\t\t\tattempts = \"attempt\"\n\t\t}\n\t\ts.stopCause += fmt.Sprintf(\" (%d submission %s)\", s.submissionAttempts, attempts)\n\t\tif records > 0 {\n\t\t\t// Keep what the model recorded: dispatch, then stop.\n\t\t\ts.halt = true\n\t\t\treturn nil, fantasy.FinishReasonToolCalls\n\t\t}\n\t\treturn nil, fantasy.FinishReasonStop\n\t}\n\n\tif len(calls) > 0 {\n\t\treturn nil, fantasy.FinishReasonToolCalls\n\t}\n\treturn []fantasy.ToolCallContent{nudgeCall(fmt.Sprintf(\"roast-nudge-%d\", s.turn),\n\t\t\"Results must be delivered via the `\"+s.opts.FinalTool+\"` tool call. If you have enough context call it now; otherwise call an exploration tool.\")}, fantasy.FinishReasonToolCalls\n}\n\nfunc (c *client) CompleteStructured(ctx context.Context, system, user string, schemaName string, out any) error {\n\treturn runAgent(ctx, c, system, user, ConverseOpts{\n\t\tTools:     []Tool{{Name: schemaName, Description: \"Return the requested structured result.\", Schema: reflectSchema(out)}},\n\t\tFinalTool: schemaName,\n\t\tMaxTurns:  1,\n\t}, out, true)\n}\n\nfunc (c *client) Converse(ctx context.Context, system, user string, opts ConverseOpts, out any) error {\n\treturn runAgent(ctx, c, system, user, opts, out, false)\n}\n\nfunc runAgent(ctx context.Context, c *client, system, user string, opts ConverseOpts, out any, structured bool) error {\n\tif findTool(opts.Tools, opts.FinalTool) == nil {\n\t\treturn fmt.Errorf(\"final tool %q is not configured\", opts.FinalTool)\n\t}\n\tstate := &agentRunState{\n\t\topts: opts, model: c.cfg.Model, wd: newWorkDeadlineState(opts), structured: structured, out: out,\n\t\ttoolNames: make(map[string]bool, len(opts.Tools)+1), toolSchemas: make(map[string]map[string]any, len(opts.Tools)),\n\t\trecordTools: make(map[string]bool),\n\t}\n\tif structured {\n\t\tstate.finalTurn = true\n\t}\n\n\ttools := make([]fantasy.AgentTool, 0, len(opts.Tools)+1)\n\tfor i := range opts.Tools {\n\t\tinfo, schema, err := fantasyToolInfo(opts.Tools[i])\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"tool %s schema: %w\", opts.Tools[i].Name, err)\n\t\t}\n\t\tstate.toolSchemas[opts.Tools[i].Name] = schema\n\t\tstate.toolNames[opts.Tools[i].Name] = true\n\t\tstate.active = append(state.active, opts.Tools[i].Name)\n\t\tif opts.Tools[i].Name == opts.FinalTool {\n\t\t\ttools = append(tools, finalFantasyTool(info, state))\n\t\t\tcontinue\n\t\t}\n\t\tif opts.Tools[i].RecordsResult {\n\t\t\tstate.recordTools[opts.Tools[i].Name] = true\n\t\t}\n\t\ttools = append(tools, explorationFantasyTool(info, opts.Tools[i], state))\n\t}\n\tstate.toolNames[nudgeToolName] = true\n\ttools = append(tools, nudgeFantasyTool())\n\n\tmanaged := &managedModel{client: c, state: state}\n\tagent := fantasy.NewAgent(managed,\n\t\tfantasy.WithSystemPrompt(system),\n\t\tfantasy.WithMaxOutputTokens(int64(c.cfg.MaxOutputTokens)),\n\t\tfantasy.WithTools(tools...),\n\t\tfantasy.WithMaxRetries(maxAttempts(c.cfg)-1),\n\t\tfantasy.WithPrepareStep(state.prepareStep),\n\t\tfantasy.WithRepairToolCall(func(context.Context, fantasy.ToolCallRepairOptions) (*fantasy.ToolCallContent, error) {\n\t\t\treturn nil, errors.New(\"tool-call repair disabled\")\n\t\t}),\n\t\tfantasy.WithStopConditions(func([]fantasy.StepResult) bool {\n\t\t\treturn state.finalDone || state.validationExhausted || state.halt ||\n\t\t\t\t(state.finalTurn && state.submissionAttempts >= maxAttempts(c.cfg)) ||\n\t\t\t\tstate.deadlinePassedDuringFinalization()\n\t\t}),\n\t)\n\n\tctx = context.WithValue(ctx, sessionContextKey{}, \"roast-\"+rand.Text())\n\t_, runErr := agent.Stream(ctx, fantasy.AgentStreamCall{Prompt: user})\n\tvar permanent permanentModelError\n\tif errors.As(runErr, &permanent) {\n\t\t// permanentModelError is intentionally opaque while Fantasy classifies\n\t\t// retries. Restore its cause once that layer has finished.\n\t\trunErr = permanent.err\n\t}\n\tif state.finalDone {\n\t\treturn nil\n\t}\n\tif state.finalErr != nil {\n\t\terr := fmt.Errorf(\"%s: %s arguments did not satisfy the schema (%v); if truncated, raise max_output_tokens\", state.model, opts.FinalTool, state.finalErr)\n\t\tif state.cutoff != nil {\n\t\t\treturn state.cutoffError(\"wrap-up submission was invalid\", err)\n\t\t}\n\t\treturn err\n\t}\n\tif runErr != nil {\n\t\tif errors.Is(runErr, ErrNoFinalCall) {\n\t\t\t// The wrap-up call already explained itself, provider error included.\n\t\t\treturn runErr\n\t\t}\n\t\tif state.cutoff != nil {\n\t\t\treturn state.cutoffError(\"wrap-up turn failed\", runErr)\n\t\t}\n\t\treturn normalizeProviderError(ctx, c.cfg.Model, runErr)\n\t}\n\tvar cause error\n\tif state.stopCause != \"\" {\n\t\tcause = fmt.Errorf(\"%s: %s\", state.model, state.stopCause)\n\t}\n\tif state.cutoff != nil {\n\t\treturn state.cutoffError(\"wrap-up turn produced no submission\", cause)\n\t}\n\tif cause != nil {\n\t\treturn fmt.Errorf(\"%w: %v\", ErrNoFinalCall, cause)\n\t}\n\treturn ErrNoFinalCall\n}\n\ntype roastFantasyTool struct {\n\tinfo fantasy.ToolInfo\n\trun  func(context.Context, fantasy.ToolCall) (fantasy.ToolResponse, error)\n\topts fantasy.ProviderOptions\n}\n\nfunc (t *roastFantasyTool) Info() fantasy.ToolInfo { return t.info }\nfunc (t *roastFantasyTool) Run(ctx context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {\n\treturn t.run(ctx, call)\n}\nfunc (t *roastFantasyTool) ProviderOptions() fantasy.ProviderOptions        { return t.opts }\nfunc (t *roastFantasyTool) SetProviderOptions(opts fantasy.ProviderOptions) { t.opts = opts }\n\nfunc explorationFantasyTool(info fantasy.ToolInfo, definition Tool, state *agentRunState) fantasy.AgentTool {\n\treturn &roastFantasyTool{info: info, run: func(ctx context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {\n\t\tif state.blockExploration != \"\" && !definition.RecordsResult {\n\t\t\treturn fantasy.NewTextErrorResponse(state.blockExploration), nil\n\t\t}\n\t\targs := decodeArgs(call.Input)\n\t\tvar result any\n\t\tvar err error\n\t\tif definition.Run == nil {\n\t\t\terr = errors.New(\"tool has no implementation\")\n\t\t} else {\n\t\t\tresult, err = state.wd.runTool(ctx, &definition, args)\n\t\t}\n\t\tif err != nil {\n\t\t\tresult = map[string]any{\"error\": err.Error()}\n\t\t}\n\t\tif state.opts.OnTurn != nil {\n\t\t\tstate.opts.OnTurn(TurnInfo{Turn: state.turn, Tool: definition.Name, Args: args})\n\t\t}\n\t\tdata, marshalErr := json.Marshal(result)\n\t\tif marshalErr != nil {\n\t\t\tdata, _ = json.Marshal(map[string]any{\"error\": marshalErr.Error()})\n\t\t}\n\t\treturn fantasy.NewTextResponse(string(data)), nil\n\t}}\n}\n\nfunc finalFantasyTool(info fantasy.ToolInfo, state *agentRunState) fantasy.AgentTool {\n\treturn &roastFantasyTool{info: info, run: func(_ context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {\n\t\t// Fantasy may repair malformed JSON locally. A final submission that\n\t\t// Roast already rejected must not become successful after that repair.\n\t\tif state.finalErr != nil {\n\t\t\tresp := fantasy.NewTextErrorResponse(state.finalErr.Error())\n\t\t\tresp.StopTurn = true\n\t\t\treturn resp, nil\n\t\t}\n\t\tif state.rejectFinal != \"\" {\n\t\t\treturn fantasy.NewTextErrorResponse(state.rejectFinal), nil\n\t\t}\n\t\tif state.finalDone {\n\t\t\tresp := fantasy.NewTextResponse(\"Already submitted.\")\n\t\t\tresp.StopTurn = true\n\t\t\treturn resp, nil\n\t\t}\n\t\t// A response may carry several submissions; only the one that was\n\t\t// validated is accepted.\n\t\tif accepted := state.acceptFinal; accepted == nil || accepted.ToolCallID != call.ID || accepted.Input != call.Input {\n\t\t\treturn fantasy.NewTextErrorResponse(\"Not accepted: call `\" + info.Name + \"` once per response.\"), nil\n\t\t}\n\t\tresp := fantasy.NewTextResponse(call.Input)\n\t\tresp.StopTurn = true\n\t\tif err := json.Unmarshal([]byte(call.Input), state.out); err != nil {\n\t\t\tstate.finalErr = err\n\t\t\tresp = fantasy.NewTextErrorResponse(err.Error())\n\t\t\tresp.StopTurn = true\n\t\t\treturn resp, nil\n\t\t}\n\t\tstate.finalErr = nil\n\t\tstate.finalDone = true\n\t\treturn resp, nil\n\t}}\n}\n\nfunc nudgeFantasyTool() fantasy.AgentTool {\n\treturn &roastFantasyTool{\n\t\tinfo: fantasy.ToolInfo{\n\t\t\tName: nudgeToolName, Description: \"Continue the Roast tool loop after a free-form response.\",\n\t\t\tParameters: map[string]any{\"message\": map[string]any{\"type\": \"string\"}}, Required: []string{\"message\"},\n\t\t},\n\t\trun: func(_ context.Context, call fantasy.ToolCall) (fantasy.ToolResponse, error) {\n\t\t\tvar payload struct {\n\t\t\t\tMessage string `json:\"message\"`\n\t\t\t}\n\t\t\t_ = json.Unmarshal([]byte(call.Input), &payload)\n\t\t\treturn fantasy.NewTextResponse(payload.Message), nil\n\t\t},\n\t}\n}\n\nfunc nudgeCall(id, message string) fantasy.ToolCallContent {\n\tdata, _ := json.Marshal(map[string]string{\"message\": message})\n\treturn fantasy.ToolCallContent{ToolCallID: id, ToolName: nudgeToolName, Input: string(data)}\n}\n\nfunc decodeArgs(arguments string) map[string]any {\n\tvar args map[string]any\n\tif err := json.Unmarshal([]byte(arguments), &args); err != nil {\n\t\treturn map[string]any{\"error\": fmt.Sprintf(\"args parse error: %v\", err)}\n\t}\n\treturn args\n}\n\nfunc fantasyToolInfo(t Tool) (fantasy.ToolInfo, map[string]any, error) {\n\tdata, err := json.Marshal(t.Schema)\n\tif err != nil {\n\t\treturn fantasy.ToolInfo{}, nil, err\n\t}\n\tvar schema map[string]any\n\tif err := json.Unmarshal(data, &schema); err != nil {\n\t\treturn fantasy.ToolInfo{}, nil, err\n\t}\n\tparameters, _ := schema[\"properties\"].(map[string]any)\n\tif parameters == nil {\n\t\tparameters = map[string]any{}\n\t}\n\tvar required []string\n\tif raw, ok := schema[\"required\"].([]any); ok {\n\t\tfor _, item := range raw {\n\t\t\tif name, ok := item.(string); ok {\n\t\t\t\trequired = append(required, name)\n\t\t\t}\n\t\t}\n\t}\n\treturn fantasy.ToolInfo{Name: t.Name, Description: t.Description, Parameters: parameters, Required: required}, schema, nil\n}\n\n// cloneSchema returns a deep copy of schema for one request. Fantasy's\n// Anthropic adapter reads a required list only as []string and sends an empty\n// one for any other shape, so every required list the JSON round trip decoded\n// as []any is restored to []string.\nfunc cloneSchema(schema map[string]any) map[string]any {\n\tdata, _ := json.Marshal(schema)\n\tvar clone map[string]any\n\t_ = json.Unmarshal(data, &clone)\n\trestoreRequiredLists(clone)\n\treturn clone\n}\n\nfunc restoreRequiredLists(node any) {\n\tswitch node := node.(type) {\n\tcase map[string]any:\n\t\tfor key, child := range node {\n\t\t\tif list, ok := child.([]any); ok && key == \"required\" {\n\t\t\t\tif names, ok := stringList(list); ok {\n\t\t\t\t\tnode[key] = names\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t}\n\t\t\trestoreRequiredLists(child)\n\t\t}\n\tcase []any:\n\t\tfor _, item := range node {\n\t\t\trestoreRequiredLists(item)\n\t\t}\n\t}\n}\n\nfunc stringList(items []any) ([]string, bool) {\n\tnames := make([]string, 0, len(items))\n\tfor _, item := range items {\n\t\tname, ok := item.(string)\n\t\tif !ok {\n\t\t\treturn nil, false\n\t\t}\n\t\tnames = append(names, name)\n\t}\n\treturn names, true\n}\n\nfunc reflectSchema(v any) map[string]any {\n\tr := &jsonschema.Reflector{Anonymous: true, AllowAdditionalProperties: false, DoNotReference: true}\n\ts := r.Reflect(v)\n\ts.Version = \"\"\n\tdata, _ := json.Marshal(s)\n\tvar out map[string]any\n\t_ = json.Unmarshal(data, &out)\n\treturn out\n}\n\nfunc validateFinalArguments(arguments string, out any) error {\n\tdata := json.RawMessage(arguments)\n\tif !json.Valid(data) {\n\t\treturn errors.New(\"invalid JSON\")\n\t}\n\tt := reflect.TypeOf(out)\n\tif t == nil || t.Kind() != reflect.Pointer {\n\t\treturn errors.New(\"output must be a pointer\")\n\t}\n\tscratch := reflect.New(t.Elem()).Interface()\n\treturn json.Unmarshal(data, scratch)\n}\n\nfunc normalizedMaxTurns(turns int) int {\n\tif turns <= 0 {\n\t\treturn 8\n\t}\n\treturn turns\n}\n\nfunc findTool(tools []Tool, name string) *Tool {\n\tfor i := range tools {\n\t\tif tools[i].Name == name {\n\t\t\treturn &tools[i]\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc fantasyConversationBytes(messages fantasy.Prompt) int {\n\tdata, _ := json.Marshal(messages)\n\treturn len(data)\n}\n","numLines":833,"startLine":1,"totalLines":833}},"tool_result_meta":[{"id":"toolu_01G8zQoMh1gyvGK6EDvi9ov2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
