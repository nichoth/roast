ON input: arguments are not a JSON object'\n    }\n    const required = Array.isArray(schema.required) ? schema.required : []\n    for (const name of required) {\n        if (typeof name === 'string' && !Object.hasOwn(args, name)) {\n            return `missing required parameter: ${name}`\n        }\n    }\n    return null\n}\n\nexport type TypeValidation<T> =\n    | { ok:true, value:T }\n    | { ok:false, error:string }\n\n// Parses the final arguments with integer preservation and decodes them\n// through the caller's spec.\nexport function typeValidate<T> (\n    text:string,\n    spec:FinalSpec<T>\n):TypeValidation<T> {\n    let value:unknown\n    try {\n        value = parsePreservingIntegers(text)\n    } catch {\n        return { ok:false, error:'invalid JSON' }\n    }\n    try {\n        return { ok:true, value:spec.decode(value) }\n    } catch (err) {\n        return { ok:false, error:errorText(err) }\n    }\n}\n\n// Tool arguments as the object a tool's `run` and `onTurn` receive.\nexport function decodeArgs (input:string):Record<string, unknown> {\n    let args:unknown\n    try {\n        args = JSON.parse(input)\n    } catch (err) {\n        return { error:`args parse error: ${errorText(err)}` }\n    }\n    if (args === null) return {}\n    if (!isObject(args)) {\n        return { error:'args parse error: arguments are not a JSON object' }\n    }\n    return args\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3928,"cache_read_input_tokens":151001,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3928},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"79353e88-0eda-49f3-aae4-5b092ab34fc4","uuid":"5d7ab041-fb69-4d21-9690-a8b33b002829","timestamp":"2026-11-18T20: