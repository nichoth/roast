{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PrJVFTjUq6RSubT9AZvjhr","type":"tool_result","content":"// The swappable `fetch` (the TS form of Go's redirectDefaultTransport,\n// shared with login and doctor) and the Roast-controlled request headers\n// (spec 06, 2.3). Nothing here reads the environment.\n\nimport { buildInfo } from '../buildinfo.js'\nimport type { Protocol } from './types.js'\n\nlet override:typeof globalThis.fetch|undefined\n\n// Replaces the fetch every client without its own `fetch` uses (tests).\nexport function setFetch (f:typeof globalThis.fetch):void {\n    override = f\n}\n\nexport function resetFetch ():void {\n    override = undefined\n}\n\nexport function currentFetch ():typeof globalThis.fetch {\n    return override ?? globalThis.fetch\n}\n\nexport function userAgent ():string {\n    return `roast/${buildInfo.version}`\n}\n\n// Every header of one request. The session headers are set last; header\n// names are case-insensitive, so a session header spelled like another\n// header yields one header holding the session ID.\nexport function requestHeaders (\n    protocol:Protocol,\n    apiKey:string,\n    sessionId:string,\n    sessionHeader?:string\n):Headers {\n    const h = new Headers()\n    h.set('Content-Type', 'application/json')\n    h.set('Accept', 'text/event-stream')\n    if (protocol === 'anthropic') {\n        h.set('X-Api-Key', apiKey)\n        h.set('Anthropic-Version', '2023-06-01')\n    } else {\n        h.set('Authorization', `Bearer ${apiKey}`)\n    }\n    h.set('User-Agent', userAgent())\n    h.set('X-Agent-Session-Id', sessionId)\n    if (sessionHeader) h.set(sessionHeader, sessionId)\n    return h\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"79353e88-0eda-49f3-aae4-5b092ab34fc4","uuid":"4add30ab-b7e7-4f25-ad67-18f87047ebb7","timestamp":"2026-11-18T20:16:34.909Z","tool_use_result":{"stdout":"// The swappable `fetch` (the TS form of Go's redirectDefaultTransport,\n// shared with login and doctor) and the Roast-controlled request headers\n// (spec 06, 2.3). Nothing here reads the environment.\n\nimport { buildInfo } from '../buildinfo.js'\nimport type { Protocol } from './types.js'\n\nlet override:typeof globalThis.fetch|undefined\n\n// Replaces the fetch every client without its own `fetch` uses (tests).\nexport function setFetch (f:typeof globalThis.fetch):void {\n    override = f\n}\n\nexport function resetFetch ():void {\n    override = undefined\n}\n\nexport function currentFetch ():typeof globalThis.fetch {\n    return override ?? globalThis.fetch\n}\n\nexport function userAgent ():string {\n    return `roast/${buildInfo.version}`\n}\n\n// Every header of one request. The session headers are set last; header\n// names are case-insensitive, so a session header spelled like another\n// header yields one header holding the session ID.\nexport function requestHeaders (\n    protocol:Protocol,\n    apiKey:string,\n    sessionId:string,\n    sessionHeader?:string\n):Headers {\n    const h = new Headers()\n    h.set('Content-Type', 'application/json')\n    h.set('Accept', 'text/event-stream')\n    if (protocol === 'anthropic') {\n        h.set('X-Api-Key', apiKey)\n        h.set('Anthropic-Version', '2023-06-01')\n    } else {\n        h.set('Authorization', `Bearer ${apiKey}`)\n    }\n    h.set('User-Agent', userAgent())\n    h.set('X-Agent-Session-Id', sessionId)\n    if (sessionHeader) h.set(sessionHeader, sessionId)\n    return h\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01PrJVFTjUq6RSubT9AZvjhr","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChB1UsuziegwMonFBB7hD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013wbBRuk6QSvqnQY72rSRgD","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-14-agent-loop-token-ledger/test/llm/agent-helpers.ts","content":"// A scripted fake ModelClient for agent-loop tests: each request takes\n// the next step of the script (a canned turn, an error to throw, or a\n// function of the request), and every request is recorded.\nimport type { ModelClient } from '../../src/llm/client.js'\nimport { createClient, type CreateClientOptions } from '../../src/llm/client.js'\nimport type {\n    AssistantPart,\n    Client,\n    ClientConfig,\n    ConversationItem,\n    ConverseOptions,\n    FinishReason,\n    ModelRequest,\n    ModelTurn,\n    Tool,\n    ToolDefinition,\n    Usage,\n} from '../../src/llm/types.js'\nimport { zeroUsage } from '../../src/llm/usage.js'\n\nexport type Step =\n    | ModelTurn\n    | Error\n    | ((req:ModelRequest, n:number) => ModelTurn|Promise<ModelTurn>)\n\nexport interface Recorded {\n    system:string;\n    items:ConversationItem[];\n    tools:ToolDefinition[];\n    sessionId:string;\n    signal:AbortSignal;\n    // Whether the signal was already aborted when the request arrived.\n    abortedAtSend:boolean;\n}\n\nexport interface FakeModel {\n    model:ModelClient;\n    requests:Recorded[];\n}\n\nexport function fakeModel (\n    script:Step[]|((req:ModelRequest, n:number) => Step),\n    over:Partial<ClientConfig> = {}\n):FakeModel {\n    const config:ClientConfig = {\n        role:'finder',\n        baseUrl:'http://fake.invalid',\n        apiKey:'sk-test',\n        model:'fake-model',\n        protocol:'chat',\n        maxOutputTokens:100,\n        maxAttempts:4,\n        requestTimeoutMs:0,\n        ...over,\n    }\n    const requests:Recorded[] = []\n    const model:ModelClient = {\n        config,\n        protocol:'chat',\n        maxAttempts:config.maxAttempts > 0 ? config.maxAttempts : 4,\n        requestBytes:() => 100,\n        usage:zeroUsage,\n        async send (req:ModelRequest):Promise<ModelTurn> {\n            const n = requests.length\n            requests.push({\n                system:req.system,\n                items:structuredClone(req.items),\n                tools:structuredClone(req.tools),\n                sessionId:req.sessionId,\n                signal:req.signal,\n                abortedAtSend:req.signal.aborted,\n            })\n            let step:Step|undefined\n            if (typeof script === 'function' && !Array.isArray(script)) {\n                step = script(req, n)\n            } else {\n                step = script[n]\n            }\n            if (step === undefined) throw new Error(`script exhausted at ${n}`)\n            if (step instanceof Error) throw step\n            if (typeof step === 'function') return step(req, n)\n            return structuredClone(step)\n        },\n    }\n    return { model, requests }\n}\n\nexport function usage (over:Partial<Usage> = {}):Usage {\n    return { ...zeroUsage(), calls:1, ...over }\n}\n\nexport function turn (\n    parts:AssistantPart[],\n    finishReason:FinishReason = 'tool-calls',\n    u:Usage = usage()\n):ModelTurn {\n    return { parts, finishReason, usage:u }\n}\n\nlet ids = 0\n\nexport function callPart (\n    name:string,\n    input:unknown = {},\n    id = `call-${++ids}`\n):AssistantPart {\n    return {\n        type:'tool-call',\n        id,\n        name,\n        input:typeof input === 'string' ? input : JSON.stringify(input),\n    }\n}\n\n// One response calling the given tools.\nexport function calls (...parts:AssistantPart[]):ModelTurn {\n    return turn(parts)\n}\n\nexport function call (name:string, input:unknown = {}, id?:string):ModelTurn {\n    return calls(callPart(name, input, id))\n}\n\nexport const FINAL = 'submit'\n\nexport function submit (input:unknown = { summary:'ok' }):ModelTurn {\n    return call(FINAL, input)\n}\n\nexport function prose (text = 'I think it is fine.'):ModelTurn {\n    return turn([{ type:'text', text }], 'stop')\n}\n\nexport interface Summary {\n    summary?:string;\n    id?:number|bigint;\n}\n\nexport const FINAL_SCHEMA = {\n    type:'object',\n    properties:{\n        summary:{ type:'string' },\n        id:{ type:'integer' },\n    },\n    required:['summary'],\n    additionalProperties:false,\n}\n\n// Mirrors decoding into a typed result: present properties must have the\n// right type; absent ones (and null) are allowed.\nexport function decodeSummary (value:unknown):Summary {\n    if (value === null) return {}\n    if (typeof value !== 'object' || Array.isArray(value)) {\n        throw new Error('result is not an object')\n    }\n    const v = value as Record<string, unknown>\n    const out:Summary = {}\n    if (v.summary !== undefined && v.summary !== null) {\n        if (typeof v.summary !== 'string') {\n            throw new Error('summary is not a string')\n        }\n        out.summary = v.summary\n    }\n    if (v.id !== undefined && v.id !== null) {\n        if (typeof v.id === 'bigint') out.id = v.id\n        else if (typeof v.id === 'number' && Number.isInteger(v.id)) {\n            out.id = v.id\n        } else throw new Error('id is not an integer')\n    }\n    return out\n}\n\nexport function finalTool ():Tool {\n    return {\n        name:FINAL,\n        description:'Submit the result.',\n        schema:structuredClone(FINAL_SCHEMA),\n    }\n}\n\n// An exploration tool that counts its runs.\nexport function readTool (log:string[] = []):Tool&{ runs:number } {\n    const tool = {\n        name:'read',\n        description:'Read a file.',\n        schema:{\n            type:'object',\n            properties:{ path:{ type:'string' } },\n        },\n        runs:0,\n        run (args:Record<string, unknown>) {\n            tool.runs++\n            log.push(`read:${String(args.path)}`)\n            return { text:'contents' }\n        },\n    }\n    return tool\n}\n\n// A record tool that counts its runs.\nexport function recordTool (\n    onRun?:() => void\n):Tool&{ runs:number } {\n    const tool = {\n        name:'report',\n        description:'Record one finding.',\n        schema:{ type:'object', properties:{ title:{ type:'string' } } },\n        recordsResult:true,\n        runs:0,\n        run () {\n            tool.runs++\n            onRun?.()\n            return { ok:true }\n        },\n    }\n    return tool\n}\n\nexport function options (\n    tools:Tool[],\n    over:Partial<ConverseOptions<Summary>> = {}\n):ConverseOptions<Summary> {\n    return {\n        tools,\n        finalTool:FINAL,\n        final:{ decode:decodeSummary },\n        ...over,\n    }\n}\n\nexport interface Harness extends FakeModel {\n    client:Client;\n    sleeps:number[];\n}\n\n// A client over a fake model; sleeps are recorded and return at once.\nexport function harness (\n    script:Step[]|((req:ModelRequest, n:number) => Step),\n    over:Partial<ClientConfig> = {},\n    clientOpts:CreateClientOptions = {}\n):Harness {\n    const fake = fakeModel(script, over)\n    const sleeps:number[] = []\n    const client = createClient(fake.model, {\n        sleep:async ms => { sleeps.push(ms) },\n        ...clientOpts,\n    })\n    return { ...fake, client, sleeps }\n}\n\nexport async function failure (p:Promise<unknown>):Promise<unknown> {\n    try {\n        await p\n    } catch (err) {\n        return err\n    }\n    throw new Error('expected a rejection')\n}\n\nexport function signal ():AbortSignal {\n    return new AbortController().signal\n}\n\n// The tool results message of a recorded request, if its last item is\n// one.\nexport function lastResults (r:Recorded) {\n    const last = r.items[r.items.length - 1]\n    return last?.role === 'tool' ? last.results : []\n}\n\n// Resolves when `s` aborts.\nexport function aborted (s:AbortSignal):Promise<void> {\n    return new Promise(resolve => {\n        if (s.aborted) resolve()\n        else s.addEventListener('abort', () => resolve(), { once:true })\n    })\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5315,"cache_read_input_tokens":173939,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5315},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"79353e88-0eda-49f3-aae4-5b092ab34fc4","uuid":"5d23c580-acfc-4606-bd4b-4ca919791e19","timestamp":"2026-11-18T20:16:57.156Z","request_id":"req_011ChB1Use7ayvczrZ1TgSbX","wire_tool_inputs":{"toolu_013wbBRuk6QSvqnQY72rSRgD":{"file_path":"/Users/nick/code/roast.ts-rewrite-14-agent-loop-token-ledger/test/llm/agent-helpers.ts","content":"// A scripted fake ModelClient for agent-loop tests: each request takes\n// the next step of the script (a canned turn, an error to throw, or a\n// function of the request), and every request is recorded.\nimport type { ModelClient } from '../../src/llm/client.js'\nimport { createClient, type CreateClientOptions } from '../../src/llm/client.js'\nimport type {\n    AssistantPart,\n    Client,\n    ClientConfig,\n    ConversationItem,\n    ConverseOptions,\n    FinishReason,\n    ModelRequest,\n    ModelTurn,\n    Tool,\n    ToolDefinition,\n    Usage,\n} from '../../src/llm/types.js'\nimport { zeroUsage } from '../../src/llm/usage.js'\n\nexport type Step =\n    | ModelTurn\n    | Error\n    | ((req:ModelRequest, n:number) => ModelTurn|Promise<ModelTurn>)\n\nexport interface Recorded {\n    system:string;\n    items:ConversationItem[];\n    tools:ToolDefinition[];\n    sessionId:string;\n    signal:AbortSignal;\n    // Whether the signal was already aborted when the request arrived.\n    abortedAtSend:boolean;\n}\n\nexport interface FakeModel {\n 