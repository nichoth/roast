{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLxqR6ULEeABxujsQntj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017yiS4PgaU16zvNBUBWN65h","name":"Bash","input":{"command":"sed -n 1,120p test/snapshot/snapshot.ts; cat test/cli/review-snapshot.ts | head -120; grep -n \"snapshot\\|runs\" test/index.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2215,"cache_read_input_tokens":82913,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2215},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0de572ae-0eae-4979-b0e7-cefd41e0bbfc","uuid":"0081fa05-8c95-425b-a5fb-d842b4559679","timestamp":"2026-11-24T02:27:54.689Z","request_id":"req_011ChLxqQxnVT7aWj2w7hz6w","wire_tool_inputs":{"toolu_017yiS4PgaU16zvNBUBWN65h":{"command":"cd /Users/nick/code/roast.ts-rewrite-24-runs-checkout-and-prune && sed -n 1,120p test/snapshot/snapshot.ts; cat test/cli/review-snapshot.ts | head -120; grep -n \"snapshot\\|runs\" test/index.ts"}},"wire_ingest_context":{"toolu_017yiS4PgaU16zvNBUBWN65h":{"cwd":"/Users/nick/code/roast.ts-rewrite-24-runs-checkout-and-prune"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017yiS4PgaU16zvNBUBWN65h","type":"tool_result","content":"// The snapshot module against real temporary Git repositories (spec 11,\n// test plan items 1-3, 5-8, 10-12).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport {\n    REF_PREFIX,\n    capture,\n    deleteSnapshot,\n    headOid,\n    pinWorktree,\n    revOid,\n    treeOid,\n} from '../../src/snapshot/snapshot.js'\nimport { newRepo, type TestRepo } from '../scope/helpers.js'\n\nfunction repoFor (t:CleanupTest, opts:{ commit?:boolean } = {}):TestRepo {\n    const r = newRepo(opts)\n    t.cleanup(() => r.cleanup())\n    return r\n}\n\nfunction head (r:TestRepo):string {\n    return r.git('rev-parse', 'HEAD').trim()\n}\n\n// The shared \"messy repo\": a clean committed file, a staged modification,\n// an unstaged modification, an unstaged deletion, untracked files (plain,\n// executable, symlink), an ignored secret, and an untracked deploy.pem.\nfunction messyRepo (t:CleanupTest):TestRepo {\n    const r = repoFor(t)\n    r.write('clean.go', 'package clean\\n')\n    r.write('staged.go', 'package staged\\n')\n    r.write('unstaged.go', 'package unstaged\\n')\n    r.write('deleted.go', 'package deleted\\n')\n    r.write('.gitignore', 'secret.txt\\n')\n    r.commitAll('base')\n    r.write('staged.go', 'package staged // staged edit\\n')\n    r.git('add', 'staged.go')\n    r.write('unstaged.go', 'package unstaged // unstaged edit\\n')\n    fs.rmSync(path.join(r.dir, 'deleted.go'))\n    r.write('untracked.go', 'package untracked\\n')\n    r.write('run.sh', '#!/bin/sh\\necho hi\\n')\n    fs.chmodSync(path.join(r.dir, 'run.sh'), 0o755)\n    fs.symlinkSync('clean.go', path.join(r.dir, 'link.go'))\n    r.write('secret.txt', 'ignored secret\\n')\n    r.write('deploy.pem', '-----BEGIN KEY-----\\n')\n    return r\n}\n\nfunction indexBytes (r:TestRepo):Buffer {\n    return fs.readFileSync(path.join(r.dir, '.git', 'index'))\n}\n\n// Paths in a tree, recursively.\nfunction treePaths (r:TestRepo, tree:string):string[] {\n    return r.git('ls-tree', '-r', '--name-only', '-z', tree)\n        .split('\\0').filter(Boolean)\n}\n\ntest('capture leaves the source status and live index unchanged',\n    async t => {\n        const r = messyRepo(t)\n        const status = r.git('status', '--porcelain')\n        const index = indexBytes(r)\n        const snap = await capture(r.dir, {\n            runId:'run-1', headOid:head(r), baseOid:'', env:r.env,\n        })\n        t.equal(snap.ref, REF_PREFIX + 'run-1', 'ref name')\n        t.equal(r.git('rev-parse', snap.ref).trim(), snap.commit,\n            'ref points at the commit')\n        t.ok(indexBytes(r).equals(index), 'live index byte-identical')\n        t.equal(r.git('status', '--porcelain'), status, 'status unchanged')\n    })\n\ntest('the worktree tree omits ignored and denylisted untracked files',\n    async t => {\n        const r = messyRepo(t)\n        const snap = await capture(r.dir, {\n            runId:'run-1', headOid:head(r), baseOid:'', env:r.env,\n        })\n        const paths = treePaths(r, snap.worktreeTree)\n        t.ok(paths.includes('untracked.go'), 'untracked file captured')\n        t.ok(!paths.includes('secret.txt'), 'ignored secret omitted')\n        t.ok(!paths.includes('deploy.pem'), 'deploy.pem omitted')\n        t.ok(!paths.includes('deleted.go'), 'deletion captured')\n        t.deepEqual(snap.excluded, ['deploy.pem'], 'excluded list')\n        t.ok(fs.existsSync(path.join(r.dir, 'deploy.pem')),\n            'deploy.pem stays on disk')\n        const mode = r.git('ls-tree', snap.worktreeTree, 'run.sh')\n        t.ok(mode.startsWith('100755'), 'exec bit kept')\n        const link = r.git('ls-tree', snap.worktreeTree, 'link.go')\n        t.ok(link.startsWith('120000'), 'symlink kept')\n        const idx = treePaths(r, snap.indexTree)\n        t.ok(idx.includes('deleted.go'), 'index tree keeps deleted.go')\n        t.ok(!idx.includes('untracked.go'), 'index tree has no untracked')\n    })\n\ntest('an untracked file literally named *.key is excluded literally',\n    async t => {\n        const r = repoFor(t)\n        // A tracked .key file is not denylisted; a glob exclude would\n        // still skip its edit.\n        r.write('tracked.key', 'old\\n')\n        r.commitAll('tracked key')\n        r.write('tracked.key', 'new\\n')\n        r.write('*.key', 'secret\\n')\n        r.write('keep.go', 'package keep\\n')\n        const pin = await pinWorktree(r.dir, { env:r.env })\n        const paths = treePaths(r, pin.tree)\n        t.ok(paths.includes('keep.go'), 'keep.go captured')\n        t.ok(!paths.includes('*.key'), '*.key excluded')\n        t.deepEqual(pin.excluded, ['*.key'], 'excluded list')\n        t.equal(r.git('show', `${pin.tree}:tracked.key`), 'new\\n',\n            'tracked edit captured')\n    })\n\nfunction refs (r:TestRepo):string {\n    return r.git('for-each-ref', '--format=%(refname)', REF_PREFIX).trim()\n// Snapshots taken during `roast review` (spec 01, 2.8 steps 10 and 15,\n// 2.13; spec 11, \"When a review takes snapshots\", test plan 16-18).\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport type { RecordedRequest, Script } from '../helpers/inference-server.js'\nimport {\n    approveProjectConfig,\n    chatCalls,\n    gitIn,\n    profileConfig,\n    reviewMeta,\n    runDirs,\n    settingsRepo,\n    writeConfig,\n    type ReviewRepo,\n} from '../helpers/review.js'\n\nconst REVIEW = ['review', '--no-verify', '--format', 'json']\n\nasync function configure (r:ReviewRepo, over:object):Promise<void> {\n    writeConfig(r.dir, profileConfig(r.server.url, over))\n    await approveProjectConfig(r)\n}\n\n// The config with review.snapshot absent (capture on).\nasync function snapshotsOn (r:ReviewRepo, over:object = {}):Promise<void> {\n    await configure(r, { review:{}, ...over })\n}\n\nfunction snapshotRefs (r:ReviewRepo):string[] {\n    return gitIn(r, ['for-each-ref', '--format=%(refname)',\n        'refs/roast/snapshots/']).split('\\n').filter(Boolean)\n}\n\nfunction rev (r:ReviewRepo, name:string):string {\n    return gitIn(r, ['rev-parse', name]).trim()\n}\n\nfunction clearRuns (r:ReviewRepo):void {\n    for (const dir of runDirs(r)) fs.rmSync(dir, { recursive:true })\n}\n\ntest('the default config captures a snapshot with a ref', async t => {\n    const r = await settingsRepo(t)\n    await snapshotsOn(r)\n    const res = await r.roast(REVIEW)\n    t.equal(res.code, 0, res.stderr)\n    const meta = reviewMeta(r)\n    const snap = meta.snapshot\n    t.equal(snap.captured, true, 'captured')\n    t.equal(snap.ref, `refs/roast/snapshots/${meta.run_id}`, 'ref name')\n    t.deepEqual(snapshotRefs(r), [snap.ref], 'the ref exists')\n    t.equal(rev(r, snap.ref), snap.commit, 'ref names the commit')\n    t.equal(rev(r, `${snap.ref}:index`), snap.index_tree, 'index tree')\n    t.equal(rev(r, `${snap.ref}:worktree`), snap.worktree_tree,\n        'worktree tree')\n    t.equal(snap.head, rev(r, 'HEAD'), 'head')\n    t.equal(typeof snap.diff_pair, 'string', 'diff pair')\n    t.ok(typeof snap.file_modes === 'string' && snap.file_modes !== '',\n        'file modes')\n    t.ok(!('reason' in snap), 'no reason when captured')\n    t.ok(gitIn(r, ['show', `${snap.worktree_tree}:main.go`])\n        .includes('if value < 0'), 'worktree holds the uncommitted edit')\n    t.equal(meta.scope.head_oid, snap.head, 'scope head falls back')\n})\n\ntest('diff_pair follows the scope', async t => {\n    const r = await settingsRepo(t)\n    await snapshotsOn(r)\n    const first = rev(r, 'HEAD')\n    fs.writeFileSync(path.join(r.dir, 'other.go'), 'package main\\n')\n    gitIn(r, ['add', 'other.go', '.roast.json'])\n    gitIn(r, ['commit', '-q', '-m', 'second'])\n\n    t.equal((await r.roast([...REVIEW, '--uncommitted-only'])).code, 0,\n        'unbased review')\n    let meta = reviewMeta(r)\n    t.equal(meta.snapshot.diff_pair, 'head..worktree', 'head..worktree')\n    t.equal(meta.snapshot.base_tree, rev(r, 'HEAD^{tree}'), 'head tree')\n    clearRuns(r)\n\n    t.equal((await r.roast([...REVIEW, '--base', first])).code, 0,\n        'based review')\n    meta = reviewMeta(r)\n    t.equal(meta.snapshot.diff_pair, 'base..worktree', 'base..worktree')\n    t.equal(meta.snapshot.base, first, 'base recorded')\n    t.equal(meta.snapshot.base_tree, rev(r, `${first}^{tree}`),\n        'base tree')\n    t.equal(meta.scope.base_oid, first, 'scope base falls back')\n    t.equal(rev(r, `${meta.snapshot.ref}^2`), first, 'base parent')\n    clearRuns(r)\n\n    gitIn(r, ['add', 'main.go'])\n    t.equal((await r.roast([...REVIEW, '--staged'])).code, 0,\n        'staged review')\n    meta = reviewMeta(r)\n    t.equal(meta.snapshot.diff_pair, 'head..index', 'head..index')\n    t.equal(meta.snapshot.captured, true, 'captured')\n})\n\ntest('an untracked denylisted file is excluded with a caveat', async t => {\n    const r = await settingsRepo(t)\n    await snapshotsOn(r)\n    fs.writeFileSync(path.join(r.dir, 'deploy.pem'), 'secret\\n')\n    t.equal((await r.roast(REVIEW)).code, 0, 'review')\n    const meta = reviewMeta(r)\n    t.deepEqual(meta.snapshot.excluded_paths, ['deploy.pem'], 'excluded')\n    t.ok(meta.caveats.some((c:string) => c.includes('excluded 1')),\n        'excluded-count caveat')\n    t.ok(fs.existsSync(path.join(r.dir, 'deploy.pem')), 'file kept')\n})\n\ntest('ROAST_SNAPSHOT=0 does not disable capture', async t => {\n    const r = await settingsRepo(t)\n    await snapshotsOn(r)\n    r.env.ROAST_SNAPSHOT = '0'\n    t.equal((await r.roast(REVIEW)).code, 0, 'review')\n    t.equal(reviewMeta(r).snapshot.captured, true, 'captured')\n    t.equal(snapshotRefs(r).length, 1, 'ref written')\n18:import './snapshot/denylist.js'\n19:import './snapshot/snapshot.js'\n89:import './cli/runs.js'\n121:import './cli/review-snapshot.js'","is_error":false}]},"parent_tool_use_id":null,"session_id":"0de572ae-0eae-4979-b0e7-cefd41e0bbfc","uuid":"3a6efa47-15a7-48bd-b192-e5def943f785","timestamp":"2026-11-24T02:27:54.799Z","tool_use_result":{"stdout":"// The snapshot module against real temporary Git repositories (spec 11,\n// test plan items 1-3, 5-8, 10-12).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport {\n    REF_PREFIX,\n    capture,\n    deleteSnapshot,\n    headOid,\n    pinWorktree,\n    revOid,\n    treeOid,\n} from '../../src/snapshot/snapshot.js'\nimport { newRepo, type TestRepo } from '../scope/helpers.js'\n\nfunction repoFor (t:CleanupTest, opts:{ commit?:boolean } = {}):TestRepo {\n    const r = newRepo(opts)\n    t.cleanup(() => r.cleanup())\n    return r\n}\n\nfunction head (r:TestRepo):string {\n    return r.git('rev-parse', 'HEAD').trim()\n}\n\n// The shared \"messy repo\": a clean committed file, a staged modification,\n// an unstaged modification, an unstaged deletion, untracked files (plain,\n// executable, symlink), an ignored secret, and an untracked deploy.pem.\nfunction messyRepo (t:CleanupTest):TestRepo {\n    const r = repoFor(t)\n    r.write('clean.go', 'package clean\\n')\n    r.write('staged.go', 'package staged\\n')\n    r.write('unstaged.go', 'package unstaged\\n')\n    r.write('deleted.go', 'package deleted\\n')\n    r.write('.gitignore', 'secret.txt\\n')\n    r.commitAll('base')\n    r.write('staged.go', 'package staged // staged edit\\n')\n    r.git('add', 'staged.go')\n    r.write('unstaged.go', 'package unstaged // unstaged edit\\n')\n    fs.rmSync(path.join(r.dir, 'deleted.go'))\n    r.write('untracked.go', 'package untracked\\n')\n    r.write('run.sh', '#!/bin/sh\\necho hi\\n')\n    fs.chmodSync(path.join(r.dir, 'run.sh'), 0o755)\n    fs.symlinkSync('clean.go', path.join(r.dir, 'link.go'))\n    r.write('secret.txt', 'ignored secret\\n')\n    r.write('deploy.pem', '-----BEGIN KEY-----\\n')\n    return r\n}\n\nfunction indexBytes (r:TestRepo):Buffer {\n    return fs.readFileSync(path.join(r.dir, '.git', 'index'))\n}\n\n// Paths in a tree, recursively.\nfunction treePaths (r:TestRepo, tree:string):string[] {\n    return r.git('ls-tree', '-r', '--name-only', '-z', tree)\n        .split('\\0').filter(Boolean)\n}\n\ntest('capture leaves the source status and live index unchanged',\n    async t => {\n        const r = messyRepo(t)\n        const status = r.git('status', '--porcelain')\n        const index = indexBytes(r)\n        const snap = await capture(r.dir, {\n            runId:'run-1', headOid:head(r), baseOid:'', env:r.env,\n        })\n        t.equal(snap.ref, REF_PREFIX + 'run-1', 'ref name')\n        t.equal(r.git('rev-parse', snap.ref).trim(), snap.commit,\n            'ref points at the commit')\n        t.ok(indexBytes(r).equals(index), 'live index byte-identical')\n        t.equal(r.git('status', '--porcelain'), status, 'status unchanged')\n    })\n\ntest('the worktree tree omits ignored and denylisted untracked files',\n    async t => {\n        const r = messyRepo(t)\n        const snap = await capture(r.dir, {\n            runId:'run-1', headOid:head(r), baseOid:'', env:r.env,\n        })\n        const paths = treePaths(r, snap.worktreeTree)\n        t.ok(paths.includes('untracked.go'), 'untracked file captured')\n        t.ok(!paths.includes('secret.txt'), 'ignored secret omitted')\n        t.ok(!paths.includes('deploy.pem'), 'deploy.pem omitted')\n        t.ok(!paths.includes('deleted.go'), 'deletion captured')\n        t.deepEqual(snap.excluded, ['deploy.pem'], 'excluded list')\n        t.ok(fs.existsSync(path.join(r.dir, 'deploy.pem')),\n            'deploy.pem stays on disk')\n        const mode = r.git('ls-tree', snap.worktreeTree, 'run.sh')\n        t.ok(mode.startsWith('100755'), 'exec bit kept')\n        const link = r.git('ls-tree', snap.worktreeTree, 'link.go')\n        t.ok(link.startsWith('120000'), 'symlink kept')\n        const idx = treePaths(r, snap.indexTree)\n        t.ok(idx.includes('deleted.go'), 'index tree keeps deleted.go')\n        t.ok(!idx.includes('untracked.go'), 'index tree has no untracked')\n    })\n\ntest('an untracked file literally named *.key is excluded literally',\n    async t => {\n        const r = repoFor(t)\n        // A tracked .key file is not denylisted; a glob exclude would\n        // still skip its edit.\n        r.write('tracked.key', 'old\\n')\n        r.commitAll('tracked key')\n        r.write('tracked.key', 'new\\n')\n        r.write('*.key', 'secret\\n')\n        r.write('keep.go', 'package keep\\n')\n        const pin = await pinWorktree(r.dir, { env:r.env })\n        const paths = treePaths(r, pin.tree)\n        t.ok(paths.includes('keep.go'), 'keep.go captured')\n        t.ok(!paths.includes('*.key'), '*.key excluded')\n        t.deepEqual(pin.excluded, ['*.key'], 'excluded list')\n        t.equal(r.git('show', `${pin.tree}:tracked.key`), 'new\\n',\n            'tracked edit captured')\n    })\n\nfunction refs (r:TestRepo):string {\n    return r.git('for-each-ref', '--format=%(refname)', REF_PREFIX).trim()\n// Snapshots taken during `roast review` (spec 01, 2.8 steps 10 and 15,\n// 2.13; spec 11, \"When a review takes snapshots\", test plan 16-18).\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport type { RecordedRequest, Script } from '../helpers/inference-server.js'\nimport {\n    approveProjectConfig,\n    chatCalls,\n    gitIn,\n    profileConfig,\n    reviewMeta,\n    runDirs,\n    settingsRepo,\n    writeConfig,\n    type ReviewRepo,\n} from '../helpers/review.js'\n\nconst REVIEW = ['review', '--no-verify', '--format', 'json']\n\nasync function configure (r:ReviewRepo, over:object):Promise<void> {\n    writeConfig(r.dir, profileConfig(r.server.url, over))\n    await approveProjectConfig(r)\n}\n\n// The config with review.snapshot absent (capture on).\nasync function snapshotsOn (r:ReviewRepo, over:object = {}):Promise<void> {\n    await configure(r, { review:{}, ...over })\n}\n\nfunction snapshotRefs (r:ReviewRepo):string[] {\n    return gitIn(r, ['for-each-ref', '--format=%(refname)',\n        'refs/roast/snapshots/']).split('\\n').filter(Boolean)\n}\n\nfunction rev (r:ReviewRepo, name:string):string {\n    return gitIn(r, ['rev-parse', name]).trim()\n}\n\nfunction clearRuns (r:ReviewRepo):void {\n    for (const dir of runDirs(r)) fs.rmSync(dir, { recursive:true })\n}\n\ntest('the default config captures a snapshot with a ref', async t => {\n    const r = await settingsRepo(t)\n    await snapshotsOn(r)\n    const res = await r.roast(REVIEW)\n    t.equal(res.code, 0, res.stderr)\n    const meta = reviewMeta(r)\n    const snap = meta.snapshot\n    t.equal(snap.captured, true, 'captured')\n    t.equal(snap.ref, `refs/roast/snapshots/${meta.run_id}`, 'ref name')\n    t.deepEqual(snapshotRefs(r), [snap.ref], 'the ref exists')\n    t.equal(rev(r, snap.ref), snap.commit, 'ref names the commit')\n    t.equal(rev(r, `${snap.ref}:index`), snap.index_tree, 'index tree')\n    t.equal(rev(r, `${snap.ref}:worktree`), snap.worktree_tree,\n        'worktree tree')\n    t.equal(snap.head, rev(r, 'HEAD'), 'head')\n    t.equal(typeof snap.diff_pair, 'string', 'diff pair')\n    t.ok(typeof snap.file_modes === 'string' && snap.file_modes !== '',\n        'file modes')\n    t.ok(!('reason' in snap), 'no reason when captured')\n    t.ok(gitIn(r, ['show', `${snap.worktree_tree}:main.go`])\n        .includes('if value < 0'), 'worktree holds the uncommitted edit')\n    t.equal(meta.scope.head_oid, snap.head, 'scope head falls back')\n})\n\ntest('diff_pair follows the scope', async t => {\n    const r = await settingsRepo(t)\n    await snapshotsOn(r)\n    const first = rev(r, 'HEAD')\n    fs.writeFileSync(path.join(r.dir, 'other.go'), 'package main\\n')\n    gitIn(r, ['add', 'other.go', '.roast.json'])\n    gitIn(r, ['commit', '-q', '-m', 'second'])\n\n    t.equal((await r.roast([...REVIEW, '--uncommitted-only'])).code, 0,\n        'unbased review')\n    let meta = reviewMeta(r)\n    t.equal(meta.snapshot.diff_pair, 'head..worktree', 'head..worktree')\n    t.equal(meta.snapshot.base_tree, rev(r, 'HEAD^{tree}'), 'head tree')\n    clearRuns(r)\n\n    t.equal((await r.roast([...REVIEW, '--base', first])).code, 0,\n        'based review')\n    meta = reviewMeta(r)\n    t.equal(meta.snapshot.diff_pair, 'base..worktree', 'base..worktree')\n    t.equal(meta.snapshot.base, first, 'base recorded')\n    t.equal(meta.snapshot.base_tree, rev(r, `${first}^{tree}`),\n        'base tree')\n    t.equal(meta.scope.base_oid, first, 'scope base falls back')\n    t.equal(rev(r, `${meta.snapshot.ref}^2`), first, 'base parent')\n    clearRuns(r)\n\n    gitIn(r, ['add', 'main.go'])\n    t.equal((await r.roast([...REVIEW, '--staged'])).code, 0,\n        'staged review')\n    meta = reviewMeta(r)\n    t.equal(meta.snapshot.diff_pair, 'head..index', 'head..index')\n    t.equal(meta.snapshot.captured, true, 'captured')\n})\n\ntest('an untracked denylisted file is excluded with a caveat', async t => {\n    const r = await settingsRepo(t)\n    await snapshotsOn(r)\n    fs.writeFileSync(path.join(r.dir, 'deploy.pem'), 'secret\\n')\n    t.equal((await r.roast(REVIEW)).code, 0, 'review')\n    const meta = reviewMeta(r)\n    t.deepEqual(meta.snapshot.excluded_paths, ['deploy.pem'], 'excluded')\n    t.ok(meta.caveats.some((c:string) => c.includes('excluded 1')),\n        'excluded-count caveat')\n    t.ok(fs.existsSync(path.join(r.dir, 'deploy.pem')), 'file kept')\n})\n\ntest('ROAST_SNAPSHOT=0 does not disable capture', async t => {\n    const r = await settingsRepo(t)\n    await snapshotsOn(r)\n    r.env.ROAST_SNAPSHOT = '0'\n    t.equal((await r.roast(REVIEW)).code, 0, 'review')\n    t.equal(reviewMeta(r).snapshot.captured, true, 'captured')\n    t.equal(snapshotRefs(r).length, 1, 'ref written')\n18:import './snapshot/denylist.js'\n19:import './snapshot/snapshot.js'\n89:import './cli/runs.js'\n121:import './cli/review-snapshot.js'","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017yiS4PgaU16zvNBUBWN65h","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
