{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLy6nTWV44Y8RWhGHzmN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011z71Ht8ug6HwjpMt2s9nc1","name":"Bash","input":{"command":"python3 - <<'EOF'\np='test/cli/runs-snapshot.ts'\ns=open(p).read()\ns=s.replace(\"\"\"import { test, type CleanupTest } from '../helpers/test.js'\n\"\"\",\"\"\"import { test, type CleanupTest } from '../helpers/test.js'\nimport { runRoast } from '../helpers/run.js'\nimport { tempDir, tempRepo } from '../helpers/repo.js'\n\"\"\")\ns+=\"\"\"\nfunction snapshotRefs (r:ReviewRepo):string[] {\n    return gitIn(r, ['for-each-ref', '--format=%(refname)',\n        'refs/roast/snapshots/']).split('\\\\n').filter(Boolean)\n}\n\ntest('runs prune with no refs exits 0 and prints nothing', async t => {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const res = await runRoast(['runs', 'prune', '--dry-run'],\n        { cwd:r.dir, env:r.env })\n    t.equal(res.code, 0, res.stderr)\n    t.equal(res.stdout, '', 'nothing on stdout')\n})\n\ntest('runs prune lists, then deletes, only the snapshot ref', async t => {\n    const { r, id } = await reviewed(t)\n    const ref = `refs/roast/snapshots/${id}`\n    const dry = await r.roast(['runs', 'prune', '--dry-run',\n        '--older-than', '1ns'])\n    t.equal(dry.code, 0, dry.stderr)\n    const lines = dry.stdout.split('\\\\n').filter(Boolean)\n    t.equal(lines.length, 1, 'one line')\n    t.ok(lines[0]?.startsWith(`would delete ${ref} `), 'names the ref')\n    t.deepEqual(snapshotRefs(r), [ref], 'ref left in place')\n\n    const real = await r.roast(['runs', 'prune', '--older-than', '1ns'])\n    t.equal(real.code, 0, real.stderr)\n    t.equal(real.stdout.split('\\\\n').filter(Boolean).length, 1, 'one line')\n    t.deepEqual(snapshotRefs(r), [], 'ref deleted')\n    t.ok(fs.existsSync(path.join(r.dir, '.roast', 'runs', id,\n        'meta.json')), 'run directory remains')\n})\n\ntest('runs prune usage errors exit 2', async t => {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const outsideRepo = tempDir()\n    t.cleanup(outsideRepo.remove)\n    const cases:[string, string[], string][] = [\n        ['a bad --older-than', ['--older-than', 'bogus'], r.dir],\n        ['a positional', ['extra'], r.dir],\n        ['outside a repository', ['--dry-run'], outsideRepo.dir],\n    ]\n    for (const [name, args, cwd] of cases) {\n        const res = await runRoast(['runs', 'prune', ...args],\n            { cwd, env:r.env })\n        t.equal(res.code, 2, `${name} exits 2`)\n        t.equal(res.stdout, '', `${name} prints nothing`)\n    }\n})\n\"\"\"\nopen(p,'w').write(s)\nEOF\nnode scripts/bundle.ts --test-file test/cli/runs-snapshot.ts >/dev/null && node test/one-bundle.js 2>&1 | grep -E \"^not ok|^# \" | head -30"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":368,"cache_read_input_tokens":125847,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":368},"output_tokens":178,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0de572ae-0eae-4979-b0e7-cefd41e0bbfc","uuid":"57afd885-68eb-4172-b9ab-5dcb8447aa1b","timestamp":"2026-11-24T02:31:28.483Z","request_id":"req_011ChLy6nJai7EyJRfGSfbW7","wire_tool_inputs":{"toolu_011z71Ht8ug6HwjpMt2s9nc1":{"command":"cd /Users/nick/code/roast.ts-rewrite-24-runs-checkout-and-prune && python3 - <<'EOF'\np='test/cli/runs-snapshot.ts'\ns=open(p).read()\ns=s.replace(\"\"\"import { test, type CleanupTest } from '../helpers/test.js'\n\"\"\",\"\"\"import { test, type CleanupTest } from '../helpers/test.js'\nimport { runRoast } from '../helpers/run.js'\nimport { tempDir, tempRepo } from '../helpers/repo.js'\n\"\"\")\ns+=\"\"\"\nfunction snapshotRefs (r:ReviewRepo):string[] {\n   