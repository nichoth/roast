{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLxqwZnFMPZRVW8GDYvm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01J23B29Hv7K1Ue7hy7NUtPq","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-24-runs-checkout-and-prune/test/snapshot/restore.ts","content":"// Loading, restoring, and pruning snapshots against real temporary Git\n// repositories (spec 11, test plan items 1 and 9).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport {\n    REF_PREFIX,\n    capture,\n    load,\n} from '../../src/snapshot/snapshot.js'\nimport { newRepo, type TestRepo } from '../scope/helpers.js'\n\nfunction repoFor (t:CleanupTest):TestRepo {\n    const r = newRepo()\n    t.cleanup(() => r.cleanup())\n    return r\n}\n\nfunction head (r:TestRepo):string {\n    return r.git('rev-parse', 'HEAD').trim()\n}\n\nasync function errorOf (fn:() => Promise<unknown>):Promise<Error|null> {\n    try {\n        await fn()\n    } catch (err) {\n        return err as Error\n    }\n    return null\n}\n\ntest('load of a missing ref fails', async t => {\n    const r = repoFor(t)\n    const err = await errorOf(() => load(r.dir, 'nope', { env:r.env }))\n    t.ok(err?.message.startsWith(`no snapshot ref ${REF_PREFIX}nope in `),\n        'missing ref error')\n})\n\ntest('load returns head and base from the parents', async t => {\n    const r = repoFor(t)\n    const base = head(r)\n    r.write('b.go', 'package b\\n')\n    r.commitAll('second')\n    const tip = head(r)\n    r.write('b.go', 'package b // edit\\n')\n    r.write('deploy.pem', 'secret\\n')\n    const snap = await capture(r.dir, {\n        runId:'run-1', headOid:tip, baseOid:base, env:r.env,\n    })\n    const got = await load(r.dir, 'run-1', { env:r.env })\n    t.equal(got.ref, snap.ref, 'ref')\n    t.equal(got.commit, snap.commit, 'commit')\n    t.equal(got.indexTree, snap.indexTree, 'index tree')\n    t.equal(got.worktreeTree, snap.worktreeTree, 'worktree tree')\n    t.equal(got.head, tip, 'head is the first parent')\n    t.equal(got.base, base, 'base is the second parent')\n    t.deepEqual(got.excluded, [], 'excluded is not recoverable')\n\n    await capture(r.dir, {\n        runId:'run-2', headOid:tip, baseOid:'', env:r.env,\n    })\n    t.equal((await load(r.dir, 'run-2', { env:r.env })).base, '',\n        'no second parent means no base')\n})\n\nexport { execFileSync, fs, path }\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4850,"cache_read_input_tokens":90074,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4850},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0de572ae-0eae-4979-b0e7-cefd41e0bbfc","uuid":"ac07613a-bb34-4463-877c-8be2f366dba1","timestamp":"2026-11-24T02:28:05.693Z","request_id":"req_011ChLxqwQ7b6WYHCHbmVBtv","wire_tool_inputs":{"toolu_01J23B29Hv7K1Ue7hy7NUtPq":{"file_path":"/Users/nick/code/roast.ts-rewrite-24-runs-checkout-and-prune/test/snapshot/restore.ts","content":"// Loading, restoring, and pruning snapshots against real temporary Git\n// repositories (spec 11, test plan items 1 and 9).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport {\n    REF_PREFIX,\n    capture,\n    load,\n} from '../../src/snapshot/snapshot.js'\nimport { newRepo, type TestRepo } from '../scope/helpers.js'\n\nfunction repoFor (t:CleanupTest):TestRepo {\n    const r = newRepo()\n    t.cleanup(() => r.cleanup())\n    return r\n}\n\nfunction head (r:TestRepo):string {\n    return r.git('rev-parse',