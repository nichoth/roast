AN : String(raw)\n    try {\n        return parseGoDuration(s)\n    } catch (err) {\n        throw new UsageError(`invalid argument ${JSON.stringify(s)} for ` +\n            `\"--older-than\" flag: ${errorMessage(err)}`, { cause:err })\n    }\n}\n\n// Go `age.Round(time.Hour)` (half away from zero), as a Go duration.\nfunction roundedAge (ageMs:number):string {\n    const hours = Math.sign(ageMs) * Math.round(Math.abs(ageMs) /\n        MS_PER_HOUR)\n    return formatGoDuration(BigInt(hours) * NS_PER_HOUR)\n}\n\n// `runs prune [--older-than d] [--dry-run]` (spec 11): deletes aged\n// snapshot refs; run records are never touched.\nasync function pruneHandler (\n    args:CommandArgs,\n    ctx:RunContext\n):Promise<void> {\n    const olderThan = parseOlderThan(args['older-than'])\n    const env = ctx.env as NodeJS.ProcessEnv\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, { env, signal:ctx.signal })\n    } catch (err) {\n        ctx.signal.throwIfAborted()\n        throw new UsageError(errorMessage(err), { cause:err })\n    }\n    const dryRun = Boolean(args['dry-run'])\n    // Fractional milliseconds keep sub-millisecond thresholds positive.\n    const ms = Number(olderThan / NS_PER_MS) +\n        Number(olderThan % NS_PER_MS) / 1e6\n    const pruned = await prune(repo, ms, dryRun,\n        { env, signal:ctx.signal })\n    if (pruned.length === 0) {\n        ctx.stderr.write('roast: no snapshot refs older than ' +\n            `${formatGoDuration(olderThan)}\\\\n`)\n        return\n    }\n    const verb = dryRun ? 'would delete' : 'deleted'\n    for (const p of pruned) {\n        ctx.stdout.write(`${verb} ${p.ref} (age ${roundedAge(p.ageMs)})\\\\n`)\n    }\n}\n\nconst pruneCommand:CommandDef = {\n    command:'prune',\n    describe:'Delete old snapshot refs under refs/roast/snapshots/',\n    builder:(y:Argv) => y\n        .option('older-than', {\n            type:'string',\n            describe:'Delete snapshot refs at least this old',\n            default:undefined,\n            defaultDescription:'720h0m0s',\n        })\n        .option('dry-run', {\n            type:'boolean',\n            default:false,\n            describe:'List refs that would be deleted',\n        }),\n    handler:pruneHandler,\n}\n\n// The `runs` subcommands.\nexport const runsSubcommands:CommandDef[] = [\n    showCommand, checkoutCommand, pruneCommand,\n]\"\"\")\nopen(p,'w').write(s)\nEOF\nnode scripts/bundle.ts --test-file test/cli/runs-snapshot.ts >/dev/null && node test/one-bundle.js 2>&1 | grep -E \"^not ok|^# \" | head -30"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1710,"cache_read_input_tokens":126215,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1710},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0de572ae-0eae-4979-b0e7-cefd41e0bbfc","uuid":"3900dd7f-6465-4b2f-aefa-160ff932c012","timestamp":"2026-11-24T02:31:50.276Z","request_id":"req_011ChLy7pAEddNtq2jiR2DYV","wire_tool_inputs":{"toolu_01HY4koNGR9X33XJQMgro5Ks":{"command":"cd /Users/nick/code/roast.ts-rewrite-24-runs-checkout-and-prune && sed -i '' \"s/        \\['outside a repository', \\['--dry-run'\\], outsideRepo.dir\\],/        ['outside a repository', ['--dry-run'], outsideRepo.dir],/\" test/cli/runs-snapshot.ts && python3 - <<'EOF'\np='test/cli/runs-snapshot.ts'\ns=open(p).read()\ns=s.replace(\"\"\"    const cases:[string, string[], string][] = [\n        ['a bad --older-than', ['--older-than', 'bogus'], r.dir],\n        ['a positional', ['extra'], r.dir],\n        ['outside a repository', ['--dry-run'], outsideRepo.dir],\n    ]\n    for (const [name, args, cwd] of cases) {\n        const res = await runRoast(['runs', 'prune', ...args],\n            { cwd, env:r.env