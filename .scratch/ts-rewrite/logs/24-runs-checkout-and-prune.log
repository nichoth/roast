{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLy1MvFKYPwC8avqhV16","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FiMmb3QxXW8Mjxxar9PRRd","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-24-runs-checkout-and-prune/test/cli/runs-snapshot.ts","content":"// `roast runs checkout` and `roast runs prune` after a real review\n// (spec 11, test plan items 13-15 and the \"New tests\" paragraph).\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport {\n    approveProjectConfig,\n    gitIn,\n    profileConfig,\n    reviewMeta,\n    settingsRepo,\n    writeConfig,\n    type ReviewRepo,\n} from '../helpers/review.js'\n\nconst REVIEW = ['review', '--no-verify', '--format', 'json']\n\n// A repository reviewed once with snapshots on; returns the run ID.\nasync function reviewed (\n    t:CleanupTest,\n    review:object = {}\n):Promise<{ r:ReviewRepo, id:string }> {\n    const r = await settingsRepo(t)\n    writeConfig(r.dir, profileConfig(r.server.url, { review }))\n    await approveProjectConfig(r)\n    const res = await r.roast(REVIEW)\n    if (res.code !== 0) throw new Error(`review failed: ${res.stderr}`)\n    return { r, id:reviewMeta(r).run_id }\n}\n\n// Registers removal of a worktree checked out at `dest`.\nfunction removeLater (t:CleanupTest, r:ReviewRepo, dest:string):void {\n    t.cleanup(() => {\n        try {\n            gitIn(r, ['worktree', 'remove', '--force', dest])\n        } catch {\n            fs.rmSync(dest, { recursive:true, force:true })\n        }\n    })\n}\n\nfunction reviewedFile (r:ReviewRepo):string {\n    return fs.readFileSync(path.join(r.dir, 'main.go'), 'utf8')\n}\n\ntest('runs checkout materializes the reviewed state', async t => {\n    const { r, id } = await reviewed(t)\n    const dest = fs.mkdtempSync(path.join(r.dir, '..', 'roast-co-')) +\n        '/out'\n    removeLater(t, r, dest)\n    t.cleanup(() => fs.rmSync(path.dirname(dest),\n        { recursive:true, force:true }))\n    const res = await r.roast(['runs', 'checkout', id, dest])\n    t.equal(res.code, 0, res.stderr)\n    t.equal(res.stdout, dest + '\\n', 'stdout is only the destination')\n    t.ok(res.stderr.includes('worktree remove'), 'removal hint on stderr')\n    t.equal(fs.readFileSync(path.join(dest, 'main.go'), 'utf8'),\n        reviewedFile(r), 'reviewed content')\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3628,"cache_read_input_tokens":112312,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3628},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0de572ae-0eae-4979-b0e7-cefd41e0bbfc","uuid":"360a1196-a9bb-4ab6-ab30-b882a3268e9a","timestamp":"2026-11-24T02:30:14.734Z","request_id":"req_011ChLy1MmL1fwAgwz1uzgfr","wire_tool_inputs":{"toolu_01FiMmb3QxXW8Mjxxar9PRRd":{"file_path":"/Users/nick/code/roast.ts-rewrite-24-runs-checkout-and-prune/test/cli/runs-snapshot.ts","content":"// `roast runs checkout` and `roast runs prune` after a real review\n// (spec 11, test plan items 13-15 and the \"New tests\" paragraph).\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport {\n    approveProjectConfig,\n    gitIn,\n    profileConfig,\n    reviewMeta,\n    settingsRepo,\n    writeConfig,\n    type ReviewRepo,\n} from '../helpers/review.js'\n\nconst REVIEW = ['review', '--no-verify', '--format', 'json']\n\n// A repository reviewed once with snapshots on; returns the run ID.\nasync function reviewed (\n    t:CleanupTest,\n    review:object = {}\n):Promise<{ r:ReviewRepo, id:string }> {\n    const r = await settingsRepo(t)\n    writeConfig(r.dir, profileConfig(r.server.url, { review }))\n    await approveProjectConfig(r)\n    const res = await r.roast(REVIEW)\n    if (res.code !== 0) throw new Error(`review failed: ${res.stderr}`)\n    return { r, id:reviewMeta(r).run_id }\n}\n\n// Registers removal of a worktree checked out at `dest`.\nfunction removeLater (t:CleanupTest, r:ReviewRepo, dest:string):void {\n    t.cleanup(() => {\n        try {\n            gitIn(r, ['worktree', 'remove', '--force', dest])\n        } catch {\n            fs.rmSync(dest, { recursive:true, force:true })\n        }\n    })\n}\n\nfunction reviewedFile (r:ReviewRepo):string {\n    return fs.readFileSync(path.join(r.dir, 'main.go'), 'utf8')\n}\n\ntest('runs checkout materializes the reviewed state', async t => {\n    const { r, id } = await reviewed(t)\n    const dest = fs.mkdtempSync(path.join(r.dir, '..', 'roast-co-')) +\n        '/out'\n    removeLater(t, r, dest)\n    t.cleanup(() => fs.rmSync(path.dirname(dest),\n        { recursive:true, force:true }))\n    const res = await r.roast(['runs', 'checkout', id, dest])\n    t.equal(res.code, 0, res.stderr)\n    t.equal(res.stdout, dest + '\\n', 'stdout is only the destination')\n    t.ok(res.stderr.includes('worktree remove'), 'removal hint on stderr')\n    t.equal(fs.readFileSync(path.join(dest, 'main.go'), 'utf8'),\n        reviewedFile(r), 'reviewed content')\n})\n"}}}
