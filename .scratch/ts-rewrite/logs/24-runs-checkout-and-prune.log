p = await fs.mkdtemp(\n            path.join(os.tmpdir(), 'roast-checkout-'))\n        dest = path.join(tmp, meta.run_id)\n    }\n    try {\n        await restore(meta.repo, meta.run_id, dest,\n            { env, signal:ctx.signal })\n    } catch (err) {\n        ctx.signal.throwIfAborted()\n        throw new Error(`restore run ${meta.run_id}: ${errorMessage(err)}`,\n            { cause:err })\n    }\n    ctx.stderr.write(`roast: remove with: git -C ${meta.repo} worktree ` +\n        `remove --force ${dest}\\\\n`)\n    ctx.stdout.write(dest + '\\\\n')\n}\n\nconst checkoutCommand:CommandDef = {\n    command:'checkout <run-id> [dir]',\n    describe:'Materialize a run\\\\'s Git snapshot as a linked worktree',\n    handler:checkoutHandler,\n}\n\n// The `runs` subcommands.\nexport const runsSubcommands:CommandDef[] = [showCommand, checkoutCommand]\"\"\")\ns=s.replace(\"\"\"// `roast runs` and `roast runs show` (spec 10, 2.14 and 2.15). The\n// snapshot area adds `checkout` and `prune` to runsSubcommands.\"\"\",\"\"\"// `roast runs` and `roast runs show` (spec 10, 2.14 and 2.15), and the\n// snapshot subcommands `runs checkout` and `runs prune` (spec 11).\"\"\")\nopen(p,'w').write(s)\nEOF\nnode scripts/bundle.ts --test-file test/cli/runs-snapshot.ts >/dev/null && node test/one-bundle.js 2>&1 | grep -E \"^not ok|^# |actual|expected\" | head"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1321,"cache_read_input_tokens":120214,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1321},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0de572ae-0eae-4979-b0e7-cefd41e0bbfc","uuid":"2e4a10d0-3af0-4e9e-b196-89947369ab76","timestamp":"2026-11-24T02:30:41.742Z","request_id":"req_011ChLy39c9Jo6hMH