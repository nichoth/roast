turn neg ? '-' + out : out\n}\n40:export type SnapshotMeta = {\n79:    snapshot:SnapshotMeta;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_014AKG4ScwmAWr8HajxMJEwQ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
