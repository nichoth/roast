*', 'id_xmss*',\n        'credentials.json', '.npmrc', '.pypirc', '.netrc', '_netrc',\n        '.pgpass', '.git-credentials', '*.p12', '*.pfx',\n    ], 'order')\n})\n\ntest('denylistedUntracked returns sorted untracked non-ignored hits',\n    async t => {\n        const repo = newRepo()\n        repo.write('tracked.pem', 'x\\n')\n        repo.commitAll()\n        repo.write('z/.env', 'SECRET=1\\n')\n        repo.write('b.key', 'k\\n')\n        repo.write('ignored.pem', 'k\\n')\n        repo.write('.gitignore', 'ignored.pem\\n')\n        repo.write('ok.go', 'package x\\n')\n        const got = await denylistedUntracked(repo.dir, { env:repo.env })\n        t.deepEqual(got, ['b.key', 'z/.env'], 'sorted, untracked only')\n        repo.cleanup()\n    })\n\ntest('denylistedUntracked with an empty list does not run git',\n    async t => {\n        const dir = fs.mkdtempSync(path.join('/tmp', 'roast-nogit-'))\n        // Not a repository: running git here would fail.\n        const got = await denylistedUntracked(dir, { patterns:[] })\n        t.deepEqual(got, [], 'empty')\n        fs.rmSync(dir, { recursive:true, force:true })\n    })\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1479,"cache_read_input_tokens":98040,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1479},"output_tokens":17,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4913b683-6028-48ab-bf68-aa225d725bd4","uuid":"0b65c6ad-825d-4c80-9317-c8b0b2e89fde","timestamp":"2026-11-18T19:24:42.861Z","request_id":"req_011ChAwWbsRpZaguTmJ9oYVa","wire_tool_inputs":{"toolu_01Mdd51ehXKcQZ6B1meDEkRW":{"file_path":"/Users/nick/code/roast.ts-rewrite-10-review-scope/test/snapshot/denylist.ts","content":"import { test } from '@substrate-system/tapz