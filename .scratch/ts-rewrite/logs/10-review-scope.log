length - 1\n        t.equal(markers, 2, 'two omission markers')\n        t.ok(s.diff.includes('+func Small() {}'), 'small file intact')\n        const notes = s.notes.join('\\n')\n        t.ok(notes.includes('data.txt') && notes.includes('untracked.txt'),\n            'notes name both cut files')\n        t.deepEqual([...s.files], ['data.txt', 'small.go', 'untracked.txt'],\n            'all three in files')\n        const growth = peak - before\n        t.ok(growth < HUGE / 2, `peak RSS growth ${growth} well below ${\n            HUGE}`)\n        repo.cleanup()\n    })\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3867,"cache_read_input_tokens":184797,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3867},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4913b683-6028-48ab-bf68-aa225d725bd4","uuid":"01c759bf-8848-4789-9db6-2092c8f1ca90","timestamp":"2026-11-18T19:33:22.007Z","request_id":"req_011ChAxAtGU637ghM1nGZbBM","wire_tool_inputs":{"toolu_01BDy1fRZC2oj1zdyKawQKTF":{"file_path":"/Users/nick/code/roast.ts-rewrite-10-review-scope/test/scope/huge.ts","content":"import { test } from '@substrate-system/tapzero'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { build } from '../../src/scope/index.js'\nimport { newRepo } from './helpers.js'\n\nconst LINE = 'a b c d e f g h\\n'\nconst LINES = 1_500_000\nconst HUGE = LINE.length * LINES // 24 MB\n\n// Writes the huge file in small chunks, so the test itself never holds it.\nfunction writeHuge (file:string):void {\n    const chunk = Buffer.from(LINE.repeat(4096))\n    const fd = fs.openSync(file, 'w')\n    let left = LINES\n    while (left > 0) {\n        const n = Math.min(4096, left)\n        fs.writeSync(fd, 