m(repo.dir + '/bad-'),\n            Buffer.from([0xff, 0xfe]), Buffer.from('.txt')])\n        try {\n            fs.writeFileSync(bad, 'x\\n')\n        } catch {\n            // Some file systems (APFS) refuse such names.\n            t.ok(true, 'skipped: file system refuses non-UTF-8 names')\n            repo.cleanup()\n            return\n        }\n        repo.write('good.txt', 'ok\\n')\n        const s = await build(repo.dir, { env:repo.env })\n        t.deepEqual([...s.files], ['good.txt'], 'only the valid name')\n        t.ok(s.notes.some(n => n.includes('not valid UTF-8')),\n            'warning note')\n        t.ok(fs.existsSync(path.join(repo.dir, 'good.txt')), 'build ok')\n        repo.cleanup()\n    })\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":7,"lines":[" import { test } from '@substrate-system/tapzero'"," import fs from 'node:fs'"," import path from 'node:path'","+import { execFileSync } from 'node:child_process'"," import { build } from '../../src/scope/index.js'"," import { compareBytes } from '../../src/gocompat/strings.js'"," import { newRepo } from './helpers.js'"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_016aKHT652MhCSWQ2tftk9JZ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
