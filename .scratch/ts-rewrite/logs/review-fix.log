{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JyCEb7Wabv64gzXkA9Ardv","type":"tool_result","content":"// `review` flags (spec 01, 2.6), their value syntax (2.11), and the raw\n// validation that runs before any config is read (2.7).\nimport type { Argv } from 'yargs'\nimport { Parser } from 'yargs/helpers'\nimport { parseGoDuration, type GoDuration } from '../gocompat/duration.js'\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport { parseSeverity, severityRank } from '../review/types.js'\nimport type { CommandArgs } from './command.js'\nimport { UsageError } from './errors.js'\n\nexport interface RoleFlags {\n    baseUrl?:string;\n    model?:string;\n    protocol?:string;\n    maxOutputTokens?:number;\n}\n\n// Optional fields are undefined when the flag was not given (\"changed\"\n// in Go terms); the documented default applies later.\nexport interface ReviewFlags {\n    config:string;\n    base:string;\n    uncommittedOnly:boolean;\n    staged:boolean;\n    task:string;\n    format:string;\n    maxSeverity:string;\n    paths:string[];\n    exclude:string[];\n    includeVendored:boolean;\n    mode:string;\n    quick:boolean;\n    noVerify:boolean;\n    interactive:boolean;\n    maxTurns?:number;\n    deadline?:GoDuration;\n    requestTimeout?:GoDuration;\n    maxTokensTotal?:number;\n    maxVerified?:number;\n    maxAttempts?:number;\n    showDropped:boolean;\n    lang:string[];\n    scope:string;\n    authorModel:string;\n    finder:RoleFlags;\n    verifier:RoleFlags;\n}\n\nexport const DEFAULT_MAX_TURNS = 16\nexport const SURVEY_MAX_TURNS = 40\nexport const DEFAULT_TASK = '(not provided)'\n\nconst BOOLEANS = [\n    'uncommitted-only', 'staged', 'include-vendored', 'quick', 'no-verify',\n    'interactive', 'show-dropped',\n] as const\n\nconst STRINGS = [\n    'config', 'base', 'task', 'format', 'max-severity', 'mode', 'scope',\n    'author-model', 'max-turns', 'deadline', 'request-timeout',\n    'max-tokens-total', 'max-verified', 'max-attempts',\n    'finder-base-url', 'finder-model', 'finder-protocol',\n    'finder-max-output-tokens', 'verifier-base-url', 'verifier-model',\n    'verifier-protocol', 'verifier-max-output-tokens', 'error-format',\n] as const\n\nconst SLICES = ['paths', 'exclude', 'lang'] as const\n\nconst DESCRIBE:Record<string, string> = {\n    config:'Project config path (default: nearest .roast.json up to ' +\n        'the Git toplevel)',\n    base:'Diff base ref',\n    'uncommitted-only':'Review only uncommitted changes',\n    staged:'Review exactly the staged set',\n    task:'What the builder was asked to do',\n    format:'Output format (json|markdown|both)',\n    'max-severity':'Exit 1 when a finding reaches this severity ' +\n        '(INFO|LOW|MEDIUM|HIGH|CRITICAL)',\n    paths:'Limit the review to these Git pathspecs',\n    exclude:'Exclude these Git pathspecs',\n    'include-vendored':'Review vendored and generated files',\n    mode:'Review mode (code|prose|mixed|auto)',\n    quick:'Single-shot finder, no verification',\n    'no-verify':'Skip verification',\n    interactive:'Let the finder navigate the checkout',\n    'max-turns':'Max interactive finder turns (default 16, 40 with ' +\n        '--scope repo)',\n    deadline:'Finder work deadline (default 10m, 25m with --scope ' +\n        'repo; 0 disables)',\n    'request-timeout':'Per inference request timeout (default 10m; 0 ' +\n        'disables)',\n    'max-tokens-total':'Shared token ceiling (default 3000000; 0 disables)',\n    'max-verified':'Max findings sent to the verifier (default 25)',\n    'max-attempts':'Provider and structured-output attempts (default 4)',\n    'show-dropped':'Render malformed and refuted candidates',\n    lang:'Prompt packs (go|react|frontend|web); none disables',\n    scope:'Review scope (diff|repo)',\n    'author-model':'Model or family that wrote the change',\n}\n\nfor (const role of ['finder', 'verifier']) {\n    DESCRIBE[`${role}-base-url`] = `${role} endpoint override`\n    DESCRIBE[`${role}-model`] = `${role} model override`\n    DESCRIBE[`${role}-protocol`] =\n        `${role} protocol override (chat|responses|anthropic)`\n    DESCRIBE[`${role}-max-output-tokens`] = `${role} output token ceiling`\n}\n\nconst DEFAULTS:Record<string, string|boolean> = {\n    config:'',\n    base:'',\n    task:DEFAULT_TASK,\n    format:'both',\n    'max-severity':'',\n    mode:'auto',\n    scope:'diff',\n    'author-model':'',\n}\n\n// Declares every review flag on `y`. Flags whose \"changed\" state matters\n// have no yargs default.\nexport function reviewBuilder (y:Argv):Argv {\n    let b = y\n    for (const name of BOOLEANS) {\n        b = b.option(name, {\n            type:'boolean', default:false, describe:DESCRIBE[name],\n        })\n    }\n    for (const name of STRINGS) {\n        if (name === 'error-format') continue\nimport {\n    type SnapshotDeps,\n    type WorktreePin,\n    captureSnapshot,\n    defaultSnapshotDeps,\n} from './snapshot-meta.js'\nimport { deleteSnapshot, pinWorktree } from '../snapshot/snapshot.js'\nimport { requireTrust } from './trust.js'\n\nconst QUICK_DIFF_BYTES = 200_000\nconst QUICK_FILE_CTX_BYTES = 100_000\nconst SURVEY_DEADLINE = '25m'\nconst INTERACTIVE_MIN_DIFF_LINES = 80\nconst INTERACTIVE_MIN_FILES = 4\nconst VERIFIER_MAX_TURNS = 8\nconst VERIFIER_SNIPPET_BYTES = 60_000\n\n// Swappable for tests: the snapshot area's functions.\nexport const reviewHooks:{\n    snapshot:((ctx:RunContext) => SnapshotDeps)|null;\n} = { snapshot:null }\n// Shared defaults for starter rendering and CLI settings.\nexport const DEFAULT_CONFIDENCE_FLOOR = 0.6\nexport const DEFAULT_QUICK_CONFIDENCE_FLOOR = 0.8\nexport const DEFAULT_SNAPSHOT = true\nexport const DEFAULT_GATE_OFFER = true\nexport const GATE_DEFAULT_TIMEOUT = 180\nexport const GATE_DEFAULT_SEVERITY = 'HIGH'\n\n// Durations use config spelling; CLI consumers parse them as Go durations.\nexport const DEFAULT_LIMITS = Object.freeze({\n    deadline:'10m',\n    request_timeout:'