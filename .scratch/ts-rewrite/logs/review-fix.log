string, err:unknown):Error {\n    return new Error(`${prefix}: ${message(err)}`, { cause:err })\n}\n\nasync function run (\n    repo:string,\n    args:readonly string[],\n    opts:SnapshotOpts,\n    extra?:{ env?:Record<string, string>, input?:string }\n):Promise<string> {\n    const out = await git(repo, args, {\n        signal:opts.signal,\n        env:opts.env,\n        extraEnv:extra?.env,\n        input:extra?.input,\n    })\n    return out.toString('utf8').trim()\n}\n\n// Runs a git step, wrapping a failure with `prefix` unless aborted.\nasync function step (\n    prefix:string,\n    opts:SnapshotOpts,\n    fn:() => Promise<string>\n):Promise<string> {\n    try {\n        return await fn()\n    } catch (err) {\n        opts.signal?.throwIfAborted()\n        throw wrap(prefix, err)\n    }\n}\n\n// The index a review reads: GIT_INDEX_FILE from `env` (relative values\n// against the toplevel `repo`), else `<gitDir>/index`.\nexport function liveIndexPath (\n    repo:string,\n    gitDir:string,\n    env:NodeJS.ProcessEnv\n):string {\n    const live = env.GIT_INDEX_FILE ?? ''\n    if (live === '') return path.join(gitDir, 'index')\n    return path.isAbsolute(live) ? live : path.join(repo, live)\n}\n\n// Copies an index byte for byte to `dst` (mode 0600, truncating). A\n// missing source writes nothing: git treats it as an empty index.\nexport async function copyIndex (src:string, dst:string):Promise<void> {\n    let data:Buffer\n    try {\n        data = await fs.readFile(src)\n    } catch (err) {\n        if ((err as NodeJS.ErrnoException).code === 'ENOENT') return\n        throw wrap(`read ${src}`, err)\n    }\n    let fh:fs.FileHandle\n    try {\n        fh = await fs.open(dst, 'w', 0o600)\n    } catch (err) {\n        throw wrap(`create ${dst}`, err)\n    }\n    try {\n        await fh.writeFile(data)\n    } catch (err) {\n        throw wrap('copy index', err)\n    } finally {\n        await fh.close()\n    }\n}\n\nfunction gitDirOf (repo:string, opts:SnapshotOpts):Promise<string> {\n    return step('resolve git dir', opts,\n        () => run(repo, ['rev-parse', '--absolute-git-dir'], opts))\n}\n\nasync function withTempDir<T> (\n    prefix:string,\n    fn:(dir:string) => Promise<T>\n// Byte-level text helpers for git output (spec 04, 2.15 and 3.4).\nexport { compareBytes } from '../gocompat/strings.js'\n\n// Splits on \"\\n\" and drops empty strings (no trimming).\nexport function nonEmptyLines (s:string):string[] {\n    return s.split('\\n').filter(line => line !== '')\n}\n\n// Splits raw git output on NUL, dropping exactly one trailing empty\n// element. Empty input yields no elements.\nexport function splitNul (buf:Buffer):Buffer[] {\n    const out:Buffer[] = []\n    let start = 0\n    while (start < buf.length) {\n        const nul = buf.indexOf(0, start)\n        if (nul === -1) {\n            out.push(buf.subarray(start))\n            break\n        }\n        out.push(buf.subarray(start, nul))\n        start = nul + 1\n    }\n    return out\n}\n\nexport interface DecodedPaths {\n    paths:string[];\n    // Names that are not valid UTF-8 and were dropped.\n    skipped:number;\n}\n\nconst fatal = new TextDecoder('utf-8', { fatal:true })\n\n// One raw name as a string, or null when it is not valid UTF-8.\nexport function decodeName (raw:Buffer):string|null {\n    try {\n        return fatal.decode(raw)\n    } catch {\n        return null\n    }\n}\n\n// Decodes NUL-separated path names. A name that is not valid UTF-8\n// cannot round-trip through a JS string, so it is skipped and counted.\nexport function decodePaths (buf:Buffer):DecodedPaths {\n    const paths:string[] = []\n    let skipped = 0\n    for (const raw of splitNul(buf)) {\n        const name = decodeName(raw)\n        if (name === null) skipped++\n        else paths.push(name)\n    }\n    return { paths, skipped }\n}\n// The one git runner. Every area runs git through here; scope and context\n// add their specialized wrappers (patch capping, streaming) on