at each flag's help shows them. It asserts on help text, which is close to your no-text-assertions rule, but I saw no other way to catch help drifting from the defaults.\n\nI added the reusable lessons to `docs/agents/scope-context.md`, since the root AGENTS.md says area notes go in their area file. My notes are in `.redeye/notes.md`, uncommitted.","ttft_ms":2565,"type":"result","duration_ms":15303,"uuid":"9702d68c-e863-4015-9333-8d5f5957edfb","ttft_stream_ms":842,"time_to_request_ms":97,"first_content_frame_ms":843,"queued_turn_count":0,"result_index":1,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":8,"outputTokens":1343,"cacheReadInputTokens":296198,"cacheCreationInputTokens":1388,"webSearchRequests":0,"costUSD":0.0972356,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":35,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":1388,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-12-09T10:07:39.368Z"}
