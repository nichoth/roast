@@ -0,0 +1,55 @@
+import core from '../../internal/prompts/templates/finder_core.tmpl'
+import prose from '../../internal/prompts/templates/finder_prose.tmpl'
+import diff from '../../internal/prompts/templates/finder_scope_diff.tmpl'
+import survey from
+    '../../internal/prompts/templates/finder_scope_survey.tmpl'
+import mixed from
+    '../../internal/prompts/templates/finder_mixed_addendum.tmpl'
+import go from '../../internal/prompts/templates/finder_go_addendum.tmpl'
+import frontend from
+    '../../internal/prompts/templates/finder_frontend_addendum.tmpl'
+import hooks from
+    '../../internal/prompts/templates/finder_react_hooks_addendum.tmpl'
+import quickAddendum from
+    '../../internal/prompts/templates/finder_quick_addendum.tmpl'
+
+export async function finderSystem (
+    mode:string,
+    scope:string,
+    quick:boolean,
+    langs:ReadonlyArray<string>,
+    overridePath:string
+):Promise<string> {
+    let base:string
+    try {
+        base = await loadOverride(overridePath, mode === 'prose' ? prose : core)
+    } catch (error) {
+        const kind = mode === 'prose' ? 'prose' : 'core'
+        const message = error instanceof Error ? error.message : String(error)
+        throw new Error(`finder ${kind} prompt: ${message}`, { cause:error })
+    }
+    if (mode !== 'prose' || scope === 'repo') {
+        base += scope === 'repo' ? survey : diff
+    }
+    if (mode === 'mixed') base += mixed
+    if (mode !== 'prose') {
+        if (langs.includes('go')) base += go
+        if (langs.includes('react') || langs.includes('frontend')) {
+            base += frontend
+        }
+        if (langs.includes('react')) base += hooks
+    }
+    if (quick) base += quickAddendum
+    return base
+}
+import { readFile } from 'node:fs/promises'
+
+async function loadOverride (path:string, fallback:string):Promise<string> {
+    if (path === '') return fallback
+    try {
+        return await readFile(path, 'utf8')
+    } catch (error) {
+        const message = error instanceof Error ? error.message : String(error)
+        throw new Error(`prompt override ${path}: ${message}`, { cause:error })
+    }
+}
