package config

import (
	"errors"
	"testing"
)

// loadStarter renders a starter config for the given models and loads it
// the way a review would.
func loadStarter(t *testing.T, finder, verifier string) Config {
	t.Helper()
	body, err := Starter(finder, verifier)
	if err != nil {
		t.Fatalf("Starter(%q, %q): %v", finder, verifier, err)
	}
	cfg, err := Load(writeConfig(t, string(body)))
	if err != nil {
		t.Fatalf("load starter for (%q, %q): %v", finder, verifier, err)
	}
	return cfg
}

// roleProfile returns the inference profile a role selects.
func roleProfile(cfg Config, role string) InferenceProfile {
	return cfg.InferenceProfiles[cfg.Roles[role].Profile]
}

type wantProvider struct {
	protocol, endpoint, keyEnv string
}

var (
	openAIProvider = wantProvider{
		"responses", "https://api.openai.com/v1", "OPENAI_API_KEY"}
	anthropicProvider = wantProvider{
		"anthropic", "https://api.anthropic.com/v1", "ANTHROPIC_API_KEY"}
	openRouterProvider = wantProvider{
		"chat", "https://openrouter.ai/api/v1", "OPENROUTER_API_KEY"}
)

func TestStarterPlacesEachRole(t *testing.T) {
	for _, tc := range []struct {
		name                       string
		finder, verifier           string
		finderAt, verifierAt       wantProvider
		finderModel, verifierModel string
		profiles                   int
	}{
		{"no models", "", "", openAIProvider, anthropicProvider,
			PlaceholderFinderModel, PlaceholderVerifierModel, 2},
		{"claude finder, codex verifier", "claude-opus-5-5", "gpt-5-codex",
			anthropicProvider, openAIProvider,
			"claude-opus-5-5", "gpt-5-codex", 2},
		{"openai finder, claude verifier", "gpt-5", "claude-sonnet-5-5",
			openAIProvider, anthropicProvider,
			"gpt-5", "claude-sonnet-5-5", 2},
		{"claude finder only", "claude-opus-5-5", "",
			anthropicProvider, openAIProvider,
			"claude-opus-5-5", PlaceholderVerifierModel, 2},
		{"openai verifier only", "", "gpt-5",
			anthropicProvider, openAIProvider,
			PlaceholderFinderModel, "gpt-5", 2},
		{"codex prefix", "codex-mini-latest", "claude-opus-5-5",
			openAIProvider, anthropicProvider,
			"codex-mini-latest", "claude-opus-5-5", 2},
		{"two anthropic models", "claude-opus-5-5", "claude-sonnet-5-5",
			anthropicProvider, anthropicProvider,
			"claude-opus-5-5", "claude-sonnet-5-5", 2},
		{"one openai model", "gpt-5", "gpt-5",
			openAIProvider, openAIProvider, "gpt-5", "gpt-5", 1},
		{"two openrouter models", "anthropic/claude-opus-5-5",
			"openai/gpt-6.1-terra", openRouterProvider, openRouterProvider,
			"anthropic/claude-opus-5-5", "openai/gpt-6.1-terra", 2},
		{"openrouter variant", "meta-llama/llama-4:free",
			"anthropic/claude-opus-5-5", openRouterProvider,
			openRouterProvider, "meta-llama/llama-4:free",
			"anthropic/claude-opus-5-5", 2},
		{"bare finder, slash verifier", "claude-opus-5-5",
			"openai/gpt-6.1-terra", anthropicProvider, openRouterProvider,
			"claude-opus-5-5", "openai/gpt-6.1-terra", 2},
		{"slash finder, bare verifier", "anthropic/claude-opus-5-5",
			"gpt-5", openRouterProvider, openAIProvider,
			"anthropic/claude-opus-5-5", "gpt-5", 2},
		{"openrouter finder only", "anthropic/claude-opus-5-5", "",
			openRouterProvider, openRouterProvider,
			"anthropic/claude-opus-5-5", PlaceholderVerifierModel, 2},
		{"openrouter verifier only", "", "openai/gpt-6.1-terra",
			openRouterProvider, openRouterProvider,
			PlaceholderFinderModel, "openai/gpt-6.1-terra", 2},
	} {
		t.Run(tc.name, func(t *testing.T) {
			cfg := loadStarter(t, tc.finder, tc.verifier)
			check := func(role string, want wantProvider, model string) {
				t.Helper()
				got := roleProfile(cfg, role)
				if got.Protocol != want.protocol ||
					got.BaseURL != want.endpoint ||
					got.APIKeyEnv != want.keyEnv || got.Model != model {
					t.Errorf("%s profile = %+v, want %+v with model %q",
						role, got, want, model)
				}
			}
			check("finder", tc.finderAt, tc.finderModel)
			check("verifier", tc.verifierAt, tc.verifierModel)
			if got := len(cfg.InferenceProfiles); got != tc.profiles {
				t.Errorf("%d profiles, want %d", got, tc.profiles)
			}
			if tc.finderModel != tc.verifierModel &&
				cfg.Roles["finder"].Profile ==
					cfg.Roles["verifier"].Profile {
				t.Errorf("different models share profile %q",
					cfg.Roles["finder"].Profile)
			}
		})
	}
}

func TestStarterNamesTwoOpenRouterProfilesByRole(t *testing.T) {
	cfg := loadStarter(t, "anthropic/claude-opus-5-5",
		"openai/gpt-6.1-terra")
	if cfg.Roles["finder"].Profile != "openrouter-finder" ||
		cfg.Roles["verifier"].Profile != "openrouter-verifier" {
		t.Fatalf("roles = %+v, want openrouter-finder and "+
			"openrouter-verifier", cfg.Roles)
	}
}

func TestStarterKeepsTheDefaultProfileNames(t *testing.T) {
	cfg := loadStarter(t, "", "")
	if cfg.Roles["finder"].Profile != "openai" ||
		cfg.Roles["verifier"].Profile != "anthropic" {
		t.Fatalf("roles = %+v, want finder on openai, verifier on anthropic",
			cfg.Roles)
	}
}

func TestStarterRejectsModelsItCannotPlace(t *testing.T) {
	for _, model := range []string{
		"gemini-2.5-pro", "some-model", "openai",
		"claude-opus-5-5[1m]", "openai:api", "Claude-Opus-5-5",
		"claude-x@2024", "gpt-5 mini",
		"Anthropic/claude-opus-5-5", "anthropic/Claude-Opus-5-5",
		"anthropic/ claude-opus-5-5",
		"anthropic/claude-opus-5-5[1m]", "openai/gpt-5:api",
		"anthropic/anthropic", "google/gemini", "openai/", "/gpt-5",
		"openai/gpt-5/mini", "meta-llama/llama-4:",
	} {
		for _, role := range []string{"finder", "verifier"} {
			finder, verifier := model, ""
			if role == "verifier" {
				finder, verifier = "", model
			}
			body, err := Starter(finder, verifier)
			var unplaceable *UnplaceableModelError
			if !errors.As(err, &unplaceable) {
				t.Errorf("Starter as %s with %q: err = %v, want "+
					"*UnplaceableModelError", role, model, err)
				continue
			}
			if unplaceable.Role != role || unplaceable.Model != model {
				t.Errorf("error = %+v, want role %q model %q",
					unplaceable, role, model)
			}
			if body != nil {
				t.Errorf("Starter as %s with %q returned a config", role,
					model)
			}
		}
	}
}

