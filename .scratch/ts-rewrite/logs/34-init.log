diff --git a/src/cli/init.ts b/src/cli/init.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d437bf6378b7560bbace5e7bd296191147144ec2
--- /dev/null
+++ b/src/cli/init.ts
@@ -0,0 +1,76 @@
+// pattern: Imperative Shell
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { starter, UnplaceableModelError } from '../config/starter.js'
+import { PROJECT_CONFIG_NAME } from '../config/load.js'
+import { gitRoot } from '../git/git.js'
+import type { CommandDef } from './command.js'
+import { UsageError } from './errors.js'
+import { ensureStateIgnored, STATE_IGNORE_ENTRY } from './ignore.js'
+
+export async function writeStarter (
+    cwd:string, finderModel:string, verifierModel:string
+):Promise<string> {
+    const file = path.resolve(cwd, PROJECT_CONFIG_NAME)
+    let body:string
+    try {
+        body = starter(finderModel, verifierModel)
+    } catch (err) {
+        if (!(err instanceof UnplaceableModelError)) throw err
+        throw new UsageError(`--${err.role}-model: ${err.message}`,
+            { cause:err })
+    }
+    let handle:fs.FileHandle
+    try {
+        handle = await fs.open(file, 'wx', 0o644)
+    } catch (err) {
+        if ((err as NodeJS.ErrnoException).code === 'EEXIST') {
+            throw new UsageError(`${file} already exists; edit it, ` +
+                'or remove it to start over', { cause:err })
+        }
+        throw new Error(`create ${file}: ${String(err)}`, { cause:err })
+    }
+    try {
+        await handle.writeFile(body)
+    } catch (err) {
+        await handle.close().catch(() => {})
+        throw new Error(`write ${file}: ${String(err)}`, { cause:err })
+    }
+    try {
+        await handle.close()
+    } catch (err) {
+        throw new Error(`close ${file}: ${String(err)}`, { cause:err })
+    }
+    return file
+}
+
+export const initCommand:CommandDef = {
+    command:'init',
+    describe:'Write a starter .roast.json in the working directory',
+    builder:y => y
+        .option('finder-model', { type:'string', default:'',
+            describe:'Finder model ID (default: a placeholder to edit)' })
+        .option('verifier-model', { type:'string', default:'',
+            describe:'Verifier model ID (default: a placeholder to edit)' })
+        .option('no-login', { type:'boolean', default:false,
+            describe:'Do not offer to log in to the config providers' }),
+    handler:async (args, ctx) => {
+        let repo:string
+        try {
+            repo = await gitRoot(ctx.cwd, {
+                env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal,
+            })
+        } catch (err) {
+            if (ctx.signal.aborted) throw err
+            throw new UsageError(String(err), { cause:err })
+        }
+        const file = await writeStarter(ctx.cwd,
+            args['finder-model'] as string, args['verifier-model'] as string)
+        ctx.stdout.write(`wrote ${file}\n`)
+        const ignored = await ensureStateIgnored(repo)
+        if (ignored.added) {
+            ctx.stdout.write(`added ${STATE_IGNORE_ENTRY} ` +
+                `to ${ignored.path}\n`)
+        }
+    },
+}
diff --git a/test/cli/init.ts b/test/cli/init.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2473eace39ae2f3b2f770e4e2fc5203247ef4091
--- /dev/null
+++ b/test/cli/init.ts
@@ -0,0 +1,65 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { tempDir, tempRepo } from '../helpers/repo.js'
+import { runRoast } from '../helpers/run.js'
+import { loadConfig } from '../../src/config/load.js'
+import { resolveRole, validateRole } from '../../src/config/role.js'
+import { thrown } from '../config/helpers.js'
+
+test('init rejects unplaceable models before writing anything', async t => {
+    for (const role of ['finder', 'verifier']) {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const result = await runRoast(['init', `--${role}-model`,
+            'unknown-model'], { cwd:repo.dir, env:repo.env })
+        t.equal(result.code, 2)
+        t.ok(result.stderr.includes(`--${role}-model`))
+        t.ok(!fs.existsSync(path.join(repo.dir, '.roast.json')))
+        t.ok(!fs.existsSync(path.join(repo.dir, '.gitignore')))
+    }
+})
+
+test('init writes usable model settings and preserves existing bytes',
+    async t => {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const args = ['init', '--no-login', '--finder-model', 'gpt-5',
+            '--verifier-model', 'claude-opus-5-5']
+        const result = await runRoast(args, { cwd:repo.dir, env:repo.env })
+        t.equal(result.code, 0)
+        const file = path.join(repo.dir, '.roast.json')
+        t.ok(result.stdout.includes(file), 'prints the absolute path')
+        t.equal(fs.statSync(file).mode & 0o777, 0o644)
+        const cfg = loadConfig(file)
+        for (const [name, model, key] of [
+            ['finder', 'gpt-5', 'openai-key'],
+            ['verifier', 'claude-opus-5-5', 'anthropic-key'],
+        ] as const) {
+            const role = resolveRole(cfg, name, {
+                OPENAI_API_KEY:'openai-key',
+                ANTHROPIC_API_KEY:'anthropic-key',
+            })
+            t.equal(role.model, model)
+            t.equal(role.apiKey, key)
+        }
+        const original = fs.readFileSync(file)
+        const again = await runRoast(args, { cwd:repo.dir, env:repo.env })
+        t.equal(again.code, 2)
+        t.deepEqual(fs.readFileSync(file), original)
+    })
+
+test('init placeholders fail role validation before any inference', async t => {
+    const repo = tempRepo()
+    t.cleanup(repo.remove)
+    const result = await runRoast(['init', '--no-login'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    t.equal(result.code, 0)
+    const cfg = loadConfig(path.join(repo.dir, '.roast.json'))
+    for (const name of ['finder', 'verifier'] as const) {
+        const err = thrown(() => validateRole(name,
+            resolveRole(cfg, name, {})))
+        t.ok(err?.message.includes('placeholder'))
+    }
+})
