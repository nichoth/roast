	"github.com/spf13/cobra"

	"github.com/bluesky-social/roast/internal/config"
	"github.com/bluesky-social/roast/internal/scope"
)

func newInitCommand(stdout, stderr io.Writer) *cobra.Command {
	var finderModel, verifierModel string
	var noLogin bool
	cmd := &cobra.Command{
		Use:   "init",
		Short: "Write a starter " + config.ProjectConfigName,
		Long: "Write a starter " + config.ProjectConfigName + " in the " +
			"working directory, then add " + stateIgnoreEntry + " to the " +
			"toplevel .gitignore. It never overwrites an existing file. " +
			"On a terminal it then offers to log in to each built-in " +
			"provider the config uses that has no credential yet.",
		Args: noArgs, SilenceUsage: true, SilenceErrors: true,
		RunE: func(cmd *cobra.Command, _ []string) error {
			repo, err := scope.GitRoot(".")
			if err != nil {
				return &usageError{msg: err.Error()}
			}
			path, err := writeStarter(finderModel, verifierModel)
			if err != nil {
				return err
			}
			fmt.Fprintf(stdout, "wrote %s\n", path)
			ignorePath, added, err := ensureStateIgnored(repo)
			if err != nil {
				return err
			}
			if added {
				fmt.Fprintf(stdout, "added %s to %s\n", stateIgnoreEntry,
					ignorePath)
			}
			if !noLogin {
				// The config is written; a failed login does not fail init.
				offerLogin(cmd.Context(), path, cmd.InOrStdin(), stdout,
					stderr)
			}
			return nil
		},
	}
	cmd.Flags().BoolVar(&noLogin, "no-login", false,
		"do not offer to log in to the config's providers")
	cmd.Flags().StringVar(&finderModel, "finder-model", "",
		"finder model ID: a bare OpenAI or Anthropic ID, or "+
			"<vendor>/<model> for OpenRouter; its ID picks the provider "+
			"(default: a placeholder to edit)")
	cmd.Flags().StringVar(&verifierModel, "verifier-model", "",
		"verifier model ID: a bare OpenAI or Anthropic ID, or "+
			"<vendor>/<model> for OpenRouter; its ID picks the provider "+
			"(default: a placeholder to edit)")
	return cmd
}

// offerLogin asks, on a terminal, whether to log in (project scope) to
// each built-in provider the config at path uses that has no resolvable
// credential. Without a terminal it prints one line suggesting
// `npx roast login`. Every failure is reported on stderr and skipped.
func offerLogin(ctx context.Context, path string, stdin io.Reader,
	stdout, stderr io.Writer) {
	cfg, err := config.Load(path)
	if err != nil {
		fmt.Fprintf(stderr, "skipping login: %v\n", err)
		return
	}
	providers, err := providersNeedingLogin(withStoredCredentials(cfg))
	if err != nil {
		fmt.Fprintf(stderr, "skipping login: %v\n", err)
		return
	}
	if len(providers) == 0 {
		return
	}
	if !interactiveTerminals(stdin, stderr) {
		fmt.Fprintln(stderr, "run `npx roast login` to store an API key "+
			"for each provider the config uses")
		return
	}
	credPath, scopeName, err := loginPath(false)
	if err != nil {
		fmt.Fprintf(stderr, "skipping login: %v\n", err)
		return
	}
	lines := bufio.NewReader(stdin)
	for _, provider := range providers {
		yes, err := promptYesDefault(stderr, lines,
			"Log in to "+provider.Name+" now?")
		if err != nil {
			fmt.Fprintf(stderr, "skipping login: %v\n", err)
			return
		}
		if !yes {
			continue
		}
		if err := loginProvider(ctx, provider, loginFlags{}, credPath,
			scopeName, stdin, lines, stdout, stderr); err != nil {
			fmt.Fprintf(stderr, "login to %s failed: %v\n",
				provider.Name, err)
		}
	}
}

// writeStarter creates the starter project config in the working directory
// and returns its path. It fails without writing when the file exists or
// config.Starter cannot place a model.
func writeStarter(finderModel, verifierModel string) (string, error) {
	cwd, err := os.Getwd()
	if err != nil {
		return "", err
	}
	path := filepath.Join(cwd, config.ProjectConfigName)
	body, err := config.Starter(finderModel, verifierModel)
	var unplaceable *config.UnplaceableModelError
	if errors.As(err, &unplaceable) {
		return path, &usageError{msg: fmt.Sprintf("--%s-model: %v",
			unplaceable.Role, err)}
	}
	if err != nil {
		return path, err
	}
	file, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o644)
	if errors.Is(err, fs.ErrExist) {
		return path, &usageError{msg: path + " already exists; " +
			"edit it, or remove it to start over"}
	}
	if err != nil {
		return path, fmt.Errorf("create %s: %w", path, err)
	}
	if _, err := file.Write(body); err != nil {
		_ = file.Close()
		return path, fmt.Errorf("write %s: %w", path, err)
	}
	if err := file.Close(); err != nil {
		return path, fmt.Errorf("close %s: %w", path, err)
	}
	return path, nil
}
