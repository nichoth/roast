+// Shared defaults for starter rendering and CLI settings.
+export const DEFAULT_CONFIDENCE_FLOOR = 0.6
+export const DEFAULT_QUICK_CONFIDENCE_FLOOR = 0.8
+export const DEFAULT_SNAPSHOT = true
+export const DEFAULT_GATE_OFFER = true
+export const GATE_DEFAULT_TIMEOUT = 180
+export const GATE_DEFAULT_SEVERITY = 'HIGH'
+
+// Durations use config spelling; CLI consumers parse them as Go durations.
+export const DEFAULT_LIMITS = Object.freeze({
+    deadline:'10m',
+    request_timeout:'10m',
+    max_total_tokens:3_000_000,
+    max_diff_bytes:1_000_000,
+    max_prompt_bytes:8_000_000,
+    max_file_ctx_bytes:400_000,
+    max_attempts:4,
+    max_verified:25,
+})
diff --git a/test/cli/init.ts b/test/cli/init.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1e774c6a10c477b709179ef67ec010dbfe2cb04a
--- /dev/null
+++ b/test/cli/init.ts
@@ -0,0 +1,209 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { tempDir, tempRepo } from '../helpers/repo.js'
+import { runRoast } from '../helpers/run.js'
+import { loadConfig } from '../../src/config/load.js'
+import { resolveRole, validateRole } from '../../src/config/role.js'
+import { thrown } from '../config/helpers.js'
+import { providerServer } from '../helpers/provider-server.js'
+import { captureBrowser, simulateTerminals } from '../helpers/terminal.js'
+import type { CleanupTest } from '../helpers/test.js'
+import { loadCredentials } from '../../src/credentials/credentials.js'
+
+async function initLoginRepo (t:CleanupTest, terminals:boolean) {
+    const repo = tempRepo()
+    t.cleanup(repo.remove)
+    const server = await providerServer()
+    t.cleanup(() => server.close())
+    simulateTerminals(t, terminals)
+    const opened = captureBrowser(t)
+    const project = path.join(repo.dir, '.git/roast/credentials.json')
+    const user = path.join(repo.env.XDG_CONFIG_HOME!, 'roast/credentials.json')
+    const run = (stdin:string, args:Array<string> = [],
+        env = repo.env) => runRoast(['init', ...args], {
+        cwd:repo.dir, env, stdin, redirectTo:server.url,
+    })
+    return { repo, server, opened, project, user, run }
+}
+
+test('init rejects unplaceable models before writing anything', async t => {
+    for (const role of ['finder', 'verifier']) {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const result = await runRoast(['init', `--${role}-model`,
+            'unknown-model'], { cwd:repo.dir, env:repo.env })
+        t.equal(result.code, 2)
+        t.ok(result.stderr.includes(`--${role}-model`))
+        t.ok(!fs.existsSync(path.join(repo.dir, '.roast.json')))
+        t.ok(!fs.existsSync(path.join(repo.dir, '.gitignore')))
+    }
+})
+
+test('init writes usable model settings and preserves existing bytes',
+    async t => {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const args = ['init', '--no-login', '--finder-model', 'gpt-5',
+            '--verifier-model', 'claude-opus-5-5']
+        const result = await runRoast(args, { cwd:repo.dir, env:repo.env })
+        t.equal(result.code, 0)
+        const file = path.join(repo.dir, '.roast.json')
+        t.ok(result.stdout.includes(file), 'prints the absolute path')
+        t.equal(fs.statSync(file).mode & 0o777, 0o644)
+        const cfg = loadConfig(file)
+        for (const [name, model, key] of [
+            ['finder', 'gpt-5', 'openai-key'],
+            ['verifier', 'claude-opus-5-5', 'anthropic-key'],
+        ] as const) {
+            const role = resolveRole(cfg, name, {
+                OPENAI_API_KEY:'openai-key',
+                ANTHROPIC_API_KEY:'anthropic-key',
+            })
+            t.equal(role.model, model)
+            t.equal(role.apiKey, key)
+        }
+        const original = fs.readFileSync(file)
+        const again = await runRoast(args, { cwd:repo.dir, env:repo.env })
+        t.equal(again.code, 2)
+        t.deepEqual(fs.readFileSync(file), original)
+    })
+
+test('init placeholders fail role validation', async t => {
+    const repo = tempRepo()
+    t.cleanup(repo.remove)
+    const result = await runRoast(['init', '--no-login'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    t.equal(result.code, 0)
+    const cfg = loadConfig(path.join(repo.dir, '.roast.json'))
+    for (const name of ['finder', 'verifier'] as const) {
+        const err = thrown(() => validateRole(name,
+            resolveRole(cfg, name, {})))
+        t.ok(err?.message.includes('placeholder'))
+    }
+})
+
+test('init writes in cwd and ignores state at the repository toplevel',
+    async t => {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const cwd = path.join(repo.dir, 'nested')
+        fs.mkdirSync(cwd)
+        fs.writeFileSync(path.join(repo.dir, '.gitignore'), 'existing')
+        const result = await runRoast(['init', '--no-login'], {
+            cwd, env:repo.env,
+        })
+        t.equal(result.code, 0)
+        t.ok(fs.existsSync(path.join(cwd, '.roast.json')))
+        t.ok(!fs.existsSync(path.join(repo.dir, '.roast.json')))
+        t.equal(fs.readFileSync(path.join(repo.dir, '.gitignore'), 'utf8'),
+            'existing\n/.roast/\n')
+        t.ok(!fs.existsSync(path.join(cwd, '.gitignore')))
+    })
+
+test('init outside Git writes nothing', async t => {
+    const dir = tempDir()
+    t.cleanup(dir.remove)
+    const result = await runRoast(['init'], { cwd:dir.dir, env:dir.env })
+    t.equal(result.code, 2)
+    t.ok(!fs.existsSync(path.join(dir.dir, '.roast.json')))
+    t.ok(!fs.existsSync(path.join(dir.dir, '.gitignore')))
+})
+
+test('init schema reference points into the installed package', async t => {
+    const repo = tempRepo()
+    t.cleanup(repo.remove)
+    const result = await runRoast(['init', '--no-login'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    t.equal(result.code, 0)
+    const cfg = loadConfig(path.join(repo.dir, '.roast.json'))
+    t.ok(/^\.\/?node_modules\/@substrate-system\/roast\/[^/]+\.json$/
+        .test(cfg.$schema ?? ''))
+})
+
+test('init offers each missing provider with shared prompt and key input',
+    async t => {
+        const r = await initLoginRepo(t, true)
+        const result = await r.run('y\nsk-anthropic\ny\nsk-openai\n', [
+            '--finder-model', 'claude-opus-5-5',
+            '--verifier-model', 'gpt-5',
+        ])
+        t.equal(result.code, 0)
+        const stored = await loadCredentials(r.project)
+        t.equal(stored.get('anthropic')?.key, 'sk-anthropic')
+        t.equal(stored.get('openai')?.key, 'sk-openai')
+        t.ok(!fs.existsSync(r.user), 'no user-scope write')
+        t.deepEqual(r.server.credentials,
+            ['sk-anthropic', 'Bearer sk-openai'])
+        t.equal(r.opened.length, 2)
+    })
+
+test('init declining both providers has no login side effects', async t => {
+    const r = await initLoginRepo(t, true)
+    const result = await r.run('n\nn\n')
+    t.equal(result.code, 0)
+    t.ok(!fs.existsSync(r.project))
+    t.ok(!fs.existsSync(r.user))
+    t.equal(r.server.requests.length, 0)
+    t.deepEqual(r.opened, [])
+})
+
+test('init no-login and nonterminal runs never offer login', async t => {
+    for (const terminals of [false, true]) {
+        const r = await initLoginRepo(t, terminals)
+        const result = await r.run('y\nunused-key\ny\nunused-key\n',
+            terminals ? ['--no-login'] : [])
+        t.equal(result.code, 0)
+        t.ok(!result.stderr.includes('[Y/n]'), 'no login offer')
+        t.ok(!fs.existsSync(r.project))
+        t.ok(!fs.existsSync(r.user))
+        t.equal(r.server.requests.length, 0)
+        t.deepEqual(r.opened, [])
+    }
+})
+
+test('init succeeds after three rejected keys and continues offering',
+    async t => {
+        const r = await initLoginRepo(t, true)
+        r.server.hooks.answerModels = () => 401
+        const result = await r.run('y\nwrong1\nwrong2\nwrong3\nn\n')
+        t.equal(result.code, 0)
+        t.ok(fs.existsSync(path.join(r.repo.dir, '.roast.json')))
+        t.ok(!fs.existsSync(r.project))
+        t.ok(!fs.existsSync(r.user))
+        t.deepEqual(r.server.credentials,
+            ['Bearer wrong1', 'Bearer wrong2', 'Bearer wrong3'])
+        t.equal(result.stderr.split('[Y/n]').length - 1, 2,
+            'failure still offers the next provider')
+    })
+
+test('init can store the second provider after the first login fails',
+    async t => {
+        const r = await initLoginRepo(t, true)
+        r.server.hooks.answerModels = key =>
+            key.startsWith('Bearer ') ? 403 : 200
+        const result = await r.run('y\nwrong1\nwrong2\nwrong3\n' +
+            'y\nsk-second\n')
+        t.equal(result.code, 0)
+        const stored = await loadCredentials(r.project)
+        t.ok(!stored.has('openai'))
+        t.equal(stored.get('anthropic')?.key, 'sk-second')
+        t.equal(r.server.requests.length, 4)
+        t.ok(!fs.existsSync(r.user))
+    })
+
+test('init skips offers when roles already have credentials', async t => {
+    const r = await initLoginRepo(t, true)
+    const result = await r.run('y\nunused\n', [], {
+        ...r.repo.env, OPENAI_API_KEY:'available-openai',
+        ANTHROPIC_API_KEY:'available-anthropic',
+    })
+    t.equal(result.code, 0)
+    t.ok(!result.stderr.includes('[Y/n]'))
+    t.deepEqual(r.opened, [])
+    t.equal(r.server.requests.length, 0)
+    t.ok(!fs.existsSync(r.project))
+    t.ok(!fs.existsSync(r.user))
+})
diff --git a/test/config/starter.ts b/test/config/starter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..802a3b387959dec702b0bc458ca008a00f8b4a44
--- /dev/null
+++ b/test/config/starter.ts
@@ -0,0 +1,120 @@
+import { test } from '../helpers/test.js'
+import { decode, normalize } from '../../src/config/load.js'
+import {
+    starter,
+    UnplaceableModelError,
+} from '../../src/config/starter.js'
+import { thrown } from './helpers.js'
+import { DEFAULT_LIMITS } from '../../src/config/defaults.js'
+import { gateOffers, snapshotEnabled } from '../../src/config/load.js'
+import {
+    GATE_DEFAULT_TIMEOUT,
+    GATE_DEFAULT_SEVERITY,
+} from '../../src/cli/gate.js'
+
+test('starter places models and separates different models', t => {
+    const cases:Array<[string, string, string, string, number]> = [
+        ['', '', 'openai', 'anthropic', 2],
+        ['claude-opus-5-5', 'gpt-5', 'anthropic', 'openai', 2],
+        ['gpt-5', 'claude-sonnet-5-5', 'openai', 'anthropic', 2],
+        ['claude-opus-5-5', '', 'anthropic', 'openai', 2],
+        ['', 'gpt-5', 'anthropic', 'openai', 2],
+        ['codex-mini-latest', '', 'openai', 'anthropic', 2],
+        ['claude-x', 'claude-y', 'anthropic', 'anthropic', 2],
+        ['gpt-5', 'gpt-5', 'openai', 'openai', 1],
+        ['anthropic/claude-x', 'openai/gpt-5',
+            'openrouter', 'openrouter', 2],
+        ['meta-llama/llama-4:free', 'anthropic/claude-x',
+            'openrouter', 'openrouter', 2],
+        ['claude-x', 'openai/gpt-5', 'anthropic', 'openrouter', 2],
+        ['anthropic/claude-x', 'gpt-5', 'openrouter', 'openai', 2],
+        ['anthropic/claude-x', '', 'openrouter', 'openrouter', 2],
+        ['', 'openai/gpt-5', 'openrouter', 'openrouter', 2],
+        [' \tgpt-5\u0085', '', 'openai', 'anthropic', 2],
+    ]
+    const providers = {
+        openai:['responses', 'https://api.openai.com/v1', 'OPENAI_API_KEY'],
+        anthropic:['anthropic', 'https://api.anthropic.com/v1',
+            'ANTHROPIC_API_KEY'],
+        openrouter:['chat', 'https://openrouter.ai/api/v1',
+            'OPENROUTER_API_KEY'],
+    }
+    for (const [finder, verifier, fAt, vAt, count] of cases) {
+        const cfg = normalize(decode(starter(finder, verifier)), '')
+        t.equal(Object.keys(cfg.inference_profiles).length, count)
+        for (const [role, at, model] of [
+            ['finder', fAt, finder], ['verifier', vAt, verifier],
+        ] as const) {
+            const name = cfg.roles[role]!.profile
+            const p = cfg.inference_profiles[name!]!
+            t.deepEqual([p.protocol, p.endpoint, p.api_key_env],
+                providers[at as keyof typeof providers])
+            t.equal(p.model, model.trim().replace(/\u0085$/, '') ||
+                `<${role}-model>`)
+        }
+        if (finder !== verifier) {
+            t.ok(cfg.roles.finder!.profile !== cfg.roles.verifier!.profile,
+                'different models have different profiles')
+        }
+    }
+})
+
+test('starter gives default and OpenRouter profiles stable names', t => {
+    for (const [f, v, names] of [
+        ['', '', ['openai', 'anthropic']],
+        ['anthropic/claude-x', 'openai/gpt-5',
+            ['openrouter-finder', 'openrouter-verifier']],
+    ] as const) {
+        const cfg = normalize(decode(starter(f, v)), '')
+        t.deepEqual([cfg.roles.finder!.profile, cfg.roles.verifier!.profile],
+            [...names])
+    }
+})
+
+test('starter rejects unplaceable IDs with role and trimmed model', t => {
+    for (const model of [
+        'gemini-2.5-pro', 'some-model', 'openai',
+        'claude-opus-5-5[1m]', 'openai:api', 'Claude-Opus-5-5',
+        'claude-x@2024', 'gpt-5 mini', 'Anthropic/claude-opus-5-5',
+        'anthropic/Claude-Opus-5-5', 'anthropic/ claude-opus-5-5',
+        'anthropic/claude-opus-5-5[1m]', 'openai/gpt-5:api',
+        'anthropic/anthropic', 'google/gemini', 'openai/', '/gpt-5',
+        'openai/gpt-5/mini', 'meta-llama/llama-4:',
+    ]) {
+        for (const role of ['finder', 'verifier']) {
+            const err = thrown(() => starter(
+                role === 'finder' ? ` ${model} ` : '',
+                role === 'verifier' ? ` ${model} ` : ''
+            ))
+            t.ok(err instanceof UnplaceableModelError)
+            if (!(err instanceof UnplaceableModelError)) continue
+            t.equal(err.role, role)
+            t.equal(err.model, model)
+        }
+    }
+    const first = thrown(() => starter('invalid-finder', 'invalid-verifier'))
+    t.equal((first as UnplaceableModelError).role, 'finder')
+})
+
+test('starter comments agree with runtime defaults', t => {
+    const body = starter('', '')
+    const comments = body.split('\n').filter(line =>
+        line.startsWith('  // ')).map(line => line.slice(5)).join('\n')
+    // Only object-property comments are executable JSONC when uncommented.
+    const blocks = comments.slice(comments.indexOf('"review":'))
+    const raw = decode('{"version":1,' + blocks + '}')
+    const cfg = normalize(decode(body), '')
+    t.deepEqual(raw.limits, {
+        deadline:'10m', request_timeout:'10m', max_total_tokens:3000000,
+        max_diff_bytes:1000000, max_prompt_bytes:8000000,
+        max_file_ctx_bytes:400000, max_attempts:4, max_verified:25,
+    })
+    t.deepEqual(raw.limits, DEFAULT_LIMITS)
+    t.equal(raw.review!.confidence_floor, cfg.review.confidence_floor)
+    t.equal(raw.review!.quick_confidence_floor,
+        cfg.review.quick_confidence_floor)
+    t.equal(raw.review!.snapshot, snapshotEnabled(cfg))
+    t.equal(raw.gate!.offer, gateOffers(cfg))
+    t.equal(raw.gate!.timeout_seconds, GATE_DEFAULT_TIMEOUT)
+    t.equal(raw.gate!.severity, GATE_DEFAULT_SEVERITY)
+})
