    saveCredential,
    userCredentialsPath,
    type CredentialScope,
} from '../credentials/credentials.js'
import { goQuote } from '../gocompat/strings.js'
import { abortable } from '../llm/capture.js'
import { AuthError, EndpointError } from '../llm/errors.js'
import type { CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'
import { loadProjectConfig, NO_PROJECT_CONFIG } from './config.js'
import { interactiveTerminals, openBrowser, readSecret } from './terminal.js'

export type LoginContext = Pick<RunContext,
    'cwd'|'env'|'signal'|'fetch'|'stdin'|'stdout'|'stderr'|'lines'>

export interface LoginFlags {
    global:boolean;
    noBrowser:boolean;
}

export interface LoginTarget {
    path:string;
    scope:CredentialScope;
}

export function providerNames ():string {
    return builtinProviders().map(p => p.name).join(', ')
}

export async function loginPath (
    global:boolean,
    ctx:LoginContext
):Promise<LoginTarget> {
    if (global) {
        return { path:userCredentialsPath(ctx.env), scope:'user' }
    }
    try {
        const path = await projectCredentialsPath(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
        return { path, scope:'project' }
    } catch (err) {
        if (ctx.signal.aborted) throw err
        throw new UsageError('not in a Git repository; use --global ' +
            'to store the key for the user', { cause:err })
    }
}

export function keyCheckPath (provider:BuiltinProvider):string {
    return provider.name === 'openrouter' ? '/key' : '/models'
}

class KeyRejected extends Error {}

// Discard at most 32 KiB, then cancel even if the provider keeps sending.
async function drainValidationBody (
    response:Response,
    signal:AbortSignal
):Promise<void> {
    if (!response.body) return
    const reader = response.body.getReader()
    let size = 0
    try {
        while (size < 32 * 1024) {
            const chunk = await abortable(reader.read(), signal)
            if (chunk.done) return
            size += chunk.value.byteLength
        }
    } finally {
        await reader.cancel().catch(() => {})
        reader.releaseLock()
    }
}

export async function validateKey (
    provider:BuiltinProvider,
    key:string,
    ctx:LoginContext
):Promise<void> {
    const url = provider.endpoint.replace(/\/+$/, '') +
        keyCheckPath(provider)
    const signal = AbortSignal.any([
        ctx.signal,
        AbortSignal.timeout(30_000),
    ])
    const prefix = 'llm: inference endpoint failure: check key at ' + url
    let response:Response
    try {
        response = await ctx.fetch(url, {
            method:'GET',
            redirect:'manual',
            signal,
            headers:provider.protocols[0] === 'anthropic' ? {
                'x-api-key':key,
                'anthropic-version':'2023-06-01',
            } : { Authorization:`Bearer ${key}` },
        })
        await drainValidationBody(response, signal)
    } catch (err) {
        const message = err instanceof Error ? err.message : String(err)
        throw new EndpointError(`${prefix}: ${message}`, { cause:err })
    }
    if (response.status >= 300 && response.status < 400) {
        throw new EndpointError(`${prefix}: redirect refused`)
    }
    if (response.status === 401 || response.status === 403) {
        throw new KeyRejected()
    }
    if (!response.ok) {
        throw new EndpointError(`${prefix}: HTTP ${response.status} ` +
            response.statusText)
    }
}

async function pasteLogin (
    provider:BuiltinProvider,
    flags:LoginFlags,
    ctx:LoginContext
):Promise<string> {
    ctx.stderr.write(`Create a ${provider.name} API key at:\n` +
        `  ${provider.keyPage}\n`)
    if (!flags.noBrowser) {
        const err = await openBrowser(provider.keyPage, ctx.signal)
        if (err) {
            ctx.stderr.write(`could not open a browser (${err.message}); ` +
                'open the URL above\n')
        }
    }
    for (let attempt = 0; attempt < 3; attempt++) {
        let key:string
        try {
            key = await readSecret(ctx.stderr, ctx.stdin, ctx.lines,
                'Paste the key: ')
        } catch (err) {
            const message = err instanceof Error ? err.message : String(err)
            throw new Error(`read key: ${message}`, { cause:err })
        }
        if (key === '') {
            ctx.stderr.write('no key entered\n')
            continue
        }
        try {
            await validateKey(provider, key, ctx)
            return key
        } catch (err) {
            if (!(err instanceof KeyRejected)) throw err
            ctx.stderr.write(`${provider.name} rejected the key; ` +
                'try again\n')
        }
    }
    throw new AuthError('llm: authentication failed: no accepted ' +
        `${provider.name} key after 3 tries; nothing stored`)
}

export async function runLogin (
    name:string,
    flags:LoginFlags,
    ctx:LoginContext
):Promise<void> {
    const provider = lookupProvider(name)
    if (!provider) {
        throw new UsageError(`unknown provider ${goQuote(name)}; ` +
            `built-in providers: ${providerNames()}`)
    }
    if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {
        throw new UsageError('login needs an interactive terminal; ' +
            `set ${provider.keyEnv} instead`)
    }
    const target = await loginPath(flags.global, ctx)
    await loginProvider(provider, flags, target, ctx)
}

export async function loginProvider (
    provider:BuiltinProvider,
    flags:LoginFlags,
    target:LoginTarget,
    ctx:LoginContext
):Promise<void> {
    const key = provider.login === 'browser' ?
        await browserLogin(provider, flags, ctx) :
        await pasteLogin(provider, flags, ctx)
    if (provider.login === 'browser') {
        try {
            await validateKey(provider, key, ctx)
        } catch (err) {
            if (!(err instanceof KeyRejected)) throw err
            throw new AuthError('llm: authentication failed: openrouter ' +
                'rejected the key it minted; nothing stored')
        }
    }
    await saveCredential(target.path, provider.name, key, new Date())
    ctx.stdout.write(`stored ${provider.name} credential ` +
        `(${target.scope} scope)\n`)
}

export function providersNeedingLogin (
    cfg:ProjectConfig,
    env:Env
):Array<BuiltinProvider> {
    const providers:Array<BuiltinProvider> = []
    for (const name of Object.keys(cfg.roles).sort()) {
        let role
        try {
            role = resolveRole(cfg, name as RoleName, env)
        } catch (err) {
            const message = err instanceof Error ? err.message : String(err)
            throw new UsageError(message, { cause:err })
        }
        if (role.apiKey !== '') continue
        const provider = providerAt(role.baseURL, role.protocol)
        if (provider && !providers.some(p => p.name === provider.name)) {
            providers.push(provider)
        }
    }
    return providers
}

export async function runLoginMissing (
    flags:LoginFlags,
    ctx:LoginContext
):Promise<void> {
    let cfg:ProjectConfig
    try {
        cfg = await loadProjectConfig('', ctx)
    } catch (err) {
        if (err instanceof UsageError && err.message === NO_PROJECT_CONFIG) {
            throw new UsageError('no project config (.roast.json) found; ' +
                'name a provider (`npx roast login <provider>`, one of ' +
                `${providerNames()}) or run \`npx roast init\``)
        }
        throw err
    }
    const providers = providersNeedingLogin(cfg, ctx.env)
    if (providers.length === 0) {
        ctx.stderr.write('every built-in provider the roles use already ' +
            'has a credential\n')
        return
    }
    if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {
        throw new UsageError('login needs an interactive terminal')
    }
    const target = await loginPath(flags.global, ctx)
    for (const provider of providers) {
        await loginProvider(provider, flags, target, ctx)
    }
}

export const loginCommand:CommandDef = {
    command:'login [provider]',
    describe:'Store an API key for a built-in provider',
    builder:y => y
        .positional('provider', { type:'string' })
        .option('global', {
            type:'boolean',
            default:false,
            describe:'Store the credential for the user',
        })
        .option('no-browser', {
            type:'boolean',
            default:false,
            describe:'Print the key page URL without opening a browser',
        }),
    handler:(args, ctx) => {
        const flags = {
            global:args.global === true,
            noBrowser:args['no-browser'] === true,
        }
        return args.provider === undefined ? runLoginMissing(flags, ctx) :
            runLogin(String(args.provider), flags, ctx)
    },
}
// `roast ignore` (spec 12, 2.13): adds the run-record state directory to
// the toplevel .gitignore. `init` reuses ensureStateIgnored.
import fs from 'node:fs/promises'
import path from 'node:path'
import { gitRoot } from '../git/git.js'
import { goTrimSpace } from '../gocompat/strings.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'

// Roast's project-local state directory at the Git toplevel.
const STATE_DIR = '.roast'

export const STATE_IGNORE_ENTRY = `/${STATE_DIR}/`

// Lines that already ignore the toplevel state directory.
const EQUIVALENT = new Set([
    `/${STATE_DIR}/`, `/${STATE_DIR}`, `${STATE_DIR}/`, STATE_DIR,
])

function fail (text:string, err:unknown):Error {
    const msg = err instanceof Error ? err.message : String(err)
    return new Error(`${text}: ${msg}`, { cause:err })
}

// Appends STATE_IGNORE_ENTRY to <repo>/.gitignore unless an equivalent
// line is present, creating the file and terminating an unterminated last
// line first. Reports the path and whether the file changed.
export async function ensureStateIgnored (
    repo:string
):Promise<{ path:string, added:boolean }> {
    const file = path.join(repo, '.gitignore')
    let data = Buffer.alloc(0)
    try {
        data = await fs.readFile(file)
    } catch (err) {
        if ((err as NodeJS.ErrnoException).code !== 'ENOENT') {
            throw fail(`read ${file}`, err)
        }
    }
    const lines = data.toString('utf8').split('\n')
    if (lines.some(line => EQUIVALENT.has(goTrimSpace(line)))) {
        return { path:file, added:false }
    }
    let addition = `${STATE_IGNORE_ENTRY}\n`
    if (data.length > 0 && data[data.length - 1] !== 0x0a) {
        addition = '\n' + addition
    }
    let handle:fs.FileHandle
    try {
        handle = await fs.open(file, 'a', 0o644)
    } catch (err) {
        throw fail(`open ${file}`, err)
    }
    try {
        await handle.write(addition)
    } catch (err) {
        await handle.close().catch(() => {})
        throw fail(`append ${file}`, err)
    }
    try {
        await handle.close()
    } catch (err) {
        throw fail(`close ${file}`, err)
    }
    return { path:file, added:true }
}

async function ignoreHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    let repo:string
    try {
        repo = await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        const msg = err instanceof Error ? err.message : String(err)
        throw new UsageError(msg, { cause:err })
    }
    const { path:file, added } = await ensureStateIgnored(repo)
    ctx.stdout.write(added ?
        `added ${STATE_IGNORE_ENTRY} to ${file}\n` :
        `${file} already ignores ${STATE_IGNORE_ENTRY}\n`)
}

export const ignoreCommand:CommandDef = {
    command:'ignore',
    describe:`Add ${STATE_IGNORE_ENTRY} to the toplevel .gitignore`,
    handler:ignoreHandler,
}
// Provider-neutral model families (spec 02, 2.10).
import { goTrimSpace } from '../gocompat/strings.js'

const VENDOR_PREFIXES = [
    'anthropic', 'openai', 'google', 'gemini', 'mistral', 'xai', 'cohere',
    'deepseek',
]

// [family, exact names, ID prefixes], first match wins.
const RULES:[string, string[], string[]][] = [
    ['anthropic', ['anthropic'], ['claude-']],
    ['openai', ['openai'], ['gpt-', 'codex-', 'chatgpt-', 'o1', 'o3', 'o4']],
    ['google', ['google', 'gemini'], ['gemini-']],
    ['mistral', ['mistral'], ['mistral-', 'codestral-']],
    ['xai', ['xai'], ['grok-']],
    ['cohere', ['cohere'], ['command-']],
    ['deepseek', ['deepseek'], ['deepseek-']],
]

export function canonicalFamily (family:string):string {
    return family === 'gemini' ? 'google' : family
}

function trimSuffix (s:string, suffix:string):string {
    return s.endsWith(suffix) ? s.slice(0, s.length - suffix.length) : s
}

// The model's family from a bare family name, a model ID, or a
// `<vendor>/<model>` ID, or '' when it cannot be determined.
export function inferFamily (model:string):string {
    let m = goTrimSpace(model).toLowerCase()
    if (m === '') return ''
    const slash = m.indexOf('/')
    if (slash >= 0) {
        const vendor = m.slice(0, slash)
        if (VENDOR_PREFIXES.includes(vendor)) return canonicalFamily(vendor)
        m = m.slice(slash + 1)
    }
    m = trimSuffix(trimSuffix(m, ':api'), '[1m]')
    for (const [family, names, prefixes] of RULES) {
        if (names.includes(m) || prefixes.some(p => m.startsWith(p))) {
            return family
        }
    }
    return ''
}
// The built-in provider registry (spec 02, 2.7): the one place that says
// which endpoint, protocols, standard key variable, key page, and login
// method each provider has. Trust standardness, ambient credentials, the
// `init` starter, and login all consult it.
import { goTrimSpace } from '../gocompat/strings.js'

export const DEFAULT_OPENAI_BASE_URL = 'https://api.openai.com/v1'
export const DEFAULT_ANTHROPIC_BASE_URL = 'https://api.anthropic.com/v1'
export const OPENROUTER_BASE_URL = 'https://openrouter.ai/api/v1'

export type Protocol = 'chat'|'responses'|'anthropic'
export type LoginMethod = 'paste'|'browser'

export interface BuiltinProvider {
    readonly name:string;
    readonly endpoint:string;
    // The first is the one starter profiles use.
    readonly protocols:readonly Protocol[];
    readonly keyEnv:string;
    readonly keyPage:string;
    readonly login:LoginMethod;
}

// No two entries share an (endpoint, protocol) pair, so providerAt finds
// at most one. Order matters for withheldKey and listings.
const REGISTRY:readonly BuiltinProvider[] = Object.freeze([
    {
        name:'openai',
        endpoint:DEFAULT_OPENAI_BASE_URL,
        protocols:['responses', 'chat'],
        keyEnv:'OPENAI_API_KEY',
        keyPage:'https://platform.openai.com/api-keys',
        login:'paste',
    },
    {
        name:'anthropic',
        endpoint:DEFAULT_ANTHROPIC_BASE_URL,
        protocols:['anthropic'],
        keyEnv:'ANTHROPIC_API_KEY',
        keyPage:'https://console.anthropic.com/settings/keys',
        login:'paste',
    },
    {
        name:'openrouter',
        endpoint:OPENROUTER_BASE_URL,
        protocols:['chat', 'responses'],
        keyEnv:'OPENROUTER_API_KEY',
        keyPage:'https://openrouter.ai/settings/keys',
        login:'browser',
    },
].map(p => Object.freeze({
    ...p,
    protocols:Object.freeze([...p.protocols]) as readonly Protocol[],
} as BuiltinProvider)))

function copy (p:BuiltinProvider):BuiltinProvider {
    return { ...p, protocols:[...p.protocols] }
}

// Copies of the registry, in registry order.
export function builtinProviders ():BuiltinProvider[] {
    return REGISTRY.map(copy)
}

// The provider with exactly this name (case-sensitive).
export function lookupProvider (name:string):BuiltinProvider|undefined {
    const p = REGISTRY.find(p => p.name === name)
    return p && copy(p)
}

// The provider that accepts `protocol` at `endpoint`.
export function providerAt (
    endpoint:string,
    protocol:string
):BuiltinProvider|undefined {
    const p = REGISTRY.find(p =>
        (p.protocols as readonly string[]).includes(protocol) &&
        sameEndpoint(p.endpoint, endpoint))
    return p && copy(p)
}

// The implicit endpoint of a profile that sets none. OpenRouter is never
// one.
export function defaultBaseURL (protocol:string):string {
    return protocol === 'anthropic' ?
        DEFAULT_ANTHROPIC_BASE_URL :
        DEFAULT_OPENAI_BASE_URL
}

// Parses an endpoint with WHATWG URL, or null when it does not parse or
// has an empty host. WHATWG repairs `https:///v1` and `https:v1` into a
// host; Go sees an empty one, so text after the scheme must start with
// `//` and a non-empty authority.
export function parseEndpoint (s:string):URL|null {
    const colon = s.indexOf(':')
    if (colon < 0) return null
    const rest = s.slice(colon + 1)
    if (!rest.startsWith('//')) return null
    const end = rest.slice(2).search(/[/?#]/)
    const authority = end < 0 ? rest.slice(2) : rest.slice(2, 2 + end)
    // Userinfo alone (`https://u@/v1`) leaves no host either.
    if (authority.slice(authority.lastIndexOf('@') + 1) === '') return null
    let u:URL
    try {
        u = new URL(s)
    } catch {
        return null
    }
    return u.host === '' ? null : u
}

function stripTrailingSlashes (p:string):string {
    let end = p.length
    while (end > 0 && p[end - 1] === '/') end--
    return p.slice(0, end)
}

// Endpoints compare by scheme and host (case-insensitive), path without
// trailing slashes, raw query, and userinfo. Unparseable values never
// match.
export function sameEndpoint (a:string, b:string):boolean {
    const left = parseEndpoint(goTrimSpace(a))
    const right = parseEndpoint(goTrimSpace(b))
    if (!left || !right) return false
    return left.protocol === right.protocol &&
        left.host === right.host &&
        stripTrailingSlashes(left.pathname) ===
            stripTrailingSlashes(right.pathname) &&
        left.search === right.search &&
        left.username === right.username &&
        left.password === right.password
}
