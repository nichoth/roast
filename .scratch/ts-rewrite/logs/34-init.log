// `roast review`, also the default command. Ticket 20 adds the review
// flags and the pipeline; until then only the bare-`roast` path that
// needs no review is implemented.
import { gitRoot } from '../git/git.js'
import type { CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'

async function insideRepository (ctx:RunContext):Promise<boolean> {
    try {
        await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
        return true
    } catch (err) {
        if (ctx.signal.aborted) throw err
        return false
    }
}

async function reviewHandler (ctx:RunContext):Promise<void> {
    const explicit = ctx.path.length > 0
    if (!(await insideRepository(ctx))) {
        if (explicit) {
            throw new UsageError('not inside a git repository')
        }
        ctx.stderr.write('roast: not in a Git repository; cd into one to ' +
            'review, or try `roast doctor` / `roast --help`\n')
        ctx.stdout.write(await ctx.rootHelp())
        return
    }
    throw new UsageError(
        'review is not implemented yet in the TypeScript CLI')
}

export const reviewCommand:CommandDef = {
    command:['review', '$0'],
    describe:'Review the current changes (the default command)',
    handler:(_args, ctx) => reviewHandler(ctx),
}
