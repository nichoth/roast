{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAvgQNY6J2YzJ97J4Eq1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PoAHoyuGQRfATnUqhTrkxQ","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-02-third-party-notices-and-package-check/test/tooling/licenses.ts","content":"import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'\nimport { readFileSync } from 'node:fs'\nimport { tmpdir } from 'node:os'\nimport { join } from 'node:path'\nimport type { Metafile } from 'esbuild'\nimport { test } from '@substrate-system/tapzero'\nimport {\n    bundledPackageDirs,\n    readBundledPackages,\n    renderNotices,\n} from '../../scripts/licenses.ts'\n\nconst OUTFILE = 'dist/cli.js'\n\ninterface FixturePackage {\n    name:string;\n    version:string;\n    license?:unknown;\n    repository?:unknown;\n    licenseFiles?:Record<string, string>;\n}\n\n// Writes one package (manifest plus license files) into `dir`.\nasync function writePackage (dir:string, pkg:FixturePackage):Promise<void> {\n    await mkdir(join(dir, 'lib'), { recursive:true })\n    const manifest:Record<string, unknown> = {\n        name:pkg.name,\n        version:pkg.version,\n    }\n    if (pkg.license !== undefined) manifest.license = pkg.license\n    if (pkg.repository !== undefined) manifest.repository = pkg.repository\n    await writeFile(join(dir, 'package.json'), JSON.stringify(manifest))\n    await writeFile(join(dir, 'lib', 'index.js'), 'export {}\\n')\n    const files = pkg.licenseFiles ?? { LICENSE:`${pkg.name} license\\n` }\n    for (const [file, text] of Object.entries(files)) {\n        await writeFile(join(dir, file), text)\n    }\n}\n\n// A metafile whose dist/cli.js output has the given inputs.\nfunction metafile (inputs:Record<string, number>):Metafile {\n    const outInputs:Metafile['outputs'][string]['inputs'] = {}\n    for (const [path, bytes] of Object.entries(inputs)) {\n        outInputs[path] = { bytesInOutput:bytes }\n    }\n    return {\n        inputs:{},\n        outputs:{\n            [OUTFILE]:{\n                bytes:1,\n                inputs:outInputs,\n                imports:[],\n                exports:[],\n                entryPoint:'src/cli.ts',\n            },\n        },\n    }\n}\n\nasync function withFixture (\n    fn:(root:string) => Promise<void>\n):Promise<void> {\n    const root = await mkdtemp(join(tmpdir(), 'roast-licenses-'))\n    try {\n        await fn(root)\n    } finally {\n        await rm(root, { recursive:true, force:true })\n    }\n}\n\ntest('notices collect unscoped, scoped, and nested packages', async t => {\n    await withFixture(async root => {\n        const nm = join(root, 'node_modules')\n        await writePackage(join(nm, 'plain'), {\n            name:'plain', version:'1.0.0', license:'MIT',\n        })\n        await writePackage(join(nm, '@scope', 'pkg'), {\n            name:'@scope/pkg', version:'2.0.0', license:'ISC',\n        })\n        const nested = join(nm, 'plain', 'node_modules', 'inner')\n        await writePackage(nested, {\n            name:'inner', version:'3.0.0', license:'Apache-2.0',\n        })\n        // A second copy of inner@3.0.0 in another place.\n        const copy = join(nm, '@scope', 'pkg', 'node_modules', 'inner')\n        await writePackage(copy, {\n            name:'inner', version:'3.0.0', license:'Apache-2.0',\n        })\n\n        const meta = metafile({\n            [join(nm, 'plain', 'lib', 'index.js')]:10,\n            [join(nm, 'plain', 'lib', 'other.js')]:10,\n            [join(nm, '@scope', 'pkg', 'lib', 'index.js')]:10,\n            [join(nested, 'lib', 'index.js')]:10,\n            [join(copy, 'lib', 'index.js')]:10,\n        })\n        const dirs = bundledPackageDirs(meta, OUTFILE)\n        t.deepEqual([...dirs].sort(), [\n            join(nm, '@scope', 'pkg'),\n            copy,\n            join(nm, 'plain'),\n            nested,\n        ].sort(), 'one directory per package root, innermost for nested')\n\n        const packages = readBundledPackages(dirs)\n        t.deepEqual(packages.map(p => `${p.name}@${p.version}`).sort(), [\n            '@scope/pkg@2.0.0',\n            'inner@3.0.0',\n            'plain@1.0.0',\n        ], 'packages are deduplicated by name@version')\n        const scoped = packages.find(p => p.name === '@scope/pkg')\n        t.equal(scoped?.license, 'ISC', 'reads the license field')\n        t.deepEqual(scoped?.licenseFiles,\n            [join(nm, '@scope', 'pkg', 'LICENSE')],\n            'finds the license file')\n    })\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":860,"cache_read_input_tokens":77740,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":860},"output_tokens":34,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c58d9c3b-30b3-4134-a232-a64a183be86b","uuid":"d8b10baf-7ebf-4bbd-83a6-d8a71a6377a7","timestamp":"2026-11-18T19:13:50.562Z","request_id":"req_011ChAvgQAPKHMjYirLcQU9y","wire_tool_inputs":{"toolu_01PoAHoyuGQRfATnUqhTrkxQ":{"file_path":"/Users/nick/code/roast.ts-rewrite-02-third-party-notices-and-package-check/test/tooling/licenses.ts","content":"import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'\nimport { readFileSync } from 'node:fs'\nimport { tmpdir } from 'node:os'\nimport { join } from 'node:path'\nimport type { Metafile } from 'esbuild'\nimport { test } from '@substrate-system/tapzero'\nimport {\n    bundledPackageDirs,\n    readBundledPackages,\n    renderNotices,\n} from '../../scripts/licenses.ts'\n\nconst OUTFILE = 'dist/cli.js'\n\ninterface FixturePackage {\n    name:string;\n    version:string;\n    license?:unknown;\n    repository?:unknown;\n    licenseFiles?:Record<string, string>;\n}\n\n// Writes one package (manifest plus license files) into `dir`.\nasync function writePackage (dir:string, pkg:FixturePackage):Promise<void> {\n    await mkdir(join(dir, 'lib'), { recursive:true })\n    const manifest:Record<string, unknown> = {\n        name:pkg.name,\n        version:pkg.version,\n    }\n    if (pkg.license !== undefined) manifest.license = pkg.license\n    if (pkg.repository !== undefined) manifest.repository = pkg.repository\n    await writeFile(join(dir, 'package.json'), JSON.stringify(manifest))\n    await writeFile(join(dir, 'lib', 'index.js'), 'export {}\\n')\n    const files = pkg.licenseFiles ?? { LICENSE:`${pkg.name} license\\n` }\n    for (const [file, text] of Object.entries(files)) {\n        await writeFile(join(dir, file), text)\n    }\n}\n\n// A metafile whose dist/cli.js output has the given inputs.\nfunction metafile (inputs:Record<string, number>):Metafile {\n    const outInputs:Metafile['outputs'][string]['inputs'] = {}\n    for (const [path, bytes] of Object.entries(inputs)) {\n        outInputs[path] = { bytesInOutput:bytes }\n    }\n    return {\n        inputs:{},\n        outputs:{\n            [OUTFILE]:{\n                bytes:1,\n                inputs:outInputs,\n                imports:[],\n                exports:[],\n                entryPoint:'src/cli.ts',\n            },\n        },\n    }\n}\n\nasync function withFixture (\n    fn:(root:string) => Promise<void>\n):Promise<void> {\n    const root = await mkdtemp(join(tmpdir(), 'roast-licenses-'))\n    try {\n        await fn(root)\n    } finally {\n        await rm(root, { recursive:true, force:true })\n    }\n}\n\ntest('notices collect unscoped, scoped, and nested packages', async t => {\n    await withFixture(async root => {\n        const nm = join(root, 'node_modules')\n        await writePackage(join(nm, 'plain'), {\n            name:'plain', version:'1.0.0', license:'MIT',\n        })\n        await writePackage(join(nm, '@scope', 'pkg'), {\n            name:'@scope/pkg', version:'2.0.0', license:'ISC',\n        })\n        const nested = join(nm, 'plain', 'node_modules', 'inner')\n        await writePackage(nested, {\n            name:'inner', version:'3.0.0', license:'Apache-2.0',\n        })\n        // A second copy of inner@3.0.0 in another place.\n        const copy = join(nm, '@scope', 'pkg', 'node_modules', 'inner')\n        await writePackage(copy, {\n            name:'inner', version:'3.0.0', license:'Apache-2.0',\n        })\n\n        const meta = metafile({\n            [join(nm, 'plain', 'lib', 'index.js')]:10,\n            [join(nm, 'plain', 'lib', 'other.js')]:10,\n            [join(nm, '@scope', 'pkg', 'lib', 'index.js')]:10,\n            [join(nested, 'lib', 'index.js')]:10,\n            [join(copy, 'lib', 'index.js')]:10,\n        })\n        const dirs = bundledPackageDirs(meta, OUTFILE)\n        t.deepEqual([...dirs].sort(), [\n            join(nm, '@scope', 'pkg'),\n            copy,\n            join(nm, 'plain'),\n            nested,\n        ].sort(), 'one directory per package root, innermost for nested')\n\n        const packages = readBundledPackages(dirs)\n        t.deepEqual(packages.map(p => `${p.name}@${p.version}`).sort(), [\n            '@scope/pkg@2.0.0',\n            'inner@3.0.0',\n            'plain@1.0.0',\n        ], 'packages are deduplicated by name@version')\n        const scoped = packages.find(p => p.name === '@scope/pkg')\n        t.equal(scoped?.license, 'ISC', 'reads the license field')\n        t.deepEqual(scoped?.licenseFiles,\n            [join(nm, '@scope', 'pkg', 'LICENSE')],\n            'finds the license file')\n    })\n})\n"}}}
