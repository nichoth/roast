{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAvt61ZYJBd8y9pW53dw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NGciUTcc9ozQc8TFN1ZBo6","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-02-third-party-notices-and-package-check/scripts/check-package.ts","content":"// The slimmed package check (spec 15, 2.10). Operates on process.cwd()\n// so tests can run it in a fixture. Becomes scripts/check-pack.ts at M6;\n// until then it would fail against the transitional manifest, so no npm\n// script or CI job runs it. Run directly by Node (type stripping), so\n// only erasable TypeScript syntax is allowed here.\nimport { spawnSync } from 'node:child_process'\nimport { closeSync, openSync, readFileSync, readSync, statSync } from 'node:fs'\nimport { join } from 'node:path'\n\nconst REQUIRED_FILES = [\n    'dist/cli.js',\n    'dist/THIRD_PARTY_LICENSES.txt',\n    'roast.schema.json',\n    'LICENSE.txt',\n    'LICENSE-MIT.txt',\n    'LICENSE-APACHE.txt',\n]\n\nconst SHEBANG = '#!/usr/bin/env node\\n'\n\ninterface PackResult {\n    files?:Array<{ path?:unknown }>;\n}\n\n// The paths `npm pack --dry-run --json` would put in the tarball. npm 12\n// prints an object keyed by package name, older npm an array.\nfunction packedFiles (cwd:string):Set<string> {\n    const res = spawnSync('npm', ['pack', '--dry-run', '--json'], {\n        cwd,\n        encoding:'utf8',\n    })\n    if (res.error) throw res.error\n    if (res.status !== 0) {\n        process.stderr.write(res.stderr)\n        throw new Error(`npm pack --dry-run exited ${res.status}`)\n    }\n    const parsed:unknown = JSON.parse(res.stdout)\n    const results = (Array.isArray(parsed) ?\n        parsed :\n        Object.values(parsed as Record<string, unknown>)) as PackResult[]\n    if (results.length !== 1) {\n        throw new Error(`npm pack reported ${results.length} packages, ` +\n            'expected 1')\n    }\n    const files = results[0]?.files ?? []\n    return new Set(files.map(file => String(file.path)))\n}\n\nfunction manifestProblems (manifest:Record<string, unknown>):string[] {\n    const problems:string[] = []\n    if (typeof manifest.license !== 'string' || manifest.license === '') {\n        problems.push('package.json declares no license')\n    }\n    const deps = manifest.dependencies\n    if (deps !== undefined &&\n        (typeof deps !== 'object' || deps === null ||\n            Object.keys(deps).length > 0)) {\n        problems.push('package.json declares dependencies; everything ' +\n            'Roast runs must be bundled into dist/cli.js')\n    }\n    if (manifest.optionalDependencies !== undefined) {\n        problems.push('package.json declares optionalDependencies')\n    }\n    return problems\n}\n\nfunction cliProblems (path:string):string[] {\n    let fd:number\n    try {\n        fd = openSync(path, 'r')\n    } catch {\n        return [] // the tarball check already reports a missing file\n    }\n    const head = Buffer.alloc(SHEBANG.length)\n    try {\n        readSync(fd, head, 0, head.length, 0)\n    } finally {\n        closeSync(fd)\n    }\n    const problems:string[] = []\n    if (head.toString('utf8') !== SHEBANG) {\n        problems.push(`dist/cli.js does not start with ${\n            JSON.stringify(SHEBANG)}`)\n    }\n    if ((statSync(path).mode & 0o100) === 0) {\n        problems.push('dist/cli.js is not executable by its owner')\n    }\n    return problems\n}\n\nfunction main ():number {\n    const cwd = process.cwd()\n    const manifest = JSON.parse(readFileSync(join(cwd, 'package.json'),\n        'utf8')) as Record<string, unknown>\n    const packed = packedFiles(cwd)\n    const problems = [\n        ...REQUIRED_FILES\n            .filter(file => !packed.has(file))\n            .map(file => `the tarball does not contain ${file}`),\n        ...manifestProblems(manifest),\n        ...cliProblems(join(cwd, 'dist', 'cli.js')),\n    ]\n    if (problems.length > 0) {\n        for (const problem of problems) {\n            console.error(`packaging check failed: ${problem}`)\n        }\n        console.error('hint: run `npm run build`, then check the `files` ' +\n            'list in package.json')\n        return 1\n    }\n    console.log(`packaging check passed: ${packed.size} files, ` +\n        `${REQUIRED_FILES.length} required files present`)\n    return 0\n}\n\ntry {\n    process.exitCode = main()\n} catch (err) {\n    console.error(`packaging check failed: ${\n        err instanceof Error ? err.message : String(err)}`)\n    process.exitCode = 1\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":401,"cache_read_input_tokens":97251,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":401},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c58d9c3b-30b3-4134-a232-a64a183be86b","uuid":"49f30d7f-53f1-4866-b8da-9a7eda5f2915","timestamp":"2026-11-18T19:16:29.193Z","request_id":"req_011ChAvt5ezG1GisdfPtxmYQ","wire_tool_inputs":{"toolu_01NGciUTcc9ozQc8TFN1ZBo6":{"file_path":"/Users/nick/code/roast.ts-rewrite-02-third-party-notices-and-package-check/scripts/check-package.ts","content":"// The slimmed package check (spec 15, 2.10). Operates on process.cwd()\n// so tests can run it in a fixture. Becomes scripts/check-pack.ts at M6;\n// until then it would fail against the transitional manifest, so no npm\n// script or CI job runs it. Run directly by Node (type stripping), so\n// only erasable TypeScript syntax is allowed here.\nimport { spawnSync } from 'node:child_process'\nimport { closeSync, openSync, readFileSync, readSync, statSync } from 'node:fs'\nimport { join } from 'node:path'\n\nconst REQUIRED_FILES = [\n    'dist/cli.js',\n    'dist/THIRD_PARTY_LICENSES.txt',\n    'roast.schema.json',\n    'LICENSE.txt',\n    'LICENSE-MIT.txt',\n    'LICENSE-APACHE.txt',\n]\n\nconst SHEBANG = '#!/usr/bin/env node\\n'\n\ninterface PackResult {\n    files?:Array<{ path?:unknown }>;\n}\n\n// The paths `npm pack --dry-run --json` would put in the tarball. npm 12\n// prints an object keyed by package name, older npm an array.\nfunction packedFiles (cwd:string):Set<string> {\n    const res = spawnSync('npm', ['pack', '--dry-run', '--json'], {\n        cwd,\n        encoding:'utf8',\n    })\n    if (res.error) throw res.error\n    if (res.status !== 0) {\n        process.stderr.write(res.stderr)\n        throw new Error(`npm pack --dry-run exited ${res.status}`)\n    }\n    const parsed:unknown = JSON.parse(res.stdout)\n    const results = (Array.isArray(parsed) ?\n        parsed :\n        Object.values(parsed as Record<string, unknown>)) as PackResult[]\n    if (results.length !== 1) {\n        throw new Error(`npm pack reported ${results.length} packages, ` +\n            'expected 1')\n    }\n    const files = results[0]?.files ?? []\n    return new Set(files.map(file => String(file.path)))\n}\n\nfunction manifestProblems (manifest:Record<string, unknown>):string[] {\n    const problems:string[] = []\n    if (typeof manifest.license !== 'string' || manifest.license === '') {\n        problems.push('package.json declares no license')\n    }\n    const deps = manifest.dependencies\n    if (deps !== undefined &&\n        (typeof deps !== 'object' || deps === null ||\n            Object.keys(deps).length > 0)) {\n        problems.push('package.json declares dependencies; everything ' +\n            'Roast runs must be bundled into dist/cli.js')\n    }\n    if (manifest.optionalDependencies !== undefined) {\n        problems.push('package.json declares optionalDependencies')\n    }\n    return problems\n}\n\nfunction cliProblems (path:string):string[] {\n    let fd:number\n    try {\n        fd = openSync(path, 'r')\n    } catch {\n        return [] // the tarball check already reports a missing file\n    }\n    const head = Buffer.alloc(SHEBANG.length)\n    try {\n        readSync(fd, head, 0, head.length, 0)\n    } finally {\n        closeSync(fd)\n    }\n    const problems:string[] = []\n    if (head.toString('utf8') !== SHEBANG) {\n        problems.push(`dist/cli.js does not start with ${\n            JSON.stringify(SHEBANG)}`)\n    }\n    if ((statSync(path).mode & 0o100) === 0) {\n        problems.push('dist/cli.js is not executable by its owner')\n    }\n    return problems\n}\n\nfunction main ():number {\n    const cwd = process.cwd()\n    const manifest = JSON.parse(readFileSync(join(cwd, 'package.json'),\n        'utf8')) as Record<string, unknown>\n    const packed = packedFiles(cwd)\n    const problems = [\n        ...REQUIRED_FILES\n            .filter(file => !packed.has(file))\n            .map(file => `the tarball does not contain ${file}`),\n        ...manifestProblems(manifest),\n        ...cliProblems(join(cwd, 'dist', 'cli.js')),\n    ]\n    if (problems.length > 0) {\n        for (const problem of problems) {\n            console.error(`packaging check failed: ${problem}`)\n        }\n        console.error('hint: run `npm run build`, then check the `files` ' +\n            'list in package.json')\n        return 1\n    }\n    console.log(`packaging check passed: ${packed.size} files, ` +\n        `${REQUIRED_FILES.length} required files present`)\n    return 0\n}\n\ntry {\n    process.exitCode = main()\n} catch (err) {\n    console.error(`packaging check failed: ${\n        err instanceof Error ? err.message : String(err)}`)\n    process.exitCode = 1\n}\n"}}}
