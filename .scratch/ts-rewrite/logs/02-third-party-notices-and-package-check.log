{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PDj5NkZo8g5GzJ9amdkT1t","type":"tool_result","content":"import { readFile, stat, open } from 'node:fs/promises'\nimport { join } from 'node:path'\nimport { test } from '@substrate-system/tapzero'\nimport { ROOT, run } from '../helpers/spawn.js'\n\nconst CLI = join(ROOT, 'dist', 'cli.js')\n\n// The process env without anything that could pick a locale.\nfunction baseEnv ():NodeJS.ProcessEnv {\n    const env = { ...process.env }\n    for (const key of Object.keys(env)) {\n        if (key === 'LANG' || key === 'LANGUAGE' || key.startsWith('LC_')) {\n            delete env[key]\n        }\n    }\n    return env\n}\n\ntest('--version prints the package.json version', async t => {\n    const pkg = JSON.parse(await readFile(join(ROOT, 'package.json'),\n        'utf8'))\n    for (const flag of ['--version', '-v']) {\n        const res = await run(process.execPath, [CLI, flag])\n        t.equal(res.code, 0, `${flag} exits 0`)\n        t.ok(res.stdout.includes(pkg.version),\n            `${flag} output contains the package version`)\n    }\n})\n\ntest('--help output does not depend on the locale', async t => {\n    const german = await run(process.execPath, [CLI, '--help'], {\n        env:{ ...baseEnv(), LC_ALL:'de_DE.UTF-8', LANG:'de_DE.UTF-8' },\n    })\n    const c = await run(process.execPath, [CLI, '--help'], {\n        env:{ ...baseEnv(), LC_ALL:'C' },\n    })\n    t.equal(german.code, 0, 'help exits 0 under a German locale')\n    t.equal(c.code, 0, 'help exits 0 under the C locale')\n    t.ok(c.stdout.length > 0, 'help is printed to stdout')\n    t.equal(german.stdout, c.stdout, 'help output is identical')\n})\n\ntest('dist/cli.js has a shebang and the owner execute bit', async t => {\n    const file = await open(CLI, 'r')\n    const head = Buffer.alloc(20)\n    await file.read(head, 0, 20, 0)\n    await file.close()\n    t.equal(head.toString('utf8'), '#!/usr/bin/env node\\n',\n        'the first line is the node shebang')\n    const mode = (await stat(CLI)).mode\n    t.ok(mode & 0o100, 'the owner can execute it')\n})\n\ntest('the entry exits 2 on a Node version below 22.18', async t => {\n    const fakeVersion = 'data:text/javascript,' + encodeURIComponent(\n        'Object.defineProperty(process.versions, \"node\", ' +\n        '{ value: \"22.17.1\" })'\n    )\n    const res = await run(process.execPath, [\n        '--import', fakeVersion, CLI, '--version',\n    ])\n    t.equal(res.code, 2, 'exits 2')\n    t.ok(res.stderr.includes('22.18'), 'stderr names the floor')\n    t.equal(res.stdout, '', 'the CLI body never ran')\n})\nimport { spawn } from 'node:child_process'\nimport { fileURLToPath } from 'node:url'\n\n// The test bundle lives in test/, so the repository root is one up.\nexport const ROOT = fileURLToPath(new URL('..', import.meta.url))\n\nexport interface SpawnResult {\n    code:number|null;\n    stdout:string;\n    stderr:string;\n}\n\n// Runs a command to completion and collects its output.\nexport function run (\n    command:string,\n    args:string[],\n    opts:{ cwd?:string, env?:NodeJS.ProcessEnv } = {}\n):Promise<SpawnResult> {\n    return new Promise((resolve, reject) => {\n        const child = spawn(command, args, {\n            cwd:opts.cwd ?? ROOT,\n            env:opts.env ?? process.env,\n            stdio:['ignore', 'pipe', 'pipe'],\n        })\n        let stdout = ''\n        let stderr = ''\n        child.stdout.setEncoding('utf8')\n        child.stderr.setEncoding('utf8')\n        child.stdout.on('data', chunk => { stdout += chunk })\n        child.stderr.on('data', chunk => { stderr += chunk })\n        child.on('error', reject)\n        child.on('close', code => resolve({ code, stdout, stderr }))\n    })\n}\nimport { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'\nimport { tmpdir } from 'node:os'\nimport { delimiter, join } from 'node:path'\nimport { test } from '@substrate-system/tapzero'\nimport { ROOT, run } from '../helpers/spawn.js'\n\n// Runs the real `test:tap` script from package.json in a fixture directory\n// whose test/test-bundle.js is `bundle`.\nasync function testTap (bundle:string) {\n    const pkg = JSON.parse(await readFile(join(ROOT, 'package.json'),\n        'utf8'))\n    const script:string = pkg.scripts['test:tap']\n    const dir = await mkdtemp(join(tmpdir(), 'roast-test-tap-'))\n    const bin = join(ROOT, 'node_modules', '.bin')\n    try {\n        await mkdir(join(dir, 'test'))\n        await writeFile(join(dir, 'test', 'test-bundle.js'), bundle)\n        return await run('sh', ['-c', script], {\n            cwd:dir,\n            env:{ ...process.env, PATH:bin + delimiter + process.env.PATH },\n        })\n    } finally {\n        await rm(dir, { recursive:true, force:true })\n    }\n}\n\n// tap-spec itself exits non-zero on `not ok` lines and a missing plan,\n// so these bundles print a complete, passing TAP stream and fail only\n// through their exit status: pipefail is what catches them.\nconst PASSING_TAP = \"console.log('TAP version 13\\\\nok 1 - fine\\\\n1..1')\\n\"\n\ntest('test:tap exits 0 when the test bundle passes', async t => {\n    const res = await testTap(PASSING_TAP)\n    t.equal(res.code, 0, 'exits 0')\n})\n\ntest('test:tap exits non-zero when the bundle reports a failure', async t => {\n    const res = await testTap(PASSING_TAP + 'process.exitCode = 1\\n')\n    t.ok(res.code !== 0, 'exits non-zero')\n})\n\ntest('test:tap exits non-zero when the test bundle crashes', async t => {\n    const res = await testTap(PASSING_TAP +\n        \"setTimeout(() => { throw new Error('crash after the plan') })\\n\")\n    t.ok(res.code !== 0, 'exits non-zero')\n})\n\ntest('test:tap exits non-zero on a failed assertion', async t => {\n    const res = await testTap(\n        \"console.log('TAP version 13\\\\nnot ok 1 - broken\\\\n1..1')\\n\" +\n        'process.exitCode = 1\\n')\n    t.ok(res.code !== 0, 'exits non-zero')\n})\nrun.ts\n// The CLI core: run(argv, io). It never reads process globals and never\n// calls process.exit, so tests drive it in-process. In M0 it handles only\n// the root --version / -v and --help; ticket 04 grows the command tree.\nimport yargs from 'yargs'\nimport { buildInfo, formatBuildInfo } from '../buildinfo.js'\n\nexport interface CliIO {\n    stdin:NodeJS.ReadableStream;\n    stdout:NodeJS.WritableStream;\n    stderr:NodeJS.WritableStream;\n    env:Readonly<Record<string, string|undefined>>;\n    cwd:string;\n    signal?:AbortSignal;\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface RunResult {\n    code:number;\n    error?:Error;\n}\n\nconst EXIT_USAGE = 2\n\nfunction parser (argv:string[]) {\n    return yargs(argv)\n        .scriptName('roast')\n        .locale('en')\n        .detectLocale(false) // English only, whatever LANG/LC_ALL say\n        .exitProcess(false)\n        .strict()\n        .usage('$0 [command] [flags]')\n        .version(false) // root-only --version / -v is handled in run\n        .option('version', {\n            alias:'v',\n            type:'boolean',\n            describe:'Print the version and exit',\n        })\n        .help('help')\n        .alias('help', 'h')\n}\n// Runs the root package's real `check:pack` script against a fixture\n// package layout whose manifests carry the real `files` lists.\nimport { test } from 'node:test'\nimport assert from 'node:assert/strict'\nimport { spawnSync } from 'node:child_process'\nimport { mkdirSync, rmSync, writeFileSync } from 'node:fs'\nimport { join } from 'node:path'\nimport {\n    LICENSES,\n    PLATFORMS,\n    REPO,\n    makeReleaseFixture,\n    packageDir,\n    readJSON,\n    removeFixture,\n    writeJSON,\n} from './release-fixture.ts'\n\n/**\n * A fully built fixture: platform packages hold their binaries and notices,\n * and the root holds the launcher and the schema. Every manifest uses the\n * `files` list from the matching manifest in this repo.\n */\nfunction makePackFixture ():string {\n    const root = makeReleaseFixture('1.2.3', true)\n    const rootManifest = join(root, 'package.json')\n    const realRoot = readJSON(join(REPO, 'package.json'))\n    writeJSON(rootManifest, {\n        ...readJSON(rootManifest),\n        license: realRoot.license,\n        files: realRoot.files,\n    })\n    for (const file of LICENSES) {\n        writeFileSync(join(root, file), 'license\\n')\n    }\n    mkdirSync(join(root, 'dist'))\n    writeFileSync(join(root, 'dist', 'launcher.js'), '// launcher\\n')\n    writeFileSync(join(root, 'roast.schema.json'), '{}\\n')\n    for (const platform of PLATFORMS) {\n        const manifest = join(packageDir(root, platform), 'package.json')\n        const real = readJSON(\n            join(packageDir(REPO, platform), 'package.json')\n        )\n        writeJSON(manifest, {\n            ...readJSON(manifest),\n            license: real.license,\n            files: real.files,\n        })\n    }\n    return root\n}\n\nfunction checkPack (root:string) {\n    return spawnSync('npm', ['run', 'check:pack'], {\n        cwd: root,\n        encoding: 'utf8',\n    })\n}\n\ntest('passes when every tarball holds its dist contents', (t) => {\n    const root = makePackFixture()\n    t.after(() => removeFixture(root))\n\n    const result = checkPack(root)\n    assert.equal(result.status, 0, result.stderr)\n})\n\ntest('fails when a platform tarball lacks its binary', (t) => {\n    const root = makePackFixture()\n    t.after(() => removeFixture(root))\n    rmSync(join(packageDir(root, 'win32-arm64'), 'dist', 'roast.exe'))\n\n    const result = checkPack(root)\n    assert.notEqual(result.status, 0)\n    assert.ok(result.stderr.includes('roast-win32-arm64'), result.stderr)\n})\n\ntest('fails when a platform tarball lacks license notices', (t) => {\n    const root = makePackFixture()\n    t.after(() => removeFixture(root))\ndist/\nLICENSE\npackage.json\nREADME.md\n{\n  \"name\": \"@substrate-system/debug\",\n  \"description\": \"Debug utility\",\n  \"type\": \"module\",\n  \"version\": \"0.9.68\",\n  \"main\": \"./dist/node/index.js\",\n  \"files\": [\n    \"./dist/*\"\n  ],\n  \"exports\": {\n    \".\": {\n      \"node\": {\n        \"types\": \"./dist/node/index.d.ts\",\n        \"import\": \"./dist/node/index.js\",\n        \"require\": \"./dist/node/index.cjs\"\n      },\n      \"worker\": {\n        \"types\": \"./dist/cloudflare/index.d.ts\",\n        \"import\": \"./dist/cloudflare/index.js\",\n        \"require\": \"./dist/cloudflare/index.cjs\"\n      },\n      \"browser\": {\n        \"types\": \"./dist/browser/index.d.ts\",\n        \"import\": \"./dist/browser/index.js\",\n        \"require\": \"./dist/browser/index.cjs\"\n      },\n      \"default\": {\n        \"types\": \"./dist/browser/index.d.ts\",\n        \"import\": \"./dist/browser/index.js\",\n        \"require\": \"./dist/browser/index.cjs\"\n      }\n    },\n    \"./index\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\",\n      \"require\": \"./dist/index.cjs\"\n    },\n    \"./node\": {\n      \"types\": \"./dist/node/index.d.ts\",\n      \"import\": \"./dist/node/index.js\",\n      \"require\": \"./dist/node/index.cjs\"\n    },\n    \"./browser\": {\n      \"types\": \"./dist/browser/index.d.ts\",\n      \"import\": \"./dist/browser/index.js\",\n      \"require\": \"./dist/browser/index.cjs\"\n    },\n    \"./cloudflare\": {\n      \"types\": \"./dist/cloudflare/index.d.ts\",\n      \"import\": \"./dist/cloudflare/index.js\",\n      \"require\": \"./dist/cloudflare/index.cjs\"\n    },\n    \"./min/*\": {\n      \"types\": \"./dist/*/index.d.ts\",\n      \"import\": \"./dist/*/index.min.js\",\n      \"require\": \"./dist/*/index.min.cjs\"\n    },\n    \"./noop\": {\n      \"types\": \"./dist/noop.d.ts\",\n      \"import\": \"./dist/noop.js\",","is_error":false}]},"parent_tool_use_id":null,"session_id":"c58d9c3b-30b3-4134-a232-a64a183be86b","uuid":"dfe7b130-7552-4314-bf73-394240aae645","time