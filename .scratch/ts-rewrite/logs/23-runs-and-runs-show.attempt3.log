diff --git a/src/cli/runs-format.ts b/src/cli/runs-format.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5851eea1fd711cf1942cb6e4a870bb51c75f8832
--- /dev/null
+++ b/src/cli/runs-format.ts
@@ -0,0 +1,57 @@
+// pattern: Functional Core
+
+function pad (s:string, width:number):string {
+    return s + ' '.repeat(Math.max(0, width - Array.from(s).length))
+}
+
+function stringField (run:Record<string, unknown>, key:string):string {
+    const value = run[key]
+    if (value == null) return ''
+    if (typeof value !== 'string') throw new Error('expected string')
+    return value
+}
+
+function integerField (run:Record<string, unknown>, key:string):bigint {
+    const value = run[key]
+    if (value == null) return 0n
+    if (typeof value !== 'bigint') throw new Error('expected integer')
+    return value
+}
+
+// Number lexemes must fit Go's signed int64; retain exact large counts.
+function decodeNumber (
+    _key:string,
+    value:unknown,
+    context?:{ source?:string }
+):unknown {
+    if (typeof value !== 'number') return value
+    const source = context?.source ?? ''
+    if (!/^-?\d+$/.test(source)) return value
+    const integer = BigInt(source)
+    return integer >= -(2n ** 63n) && integer < 2n ** 63n ? integer : value
+}
+
+// The index is best effort: malformed lines disappear only in text mode.
+export function formatRunLine (line:string):string|null {
+    try {
+        const raw:unknown = JSON.parse(line, decodeNumber)
+        if (raw !== null && (typeof raw !== 'object' ||
+            Array.isArray(raw))) return null
+        const run = (raw ?? {}) as Record<string, unknown>
+        const ts = stringField(run, 'ts')
+        const id = stringField(run, 'run_id')
+        const mode = stringField(run, 'mode')
+        const assessment = stringField(run, 'assessment')
+        const repo = stringField(run, 'repo')
+        const quick = run.quick ?? false
+        if (typeof quick !== 'boolean') return null
+        const files = run.files_reviewed ?? []
+        if (!Array.isArray(files) || files.some(v =>
+            v !== null && typeof v !== 'string')) return null
+        return `${ts}  ${pad(id, 25)} ${pad(mode, 8)} ` +
+            `q=${pad(String(quick), 5)} ${pad(assessment, 30)} ` +
+            `findings=${integerField(run, 'n_findings')} ` +
+            `refuted=${integerField(run, 'n_refuted')} ` +
+            `files=${files.length}  ${repo}\n`
+    } catch { return null }
+}
diff --git a/src/cli/runs.ts b/src/cli/runs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..db47b48880927543a6bef3080626e5d77c5623aa
--- /dev/null
+++ b/src/cli/runs.ts
@@ -0,0 +1,119 @@
+// pattern: Imperative Shell
+import fs from 'node:fs/promises'
+import { createReadStream } from 'node:fs'
+import path from 'node:path'
+import type { CommandArgs, CommandDef, RunContext } from './command.js'
+import { recordDir } from '../record/dir.js'
+import { reportPath } from '../record/meta.js'
+import { compareBytes } from '../gocompat/strings.js'
+import { UsageError } from './errors.js'
+import { formatRunLine } from './runs-format.js'
+import { textBytes } from '../textsafe/textsafe.js'
+
+async function readLines (file:string):Promise<Array<Buffer>> {
+    const lines:Array<Buffer> = []
+    const stream = createReadStream(file)
+    const max = 16 * 1024 * 1024
+    let pending = Buffer.alloc(0)
+    function append (line:Buffer):void {
+        lines.push(line.at(-1) === 13 ? line.subarray(0, -1) : line)
+    }
+    try {
+        for await (const chunk of stream) {
+            pending = Buffer.concat([pending, chunk])
+            let end:number
+            while ((end = pending.indexOf(10)) !== -1) {
+                if (end >= max) return lines
+                append(pending.subarray(0, end))
+                pending = pending.subarray(end + 1)
+            }
+            if (pending.length >= max) return lines
+        }
+        if (pending.length) append(pending)
+    } catch {
+        // Unreadable files do not hide records in later months.
+    } finally {
+        stream.destroy()
+    }
+    return lines
+}
+
+async function runsHandler (
+    args:CommandArgs,
+    ctx:RunContext
+):Promise<void> {
+    const rawLimit = String(args.limit)
+    if (!/^[+-]?\d+$/.test(rawLimit) ||
+        BigInt(rawLimit) < -(2n ** 63n) ||
+        BigInt(rawLimit) >= 2n ** 63n) {
+        throw new UsageError('invalid --limit: expected a decimal integer')
+    }
+    const limit = BigInt(rawLimit)
+    const dir = await recordDir(ctx.cwd, {
+        env:ctx.env, signal:ctx.signal,
+    })
+    if (!dir) {
+        throw new UsageError('cannot resolve record directory: ' +
+            'run inside a Git repository')
+    }
+    const files = (await fs.readdir(dir).catch(() => []))
+        .filter(name => name.startsWith('runs-') && name.endsWith('.jsonl'))
+        .sort(compareBytes)
+    let lines:Array<Buffer> = []
+    for (const file of files) {
+        lines.push(...await readLines(path.join(dir, file)))
+    }
+    if (limit > 0 && BigInt(lines.length) > limit) {
+        lines = lines.slice(-Number(limit))
+    }
+    if (!lines.length) {
+        ctx.stderr.write(`roast: no run records in ${dir}\n`)
+    }
+    for (const line of lines) {
+        if (args.json === true) {
+            ctx.stdout.write(line)
+            ctx.stdout.write('\n')
+        } else {
+            const formatted = formatRunLine(line.toString('utf8'))
+            if (formatted !== null) ctx.stdout.write(formatted)
+        }
+    }
+}
+
+export const runsCommand:CommandDef = {
+    command:'runs',
+    describe:'Show and inspect local review runs',
+    builder:y => y
+        .option('limit', {
+            type:'string', default:'20', global:false,
+            describe:'maximum runs to show',
+        })
+        .option('json', {
+            type:'boolean', default:false, global:false,
+            describe:'emit raw JSONL records',
+        }),
+    handler:runsHandler,
+    subcommands:[
+        {
+            command:'show <run-id>',
+            describe:"Print a run's Markdown report",
+            builder:y => y.positional('run-id', { type:'string' }),
+            handler:async (args, ctx) => {
+                const dir = await recordDir(ctx.cwd, {
+                    env:ctx.env, signal:ctx.signal,
+                })
+                const file = await reportPath(dir, String(args['run-id']))
+                let content:Buffer
+                try {
+                    content = await fs.readFile(file)
+                } catch (err) {
+                    const msg = err instanceof Error ?
+                        err.message : String(err)
+                    throw new Error(`run has no report artifact: ${msg}`,
+                        { cause:err })
+                }
+                ctx.stdout.write(textBytes(content))
+            },
+        },
+    ],
+}
diff --git a/test/cli/runs.ts b/test/cli/runs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5f3a0824f5668d5b6d0324bf749d2ca32c29fd4b
--- /dev/null
+++ b/test/cli/runs.ts
@@ -0,0 +1,178 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { recordRepo } from '../record/repo.js'
+import { runRoast } from '../helpers/run.js'
+import { tempDir } from '../helpers/repo.js'
+import { recordDir } from '../../src/record/dir.js'
+import { appendRunLine } from '../../src/record/index-file.js'
+import { report } from '../render/fixtures.js'
+import { writeReport } from '../../src/record/meta.js'
+
+test('runs without records succeeds without creating state', async t => {
+    const repo = recordRepo(t)
+    const got = await runRoast(['runs'], { cwd:repo.dir, env:repo.env })
+    t.equal(got.code, 0)
+    t.equal(got.stdout, '')
+    t.ok(got.stderr.length > 0)
+    t.ok(!(await fs.readdir(repo.dir)).includes('.roast'))
+})
+
+test('runs outside Git is a usage error', async t => {
+    const outside = tempDir()
+    t.cleanup(outside.remove)
+    const got = await runRoast(['runs', '--error-format', 'json'], {
+        cwd:outside.dir, env:outside.env,
+    })
+    t.equal(got.code, 2)
+    t.equal(got.stdout, '')
+    t.equal(JSON.parse(got.stderr).error_category, 'usage')
+})
+
+test('runs rejects removed commands and other positionals', async t => {
+    const repo = recordRepo(t)
+    for (const positional of ['sync', 'status', 'bogus', 'run-id']) {
+        const got = await runRoast(['runs', positional,
+            '--error-format', 'json'], { cwd:repo.dir, env:repo.env })
+        t.equal(got.code, 2, positional)
+        t.equal(got.stdout, '')
+        t.equal(JSON.parse(got.stderr).error_category, 'usage')
+    }
+})
+
+test('runs JSON tails raw lines across chronological months', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    // Create the newer month first to exercise chronological ordering.
+    await appendRunLine(dir, report({ runId:'newer' }), repo.dir, [],
+        new Date(2026, 10, 2))
+    await appendRunLine(dir, report({ runId:'older' }), repo.dir, [],
+        new Date(2026, 9, 2))
+    const newer = path.join(dir, 'runs-2026-11.jsonl')
+    const raw = await fs.readFile(newer, 'utf8')
+    await fs.appendFile(newer, '  invalid JSON  \n')
+    const got = await runRoast(['runs', '--json', '--limit', '2'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    t.equal(got.code, 0)
+    t.equal(got.stdout, raw + '  invalid JSON  \n')
+    t.equal(got.stderr, '')
+})
+
+test('runs formats parseable records and skips invalid fields', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    const id = 'r\ud83d\ude80'
+    await appendRunLine(dir, report({ runId:id }), repo.dir, [],
+        new Date(2026, 10, 2))
+    const file = path.join(dir, 'runs-2026-11.jsonl')
+    await fs.appendFile(file, [
+        'not JSON',
+        '{"run_id":"bad-quick","quick":"true"}',
+        '{"run_id":"bad-files","files_reviewed":[2]}',
+        '{"run_id":"fraction","n_findings":1.0}',
+        '{"run_id":"exponent","n_findings":1e3}',
+        '{"run_id":"overflow","n_refuted":9223372036854775808}',
+        '{"run_id":"large","n_findings":9007199254740993}',
+        '{"run_id":"legacy","Mode":"wrong-case","quick":null}',
+        '',
+    ].join('\n'))
+    const got = await runRoast(['runs'], { cwd:repo.dir, env:repo.env })
+    t.equal(got.code, 0)
+    const lines = got.stdout.trimEnd().split('\n')
+    t.equal(lines.length, 3)
+    t.ok(lines[0].includes(id))
+    t.equal(lines[0].indexOf('code') - lines[0].indexOf(id), 27,
+        '25 code point ID column and one separator')
+    t.ok(lines[0].includes('findings=1 refuted=0 files=0'))
+    t.ok(lines[0].endsWith(repo.dir))
+    t.ok(lines[1].includes('large'))
+    t.ok(lines[1].includes('9007199254740993'))
+    t.ok(lines[2].includes('legacy'))
+    t.ok(!lines[2].includes('wrong-case'))
+})
+
+test('runs nonpositive limits list all and default limits to 20', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    for (let i = 0; i < 23; i++) {
+        await appendRunLine(dir, report({ runId:`run-${i}` }), repo.dir,
+            [], new Date(2026, 10, 2))
+    }
+    for (const limit of ['0', '-1', '+0']) {
+        const got = await runRoast(['runs', '--json', '--limit', limit], {
+            cwd:repo.dir, env:repo.env,
+        })
+        t.equal(got.code, 0)
+        const lines = got.stdout.trimEnd().split('\n')
+        t.equal(lines.length, 23)
+        t.equal(JSON.parse(lines[0]).run_id, 'run-0')
+    }
+    const got = await runRoast(['runs', '--json'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    const lines = got.stdout.trimEnd().split('\n')
+    t.equal(got.code, 0)
+    t.equal(lines.length, 20)
+    t.equal(JSON.parse(lines[0]).run_id, 'run-3')
+})
+
+test('runs scans CRLF, empty and unterminated final lines', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    await appendRunLine(dir, report(), repo.dir, [], new Date(2026, 10, 2))
+    await fs.writeFile(path.join(dir, 'runs-2026-11.jsonl'),
+        'first\r\n\nsecond\r\r\nlast\r')
+    const got = await runRoast(['runs', '--json', '--limit', '0'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    t.equal(got.code, 0)
+    t.equal(got.stdout, 'first\n\nsecond\r\nlast\n')
+})
+
+test('runs show round-trips stored reports from a nested cwd', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    const markdown = '# Review\n\nFinding in `main.ts`.\nNo final newline.'
+    await writeReport(dir, '20261123-report', markdown)
+    const cwd = path.join(repo.dir, 'nested', 'deeper')
+    await fs.mkdir(cwd, { recursive:true })
+    for (const id of ['20261123-report', '20261123']) {
+        const got = await runRoast(['runs', 'show', id], {
+            cwd, env:repo.env,
+        })
+        t.equal(got.code, 0)
+        t.equal(got.stdout, markdown)
+        t.equal(got.stderr, '')
+    }
+})
+
+test('runs show escapes stored terminal controls and invalid bytes',
+    async t => {
+        const repo = recordRepo(t)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const file = await writeReport(dir, 'unsafe',
+            '# Review\n\x1b[31m\x07\u0085\u009b')
+        await fs.appendFile(file, Buffer.from([0x80, 0x9b, 0xff]))
+        const got = await runRoast(['runs', 'show', 'unsafe'], {
+            cwd:repo.dir, env:repo.env,
+        })
+        t.equal(got.code, 0)
+        t.ok(got.stdout.length > 0)
+        t.ok(!Array.from(got.stdout).some(ch => {
+            const n = ch.codePointAt(0)!
+            return n === 0x1b || n === 0x07 || (n >= 0x80 && n <= 0x9f)
+        }))
+        t.ok(!got.stdout.includes('\ufffd'))
+    })
+
+test('runs show requires exactly one run ID', async t => {
+    const repo = recordRepo(t)
+    for (const ids of [[], ['one', 'two']]) {
+        const got = await runRoast(['runs', 'show', ...ids,
+            '--error-format', 'json'], { cwd:repo.dir, env:repo.env })
+        t.equal(got.code, 2)
+        t.equal(got.stdout, '')
+        t.equal(JSON.parse(got.stderr).error_category, 'usage')
+    }
+})
