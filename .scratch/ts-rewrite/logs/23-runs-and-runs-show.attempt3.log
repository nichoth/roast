new file mode 100644
index 0000000000000000000000000000000000000000..5851eea1fd711cf1942cb6e4a870bb51c75f8832
--- /dev/null
+++ b/src/cli/runs-format.ts
@@ -0,0 +1,57 @@
+// pattern: Functional Core
+
+function pad (s:string, width:number):string {
+    return s + ' '.repeat(Math.max(0, width - Array.from(s).length))
+}
+
+function stringField (run:Record<string, unknown>, key:string):string {
+    const value = run[key]
+    if (value == null) return ''
+    if (typeof value !== 'string') throw new Error('expected string')
+    return value
+}
+
+function integerField (run:Record<string, unknown>, key:string):bigint {
+    const value = run[key]
+    if (value == null) return 0n
+    if (typeof value !== 'bigint') throw new Error('expected integer')
+    return value
+}
+
+// Number lexemes must fit Go's signed int64; retain exact large counts.
+function decodeNumber (
+    _key:string,
+    value:unknown,
+    context?:{ source?:string }
+):unknown {
+    if (typeof value !== 'number') return value
+    const source = context?.source ?? ''
+    if (!/^-?\d+$/.test(source)) return value
+    const integer = BigInt(source)
+    return integer >= -(2n ** 63n) && integer < 2n ** 63n ? integer : value
+}
+
+// The index is best effort: malformed lines disappear only in text mode.
+export function formatRunLine (line:string):string|null {
+    try {
+        const raw:unknown = JSON.parse(line, decodeNumber)
+        if (raw !== null && (typeof raw !== 'object' ||
+            Array.isArray(raw))) return null
+        const run = (raw ?? {}) as Record<string, unknown>
+        const ts = stringField(run, 'ts')
+        const id = stringField(run, 'run_id')
+        const mode = stringField(run, 'mode')
+        const assessment = stringField(run, 'assessment')
+        const repo = stringField(run, 'repo')
+        const quick = run.quick ?? false
+        if (typeof quick !== 'boolean') return null
+        const files = run.files_reviewed ?? []
+        if (!Array.isArray(files) || files.some(v =>
+            v !== null && typeof v !== 'string')) return null
+        return `${ts}  ${pad(id, 25)} ${pad(mode, 8)} ` +
+            `q=${pad(String(quick), 5)} ${pad(assessment, 30)} ` +
+            `findings=${integerField(run, 'n_findings')} ` +
+            `refuted=${integerField(run, 'n_refuted')} ` +
+            `files=${files.length}  ${repo}\n`
+    } catch { return null }
+}
diff --git a/src/cli/runs.ts b/src/cli/runs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f4991c5ef9aef41c3ad8b96951f0bd1faa1c2403
--- /dev/null
+++ b/src/cli/runs.ts
@@ -0,0 +1,94 @@
+// pattern: Imperative Shell
+import fs from 'node:fs/promises'
+import { createReadStream } from 'node:fs'
+import path from 'node:path'
+import type { CommandArgs, CommandDef, RunContext } from './command.js'
+import { recordDir } from '../record/dir.js'
+import { compareBytes } from '../gocompat/strings.js'
+import { UsageError } from './errors.js'
+import { formatRunLine } from './runs-format.js'
+
+async function readLines (file:string):Promise<Array<Buffer>> {
+    const lines:Array<Buffer> = []
+    const stream = createReadStream(file)
+    const max = 16 * 1024 * 1024
+    let pending = Buffer.alloc(0)
+    function append (line:Buffer):void {
+        lines.push(line.at(-1) === 13 ? line.subarray(0, -1) : line)
+    }
+    try {
+        for await (const chunk of stream) {
+            pending = Buffer.concat([pending, chunk])
+            let end:number
+            while ((end = pending.indexOf(10)) !== -1) {
+                if (end >= max) return lines
+                append(pending.subarray(0, end))
+                pending = pending.subarray(end + 1)
+            }
+            if (pending.length >= max) return lines
+        }
+        if (pending.length) append(pending)
+    } catch {
+        // Unreadable files do not hide records in later months.
+    } finally {
+        stream.destroy()
+    }
+    return lines
+}
+
+async function runsHandler (
+    args:CommandArgs,
+    ctx:RunContext
+):Promise<void> {
+    const rawLimit = String(args.limit)
+    if (!/^[+-]?\d+$/.test(rawLimit) ||
+        BigInt(rawLimit) < -(2n ** 63n) ||
+        BigInt(rawLimit) >= 2n ** 63n) {
+        throw new UsageError('invalid --limit: expected a decimal integer')
+    }
+    const limit = BigInt(rawLimit)
+    const dir = await recordDir(ctx.cwd, {
+        env:ctx.env, signal:ctx.signal,
+    })
+    if (!dir) {
+        throw new UsageError('cannot resolve record directory: ' +
+            'run inside a Git repository')
+    }
+    const files = (await fs.readdir(dir).catch(() => []))
+        .filter(name => name.startsWith('runs-') && name.endsWith('.jsonl'))
+        .sort(compareBytes)
+    let lines:Array<Buffer> = []
+    for (const file of files) {
+        lines.push(...await readLines(path.join(dir, file)))
+    }
+    if (limit > 0 && BigInt(lines.length) > limit) {
+        lines = lines.slice(-Number(limit))
+    }
+    if (!lines.length) {
+        ctx.stderr.write(`roast: no run records in ${dir}\n`)
+    }
+    for (const line of lines) {
+        if (args.json === true) {
+            ctx.stdout.write(line)
+            ctx.stdout.write('\n')
+        } else {
+            const formatted = formatRunLine(line.toString('utf8'))
+            if (formatted !== null) ctx.stdout.write(formatted)
+        }
+    }
+}
+
+export const runsCommand:CommandDef = {
+    command:'runs',
+    describe:'Show and inspect local review runs',
+    builder:y => y
+        .option('limit', {
+            type:'string', default:'20', global:false,
+            describe:'maximum runs to show',
+        })
+        .option('json', {
+            type:'boolean', default:false, global:false,
+            describe:'emit raw JSONL records',
+        }),
+    handler:runsHandler,
+}
