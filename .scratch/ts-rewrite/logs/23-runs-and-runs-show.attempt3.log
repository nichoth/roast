// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a
// temporary Git repository as cwd, a clean environment, and optionally a
// fetch that sends every request to a fake server.
import { run, type RunResult } from '../../src/cli/run.js'
import { BufferStream, inputStream } from './streams.js'
import { tempRepo } from './repo.js'

export interface RunRoastOpts {
    // Working directory; a fresh temporary repository when absent.
    cwd?:string;
    // The environment; the repository's isolated env when absent.
    env?:Record<string, string>;
    stdin?:NodeJS.ReadableStream|string;
    signal?:AbortSignal;
    // Origin (`http://127.0.0.1:port`) every request is redirected to.
    redirectTo?:string;
}

export interface RunRoastResult extends RunResult {
    stdout:string;
    stderr:string;
    // The original host of every redirected request, in order.
    hosts:string[];
}

// A fetch that rewrites each URL's origin to `origin`, recording the
// original host (Go redirectDefaultTransport).
export function redirectingFetch (
    origin:string,
    hosts:string[]
):typeof globalThis.fetch {
    return (input, init) => {
        const req = new Request(input, init)
        const url = new URL(req.url)
        hosts.push(url.host)
        const target = new URL(url.pathname + url.search, origin)
        return globalThis.fetch(new Request(target, req))
    }
}

export async function runRoast (
    args:string[],
    opts:RunRoastOpts = {}
):Promise<RunRoastResult> {
    let cwd = opts.cwd
    let env = opts.env
    let remove:(() => void)|undefined
    if (cwd === undefined) {
        const repo = tempRepo()
        cwd = repo.dir
        env ??= repo.env
        remove = repo.remove
    }
    const stdout = new BufferStream()
    const stderr = new BufferStream()
    const hosts:string[] = []
    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?
        inputStream(opts.stdin ?? '') :
        opts.stdin
    try {
        const res = await run(args, {
            stdin,
            stdout,
            stderr,
            env:env ?? {},
            cwd,
            signal:opts.signal,
            fetch:opts.redirectTo ?
                redirectingFetch(opts.redirectTo, hosts) :
                undefined,
        })
        return {
            ...res,
            stdout:stdout.text(),
            stderr:stderr.text(),
            hosts,
        }
    } finally {
        remove?.()
    }
}
// Neutralizes terminal control sequences in untrusted text before it reaches
// a terminal or a Markdown report (Go: internal/textsafe).
//
// `text` keeps line structure (LF and tab survive, CRLF becomes LF);
// `line` keeps everything on one line (LF and tab become `\n` and `\t`).
// Controls, DEL, C1 controls, invalid UTF-8 bytes, and lone surrogates
// become printable escapes. Backslash is never escaped, so both functions
// are idempotent.

// A decoded unit: a code point (>= 0), or an invalid byte stored as
// -(byte + 1).
type Unit = number

// Fast path: true when the mode would change nothing in `s`. A
// well-formed surrogate pair is clean; a lone surrogate is not.
function isClean (s:string, lineMode:boolean):boolean {
    for (let i = 0; i < s.length; i++) {
        const c = s.charCodeAt(i)
        if (c < 0x20) {
            if (lineMode || (c !== 0x0a && c !== 0x09)) return false
        } else if (c >= 0x7f && c <= 0x9f) {
            return false
        } else if (c >= 0xd800 && c <= 0xdbff) {
            const next = s.charCodeAt(i + 1)
            if (!(next >= 0xdc00 && next <= 0xdfff)) return false
            i++
        } else if (c >= 0xdc00 && c <= 0xdfff) {
            return false
        }
    }
    return true
}

function hex (n:number, width:number):string {
    return n.toString(16).padStart(width, '0')
}

function escapeUnits (units:Unit[], lineMode:boolean):string {
    let out = ''
    for (let i = 0; i < units.length; i++) {
        const u = units[i]
        if (u < 0) {
            out += '\\x' + hex(-u - 1, 2)
        } else if (u === 0x0d) {
            if (!lineMode && units[i + 1] === 0x0a) continue
            out += '\\x0d'
        } else if (u === 0x0a) {
            out += lineMode ? '\\n' : '\n'
        } else if (u === 0x09) {
            out += lineMode ? '\\t' : '\t'
        } else if (u < 0x20 || u === 0x7f) {
            out += '\\x' + hex(u, 2)
        } else if ((u >= 0x80 && u <= 0x9f) ||
            (u >= 0xd800 && u <= 0xdfff)) {
            out += '\\u' + hex(u, 4)
        } else {
            out += String.fromCodePoint(u)
        }
    }
    return out
}

function stringUnits (s:string):Unit[] {
    const units:Unit[] = []
    // String iteration yields a lone surrogate as its own code point.
    for (const ch of s) units.push(ch.codePointAt(0)!)
    return units
}

function isCont (b:number|undefined):boolean {
    return b !== undefined && b >= 0x80 && b <= 0xbf
}

// Decodes one rune at `i` with Go utf8.DecodeRune validity rules. Returns
// [codePoint, size], or [-1, 1] for an invalid or truncated sequence.
function decodeRune (b:Uint8Array, i:number):[number, number] {
    const b0 = b[i]
    if (b0 < 0x80) return [b0, 1]
    const b1 = b[i + 1]
    if (b0 >= 0xc2 && b0 <= 0xdf) {
        if (!isCont(b1)) return [-1, 1]
        return [((b0 & 0x1f) << 6) | (b1 & 0x3f), 2]
    }
    if (b0 >= 0xe0 && b0 <= 0xef) {
        const lo = b0 === 0xe0 ? 0xa0 : 0x80
        const hi = b0 === 0xed ? 0x9f : 0xbf
        if (b1 === undefined || b1 < lo || b1 > hi) return [-1, 1]
        const b2 = b[i + 2]
        if (!isCont(b2)) return [-1, 1]
        return [((b0 & 0x0f) << 12) | ((b1 & 0x3f) << 6) | (b2 & 0x3f), 3]
    }
    if (b0 >= 0xf0 && b0 <= 0xf4) {
        const lo = b0 === 0xf0 ? 0x90 : 0x80
        const hi = b0 === 0xf4 ? 0x8f : 0xbf
        if (b1 === undefined || b1 < lo || b1 > hi) return [-1, 1]
        const b2 = b[i + 2]
        const b3 = b[i + 3]
        if (!isCont(b2) || !isCont(b3)) return [-1, 1]
        return [((b0 & 0x07) << 18) | ((b1 & 0x3f) << 12) |
            ((b2 & 0x3f) << 6) | (b3 & 0x3f), 4]
    }
    return [-1, 1]
}

function byteUnits (b:Uint8Array):Unit[] {
    const units:Unit[] = []
    for (let i = 0; i < b.length;) {
        const [cp, size] = decodeRune(b, i)
        units.push(cp < 0 ? -(b[i] + 1) : cp)
        i += size
    }
    return units
}

// Multi-line sanitizing of a string.
export function text (s:string):string {
    if (isClean(s, false)) return s
    return escapeUnits(stringUnits(s), false)
}

// Single-line sanitizing of a string.
export function line (s:string):string {
    if (isClean(s, true)) return s
    return escapeUnits(stringUnits(s), true)
}

// Multi-line sanitizing of raw bytes, escaping each invalid UTF-8 byte.
export function textBytes (b:Uint8Array):string {
    return escapeUnits(byteUnits(b), false)
}

// Single-line sanitizing of raw bytes.
export function lineBytes (b:Uint8Array):string {
    return escapeUnits(byteUnits(b), true)
}
package cli

import (
	"bufio"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"sort"
	"time"

	"github.com/spf13/cobra"

	"github.com/bluesky-social/roast/internal/record"
	"github.com/bluesky-social/roast/internal/scope"
	"github.com/bluesky-social/roast/internal/snapshot"
	"github.com/bluesky-social/roast/internal/textsafe"
)

func newRunsCommand(stdout, stderr io.Writer) *cobra.Command {
	var limit int
	var rawJSON bool
	cmd := &cobra.Command{
		Use: "runs", Short: "Show and inspect local review runs", Args: noArgs,
		SilenceUsage: true, SilenceErrors: true,
		RunE: func(_ *cobra.Command, _ []string) error {
			dir := record.DefaultDir()
			if dir == "" {
				return &usageError{msg: "cannot resolve record directory: " +
					"run inside a Git repository"}
			}
			files, _ := filepath.Glob(filepath.Join(dir, "runs-*.jsonl"))
			sort.Strings(files)
			lines := tailRunLines(files, limit)
			if len(lines) == 0 {
				fmt.Fprintf(stderr, "roast: no run records in %s\n", dir)
				return nil
			}
			for _, line := range lines {
				if rawJSON {
					fmt.Fprintln(stdout, line)
					continue
				}
				var run struct {
					TS         string   `json:"ts"`
					RunID      string   `json:"run_id"`
					Repo       string   `json:"repo"`
					Mode       string   `json:"mode"`
					Assessment string   `json:"assessment"`
					Quick      bool     `json:"quick"`
					NFindings  int      `json:"n_findings"`
					NRefuted   int      `json:"n_refuted"`
					Files      []string `json:"files_reviewed"`
				}
				if err := json.Unmarshal([]byte(line), &run); err != nil {
					continue
				}
				fmt.Fprintf(stdout, "%s  %-25s %-8s q=%-5v %-30s findings=%d refuted=%d files=%d  %s\n",
					run.TS, run.RunID, run.Mode, run.Quick, run.Assessment,
					run.NFindings, run.NRefuted, len(run.Files), run.Repo)
			}
			return nil
		},
	}
	cmd.Flags().IntVar(&limit, "limit", 20, "maximum runs to show")
	cmd.Flags().BoolVar(&rawJSON, "json", false, "emit raw JSONL records")
	cmd.AddCommand(
		newRunsShowCommand(stdout), newRunsCheckoutCommand(stdout, stderr),
		newRunsPruneCommand(stdout, stderr),
	)
	return cmd
}

func tailRunLines(files []string, limit int) []string {
	var lines []string
	for _, path := range files {
		file, err := os.Open(path)
		if err != nil {
			continue
		}
		scanner := bufio.NewScanner(file)
		scanner.Buffer(make([]byte, 64*1024), 16*1024*1024)
		for scanner.Scan() {
			lines = append(lines, scanner.Text())
		}
		_ = file.Close()
	}
	if limit > 0 && len(lines) > limit {
		lines = lines[len(lines)-limit:]
	}
	return lines
}

func newRunsShowCommand(stdout io.Writer) *cobra.Command {
	return &cobra.Command{
		Use: "show <run-id>", Short: "Print a run's Markdown report", Args: usageArgs(cobra.ExactArgs(1)),
		SilenceUsage: true, SilenceErrors: true,
		RunE: func(_ *cobra.Command, args []string) error {
			path, err := record.ReportPath(args[0])
			if err != nil {
				return err
			}
			data, err := os.ReadFile(path)
			if err != nil {
				return fmt.Errorf("run has no report artifact: %w", err)
			}
			// Reports written before render escaped finding text can hold raw
			// control bytes from model output; escape on the way out too.
			_, err = io.WriteString(stdout, textsafe.Text(string(data)))
			return err
		},
	}
}

func newRunsCheckoutCommand(stdout, stderr io.Writer) *cobra.Command {
	return &cobra.Command{
		Use: "checkout <run-id> [dir]", Short: "Materialize a run snapshot into a linked worktree",
		Args: usageArgs(cobra.RangeArgs(1, 2)), SilenceUsage: true, SilenceErrors: true,
		RunE: func(_ *cobra.Command, args []string) error {
			meta, _, err := record.ReadMeta(args[0])
			if err != nil {
				return &usageError{msg: err.Error()}
			}
			if !meta.Snapshot.Captured {
				return &usageError{msg: fmt.Sprintf("run %s has no Git snapshot (%s)", meta.RunID, meta.Snapshot.Reason)}
			}
			dest := ""
			if len(args) == 2 {
				dest = args[1]
			} else {
				base, err := os.MkdirTemp("", "roast-checkout-")
				if err != nil {
					return err
				}
				dest = filepath.Join(base, meta.RunID)
			}
			if _, err := snapshot.Restore(meta.Repo, meta.RunID, dest); err != nil {
				return fmt.Errorf("restore run %s: %w", meta.RunID, err)
			}
			fmt.Fprintf(stderr, "roast: remove with: git -C %s worktree remove --force %s\n", meta.Repo, dest)
			fmt.Fprintln(stdout, dest)
			return nil
		},
	}
}

func newRunsPruneCommand(stdout, stderr io.Writer) *cobra.Command {
	var olderThan time.Duration
	var dryRun bool
	cmd := &cobra.Command{
		Use: "prune", Short: "Delete aged Roast snapshot refs from the current repository", Args: noArgs,
		SilenceUsage: true, SilenceErrors: true,
		RunE: func(_ *cobra.Command, _ []string) error {
			repo, err := scope.GitRoot(".")
			if err != nil {
				return &usageError{msg: err.Error()}
			}
			items, err := snapshot.Prune(repo, olderThan, dryRun)
			if err != nil {
				return err
			}
			if len(items) == 0 {
				fmt.Fprintf(stderr, "roast: no snapshot refs older than %s\n", olderThan)
			}
			for _, item := range items {
				verb := "deleted"
				if dryRun {
					verb = "would delete"
				}
				fmt.Fprintf(stdout, "%s %s (age %s)\n", verb, item.Ref, item.Age.Round(time.Hour))
			}
			return nil
		},
	}
	cmd.Flags().DurationVar(&olderThan, "older-than", snapshot.DefaultRefRetention, "delete refs older than this")
	cmd.Flags().BoolVar(&dryRun, "dry-run", false, "list refs without deleting them")
	return cmd
}

