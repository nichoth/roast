+// pattern: Functional Core
+
+function pad (s:string, width:number):string {
+    return s + ' '.repeat(Math.max(0, width - Array.from(s).length))
+}
+
+function stringField (run:Record<string, unknown>, key:string):string {
+    const value = run[key]
+    if (value == null) return ''
+    if (typeof value !== 'string') throw new Error('expected string')
+    return value
+}
+
+function integerField (run:Record<string, unknown>, key:string):bigint {
+    const value = run[key]
+    if (value == null) return 0n
+    if (typeof value !== 'bigint') throw new Error('expected integer')
+    return value
+}
+
+// Number lexemes must fit Go's signed int64; retain exact large counts.
+function decodeNumber (
+    _key:string,
+    value:unknown,
+    context?:{ source?:string }
+):unknown {
+    if (typeof value !== 'number') return value
+    const source = context?.source ?? ''
+    if (!/^-?\d+$/.test(source)) return value
+    const integer = BigInt(source)
+    return integer >= -(2n ** 63n) && integer < 2n ** 63n ? integer : value
+}
+
+// The index is best effort: malformed lines disappear only in text mode.
+export function formatRunLine (line:string):string|null {
+    try {
+        const raw:unknown = JSON.parse(line, decodeNumber)
+        if (raw !== null && (typeof raw !== 'object' ||
+            Array.isArray(raw))) return null
+        const run = (raw ?? {}) as Record<string, unknown>
+        const ts = stringField(run, 'ts')
+        const id = stringField(run, 'run_id')
+        const mode = stringField(run, 'mode')
+        const assessment = stringField(run, 'assessment')
+        const repo = stringField(run, 'repo')
+        const quick = run.quick ?? false
+        if (typeof quick !== 'boolean') return null
+        const files = run.files_reviewed ?? []
+        if (!Array.isArray(files) || files.some(v =>
+            v !== null && typeof v !== 'string')) return null
+        return `${ts}  ${pad(id, 25)} ${pad(mode, 8)} ` +
+            `q=${pad(String(quick), 5)} ${pad(assessment, 30)} ` +
+            `findings=${integerField(run, 'n_findings')} ` +
+            `refuted=${integerField(run, 'n_refuted')} ` +
+            `files=${files.length}  ${repo}\n`
+    } catch { return null }
+}
