// Go-compatible ustar tar writer and reader with PAX path records.
// writeTar produces byte-identical output to Go's archive/tar for the same inputs.

const BLOCK_SIZE = 512
const MAX_FILE_SIZE = 8 * 1024 * 1024 * 1024 // 8 GiB

// Header offsets (Go archive/tar layout).
const OFF_MODE = 100
const OFF_UID = 108
const OFF_GID = 116
const OFF_SIZE = 124
const OFF_MTIME = 136
const OFF_CHKSUM = 148

// Magic and version.
const USTAR_MAGIC = 'ustar\0'
const USTAR_VERSION = '00'

/** One file ready to be written into a tar stream. */
export interface TarFile {
    name:string
    data:Uint8Array
}

/** One parsed entry from a tar stream. */
export interface TarEntry {
    name:string
    typeflag:string
    size:number
    data:Uint8Array
}

// Zero block for EOF markers.
const ZERO_BLOCK = Buffer.alloc(BLOCK_SIZE, 0)

// === Writer ==================================================================

/** Write a tar archive from an array of files. Returns the complete bytes. */
export function writeTar (files:TarFile[]):Buffer {
    const parts:Buffer[] = []

    for (const file of files) {
        // Check size limit (8 GiB throws).
        if (file.data.length >= MAX_FILE_SIZE) {
            throw new Error(
                `file ${file.name}: cannot archive files ≥ 8 GiB`
            )
        }

        // Check if the name needs a PAX path record.
        const needsPax = !isUstarName(file.name)

        if (needsPax) {
            // Write a PAX extended header before this file.
            const paxBytes = buildPaxExtendedHeader(file.name, 'path')
            parts.push(paxBytes)
        }

        // Write the file's own ustar header block.
        const hdr = Buffer.alloc(BLOCK_SIZE, 0)
        writeUstarHeader(hdr, file)
        parts.push(hdr)

        // Write the file data, zero-padded to a multiple of BLOCK_SIZE.
        const dataBuf = Buffer.from(file.data)
        parts.push(dataBuf)
        const paddedLen = padToBlock(dataBuf.length)
        if (paddedLen > dataBuf.length) {
            parts.push(Buffer.alloc(paddedLen - dataBuf.length, 0))
        }
    }

    // Two zero blocks mark the end of the archive.
    parts.push(ZERO_BLOCK, ZERO_BLOCK)

    const totalLen = parts.reduce((sum:number, b:Buffer) => sum + b.length, 0)
    const result = Buffer.alloc(totalLen)
    let offset = 0
    for (const part of parts) {
        result.set(part, offset)
        offset += part.length
    }

    return result
}

// Check if a name fits in the ustar 100-byte ASCII-only field.
function isUstarName (name:string):boolean {
    let length = 0
    for (let i = 0; i < name.length; i++) {
        const cp = name.charCodeAt(i)
        if (cp >= 0x80) return false // non-ASCII
        if (length >= 100) return false // too long
        length++
    }
    return true
}

// Write a ustar header into a pre-allocated block.
function writeUstarHeader (buf:Buffer, file:TarFile):void {
    buf.fill(0)

    // Name: ASCII-only, up to 100 bytes (non-ASCII bytes dropped).
    const truncated = truncateUstarName(file.name)
    for (let i = 0; i < truncated.length && i < 100; i++) {
        buf[i] = truncated.charCodeAt(i) & 0xff
    }

    // Mode: "0000600\0"
    writeOctal(buf, OFF_MODE, '0000600')

    // UID/GID: "0000000\0"
    writeOctal(buf, OFF_UID, '0000000')
    writeOctal(buf, OFF_GID, '0000000')

    // Size: 11 zero-padded octal digits + '\0'
    writeSize(buf, file.data.length)

    // Mtime: "00000000000\0" (epoch zero)
    writeOctal(buf, OFF_MTIME, '00000000000')

    // Typeflag: '0' (regular file)
    buf[156] = 0x30

    // Linkname: all NUL (already filled)

    // Magic + version
    writeAscii(buf, 257, USTAR_MAGIC)
    writeAscii(buf, 263, USTAR_VERSION)

    // Checksum: compute with chksum field as 8 spaces, then write.
    for (let i = OFF_CHKSUM; i < OFF_CHKSUM + 8; i++) buf[i] = 0x20
    const checksum = computeChecksum(buf)
    writeOctal(buf, OFF_CHKSUM, String(checksum).padStart(6, '0'))
}

// Compute the unsigned sum of all 512 header bytes when the chksum field is
// read as eight spaces.
function computeChecksum (buf:Buffer):number {
    let sum = 0
    for (let i = 0; i < OFF_CHKSUM; i++) sum += buf[i]
    for (let i = OFF_CHKSUM + 8; i < BLOCK_SIZE; i++) sum += buf[i]
    return sum
}

function writeOctal (buf:Buffer, offset:number, value:string):void {
    const padWidth = 8
    const padded = value.padStart(padWidth, '0')
    for (let i = 0; i < Math.min(padded.length, buf.length - offset); i++) {
        buf[offset + i] = padded.charCodeAt(i)
    }
}

function writeSize (buf:Buffer, size:number):void {
    const octal = Math.trunc(size).toString(8).padStart(11, '0')
    for (let i = 0; i < 11; i++) buf[OFF_SIZE + i] = octal.charCodeAt(i)
}

function writeAscii (buf:Buffer, offset:number, value:string):void {
    for (let i = 0; i < value.length; i++) {
        buf[offset + i] = value.charCodeAt(i)
    }
}

function truncateUstarName (name:string):string {
    let out = ''
    for (let i = 0; i < name.length && out.length < 100; i++) {
        const cp = name.charCodeAt(i)
        if (cp < 0x80) out += name[i]
    }
    return out
}

function padToBlock (len:number):number {
    const mod = len % BLOCK_SIZE
    return mod === 0 ? len : len + (BLOCK_SIZE - mod)
}

// === PAX records =============================================================

/** Compute the byte length of a PAX record including its self-describing length. */
function computePaxRecordLength (rest:string):number {
    const restBytes = Buffer.byteLength(rest, 'utf-8')
    // Find N such that str(N).length + restBytes === N.
    for (let n = 1; n < 2_000_000; n++) {
        if (String(n).length + restBytes === n) return n
    }
    throw new Error('cannot compute PAX record length')
}

// Build the raw bytes of a PAX extended header: the name header block,
// then the records block with zero padding to 512.
function buildPaxExtendedHeader (name:string, key:string):Buffer {
    // The PAX entry name is PaxHeaders.0/<base>.
    const slashIdx = Math.max(name.lastIndexOf('/'), -1)
    const base = slashIdx >= 0 ? name.slice(slashIdx + 1) : name
    const paxName = `PaxHeaders.0/${base}`

    // Record text (without the length prefix).
    const record = ` ${key}=${name}\n`
    const len = computePaxRecordLength(record)

    // Build the header block for this PAX extended header entry.
    const hdr = Buffer.alloc(BLOCK_SIZE, 0)
    writeUstarHeader(hdr, { name:paxName, data:Buffer.from(String(len)) })

    // The size in the header is the record length (the records block).
    writeSize(hdr, len)

    // Build the full records block: the self-describing length + rest.
    const strLen = String(len)
    const recordBytes = Buffer.alloc(len)
    for (let i = 0; i < strLen.length; i++) {
        recordBytes[i] = strLen.charCodeAt(i)
    }
    const recordData = Buffer.from(record, 'utf-8')
    for (let i = 0; i < recordData.length; i++) {
        recordBytes[strLen.length + i] = recordData[i]
    }

    // Zero-pad the records block to a multiple of 512.
    const paddedLen = padToBlock(recordBytes.length)
    if (paddedLen > recordBytes.length) {
        const padding = Buffer.alloc(paddedLen - recordBytes.length, 0)
        return Buffer.concat([Buffer.concat([hdr, recordBytes]), padding])
    }

    return Buffer.concat([hdr, recordBytes])
}

// === Reader ==================================================================

/** Read a tar archive into an array of entries. */
export function readTar (archive:Uint8Array):TarEntry[] {
    const data = toBuffer(archive)
    const entries:TarEntry[] = []
    let offset = 0
    let nextIsPaxPath = false
    let paxName:string|null = null

    while (offset < data.length) {
        // Check for EOF marker.
        if (isZeroBlock(data, offset)) break

        const header = data.slice(offset, offset + BLOCK_SIZE)

        // Validate checksum (unsigned or signed).
        validateChecksum(header)

        // Parse fields.
        const nameStr = trimNull(headerSlice(header, 0, 100).toString('utf-8'))
        const typeflag = String.fromCharCode(header[156])
        const sizeStr = trimOctal(headerSlice(header, 124, 136))
        const prefixBuf = headerSlice(header, 345, 500)
        const magic = trimNull(headerSlice(header, 257, 263).toString('utf-8'))

        // Reconstruct the full name.
        let name = nameStr
        const prefixStr = trimNull(prefixBuf.toString())
        if (prefixStr && magic === 'ustar') {
            name = prefixStr + '/' + name
        }

        const size = parseInt(sizeStr, 8) || 0

        // Handle PAX extended headers.
        if (typeflag === 'x' || typeflag === 'X') {
            // Parse PAX records from the data.
            const paxData = parsePaxRecords(data, offset + BLOCK_SIZE, size)
            for (const [k, v] of Object.entries(paxData)) {
                if (k === 'path') {
                    nextIsPaxPath = true
                    paxName = v
                }
            }
            offset += BLOCK_SIZE + padToBlock(size)
            continue
        }

        // Handle PAX global extended headers.
        if (typeflag === 'g' || typeflag === 'G') {
            // Consume the data, ignore records.
            offset += BLOCK_SIZE + padToBlock(size)
            continue
        }

        // If a prior x entry set a path, use that.
        if (nextIsPaxPath && paxName !== null) {
            name = paxName
            nextIsPaxPath = false
            paxName = null
        }

        const dataStart = offset + BLOCK_SIZE
        const entryData = data.slice(dataStart, dataStart + size)

        entries.push({ name, typeflag, size, data:entryData })

        offset = dataStart + padToBlock(size)
    }

    return entries
}

function toBuffer (archive:Uint8Array):Buffer {
    if (archive instanceof Buffer) return archive
    return Buffer.from(archive)
}

function headerSlice (buf:Buffer, start:number, end:number):Buffer {
    return buf.slice(start, Math.min(end, buf.length))
}

function trimOctal (s:Buffer):string {
    let end = s.length
    while (end > 0 && s[end - 1] === 0) end--
    // Return the numeric part (trim trailing spaces too, as Go does).
    let start = 0
    while (start < end && s[start] === 32) start++
    return String.fromCharCode(...s.subarray(start, end))
}

function trimNull (s:string):string {
    const idx = s.indexOf('\0')
    return idx >= 0 ? s.slice(0, idx) : s
}

function isZeroBlock (data:Buffer, offset:number):boolean {
    for (let i = 0; i < BLOCK_SIZE; i++) {
        if (data[offset + i] !== 0) return false
    }
    return true
}

// Validate the checksum (accept unsigned or signed sum).
function validateChecksum (header:Buffer):void {
    // Compute unsigned sum with chksum as 8 spaces.
    let unsignedSum = 0
    for (let i = 0; i < OFF_CHKSUM; i++) unsignedSum += header[i]
    for (let i = OFF_CHKSUM + 8; i < BLOCK_SIZE; i++) unsignedSum += header[i]

    // For the signed sum, parse the chksum field as octal.
    const chksumSlice = trimOctal(headerSlice(header, OFF_CHKSUM, 8))
    let signedSum:number|undefined
    if (chksumSlice.length > 0) {
        try {
            signedSum = parseInt(chksumSlice, 8)
        } catch {
            signedSum = 0
        }
    }

    // Compute the signed checksum: unsigned sum minus the parsed value.
    if (typeof signedSum === 'number') {
        const adjustedSum = unsignedSum - signedSum
        if (signedSum !== 0 && Math.abs(signedSum) !== Math.abs(adjustedSum)) {
            throw new Error('tar: invalid checksum')
        }
    }
}

// Parse PAX records from a block of data. Returns key-value pairs.
function parsePaxRecords (data:Buffer, offset:number, size:number):Record<string, string> {
    const records:Record<string, string> = {}
    let pos = 0
    const maxPos = offset + padToBlock(size)

    while (pos < data.length && pos < maxPos) {
        // Find the first space to get the length.
        let endPos = pos
        while (endPos < data.length && data[endPos] !== 32 && endPos < maxPos) endPos++

        if (endPos >= maxPos) break

        const lenStr = trimNull(data.slice(pos, endPos).toString('ascii'))
        const recordLen = parseInt(lenStr, 10)
        if (isNaN(recordLen) || recordLen === 0 || recordLen > maxPos - endPos) {
            // Malformed; skip to next block boundary.
            break
        }

        // The record includes the length digits and everything after the space.
        const recordEnd = endPos + recordLen
        if (recordEnd > maxPos) break

        const recordText = trimNull(data.slice(endPos + 1, recordEnd).toString('utf-8'))

        // Parse key=value: find first '=' after the length.
        const eqIdx = recordText.indexOf('=')
        if (eqIdx < 0) {
            pos = Math.min(recordEnd, maxPos)
            continue
        }
        const key = recordText.slice(1, eqIdx) // skip leading space
        const value = recordText.slice(eqIdx + 1)

        if (key && key.length > 0) {
            records[key] = value
        }

        pos = Math.min(recordEnd, maxPos)
    }

    return records
}

// Also accept NUL typeflag as a regular file.
export const NULL_TYPEFLAG = '\x00'
test('readTar returns entries with correct typeflags', t => {
    const files:TarFile[] = [{ name:'f.txt', data:Buffer.from('x') }]
    const archive = writeTar(files)
    const entries = readTar(archive)

    t.equal(entries[0].typeflag, '0', 'typeflag is "0"')
})

test('readTar accepts NUL typeflag as regular file (legacy)', t => {
    // Build a minimal tar with a NUL typeflag at offset 156.
    const data = Buffer.from('x')
    const archive = writeTar([{ name:'nul.txt', data }])

    // Modify the typeflag to NUL (0x00).
    archive[156] = 0x00

    const entries = readTar(archive)
    t.equal(entries.length, 1, 'one entry')
    t.deepEqual(entries[0].data, data, 'data matches with NUL typeflag')
})

test('writeTar with long file name produces PAX path record', t => {
    const longName = 'a'.repeat(150) + '.txt'
    const files:TarFile[] = [{ name:longName, data:Buffer.from('long content') }]
    const archive = writeTar(files)

    // Decompress should not be needed; this tests the raw tar output.
    const entries = readTar(archive)
    t.equal(entries.length, 1, 'one entry')
    t.equal(entries[0].name, longName, 'full long name is preserved')
})

test('writeTar with non-ASCII file name produces PAX path record', t => {
    const files:TarFile[] = [{ name:'café.txt', data:Buffer.from('non-ascii\n') }]
    const archive = writeTar(files)

    const entries = readTar(archive)
    t.equal(entries.length, 1, 'one entry')
    t.equal(entries[0].name, 'café.txt', 'full non-ASCII name is preserved')
})

test('writeTar with multi-byte UTF-8 characters in PAX records', t => {
    const files:TarFile[] = [{ name:'日本語.txt', data:Buffer.from('japanese\n') }]
    const archive = writeTar(files)

    const entries = readTar(archive)
    t.equal(entries.length, 1, 'one entry')
    t.equal(entries[0].name, '日本語.txt', 'full multi-byte name is preserved')
})

test('writeTar with PAX path and file name produces correct record lengths', t => {
    const files:TarFile[] = [
        { name:'PaxHeaders.0/test.txt', data:Buffer.from('18 path café.txt\n') },
        { name:'test.txt', data:Buffer.from('content\n') },
    ]
    const archive = writeTar(files)

    // First entry is the PAX extended header (typeflag x).
    // Second entry is the actual file.
    const entries = readTar(archive)
    t.equal(entries.length, 2, 'two entries')
    t.equal(entries[0].name, 'PaxHeaders.0/test.txt', 'pax entry name')
    t.equal(entries[1].name, 'café.txt', 'actual file gets pax override')
})

test('readTar handles two zero blocks at end of archive', t => {
    const files:TarFile[] = [
        { name:'only.txt', data:Buffer.from('x') },
    ]
    const archive = writeTar(files)

    const entries = readTar(archive)
    t.equal(entries.length, 1, 'one entry from a properly terminated archive')
})

test('writeTar with empty data produces correct padding', t => {
