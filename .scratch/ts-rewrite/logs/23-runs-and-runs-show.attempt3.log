+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { recordRepo } from '../record/repo.js'
+import { runRoast } from '../helpers/run.js'
+import { tempDir } from '../helpers/repo.js'
+import { recordDir } from '../../src/record/dir.js'
+import { appendRunLine } from '../../src/record/index-file.js'
+import { report } from '../render/fixtures.js'
+import { writeReport } from '../../src/record/meta.js'
+
+test('runs without records succeeds without creating state', async t => {
+    const repo = recordRepo(t)
+    const got = await runRoast(['runs'], { cwd:repo.dir, env:repo.env })
+    t.equal(got.code, 0)
+    t.equal(got.stdout, '')
+    t.ok(got.stderr.length > 0)
+    t.ok(!(await fs.readdir(repo.dir)).includes('.roast'))
+})
+
+test('runs outside Git is a usage error', async t => {
+    const outside = tempDir()
+    t.cleanup(outside.remove)
+    const got = await runRoast(['runs', '--error-format', 'json'], {
+        cwd:outside.dir, env:outside.env,
+    })
+    t.equal(got.code, 2)
+    t.equal(got.stdout, '')
+    t.equal(JSON.parse(got.stderr).error_category, 'usage')
+})
+
+test('runs rejects removed commands and other positionals', async t => {
+    const repo = recordRepo(t)
+    for (const positional of ['sync', 'status', 'bogus', 'run-id']) {
+        const got = await runRoast(['runs', positional,
+            '--error-format', 'json'], { cwd:repo.dir, env:repo.env })
+        t.equal(got.code, 2, positional)
+        t.equal(got.stdout, '')
+        t.equal(JSON.parse(got.stderr).error_category, 'usage')
+    }
+})
+
+test('runs JSON tails raw lines across chronological months', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    // Create the newer month first to exercise chronological ordering.
+    await appendRunLine(dir, report({ runId:'newer' }), repo.dir, [],
+        new Date(2026, 10, 2))
+    await appendRunLine(dir, report({ runId:'older' }), repo.dir, [],
+        new Date(2026, 9, 2))
+    const newer = path.join(dir, 'runs-2026-11.jsonl')
+    const raw = await fs.readFile(newer, 'utf8')
+    await fs.appendFile(newer, '  invalid JSON  \n')
+    const got = await runRoast(['runs', '--json', '--limit', '2'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    t.equal(got.code, 0)
+    t.equal(got.stdout, raw + '  invalid JSON  \n')
+    t.equal(got.stderr, '')
+})
+
+test('runs formats parseable records and skips invalid fields', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    const id = 'r\ud83d\ude80'
+    await appendRunLine(dir, report({ runId:id }), repo.dir, [],
+        new Date(2026, 10, 2))
+    const file = path.join(dir, 'runs-2026-11.jsonl')
+    await fs.appendFile(file, [
+        'not JSON',
+        '{"run_id":"bad-quick","quick":"true"}',
+        '{"run_id":"bad-files","files_reviewed":[2]}',
+        '{"run_id":"fraction","n_findings":1.0}',
+        '{"run_id":"exponent","n_findings":1e3}',
+        '{"run_id":"overflow","n_refuted":9223372036854775808}',
+        '{"run_id":"large","n_findings":9007199254740993}',
+        '{"run_id":"legacy","Mode":"wrong-case","quick":null}',
+        '',
+    ].join('\n'))
+    const got = await runRoast(['runs'], { cwd:repo.dir, env:repo.env })
+    t.equal(got.code, 0)
+    const lines = got.stdout.trimEnd().split('\n')
+    t.equal(lines.length, 3)
+    t.ok(lines[0].includes(id))
+    t.equal(lines[0].indexOf('code') - lines[0].indexOf(id), 27,
+        '25 code point ID column and one separator')
+    t.ok(lines[0].includes('findings=1 refuted=0 files=0'))
+    t.ok(lines[0].endsWith(repo.dir))
+    t.ok(lines[1].includes('large'))
+    t.ok(lines[1].includes('9007199254740993'))
+    t.ok(lines[2].includes('legacy'))
+    t.ok(!lines[2].includes('wrong-case'))
+})
+
+test('runs nonpositive limits list all and default limits to 20', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    for (let i = 0; i < 23; i++) {
+        await appendRunLine(dir, report({ runId:`run-${i}` }), repo.dir,
+            [], new Date(2026, 10, 2))
+    }
+    for (const limit of ['0', '-1', '+0']) {
+        const got = await runRoast(['runs', '--json', '--limit', limit], {
+            cwd:repo.dir, env:repo.env,
+        })
+        t.equal(got.code, 0)
+        const lines = got.stdout.trimEnd().split('\n')
+        t.equal(lines.length, 23)
+        t.equal(JSON.parse(lines[0]).run_id, 'run-0')
+    }
+    const got = await runRoast(['runs', '--json'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    const lines = got.stdout.trimEnd().split('\n')
+    t.equal(got.code, 0)
+    t.equal(lines.length, 20)
+    t.equal(JSON.parse(lines[0]).run_id, 'run-3')
+})
+
+test('runs scans CRLF, empty and unterminated final lines', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    await appendRunLine(dir, report(), repo.dir, [], new Date(2026, 10, 2))
+    await fs.writeFile(path.join(dir, 'runs-2026-11.jsonl'),
+        'first\r\n\nsecond\r\r\nlast\r')
+    const got = await runRoast(['runs', '--json', '--limit', '0'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    t.equal(got.code, 0)
+    t.equal(got.stdout, 'first\n\nsecond\r\nlast\n')
+})
+
+test('runs show round-trips stored reports from a nested cwd', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    const markdown = '# Review\n\nFinding in `main.ts`.\nNo final newline.'
+    await writeReport(dir, '20261123-report', markdown)
+    const cwd = path.join(repo.dir, 'nested', 'deeper')
+    await fs.mkdir(cwd, { recursive:true })
+    for (const id of ['20261123-report', '20261123']) {
+        const got = await runRoast(['runs', 'show', id], {
+            cwd, env:repo.env,
+        })
+        t.equal(got.code, 0)
+        t.equal(got.stdout, markdown)
+        t.equal(got.stderr, '')
+    }
+})
+
+test('runs show escapes stored terminal controls and invalid bytes',
+    async t => {
+        const repo = recordRepo(t)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const file = await writeReport(dir, 'unsafe',
+            '# Review\n\x1b[31m\x07\u0085\u009b')
+        await fs.appendFile(file, Buffer.from([0x80, 0x9b, 0xff]))
+        const got = await runRoast(['runs', 'show', 'unsafe'], {
+            cwd:repo.dir, env:repo.env,
+        })
+        t.equal(got.code, 0)
+        t.ok(got.stdout.length > 0)
+        t.ok(!Array.from(got.stdout).some(ch => {
+            const n = ch.codePointAt(0)!
+            return n === 0x1b || n === 0x07 || (n >= 0x80 && n <= 0x9f)
+        }))
+        t.ok(!got.stdout.includes('\ufffd'))
+    })
