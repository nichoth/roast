index 0000000000000000000000000000000000000000..9f1e9c1313e40bcf4ae0418a0eec1343c010d4b5
--- /dev/null
+++ b/src/cli/runs.ts
@@ -0,0 +1,125 @@
+// pattern: Imperative Shell
+import fs from 'node:fs/promises'
+import { createReadStream } from 'node:fs'
+import path from 'node:path'
+import type { CommandArgs, CommandDef, RunContext } from './command.js'
+import { recordDir } from '../record/dir.js'
+import { reportPath } from '../record/meta.js'
+import { compareBytes } from '../gocompat/strings.js'
+import { UsageError } from './errors.js'
+import { formatRunLine } from './runs-format.js'
+import { textBytes } from '../textsafe/textsafe.js'
+
+async function readLines (file:string):Promise<Array<Buffer>> {
+    const lines:Array<Buffer> = []
+    const stream = createReadStream(file)
+    const max = 16 * 1024 * 1024
+    let pending = Buffer.alloc(0)
+    function append (line:Buffer):void {
+        lines.push(line.at(-1) === 13 ? line.subarray(0, -1) : line)
+    }
+    try {
+        for await (const chunk of stream) {
+            pending = Buffer.concat([pending, chunk])
+            let end:number
+            while ((end = pending.indexOf(10)) !== -1) {
+                if (end >= max) return lines
+                append(pending.subarray(0, end))
+                pending = pending.subarray(end + 1)
+            }
+            if (pending.length >= max) return lines
+        }
+        if (pending.length) append(pending)
+    } catch {
+        // Unreadable files do not hide records in later months.
+    } finally {
+        stream.destroy()
+    }
+    return lines
+}
+
+async function runsHandler (
+    args:CommandArgs,
+    ctx:RunContext
+):Promise<void> {
+    const rawLimit = String(args.limit)
+    if (!/^[+-]?\d+$/.test(rawLimit) ||
+        BigInt(rawLimit) < -(2n ** 63n) ||
+        BigInt(rawLimit) >= 2n ** 63n) {
+        throw new UsageError('invalid --limit: expected a decimal integer')
+    }
+    const limit = BigInt(rawLimit)
+    const dir = await recordDir(ctx.cwd, {
+        env:ctx.env, signal:ctx.signal,
+    })
+    if (!dir) {
+        throw new UsageError('cannot resolve record directory: ' +
+            'run inside a Git repository')
+    }
+    const files = (await fs.readdir(dir).catch(() => []))
+        .filter(name => name.startsWith('runs-') && name.endsWith('.jsonl'))
+        .sort(compareBytes)
+    let lines:Array<Buffer> = []
+    for (const file of files) {
+        for (const line of await readLines(path.join(dir, file))) {
+            lines.push(line)
+        }
+    }
+    if (limit > 0 && BigInt(lines.length) > limit) {
+        lines = lines.slice(-Number(limit))
+    }
+    if (!lines.length) {
+        ctx.stderr.write(`roast: no run records in ${dir}\n`)
+    }
+    for (const line of lines) {
+        if (args.json === true) {
+            ctx.stdout.write(line)
+            ctx.stdout.write('\n')
+        } else {
+            const formatted = formatRunLine(line.toString('utf8'))
+            if (formatted !== null) ctx.stdout.write(formatted)
+        }
+    }
+}
+
+export const runsCommand:CommandDef = {
+    command:'runs',
+    describe:'Show and inspect local review runs',
+    builder:y => y
+        .option('limit', {
+            type:'string',
+            default:'20',
+            global:false,
+            describe:'maximum runs to show',
+        })
+        .option('json', {
+            type:'boolean',
+            default:false,
+            global:false,
+            describe:'emit raw JSONL records',
+        }),
+    handler:runsHandler,
+    subcommands:[
+        {
+            command:'show <run-id>',
+            describe:"Print a run's Markdown report",
+            builder:y => y.positional('run-id', { type:'string' }),
+            handler:async (args, ctx) => {
+                const dir = await recordDir(ctx.cwd, {
+                    env:ctx.env, signal:ctx.signal,
+                })
+                const file = await reportPath(dir, String(args['run-id']))
+                let content:Buffer
+                try {
+                    content = await fs.readFile(file)
+                } catch (err) {
+                    const msg = err instanceof Error ?
+                        err.message : String(err)
+                    throw new Error(`run has no report artifact: ${msg}`,
+                        { cause:err })
+                }
+                ctx.stdout.write(textBytes(content))
+            },
+        },
+    ],
+}
