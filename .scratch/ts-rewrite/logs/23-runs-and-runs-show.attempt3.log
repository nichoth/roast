package cli

import (
	"bufio"
	"encoding/json"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"sort"
	"time"

	"github.com/spf13/cobra"

	"github.com/bluesky-social/roast/internal/record"
	"github.com/bluesky-social/roast/internal/scope"
	"github.com/bluesky-social/roast/internal/snapshot"
	"github.com/bluesky-social/roast/internal/textsafe"
)

func newRunsCommand(stdout, stderr io.Writer) *cobra.Command {
	var limit int
	var rawJSON bool
	cmd := &cobra.Command{
		Use: "runs", Short: "Show and inspect local review runs", Args: noArgs,
		SilenceUsage: true, SilenceErrors: true,
		RunE: func(_ *cobra.Command, _ []string) error {
			dir := record.DefaultDir()
			if dir == "" {
				return &usageError{msg: "cannot resolve record directory: " +
					"run inside a Git repository"}
			}
			files, _ := filepath.Glob(filepath.Join(dir, "runs-*.jsonl"))
			sort.Strings(files)
			lines := tailRunLines(files, limit)
			if len(lines) == 0 {
				fmt.Fprintf(stderr, "roast: no run records in %s\n", dir)
				return nil
			}
			for _, line := range lines {
				if rawJSON {
					fmt.Fprintln(stdout, line)
					continue
				}
				var run struct {
					TS         string   `json:"ts"`
					RunID      string   `json:"run_id"`
					Repo       string   `json:"repo"`
					Mode       string   `json:"mode"`
					Assessment string   `json:"assessment"`
					Quick      bool     `json:"quick"`
					NFindings  int      `json:"n_findings"`
					NRefuted   int      `json:"n_refuted"`
					Files      []string `json:"files_reviewed"`
				}
				if err := json.Unmarshal([]byte(line), &run); err != nil {
					continue
				}
				fmt.Fprintf(stdout, "%s  %-25s %-8s q=%-5v %-30s findings=%d refuted=%d files=%d  %s\n",
					run.TS, run.RunID, run.Mode, run.Quick, run.Assessment,
					run.NFindings, run.NRefuted, len(run.Files), run.Repo)
			}
			return nil
		},
	}
	cmd.Flags().IntVar(&limit, "limit", 20, "maximum runs to show")
	cmd.Flags().BoolVar(&rawJSON, "json", false, "emit raw JSONL records")
	cmd.AddCommand(
		newRunsShowCommand(stdout), newRunsCheckoutCommand(stdout, stderr),
		newRunsPruneCommand(stdout, stderr),
	)
	return cmd
}

func tailRunLines(files []string, limit int) []string {
	var lines []string
	for _, path := range files {
		file, err := os.Open(path)
		if err != nil {
			continue
		}
		scanner := bufio.NewScanner(file)
		scanner.Buffer(make([]byte, 64*1024), 16*1024*1024)
		for scanner.Scan() {
			lines = append(lines, scanner.Text())
		}
		_ = file.Close()
	}
	if limit > 0 && len(lines) > limit {
		lines = lines[len(lines)-limit:]
	}
	return lines
}

func newRunsShowCommand(stdout io.Writer) *cobra.Command {
	return &cobra.Command{
		Use: "show <run-id>", Short: "Print a run's Markdown report", Args: usageArgs(cobra.ExactArgs(1)),
		SilenceUsage: true, SilenceErrors: true,
		RunE: func(_ *cobra.Command, args []string) error {
			path, err := record.ReportPath(args[0])
			if err != nil {
				return err
			}
			data, err := os.ReadFile(path)
			if err != nil {
				return fmt.Errorf("run has no report artifact: %w", err)
			}
			// Reports written before render escaped finding text can hold raw
			// control bytes from model output; escape on the way out too.
			_, err = io.WriteString(stdout, textsafe.Text(string(data)))
			return err
		},
	}
}

func newRunsCheckoutCommand(stdout, stderr io.Writer) *cobra.Command {
	return &cobra.Command{
		Use: "checkout <run-id> [dir]", Short: "Materialize a run snapshot into a linked worktree",
		Args: usageArgs(cobra.RangeArgs(1, 2)), SilenceUsage: true, SilenceErrors: true,
		RunE: func(_ *cobra.Command, args []string) error {
			meta, _, err := record.ReadMeta(args[0])
			if err != nil {
				return &usageError{msg: err.Error()}
			}
			if !meta.Snapshot.Captured {
				return &usageError{msg: fmt.Sprintf("run %s has no Git snapshot (%s)", meta.RunID, meta.Snapshot.Reason)}
			}
			dest := ""
			if len(args) == 2 {
				dest = args[1]
			} else {
				base, err := os.MkdirTemp("", "roast-checkout-")
				if err != nil {
					return err
				}
				dest = filepath.Join(base, meta.RunID)
			}
			if _, err := snapshot.Restore(meta.Repo, meta.RunID, dest); err != nil {
				return fmt.Errorf("restore run %s: %w", meta.RunID, err)
			}
			fmt.Fprintf(stderr, "roast: remove with: git -C %s worktree remove --force %s\n", meta.Repo, dest)
			fmt.Fprintln(stdout, dest)
			return nil
		},
	}
}

func newRunsPruneCommand(stdout, stderr io.Writer) *cobra.Command {
	var olderThan time.Duration
	var dryRun bool
	cmd := &cobra.Command{
		Use: "prune", Short: "Delete aged Roast snapshot refs from the current repository", Args: noArgs,
		SilenceUsage: true, SilenceErrors: true,
		RunE: func(_ *cobra.Command, _ []string) error {
			repo, err := scope.GitRoot(".")
			if err != nil {
				return &usageError{msg: err.Error()}
			}
			items, err := snapshot.Prune(repo, olderThan, dryRun)
			if err != nil {
				return err
			}
			if len(items) == 0 {
				fmt.Fprintf(stderr, "roast: no snapshot refs older than %s\n", olderThan)
			}
			for _, item := range items {
				verb := "deleted"
				if dryRun {
					verb = "would delete"
				}
				fmt.Fprintf(stdout, "%s %s (age %s)\n", verb, item.Ref, item.Age.Round(time.Hour))
			}
			return nil
		},
	}
	cmd.Flags().DurationVar(&olderThan, "older-than", snapshot.DefaultRefRetention, "delete refs older than this")
	cmd.Flags().BoolVar(&dryRun, "dry-run", false, "list refs without deleting them")
	return cmd
}
// `roast ignore` (spec 12, 2.13): adds the run-record state directory to
// the toplevel .gitignore. `init` reuses ensureStateIgnored.
import fs from 'node:fs/promises'
import path from 'node:path'
import { gitRoot } from '../git/git.js'
import { goTrimSpace } from '../gocompat/strings.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'

// Roast's project-local state directory at the Git toplevel.
const STATE_DIR = '.roast'

export const STATE_IGNORE_ENTRY = `/${STATE_DIR}/`

// Lines that already ignore the toplevel state directory.
const EQUIVALENT = new Set([
    `/${STATE_DIR}/`, `/${STATE_DIR}`, `${STATE_DIR}/`, STATE_DIR,
])

function fail (text:string, err:unknown):Error {
    const msg = err instanceof Error ? err.message : String(err)
    return new Error(`${text}: ${msg}`, { cause:err })
}

// Appends STATE_IGNORE_ENTRY to <repo>/.gitignore unless an equivalent
// line is present, creating the file and terminating an unterminated last
// line first. Reports the path and whether the file changed.
export async function ensureStateIgnored (
    repo:string
):Promise<{ path:string, added:boolean }> {
    const file = path.join(repo, '.gitignore')
    let data = Buffer.alloc(0)
    try {
        data = await fs.readFile(file)
    } catch (err) {
        if ((err as NodeJS.ErrnoException).code !== 'ENOENT') {
            throw fail(`read ${file}`, err)
        }
    }
    const lines = data.toString('utf8').split('\n')
    if (lines.some(line => EQUIVALENT.has(goTrimSpace(line)))) {
        return { path:file, added:false }
    }
    let addition = `${STATE_IGNORE_ENTRY}\n`
    if (data.length > 0 && data[data.length - 1] !== 0x0a) {
        addition = '\n' + addition
    }
    let handle:fs.FileHandle
    try {
        handle = await fs.open(file, 'a', 0o644)
    } catch (err) {
        throw fail(`open ${file}`, err)
    }
    try {
        await handle.write(addition)
    } catch (err) {
        await handle.close().catch(() => {})
        throw fail(`append ${file}`, err)
    }
    try {
        await handle.close()
    } catch (err) {
        throw fail(`close ${file}`, err)
    }
    return { path:file, added:true }
}

async function ignoreHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    let repo:string
    try {
        repo = await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        const msg = err instanceof Error ? err.message : String(err)
        throw new UsageError(msg, { cause:err })
    }
    const { path:file, added } = await ensureStateIgnored(repo)
    ctx.stdout.write(added ?
        `added ${STATE_IGNORE_ENTRY} to ${file}\n` :
        `${file} already ignores ${STATE_IGNORE_ENTRY}\n`)
}

export const ignoreCommand:CommandDef = {
    command:'ignore',
    describe:`Add ${STATE_IGNORE_ENTRY} to the toplevel .gitignore`,
    handler:ignoreHandler,
}
// `roast skill install|status`: install or inspect the bundled agent skill
// in the project's or the user's agent skill directories.
import type { Argv } from 'yargs'
import { gitRoot } from '../git/git.js'
import {
    inspect,
    install,
    installationTargets,
    type InstallationTarget,
    type SkillStatus,
} from '../skill/skill.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'

// Where skill commands operate: --dir wins, then --global selects the
// user-level directories, and otherwise the project's agent skill
// directories at the Git toplevel.
export async function skillTargets (
    dir:string,
    global:boolean,
    ctx:RunContext
):Promise<InstallationTarget[]> {
    const opts = { env:ctx.env }
    if (dir || global) return installationTargets(dir, '', opts)
    let root:string
    try {
        root = await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        const msg = err instanceof Error ? err.message : String(err)
        throw new UsageError(
            `${msg}; run inside a project or pass --global`, { cause:err })
    }
    return installationTargets('', root, opts)
}

function stringFlag (args:CommandArgs, name:string):string {
    const v = args[name]
    return typeof v === 'string' ? v : ''
}

function flagsFor (args:CommandArgs):{ dir:string, global:boolean } {
    return { dir:stringFlag(args, 'dir'), global:args.global === true }
}

async function installHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const { dir, global } = flagsFor(args)
    const force = args.force === true
    const targets = await skillTargets(dir, global, ctx)
    const before:SkillStatus[] = []
    for (const target of targets) {
        const status = await inspect(target.path)
        if (status.state === 'stale' && !force) {
            throw new Error(`${target.harness} skill files differ (${
                status.stale.join(', ')}); re-run with --force to overwrite`)
        }
        before.push(status)
    }
    for (const [i, target] of targets.entries()) {
        const after = await install(target.path, force)
        const prior = before[i].state
        const what = prior === 'symlink' ?
            'symlink (development install), left unchanged' :
            prior === 'up_to_date' ?
                'already up to date' :
                `installed (${after.state})`
        ctx.stdout.write(`${target.harness}\t${what}\t${target.path}\n`)
    }
}

async function statusHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const { dir, global } = flagsFor(args)
    for (const target of await skillTargets(dir, global, ctx)) {
        const status = await inspect(target.path)
        let line = `${target.harness}\t${status.state}\t${status.path}`
        if (status.stale.length > 0) line += `\t${status.stale.join(',')}`
        ctx.stdout.write(line + '\n')
    }
}

export const skillCommand:CommandDef = {
    command:'skill',
    describe:'Manage the Roast agent skill',
    subcommands:[
        {
            command:'install',
            describe:'Install the Roast agent skill',
            builder:(y:Argv) => y
                .option('dir', {
                    type:'string',
                    describe:'install only below this parent skills ' +
                        'directory; /roast is appended',
                })
                .option('global', {
                    type:'boolean',
                    describe:'install into the user-level skill ' +
                        'directories instead of the project',
                })
                .option('force', {
                    type:'boolean',
                    describe:'overwrite installed skill files that differ',
                }),
            handler:installHandler,
        },
        {
            command:'status',
            describe:'Report the Roast agent skill installation status',
            builder:(y:Argv) => y
                .option('global', {
                    type:'boolean',
                    describe:'inspect the user-level skill directories ' +
                        'instead of the project',
                })
                .option('dir', {
                    type:'string',
                    describe:'inspect only below this parent skills ' +
                        'directory; /roast is appended',
                }),
            handler:statusHandler,
        },
    ],
}
