// touches the real terminal, and never calls process.exit, so tests drive
// it in-process. It parses argv with yargs, runs the selected command,
// writes any error to io.stderr, and returns the exit code.
import yargs, { type Argv } from 'yargs'
import { Parser } from 'yargs/helpers'
import { buildInfo, formatBuildInfo } from '../buildinfo.js'
import {
    type CommandArgs,
    type CommandDef,
    type RunContext,
    registeredCommands,
} from './command.js'
import { builtinCommands } from './commands.js'
import {
    type ErrorFormat,
    UsageError,
    exitCode,
    writeError,
} from './errors.js'
import { LineReader } from './terminal.js'

export interface CliIO {
    stdin:NodeJS.ReadableStream;
    stdout:NodeJS.WritableStream;
    stderr:NodeJS.WritableStream;
    env:Readonly<Record<string, string|undefined>>;
    cwd:string;
    signal?:AbortSignal;
    fetch?:typeof globalThis.fetch;
}

export interface RunResult {
    code:number;
    error?:Error;
}

const PARSER_CONFIGURATION = {
    'boolean-negation':false, // --no-verify is a real flag
    'camel-case-expansion':false,
    'dot-notation':false,
    'parse-numbers':false, // integers are parsed by our own helper
    'parse-positional-numbers':false,
    'duplicate-arguments-array':false, // scalar flags: last wins
    'strip-aliased':true,
}

const ERROR_FORMATS:readonly string[] = ['text', 'json']

interface Selected {
    def:CommandDef;
    args:CommandArgs;
    path:string[];
}

function commandNames (def:CommandDef):string[] {
    const cmds = typeof def.command === 'string' ?
        [def.command] :
        [...def.command]
    return cmds.map(c => c.split(' ')[0])
}

// Registers `def` (and its subcommands) on `y`. The yargs handler only
// records the selection; run() calls the real handler after parsing, so
// parse errors and command errors stay apart.
function addCommand (
    y:Argv,
    def:CommandDef,
    parent:string[],
    select:(s:Selected) => void
):Argv {
    const names = commandNames(def)
    const name = names.find(n => n !== '$0') ?? '$0'
    return y.command(
        def.command as string|string[],
        def.describe as string,
        sub => {
            let b = def.builder ? def.builder(sub) : sub
            for (const child of def.subcommands ?? []) {
                b = addCommand(b, child, [...parent, name], select)
            }
            return b
        },
        args => {
            // A default command matched without its name in argv.
            const named = args._[parent.length] === name
            const path = named ? [...parent, name] : parent
            select({ def, args:args as CommandArgs, path })
        }
    )
}

function parser (select:(s:Selected) => void):Argv {
    let y:Argv = yargs()
        .scriptName('roast')
        .locale('en')
        .detectLocale(false) // English only, whatever LANG/LC_ALL say
        .parserConfiguration(PARSER_CONFIGURATION)
        .strict()
        .exitProcess(false)
        .showHelpOnFail(false)
        .fail((msg, err) => {
            throw new UsageError(msg ?? err?.message ?? 'invalid usage',
                { cause:err })
        })
        .usage('$0 [command] [flags]\n\nAdversarial cross-model code ' +
            'review. A finder proposes potential defects, then an ' +
            'independent verifier adjudicates each claim against the ' +
            'local checkout.')
        .option('error-format', {
            type:'string',
            default:'text',
            global:true,
            describe:'Error output format (text|json)',
        })
        .version(false) // root-only --version / -v is handled in run
        .option('version', {
            alias:'v',
            type:'boolean',
            global:false,
            describe:'Print the version and exit',
        })
        .help('help')
        .alias('help', 'h')
    for (const def of [...builtinCommands, ...registeredCommands()]) {
        y = addCommand(y, def, [], select)
    }
    return y
}

// Parses argv. Resolves with the selected command, or with help output
// when --help was given.
async function parse (
    argv:string[]
):Promise<{ selected?:Selected, output:string }> {
    let selected:Selected|undefined
    let output = ''
    await parser(s => { selected = s }).parseAsync(argv, {},
        (_err, _args, out) => { output = out ?? '' })
    return { selected, output }
}

async function helpFor (path:string[]):Promise<string> {
    const { output } = await parse([...path, '--help'])
    return output.endsWith('\n') ? output : `${output}\n`
}

// The --error-format yargs would parse from argv, for reporting a parse
// failure; text when absent or invalid.
function parsedErrorFormat (argv:string[]):ErrorFormat {
    const parsed = Parser(argv, {
        string:['error-format'],
        configuration:PARSER_CONFIGURATION,
    })
    const v = parsed['error-format']
    return v === 'json' ? 'json' : 'text'
}

// A root-level flag is one that no subcommand token precedes.
function hasRootFlag (argv:string[], names:string[]):boolean {
    for (let i = 0; i < argv.length; i++) {
        const arg = argv[i]
        if (arg === '--' || !arg.startsWith('-')) return false
        if (names.includes(arg)) return true
        if (arg === '--error-format') i++ // skip its value
    }
    return false
}

function toError (e:unknown):Error {
    return e instanceof Error ? e : new Error(String(e))
}

export async function run (argv:string[], io:CliIO):Promise<RunResult> {
    const signal = io.signal ?? new AbortController().signal
    let format:ErrorFormat = 'text'
    try {
        if (hasRootFlag(argv, ['--version', '-v'])) {
            io.stdout.write(
                `roast version ${formatBuildInfo(buildInfo)}\n`)
            return { code:0 }
        }
        let parsed:Awaited<ReturnType<typeof parse>>
        try {
            parsed = await parse(argv)
        } catch (err) {
            format = parsedErrorFormat(argv)
            throw err
        }
        const { selected, output } = parsed
        if (!selected) {
            // --help (or a yargs-handled path with nothing to run).
            if (output) {
                io.stdout.write(output.endsWith('\n') ?
                    output :
                    `${output}\n`)
            }
            return { code:0 }
        }
        const errorFormat = String(selected.args['error-format'])
        if (!ERROR_FORMATS.includes(errorFormat)) {
            throw new UsageError(
                `invalid --error-format ${JSON.stringify(errorFormat)} ` +
                '(text|json)')
        }
        format = errorFormat as ErrorFormat
        const extra = selected.args._.slice(selected.path.length)
        if (extra.length > 0) {
            throw new UsageError(
                `unexpected argument ${JSON.stringify(String(extra[0]))}`)
        }
        const ctx:RunContext = {
            stdin:io.stdin,
            stdout:io.stdout,
            stderr:io.stderr,
            env:io.env,
            cwd:io.cwd,
            signal,
            fetch:io.fetch ?? globalThis.fetch,
            lines:new LineReader(io.stdin),
            errorFormat:format,
            path:selected.path,
            rootHelp:() => helpFor([]),
        }
        const { def } = selected
        if (def.handler) {
            await def.handler(selected.args, ctx)
        } else {
            io.stdout.write(await helpFor(selected.path))
        }
        return { code:0 }
    } catch (e) {
        const error = toError(e)
        const code = exitCode(error, signal)
        writeError(io.stderr, code, error, format, signal)
        return { code, error }
    }
}
// Exit codes, error categories, and error output (spec 01, 2.2 to 2.4).
import { LlmError } from '../llm/errors.js'
import { text } from '../textsafe/textsafe.js'

export const ExitCode = {
    Clean:0,
    Findings:1,
    Usage:2,
    Auth:3,
    Partial:4,
    Cancelled:5,
} as const

export type ErrorCategory = 'none'|'findings'|'usage'|'auth'|'endpoint'|
    'resource_limit'|'partial'|'cancelled'

export type ErrorFormat = 'text'|'json'

// A bad flag, command, config, or anything else the user must fix.
export class UsageError extends Error {
    constructor (message:string, options?:ErrorOptions) {
        super(message, options)
        this.name = 'UsageError'
    }
}

// The run was cancelled (first SIGINT/SIGTERM, Ctrl-C at a prompt).
export class CancelledError extends Error {
    constructor (message = 'cancelled', options?:ErrorOptions) {
        super(message, options)
        this.name = 'CancelledError'
    }
}

// A successful command asking for a non-zero exit with nothing printed
// (Go gateExit): 1 for gating findings, 4 for a partial review.
export class ExitSignal extends Error {
    readonly code:1|4

    constructor (code:1|4) {
        super(`exit ${code}`)
        this.code = code
        this.name = 'ExitSignal'
    }
}

// Walks err, err.cause, ... and reports whether any link passes `test`.
// Stops on a cycle or at the first non-Error.
export function errorChainHas (
    err:unknown,
    test:(e:Error) => boolean
):boolean {
    const seen = new Set<unknown>()
    let cur = err
    while (cur instanceof Error && !seen.has(cur)) {
        if (test(cur)) return true
        seen.add(cur)
        cur = cur.cause
    }
    return false
}

function isAbortError (e:Error):boolean {
    return e.name === 'AbortError'
}

// Cancellation: a CancelledError in the chain, or an AbortError raised
// while `signal` is aborted with a CancelledError reason. A TimeoutError
// is never cancellation.
export function isCancellation (err:unknown, signal?:AbortSignal):boolean {
    if (errorChainHas(err, e => e instanceof CancelledError)) return true
    if (!signal?.aborted) return false
    if (!(signal.reason instanceof CancelledError)) return false
    return errorChainHas(err, isAbortError)
}

function llmKind (err:unknown, kinds:string[]):boolean {
    return errorChainHas(err, e => {
        return e instanceof LlmError && kinds.includes(e.kind)
    })
}

function isUsage (err:unknown):boolean {
    return errorChainHas(err, e => e instanceof UsageError)
}

export function exitCode (err:unknown, signal?:AbortSignal):number {
    if (err === undefined || err === null) return ExitCode.Clean
    if (err instanceof ExitSignal) return err.code
    if (isCancellation(err, signal)) return ExitCode.Cancelled
    if (llmKind(err, ['auth'])) return ExitCode.Auth
    if (isUsage(err)) return ExitCode.Usage
    return ExitCode.Partial
}

export function errorCategoryFor (
    code:number,
    err:unknown,
    signal?:AbortSignal
):ErrorCategory {
    if (code === ExitCode.Clean) return 'none'
    if (code === ExitCode.Findings) return 'findings'
    if (isCancellation(err, signal)) return 'cancelled'
    if (llmKind(err, ['auth'])) return 'auth'
    if (llmKind(err, ['endpoint'])) return 'endpoint'
    if (llmKind(err, ['budget_exhausted', 'work_deadline',
        'no_final_call'])) {
        return 'resource_limit'
    }
    if (isUsage(err) || code === ExitCode.Usage) return 'usage'
    if (code === ExitCode.Cancelled) return 'cancelled'
    return 'partial'
}

// Writes an error to `out`: `roast: <message>` sanitized, or one JSON
// object. An ExitSignal writes nothing.
export function writeError (
    out:NodeJS.WritableStream,
    code:number,
    err:Error,
    format:ErrorFormat,
    signal?:AbortSignal
):void {
    if (err instanceof ExitSignal) return
    if (format === 'json') {
        const body = {
            error_category:errorCategoryFor(code, err, signal),
            message:err.message,
            exit_code:code,
        }
        out.write(`${JSON.stringify(body)}\n`)
        return
    }
    out.write(`roast: ${text(err.message)}\n`)
}
// `roast ignore` (spec 12, 2.13): adds the run-record state directory to
// the toplevel .gitignore. `init` reuses ensureStateIgnored.
import fs from 'node:fs/promises'
import path from 'node:path'
import { gitRoot } from '../git/git.js'
import { goTrimSpace } from '../gocompat/strings.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'

// Roast's project-local state directory at the Git toplevel.
const STATE_DIR = '.roast'

export const STATE_IGNORE_ENTRY = `/${STATE_DIR}/`

// Lines that already ignore the toplevel state directory.
const EQUIVALENT = new Set([
    `/${STATE_DIR}/`, `/${STATE_DIR}`, `${STATE_DIR}/`, STATE_DIR,
])

function fail (text:string, err:unknown):Error {
    const msg = err instanceof Error ? err.message : String(err)
    return new Error(`${text}: ${msg}`, { cause:err })
}

// Appends STATE_IGNORE_ENTRY to <repo>/.gitignore unless an equivalent
// line is present, creating the file and terminating an unterminated last
// line first. Reports the path and whether the file changed.
export async function ensureStateIgnored (
    repo:string
):Promise<{ path:string, added:boolean }> {
    const file = path.join(repo, '.gitignore')
    let data = Buffer.alloc(0)
    try {
        data = await fs.readFile(file)
    } catch (err) {
        if ((err as NodeJS.ErrnoException).code !== 'ENOENT') {
            throw fail(`read ${file}`, err)
        }
    }
    const lines = data.toString('utf8').split('\n')
    if (lines.some(line => EQUIVALENT.has(goTrimSpace(line)))) {
        return { path:file, added:false }
    }
    let addition = `${STATE_IGNORE_ENTRY}\n`
    if (data.length > 0 && data[data.length - 1] !== 0x0a) {
        addition = '\n' + addition
    }
    let handle:fs.FileHandle
    try {
        handle = await fs.open(file, 'a', 0o644)
    } catch (err) {
        throw fail(`open ${file}`, err)
    }
    try {
        await handle.write(addition)
    } catch (err) {
        await handle.close().catch(() => {})
        throw fail(`append ${file}`, err)
    }
    try {
        await handle.close()
    } catch (err) {
        throw fail(`close ${file}`, err)
    }
    return { path:file, added:true }
}

async function ignoreHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    let repo:string
    try {
        repo = await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        const msg = err instanceof Error ? err.message : String(err)
        throw new UsageError(msg, { cause:err })
    }
    const { path:file, added } = await ensureStateIgnored(repo)
    ctx.stdout.write(added ?
        `added ${STATE_IGNORE_ENTRY} to ${file}\n` :
        `${file} already ignores ${STATE_IGNORE_ENTRY}\n`)
}

export const ignoreCommand:CommandDef = {
    command:'ignore',
    describe:`Add ${STATE_IGNORE_ENTRY} to the toplevel .gitignore`,
    handler:ignoreHandler,
}
// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a
// temporary Git repository as cwd, a clean environment, and optionally a
// fetch that sends every request to a fake server.
import { run, type RunResult } from '../../src/cli/run.js'
import { BufferStream, inputStream } from './streams.js'
import { tempRepo } from './repo.js'

export interface RunRoastOpts {
    // Working directory; a fresh temporary repository when absent.
    cwd?:string;
    // The environment; the repository's isolated env when absent.
    env?:Record<string, string>;
    stdin?:NodeJS.ReadableStream|string;
    signal?:AbortSignal;
    // Origin (`http://127.0.0.1:port`) every request is redirected to.
    redirectTo?:string;
}

export interface RunRoastResult extends RunResult {
    stdout:string;
    stderr:string;
    // The original host of every redirected request, in order.
    hosts:string[];
}

// A fetch that rewrites each URL's origin to `origin`, recording the
// original host (Go redirectDefaultTransport).
export function redirectingFetch (
    origin:string,
    hosts:string[]
):typeof globalThis.fetch {
    return (input, init) => {
        const req = new Request(input, init)
        const url = new URL(req.url)
        hosts.push(url.host)
        const target = new URL(url.pathname + url.search, origin)
        return globalThis.fetch(new Request(target, req))
    }
}

export async function runRoast (
    args:string[],
    opts:RunRoastOpts = {}
):Promise<RunRoastResult> {
    let cwd = opts.cwd
    let env = opts.env
    let remove:(() => void)|undefined
    if (cwd === undefined) {
        const repo = tempRepo()
        cwd = repo.dir
        env ??= repo.env
        remove = repo.remove
    }
    const stdout = new BufferStream()
    const stderr = new BufferStream()
    const hosts:string[] = []
    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?
        inputStream(opts.stdin ?? '') :
        opts.stdin
    try {
        const res = await run(args, {
            stdin,
            stdout,
            stderr,
            env:env ?? {},
            cwd,
            signal:opts.signal,
            fetch:opts.redirectTo ?
                redirectingFetch(opts.redirectTo, hosts) :
                undefined,
        })
        return {
            ...res,
            stdout:stdout.text(),
            stderr:stderr.text(),
            hosts,
        }
    } finally {
        remove?.()
    }
}
// Temporary directories and Git repositories for CLI tests, with an
// environment that isolates the user's home and config directories and
// gives Git an identity (CI runners have none).
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { cleanEnv } from './env.js'

export interface TempDir {
    dir:string;
    env:Record<string, string>;
    remove ():void;
}

function makeTemp (prefix:string):string {
    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))
}

// The base test environment: the process env without provider or roast
// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside
// `root`, a Git identity, and no Git discovery above `root`.
export function isolatedEnv (root:string):Record<string, string> {
    const home = path.join(root, '.home')
    fs.mkdirSync(home, { recursive:true })
    return {
        ...cleanEnv(process.env),
        HOME:home,
        XDG_CONFIG_HOME:path.join(home, '.config'),
        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),
        GIT_AUTHOR_NAME:'Roast Test',
        GIT_AUTHOR_EMAIL:'roast-test@example.com',
        GIT_COMMITTER_NAME:'Roast Test',
        GIT_COMMITTER_EMAIL:'roast-test@example.com',
        GIT_CEILING_DIRECTORIES:path.dirname(root),
        GIT_CONFIG_NOSYSTEM:'1',
    }
}

// A temporary directory that is not inside any Git repository. The test
// working directory is `dir/work`.
export function tempDir (prefix = 'roast-dir-'):TempDir {
    const root = makeTemp(prefix)
    const dir = path.join(root, 'work')
    fs.mkdirSync(dir)
    return {
        dir,
        env:isolatedEnv(root),
        remove:() => fs.rmSync(root, { recursive:true, force:true }),
    }
}

// A temporary Git repository at `dir` (realpath, so it compares equal to
// what Git prints).
export function tempRepo (prefix = 'roast-repo-'):TempDir {
    const t = tempDir(prefix)
    execFileSync('git', ['init', '-q', t.dir], { env:t.env })
    return t
}
