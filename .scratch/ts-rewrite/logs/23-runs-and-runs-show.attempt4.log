diff --git a/src/cli/runs.ts b/src/cli/runs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e1bc076135e00765220fb4b57227dcaabefe2ce
--- /dev/null
+++ b/src/cli/runs.ts
@@ -0,0 +1,19 @@
+// pattern: Imperative Shell
+import { recordDir } from '../record/dir.js'
+import type { CommandArgs, CommandDef, RunContext } from './command.js'
+
+async function runsHandler (
+    _args:CommandArgs,
+    ctx:RunContext
+):Promise<void> {
+    const dir = await recordDir(ctx.cwd, {
+        env:ctx.env, signal:ctx.signal,
+    })
+    ctx.stderr.write(`roast: no run records in ${dir}\n`)
+}
+
+export const runsCommand:CommandDef = {
+    command:'runs',
+    describe:'Inspect stored review runs',
+    handler:runsHandler,
+}
