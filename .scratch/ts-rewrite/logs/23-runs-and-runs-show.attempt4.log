import type { Report } from '../render/render.js'
import { toJSON } from '../render/render.js'
import { DROP } from '../review/types.js'
import { goStringify, rfc3339Local, sortedMap } from './json.js'
import { orderedMap, FIELDS } from './meta-json.js'

export type PriorSighting = { runTS:string; dropReason:string }

export function priorLine (
    line:string,
    repo:string,
    targets:ReadonlySet<string>,
    out:Map<string, PriorSighting>
):void {
    try {
        const raw:unknown = JSON.parse(line)
        if (raw === null || typeof raw !== 'object') return
        const r = raw as Record<string, unknown>
        if (r.repo !== repo || (r.ts != null && typeof r.ts !== 'string')) {
            return
        }
        const findings = [r.findings, r.dropped_findings]
            .flatMap(value => {
                if (value == null) return []
                if (!Array.isArray(value)) throw new Error('invalid findings')
                return value as unknown[]
            }).map(value => {
                if (value === null) return {}
                if (typeof value !== 'object') throw new Error('invalid item')
                const f = value as Record<string, unknown>
                for (const key of ['fingerprint', '_drop_reason']) {
                    if (f[key] != null && typeof f[key] !== 'string') {
                        throw new Error('invalid finding field')
                    }
                }
                return f
            })
        for (const f of findings) {
            const fp = f.fingerprint as string|undefined
            if (fp && targets.has(fp) && !out.has(fp)) {
                out.set(fp, {
                    runTS:(r.ts as string|null) ?? '',
                    dropReason:(f._drop_reason as string|null) ?? '',
                })
            }
        }
    } catch { /* Malformed index lines do not hide later valid lines. */ }
}

export function runLine (
    report:Report,
    repo:string,
    argv:readonly string[]|null,
    now:Date
):string {
    // Reuse the render area's ordered finding/usage representation,
    // without the transient annotation of prior sightings.
    const rendered = JSON.parse(toJSON({ ...report, prior:null }))
    return goStringify({
        ts:rfc3339Local(now),
        ...(report.runId ? { run_id:report.runId } : {}),
        repo,
        argv,
        mode:report.mode,
        quick:report.quick ?? false,
        verified:report.verified ?? false,
        assessment:report.result.assessment,
        n_findings:report.result.findings.length,
        n_dropped:report.result.dropped.length,
        n_refuted:report.result.dropped.filter(f =>
            f._drop_reason === DROP.REFUTED_BY_VERIFIER).length,
        files_reviewed:report.filesReviewed ?? null,
        findings:rendered.findings,
        dropped_findings:rendered.dropped_findings,
        usage:report.usage ? orderedMap(report.usage, FIELDS.usage) : null,
        prompt_packs:report.promptPacks ?? null,
        ...(report.budgets != null ?
            { budgets:sortedMap(report.budgets) } : {}),
    }) + '\n'
}
// Neutralizes terminal control sequences in untrusted text before it reaches
// a terminal or a Markdown report (Go: internal/textsafe).
//
// `text` keeps line structure (LF and tab survive, CRLF becomes LF);
// `line` keeps everything on one line (LF and tab become `\n` and `\t`).
// Controls, DEL, C1 controls, invalid UTF-8 bytes, and lone surrogates
// become printable escapes. Backslash is never escaped, so both functions
// are idempotent.

// A decoded unit: a code point (>= 0), or an invalid byte stored as
// -(byte + 1).
type Unit = number

// Fast path: true when the mode would change nothing in `s`. A
// well-formed surrogate pair is clean; a lone surrogate is not.
function isClean (s:string, lineMode:boolean):boolean {
    for (let i = 0; i < s.length; i++) {
        const c = s.charCodeAt(i)
        if (c < 0x20) {
            if (lineMode || (c !== 0x0a && c !== 0x09)) return false
        } else if (c >= 0x7f && c <= 0x9f) {
            return false
        } else if (c >= 0xd800 && c <= 0xdbff) {
            const next = s.charCodeAt(i + 1)
            if (!(next >= 0xdc00 && next <= 0xdfff)) return false
            i++
        } else if (c >= 0xdc00 && c <= 0xdfff) {
            return false
        }
    }
    return true
}

function hex (n:number, width:number):string {
    return n.toString(16).padStart(width, '0')
}

function escapeUnits (units:Unit[], lineMode:boolean):string {
    let out = ''
    for (let i = 0; i < units.length; i++) {
        const u = units[i]
        if (u < 0) {
            out += '\\x' + hex(-u - 1, 2)
        } else if (u === 0x0d) {
            if (!lineMode && units[i + 1] === 0x0a) continue
            out += '\\x0d'
        } else if (u === 0x0a) {
            out += lineMode ? '\\n' : '\n'
        } else if (u === 0x09) {
            out += lineMode ? '\\t' : '\t'
        } else if (u < 0x20 || u === 0x7f) {
            out += '\\x' + hex(u, 2)
        } else if ((u >= 0x80 && u <= 0x9f) ||
            (u >= 0xd800 && u <= 0xdfff)) {
            out += '\\u' + hex(u, 4)
        } else {
            out += String.fromCodePoint(u)
        }
    }
    return out
}

function stringUnits (s:string):Unit[] {
    const units:Unit[] = []
    // String iteration yields a lone surrogate as its own code point.
    for (const ch of s) units.push(ch.codePointAt(0)!)
    return units
}

function isCont (b:number|undefined):boolean {
    return b !== undefined && b >= 0x80 && b <= 0xbf
}

// Decodes one rune at `i` with Go utf8.DecodeRune validity rules. Returns
// [codePoint, size], or [-1, 1] for an invalid or truncated sequence.
function decodeRune (b:Uint8Array, i:number):[number, number] {
    const b0 = b[i]
    if (b0 < 0x80) return [b0, 1]
    const b1 = b[i + 1]
    if (b0 >= 0xc2 && b0 <= 0xdf) {
        if (!isCont(b1)) return [-1, 1]
        return [((b0 & 0x1f) << 6) | (b1 & 0x3f), 2]
    }
    if (b0 >= 0xe0 && b0 <= 0xef) {
        const lo = b0 === 0xe0 ? 0xa0 : 0x80
        const hi = b0 === 0xed ? 0x9f : 0xbf
        if (b1 === undefined || b1 < lo || b1 > hi) return [-1, 1]
        const b2 = b[i + 2]
        if (!isCont(b2)) return [-1, 1]
        return [((b0 & 0x0f) << 12) | ((b1 & 0x3f) << 6) | (b2 & 0x3f), 3]
    }
    if (b0 >= 0xf0 && b0 <= 0xf4) {
        const lo = b0 === 0xf0 ? 0x90 : 0x80
        const hi = b0 === 0xf4 ? 0x8f : 0xbf
        if (b1 === undefined || b1 < lo || b1 > hi) return [-1, 1]
        const b2 = b[i + 2]
        const b3 = b[i + 3]
        if (!isCont(b2) || !isCont(b3)) return [-1, 1]
        return [((b0 & 0x07) << 18) | ((b1 & 0x3f) << 12) |
            ((b2 & 0x3f) << 6) | (b3 & 0x3f), 4]
    }
    return [-1, 1]
}

function byteUnits (b:Uint8Array):Unit[] {
    const units:Unit[] = []
    for (let i = 0; i < b.length;) {
        const [cp, size] = decodeRune(b, i)
        units.push(cp < 0 ? -(b[i] + 1) : cp)
        i += size
    }
    return units
}

// Multi-line sanitizing of a string.
export function text (s:string):string {
    if (isClean(s, false)) return s
    return escapeUnits(stringUnits(s), false)
}

// Single-line sanitizing of a string.
export function line (s:string):string {
    if (isClean(s, true)) return s
    return escapeUnits(stringUnits(s), true)
}

// Multi-line sanitizing of raw bytes, escaping each invalid UTF-8 byte.
export function textBytes (b:Uint8Array):string {
    return escapeUnits(byteUnits(b), false)
}

// Single-line sanitizing of raw bytes.
export function lineBytes (b:Uint8Array):string {
    return escapeUnits(byteUnits(b), true)
}
// Temporary directories and Git repositories for CLI tests, with an
// environment that isolates the user's home and config directories and
// gives Git an identity (CI runners have none).
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { cleanEnv } from './env.js'

export interface TempDir {
    dir:string;
    env:Record<string, string>;
    remove ():void;
}

function makeTemp (prefix:string):string {
    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))
}

// The base test environment: the process env without provider or roast
// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside
// `root`, a Git identity, and no Git discovery above `root`.
export function isolatedEnv (root:string):Record<string, string> {
    const home = path.join(root, '.home')
    fs.mkdirSync(home, { recursive:true })
    return {
        ...cleanEnv(process.env),
        HOME:home,
        XDG_CONFIG_HOME:path.join(home, '.config'),
        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),
        GIT_AUTHOR_NAME:'Roast Test',
        GIT_AUTHOR_EMAIL:'roast-test@example.com',
        GIT_COMMITTER_NAME:'Roast Test',
        GIT_COMMITTER_EMAIL:'roast-test@example.com',
        GIT_CEILING_DIRECTORIES:path.dirname(root),
        GIT_CONFIG_NOSYSTEM:'1',
    }
}

// A temporary directory that is not inside any Git repository. The test
// working directory is `dir/work`.
export function tempDir (prefix = 'roast-dir-'):TempDir {
    const root = makeTemp(prefix)
    const dir = path.join(root, 'work')
    fs.mkdirSync(dir)
    return {
        dir,
        env:isolatedEnv(root),
        remove:() => fs.rmSync(root, { recursive:true, force:true }),
    }
}

// A temporary Git repository at `dir` (realpath, so it compares equal to
// what Git prints).
export function tempRepo (prefix = 'roast-repo-'):TempDir {
    const t = tempDir(prefix)
    execFileSync('git', ['init', '-q', t.dir], { env:t.env })
    return t
}
