    const line = JSON.parse(raw)
    t.deepEqual(Object.keys(line.budgets), [bmp, astral])
    t.deepEqual(Object.keys(line.usage), [bmp, astral])
    t.deepEqual(Object.keys(line.usage[bmp]), [
