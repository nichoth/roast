@@ -0,0 +1,27 @@
+import fs from 'node:fs/promises'
+import { test } from '../helpers/test.js'
+import { runRoast } from '../helpers/run.js'
+import { recordRepo } from '../record/repo.js'
+import { tempDir } from '../helpers/repo.js'
+
+test('runs with no records succeeds without creating state', async t => {
+    const repo = recordRepo(t)
+    const result = await runRoast(['runs'], {
+        cwd:repo.dir, env:repo.env,
+    })
+    t.equal(result.code, 0)
+    t.equal(result.stdout, '')
+    t.ok(result.stderr.length > 0)
+    t.ok(!(await fs.readdir(repo.dir)).includes('.roast'))
+})
+
+test('runs outside a Git repository is a usage error', async t => {
+    const outside = tempDir()
+    t.cleanup(outside.remove)
+    const result = await runRoast(['runs', '--error-format', 'json'], {
+        cwd:outside.dir, env:outside.env,
+    })
+    t.equal(result.code, 2)
+    t.equal(result.stdout, '')
+    t.equal(JSON.parse(result.stderr).error_category, 'usage')
+})
