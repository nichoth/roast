// `roast skill install|status`: install or inspect the bundled agent skill
// in the project's or the user's agent skill directories.
import type { Argv } from 'yargs'
import { gitRoot } from '../git/git.js'
import {
    inspect,
    install,
    installationTargets,
    type InstallationTarget,
    type SkillStatus,
} from '../skill/skill.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'

// Where skill commands operate: --dir wins, then --global selects the
// user-level directories, and otherwise the project's agent skill
// directories at the Git toplevel.
export async function skillTargets (
    dir:string,
    global:boolean,
    ctx:RunContext
):Promise<InstallationTarget[]> {
    const opts = { env:ctx.env }
    if (dir || global) return installationTargets(dir, '', opts)
    let root:string
    try {
        root = await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        const msg = err instanceof Error ? err.message : String(err)
        throw new UsageError(
            `${msg}; run inside a project or pass --global`, { cause:err })
    }
    return installationTargets('', root, opts)
}

function stringFlag (args:CommandArgs, name:string):string {
    const v = args[name]
    return typeof v === 'string' ? v : ''
}

function flagsFor (args:CommandArgs):{ dir:string, global:boolean } {
    return { dir:stringFlag(args, 'dir'), global:args.global === true }
}

async function installHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const { dir, global } = flagsFor(args)
    const force = args.force === true
    const targets = await skillTargets(dir, global, ctx)
    const before:SkillStatus[] = []
    for (const target of targets) {
        const status = await inspect(target.path)
        if (status.state === 'stale' && !force) {
            throw new Error(`${target.harness} skill files differ (${
                status.stale.join(', ')}); re-run with --force to overwrite`)
        }
        before.push(status)
    }
    for (const [i, target] of targets.entries()) {
        const after = await install(target.path, force)
        const prior = before[i].state
        const what = prior === 'symlink' ?
            'symlink (development install), left unchanged' :
            prior === 'up_to_date' ?
                'already up to date' :
                `installed (${after.state})`
        ctx.stdout.write(`${target.harness}\t${what}\t${target.path}\n`)
    }
}

async function statusHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const { dir, global } = flagsFor(args)
    for (const target of await skillTargets(dir, global, ctx)) {
        const status = await inspect(target.path)
        let line = `${target.harness}\t${status.state}\t${status.path}`
        if (status.stale.length > 0) line += `\t${status.stale.join(',')}`
        ctx.stdout.write(line + '\n')
    }
}

export const skillCommand:CommandDef = {
    command:'skill',
    describe:'Manage the Roast agent skill',
    subcommands:[
        {
            command:'install',
            describe:'Install the Roast agent skill',
            builder:(y:Argv) => y
                .option('dir', {
                    type:'string',
                    describe:'install only below this parent skills ' +
                        'directory; /roast is appended',
                })
                .option('global', {
                    type:'boolean',
                    describe:'install into the user-level skill ' +
                        'directories instead of the project',
                })
                .option('force', {
                    type:'boolean',
                    describe:'overwrite installed skill files that differ',
                }),
            handler:installHandler,
        },
        {
            command:'status',
            describe:'Report the Roast agent skill installation status',
            builder:(y:Argv) => y
                .option('global', {
                    type:'boolean',
                    describe:'inspect the user-level skill directories ' +
                        'instead of the project',
                })
                .option('dir', {
                    type:'string',
                    describe:'inspect only below this parent skills ' +
                        'directory; /roast is appended',
                }),
            handler:statusHandler,
        },
    ],
}
// `roast gate enable|disable|status` and the hidden `gate settings` the
// pre-commit hook calls (spec 12, 2.10).
import type { Argv } from 'yargs'
import { recordDecision } from '../gate/decision.js'
import { manualLine } from '../gate/constants.js'
import { inspect, install, remove, summary } from '../gate/hook.js'
import { gitRoot } from '../git/git.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { NO_GATE_CONFIG, gateConfigPath, loadProjectConfig } from './config.js'
import { UsageError } from './errors.js'

export const GATE_DEFAULT_TIMEOUT = 180
export const GATE_DEFAULT_SEVERITY = 'HIGH'

// Prints the gate's timeout and severity from the config, or their
// defaults. The environment never changes them.
async function settingsHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const explicit = typeof args.config === 'string' ? args.config : ''
    const cfg = await loadProjectConfig(explicit, ctx)
    const timeout = cfg.gate?.timeout_seconds ?? GATE_DEFAULT_TIMEOUT
    const severity = cfg.gate?.severity ?
        cfg.gate.severity.toUpperCase() :
        GATE_DEFAULT_SEVERITY
    ctx.stdout.write(`timeout_seconds=${timeout}\nseverity=${severity}\n`)
}

const settingsCommand:CommandDef = {
    command:'settings',
    describe:false,
    builder:(y:Argv) => y.option('config', {
        type:'string',
        describe:'project config file (default: nearest .roast.json)',
    }),
    handler:settingsHandler,
}

// The Git toplevel of the working directory.
async function repoRoot (ctx:RunContext):Promise<string> {
    try {
        return await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        throw new UsageError('not inside a Git repository', { cause:err })
    }
}

// Installs the gate and records consent, also when the hook is foreign
// and the user must add the manual line. The toplevel config must exist
// (the hook sees no other) but is not loaded or trust-checked.
async function enableHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const repo = await repoRoot(ctx)
    let config:string
    try {
        config = gateConfigPath(repo)
    } catch (err) {
        const msg = err instanceof Error ? err.message : String(err)
        throw new UsageError(msg, { cause:err })
    }
    if (config === '') throw new UsageError(NO_GATE_CONFIG)
    const { action, status } = await install(repo, ctx.env)
    await recordDecision(repo, 'enabled', ctx.env)
    const p = status.hookPath
    if (action === 'manual') {
        ctx.stdout.write(`${p} is not an appendable shell script; Roast ` +
            'left it untouched.\nAdd this line manually:\n\n    ' +
            `${manualLine()}\n`)
        return
    }
    const line = {
        installed:`gate installed: ${p}`,
        appended:`gate appended to existing hook: ${p}`,
        refreshed:`gate refreshed: ${p}`,
        'up-to-date':`gate already up to date: ${p}`,
    }[action]
    ctx.stdout.write(`${line}\nbypass one commit with: ROAST_SKIP=1 git ` +
        'commit ...\n')
}

async function disableHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const repo = await repoRoot(ctx)
    const { action, status } = await remove(repo, ctx.env)
    await recordDecision(repo, 'declined', ctx.env)
    const line = action === 'removed' ?
        `gate removed from ${status.hookPath}` :
        action === 'preserved' ?
            'gate disabled for this repository; shared dispatcher ' +
                `preserved at ${status.hookPath}` :
            'no Roast gate was installed; recorded the decline'
    ctx.stdout.write(line + '\n')
}

async function statusHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const repo = await repoRoot(ctx)
    const status = await inspect(repo, ctx.env)
    const decision = status.decision === 'none' ?
        'none recorded' :
        status.decision
    ctx.stdout.write(`repo:     ${status.repo}\n` +
        `gate:     ${summary(status)}\n` +
        `decision: ${decision}\n`)
}

export const gateCommand:CommandDef = {
    command:'gate',
    describe:'Manage the native Git pre-commit review gate',
    subcommands:[
        {
            command:'status',
            describe:'Report gate status for this repository',
            handler:statusHandler,
        },
        {
            command:'enable',
            describe:'Install the pre-commit gate in this repository',
            handler:enableHandler,
        },
        {
            command:'disable',
            describe:'Disable the Roast pre-commit gate in this repository',
            handler:disableHandler,
        },
        settingsCommand,
    ],
}
// `roast trust` (spec 03, 2.7, 2.9, 5.4) run in-process.
import fs from 'node:fs'
import path from 'node:path'
import { Readable } from 'node:stream'
import { test, type CleanupTest } from '../helpers/test.js'
import { runRoast } from '../helpers/run.js'
import { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'

const GATEWAY = 'https://gw.example/v1'

// A config with a custom finder, a routed profile, a built-in verifier,
// and two prompt overrides.
const CUSTOM = {
    version:1,
    inference_profiles:{
        gateway_profile:{
            model:'m',
            endpoint:GATEWAY,
            protocol:'chat',
            api_key_env:'GW_KEY',
        },
        routed_profile:{
            model:'m',
            endpoint:'https://routed.example/v2',
            protocol:'responses',
        },
        claude_profile:{ model:'m', protocol:'anthropic' },
    },
    roles:{
        finder:{
            profile:'gateway_profile',
            author_routes:{ openai:'routed_profile' },
        },
        verifier:{ profile:'claude_profile' },
    },
    prompts:{ finder_code:'prompts/code.md', verifier:'verify.md' },
}

const BUILTIN = {
    version:1,
    inference_profiles:{
        o:{ model:'m' },
        a:{ model:'m', protocol:'anthropic' },
    },
    roles:{
        finder:{ profile:'o', author_routes:{ openai:'a' } },
        verifier:{ profile:'a' },
    },
}

function repoWith (t:CleanupTest, cfg:unknown):TempDir {
    const r = tempRepo()
    t.cleanup(r.remove)
    const body = typeof cfg === 'string' ? cfg : JSON.stringify(cfg)
    fs.writeFileSync(path.join(r.dir, '.roast.json'), body)
    return r
}

function stateDir (r:TempDir):string {
    return path.join(r.dir, '.git', 'roast')
}

function approved (r:TempDir):string[] {
    const file = path.join(stateDir(r), 'trust.json')
    if (!fs.existsSync(file)) return []
    return JSON.parse(fs.readFileSync(file, 'utf8')).approved
}

function trust (
    r:TempDir,
    args:string[] = [],
    stdin:string|NodeJS.ReadableStream = ''
) {
    return runRoast(['trust', ...args], { cwd:r.dir, env:r.env, stdin })
}

test('trust on a built-in-only config needs no approval', async t => {
    const r = repoWith(t, BUILTIN)
    const res = await trust(r)
    t.equal(res.code, 0, `exits 0 ${res.stderr}`)
    t.ok(!fs.existsSync(stateDir(r)), 'no state directory')
})

test('trust summary names every security-relevant value', async t => {
    const r = repoWith(t, CUSTOM)
    const res = await trust(r, ['--yes'])
    t.equal(res.code, 0, `exits 0 ${res.stderr}`)
    for (const value of [
        'gateway_profile', 'routed_profile', 'claude_profile',
        GATEWAY, 'https://routed.example/v2', 'https://api.anthropic.com/v1',
        'chat', 'responses', 'anthropic',
        'GW_KEY', 'ANTHROPIC_API_KEY',
        'prompts/code.md', 'verify.md',
        'roles.finder.author_routes.openai',
    ]) {
        t.ok(res.stdout.includes(value), `names ${value}`)
    }
    t.equal(approved(r).length, 1, 'approval recorded')
})

// Bytes 0x00-0x08, 0x0b-0x1f, and 0x7f; newline is the only allowed
// control character in the summary.
function hasRawControl (s:string):boolean {
    for (let i = 0; i < s.length; i++) {
        const c = s.charCodeAt(i)
        if ((c < 0x20 && c !== 0x0a) || c === 0x7f) return true
    }
    return false
}

test('trust summary escapes control characters', async t => {
    const r = repoWith(t, `{
  "version": 1,
  "inference_profiles": {
    "evil\\u001b[2J\\nINJECTED": {"endpoint": "https://gw.example/v1",
      "model": "m", "protocol": "chat", "api_key_env": "GW_KEY"}
  },
  "roles": {
    "finder": {"profile": "evil\\u001b[2J\\nINJECTED",
      "author_routes": {"x\\u0007\\nINJECTED": "evil\\u001b[2J\\nINJECTED"}},
    "verifier": {"profile": "evil\\u001b[2J\\nINJECTED"}
  },
  "prompts": {"verifier": "prompt\\r\\nINJECTED\\u0007"}
}`)
    const res = await trust(r, [], 'n\n')
    t.equal(res.code, 2, `declined exits 2 ${res.stderr}`)
    t.ok(res.stdout.includes('evil'), 'summary printed')
    t.ok(!hasRawControl(res.stdout), 'no raw control characters')
    const lines = res.stdout.split('\n')
    t.ok(!lines.some(l => l.trimStart().startsWith('INJECTED')),
        'no config value starts its own line')
})

test('trust usage errors exit 2', async t => {
    const outside = tempDir()
    t.cleanup(outside.remove)
    fs.writeFileSync(path.join(outside.dir, '.roast.json'),
        JSON.stringify(CUSTOM))
    const res = await runRoast(['trust', '--yes'],
        { cwd:outside.dir, env:outside.env })
    t.equal(res.code, 2, 'outside a repository')

    const r = repoWith(t, CUSTOM)
    t.equal((await trust(r, ['--yes', 'extra'])).code, 2, 'extra argument')
    t.deepEqual(approved(r), [], 'extra argument records nothing')

    const none = tempRepo()
    t.cleanup(none.remove)
    const noConfig = await runRoast(['trust', '--yes'],
        { cwd:none.dir, env:none.env })
    t.equal(noConfig.code, 2, 'no config')

    const bad = repoWith(t, { version:1, bogus:true })
    t.equal((await trust(bad, ['--yes'])).code, 2, 'invalid config')
    t.ok(!fs.existsSync(stateDir(bad)), 'nothing written')
})

test('trust records approval only on yes', async t => {
    for (const answer of ['', '\n', 'n\n', 'no\n', 'yy\n', 'sure\n']) {
        const r = repoWith(t, CUSTOM)
        const res = await trust(r, [], answer)
        t.equal(res.code, 2, `${JSON.stringify(answer)} exits 2`)
        t.ok(res.stdout.includes('[y/N]'), 'asks')
        t.ok(!fs.existsSync(stateDir(r)), 'records nothing')
    }
    for (const answer of ['y\n', 'Y\n', 'yes\n', 'y']) {
        const r = repoWith(t, CUSTOM)
        const res = await trust(r, [], answer)
        t.equal(res.code, 0, `${JSON.stringify(answer)} exits 0`)
        t.equal(approved(r).length, 1, 'records one approval')
    }
})

test('trust --yes records approval without reading stdin', async t => {
    let reads = 0
    const stdin = new Readable({
        read () {
            reads++
            this.destroy(new Error('stdin must not be read'))
        },
    })
    const r = repoWith(t, CUSTOM)
    const res = await trust(r, ['--yes'], stdin)
    t.equal(res.code, 0, `exits 0 ${res.stderr}`)
    t.equal(reads, 0, 'stdin never read')
    t.equal(approved(r).length, 1, 'approval recorded')
    const again = await trust(r, ['--yes'], stdin)
    t.equal(again.code, 0, 'approving again exits 0')
    t.equal(approved(r).length, 1, 'still one approval')
})

test('trust reports a stdin read error as a non-usage error', async t => {
    const stdin = new Readable({
        read () {
            this.destroy(new Error('broken stdin'))
        },
    })
    const r = repoWith(t, CUSTOM)
    const res = await trust(r, [], stdin)
    t.equal(res.code, 4, 'exits 4')
    t.ok(!fs.existsSync(stateDir(r)), 'records nothing')
})
