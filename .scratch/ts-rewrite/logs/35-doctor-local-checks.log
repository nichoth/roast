// provider's standard endpoint and key variable, or that replaces a
// prompt, must be approved for this clone before anything is sent.
import type { Argv } from 'yargs'
import type { ProjectConfig } from '../config/load.js'
import {
    type TrustProjection,
    requiresApproval,
    trustHash,
    trustProjection,
} from '../config/trust.js'
import { gitRoot } from '../git/git.js'
import { line } from '../textsafe/textsafe.js'
import { approve, isApproved } from '../trust/trust.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { loadProjectConfig } from './config.js'
import { UsageError } from './errors.js'
import { interactiveTerminals, promptNoDefault } from './terminal.js'

const QUESTION = 'Trust this project config?'
const APPROVED = 'Approved for this clone.\n'

export const NOT_APPROVED = 'the project config names endpoints, ' +
    'credential variables, or prompt files that are not approved for this ' +
    'clone; review and approve them with `npx roast trust`'

export const LEGACY_APPROVAL = 'this clone\'s approvals were recorded by ' +
    'an older Roast and are no longer accepted; review and approve the ' +
    'project config again with `npx roast trust`'

// What requireTrust may touch: the CLI context without its command
// details.
export type TrustIo = Pick<RunContext,
    'stdin'|'stderr'|'lines'|'env'|'signal'>

// Prints every security-relevant value of the projection, each escaped to
// one line so config text cannot add lines or terminal escapes.
export function writeTrustSummary (
    out:NodeJS.WritableStream,
    p:TrustProjection
):void {
    let text = 'This project config sends code and credentials to:\n'
    for (const profile of p.profiles) {
        const credential = profile.credentialEnv === '' ?
            '(none named)' :
            line(profile.credentialEnv)
        text += `  ${line(profile.selector)}: profile ` +
            `${line(profile.profile)}\n` +
            `    endpoint:   ${line(profile.endpoint)}\n` +
            `    protocol:   ${line(profile.protocol)}\n` +
            `    credential: ${credential}\n`
    }
    if (p.promptOverrides.length > 0) {
        text += 'and replaces prompts with these files:\n'
        for (const o of p.promptOverrides) {
            text += `  ${line(o.name)}: ${line(o.path)}\n`
        }
    }
    out.write(text)
}

// Fails unless the config needs no approval or this clone approved it.
// On terminals it asks inline (on stderr); elsewhere it never reads
// stdin. A trust record that cannot be read is not a usage error.
export async function requireTrust (
    dir:string,
    cfg:ProjectConfig,
    io:TrustIo
):Promise<void> {
    const p = trustProjection(cfg)
    if (!requiresApproval(p)) return
    const hash = trustHash(p)
    const opts = { env:io.env as NodeJS.ProcessEnv, signal:io.signal }
    const state = await isApproved(dir, hash, opts)
    if (state === 'approved') return
    if (!interactiveTerminals(io.stdin, io.stderr)) {
        throw new UsageError(state === 'legacy' ?
            LEGACY_APPROVAL :
            NOT_APPROVED)
    }
    if (state === 'legacy') {
        io.stderr.write('The existing approvals for this clone came from ' +
            'an older Roast and are no longer accepted.\n')
    }
    writeTrustSummary(io.stderr, p)
    if (!await promptNoDefault(io.stderr, io.lines, QUESTION)) {
        throw new UsageError('project config not approved; nothing ' +
            'recorded and nothing sent')
    }
    await approve(dir, hash, opts)
    io.stderr.write(APPROVED)
}

async function trustHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    let root:string
    try {
        root = await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        throw new UsageError('not inside a git repository', { cause:err })
    }
    const explicit = typeof args.config === 'string' ? args.config : ''
    const cfg = await loadProjectConfig(explicit, ctx)
    const p = trustProjection(cfg)
    writeTrustSummary(ctx.stdout, p)
    if (!requiresApproval(p)) {
        ctx.stdout.write('Only default provider endpoints and key ' +
            'variables are used; no approval is needed.\n')
        return
    }
    if (args.yes !== true &&
        !await promptNoDefault(ctx.stdout, ctx.lines, QUESTION)) {
        throw new UsageError('not approved; nothing recorded')
    }
    await approve(root, trustHash(p), {
        env:ctx.env as NodeJS.ProcessEnv,
        signal:ctx.signal,
    })
    ctx.stdout.write(APPROVED)
}

export const trustCommand:CommandDef = {
    command:'trust',
    describe:'Approve the project config\'s endpoints and credentials',
    builder:(y:Argv) => y
        .option('config', {
            type:'string',
            describe:'project config file (default: nearest .roast.json)',
        })
        .option('yes', {
            type:'boolean',
            describe:'record approval without asking',
        }),
    handler:trustHandler,
}
// `roast skill install|status`: install or inspect the bundled agent skill
// in the project's or the user's agent skill directories.
import type { Argv } from 'yargs'
import { gitRoot } from '../git/git.js'
import {
    inspect,
    install,
    installationTargets,
    type InstallationTarget,
    type SkillStatus,
} from '../skill/skill.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'

// Where skill commands operate: --dir wins, then --global selects the
// user-level directories, and otherwise the project's agent skill
// directories at the Git toplevel.
export async function skillTargets (
    dir:string,
    global:boolean,
    ctx:RunContext
):Promise<InstallationTarget[]> {
    const opts = { env:ctx.env }
    if (dir || global) return installationTargets(dir, '', opts)
    let root:string
    try {
        root = await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        const msg = err instanceof Error ? err.message : String(err)
        throw new UsageError(
            `${msg}; run inside a project or pass --global`, { cause:err })
    }
    return installationTargets('', root, opts)
}

function stringFlag (args:CommandArgs, name:string):string {
    const v = args[name]
    return typeof v === 'string' ? v : ''
}

function flagsFor (args:CommandArgs):{ dir:string, global:boolean } {
    return { dir:stringFlag(args, 'dir'), global:args.global === true }
}

async function installHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const { dir, global } = flagsFor(args)
    const force = args.force === true
    const targets = await skillTargets(dir, global, ctx)
    const before:SkillStatus[] = []
    for (const target of targets) {
        const status = await inspect(target.path)
        if (status.state === 'stale' && !force) {
            throw new Error(`${target.harness} skill files differ (${
                status.stale.join(', ')}); re-run with --force to overwrite`)
        }
        before.push(status)
    }
    for (const [i, target] of targets.entries()) {
        const after = await install(target.path, force)
        const prior = before[i].state
        const what = prior === 'symlink' ?
            'symlink (development install), left unchanged' :
            prior === 'up_to_date' ?
                'already up to date' :
                `installed (${after.state})`
        ctx.stdout.write(`${target.harness}\t${what}\t${target.path}\n`)
    }
}

async function statusHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const { dir, global } = flagsFor(args)
    for (const target of await skillTargets(dir, global, ctx)) {
        const status = await inspect(target.path)
        let line = `${target.harness}\t${status.state}\t${status.path}`
        if (status.stale.length > 0) line += `\t${status.stale.join(',')}`
        ctx.stdout.write(line + '\n')
    }
}

export const skillCommand:CommandDef = {
    command:'skill',
    describe:'Manage the Roast agent skill',
    subcommands:[
        {
            command:'install',
            describe:'Install the Roast agent skill',
            builder:(y:Argv) => y
                .option('dir', {
                    type:'string',
                    describe:'install only below this parent skills ' +
                        'directory; /roast is appended',
                })
                .option('global', {
                    type:'boolean',
                    describe:'install into the user-level skill ' +
                        'directories instead of the project',
                })
                .option('force', {
                    type:'boolean',
                    describe:'overwrite installed skill files that differ',
                }),
            handler:installHandler,
        },
        {
            command:'status',
            describe:'Report the Roast agent skill installation status',
            builder:(y:Argv) => y
                .option('global', {
                    type:'boolean',
                    describe:'inspect the user-level skill directories ' +
                        'instead of the project',
                })
                .option('dir', {
                    type:'string',
                    describe:'inspect only below this parent skills ' +
                        'directory; /roast is appended',
                }),
            handler:statusHandler,
        },
    ],
}
// `roast gate enable|disable|status` and the hidden `gate settings` the
// pre-commit hook calls (spec 12, 2.10).
import type { Argv } from 'yargs'
import { recordDecision } from '../gate/decision.js'
import { manualLine } from '../gate/constants.js'
import { inspect, install, remove, summary } from '../gate/hook.js'
import { gitRoot } from '../git/git.js'
import type { CommandArgs, CommandDef, RunContext } from './command.js'
import { NO_GATE_CONFIG, gateConfigPath, loadProjectConfig } from './config.js'
import { UsageError } from './errors.js'

export const GATE_DEFAULT_TIMEOUT = 180
export const GATE_DEFAULT_SEVERITY = 'HIGH'

// Prints the gate's timeout and severity from the config, or their
// defaults. The environment never changes them.
async function settingsHandler (
    args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const explicit = typeof args.config === 'string' ? args.config : ''
    const cfg = await loadProjectConfig(explicit, ctx)
    const timeout = cfg.gate?.timeout_seconds ?? GATE_DEFAULT_TIMEOUT
    const severity = cfg.gate?.severity ?
        cfg.gate.severity.toUpperCase() :
        GATE_DEFAULT_SEVERITY
    ctx.stdout.write(`timeout_seconds=${timeout}\nseverity=${severity}\n`)
}

const settingsCommand:CommandDef = {
    command:'settings',
    describe:false,
    builder:(y:Argv) => y.option('config', {
        type:'string',
        describe:'project config file (default: nearest .roast.json)',
    }),
    handler:settingsHandler,
}

// The Git toplevel of the working directory.
async function repoRoot (ctx:RunContext):Promise<string> {
    try {
        return await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
        throw new UsageError('not inside a Git repository', { cause:err })
    }
}

// Installs the gate and records consent, also when the hook is foreign
// and the user must add the manual line. The toplevel config must exist
// (the hook sees no other) but is not loaded or trust-checked.
async function enableHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const repo = await repoRoot(ctx)
    let config:string
    try {
        config = gateConfigPath(repo)
    } catch (err) {
        const msg = err instanceof Error ? err.message : String(err)
        throw new UsageError(msg, { cause:err })
    }
    if (config === '') throw new UsageError(NO_GATE_CONFIG)
    const { action, status } = await install(repo, ctx.env)
    await recordDecision(repo, 'enabled', ctx.env)
    const p = status.hookPath
    if (action === 'manual') {
        ctx.stdout.write(`${p} is not an appendable shell script; Roast ` +
            'left it untouched.\nAdd this line manually:\n\n    ' +
            `${manualLine()}\n`)
        return
    }
    const line = {
        installed:`gate installed: ${p}`,
        appended:`gate appended to existing hook: ${p}`,
        refreshed:`gate refreshed: ${p}`,
        'up-to-date':`gate already up to date: ${p}`,
    }[action]
    ctx.stdout.write(`${line}\nbypass one commit with: ROAST_SKIP=1 git ` +
        'commit ...\n')
}

async function disableHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const repo = await repoRoot(ctx)
    const { action, status } = await remove(repo, ctx.env)
    await recordDecision(repo, 'declined', ctx.env)
    const line = action === 'removed' ?
        `gate removed from ${status.hookPath}` :
        action === 'preserved' ?
            'gate disabled for this repository; shared dispatcher ' +
                `preserved at ${status.hookPath}` :
            'no Roast gate was installed; recorded the decline'
    ctx.stdout.write(line + '\n')
}

async function statusHandler (
    _args:CommandArgs,
    ctx:RunContext
):Promise<void> {
    const repo = await repoRoot(ctx)
    const status = await inspect(repo, ctx.env)
    const decision = status.decision === 'none' ?
        'none recorded' :
        status.decision
    ctx.stdout.write(`repo:     ${status.repo}\n` +
        `gate:     ${summary(status)}\n` +
        `decision: ${decision}\n`)
}

export const gateCommand:CommandDef = {
    command:'gate',
    describe:'Manage the native Git pre-commit review gate',
    subcommands:[
        {
            command:'status',
            describe:'Report gate status for this repository',
            handler:statusHandler,
        },
        {
            command:'enable',
            describe:'Install the pre-commit gate in this repository',
            handler:enableHandler,
        },
        {
            command:'disable',
            describe:'Disable the Roast pre-commit gate in this repository',
            handler:disableHandler,
        },
        settingsCommand,
    ],
}
// Per-clone approvals of project configs (spec 03, 2.5 and 2.6). The
// record lives under the Git common directory, which `git clone` never
// copies, so a repository cannot ship its own approval.
import fs from 'node:fs/promises'
import path from 'node:path'
import { git } from '../git/git.js'
import { writeFileAtomic } from '../fsutil/atomic.js'

export const TRUST_FILE = 'trust.json'
const CURRENT_VERSION = 2
const LEGACY_VERSION = 1

export interface TrustOpts {
    signal?:AbortSignal;
    // The git environment, normally the CLI context's env.
    env?:NodeJS.ProcessEnv;
}

export type TrustRecord =
    { kind:'current', approved:string[] }|{ kind:'legacy' }

export type ApprovalState = 'approved'|'not-approved'|'legacy'

function message (err:unknown):string {
    return err instanceof Error ? err.message : String(err)
}

// <git-common-dir>/roast for the repository containing `dir`. Linked
// worktrees share the main repository's.
export async function stateDir (
    dir:string,
    opts:TrustOpts = {}
):Promise<string> {
    let out:Buffer
    try {
        out = await git(dir, ['rev-parse', '--path-format=absolute',
            '--git-common-dir'], opts)
    } catch (err) {
        if (opts.signal?.aborted) throw err
        throw new Error('not inside a git repository', { cause:err })
    }
    return path.join(out.toString('utf8').trim(), 'roast')
}

export async function trustPath (
    dir:string,
    opts:TrustOpts = {}
):Promise<string> {
    try {
        return path.join(await stateDir(dir, opts), TRUST_FILE)
    } catch (err) {
        if (opts.signal?.aborted) throw err
        throw new Error(`trust: ${message(err)}`, { cause:err })
    }
}

function isObject (v:unknown):v is Record<string, unknown> {
    return typeof v === 'object' && v !== null && !Array.isArray(v)
}

// Reads the record at `file`. An absent file is an empty current record;
// a version 1 file (Go era) is legacy; anything else is an error.
export async function readTrustRecord (file:string):Promise<TrustRecord> {
    let text:string
    try {
        text = await fs.readFile(file, 'utf8')
    } catch (err) {
        if ((err as NodeJS.ErrnoException).code === 'ENOENT') {
            return { kind:'current', approved:[] }
        }
        throw new Error(`read trust record: ${message(err)}`, { cause:err })
    }
    const invalid = (cause:string):Error =>
        new Error(`read trust record ${file}: ${cause}`)
    let doc:unknown
    try {
        doc = JSON.parse(text)
    } catch (err) {
        throw invalid(message(err))
    }
    if (!isObject(doc)) throw invalid('not a JSON object')
    const version = doc.version
    if (version === LEGACY_VERSION) return { kind:'legacy' }
    if (version !== CURRENT_VERSION) {
        const shown = version === undefined ? 0 : JSON.stringify(version)
        throw new Error(`trust record ${file} has unsupported version ` +
            `${shown}`)
    }
    const approved = doc.approved ?? []
    if (!Array.isArray(approved) ||
        !approved.every(h => typeof h === 'string')) {
        throw invalid('approved must be an array of strings')
    }
    return { kind:'current', approved }
}

export async function isApproved (
    dir:string,
    hash:string,
    opts:TrustOpts = {}
):Promise<ApprovalState> {
    const rec = await readTrustRecord(await trustPath(dir, opts))
    if (rec.kind === 'legacy') return 'legacy'
    return rec.approved.includes(hash) ? 'approved' : 'not-approved'
}

// Records `hash` for this clone. A legacy record is replaced, not
// migrated; a malformed one aborts with the file untouched.
export async function approve (
    dir:string,
    hash:string,
    opts:TrustOpts = {}
):Promise<void> {
    const file = await trustPath(dir, opts)
    const rec = await readTrustRecord(file)
    let approved = [hash]
    if (rec.kind === 'current') {
        if (rec.approved.includes(hash)) return
        approved = [...rec.approved, hash]
    }
    const body = { version:CURRENT_VERSION, approved }
    await writeFileAtomic(file, JSON.stringify(body, null, 2) + '\n', {
        mode:0o600,
        tempPrefix:'trust-',
        tempSuffix:'.json',
        dirMode:0o755,
        errorPrefix:'write trust record',
    })
}
