diff --git a/src/cli/doctor.ts b/src/cli/doctor.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cc6eb73c4ac41b39188936b423f80378b92d12a0
--- /dev/null
+++ b/src/cli/doctor.ts
@@ -0,0 +1,204 @@
+// pattern: Imperative Shell
+// Sequential setup diagnostics. Network role checks land separately.
+import { buildInfo, formatBuildInfo } from '../buildinfo.js'
+import { loadProjectConfig, projectConfigPath, NO_PROJECT_CONFIG }
+    from './config.js'
+import { trustProjection, requiresApproval, trustHash }
+    from '../config/trust.js'
+import { isApproved } from '../trust/trust.js'
+import { gitRoot } from '../git/git.js'
+import type { ProjectConfig } from '../config/load.js'
+import { lstat } from 'node:fs/promises'
+import { openCredentialStore, loadCredentials }
+    from '../credentials/credentials.js'
+import { inspect as inspectGate, summary, isActive } from '../gate/hook.js'
+import { inspect as inspectSkill, installationTargets,
+    type InstallationTarget } from '../skill/skill.js'
+import type { CommandDef, RunContext } from './command.js'
+
+export type DoctorStatus = 'pass'|'warn'|'fail'
+
+export interface DoctorResult {
+    name:string;
+    status:DoctorStatus;
+    detail:string;
+}
+
+function message (err:unknown):string {
+    return err instanceof Error ? err.message : String(err)
+}
+
+async function doctorTrustCheck (
+    cfg:ProjectConfig,
+    ctx:RunContext
+):Promise<DoctorResult> {
+    const projection = trustProjection(cfg)
+    const name = 'config-trust'
+    if (!requiresApproval(projection)) {
+        return { name, status:'pass', detail:'no approval required ' +
+            '(default provider endpoints and key variables only)' }
+    }
+    let repo:string
+    try {
+        repo = await gitRoot(ctx.cwd, ctx)
+    } catch {
+        return { name, status:'fail', detail:'approval required but not ' +
+            'granted: not inside a Git repository' }
+    }
+    try {
+        const state = await isApproved(repo, trustHash(projection), ctx)
+        if (state === 'approved') {
+            return { name, status:'pass', detail:'approval required and ' +
+                'granted for this clone' }
+        }
+        const why = state === 'legacy' ?
+            'approval required; approved by an older Roast' :
+            'approval required and not granted'
+        return { name, status:'fail', detail:why +
+            '; endpoint probes skipped; run `npx roast trust`' }
+    } catch (err) {
+        return { name, status:'fail', detail:'approval required; could ' +
+            `not read approvals: ${message(err)}` }
+    }
+}
+
+export async function doctorChecks (
+    explicit:string,
+    ctx:RunContext
+):Promise<DoctorResult[]> {
+    const results:DoctorResult[] = [{
+        name:'build',
+        status:buildInfo.version === 'dev' ? 'warn' : 'pass',
+        detail:formatBuildInfo(buildInfo) +
+            (buildInfo.version === 'dev' ? '; development build' : ''),
+    }]
+    let file = ''
+    try {
+        file = await projectConfigPath(explicit, ctx)
+        if (!file) throw new Error(NO_PROJECT_CONFIG)
+        results.push({ name:'config-file', status:'pass', detail:file })
+    } catch (err) {
+        results.push({ name:'config-file', status:'fail',
+            detail:message(err) })
+    }
+    let cfg:ProjectConfig|undefined
+    if (file) {
+        try {
+            cfg = await loadProjectConfig(file, ctx)
+            results.push({ name:'config', status:'pass',
+                detail:`schema version ${cfg.version}` })
+        } catch (err) {
+            results.push({ name:'config', status:'fail',
+                detail:message(err) })
+        }
+    }
+    if (cfg) {
+        results.push(await doctorTrustCheck(cfg, ctx))
+        // Per-role slot: finder, then verifier (tickets 43 and 44).
+    }
+    let repo = ''
+    try {
+        repo = await gitRoot(ctx.cwd, ctx)
+        results.push({ name:'git', status:'pass', detail:repo })
+    } catch (err) {
+        if (ctx.signal.aborted) throw err
+        results.push({ name:'git', status:'warn',
+            detail:'not inside a Git repository' })
+    }
+    if (repo) {
+        try {
+            const gate = await inspectGate(repo, ctx.env)
+            results.push({ name:'git-gate',
+                status:gate.stale ||
+                    (gate.decision === 'enabled' && !isActive(gate)) ?
+                    'warn' : 'pass',
+                detail:summary(gate) })
+        } catch (err) {
+            results.push({ name:'git-gate', status:'warn',
+                detail:message(err) })
+        }
+    }
+    const store = await openCredentialStore(ctx.cwd, ctx.env, ctx)
+    for (const scope of ['project', 'user'] as const) {
+        const file = store.paths[scope]
+        if (!file) continue
+        try {
+            await lstat(file)
+        } catch (err) {
+            if ((err as NodeJS.ErrnoException).code === 'ENOENT') continue
+            // Let the credential loader report other filesystem errors.
+        }
+        const name = `${scope}-credentials`
+        try {
+            const entries = await loadCredentials(file)
+            const providers = [...entries.keys()].sort().join(', ')
+            results.push({ name, status:'pass',
+                detail:`${file} (${providers || 'none stored'})` })
+        } catch (err) {
+            results.push({ name, status:'fail', detail:message(err) })
+        }
+    }
+    const variable = ctx.env.HTTPS_PROXY ? 'HTTPS_PROXY' :
+        ctx.env.https_proxy ? 'https_proxy' : ''
+    const honored = ctx.env.NODE_USE_ENV_PROXY === '1'
+    results.push({
+        name:'proxy-env',
+        status:variable && !honored ? 'warn' : 'pass',
+        detail:!variable ? 'no proxy configured' : honored ?
+            'proxy variables honored (NODE_USE_ENV_PROXY=1)' :
+            `${variable} is set but NODE_USE_ENV_PROXY is not; ` +
+                'Node ignores proxy variables unless NODE_USE_ENV_PROXY=1',
+    })
+    let targets:InstallationTarget[] = []
+    try {
+        targets = await installationTargets('', '', { env:ctx.env })
+    } catch (err) {
+        results.push({ name:'agent-skills', status:'warn',
+            detail:message(err) })
+    }
+    for (const target of targets) {
+        const name = `${target.harness}-skill`
+        try {
+            const skill = await inspectSkill(target.path)
+            switch (skill.state) {
+            case 'not_installed':
+                results.push({ name, status:'warn', detail:'not ' +
+                    'installed; run `roast skill install --global`' })
+                break
+            case 'stale':
+                results.push({ name, status:'warn', detail:'stale; run ' +
+                    '`roast skill install --global --force`' })
+                break
+            default:
+                results.push({ name, status:'pass', detail:target.path +
+                    (skill.state === 'symlink' ?
+                        ' (development symlink)' : '') })
+            }
+        } catch (err) {
+            results.push({ name, status:'warn', detail:message(err) })
+        }
+    }
+    return results
+}
+
+export const doctorCommand:CommandDef = {
+    command:'doctor',
+    describe:'Check configuration, providers, and local integration',
+    builder:y => y
+        .option('config', { type:'string', default:'' })
+        .option('json', { type:'boolean', default:false }),
+    async handler (args, ctx) {
+        const results = await doctorChecks(String(args.config), ctx)
+        if (args.json) {
+            ctx.stdout.write(JSON.stringify(results, null, 2) + '\n')
+        } else {
+            for (const result of results) {
+                ctx.stdout.write(result.status.toUpperCase().padEnd(5) +
+                    ` ${result.name.padEnd(18)} ${result.detail}\n`)
+            }
+        }
+        if (results.some(result => result.status === 'fail')) {
+            throw new Error('one or more doctor checks failed')
+        }
+    },
+}
diff --git a/test/cli/doctor.ts b/test/cli/doctor.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c613972c94eef644676876e4ef5f9208dc04458d
--- /dev/null
+++ b/test/cli/doctor.ts
@@ -0,0 +1,206 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { test, type CleanupTest } from '../helpers/test.js'
+import { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'
+import { runRoast } from '../helpers/run.js'
+import { saveCredential, projectCredentialsPath, userCredentialsPath }
+    from '../../src/credentials/credentials.js'
+import { installationTargets, install, skillHooks }
+    from '../../src/skill/skill.js'
+import { git } from '../../src/git/git.js'
+
+const BUILTIN = {
+    version:1,
+    inference_profiles:{ o:{ model:'m' } },
+    roles:{ finder:{ profile:'o' }, verifier:{ profile:'o' } },
+}
+
+function doctorRepo (t:CleanupTest):TempDir {
+    const r = tempRepo()
+    t.cleanup(r.remove)
+    delete r.env.HTTPS_PROXY
+    delete r.env.https_proxy
+    delete r.env.NODE_USE_ENV_PROXY
+    fs.writeFileSync(path.join(r.dir, '.roast.json'),
+        JSON.stringify(BUILTIN))
+    return r
+}
+
+interface Row {
+    name:string;
+    status:string;
+    detail:string;
+}
+
+async function doctor (r:TempDir, args:string[] = []) {
+    const res = await runRoast(['doctor', '--json', ...args],
+        { cwd:r.dir, env:r.env })
+    const rows:Row[] = res.stdout.startsWith('[') ?
+        JSON.parse(res.stdout) : []
+    return { ...res, rows }
+}
+
+test('doctor keeps all local checks after missing or invalid config',
+    async t => {
+        const r = doctorRepo(t)
+        const original = skillHooks.lookPath
+        skillHooks.lookPath = async () => false
+        t.cleanup(() => { skillHooks.lookPath = original })
+        const project = await projectCredentialsPath(r.dir, { env:r.env })
+        await saveCredential(project, 'openai', 'secret', new Date())
+        fs.unlinkSync(path.join(r.dir, '.roast.json'))
+        const missing = await doctor(r)
+        t.equal(missing.code, 4, 'missing config fails')
+        t.deepEqual(missing.rows.map(x => x.name), [
+            'build', 'config-file', 'git', 'git-gate',
+            'project-credentials', 'proxy-env', 'agents-skill', 'claude-skill',
+        ], 'local checks remain in order')
+        t.equal(missing.rows[1].status, 'fail', 'config-file failure')
+        fs.writeFileSync(path.join(r.dir, '.roast.json'), '{')
+        const invalid = await doctor(r)
+        t.equal(invalid.code, 4, 'invalid config fails')
+        t.equal(invalid.rows.find(x => x.name === 'config')?.status,
+            'fail', 'config failure')
+        t.ok(invalid.rows.some(x => x.name === 'agents-skill'),
+            'skills still checked')
+        const explicit = await doctor(r, ['--config', 'missing.json'])
+        t.equal(explicit.rows.find(x => x.name === 'config-file')?.status,
+            'pass', 'explicit missing path accepted')
+        t.equal(explicit.rows.find(x => x.name === 'config')?.status,
+            'fail', 'explicit missing file fails loading')
+    })
+
+test('doctor checks gate health and only user-level skill installations',
+    async t => {
+        const r = doctorRepo(t)
+        const original = skillHooks.lookPath
+        skillHooks.lookPath = async () => false
+        t.cleanup(() => { skillHooks.lookPath = original })
+        const targets = await installationTargets('', '', { env:r.env })
+        await install(targets[0].path, false)
+        await git(r.dir, ['config', '--local', 'roast.gate', 'enabled'],
+            { env:r.env })
+        const res = await doctor(r)
+        t.equal(res.code, 0, 'warnings do not fail')
+        t.equal(res.rows.find(x => x.name === 'git-gate')?.status,
+            'warn', 'enabled but absent gate warns')
+        t.equal(res.rows.find(x => x.name === 'agents-skill')?.status,
+            'pass', 'user install found')
+        fs.writeFileSync(path.join(targets[0].path, 'SKILL.md'), 'stale')
+        t.equal((await doctor(r)).rows.find(x =>
+            x.name === 'agents-skill')?.status, 'warn', 'stale warns')
+        fs.rmSync(targets[0].path, { recursive:true })
+        fs.symlinkSync(r.dir, targets[0].path)
+        t.equal((await doctor(r)).rows.find(x =>
+            x.name === 'agents-skill')?.status, 'pass', 'symlink passes')
+        const outside = tempDir()
+        t.cleanup(outside.remove)
+        fs.writeFileSync(path.join(outside.dir, '.roast.json'),
+            JSON.stringify(BUILTIN))
+        const out = await doctor(outside)
+        t.equal(out.code, 0, 'outside repository only warns')
+        t.equal(out.rows.find(x => x.name === 'git')?.status,
+            'warn', 'git warns')
+        t.ok(!out.rows.some(x => x.name === 'git-gate'), 'gate omitted')
+        const text = await runRoast(['doctor'], { cwd:r.dir, env:r.env })
+        t.equal(text.code, 0, 'text mode')
+        t.equal(text.stdout.split('\n').filter(Boolean).length,
+            res.rows.length, 'one text line per result')
+        t.equal((await doctor(r, ['extra'])).code, 2, 'rejects positional')
+    })
+
+export async function approveDoctorConfig (r:TempDir):Promise<void> {
+    const res = await runRoast(['trust', '--yes'],
+        { cwd:r.dir, env:r.env })
+    if (res.code !== 0) throw new Error(res.stderr)
+}
+
+test('doctor inspects both stored scopes even with an environment key',
+    async t => {
+        const r = doctorRepo(t)
+        r.env.OPENAI_API_KEY = 'environment-secret'
+        const project = await projectCredentialsPath(r.dir, { env:r.env })
+        const user = userCredentialsPath(r.env)
+        const secret = 'stored-secret-do-not-print'
+        for (const file of [project, user]) {
+            await saveCredential(file, 'openai', secret, new Date())
+        }
+        const usable = await doctor(r)
+        t.equal(usable.code, 0, usable.stderr)
+        for (const scope of ['project', 'user']) {
+            const row = usable.rows.find(x => x.name ===
+                `${scope}-credentials`)
+            t.equal(row?.status, 'pass', `${scope} reported`)
+            t.ok(row?.detail.includes('(openai)'), 'provider reported')
+        }
+        t.ok(!usable.stdout.includes(secret), 'stored key omitted')
+        for (const [scope, file] of [['project', project], ['user', user]]) {
+            fs.writeFileSync(file, JSON.stringify({
+                version:1, providers:{ openai:{ key:secret } }, bogus:true,
+            }))
+            const broken = await doctor(r)
+            t.equal(broken.code, 4, `${scope} broken fails`)
+            t.equal(broken.rows.find(x => x.name ===
+                `${scope}-credentials`)?.status, 'fail', 'failure row')
+            t.ok(broken.rows.some(x => x.name === 'proxy-env'),
+                'later checks run')
+            t.ok(!(broken.stdout + broken.stderr).includes(secret),
+                'no key in error output')
+            fs.unlinkSync(file)
+        }
+        const absent = await doctor(r)
+        t.equal(absent.code, 0, 'absent files pass')
+        t.ok(!absent.rows.some(x => x.name.endsWith('-credentials')),
+            'absent files omitted')
+    })
+
+test('doctor requires current clone approval for custom endpoints', async t => {
+    const r = doctorRepo(t)
+    t.equal((await doctor(r)).rows.find(x =>
+        x.name === 'config-trust')?.status, 'pass', 'built-in needs none')
+    fs.writeFileSync(path.join(r.dir, '.roast.json'), JSON.stringify({
+        ...BUILTIN,
+        inference_profiles:{
+            o:{ model:'m', endpoint:'https://gateway.example/v1' },
+        },
+    }))
+    const unapproved = await doctor(r)
+    t.equal(unapproved.code, 4, 'unapproved fails')
+    t.equal(unapproved.rows.find(x => x.name === 'config-trust')?.status,
+        'fail', 'trust fails')
+    await approveDoctorConfig(r)
+    t.equal((await doctor(r)).code, 0, 'v2 approval passes')
+    const file = path.join(r.dir, '.git', 'roast', 'trust.json')
+    fs.writeFileSync(file, JSON.stringify({ version:1, approved:['old'] }))
+    const legacy = await doctor(r)
+    t.equal(legacy.code, 4, 'legacy fails')
+    const detail = legacy.rows.find(x => x.name === 'config-trust')?.detail
+    t.ok(detail?.includes('older Roast'), 'explains legacy approval')
+    t.ok(detail?.includes('npx roast trust'), 'names approval command')
+    fs.writeFileSync(file, '{')
+    t.equal((await doctor(r)).code, 4, 'malformed approval fails')
+})
+
+test('doctor diagnoses proxy variables without exposing the URL', async t => {
+    const r = doctorRepo(t)
+    const secret = 'https://user:proxy-secret@example.com:8080'
+    for (const variable of ['HTTPS_PROXY', 'https_proxy']) {
+        r.env[variable] = secret
+        const res = await doctor(r)
+        t.equal(res.code, 0, res.stderr)
+        t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,
+            'warn', variable)
+        t.ok(!res.stdout.includes(secret), 'proxy URL omitted')
+        r.env.NODE_USE_ENV_PROXY = '1'
+        const honored = await doctor(r)
+        t.equal(honored.code, 0, honored.stderr)
+        t.equal(honored.rows.find(row => row.name === 'proxy-env')?.status,
+            'pass', 'proxy enabled')
+        delete r.env[variable]
+        delete r.env.NODE_USE_ENV_PROXY
+    }
+    const res = await doctor(r)
+    t.equal(res.code, 0, res.stderr)
+    t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,
+        'pass', 'no proxy')
+})
