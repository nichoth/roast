// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a
// temporary Git repository as cwd, a clean environment, and optionally a
// fetch that sends every request to a fake server.
import { run, type RunResult } from '../../src/cli/run.js'
import { BufferStream, inputStream } from './streams.js'
import { tempRepo } from './repo.js'

export interface RunRoastOpts {
    // Working directory; a fresh temporary repository when absent.
    cwd?:string;
    // The environment; the repository's isolated env when absent.
    env?:Record<string, string>;
    stdin?:NodeJS.ReadableStream|string;
    signal?:AbortSignal;
    // Origin (`http://127.0.0.1:port`) every request is redirected to.
    redirectTo?:string;
}

export interface RunRoastResult extends RunResult {
    stdout:string;
    stderr:string;
    // The original host of every redirected request, in order.
    hosts:string[];
}

// A fetch that rewrites each URL's origin to `origin`, recording the
// original host (Go redirectDefaultTransport).
export function redirectingFetch (
    origin:string,
    hosts:string[]
):typeof globalThis.fetch {
    return (input, init) => {
        const req = new Request(input, init)
        const url = new URL(req.url)
        hosts.push(url.host)
        const target = new URL(url.pathname + url.search, origin)
        return globalThis.fetch(new Request(target, req))
    }
}

export async function runRoast (
    args:string[],
    opts:RunRoastOpts = {}
):Promise<RunRoastResult> {
    let cwd = opts.cwd
    let env = opts.env
    let remove:(() => void)|undefined
    if (cwd === undefined) {
        const repo = tempRepo()
        cwd = repo.dir
        env ??= repo.env
        remove = repo.remove
    }
    const stdout = new BufferStream()
    const stderr = new BufferStream()
    const hosts:string[] = []
    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?
        inputStream(opts.stdin ?? '') :
        opts.stdin
    try {
        const res = await run(args, {
            stdin,
            stdout,
            stderr,
            env:env ?? {},
            cwd,
            signal:opts.signal,
            fetch:opts.redirectTo ?
                redirectingFetch(opts.redirectTo, hosts) :
                undefined,
        })
        return {
            ...res,
            stdout:stdout.text(),
            stderr:stderr.text(),
            hosts,
        }
    } finally {
        remove?.()
    }
}
// Temporary directories and Git repositories for CLI tests, with an
// environment that isolates the user's home and config directories and
// gives Git an identity (CI runners have none).
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { cleanEnv } from './env.js'

export interface TempDir {
    dir:string;
    env:Record<string, string>;
    remove ():void;
}

function makeTemp (prefix:string):string {
    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))
}

// The base test environment: the process env without provider or roast
// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside
// `root`, a Git identity, and no Git discovery above `root`.
export function isolatedEnv (root:string):Record<string, string> {
    const home = path.join(root, '.home')
    fs.mkdirSync(home, { recursive:true })
    return {
        ...cleanEnv(process.env),
        HOME:home,
        XDG_CONFIG_HOME:path.join(home, '.config'),
        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),
        GIT_AUTHOR_NAME:'Roast Test',
        GIT_AUTHOR_EMAIL:'roast-test@example.com',
        GIT_COMMITTER_NAME:'Roast Test',
        GIT_COMMITTER_EMAIL:'roast-test@example.com',
        GIT_CEILING_DIRECTORIES:path.dirname(root),
        GIT_CONFIG_NOSYSTEM:'1',
    }
}

// A temporary directory that is not inside any Git repository. The test
// working directory is `dir/work`.
export function tempDir (prefix = 'roast-dir-'):TempDir {
    const root = makeTemp(prefix)
    const dir = path.join(root, 'work')
    fs.mkdirSync(dir)
    return {
        dir,
        env:isolatedEnv(root),
        remove:() => fs.rmSync(root, { recursive:true, force:true }),
    }
}

// A temporary Git repository at `dir` (realpath, so it compares equal to
// what Git prints).
export function tempRepo (prefix = 'roast-repo-'):TempDir {
    const t = tempDir(prefix)
    execFileSync('git', ['init', '-q', t.dir], { env:t.env })
    return t
}
// `roast trust` (spec 03, 2.7, 2.9, 5.4) run in-process.
import fs from 'node:fs'
import path from 'node:path'
import { Readable } from 'node:stream'
import { test, type CleanupTest } from '../helpers/test.js'
import { runRoast } from '../helpers/run.js'
import { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'

const GATEWAY = 'https://gw.example/v1'

// A config with a custom finder, a routed profile, a built-in verifier,
// and two prompt overrides.
const CUSTOM = {
    version:1,
    inference_profiles:{
        gateway_profile:{
            model:'m',
            endpoint:GATEWAY,
            protocol:'chat',
            api_key_env:'GW_KEY',
        },
        routed_profile:{
            model:'m',
            endpoint:'https://routed.example/v2',
            protocol:'responses',
        },
        claude_profile:{ model:'m', protocol:'anthropic' },
    },
    roles:{
        finder:{
            profile:'gateway_profile',
            author_routes:{ openai:'routed_profile' },
        },
        verifier:{ profile:'claude_profile' },
    },
    prompts:{ finder_code:'prompts/code.md', verifier:'verify.md' },
}

const BUILTIN = {
    version:1,
    inference_profiles:{
        o:{ model:'m' },
        a:{ model:'m', protocol:'anthropic' },
    },
    roles:{
        finder:{ profile:'o', author_routes:{ openai:'a' } },
        verifier:{ profile:'a' },
    },
}

function repoWith (t:CleanupTest, cfg:unknown):TempDir {
    const r = tempRepo()
    t.cleanup(r.remove)
    const body = typeof cfg === 'string' ? cfg : JSON.stringify(cfg)
    fs.writeFileSync(path.join(r.dir, '.roast.json'), body)
    return r
}

function stateDir (r:TempDir):string {
    return path.join(r.dir, '.git', 'roast')
}

function approved (r:TempDir):string[] {
    const file = path.join(stateDir(r), 'trust.json')
    if (!fs.existsSync(file)) return []
    return JSON.parse(fs.readFileSync(file, 'utf8')).approved
}

function trust (
    r:TempDir,
    args:string[] = [],
    stdin:string|NodeJS.ReadableStream = ''
) {
    return runRoast(['trust', ...args], { cwd:r.dir, env:r.env, stdin })
}

test('trust on a built-in-only config needs no approval', async t => {
    const r = repoWith(t, BUILTIN)
    const res = await trust(r)
    t.equal(res.code, 0, `exits 0 ${res.stderr}`)
    t.ok(!fs.existsSync(stateDir(r)), 'no state directory')
})

test('trust summary names every security-relevant value', async t => {
    const r = repoWith(t, CUSTOM)
    const res = await trust(r, ['--yes'])
    t.equal(res.code, 0, `exits 0 ${res.stderr}`)
    for (const value of [
        'gateway_profile', 'routed_profile', 'claude_profile',
        GATEWAY, 'https://routed.example/v2', 'https://api.anthropic.com/v1',
        'chat', 'responses', 'anthropic',
        'GW_KEY', 'ANTHROPIC_API_KEY',
        'prompts/code.md', 'verify.md',
        'roles.finder.author_routes.openai',
    ]) {
        t.ok(res.stdout.includes(value), `names ${value}`)
    }
    t.equal(approved(r).length, 1, 'approval recorded')
})

// Bytes 0x00-0x08, 0x0b-0x1f, and 0x7f; newline is the only allowed
// control character in the summary.
function hasRawControl (s:string):boolean {
    for (let i = 0; i < s.length; i++) {
        const c = s.charCodeAt(i)
        if ((c < 0x20 && c !== 0x0a) || c === 0x7f) return true
    }
    return false
}

test('trust summary escapes control characters', async t => {
    const r = repoWith(t, `{
  "version": 1,
  "inference_profiles": {
    "evil\\u001b[2J\\nINJECTED": {"endpoint": "https://gw.example/v1",
      "model": "m", "protocol": "chat", "api_key_env": "GW_KEY"}
  },
  "roles": {
    "finder": {"profile": "evil\\u001b[2J\\nINJECTED",
      "author_routes": {"x\\u0007\\nINJECTED": "evil\\u001b[2J\\nINJECTED"}},
    "verifier": {"profile": "evil\\u001b[2J\\nINJECTED"}
  },
  "prompts": {"verifier": "prompt\\r\\nINJECTED\\u0007"}
}`)
    const res = await trust(r, [], 'n\n')
    t.equal(res.code, 2, `declined exits 2 ${res.stderr}`)
    t.ok(res.stdout.includes('evil'), 'summary printed')
    t.ok(!hasRawControl(res.stdout), 'no raw control characters')
    const lines = res.stdout.split('\n')
    t.ok(!lines.some(l => l.trimStart().startsWith('INJECTED')),
        'no config value starts its own line')
})

test('trust usage errors exit 2', async t => {
    const outside = tempDir()
    t.cleanup(outside.remove)
    fs.writeFileSync(path.join(outside.dir, '.roast.json'),
        JSON.stringify(CUSTOM))
    const res = await runRoast(['trust', '--yes'],
        { cwd:outside.dir, env:outside.env })
    t.equal(res.code, 2, 'outside a repository')

    const r = repoWith(t, CUSTOM)
    t.equal((await trust(r, ['--yes', 'extra'])).code, 2, 'extra argument')
    t.deepEqual(approved(r), [], 'extra argument records nothing')

    const none = tempRepo()
    t.cleanup(none.remove)
    const noConfig = await runRoast(['trust', '--yes'],
        { cwd:none.dir, env:none.env })
    t.equal(noConfig.code, 2, 'no config')

    const bad = repoWith(t, { version:1, bogus:true })
    t.equal((await trust(bad, ['--yes'])).code, 2, 'invalid config')
    t.ok(!fs.existsSync(stateDir(bad)), 'nothing written')
})

test('trust records approval only on yes', async t => {
    for (const answer of ['', '\n', 'n\n', 'no\n', 'yy\n', 'sure\n']) {
        const r = repoWith(t, CUSTOM)
        const res = await trust(r, [], answer)
        t.equal(res.code, 2, `${JSON.stringify(answer)} exits 2`)
        t.ok(res.stdout.includes('[y/N]'), 'asks')
        t.ok(!fs.existsSync(stateDir(r)), 'records nothing')
    }
    for (const answer of ['y\n', 'Y\n', 'yes\n', 'y']) {
        const r = repoWith(t, CUSTOM)
        const res = await trust(r, [], answer)
        t.equal(res.code, 0, `${JSON.stringify(answer)} exits 0`)
        t.equal(approved(r).length, 1, 'records one approval')
    }
})

test('trust --yes records approval without reading stdin', async t => {
    let reads = 0
    const stdin = new Readable({
        read () {
            reads++
            this.destroy(new Error('stdin must not be read'))
        },
    })
    const r = repoWith(t, CUSTOM)
    const res = await trust(r, ['--yes'], stdin)
    t.equal(res.code, 0, `exits 0 ${res.stderr}`)
    t.equal(reads, 0, 'stdin never read')
    t.equal(approved(r).length, 1, 'approval recorded')
    const again = await trust(r, ['--yes'], stdin)
    t.equal(again.code, 0, 'approving again exits 0')
    t.equal(approved(r).length, 1, 'still one approval')
})

test('trust reports a stdin read error as a non-usage error', async t => {
    const stdin = new Readable({
        read () {
            this.destroy(new Error('broken stdin'))
        },
    })
    const r = repoWith(t, CUSTOM)
    const res = await trust(r, [], stdin)
    t.equal(res.code, 4, 'exits 4')
    t.ok(!fs.existsSync(stateDir(r)), 'records nothing')
})
// Bundles the CLI (default), the test entry (--test), the live-test
// entry (--live), or the Go-vs-TS differential harness (--diff) with
// esbuild. Run directly by Node (type stripping), so
// only erasable TypeScript syntax is allowed here.
import { execFileSync } from 'node:child_process'
import { readFileSync } from 'node:fs'
import { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
import { resolve } from 'node:path'
import { build } from 'esbuild'
import type { Metafile } from 'esbuild'
import { ROOT, baseOptions } from './esbuild-options.ts'
import {
    bundledPackageDirs,
    readBundledPackages,
    renderNotices,
} from './licenses.ts'

const SHEBANG = '#!/usr/bin/env node'
// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into
// a runtime "Dynamic require is not supported" error unless a `require`
// is in scope.
const REQUIRE_SHIM = [
    "import { createRequire as __roastRequire } from 'node:module'",
    'const require = __roastRequire(import.meta.url)',
].join('\n')

type Mode = 'cli'|'test'|'live'|'diff'

function parseMode (args:string[]):Mode {
    if (args.length === 0) return 'cli'
    if (args.length === 1 && args[0] === '--test') return 'test'
    if (args.length === 1 && args[0] === '--live') return 'live'
    if (args.length === 1 && args[0] === '--diff') return 'diff'
    throw new Error('usage: node scripts/bundle.ts [--test|--live|--diff], ' +
        `got ${args.join(' ')}`)
}

// Runs git at the repository root; `unknown` when git fails (a build
// from a tarball, no git on PATH).
function git (args:string[]):string {
    try {
        const out = execFileSync('git', args, {
            cwd:ROOT,
            encoding:'utf8',
            stdio:['ignore', 'pipe', 'ignore'],
        }).trim()
        return out || 'unknown'
    } catch {
        return 'unknown'
    }
}

async function packageVersion ():Promise<string> {
    const text = await readFile(new URL('package.json', `file://${ROOT}`),
        'utf8')
    const version = JSON.parse(text).version
    if (typeof version !== 'string') {
        throw new Error('package.json has no string version')
    }
    return version
}

// Writes dist/THIRD_PARTY_LICENSES.txt from the metafile (spec 15, 2.6).
// Throws, naming the package, when a bundled package fails validation.
async function writeThirdPartyNotices (metafile:Metafile):Promise<void> {
    const dirs = bundledPackageDirs(metafile, 'dist/cli.js')
        .map(dir => resolve(ROOT, dir))
    const notices = renderNotices(readBundledPackages(dirs),
        path => readFileSync(path, 'utf8'))
    await writeFile(new URL('dist/THIRD_PARTY_LICENSES.txt',
        `file://${ROOT}`), notices)
}

async function bundleCli ():Promise<void> {
    const dist = new URL('dist/', `file://${ROOT}`)
    await rm(dist, { recursive:true, force:true })
    await mkdir(dist, { recursive:true })

    const version = await packageVersion()
    const commit = git(['rev-parse', '--short=7', 'HEAD'])
    const date = git(['log', '-1', '--format=%cI'])

    const result = await build({
        ...baseOptions(),
        entryPoints:['src/cli.ts'],
        outfile:'dist/cli.js',
        tsconfig:'tsconfig.build.json',
        metafile:true,
        banner:{ js:`${SHEBANG}\n${REQUIRE_SHIM}` },
        define:{
            __ROAST_VERSION__:JSON.stringify(version),
            __ROAST_COMMIT__:JSON.stringify(commit),
            __ROAST_DATE__:JSON.stringify(date),
        },
    })
    const metafile = result.metafile
    if (!metafile) throw new Error('esbuild returned no metafile')
    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))
    await writeThirdPartyNotices(metafile)
    await chmod(new URL('cli.js', dist), 0o755)
}

async function bundleTests (entry:string, outfile:string):Promise<void> {
    await build({
        ...baseOptions(),
        entryPoints:[entry],
        outfile,
        tsconfig:'tsconfig.json',
        banner:{ js:REQUIRE_SHIM },
    })
}

async function main ():Promise<void> {
    const mode = parseMode(process.argv.slice(2))
    if (mode === 'cli') return bundleCli()
    if (mode === 'test') {
        return bundleTests('test/index.ts', 'test/test-bundle.js')
    }
    if (mode === 'diff') {
        return bundleTests('test/diff/index.ts', 'test/diff-bundle.js')
    }
    return bundleTests('test/live/index.ts', 'test/live-bundle.js')
}

try {
    await main()
} catch (err) {
    // esbuild has already printed its own diagnostics for build errors.
    console.error(err instanceof Error ? err.message : err)
    process.exitCode = 1
}

