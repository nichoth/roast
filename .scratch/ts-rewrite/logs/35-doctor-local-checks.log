// Per-clone approvals of project configs (spec 03, 2.5 and 2.6). The
// record lives under the Git common directory, which `git clone` never
// copies, so a repository cannot ship its own approval.
import fs from 'node:fs/promises'
import path from 'node:path'
import { git } from '../git/git.js'
import { writeFileAtomic } from '../fsutil/atomic.js'

export const TRUST_FILE = 'trust.json'
const CURRENT_VERSION = 2
const LEGACY_VERSION = 1

export interface TrustOpts {
    signal?:AbortSignal;
    // The git environment, normally the CLI context's env.
    env?:NodeJS.ProcessEnv;
}

export type TrustRecord =
    { kind:'current', approved:string[] }|{ kind:'legacy' }

export type ApprovalState = 'approved'|'not-approved'|'legacy'

function message (err:unknown):string {
    return err instanceof Error ? err.message : String(err)
}

// <git-common-dir>/roast for the repository containing `dir`. Linked
// worktrees share the main repository's.
export async function stateDir (
    dir:string,
    opts:TrustOpts = {}
):Promise<string> {
    let out:Buffer
    try {
        out = await git(dir, ['rev-parse', '--path-format=absolute',
            '--git-common-dir'], opts)
    } catch (err) {
        if (opts.signal?.aborted) throw err
        throw new Error('not inside a git repository', { cause:err })
    }
    return path.join(out.toString('utf8').trim(), 'roast')
}

export async function trustPath (
    dir:string,
    opts:TrustOpts = {}
):Promise<string> {
    try {
        return path.join(await stateDir(dir, opts), TRUST_FILE)
    } catch (err) {
        if (opts.signal?.aborted) throw err
        throw new Error(`trust: ${message(err)}`, { cause:err })
    }
}

function isObject (v:unknown):v is Record<string, unknown> {
    return typeof v === 'object' && v !== null && !Array.isArray(v)
}

// Reads the record at `file`. An absent file is an empty current record;
// a version 1 file (Go era) is legacy; anything else is an error.
export async function readTrustRecord (file:string):Promise<TrustRecord> {
    let text:string
    try {
        text = await fs.readFile(file, 'utf8')
    } catch (err) {
        if ((err as NodeJS.ErrnoException).code === 'ENOENT') {
            return { kind:'current', approved:[] }
        }
        throw new Error(`read trust record: ${message(err)}`, { cause:err })
    }
    const invalid = (cause:string):Error =>
        new Error(`read trust record ${file}: ${cause}`)
    let doc:unknown
    try {
        doc = JSON.parse(text)
    } catch (err) {
        throw invalid(message(err))
    }
    if (!isObject(doc)) throw invalid('not a JSON object')
    const version = doc.version
    if (version === LEGACY_VERSION) return { kind:'legacy' }
    if (version !== CURRENT_VERSION) {
        const shown = version === undefined ? 0 : JSON.stringify(version)
        throw new Error(`trust record ${file} has unsupported version ` +
            `${shown}`)
    }
    const approved = doc.approved ?? []
    if (!Array.isArray(approved) ||
        !approved.every(h => typeof h === 'string')) {
        throw invalid('approved must be an array of strings')
    }
    return { kind:'current', approved }
}

export async function isApproved (
    dir:string,
    hash:string,
    opts:TrustOpts = {}
):Promise<ApprovalState> {
    const rec = await readTrustRecord(await trustPath(dir, opts))
    if (rec.kind === 'legacy') return 'legacy'
    return rec.approved.includes(hash) ? 'approved' : 'not-approved'
}

// Records `hash` for this clone. A legacy record is replaced, not
// migrated; a malformed one aborts with the file untouched.
export async function approve (
    dir:string,
    hash:string,
    opts:TrustOpts = {}
):Promise<void> {
    const file = await trustPath(dir, opts)
    const rec = await readTrustRecord(file)
    let approved = [hash]
    if (rec.kind === 'current') {
        if (rec.approved.includes(hash)) return
        approved = [...rec.approved, hash]
    }
    const body = { version:CURRENT_VERSION, approved }
    await writeFileAtomic(file, JSON.stringify(body, null, 2) + '\n', {
        mode:0o600,
        tempPrefix:'trust-',
        tempSuffix:'.json',
        dirMode:0o755,
        errorPrefix:'write trust record',
    })
}
// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a
// temporary Git repository as cwd, a clean environment, and optionally a
// fetch that sends every request to a fake server.
import { run, type RunResult } from '../../src/cli/run.js'
import { BufferStream, inputStream } from './streams.js'
import { tempRepo } from './repo.js'

export interface RunRoastOpts {
    // Working directory; a fresh temporary repository when absent.
    cwd?:string;
    // The environment; the repository's isolated env when absent.
    env?:Record<string, string>;
    stdin?:NodeJS.ReadableStream|string;
    signal?:AbortSignal;
    // Origin (`http://127.0.0.1:port`) every request is redirected to.
    redirectTo?:string;
}

export interface RunRoastResult extends RunResult {
    stdout:string;
    stderr:string;
    // The original host of every redirected request, in order.
    hosts:string[];
}

// A fetch that rewrites each URL's origin to `origin`, recording the
// original host (Go redirectDefaultTransport).
export function redirectingFetch (
    origin:string,
    hosts:string[]
):typeof globalThis.fetch {
    return (input, init) => {
        const req = new Request(input, init)
        const url = new URL(req.url)
        hosts.push(url.host)
        const target = new URL(url.pathname + url.search, origin)
        return globalThis.fetch(new Request(target, req))
    }
}

export async function runRoast (
    args:string[],
    opts:RunRoastOpts = {}
):Promise<RunRoastResult> {
    let cwd = opts.cwd
    let env = opts.env
    let remove:(() => void)|undefined
    if (cwd === undefined) {
        const repo = tempRepo()
        cwd = repo.dir
        env ??= repo.env
        remove = repo.remove
    }
    const stdout = new BufferStream()
    const stderr = new BufferStream()
    const hosts:string[] = []
    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?
        inputStream(opts.stdin ?? '') :
        opts.stdin
    try {
        const res = await run(args, {
            stdin,
            stdout,
            stderr,
            env:env ?? {},
            cwd,
            signal:opts.signal,
            fetch:opts.redirectTo ?
                redirectingFetch(opts.redirectTo, hosts) :
                undefined,
        })
        return {
            ...res,
            stdout:stdout.text(),
            stderr:stderr.text(),
            hosts,
        }
    } finally {
        remove?.()
    }
}
// Temporary directories and Git repositories for CLI tests, with an
// environment that isolates the user's home and config directories and
// gives Git an identity (CI runners have none).
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { cleanEnv } from './env.js'

export interface TempDir {
    dir:string;
    env:Record<string, string>;
    remove ():void;
}

function makeTemp (prefix:string):string {
    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))
}

// The base test environment: the process env without provider or roast
// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside
// `root`, a Git identity, and no Git discovery above `root`.
export function isolatedEnv (root:string):Record<string, string> {
    const home = path.join(root, '.home')
    fs.mkdirSync(home, { recursive:true })
    return {
        ...cleanEnv(process.env),
        HOME:home,
        XDG_CONFIG_HOME:path.join(home, '.config'),
        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),
        GIT_AUTHOR_NAME:'Roast Test',
        GIT_AUTHOR_EMAIL:'roast-test@example.com',
        GIT_COMMITTER_NAME:'Roast Test',
        GIT_COMMITTER_EMAIL:'roast-test@example.com',
        GIT_CEILING_DIRECTORIES:path.dirname(root),
        GIT_CONFIG_NOSYSTEM:'1',
    }
}

// A temporary directory that is not inside any Git repository. The test
// working directory is `dir/work`.
export function tempDir (prefix = 'roast-dir-'):TempDir {
    const root = makeTemp(prefix)
    const dir = path.join(root, 'work')
    fs.mkdirSync(dir)
    return {
        dir,
        env:isolatedEnv(root),
        remove:() => fs.rmSync(root, { recursive:true, force:true }),
    }
}

// A temporary Git repository at `dir` (realpath, so it compares equal to
// what Git prints).
export function tempRepo (prefix = 'roast-repo-'):TempDir {
    const t = tempDir(prefix)
    execFileSync('git', ['init', '-q', t.dir], { env:t.env })
    return t
}

