// pattern: Imperative Shell
// Paste login uses only the registry's built-in endpoints and the
// command's shared reader, fetch, environment, and cancellation signal.
import {
    builtinProviders,
    lookupProvider,
    providerAt,
    type BuiltinProvider,
} from '../config/provider.js'
import type { Env } from '../config/credential.js'
import type { ProjectConfig } from '../config/load.js'
import { resolveRole, type RoleName } from '../config/role.js'
import {
    projectCredentialsPath,
    saveCredential,
    userCredentialsPath,
    type CredentialScope,
} from '../credentials/credentials.js'
import { goQuote } from '../gocompat/strings.js'
import { abortable } from '../llm/capture.js'
import { AuthError, EndpointError } from '../llm/errors.js'
import type { CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'
import { loadProjectConfig, NO_PROJECT_CONFIG } from './config.js'
import { interactiveTerminals, openBrowser, readSecret } from './terminal.js'

export type LoginContext = Pick<RunContext,
    'cwd'|'env'|'signal'|'fetch'|'stdin'|'stdout'|'stderr'|'lines'>

export interface LoginFlags {
    global:boolean;
    noBrowser:boolean;
}

export interface LoginTarget {
    path:string;
    scope:CredentialScope;
}

export function providerNames ():string {
    return builtinProviders().map(p => p.name).join(', ')
}

export async function loginPath (
    global:boolean,
    ctx:LoginContext
):Promise<LoginTarget> {
    if (global) {
        return { path:userCredentialsPath(ctx.env), scope:'user' }
    }
    try {
        const path = await projectCredentialsPath(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
        return { path, scope:'project' }
    } catch (err) {
        if (ctx.signal.aborted) throw err
        throw new UsageError('not in a Git repository; use --global ' +
            'to store the key for the user', { cause:err })
    }
}

export function keyCheckPath (provider:BuiltinProvider):string {
    return provider.name === 'openrouter' ? '/key' : '/models'
}

class KeyRejected extends Error {}

// Discard at most 32 KiB, then cancel even if the provider keeps sending.
async function drainValidationBody (
    response:Response,
    signal:AbortSignal
):Promise<void> {
    if (!response.body) return
    const reader = response.body.getReader()
    let size = 0
    try {
        while (size < 32 * 1024) {
            const chunk = await abortable(reader.read(), signal)
            if (chunk.done) return
            size += chunk.value.byteLength
        }
    } finally {
        await reader.cancel().catch(() => {})
        reader.releaseLock()
    }
}

export async function validateKey (
    provider:BuiltinProvider,
    key:string,
    ctx:LoginContext
):Promise<void> {
    const url = provider.endpoint.replace(/\/+$/, '') +
        keyCheckPath(provider)
    const signal = AbortSignal.any([
        ctx.signal,
        AbortSignal.timeout(30_000),
    ])
    const prefix = 'llm: inference endpoint failure: check key at ' + url
    let response:Response
    try {
        response = await ctx.fetch(url, {
            method:'GET',
            redirect:'manual',
            signal,
            headers:provider.protocols[0] === 'anthropic' ? {
                'x-api-key':key,
                'anthropic-version':'2023-06-01',
            } : { Authorization:`Bearer ${key}` },
        })
        await drainValidationBody(response, signal)
    } catch (err) {
        const message = err instanceof Error ? err.message : String(err)
        throw new EndpointError(`${prefix}: ${message}`, { cause:err })
    }
    if (response.status >= 300 && response.status < 400) {
        throw new EndpointError(`${prefix}: redirect refused`)
    }
    if (response.status === 401 || response.status === 403) {
        throw new KeyRejected()
    }
    if (!response.ok) {
        throw new EndpointError(`${prefix}: HTTP ${response.status} ` +
            response.statusText)
    }
}

async function pasteLogin (
    provider:BuiltinProvider,
    flags:LoginFlags,
    ctx:LoginContext
):Promise<string> {
    ctx.stderr.write(`Create a ${provider.name} API key at:\n` +
        `  ${provider.keyPage}\n`)
    if (!flags.noBrowser) {
        const err = await openBrowser(provider.keyPage, ctx.signal)
        if (err) {
            ctx.stderr.write(`could not open a browser (${err.message}); ` +
                'open the URL above\n')
        }
    }
    for (let attempt = 0; attempt < 3; attempt++) {
        let key:string
        try {
            key = await readSecret(ctx.stderr, ctx.stdin, ctx.lines,
                'Paste the key: ')
        } catch (err) {
            const message = err instanceof Error ? err.message : String(err)
            throw new Error(`read key: ${message}`, { cause:err })
        }
        if (key === '') {
            ctx.stderr.write('no key entered\n')
            continue
        }
        try {
            await validateKey(provider, key, ctx)
            return key
        } catch (err) {
            if (!(err instanceof KeyRejected)) throw err
            ctx.stderr.write(`${provider.name} rejected the key; ` +
                'try again\n')
        }
    }
    throw new AuthError('llm: authentication failed: no accepted ' +
        `${provider.name} key after 3 tries; nothing stored`)
}

export async function runLogin (
    name:string,
    flags:LoginFlags,
    ctx:LoginContext
):Promise<void> {
    const provider = lookupProvider(name)
    if (!provider) {
        throw new UsageError(`unknown provider ${goQuote(name)}; ` +
            `built-in providers: ${providerNames()}`)
    }
    if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {
        throw new UsageError('login needs an interactive terminal; ' +
            `set ${provider.keyEnv} instead`)
    }
    const target = await loginPath(flags.global, ctx)
    await loginProvider(provider, flags, target, ctx)
}

export async function loginProvider (
    provider:BuiltinProvider,
    flags:LoginFlags,
    target:LoginTarget,
    ctx:LoginContext
):Promise<void> {
    // Ticket 32 supplies the browser flow at this dispatch point.
    if (provider.login === 'browser') {
        throw new Error(`login to ${provider.name} is not supported; ` +
            `set ${provider.keyEnv}`)
    }
    const key = await pasteLogin(provider, flags, ctx)
    await saveCredential(target.path, provider.name, key, new Date())
    ctx.stdout.write(`stored ${provider.name} credential ` +
        `(${target.scope} scope)\n`)
}

export function providersNeedingLogin (
    cfg:ProjectConfig,
    env:Env
):Array<BuiltinProvider> {
    const providers:Array<BuiltinProvider> = []
    for (const name of Object.keys(cfg.roles).sort()) {
        let role
        try {
            role = resolveRole(cfg, name as RoleName, env)
        } catch (err) {
            const message = err instanceof Error ? err.message : String(err)
            throw new UsageError(message, { cause:err })
        }
        if (role.apiKey !== '') continue
        const provider = providerAt(role.baseURL, role.protocol)
        if (provider && !providers.some(p => p.name === provider.name)) {
            providers.push(provider)
        }
    }
    return providers
}

export async function runLoginMissing (
    flags:LoginFlags,
    ctx:LoginContext
):Promise<void> {
    let cfg:ProjectConfig
    try {
        cfg = await loadProjectConfig('', ctx)
    } catch (err) {
        if (err instanceof UsageError && err.message === NO_PROJECT_CONFIG) {
            throw new UsageError('no project config (.roast.json) found; ' +
                'name a provider (`npx roast login <provider>`, one of ' +
                `${providerNames()}) or run \`npx roast init\``)
        }
        throw err
    }
    const providers = providersNeedingLogin(cfg, ctx.env)
    if (providers.length === 0) {
        ctx.stderr.write('every built-in provider the roles use already ' +
            'has a credential\n')
        return
    }
    if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {
        throw new UsageError('login needs an interactive terminal')
    }
    const target = await loginPath(flags.global, ctx)
    for (const provider of providers) {
        await loginProvider(provider, flags, target, ctx)
    }
}

export const loginCommand:CommandDef = {
    command:'login [provider]',
    describe:'Store an API key for a built-in provider',
    builder:y => y
        .positional('provider', { type:'string' })
        .option('global', {
            type:'boolean',
            default:false,
            describe:'Store the credential for the user',
        })
        .option('no-browser', {
            type:'boolean',
            default:false,
            describe:'Print the key page URL without opening a browser',
        }),
    handler:(args, ctx) => {
        const flags = {
            global:args.global === true,
            noBrowser:args['no-browser'] === true,
        }
        return args.provider === undefined ? runLoginMissing(flags, ctx) :
            runLogin(String(args.provider), flags, ctx)
    },
}
// pattern: Imperative Shell
// Shared provider fake for login and init. Inference replies can be
// supplied by callers when they also exercise a model request.
import {
    startInferenceServer,
    type Reply,
    type Script,
} from './inference-server.js'

export async function providerServer (inference?:Script) {
    const credentials:string[] = []
    const hooks = {
        answerModels:(key:string):number|Reply => key === '' ? 401 : 200,
    }
    const server = await startInferenceServer((req, n) => {
        const key = String(req.headers['x-api-key'] ??
            req.headers.authorization ?? '')
        credentials.push(key)
        if (req.method === 'GET' && req.path === '/v1/models') {
            if (req.headers['x-api-key'] &&
                req.headers['anthropic-version'] !== '2023-06-01') {
                return { status:400 }
            }
            const answer = hooks.answerModels(key)
            return typeof answer === 'number' ?
                { status:answer, body:'{}' } : answer
        }
        return inference?.(req, n) ?? { status:404 }
    })
    return { ...server, credentials, hooks }
}
// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a
// temporary Git repository as cwd, a clean environment, and optionally a
// fetch that sends every request to a fake server.
import { run, type RunResult } from '../../src/cli/run.js'
import { BufferStream, inputStream } from './streams.js'
import { tempRepo } from './repo.js'

export interface RunRoastOpts {
    // Working directory; a fresh temporary repository when absent.
    cwd?:string;
    // The environment; the repository's isolated env when absent.
    env?:Record<string, string>;
    stdin?:NodeJS.ReadableStream|string;
    signal?:AbortSignal;
    // Origin (`http://127.0.0.1:port`) every request is redirected to.
    redirectTo?:string;
}

export interface RunRoastResult extends RunResult {
    stdout:string;
    stderr:string;
    // The original host of every redirected request, in order.
    hosts:string[];
}

// A fetch that rewrites each URL's origin to `origin`, recording the
// original host (Go redirectDefaultTransport).
export function redirectingFetch (
    origin:string,
    hosts:string[]
):typeof globalThis.fetch {
    return (input, init) => {
        const req = new Request(input, init)
        const url = new URL(req.url)
        hosts.push(url.host)
        const target = new URL(url.pathname + url.search, origin)
        return globalThis.fetch(new Request(target, req))
    }
}

export async function runRoast (
    args:string[],
    opts:RunRoastOpts = {}
):Promise<RunRoastResult> {
    let cwd = opts.cwd
    let env = opts.env
    let remove:(() => void)|undefined
    if (cwd === undefined) {
        const repo = tempRepo()
        cwd = repo.dir
        env ??= repo.env
        remove = repo.remove
    }
    const stdout = new BufferStream()
    const stderr = new BufferStream()
    const hosts:string[] = []
    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?
        inputStream(opts.stdin ?? '') :
        opts.stdin
    try {
        const res = await run(args, {
            stdin,
            stdout,
            stderr,
            env:env ?? {},
            cwd,
            signal:opts.signal,
            fetch:opts.redirectTo ?
                redirectingFetch(opts.redirectTo, hosts) :
                undefined,
        })
        return {
            ...res,
            stdout:stdout.text(),
            stderr:stderr.text(),
            hosts,
        }
    } finally {
        remove?.()
    }
}
// Swaps the terminal hooks for a test and restores them at test end.
import { terminalHooks } from '../../src/cli/terminal.js'

interface Cleanup {
    cleanup (fn:() => void):void;
}

// Makes interactiveTerminals answer `value` until the test ends.
export function simulateTerminals (t:Cleanup, value:boolean):void {
    const saved = terminalHooks.interactiveTerminals
    terminalHooks.interactiveTerminals = () => value
    t.cleanup(() => { terminalHooks.interactiveTerminals = saved })
}

// Replaces openBrowser with a recorder; returns the URLs it was asked to
// open. Nothing is launched.
export function captureBrowser (t:Cleanup, error?:Error):string[] {
    const saved = terminalHooks.openBrowser
    const opened:string[] = []
    terminalHooks.openBrowser = async url => {
        opened.push(url)
        return error
    }
    t.cleanup(() => { terminalHooks.openBrowser = saved })
    return opened
}
// Shared terminal helpers (spec 01, 2.16): yes/no prompt, secret input,
// terminal detection, browser opening. Terminal detection and browser
// opening are swappable through `terminalHooks` so tests never touch a
// real terminal or launch a browser.
import { spawn } from 'node:child_process'
import { isatty } from 'node:tty'
import { goTrimSpace } from '../gocompat/strings.js'
import { CancelledError } from './errors.js'

// Reads a stream one character or line at a time. One reader serves every
// prompt in a command, so input buffered past one answer is kept for the
// next. The stream is attached lazily, on the first read.
export class LineReader {
    private readonly stream:NodeJS.ReadableStream
    private buf = ''
    private ended = false
    private error:Error|undefined
    private attached = false
    private wake:(() => void)|undefined

    constructor (stream:NodeJS.ReadableStream) {
        this.stream = stream
    }

    private attach ():void {
        if (this.attached) return
        this.attached = true
        const notify = ():void => {
            const w = this.wake
            this.wake = undefined
            w?.()
        }
        this.stream.setEncoding('utf8')
        this.stream.on('data', (chunk:string) => {
            this.buf += chunk
            notify()
        })
        this.stream.on('end', () => {
            this.ended = true
            notify()
        })
        this.stream.on('error', (err:Error) => {
            this.error = err
            notify()
        })
    }

    // Waits until the buffer holds data, the stream ended, or failed.
    private async fill ():Promise<void> {
        this.attach()
        while (this.buf === '' && !this.ended && !this.error) {
            this.stream.resume()
            await new Promise<void>(resolve => { this.wake = resolve })
        }
        this.stream.pause()
        if (this.buf === '' && this.error) throw this.error
    }

    // The next character, or null at end of input.
    async readChar ():Promise<string|null> {
        await this.fill()
        if (this.buf === '') return null
        const c = String.fromCodePoint(this.buf.codePointAt(0) as number)
        this.buf = this.buf.slice(c.length)
        return c
    }

    // The next line without its line ending, or null at end of input with
    // nothing read. A last line without a newline is returned as is.
    async readLine ():Promise<string|null> {
        let line = ''
        for (;;) {
            await this.fill()
            if (this.buf === '') return line === '' ? null : line
            const i = this.buf.indexOf('\n')
            if (i >= 0) {
                line += this.buf.slice(0, i)
                this.buf = this.buf.slice(i + 1)
                return line.endsWith('\r') ? line.slice(0, -1) : line
            }
            line += this.buf
            this.buf = ''
        }
    }
}

// Writes `<question> [Y/n] ` and reads one answer: empty, y, or yes (any
// case) is true; anything else, or end of input, is false.
export async function promptYesDefault (
    out:NodeJS.WritableStream,
    lines:LineReader,
    question:string
):Promise<boolean> {
    out.write(`${question} [Y/n] `)
    const answer = await lines.readLine()
    if (answer === null) return false
    const a = goTrimSpace(answer).toLowerCase()
    return a === '' || a === 'y' || a === 'yes'
}

// Writes `<question> [y/N] ` and reads one answer: only y or yes (any
// case, surrounding space ignored) is true; empty input, anything else,
// or end of input is false.
export async function promptNoDefault (
    out:NodeJS.WritableStream,
    lines:LineReader,
    question:string
):Promise<boolean> {
    out.write(`${question} [y/N] `)
    const answer = await lines.readLine()
    if (answer === null) return false
    const a = goTrimSpace(answer).toLowerCase()
    return a === 'y' || a === 'yes'
}

interface RawTTY {
    isTTY?:boolean;
    setRawMode?:(on:boolean) => unknown;
}

function rawCapable (stdin:NodeJS.ReadableStream):stdin is
    NodeJS.ReadableStream&Required<RawTTY> {
    const s = stdin as NodeJS.ReadableStream&RawTTY
    return s.isTTY === true && typeof s.setRawMode === 'function'
}

const CTRL_C = '\x03'
const CTRL_D = '\x04'
const BACKSPACE = '\x08'
const DELETE = '\x7f'

// Reads one line in raw mode without echo. Ctrl-C cancels.
async function readRawLine (lines:LineReader):Promise<string|null> {
    let line = ''
    for (;;) {
        const c = await lines.readChar()
        if (c === null) return line === '' ? null : line
        if (c === '\r' || c === '\n') return line
        if (c === CTRL_C) throw new CancelledError()
        if (c === CTRL_D && line === '') return null
        if (c === BACKSPACE || c === DELETE) {
            line = line.slice(0, -1)
            continue
        }
        line += c
    }
}

// Writes `prompt` and reads one secret. On a TTY it reads in raw mode
// without echo (Ctrl-C is cancellation); otherwise one plain line from
// the shared reader. The result is trimmed; end of input with no text is
// an error.
export async function readSecret (
    out:NodeJS.WritableStream,
    stdin:NodeJS.ReadableStream,
    lines:LineReader,
    prompt:string
):Promise<string> {
    out.write(prompt)
    let answer:string|null
    if (rawCapable(stdin)) {
        stdin.setRawMode(true)
        try {
            answer = await readRawLine(lines)
        } finally {
            stdin.setRawMode(false)
            out.write('\n')
        }
    } else {
        answer = await lines.readLine()
    }
    if (answer === null) throw new Error('no input: end of file')
    return goTrimSpace(answer)
}

function isTerminal (stream:unknown):boolean {
    const s = stream as { isTTY?:boolean, fd?:unknown }
    return s.isTTY === true && typeof s.fd === 'number' && isatty(s.fd)
}

// Both streams are real terminals. A stream without a file descriptor,
// such as a test buffer, never is.
function defaultInteractiveTerminals (
    stdin:NodeJS.ReadableStream,
    stderr:NodeJS.WritableStream
):boolean {
    return isTerminal(stdin) && isTerminal(stderr)
}

// Starts `open <url>` (darwin) or `xdg-open <url>` without waiting for
// it. Resolves with a spawn error, or undefined once started. The child
// is killed when `signal` aborts.
function defaultOpenBrowser (
    url:string,
    signal?:AbortSignal
):Promise<Error|undefined> {
    const cmd = process.platform === 'darwin' ? 'open' : 'xdg-open'
    return new Promise(resolve => {
        const child = spawn(cmd, [url], {
            stdio:'ignore',
            detached:true,
            signal,
        })
        child.on('spawn', () => {
            child.unref()
            resolve(undefined)
        })
        // Also swallows the AbortError emitted when `signal` kills it.
        child.on('error', err => resolve(err))
    })
}

export const terminalHooks = {
    interactiveTerminals:defaultInteractiveTerminals,
    openBrowser:defaultOpenBrowser,
}

export function interactiveTerminals (
    stdin:NodeJS.ReadableStream,
    stderr:NodeJS.WritableStream
):boolean {
    return terminalHooks.interactiveTerminals(stdin, stderr)
}

export function openBrowser (
    url:string,
    signal?:AbortSignal
):Promise<Error|undefined> {
    return terminalHooks.openBrowser(url, signal)
}
