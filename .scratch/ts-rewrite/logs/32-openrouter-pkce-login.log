// Response body ownership and raw-response capture (spec 06, 2.11): a
// size cap, the Content-Length check, streaming capture that never reads
// ahead of the parser, and the client's sticky failure gate.

import { CaptureError } from './errors.js'
import type { Protocol, RawResponse } from './types.js'

export const MAX_CAPTURED_RESPONSE_SIZE = 16 << 20

// A client's capture state: after the first failure every later request
// fails with the same error without contacting the server.
export class CaptureGate {
    failure?:CaptureError
}

export interface CaptureOptions {
    role:string;
    protocol:Protocol;
    model:string;
    captureResponse?:(raw:RawResponse) => Promise<void>|void;
    // Overrides MAX_CAPTURED_RESPONSE_SIZE (tests).
    limit?:number;
}

export interface CapturedBody {
    // Body chunks, read only as the consumer pulls them.
    chunks:AsyncIterable<Uint8Array>;
    // Idempotent: cancels the body if it is not at EOF, then hands the
    // bytes read to the capture callback. Throws a CaptureError.
    release ():Promise<void>;
}

function latch (
    gate:CaptureGate,
    role:string,
    detail:string,
    cause?:unknown
):CaptureError {
    const err = new CaptureError(
        `capture ${role} provider response: ${detail}`, { cause })
    gate.failure ??= err
    return err
}

function mediaType (contentType:string|null):string {
    return (contentType ?? '').split(';')[0].trim().toLowerCase()
}

function concat (parts:Uint8Array[], size:number):Uint8Array {
    const out = new Uint8Array(size)
    let off = 0
    for (const p of parts) {
        out.set(p, off)
        off += p.length
    }
    return out
}

// `p`, or the signal's reason as soon as it aborts.
export function abortable<T> (p:Promise<T>, signal?:AbortSignal):Promise<T> {
    if (!signal) return p
    if (signal.aborted) return Promise.reject(signal.reason)
    return new Promise<T>((resolve, reject) => {
        const onAbort = () => reject(signal.reason)
        signal.addEventListener('abort', onAbort, { once:true })
        p.then(v => {
            signal.removeEventListener('abort', onAbort)
            resolve(v)
        }, (e:unknown) => {
            signal.removeEventListener('abort', onAbort)
            reject(e)
        })
    })
}

async function runCallback (
    opts:CaptureOptions,
    gate:CaptureGate,
    contentType:RawResponse['contentType'],
    body:Uint8Array
):Promise<void> {
    if (!opts.captureResponse) return
    try {
        await opts.captureResponse({
            role:opts.role,
            protocol:opts.protocol,
            model:opts.model,
            contentType,
            body,
        })
    } catch (err) {
        const msg = err instanceof Error ? err.message : String(err)
        throw latch(gate, opts.role, msg, err)
    }
}

// Opens a 2xx response body for the SSE parser.
export async function openCapturedBody (
    response:Response,
    opts:CaptureOptions,
    gate:CaptureGate,
    signal?:AbortSignal
):Promise<CapturedBody> {
    const limit = opts.limit ?? MAX_CAPTURED_RESPONSE_SIZE
    const reader = response.body?.getReader()
    let done = !reader
    let released = false

    async function cancel ():Promise<void> {
        if (done || !reader) return
        done = true
        await reader.cancel().catch(() => {})
    }

    // The next chunk, or null at EOF.
    async function read ():Promise<Uint8Array|null> {
        if (!reader) return null
        const r = await abortable(reader.read(), signal)
        return r.done ? null : r.value
    }

    const capturing = opts.captureResponse !== undefined
    const length = Number(response.headers.get('content-length') ?? '')
    if (capturing && Number.isFinite(length) && length > limit) {
        await cancel()
        throw latch(gate, opts.role,
            `body exceeds ${limit}-byte limit`)
    }

    const sse = mediaType(response.headers.get('content-type')) ===
        'text/event-stream'
    if (capturing && !sse) {
        const parts:Uint8Array[] = []
        let size = 0
        while (!done) {
            const value = await read()
            if (value === null) {
                done = true
                break
            }
            size += value.length
            if (size > limit) {
                await cancel()
                throw latch(gate, opts.role,
                    `body exceeds ${limit}-byte limit`)
            }
            parts.push(value)
        }
        const body = concat(parts, size)
        try {
            JSON.parse(new TextDecoder().decode(body))
        } catch {
            throw latch(gate, opts.role,
                `${opts.model} returned invalid raw JSON`)
        }
        await runCallback(opts, gate, 'application/json', body)
        async function * once () { yield body }
        return { chunks:once(), release:async () => {} }
    }

    const parts:Uint8Array[] = []
    let size = 0
    let overflowed = false

    async function * chunks ():AsyncGenerator<Uint8Array> {
        while (!done) {
            const value = await read()
            if (value === null) {
                done = true
                return
            }
            if (capturing) {
                if (size + value.length > limit) {
                    overflowed = true
                    await cancel()
                    throw latch(gate, opts.role,
                        `body exceeds ${limit}-byte limit`)
                }
                parts.push(value)
                size += value.length
            }
            yield value
        }
    }

    return {
        chunks:chunks(),
        async release ():Promise<void> {
            if (released) return
            released = true
            await cancel()
            if (!capturing || overflowed) return
            await runCallback(opts, gate, 'text/event-stream',
                concat(parts, size))
        },
    }
}
// Exit codes, error categories, and error output (spec 01, 2.2 to 2.4).
import { LlmError } from '../llm/errors.js'
import { text } from '../textsafe/textsafe.js'

export const ExitCode = {
    Clean:0,
    Findings:1,
    Usage:2,
    Auth:3,
    Partial:4,
    Cancelled:5,
} as const

export type ErrorCategory = 'none'|'findings'|'usage'|'auth'|'endpoint'|
    'resource_limit'|'partial'|'cancelled'

export type ErrorFormat = 'text'|'json'

// A bad flag, command, config, or anything else the user must fix.
export class UsageError extends Error {
    constructor (message:string, options?:ErrorOptions) {
        super(message, options)
        this.name = 'UsageError'
    }
}

// The run was cancelled (first SIGINT/SIGTERM, Ctrl-C at a prompt).
export class CancelledError extends Error {
    constructor (message = 'cancelled', options?:ErrorOptions) {
        super(message, options)
        this.name = 'CancelledError'
    }
}

// A successful command asking for a non-zero exit with nothing printed
// (Go gateExit): 1 for gating findings, 4 for a partial review.
export class ExitSignal extends Error {
    readonly code:1|4

    constructor (code:1|4) {
        super(`exit ${code}`)
        this.code = code
        this.name = 'ExitSignal'
    }
}

// Walks err, err.cause, ... and reports whether any link passes `test`.
// Stops on a cycle or at the first non-Error.
export function errorChainHas (
    err:unknown,
    test:(e:Error) => boolean
):boolean {
    const seen = new Set<unknown>()
    let cur = err
    while (cur instanceof Error && !seen.has(cur)) {
        if (test(cur)) return true
        seen.add(cur)
        cur = cur.cause
    }
    return false
}

function isAbortError (e:Error):boolean {
    return e.name === 'AbortError'
}

// Cancellation: a CancelledError in the chain, or an AbortError raised
// while `signal` is aborted with a CancelledError reason. A TimeoutError
// is never cancellation.
export function isCancellation (err:unknown, signal?:AbortSignal):boolean {
    if (errorChainHas(err, e => e instanceof CancelledError)) return true
    if (!signal?.aborted) return false
    if (!(signal.reason instanceof CancelledError)) return false
    return errorChainHas(err, isAbortError)
}

function llmKind (err:unknown, kinds:string[]):boolean {
    return errorChainHas(err, e => {
        return e instanceof LlmError && kinds.includes(e.kind)
    })
}

function isUsage (err:unknown):boolean {
    return errorChainHas(err, e => e instanceof UsageError)
}

export function exitCode (err:unknown, signal?:AbortSignal):number {
    if (err === undefined || err === null) return ExitCode.Clean
    if (err instanceof ExitSignal) return err.code
    if (isCancellation(err, signal)) return ExitCode.Cancelled
    if (llmKind(err, ['auth'])) return ExitCode.Auth
    if (isUsage(err)) return ExitCode.Usage
    return ExitCode.Partial
}

export function errorCategoryFor (
    code:number,
    err:unknown,
    signal?:AbortSignal
):ErrorCategory {
    if (code === ExitCode.Clean) return 'none'
    if (code === ExitCode.Findings) return 'findings'
    if (isCancellation(err, signal)) return 'cancelled'
    if (llmKind(err, ['auth'])) return 'auth'
    if (llmKind(err, ['endpoint'])) return 'endpoint'
    if (llmKind(err, ['budget_exhausted', 'work_deadline',
        'no_final_call'])) {
        return 'resource_limit'
    }
    if (isUsage(err) || code === ExitCode.Usage) return 'usage'
    if (code === ExitCode.Cancelled) return 'cancelled'
    return 'partial'
}

// Writes an error to `out`: `roast: <message>` sanitized, or one JSON
// object. An ExitSignal writes nothing.
export function writeError (
    out:NodeJS.WritableStream,
    code:number,
    err:Error,
    format:ErrorFormat,
    signal?:AbortSignal
):void {
    if (err instanceof ExitSignal) return
    if (format === 'json') {
        const body = {
            error_category:errorCategoryFor(code, err, signal),
            message:err.message,
            exit_code:code,
        }
        out.write(`${JSON.stringify(body)}\n`)
        return
    }
    out.write(`roast: ${text(err.message)}\n`)
}
// A `node:http` fake inference server (Go httptest plus providerServer):
// it records every request and answers from a script that looks at the
// request (path, body, headers) and the request's position.
import {
    createServer,
    type IncomingHttpHeaders,
    type ServerResponse,
} from 'node:http'
import type { AddressInfo } from 'node:net'
import { writeInferenceStream } from './inference-stream.js'

export interface RecordedRequest {
    method:string;
    path:string;
    headers:IncomingHttpHeaders;
    // Header names and values exactly as sent, in order.
    rawHeaders:string[];
    rawBody:Buffer;
    // The parsed JSON body; undefined when it is not JSON.
    body:unknown;
}

export type Reply =
    // A complete response object, streamed in the protocol's SSE format;
    // the protocol defaults to the one the request path implies.
    | { stream:unknown, protocol?:string }
    | { status:number, headers?:Record<string, string>, body?:string|Buffer }
    // Full control: write the response yourself.
    | ((res:ServerResponse, req:RecordedRequest) => void|Promise<void>)

// Picks the reply for the n-th request (0-based).
export type Script = (req:RecordedRequest, n:number) => Reply

export interface InferenceServer {
    // `http://127.0.0.1:<port>`.
    url:string;
    requests:RecordedRequest[];
    close ():Promise<void>;
}

export function protocolForPath (path:string):string {
    if (path.endsWith('/chat/completions')) return 'chat'
    if (path.endsWith('/responses')) return 'responses'
    if (path.endsWith('/v1/messages')) return 'anthropic'
    return ''
}

async function reply (res:ServerResponse, req:RecordedRequest, r:Reply) {
    if (typeof r === 'function') {
        await r(res, req)
        return
    }
    if ('stream' in r) {
        writeInferenceStream(res, r.protocol ?? protocolForPath(req.path),
            r.stream)
        return
    }
    res.writeHead(r.status, r.headers ?? {})
    res.end(r.body ?? '')
}

export async function startInferenceServer (
    script:Script
):Promise<InferenceServer> {
    const requests:RecordedRequest[] = []
    const server = createServer((req, res) => {
        const parts:Buffer[] = []
        req.on('data', (c:Buffer) => parts.push(c))
        req.on('end', () => {
            const rawBody = Buffer.concat(parts)
            let body:unknown
            try {
                body = JSON.parse(rawBody.toString('utf8'))
            } catch {
                body = undefined
            }
            const rec:RecordedRequest = {
                method:req.method ?? '',
                path:req.url ?? '',
                headers:req.headers,
                rawHeaders:req.rawHeaders,
                rawBody,
                body,
            }
            const n = requests.length
            requests.push(rec)
            Promise.resolve()
                .then(() => reply(res, rec, script(rec, n)))
                .catch((err:unknown) => {
                    if (!res.headersSent) res.writeHead(500)
                    res.end(String(err))
                })
        })
    })
    await new Promise<void>(resolve => {
        server.listen(0, '127.0.0.1', resolve)
    })
    const { port } = server.address() as AddressInfo
    return {
        url:`http://127.0.0.1:${port}`,
        requests,
        close () {
            server.closeAllConnections()
            return new Promise<void>(resolve => server.close(() => resolve()))
        },
    }
}
// Bundles the CLI (default), the test entry (--test), the live-test
// entry (--live), or the Go-vs-TS differential harness (--diff) with
// esbuild. Run directly by Node (type stripping), so
// only erasable TypeScript syntax is allowed here.
import { execFileSync } from 'node:child_process'
import { readFileSync } from 'node:fs'
import { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
import { resolve } from 'node:path'
import { build } from 'esbuild'
import type { Metafile } from 'esbuild'
import { ROOT, baseOptions } from './esbuild-options.ts'
import {
    bundledPackageDirs,
    readBundledPackages,
    renderNotices,
} from './licenses.ts'

const SHEBANG = '#!/usr/bin/env node'
// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into
// a runtime "Dynamic require is not supported" error unless a `require`
// is in scope.
const REQUIRE_SHIM = [
    "import { createRequire as __roastRequire } from 'node:module'",
    'const require = __roastRequire(import.meta.url)',
].join('\n')

type Mode = 'cli'|'test'|'live'|'diff'

function parseMode (args:string[]):Mode {
    if (args.length === 0) return 'cli'
    if (args.length === 1 && args[0] === '--test') return 'test'
    if (args.length === 1 && args[0] === '--live') return 'live'
    if (args.length === 1 && args[0] === '--diff') return 'diff'
    throw new Error('usage: node scripts/bundle.ts [--test|--live|--diff], ' +
        `got ${args.join(' ')}`)
}

// Runs git at the repository root; `unknown` when git fails (a build
// from a tarball, no git on PATH).
function git (args:string[]):string {
    try {
        const out = execFileSync('git', args, {
            cwd:ROOT,
            encoding:'utf8',
            stdio:['ignore', 'pipe', 'ignore'],
        }).trim()
        return out || 'unknown'
    } catch {
        return 'unknown'
    }
}

async function packageVersion ():Promise<string> {
    const text = await readFile(new URL('package.json', `file://${ROOT}`),
        'utf8')
    const version = JSON.parse(text).version
    if (typeof version !== 'string') {
        throw new Error('package.json has no string version')
    }
    return version
}

// Writes dist/THIRD_PARTY_LICENSES.txt from the metafile (spec 15, 2.6).
// Throws, naming the package, when a bundled package fails validation.
async function writeThirdPartyNotices (metafile:Metafile):Promise<void> {
    const dirs = bundledPackageDirs(metafile, 'dist/cli.js')
        .map(dir => resolve(ROOT, dir))
    const notices = renderNotices(readBundledPackages(dirs),
        path => readFileSync(path, 'utf8'))
    await writeFile(new URL('dist/THIRD_PARTY_LICENSES.txt',
        `file://${ROOT}`), notices)
}

async function bundleCli ():Promise<void> {
    const dist = new URL('dist/', `file://${ROOT}`)
    await rm(dist, { recursive:true, force:true })
    await mkdir(dist, { recursive:true })

    const version = await packageVersion()
    const commit = git(['rev-parse', '--short=7', 'HEAD'])
    const date = git(['log', '-1', '--format=%cI'])

    const result = await build({
        ...baseOptions(),
        entryPoints:['src/cli.ts'],
        outfile:'dist/cli.js',
        tsconfig:'tsconfig.build.json',
        metafile:true,
        banner:{ js:`${SHEBANG}\n${REQUIRE_SHIM}` },
        define:{
            __ROAST_VERSION__:JSON.stringify(version),
            __ROAST_COMMIT__:JSON.stringify(commit),
            __ROAST_DATE__:JSON.stringify(date),
        },
    })
    const metafile = result.metafile
    if (!metafile) throw new Error('esbuild returned no metafile')
    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))
    await writeThirdPartyNotices(metafile)
    await chmod(new URL('cli.js', dist), 0o755)
}

async function bundleTests (entry:string, outfile:string):Promise<void> {
    await build({
        ...baseOptions(),
        entryPoints:[entry],
        outfile,
        tsconfig:'tsconfig.json',
        banner:{ js:REQUIRE_SHIM },
    })
}

async function main ():Promise<void> {
    const mode = parseMode(process.argv.slice(2))
    if (mode === 'cli') return bundleCli()
    if (mode === 'test') {
        return bundleTests('test/index.ts', 'test/test-bundle.js')
    }
    if (mode === 'diff') {
        return bundleTests('test/diff/index.ts', 'test/diff-bundle.js')
    }
    return bundleTests('test/live/index.ts', 'test/live-bundle.js')
}

try {
    await main()
} catch (err) {
    // esbuild has already printed its own diagnostics for build errors.
    console.error(err instanceof Error ? err.message : err)
    process.exitCode = 1
}
