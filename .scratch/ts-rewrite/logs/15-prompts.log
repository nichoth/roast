{"type":"message_update","usage":{"input":40,"output":1714,"cacheRead":62303,"cacheWrite":0,"reasoning":0,"totalTokens":64057,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"V4cEygIsQTSfz9wzEdRWLrOjH1yWi1NZ","name":"write","arguments":{"path":"/Users/nick/code/roast.ts-rewrite-15-prompts/test/prompts/prompts.ts","content":"// Tests for src/prompts/index.ts — template imports, finderSystem,\n// verifierSystem.\n\nimport { test } from '../helpers/test.js'\nimport {\n    finderSystem,\n    verifierSystem,\n} from '../../src/prompts/index.js'\n\n// Template imports equal bytes of their files (spec 2.15).\n// We verify by checking that all twelve templates are non-empty strings.\n// Exact byte-for-byte comparison happens in the differential harness.\n\nimport finderCore from '../../src/prompts/templates/finder_core.tmpl'\nimport finderProse from '../../src/prompts/templates/finder_prose.tmpl'\nimport finderScopeDiff from '../../src/prompts/templates/finder_scope_diff.tmpl'\nimport finderScopeSurvey from '../../src/prompts/templates/finder_scope_survey.tmpl'\nimport finderMixedAddendum from '../../src/prompts/templates/finder_mixed_addendum.tmpl'\nimport finderGoAddendum from '../../src/prompts/templates/finder_go_addendum.tmpl'\nimport finderFrontendAddendum from '../../src/prompts/templates/finder_frontend_addendum.tmpl'\nimport finderReactHooksAddendum from '../../src/prompts/templates/finder_react_hooks_addendum.tmpl'\nimport finderQuickAddendum from '../../src/prompts/templates/finder_quick_addendum.tmpl'\nimport verifierSystemTemplate from '../../src/prompts/templates/verifier_system.tmpl'\n\ntest('all twelve templates are non-empty strings', async t => {\n    const templates = [\n        ['finder_core', finderCore],\n        ['finder_prose', finderProse],\n        ['finder_scope_diff', finderScopeDiff],\n        ['finder_scope_survey', finderScopeSurvey],\n        ['finder_mixed_addendum', finderMixedAddendum],\n        ['finder_go_addendum', finderGoAddendum],\n        ['finder_frontend_addendum', finderFrontendAddendum],\n        ['finder_react_hooks_addendum', finderReactHooksAddendum],\n        ['finder_quick_addendum', finderQuickAddendum],\n        ['verifier_system', verifierSystemTemplate],\n    ]\n    for (const [name, content] of templates) {\n        t.ok(content.length > 0, `${name} is non-empty`)\n    }\n})\n\n// finderSystem (spec 2.13): order and containment, not word-for-word comparison.\n\ntest('finderSystem prose diff mode has no diff framing, no language addenda',\n    async t => {\n        const result = await finderSystem('prose', 'diff', false, [], '')\n        // Should contain the prose base.\n        t.ok(result.includes('You are an adversarial reviewer of design docs'),\n            'contains prose base')\n        // Should NOT contain diff scope framing.\n        t.ok(!result.includes('Diff-mode focus'), 'no diff framing')\n        // Should NOT contain scope survey framing.\n        t.ok(!result.includes('Survey-mode focus'), 'no survey framing')\n        // Should NOT contain mixed addendum.\n        t.ok(!result.includes('Note: this changeset includes prose files'),\n            'no mixed addendum')\n    })\n\ntest('finderSystem prose repo mode appends scope survey framing',\n    async t => {\n        const result = await finderSystem('prose', 'repo', false, [], '')\n        t.ok(result.includes('Survey-mode focus'), 'contains survey framing')\n    })\n\ntest('finderSystem code diff mode has diff framing, no language addenda',\n    async t => {\n        const result = await finderSystem('code', 'diff', false, [], '')\n        t.ok(result.includes('You are an adversarial code reviewer'),\n            'contains code base')\n        t.ok(result.includes('Diff-mode focus'), 'has diff framing')\n        t.ok(!result.includes('Survey-mode focus'), 'no survey framing')\n    })\n\ntest('finderSystem code repo mode has survey framing',\n    async t => {\n        const result = await finderSystem('code', 'repo', false, [], '')\n        t.ok(result.includes('Survey-mode focus'), 'has survey framing')\n    })\n\ntest('finderSystem mixed mode includes mixed addendum',\n    async t => {\n        const result = await finderSystem('mixed', 'diff', false, [], '')\n        t.ok(result.includes('Note: this changeset includes prose files'),\n            'mixed mode has mixed addendum')\n        t.ok(result.includes('Diff-mode focus'), 'has diff framing')\n    })\n\ntest('finderSystem quick mode appends quick addendum last',\n    async t => {\n        const result = await finderSystem('code', 'diff', true, [], '')\n        // Quick addendum must be at the end.\n        t.ok(result.includes('Quick-mode constraints'), 'has quick addendum')\n        t.ok(result.endsWith('\\n'), 'ends with newline')\n    })\n\ntest('finderSystem frontend addendum for react and frontend',\n    async t => {\n        const result = await finderSystem('code', 'diff', false,\n            ['react', 'frontend'], '')\n        t.ok(result.includes('Frontend-specific guidance'), 'frontend addendum')\n        t.ok(result.includes('React-hooks-specific guidance'), 'react hooks addendum')\n    })\n\ntest('finderSystem frontend only (no react) has frontend but not hooks',\n    async t => {\n        const result = await finderSystem('code', 'diff', false,\n            ['frontend'], '')\n        t.ok(result.includes('Frontend-specific guidance'), 'frontend addendum')\n        t.ok(!result.includes('React-hooks-specific guidance'), 'no hooks addendum')\n    })\n\ntest('finderSystem go addendum only',\n    async t => {\n        const result = await finderSystem('code', 'diff', false,\n            ['go'], '')\n        t.ok(result.includes('goroutine leaks'), 'go addendum')\n        t.ok(!result.includes('Frontend-specific guidance'), 'no frontend')\n    })\n\ntest('finderSystem web tag adds no addendum',\n    async t => {\n        const result = await finderSystem('code', 'diff', false,\n            ['web'], '')\n        t.ok(!result.includes('Frontend-specific guidance'), 'no frontend')\n        t.ok(!result.includes('goroutine leaks'), 'no go')\n    })\n\ntest('finderSystem override replaces only the base',\n    async t => {\n        // Override path is non-existent, so it will fail with an error.\n        // That's OK — we just verify the error is not a UsageError.\n        let err: unknown\n        try {\n            await finderSystem('code', 'diff', false, [],\n                '/nonexistent/path/that/does/not/exist')\n        } catch (e) {\n            err = e\n        }\n        t.ok(err instanceof Error, 'non-existent path errors')\n        t.ok(!(err instanceof Error) ||\n            (err as Error).constructor.name !== 'UsageError',\n            'error is not UsageError')\n    })\n\n// verifierSystem (spec 2.14).\n\ntest('verifierSystem with no override returns the default',\n    async t => {\n        const result = await verifierSystem('')\n        t.ok(result.includes('You are a verification reviewer'),\n            'contains verifier system text')\n    })\n\ntest('verifierSystem with empty string as path returns the default',\n    async t => {\n        const result = await verifierSystem('')\n        t.ok(result.includes('You are a verification reviewer'),\n            'contains verifier system text')\n    })\n"}}}}
