       }\n        if (value !== 'go' && value !== 'react' && value !== 'frontend' &&\n            value !== 'web') {\n            // Rule 4: unknown pack (case-sensitive, untrimmed).\n            throw new UsageError(\n                `unknown language pack \"${value}\"`\n            )\n        }\n    }\n\n    // Otherwise return the flag values as given: order, duplicates, unsorted.\n    return [...flagValues]\n}"}]}}}}
