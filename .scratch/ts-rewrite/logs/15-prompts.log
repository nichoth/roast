{"type":"message_update","usage":{"input":47,"output":1051,"cacheRead":59634,"cacheWrite":0,"reasoning":0,"totalTokens":60732,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"srCediXewjzwE2dXegXBTKoenLKZoKZS","name":"write","arguments":{"path":"/Users/nick/code/roast.ts-rewrite-15-prompts/src/prompts/index.ts","content":"// Prompt assembly for the finder and verifier (spec 08, 2.13–2.14).\n// No model calls; the CLI imports these to build system prompts.\n\nimport { readFile } from 'node:fs/promises'\n\n// The twelve baseline templates, imported as strings through the esbuild\n// text loader from the Go repository's internal/prompts/templates/ (spec 2.15).\nimport finderCore    from './templates/finder_core.tmpl'\nimport finderProse   from './templates/finder_prose.tmpl'\nimport finderScopeDiff from './templates/finder_scope_diff.tmpl'\nimport finderScopeSurvey from './templates/finder_scope_survey.tmpl'\nimport finderMixedAddendum  from './templates/finder_mixed_addendum.tmpl'\nimport finderGoAddendum     from './templates/finder_go_addendum.tmpl'\nimport finderFrontendAddendum from './templates/finder_frontend_addendum.tmpl'\nimport finderReactHooksAddendum from './templates/finder_react_hooks_addendum.tmpl'\nimport finderQuickAddendum  from './templates/finder_quick_addendum.tmpl'\nimport verifierSystem        from './templates/verifier_system.tmpl'\n\n// Override loading (spec 2.14).\n\n/** Read a prompt override, or fall back to the template asset.\nRead failure is a plain Error, not a UsageError.\nA missing file is a failure.\n`path` \"\" stays \"\" to use the default asset. */\nasync function loadOverride (path: string, fallback: string): Promise<string> {\n    if (path === '') return fallback\n    const content = await readFile(path, 'utf8')\n    return content\n}\n\n/** finderSystem(mode, scope, quick, langs, overridePath) — assembles the\nfinder base prompt. Scope, mixed addendum, language addenda, and quick\naddendum are appended per spec 2.13.\nThe override replaces only the base (spec 2.14).\nOverride files are read verbatim — no trimming, no rendering, no defanging.\nCallers pass paths already resolved through the config's promptPath; this\nmodule does not resolve them. */\nexport async function finderSystem (\n    mode: string,\n    scope: string,\n    quick: boolean,\n    langs: string[],\n    overridePath: string\n): Promise<string> {\n    // Determine the base template.\n    const isProse = mode === 'prose'\n    const baseTemplate = isProse ? finderProse : finderCore\n    let base = await loadOverride(overridePath, baseTemplate)\n\n    // Scope framing.\n    let parts: string[] = [base]\n    if (scope === 'repo') {\n        parts.push(finderScopeSurvey)\n    } else {\n        // diff scope: only prose diff mode gets no framing (spec 2.13).\n        // Actually per spec, prose diff mode has no diff framing.\n        if (!isProse) {\n            parts.push(finderScopeDiff)\n        }\n    }\n\n    // Mixed addendum (code mode only).\n    if (!isProse) {\n        parts.push(finderMixedAddendum)\n    }\n\n    // Language addenda (spec 2.12 rules: order = go, frontend/react, react).\n    for (const tag of langs) {\n        if (tag === 'go') {\n            parts.push(finderGoAddendum)\n        }\n    }\n    if (langs.includes('react') || langs.includes('frontend')) {\n        parts.push(finderFrontendAddendum)\n    }\n    if (langs.includes('react')) {\n        parts.push(finderReactHooksAddendum)\n    }\n\n    // Quick addendum — always last.\n    if (quick) {\n        parts.push(finderQuickAddendum)\n    }\n\n    return parts.join('')\n}\n\n/** verifierSystem(overridePath) returns the override or the baseline\nverifier_system asset (spec 2.14). */\nexport async function verifierSystem (\n    overridePath: string\n): Promise<string> {\n    if (overridePath === '') return verifierSystemDefault\n    const content = await readFile(overridePath, 'utf8')\n    return content\n}\n\n// The verifier_system default is imported as `verifierSystem` above,\n// but we need the raw string for loadOverride fallback.\nconst verifierSystemDefault = verifierSystem\n"}}}}
