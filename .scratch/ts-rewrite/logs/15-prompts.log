{"type":"tool_execution_end","toolCallId":"6QobUCNxDvB9fyX7Kc6L11tSyLgWg8SP","toolName":"read","result":{"content":[{"type":"text","text":"// Differences the harness accepts: only those caused by a deliberate\n// change from the Go baseline (spec.md, \"Deliberate changes from the Go\n// baseline\", numbered as there). Every entry names its change, the\n// scenario, and the difference path it explains. Anything else fails.\nimport type { Difference } from './compare.js'\n\nexport interface AllowEntry {\n    // The deliberate change's number in spec.md.\n    change:number;\n    // The scenario name, or a pattern over scenario names.\n    scenario:string|RegExp;\n    // A pattern over Difference paths.\n    path:RegExp;\n    reason:string;\n}\n\nexport const ALLOWLIST:readonly AllowEntry[] = [\n    {\n        change:7,\n        scenario:/^(gate settings|trust --yes): field name in another case$/,\n        path:/^(exit|stdout\\..+)$/,\n        reason:'Go matches \"Gate\" to the gate field case-insensitively and ' +\n            'succeeds; TS rejects it as an unknown field (exit 2)',\n    },\n]\n\nfunction applies (entry:AllowEntry, scenario:string, d:Difference):boolean {\n    const s = entry.scenario\n    const scenarioOk = typeof s === 'string' ? s === scenario : s.test(scenario)\n    return scenarioOk && entry.path.test(d.path)\n}\n\n// The differences no allowlist entry explains.\nexport function unexplained (\n    scenario:string,\n    diffs:readonly Difference[],\n    entries:readonly AllowEntry[] = ALLOWLIST\n):Difference[] {\n    return diffs.filter(d => !entries.some(e => applies(e, scenario, d)))\n}\n"}],"structuredContent":"// Differences the harness accepts: only those caused by a deliberate\n// change from the Go baseline (spec.md, \"Deliberate changes from the Go\n// baseline\", numbered as there). Every entry names its change, the\n// scenario, and the difference path it explains. Anything else fails.\nimport type { Difference } from './compare.js'\n\nexport interface AllowEntry {\n    // The deliberate change's number in spec.md.\n    change:number;\n    // The scenario name, or a pattern over scenario names.\n    scenario:string|RegExp;\n    // A pattern over Difference paths.\n    path:RegExp;\n    reason:string;\n}\n\nexport const ALLOWLIST:readonly AllowEntry[] = [\n    {\n        change:7,\n        scenario:/^(gate settings|trust --yes): field name in another case$/,\n        path:/^(exit|stdout\\..+)$/,\n        reason:'Go matches \"Gate\" to the gate field case-insensitively and ' +\n            'succeeds; TS rejects it as an unknown field (exit 2)',\n    },\n]\n\nfunction applies (entry:AllowEntry, scenario:string, d:Difference):boolean {\n    const s = entry.scenario\n    const scenarioOk = typeof s === 'string' ? s === scenario : s.test(scenario)\n    return scenarioOk && entry.path.test(d.path)\n}\n\n// The differences no allowlist entry explains.\nexport function unexplained (\n    scenario:string,\n    diffs:readonly Difference[],\n    entries:readonly AllowEntry[] = ALLOWLIST\n):Difference[] {\n    return diffs.filter(d => !entries.some(e => applies(e, scenario, d)))\n}\n"},"isError":false,"durationMs":5}
