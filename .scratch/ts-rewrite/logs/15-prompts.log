/files>\\n\\n'\n            + T27 + '\\n'\n    }\n}\n\nexport interface VerifierVars {\n    severity: string\n    confidence: number\n    file: string\n    lines: string\n    description: string\n    codeQuote: string\n    fixedCode: string\n    fileSnippet: string\n}\n\n/** Render the verifier user message (spec 2.17). */\nexport function renderVerifierUser (v: VerifierVars): string {\n    let out = verifierUserTemplate\n\n    // Replace each action in place (spec 2.17):\n    // {{data .Severity}} -> dataText(severity)\n    out = out.replace(/{{data \\.Severity}}/g, () => dataText(v.severity))\n    // {{printf \"%.2f\" .Confidence}} -> formatFixed2(confidence)\n    out = out.replace(/{{printf \"\\\\.2f\" \\.Confidence}}/g, () => formatFixed2(v.confidence))\n    // {{data .File}} -> dataText(file)\n    out = out.replace(/{{data \\.File}}/g, () => dataText(v.file))\n    // {{data .Lines}} -> dataText(lines)\n    out = out.replace(/{{data \\.Lines}}/g, () => dataText(v.lines))\n    // {{data .Description}} -> dataText(description)\n    out = out.replace(/{{data \\.Description}}/g, () => dataText(v.description))\n    // {{data .CodeQuote}} -> dataText(codeQuote)\n    out = out.replace(/{{data \\.CodeQuote}}/g, () => dataText(v.codeQuote))\n    // {{data .FixedCode}} -> dataText(fixedCode)\n    out = out.replace(/{{data \\.FixedCode}}/g, () => dataText(v.fixedCode))\n    // {{data .FileSnippet}} -> dataText(fileSnippet)\n    out = out.replace(/{{data \\.FileSnippet}}/g, () => dataText(v.fileSnippet))\n\n    return out\n}\n"}}}}
