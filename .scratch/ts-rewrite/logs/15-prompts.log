test('resolveLangs unknown pack matching is case-sensitive', t => {\n    let err: unknown\n    try {\n        resolveLangs(['Go'], ['file.go'], 'code')\n    } catch (e) {\n        err = e\n    }\n    t.ok(err instanceof UsageError, 'case-sensitive match fails')\n})\n\ntest('resolveLangs does not trim flag values', t => {\n    // A flag like \"go, react\" (with comma) is a single unknown pack.\n    let err: unknown\n    try {\n        resolveLangs([' go'], ['file.go'], 'code')\n    } catch (e) {\n        err = e\n    }\n    t.ok(err instanceof UsageError, 'untrimmed value is unknown')\n})"}],"path":"/Users/nick/code/roast.ts-rewrite-15-prompts/test/review/classify.ts"}}}}
