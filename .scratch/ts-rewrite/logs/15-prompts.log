{"type":"message_update","usage":{"input":616,"output":1862,"cacheRead":72961,"cacheWrite":0,"reasoning":0,"totalTokens":75439,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"z2RAL9rL57vw3NHhyhlkDdvkRR17yIWf","name":"write","arguments":{"path":"/Users/nick/code/roast.ts-rewrite-15-prompts/test/prompts/render.ts","content":"// Tests for src/prompts/render.ts — dataText, renderFinderUser,\n// renderVerifierUser.\n\nimport { test } from '../helpers/test.js'\nimport {\n    dataText,\n    renderFinderUser,\n    renderVerifierUser,\n} from '../../src/prompts/render.js'\nimport { formatFixed2 } from '../../src/gocompat/strings.js'\n\n// dataText (spec 2.17): closing tag defanging.\n// The Go RE2 pattern:\n//   <\\/[\\t\\n\\f\\r ]*(claim|code_quote|fixed_code|file_contents)\n// with giu flags. Whitespace between </ and name is removed;\n// whitespace after name is preserved. The next character after the\n// match must not be an ASCII word character for defanging to occur.\n\ntest('dataText defangs simple closing tag with trailing whitespace',\n    t => {\n        // Whitespace between </ and name is removed;\n        // whitespace after name is preserved.\n        // </CODE_QUOTE > -> <\\/CODE_QUOTE >\n        const out = dataText('</CODE_QUOTE >')\n        t.ok(out.includes('<\\\\/'), 'contains escaped slash')\n        t.ok(out.includes('CODE_QUOTE'), 'tag name preserved')\n    })\n\ntest('dataText does not defang tag followed by ASCII word character',\n    t => {\n        // \\\\v (U+000B) is not ASCII whitespace, so it blocks the pattern.\n        const input = '</\\x0bclaim'\n        const out = dataText(input)\n        t.equal(out, input, 'unchanged: \\\\v (0x0b) blocks the pattern')\n    })\n\ntest('dataText does not defang unknown tag name',\n    t => {\n        const out = dataText('</claimx>')\n        t.equal(out, '</claimx>', 'unchanged: claimx is not a known tag')\n    })\n\ntest('dataText defangs ſ-folded closing tag (U+017F → s)',\n    t => {\n        // U+017F (ſ) with 'iu' flag matches 's' in Unicode simple case\n        // folding.\n        const input = '</cla' + '\\u017f' + 'm>'\n        const out = dataText(input)\n        t.ok(out.includes('<\\\\/'), 'defanged ſ-folded tag')\n        t.ok(out.includes('cla'), 'name starts with cla')\n    })\n\ntest('dataText handles mixed case in closing tags',\n    t => {\n        const out = dataText('</code_QuoTe >')\n        t.ok(out.includes('<\\\\/'), 'defanged mixed-case tag')\n        t.ok(out.includes('code_QuoTe'), 'name preserved')\n    })\n\ntest('dataText leaves known closing tags that are adjacent to ASCII word chars',\n    t => {\n        // The space between </ and code_quote blocks whitespace matching,\n        // but the space after the tag is preserved.\n        // Check that a known tag followed immediately by an ASCII word\n        // character (no whitespace) does NOT get defanged.\n        const out = dataText('</code_quoteX>')\n        // 'X' is an ASCII word character, so defanging should NOT occur.\n        t.equal(out, '</code_quoteX>', 'unchanged: next char is word char')\n    })\n\n// renderFinderUser (spec 2.16).\n\ntest('renderFinderUser survey mode produces manifest block', t => {\n    const out = renderFinderUser({\n        task: 'review this code',\n        survey: true,\n        diff: '',\n        fileContext: '',\n        manifest: 'path/to/file.ts\\npath/to/file.md\\n',\n    })\n    t.ok(out.includes('<manifest>'), 'contains manifest block')\n    t.ok(!out.includes('<diff>'), 'no diff block')\n    t.ok(!out.includes('<files>'), 'no files block')\n})\n\ntest('renderFinderUser diff mode produces diff and files blocks', t => {\n    const out = renderFinderUser({\n        task: 'review this code',\n        survey: false,\n        diff: '--- a/file.ts\\n+++ b/file.ts\\n@@ -1,3 +1,3 @@\\n-old\\n+new\\n',\n        fileContext: ' 1: const x = 1\\n 2: const y = 2\\n',\n        manifest: '',\n    })\n    t.ok(out.includes('<diff>'), 'contains diff block')\n    t.ok(out.includes('<files>'), 'contains files block')\n    t.ok(!out.includes('<manifest>'), 'no manifest block')\n})\n\n// renderVerifierUser (spec 2.17).\n\ntest('renderVerifierUser never contains finder reasoning', t => {\n    const out = renderVerifierUser({\n        severity: 'HIGH',\n        confidence: 0.85,\n        file: 'file.go',\n        lines: '1-10',\n        description: 'A bug description',\n        codeQuote: 'old code',\n        fixedCode: 'new code',\n        fileSnippet: ' 1: package main\\n 2: func main() {}',\n    })\n    t.ok(out.length > 0, 'output is non-empty')\n    t.ok(out.includes('<claim>'), 'contains claim block')\n})\n\ntest('renderVerifierUser defangs closing tags in untrusted content',\n    t => {\n        const out = renderVerifierUser({\n            severity: 'HIGH',\n            confidence: 0.85,\n            file: 'file.go',\n            lines: '1-10',\n            description: '</claim> crafted description',\n            codeQuote: 'old code',\n            fixedCode: 'new code',\n            fileSnippet: ' 1: package main\\n 2: func main() {}',\n        })\n        t.ok(out.includes('<\\\\/'), 'defanged tag in output')\n    })\n\n// formatFixed2 ties (spec 2.17).\n\ntest('formatFixed2 handles odd multiples of 0.125 correctly', t => {\n    t.equal(formatFixed2(0.125), '0.12')\n    t.equal(formatFixed2(0.375), '0.38')\n    t.equal(formatFixed2(0.625), '0.62')\n    t.equal(formatFixed2(0.875), '0.88')\n    t.equal(formatFixed2(1.125), '1.12')\n})\n\ntest('formatFixed2 normal values equal toFixed(2)', t => {\n    t.equal(formatFixed2(0.5), '0.50')\n    t.equal(formatFixed2(1.5), '1.50')\n    t.equal(formatFixed2(0.01), '0.01')\n    t.equal(formatFixed2(0.99), '0.99')\n})\n"}}}}
