{"type":"tool_execution_end","toolCallId":"FQqICYLuPrJYikDjZFWcIXMjL02lOr5i","toolName":"read","result":{"content":[{"type":"text","text":"// Tests for src/prompts/render.ts — dataText, renderFinderUser,\n// renderVerifierUser.\n\nimport { test } from '../helpers/test.js'\nimport {\n    dataText,\n    renderFinderUser,\n    renderVerifierUser,\n} from '../../src/prompts/render.js'\nimport { formatFixed2 } from '../../src/gocompat/strings.js'\n\n// dataText (spec 2.17): closing tag defanging.\n\ntest('dataText defangs simple closing tag', t => {\n    const out = dataText('</CODE_QUOTE >')\n    t.ok(out.includes('<\\\\/CODE_QUOTE>'), 'defanged closing tag')\n})\n\ntest('dataText does not defang tag followed by ASCII word character',\n    t => {\n        const out = dataText('</\\vclaim')\n        t.equal(out, '</\\vclaim', 'unchanged: \\\\v is not ASCII whitespace')\n    })\n\ntest('dataText does not defang unknown tag name',\n    t => {\n        const out = dataText('</claimx>')\n        t.equal(out, '</claimx>', 'unchanged: claimx is not a known tag')\n    })\n\ntest('dataText defangs ſ-folded closing tag (U+017F → s)',\n    t => {\n        // ſ (U+017F) with 'i' flag and 'u' flag matches 's' in Unicode\n        // case folding. The close pattern is case-insensitive with 'iu' flag.\n        const out = dataText('</cla&#239;')\n        // The output should contain the escaped close.\n        t.ok(out.includes('<\\\\/'), 'defanged ſ-folded tag')\n    })\n\ntest('dataText handles mixed case in closing tags',\n    t => {\n        const out = dataText('</code_QuoTe >')\n        t.ok(out.includes('<\\\\/'), 'defanged mixed-case tag')\n    })\n\ntest('dataText leaves valid tags unchanged when not closing',\n    t => {\n        // Opening tags are not touched; only closing tags.\n        const out = dataText('<code_quote>hello</code_quote>')\n        // The closing tag </code_quote> should be defanged.\n        t.ok(out.includes('<\\\\/code_quote'), 'closing tag defanged')\