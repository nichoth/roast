{"type":"message_update","usage":{"input":41,"output":1584,"cacheRead":64056,"cacheWrite":0,"reasoning":0,"totalTokens":65681,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"hbp9uUZbinbyg4Wm6pWtlhuS84b4PSVb","name":"write","arguments":{"path":"/Users/nick/code/roast.ts-rewrite-15-prompts/test/prompts/render.ts","content":"// Tests for src/prompts/render.ts — dataText, renderFinderUser,\n// renderVerifierUser.\n\nimport { test } from '../helpers/test.js'\nimport {\n    dataText,\n    renderFinderUser,\n    renderVerifierUser,\n} from '../../src/prompts/render.js'\nimport { formatFixed2 } from '../../src/gocompat/strings.js'\n\n// dataText (spec 2.17): closing tag defanging.\n\ntest('dataText defangs simple closing tag', t => {\n    const out = dataText('</CODE_QUOTE >')\n    t.ok(out.includes('<\\\\/CODE_QUOTE>'), 'defanged closing tag')\n})\n\ntest('dataText does not defang tag followed by ASCII word character',\n    t => {\n        const out = dataText('</\\vclaim')\n        t.equal(out, '</\\vclaim', 'unchanged: \\\\v is not ASCII whitespace')\n    })\n\ntest('dataText does not defang unknown tag name',\n    t => {\n        const out = dataText('</claimx>')\n        t.equal(out, '</claimx>', 'unchanged: claimx is not a known tag')\n    })\n\ntest('dataText defangs ſ-folded closing tag (U+017F → s)',\n    t => {\n        // ſ (U+017F) with 'i' flag and 'u' flag matches 's' in Unicode\n        // case folding. The close pattern is case-insensitive with 'iu' flag.\n        const out = dataText('</cla&#239;')\n        // The output should contain the escaped close.\n        t.ok(out.includes('<\\\\/'), 'defanged ſ-folded tag')\n    })\n\ntest('dataText handles mixed case in closing tags',\n    t => {\n        const out = dataText('</code_QuoTe >')\n        t.ok(out.includes('<\\\\/'), 'defanged mixed-case tag')\n    })\n\ntest('dataText leaves valid tags unchanged when not closing',\n    t => {\n        // Opening tags are not touched; only closing tags.\n        const out = dataText('<code_quote>hello</code_quote>')\n        // The closing tag </code_quote> should be defanged.\n        t.ok(out.includes('<\\\\/code_quote'), 'closing tag defanged')\n        // Opening tag stays.\n        t.ok(out.startsWith('<code_quote>hello'), 'opening tag intact')\n    })\n\n// renderFinderUser (spec 2.16).\n\ntest('renderFinderUser survey mode produces manifest block', t => {\n    const out = renderFinderUser({\n        task: 'review this code',\n        survey: true,\n        diff: '',\n        fileContext: '',\n        manifest: 'path/to/file.ts\\npath/to/file.md\\n',\n    })\n    t.ok(out.includes('<manifest>'), 'contains manifest block')\n    t.ok(!out.includes('<diff>'), 'no diff block')\n    t.ok(!out.includes('<files>'), 'no files block')\n})\n\ntest('renderFinderUser diff mode produces diff and files blocks', t => {\n    const out = renderFinderUser({\n        task: 'review this code',\n        survey: false,\n        diff: '--- a/file.ts\\n+++ b/file.ts\\n@@ -1,3 +1,3 @@\\n-old\\n+new\\n',\n        fileContext: ' 1: const x = 1\\n 2: const y = 2\\n',\n        manifest: '',\n    })\n    t.ok(out.includes('<diff>'), 'contains diff block')\n    t.ok(out.includes('<files>'), 'contains files block')\n    t.ok(!out.includes('<manifest>'), 'no manifest block')\n})\n\n// renderVerifierUser (spec 2.17).\n\ntest('renderVerifierUser never contains finder reasoning', t => {\n    const out = renderVerifierUser({\n        severity: 'HIGH',\n        confidence: 0.85,\n        file: 'file.go',\n        lines: '1-10',\n        description: 'A bug description',\n        codeQuote: 'old code',\n        fixedCode: 'new code',\n        fileSnippet: ' 1: package main\\n 2: func main() {}',\n    })\n    // The verifier user message should not contain the finder's reasoning field.\n    // Reasoning is not a VerifierVars field, so it should never appear.\n    t.ok(out.length > 0, 'output is non-empty')\n    t.ok(out.includes('<claim>'), 'contains claim block')\n})\n\ntest('renderVerifierUser defangs closing tags in untrusted content',\n    t => {\n        const out = renderVerifierUser({\n            severity: 'HIGH',\n            confidence: 0.85,\n            file: 'file.go',\n            lines: '1-10',\n            description: '</claim> crafted description',\n            codeQuote: 'old code',\n            fixedCode: 'new code',\n            fileSnippet: ' 1: package main\\n 2: func main() {}',\n        })\n        // The closing tag in description should be defanged.\n        t.ok(out.includes('<\\\\/'), 'defanged tag in output')\n    })\n\n// formatFixed2 ties (spec 2.17).\n\ntest('formatFixed2 handles odd multiples of 0.125 correctly', t => {\n    // 0.125 -> \"0.12\" (round half to even, 12 is even)\n    t.equal(formatFixed2(0.125), '0.12')\n    // 0.375 -> \"0.38\" (round half to even, 38 is even)\n    t.equal(formatFixed2(0.375), '0.38')\n    // 0.625 -> \"0.62\" (round half to even, 62 is even)\n    t.equal(formatFixed2(0.625), '0.62')\n    // 0.875 -> \"0.88\" (round half to even, 88 is even)\n    t.equal(formatFixed2(0.875), '0.88')\n    // 1.125 -> \"1.12\"\n    t.equal(formatFixed2(1.125), '1.12')\n})\n\ntest('formatFixed2 normal values equal toFixed(2)', t => {\n    t.equal(formatFixed2(0.5), '0.50')\n    t.equal(formatFixed2(1.5), '1.50')\n    t.equal(formatFixed2(0.01), '0.01')\n    t.equal(formatFixed2(0.99), '0.99')\n})\n"}}}}
