{"type":"tool_execution_end","toolCallId":"bJPKXHE3Xwhl8WuwEWOe2mbOfoHySvTj","toolName":"read","result":{"content":[{"type":"text","text":"// Bundles the CLI (default), the test entry (--test), the live-test\n// entry (--live), or the Go-vs-TS differential harness (--diff) with\n// esbuild. Run directly by Node (type stripping), so\n// only erasable TypeScript syntax is allowed here.\nimport { execFileSync } from 'node:child_process'\nimport { readFileSync } from 'node:fs'\nimport { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'\nimport { resolve } from 'node:path'\nimport { build } from 'esbuild'\nimport type { Metafile } from 'esbuild'\nimport { ROOT, baseOptions } from './esbuild-options.ts'\nimport {\n    bundledPackageDirs,\n    readBundledPackages,\n    renderNotices,\n} from './licenses.ts'\n\nconst SHEBANG = '#!/usr/bin/env node'\n// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into\n// a runtime \"Dynamic require is not supported\" error unless a `require`\n// is in scope.\nconst REQUIRE_SHIM = [\n    \"import { createRequire as __roastRequire } from 'node:module'\",\n    'const require = __roastRequire(import.meta.url)',\n].join('\\n')\n\ntype Mode = 'cli'|'test'|'live'|'diff'\n\nfunction parseMode (args:string[]):Mode {\n    if (args.length === 0) return 'cli'\n    if (args.length === 1 && args[0] === '--test') return 'test'\n    if (args.length === 1 && args[0] === '--live') return 'live'\n    if (args.length === 1 && args[0] === '--diff') return 'diff'\n    throw new Error('usage: node scripts/bundle.ts [--test|--live|--diff], ' +\n        `got ${args.join(' ')}`)\n}\n\n// Runs git at the repository root; `unknown` when git fails (a build\n// from a tarball, no git on PATH).\nfunction git (args:string[]):string {\n    try {\n        const out = execFileSync('git', args, {\n            cwd:ROOT,\n            encoding:'utf8',\n            stdio:['ignore', 'pipe', 'ignore'],\n        }).trim()\n        return out || 'unknown'\n    } catch {\n        return 'unknown'\n    }\n}\n\nasync function packageVersion ():Promise<string> {\n    const text = await readFile(new URL('package.json', `file://${ROOT}`),\n        'utf8')\n    const version = JSON.parse(text).version\n    if (typeof version !== 'string') {\n        throw new Error('package.json has no string version')\n    }\n    return version\n}\n\n// Writes dist/THIRD_PARTY_LICENSES.txt from the metafile (spec 15, 2.6).\n// Throws, naming the package, when a bundled package fails validation.\nasync function writeThirdPartyNotices (metafile:Metafile):Promise<void> {\n    const dirs = bundledPackageDirs(metafile, 'dist/cli.js')\n        .map(dir => resolve(ROOT, dir))\n    const notices = renderNotices(readBundledPackages(dirs),\n        path => readFileSync(path, 'utf8'))\n    await writeFile(new URL('dist/THIRD_PARTY_LICENSES.txt',\n        `file://${ROOT}`), notices)\n}\n\nasync function bundleCli ():Promise<void> {\n    const dist = new URL('dist/', `file://${ROOT}`)\n    await rm(dist, { recursive:true, force:true })\n    await mkdir(dist, { recursive:true })\n\n    const version = await packageVersion()\n    const commit = git(['rev-parse', '--short=7', 'HEAD'])\n    const date = git(['log', '-1', '--format=%cI'])\n\n    const result = await build({\n        ...baseOptions(),\n        entryPoints:['src/cli.ts'],\n        outfile:'dist/cli.js',\n        tsconfig:'tsconfig.build.json',\n        metafile:true,\n        banner:{ js:`${SHEBANG}\\n${REQUIRE_SHIM}` },\n        define:{\n            __ROAST_VERSION__:JSON.stringify(version),\n            __ROAST_COMMIT__:JSON.stringify(commit),\n            __ROAST_DATE__:JSON.stringify(date),\n        },\n    })\n    const metafile = result.metafile\n    if (!metafile) throw new Error('esbuild returned no metafile')\n    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))\n    await writeThirdPartyNotices(metafile)\n    await chmod(new URL('cli.js', dist), 0o755)\n}\n\nasync function bundleTests (entry:string, outfile:string):Promise<void> {\n    await build({\n        ...baseOptions(),\n        entryPoints:[entry],\n        outfile,\n        tsconfig:'tsconfig.json',\n        banner:{ js:REQUIRE_SHIM },\n    })\n}\n\nasync function main ():Promise<void> {\n    const mode = parseMode(process.argv.slice(2))\n    if (mode === 'cli') return bundleCli()\n    if (mode === 'test') {\n        return bundleTests('test/index.ts', 'test/test-bundle.js')\n    }\n    if (mode === 'diff') {\n        return bundleTests('test/diff/index.ts', 'test/diff-bundle.js')\n    }\n    return bundleTests('test/live/index.ts', 'test/live-bundle.js')\n}\n\ntry {\n    await main()\n} catch (err) {\n    // esbuild has already printed its own diagnostics for build errors.\n    console.error(err instanceof Error ? err.message : err)\n    process.exitCode = 1\n}\n"}],"structuredContent":"// Bundles the CLI (default), the test entry (--test), the live-test\n// entry (--live), or the Go-vs-TS differential harness (--diff) with\n// esbuild. Run directly by Node (type stripping), so\n// only erasable TypeScript syntax is allowed here.\nimport { execFileSync } from 'node:child_process'\nimport { readFileSync } from 'node:fs'\nimport { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'\nimport { resolve } from 'node:path'\nimport { build } from 'esbuild'\nimport type { Metafile } from 'esbuild'\nimport { ROOT, baseOptions } from './esbuild-options.ts'\nimport {\n    bundledPackageDirs,\n    readBundledPackages,\n    renderNotices,\n} from './licenses.ts'\n\nconst SHEBANG = '#!/usr/bin/env node'\n// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into\n// a runtime \"Dynamic require is not supported\" error unless a `require`\n// is in scope.\nconst REQUIRE_SHIM = [\n    \"import { createRequire as __roastRequire } from 'node:module'\",\n    'const require = __roastRequire(import.meta.url)',\n].join('\\n')\n\ntype Mode = 'cli'|'test'|'live'|'diff'\n\nfunction parseMode (args:string[]):Mode {\n    if (args.length === 0) return 'cli'\n    if (args.length === 1 && args[0] === '--test') return 'test'\n    if (args.length === 1 && args[0] === '--live') return 'live'\n    if (args.length === 1 && args[0] === '--diff') return 'diff'\n    throw new Error('usage: node scripts/bundle.ts [--test|--live|--diff], ' +\n        `got ${args.join(' ')}`)\n}\n\n// Runs git at the repository root; `unknown` when git fails (a build\n// from a tarball, no git on PATH).\nfunction git (args:string[]):string {\n    try {\n        const out = execFileSync('git', args, {\n            cwd:ROOT,\n            encoding:'utf8',\n            stdio:['ignore', 'pipe', 'ignore'],\n        }).trim()\n        return out || 'unknown'\n    } catch {\n        return 'unknown'\n    }\n}\n\nasync function packageVersion ():Promise<string> {\n    const text = await readFile(new URL('package.json', `file://${ROOT}`),\n        'utf8')\n    const version = JSON.parse(text).version\n    if (typeof version !== 'string') {\n        throw new Error('package.json has no string version')\n    }\n    return version\n}\n\n// Writes dist/THIRD_PARTY_LICENSES.txt from the metafile (spec 15, 2.6).\n// Throws, naming the package, when a bundled package fails validation.\nasync function writeThirdPartyNotices (metafile:Metafile):Promise<void> {\n    const dirs = bundledPackageDirs(metafile, 'dist/cli.js')\n        .map(dir => resolve(ROOT, dir))\n    const notices = renderNotices(readBundledPackages(dirs),\n        path => readFileSync(path, 'utf8'))\n    await writeFile(new URL('dist/THIRD_PARTY_LICENSES.txt',\n        `file://${ROOT}`), notices)\n}\n\nasync function bundleCli ():Promise<void> {\n    const dist = new URL('dist/', `file://${ROOT}`)\n    await rm(dist, { recursive:true, force:true })\n    await mkdir(dist, { recursive:true })\n\n    const version = await packageVersion()\n    const commit = git(['rev-parse', '--short=7', 'HEAD'])\n    const date = git(['log', '-1', '--format=%cI'])\n\n    const result = await build({\n        ...baseOptions(),\n        entryPoints:['src/cli.ts'],\n        outfile:'dist/cli.js',\n        tsconfig:'tsconfig.build.json',\n        metafile:true,\n        banner:{ js:`${SHEBANG}\\n${REQUIRE_SHIM}` },\n        define:{\n            __ROAST_VERSION__:JSON.stringify(version),\n            __ROAST_COMMIT__:JSON.stringify(commit),\n            __ROAST_DATE__:JSON.stringify(date),\n        },\n    })\n    const metafile = result.metafile\n    if (!metafile) throw new Error('esbuild returned no metafile')\n    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))\n    await writeThirdPartyNotices(metafile)\n    await chmod(new URL('cli.js', dist), 0o755)\n}\n\nasync function bundleTests (entry:string, outfile:string):Promise<void> {\n    await build({\n        ...baseOptions(),\n        entryPoints:[entry],\n        outfile,\n        tsconfig:'tsconfig.json',\n        banner:{ js:REQUIRE_SHIM },\n    })\n}\n\nasync function main ():Promise<void> {\n    const mode = parseMode(process.argv.slice(2))\n    if (mode === 'cli') return bundleCli()\n    if (mode === 'test') {\n        return bundleTests('test/index.ts', 'test/test-bundle.js')\n    }\n    if (mode === 'diff') {\n        return bundleTests('test/diff/index.ts', 'test/diff-bundle.js')\n    }\n    return bundleTests('test/live/index.ts', 'test/live-bundle.js')\n}\n\ntry {\n    await main()\n} catch (err) {\n    // esbuild has already printed its own diagnostics for build errors.\n    console.error(err instanceof Error ? err.message : err)\n    process.exitCode = 1\n}\n"},"isError":false,"durationMs":5}
