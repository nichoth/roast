ction setFetch (f:typeof globalThis.fetch):void {\nsrc/llm/http.ts:15:export function resetFetch ():void {\nsrc/llm/http.ts:19:export function currentFetch ():typeof globalThis.fetch {\nsrc/llm/http.ts:23:export function userAgent ():string {\nsrc/llm/http.ts:30:export function requestHeaders (\nsrc/llm/review.ts:8:export interface ReviewCall {\nsrc/llm/review.ts:14:export interface StopCause {\nsrc/llm/review.ts:19:export interface ReviewInput {\nsrc/llm/review.ts:37:export interface ReviewDecision {\nsrc/llm/review.ts:61:export function reviewResponse (input:ReviewInput):ReviewDecision {\n      40 src/cli/review.ts\n// `roast review`, also the default command. Ticket 20 adds the review\n// flags and the pipeline; until then only the bare-`roast` path that\n// needs no review is implemented.\nimport { gitRoot } from '../git/git.js'\nimport type { CommandDef, RunContext } from './command.js'\nimport { UsageError } from './errors.js'\n\nasync function insideRepository (ctx:RunContext):Promise<boolean> {\n    try {\n        await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n        return true\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        return false\n    }\n}\n\nasync function reviewHandler (ctx:RunContext):Promise<void> {\n    const explicit = ctx.path.length > 0\n    if (!(await insideRepository(ctx))) {\n        if (explicit) {\n            throw new UsageError('not inside a git repository')\n        }\n        ctx.stderr.write('roast: not in a Git repository; cd into one to ' +\n            'review, or try `roast doctor` / `roast --help`\\n')\n        ctx.stdout.write(await ctx.rootHelp())\n        return\n    }\n    throw new UsageError(\n        'review is not implemented yet in the TypeScript CLI')\n}\n\nexport const reviewCommand:CommandDef = {\n    command:['review', '$0'],\n    describe:'Review the current changes (the default command)',\n    handler:(_args, ctx) => reviewHandler(ctx),\n}","is_error":false}]},"parent_tool_use_id":"toolu_013ZjZWsp3co15WosgrPTPBD","agent_id":"a0cf7d3e7bd92336b","session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"2816d26c-cadb-4152-8557-87f8b75479d6","timestamp":"2026-11-24T01:28:36.331Z","tool_result_meta":[{"id":"toolu_01V8FCsotcJ29xRZSKZS8uVj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"Explore","task_description":"Map module APIs for review wiring"}
