quick, ConfidenceFloor: floor,\n726\t\t\tInteractive: interactive,\n727\t\t\tTools:       tools,\n728\t\t\tMaxTurns:    maxTurns,\n729\t\t\tGround:      ground,\n730\t\t\tDeadline:    deadline,\n731\t\t\tSurvey:      survey,\n732\t\t\tCapture:     record.OpenFindingSpill(runID),\n733\t\t})\n734\t\tif err != nil {\n735\t\t\treturn err\n736\t\t}\n737\t\n738\t\tusage := map[string]llm.Usage{\"finder\": finder.Usage()}\n739\t\tpartial := result.Incomplete\n740\t\tif doVerify && len(result.Findings) > 0 {\n741\t\t\tverifier, newErr := llm.New(ctx, clientConfig(\"verifier\", verifierRole, ledger, captureResponse, maxAttempts, requestTimeout))\n742\t\t\tif newErr != nil {\n743\t\t\t\treturn newErr\n744\t\t\t}\n745\t\t\tlogf(stderr, \"verifying %d finding(s) with %s (profile=%s protocol=%s)\", len(result.Findings), verifierRole.Model, verifierRole.Profile, verifierRole.Protocol)\n746\t\t\tresult = verify.Verify(ctx, verifier, result, verify.Deps{\n747\t\t\t\tSystemPrompt: verifierSystem,\n748\t\t\t\tUserPrompt: func(finding review.Finding) string {\n749\t\t\t\t\treturn verifierPrompt(repo, tree, finding)\n750\t\t\t\t},\n751\t\t\t\tTools:       rcontext.ExplorationTools(repo, tree),\n752\t\t\t\tMaxTurns:    8,\n753\t\t\t\tMaxVerified: maxVerified,\n754\t\t\t\tLedger:      ledger,\n755\t\t\t\tLog:         func(message string) { fmt.Fprintln(stderr, message) },\n756\t\t\t})\n757\t\t\tusage[\"verifier\"] = verifier.Usage()\n758\t\t\tfor _, finding := range result.Findings {\n759\t\t\t\tif finding.Verdict != nil && finding.Verdict.Undecided {\n760\t\t\t\t\tpartial = true\n761\t\t\t\t}\n762\t\t\t}\n763\t\t}\n764\t\n765\t\tvar reviewKind, completion, stopReason string\n766\t\tif survey {\n767\t\t\treviewKind = \"survey_triage\"\n768\t\t\tif result.Incomplete || result.StopReason == \"deadline\" || result.StopReason == \"token_budget\" || result.StopReason == \"budget_exhausted\" {\n769\t\t\t\tcompletion = \"partial\"\n770\t\t\t\tstopReason = result.StopReason\n771\t\t\t\tif stopReason == \"\" {\n772\t\t\t\t\tstopReason = \"incomplete_no_submission\"\n773\t\t\t\t}\n774\t\t\t} else {\n775\t\t\t\tcompletion, stopReason = \"complete\", \"converged\"\n776\t\t\t\tif result.Assessment == review.AssessmentNoFindings {\n777\t\t\t\t\tresult.Assessment = review.AssessmentNoFindingsInSampledAreas\n778\t\t\t\t}\n779\t\t\t}\n780\t\t}\n781\t\treport := render.Report{\n782\t\t\tResult: result, Mode: mode, FilesReviewed: sc.Files, Task: f.task,\n783\t\t\tRunID: runID, Budgets: budgets,\n784\t\t\tQuick: f.quick, Verified: doVerify,\n785\t\t\tDiffTruncated: len(breakdown) > 0, OriginalDiffBytes: originalDiffBytes,\n786\t\t\tSizeBreakdown: toRenderEntries(breakdown), Usage: usage,\n787\t\t\tPromptPacks: langs,\n788\t\t\tReviewKind:  reviewKind, Completion: completion,\n789\t\t\tManifestFileCount: len(sc.Files), StopReason: stopReason,\n790\t\t}\n791\t\tif spent, limit := ledger.Committed(); limit > 0 {\n792\t\t\tbudgets[\"ledger_committed_tokens\"] = spent\n793\t\t}\n794\t\treport.Prior = priorNotes(repo, result)\n795\t\twriteReport(stdout, stderr, f, report)\n796\t\tmeta.Usage = usageMeta(usage)\n797\t\tmeta.Budgets = budgets\n798\t\tfinalErr := finalizeRunArtifacts(meta, report, repo)\n799\t\tif finalErr == nil {\n800\t\t\tif reportPath, pathErr := record.ReportPath(runID); pathErr == nil {\n801\t\t\t\tlogf(stderr, \"run %s · report %s\", runID, reportPath)\n802\t\t\t}\n803\t\t}\n804\t\treturn reviewExitError(finalErr, gateRank, result.MaxSeverity(), partial)\n805\t}\n806\t\n807\tfunc reviewExitError(finalErr error, gateRank, maxSeverity int, partial bool) error {\n808\t\tif finalErr != nil {\n809\t\t\treturn finalErr\n810\t\t}\n811\t\tif gateRank >= 0 && maxSeverity >= gateRank {\n812\t\t\treturn &gateExit{code: ExitFindings}\n813\t\t}\n814\t\tif partial {\n815\t\t\treturn &gateExit{code: ExitPartial}\n816\t\t}\n817\t\treturn nil\n818\t}\n819\t\n820\tfunc roleMeta(role config.ResolvedRole, systemPrompt string) record.RoleMeta {\n821\t\treturn record.RoleMeta{\n822\t\t\tProfile: role.Profile, BaseURL: role.BaseURL, Model: role.Model, Protocol: role.Protocol,\n823\t\t\tMaxOutputTokens: role.MaxOutputTokens, SessionHeader: role.SessionHeader, PromptDigest: record.Digest(systemPrompt),\n824\t\t}\n825\t}\n826\t\n827\tfunc captureSnapshot(enabled bool, repo, runID string, sc scope.Scope, indexTree string, pin snapshot.Pin) (record.SnapshotMeta, []string) {\n828\t\tif !enabled {\n829\t\t\treturn record.SnapshotMeta{Reason: \"disabled by review.snapshot\"}, []string{\"Git snapshot capture was disabled; this run cannot be replayed.\"}\n830\t\t}\n831\t\thead := sc.HeadOID\n832\t\tif head == \"\" {\n833\t\t\thead = snapshot.HeadOID(repo)\n834\t\t}\n835\t\tbase := sc.BaseOID\n836\t\tif base == \"\" && sc.Base != \"\" {\n837\t\t\tbase = snapshot.RevOID(repo, sc.Base)\n838\t\t}\n839\t\tsnap, err := snapshot.Capture(repo, snapshot.Options{RunID: runID, HeadOID: head, BaseOID: base, IndexTree: indexTree, Worktree: pin})\n840\t\tif err != nil {\n841\t\t\treturn record.SnapshotMeta{Reason: err.Error(), Head: head, Base: base}, []string{\"Git snapshot capture failed: \" + err.Error()}\n842\t\t}\n843\t\tdiffPair := \"base..worktree\"\n844\t\tif sc.Staged {\n845\t\t\tdiffPair = \"head..index\"\n846\t\t} else if sc.Survey {\n847\t\t\tdiffPair = \"head\"\n848\t\t} else if sc.Base == \"\" {\n849\t\t\tdiffPair = \"head..worktree\"\n850\t\t}\n851\t\tmeta := record.SnapshotMeta{\n852\t\t\tCaptured: true, Ref: snap.Ref, Commit: snap.Commit,\n853\t\t\tIndexTree: snap.IndexTree, WorktreeTree: snap.WorktreeTree,\n854\t\t\tHead: snap.Head, Base: snap.Base, DiffPair: diffPair,\n855\t\t\tFileModes:     \"regular and executable files plus symlinks; empty directories are not represented\",\n856\t\t\tExcludedPaths: append([]string(nil), snap.Excluded...),\n857\t\t}\n858\t\tbaseTreeSource := base\n859\t\tif diffPair == \"head..index\" || diffPair == \"head..worktree\" || diffPair == \"head\" {\n860\t\t\tbaseTreeSource = head\n861\t\t}\n862\t\tif baseTreeSource != \"\" {\n863\t\t\tmeta.BaseTree = snapshot.TreeOID(repo, baseTreeSource)\n864\t\t}\n865\t\tvar caveats []string\n866\t\tif len(snap.Excluded) > 0 {\n867\t\t\tcaveats = append(caveats, fmt.Sprintf(\"snapshot excluded %d denylisted untracked path(s)\", len(snap.Excluded)))\n868\t\t}\n869\t\treturn meta, caveats\n870\t}\n871\t\n872\tfunc initializeRunArtifacts(meta record.Meta, input, finderSystem, finderUser, verifierSystem string) error {\n873\t\tif _, err := record.WriteMetaRequired(meta); err != nil {\n874\t\t\treturn fmt.Errorf(\"initialize run record: %w\", err)\n875\t\t}\n876\t\tfor name, content := range map[string]string{\n877\t\t\t\"input\": input, \"finder_system\": finderSystem,\n878\t\t\t\"finder_user\": finderUser, \"verifier_system\": verifierSystem,\n879\t\t} {\n880\t\t\tif _, err := record.WriteArtifactRequired(meta.RunID, name, content); err != nil {\n881\t\t\t\treturn fmt.Errorf(\"initialize run artifact %s: %w\", name, err)\n882\t\t\t}\n883\t\t}\n884\t\treturn nil\n885\t}\n886\t\n887\tfunc finalizeRunArtifacts(meta record.Meta, report render.Report, repo string) error {\n888\t\tresultJSON := render.ToJSON(report)\n889\t\tif _, err := record.WriteArtifactRequired(meta.RunID, \"result.json\", resultJSON); err != nil {\n890\t\t\treturn fmt.Errorf(\"finalize run result: %w\", err)\n891\t\t}\n892\t\tif _, err := record.WriteReportRequired(meta.RunID, render.ToMarkdown(report, true)); err != nil {\n893\t\t\treturn fmt.Errorf(\"finalize run report: %w\", err)\n894\t\t}\n895\t\tif _, err := record.WriteMetaRequired(meta); err != nil {\n896\t\t\treturn fmt.Errorf(\"finalize run metadata: %w\", err)\n897\t\t}\n898\t\trunDir, err := record.RunDir(meta.RunID)\n899\t\tif err != nil {\n900\t\t\treturn fmt.Errorf(\"resolve run bundle directory: %w\", err)\n901\t\t}\n902\t\tif _, _, _, err := runbundle.Build(runDir); err != nil {\n903\t\t\treturn fmt.Errorf(\"build local run bundle: %w\", err)\n904\t\t}\n905\t\trecord.Record(report, repo, meta.Argv)\n906\t\treturn nil\n907\t}\n908\t\n909\tfunc usageMeta(usage map[string]llm.Usage) map[string]record.UsageMeta {\n910\t\tout := make(map[string]record.UsageMeta, len(usage))\n911\t\tfor role, value := range usage {\n912\t\t\tout[role] = record.UsageMeta{\n913\t\t\t\tUncachedInputTokens: value.UncachedInputTokens,\n914\t\t\t\tCachedInputTokens:   value.CachedInputTokens,\n915\t\t\t\tCacheWriteTokens:    value.CacheWriteTokens,\n916\t\t\t\tOutputTokens:        value.OutputTokens, Calls: value.Calls,\n917\t\t\t}\n918\t\t}\n919\t\treturn out\n920\t}\n921\t\n922\tfunc priorNotes(repo string, result *review.Result) map[string]string {\n923\t\tseen := record.SeenBefore(repo, result.Findings, 3)\n924\t\tif len(seen) == 0 {\n925\t\t\treturn nil\n926\t\t}\n927\t\tout := make(map[string]string, len(seen))\n928\t\tfor fingerprint, sighting := range seen {\n929\t\t\tnote := \"seen previously in run \" + sighting.RunTS\n930\t\t\tif sighting.DropReason != \"\" {\n931\t\t\t\tnote += \" (dropped: \" + sighting.DropReason + \")\"\n932\t\t\t}\n933\t\t\tout[fingerprint] = note\n934\t\t}\n935\t\treturn out\n936\t}\n937\t\n938\t// configInt returns a project config value, or fallback when it is unset.\n939\tfunc configInt(configured *int, fallback int) int {\n940\t\tif configured != nil {\n941\t\t\treturn *configured\n942\t\t}\n943\t\treturn fallback\n944\t}\n945\t\n946\t// flagOrConfigInt returns the flag value when the flag was given, else the\n947\t// project config value, else fallback.\n948\tfunc flagOrConfigInt(flagSet bool, flag int, configured *int,\n949\t\tfallback int) int {\n950\t\tif flagSet {\n951\t\t\treturn flag\n952\t\t}\n953\t\treturn configInt(configured, fallback)\n954\t}\n955\t\n956\t// flagOrConfigDuration returns the flag value when the flag was given, else\n957\t// the project config value, else fallback.\n958\tfunc flagOrConfigDuration(flagSet bool, flag time.Duration,\n959\t\tconfigured *config.Duration, fallback time.Duration) time.Duration {\n960\t\tswitch {\n961\t\tcase flagSet:\n962\t\t\treturn flag\n963\t\tcase configured != nil:\n964\t\t\treturn time.Duration(*configured)\n965\t\t}\n966\t\treturn fallback\n967\t}\n968\t\n969\t// applyRoleFlags applies command-line role overrides, including which\n970\t// credential may follow the role to a new endpoint.\n971\tfunc applyRoleFlags(changed func(string) bool, name string, role config.ResolvedRole, flags roleFlags) (config.ResolvedRole, error) {\n972\t\tvar baseURL, protocol *string\n973\t\tif changed(name + \"-base-url\") {\n974\t\t\tbaseURL = &flags.baseURL\n975\t\t}\n976\t\tif changed(name + \"-protocol\") {\n977\t\t\tprotocol = &flags.protocol\n978\t\t}\n979\t\tif baseURL != nil || protocol != nil {\n980\t\t\tvar err error\n981\t\t\trole, err = config.OverrideEndpoint(name, role, baseURL, protocol)\n982\t\t\tif err != nil {\n983\t\t\t\treturn config.ResolvedRole{}, err\n984\t\t\t}\n985\t\t}\n986\t\tif changed(name + \"-model\") {\n987\t\t\trole.Model = flags.model\n988\t\t}\n989\t\tif changed(name + \"-max-output-tokens\") {\n990\t\t\trole.MaxOutputTokens = flags.maxOutputTokens\n991\t\t}\n992\t\treturn role, nil\n993\t}\n994\t\n995\tfunc clientConfig(roleName string, role config.ResolvedRole, ledger *llm.Ledger, capture func(llm.RawResponse) error, maxAttempts int, requestTimeout time.Duration) llm.ClientConfig {\n996\t\treturn llm.ClientConfig{\n997\t\t\tRole:    roleName,\n998\t\t\tBaseURL: strings.TrimRight(role.BaseURL, \"/\"), APIKey: role.APIKey,\n999\t\t\tModel: role.Model, Protocol: role.Protocol, MaxOutputTokens: role.MaxOutputTokens,\n1000\t\t\tSessionHeader: role.SessionHeader, MaxAttempts: maxAttempts, RequestTimeout: requestTimeout,\n1001\t\t\tLedger: ledger, CaptureResponse: capture,\n1002\t\t}\n1003\t}\n1004\t\n1005\tfunc resolveLangs(in, files []string, mode string) ([]string, error) {\n1006\t\tif mode == \"prose\" {\n1007\t\t\treturn []string{}, nil\n1008\t\t}\n1009\t\tif len(in) == 0 {\n1010\t\t\treturn review.ClassifyLangs(files), nil\n1011\t\t}\n1012\t\tfor _, lang := range in {\n1013\t\t\tif lang == \"none\" {\n1014\t\t\t\tif len(in) != 1 {\n1015\t\t\t\t\treturn nil, fmt.Errorf(\"--lang none cannot be combined with another language pack\")\n1016\t\t\t\t}\n1017\t\t\t\treturn []string{}, nil\n1018\t\t\t}\n1019\t\t\tswitch lang {\n1020\t\t\tcase \"go\", \"react\", \"frontend\", \"web\":\n1021\t\t\tdefault:\n1022\t\t\t\treturn nil, fmt.Errorf(\"unknown language pack %q\", lang)\n1023\t\t\t}\n1024\t\t}\n1025\t\treturn append([]string(nil), in...), nil\n1026\t}\n1027\t\n1028\tfunc verifierPrompt(repo string, tree rcontext.Tree, finding review.Finding) string {\n1029\t\treturn prompts.VerifierUser(prompts.VerifierVars{\n1030\t\t\tSeverity: string(finding.Severity), Confidence: finding.Confidence,\n1031\t\t\tFile: finding.File, Lines: lineRange(finding.Lines),\n1032\t\t\tDescription: finding.Description, CodeQuote: finding.CodeQuote,\n1033\t\t\tFixedCode:   finding.FixedCode,\n1034\t\t\tFileSnippet: rcontext.NumberedSnippet(repo, finding.File, 60_000, tree),\n1035\t\t})\n1036\t}\n1037\t\n1038\tfunc lineRange(lines []int) string {\n1039\t\tswitch len(lines) {\n1040\t\tcase 0:\n1041\t\t\treturn \"?\"\n1042\t\tcase 1:\n1043\t\t\treturn fmt.Sprintf(\"%d\", lines[0])\n1044\t\tdefault:\n1045\t\t\treturn fmt.Sprintf(\"%d-%d\", lines[0], lines[len(lines)-1])\n1046\t\t}"}]},"parent_tool_use_id":null,"session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"6bb71327-1521-4a66-a6d2-e5398b1ca54e","timestamp":"2026-11-24T01:31:08.070Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/internal/cli/cli.go","content":"func runReviewCommand(ctx context.Context, changed func(string) bool,\n\tf *reviewFlags, stdin io.Reader, stdout, stderr io.Writer) error {\n\tif f.staged && f.uncommittedOnly {\n\t\treturn &usageError{msg: \"--staged and --uncommitted-only cannot be combined\"}\n\t}\n\tif f.format != \"json\" && f.format != \"markdown\" && f.format != \"both\" {\n\t\treturn &usageError{msg: fmt.Sprintf(\"invalid --format %q\", f.format)}\n\t}\n\tif f.maxTurns < 1 {\n\t\treturn &usageError{msg: \"max-turns must be positive\"}\n\t}\n\tif f.deadline < 0 {\n\t\treturn &usageError{msg: \"deadline cannot be negative\"}\n\t}\n\tif f.requestTimeout < 0 {\n\t\treturn &usageError{msg: \"request-timeout cannot be negative\"}\n\t}\n\tif f.maxTokensTotal < 0 {\n\t\treturn &usageError{msg: \"max-tokens-total cannot be negative\"}\n\t}\n\tif f.maxVerified < 0 {\n\t\treturn &usageError{msg: \"max-verified cannot be negative\"}\n\t}\n\tif f.maxAttempts < 1 {\n\t\treturn &usageError{msg: \"max-attempts must be positive\"}\n\t}\n\tif f.scope != \"diff\" && f.scope != \"repo\" {\n\t\treturn &usageError{msg: fmt.Sprintf(\"invalid --scope %q (diff|repo)\", f.scope)}\n\t}\n\tsurvey := f.scope == \"repo\"\n\tif survey && f.quick {\n\t\treturn &usageError{msg: \"--quick cannot run a repository survey; drop --quick\"}\n\t}\n\tif survey && (f.staged || f.uncommittedOnly || f.base != \"\") {\n\t\treturn &usageError{msg: \"--scope repo cannot be combined with --staged, --uncommitted-only, or --base\"}\n\t}\n\tgateRank := -1\n\tif f.maxSeverity != \"\" {\n\t\tsev, ok := review.ParseSeverity(strings.ToUpper(f.maxSeverity))\n\t\tif !ok {\n\t\t\treturn &usageError{msg: fmt.Sprintf(\"invalid --max-severity %q\", f.maxSeverity)}\n\t\t}\n\t\tgateRank = sev.Rank()\n\t}\n\n\tcfg, err := loadProjectConfig(f.configPath)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfinderRole, err := cfg.ResolveRole(\"finder\")\n\tif err != nil {\n\t\treturn &usageError{msg: err.Error()}\n\t}\n\tverifierRole, err := cfg.ResolveRole(\"verifier\")\n\tif err != nil {\n\t\treturn &usageError{msg: err.Error()}\n\t}\n\tfinderRole, err = applyRoleFlags(changed, \"finder\", finderRole, f.finder)\n\tif err != nil {\n\t\treturn &usageError{msg: err.Error()}\n\t}\n\tverifierRole, err = applyRoleFlags(changed, \"verifier\", verifierRole, f.verifier)\n\tif err != nil {\n\t\treturn &usageError{msg: err.Error()}\n\t}\n\tflip, err := cfg.ResolveFinderFlip(finderRole, f.authorModel)\n\tif err != nil {\n\t\treturn &usageError{msg: err.Error()}\n\t}\n\tif flip.Note != \"\" {\n\t\tlogf(stderr, \"%s\", flip.Note)\n\t}\n\tif flip.Warn != \"\" {\n\t\tlogf(stderr, \"%s\", flip.Warn)\n\t}\n\tfinderRole = flip.Role\n\tif err := config.ValidateRole(\"finder\", finderRole); err != nil {\n\t\treturn &usageError{msg: err.Error()}\n\t}\n\tdoVerify := !f.quick && !f.noVerify\n\tif doVerify {\n\t\tif err := config.ValidateRole(\"verifier\", verifierRole); err != nil {\n\t\t\treturn &usageError{msg: err.Error()}\n\t\t}\n\t}\n\n\trepo, err := scope.GitRoot(\".\")\n\tif err != nil {\n\t\treturn &usageError{msg: err.Error()}\n\t}\n\tif err := requireTrust(repo, cfg, stdin, stderr); err != nil {\n\t\treturn err\n\t}\n\texcludes := append(append([]string{}, cfg.Review.Excludes...), f.excludes...)\n\tmaxDiffDefault, maxFileContextDefault := defaultMaxDiffBytes, defaultMaxFileCtxBytes\n\tif f.quick {\n\t\tmaxDiffDefault, maxFileContextDefault = defaultQuickDiffBytes, defaultQuickFileCtxBytes\n\t}\n\tlimits := cfg.Limits\n\tmaxDiff := configInt(limits.MaxDiffBytes, maxDiffDefault)\n\tbuild := scope.BuildOpts{\n\t\tBase:            f.base,\n\t\tUncommittedOnly: f.uncommittedOnly,\n\t\tStagedOnly:      f.staged,\n\t\tPaths:           f.paths,\n\t\tExcludes:        excludes,\n\t\tIncludeVendored: f.includeVendored,\n\t\tScope:           f.scope,\n\t\t// No one file's diff can be shown past the whole-diff budget, so\n\t\t// Build need not hold more of it than that.\n\t\tMaxFileDiffBytes: maxDiff,\n\t}\n\ttree := rcontext.Tree{}\n\tif f.staged {\n\t\ttree, err = rcontext.PinIndexTree(repo)\n\t\tif err != nil {\n\t\t\treturn fmt.Errorf(\"pin staged tree: %w\", err)\n\t\t}\n\t\tbuild.StagedTreeOID = tree.OID\n\t}\n\tsc, err := scope.Build(repo, build)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfor _, note := range sc.Notes {\n\t\tlogf(stderr, \"%s\", note)\n\t}\n\tif sc.Empty() {\n\t\tresult := &review.Result{Assessment: review.AssessmentNoDiff, Findings: []review.Finding{}, Dropped: []review.Finding{}, Notes: []string{}}\n\t\treport := render.Report{Result: result, Mode: \"code\", FilesReviewed: []string{}, Task: f.task}\n\t\twriteReport(stdout, stderr, f, report)\n\t\treturn nil\n\t}\n\tinputKind, reviewedInput := \"diff\", sc.Diff\n\tif survey {\n\t\tinputKind, reviewedInput = \"manifest\", sc.Manifest\n\t}\n\trunID := record.NewRunID()\n\t// Pin the reviewed corpus whether or not a replayable snapshot can be\n\t// recorded (snapshots are refused without a HEAD, with an unmerged index,\n\t// or with review.snapshot set to false). Only when Git cannot write the tree at all\n\t// do readers fall back to the live tree, which context guards separately.\n\tvar pin snapshot.Pin\n\tindexTree := tree.OID\n\tif !sc.Staged {\n\t\tvar pinErr error\n\t\tpin, pinErr = snapshot.PinWorktree(repo, nil)\n\t\tif pinErr != nil {\n\t\t\tlogf(stderr, \"could not pin the working tree (%v); reading it live with .git, ignored, and denylisted paths blocked\", pinErr)\n\t\t} else {\n\t\t\ttree = rcontext.PinnedWorktree(pin.Tree)\n\t\t}\n\t}\n\tsnapshotMeta, snapshotCaveats := captureSnapshot(\n\t\tcfg.Review.SnapshotEnabled(), repo, runID, sc, indexTree, pin)\n\tsnapshotDurable := false\n\tif snapshotMeta.Captured {\n\t\tdefer func() {\n\t\t\tif !snapshotDurable {\n\t\t\t\t_ = snapshot.Delete(repo, runID)\n\t\t\t}\n\t\t}()\n\t}\n\n\tground := rcontext.NewQuoteGrounder(repo, tree, sc.Diff, \"\")\n\toriginalDiffBytes := len(sc.Diff)\n\tmaxFileContext := configInt(limits.MaxFileCtxBytes, maxFileContextDefault)\n\tbreakdown := scope.Fit(&sc, maxDiff)\n\n\tmode := f.mode\n\tif mode == \"auto\" {\n\t\tmode = review.ClassifyMode(sc.Files)\n\t}\n\tif mode != \"code\" && mode != \"prose\" && mode != \"mixed\" {\n\t\treturn &usageError{msg: fmt.Sprintf(\"invalid --mode %q\", f.mode)}\n\t}\n\tlangs, err := resolveLangs(f.langs, sc.Files, mode)\n\tif err != nil {\n\t\treturn &usageError{msg: err.Error()}\n\t}\n\tfinderPrompt := cfg.Prompts.FinderCode\n\tif mode == \"prose\" {\n\t\tfinderPrompt = cfg.Prompts.FinderProse\n\t}\n\tsystem, err := prompts.Finder(mode, f.scope, f.quick, langs,\n\t\tcfg.PromptPath(finderPrompt))\n\tif err != nil {\n\t\treturn err\n\t}\n\tverifierSystem, err := prompts.Verifier(\n\t\tcfg.PromptPath(cfg.Prompts.Verifier))\n\tif err != nil {\n\t\treturn err\n\t}\n\tvar user string\n\tif survey {\n\t\tuser = prompts.FinderUser(prompts.FinderUserVars{Task: f.task, Survey: true, Manifest: sc.Manifest})\n\t} else {\n\t\tuser = prompts.FinderUser(prompts.FinderUserVars{\n\t\t\tTask:        f.task,\n\t\t\tDiff:        sc.Diff,\n\t\t\tFileContext: rcontext.BuildFileContext(repo, sc.Files, maxFileContext, tree),\n\t\t})\n\t}\n\n\t// Precedence: command-line flag, then project config, then default.\n\tmaxTokensTotal := flagOrConfigInt(changed(\"max-tokens-total\"),\n\t\tf.maxTokensTotal, limits.MaxTotalTokens, defaultMaxTotalTokens)\n\tmaxVerified := flagOrConfigInt(changed(\"max-verified\"), f.maxVerified,\n\t\tlimits.MaxVerified, defaultMaxVerified)\n\trequestTimeout := flagOrConfigDuration(changed(\"request-timeout\"),\n\t\tf.requestTimeout, limits.RequestTimeout, defaultRequestTimeout)\n\tmaxAttempts := flagOrConfigInt(changed(\"max-attempts\"), f.maxAttempts,\n\t\tlimits.MaxAttempts, defaultMaxAttempts)\n\tledger := llm.NewLedger(maxTokensTotal)\n\tinteractive := f.interactive && !f.quick\n\tmaxTurns := f.maxTurns\n\tif survey {\n\t\tinteractive = true\n\t\tif !changed(\"max-turns\") {\n\t\t\tmaxTurns = surveyMaxTurnsDefault\n\t\t}\n\t}\n\tif interactive && !survey {\n\t\tminLines := configInt(cfg.Interactive.MinDiffLines,\n\t\t\tdefaultInteractiveMinDiffLines)\n\t\tminFiles := configInt(cfg.Interactive.MinFiles,\n\t\t\tdefaultInteractiveMinFiles)\n\t\tif strings.Count(sc.Diff, \"\\n\") < minLines && len(sc.Files) < minFiles {\n\t\t\tlogf(stderr, \"diff is small; using a single structured finder call\")\n\t\t\tinteractive = false\n\t\t}\n\t}\n\tdeadlineDefault := defaultDeadline\n\tif survey {\n\t\tdeadlineDefault = surveyDeadlineDefault\n\t}\n\tdeadlineDuration := flagOrConfigDuration(changed(\"deadline\"), f.deadline,\n\t\tlimits.Deadline, deadlineDefault)\n\tvar deadline time.Time\n\tif deadlineDuration > 0 {\n\t\tdeadline = time.Now().Add(deadlineDuration)\n\t}\n\tbudgets := map[string]any{\n\t\t\"deadline_duration\": deadlineDuration.String(),\n\t\t\"request_timeout\":   requestTimeout.String(),\n\t\t\"max_total_tokens\":  maxTokensTotal,\n\t\t\"verifier_cap\":      maxVerified,\n\t\t\"max_turns\":         maxTurns,\n\t\t\"max_attempts\":      maxAttempts,\n\t}\n\ttools := []llm.Tool(nil)\n\tif interactive {\n\t\ttools = rcontext.ExplorationTools(repo, tree)\n\t}\n\tfloor := cfg.Review.ConfidenceFloor\n\tif f.quick {\n\t\tfloor = cfg.Review.QuickConfidenceFloor\n\t}\n\tpromptCeiling := configInt(limits.MaxPromptBytes, defaultMaxPromptBytes)\n\tbudgets[\"max_prompt_bytes\"] = promptCeiling\n\tif promptBytes, ceiling := len(system)+len(user), promptCeiling; promptBytes > ceiling {\n\t\treturn &usageError{msg: fmt.Sprintf(\"finder prompt is %d bytes, over the %d-byte ceiling; narrow the review scope or adjust limits.max_diff_bytes, limits.max_file_ctx_bytes, or limits.max_prompt_bytes in the project config\", promptBytes, ceiling)}\n\t}\n\tscopeBaseOID := sc.BaseOID\n\tif scopeBaseOID == \"\" {\n\t\tscopeBaseOID = snapshotMeta.Base\n\t}\n\tscopeHeadOID := sc.HeadOID\n\tif scopeHeadOID == \"\" {\n\t\tscopeHeadOID = snapshotMeta.Head\n\t}\n\tenvNames := record.CaptureEnv(cfg.CredentialEnvNames()...)\n\tmeta := record.Meta{\n\t\tRunID: runID, TS: time.Now().UTC().Format(time.RFC3339Nano), Repo: repo,\n\t\tArgv:  append([]string(nil), os.Args[1:]...),\n\t\tRoast: record.BuildMeta{Version: buildinfo.Version, Commit: buildinfo.Commit},\n\t\tScope: record.ScopeMeta{\n\t\t\tKind: f.scope, Base: sc.Base, UncommittedOnly: f.uncommittedOnly,\n\t\t\tStagedOnly: f.staged, IncludeVendored: f.includeVendored,\n\t\t\tPaths: append([]string(nil), f.paths...), Excludes: append([]string(nil), excludes...),\n\t\t\tBaseOID: scopeBaseOID, MergeBaseOID: sc.MergeBaseOID, HeadOID: scopeHeadOID,\n\t\t\tSurvey: sc.Survey, Staged: sc.Staged, Files: append([]string(nil), sc.Files...),\n\t\t},\n\t\tDerived: record.DerivedMeta{\n\t\t\tMode: mode, Langs: append([]string(nil), langs...), Quick: f.quick,\n\t\t\tInteractive: interactive, MaxTurns: maxTurns, ConfidenceFloor: floor,\n\t\t\tDoVerify: doVerify, Task: f.task, MaxSeverity: f.maxSeverity,\n\t\t\tMaxDiffBytes: maxDiff, MaxFileCtxBytes: maxFileContext,\n\t\t},\n\t\tRoles: map[string]record.RoleMeta{\n\t\t\t\"finder\":   roleMeta(finderRole, system),\n\t\t\t\"verifier\": roleMeta(verifierRole, verifierSystem),\n\t\t},\n\t\tSnapshot: snapshotMeta,\n\t\tDigests: record.DigestMeta{\n\t\t\tInputKind: inputKind, Input: record.Digest(reviewedInput), InputBytes: len(reviewedInput),\n\t\t\tSystem: record.Digest(system), User: record.Digest(user),\n\t\t},\n\t\tBudgets: budgets, EnvNamesOnly: envNames, Caveats: snapshotCaveats,\n\t}\n\tif err := initializeRunArtifacts(meta, reviewedInput, system, user, verifierSystem); err != nil {\n\t\t_ = record.RemoveRun(runID)\n\t\treturn err\n\t}\n\tsnapshotDurable = true\n\tresponseRecorder := record.NewResponseRecorder(runID)\n\tcaptureResponse := func(response llm.RawResponse) error {\n\t\treturn responseRecorder.Append(response.Role, response.Protocol, response.Model, response.ContentType, response.Body)\n\t}\n\tfinder, err := llm.New(ctx, clientConfig(\"finder\", finderRole, ledger, captureResponse, maxAttempts, requestTimeout))\n\tif err != nil {\n\t\treturn err\n\t}\n\tlogf(stderr, \"finder=%s profile=%s protocol=%s endpoint=%s\", finderRole.Model, finderRole.Profile, finderRole.Protocol, finderRole.BaseURL)\n\n\tresult, err := review.Find(ctx, finder, review.FindInput{\n\t\tSystem: system, User: user,\n\t\tQuick: f.quick, ConfidenceFloor: floor,\n\t\tInteractive: interactive,\n\t\tTools:       tools,\n\t\tMaxTurns:    maxTurns,\n\t\tGround:      ground,\n\t\tDeadline:    deadline,\n\t\tSurvey:      survey,\n\t\tCapture:     record.OpenFindingSpill(runID),\n\t})\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tusage := map[string]llm.Usage{\"finder\": finder.Usage()}\n\tpartial := result.Incomplete\n\tif doVerify && len(result.Findings) > 0 {\n\t\tverifier, newErr := llm.New(ctx, clientConfig(\"verifier\", verifierRole, ledger, captureResponse, maxAttempts, requestTimeout))\n\t\tif newErr != nil {\n\t\t\treturn newErr\n\t\t}\n\t\tlogf(stderr, \"verifying %d finding(s) with %s (profile=%s protocol=%s)\", len(result.Findings), verifierRole.Model, verifierRole.Profile, verifierRole.Protocol)\n\t\tresult = verify.Verify(ctx, verifier, result, verify.Deps{\n\t\t\tSystemPrompt: verifierSystem,\n\t\t\tUserPrompt: func(finding review.Finding) string {\n\t\t\t\treturn verifierPrompt(repo, tree, finding)\n\t\t\t},\n\t\t\tTools:       rcontext.ExplorationTools(repo, tree),\n\t\t\tMaxTurns:    8,\n\t\t\tMaxVerified: maxVerified,\n\t\t\tLedger:      ledger,\n\t\t\tLog:         func(message string) { fmt.Fprintln(stderr, message) },\n\t\t})\n\t\tusage[\"verifier\"] = verifier.Usage()\n\t\tfor _, finding := range result.Findings {\n\t\t\tif finding.Verdict != nil && finding.Verdict.Undecided {\n\t\t\t\tpartial = true\n\t\t\t}\n\t\t}\n\t}\n\n\tvar reviewKind, completion, stopReason string\n\tif survey {\n\t\treviewKind = \"survey_triage\"\n\t\tif result.Incomplete || result.StopReason == \"deadline\" || result.StopReason == \"token_budget\" || result.StopReason == \"budget_exhausted\" {\n\t\t\tcompletion = \"partial\"\n\t\t\tstopReason = result.StopReason\n\t\t\tif stopReason == \"\" {\n\t\t\t\tstopReason = \"incomplete_no_submission\"\n\t\t\t}\n\t\t} else {\n\t\t\tcompletion, stopReason = \"complete\", \"converged\"\n\t\t\tif result.Assessment == review.AssessmentNoFindings {\n\t\t\t\tresult.Assessment = review.AssessmentNoFindingsInSampledAreas\n\t\t\t}\n\t\t}\n\t}\n\treport := render.Report{\n\t\tResult: result, Mode: mode, FilesReviewed: sc.Files, Task: f.task,\n\t\tRunID: runID, Budgets: budgets,\n\t\tQuick: f.quick, Verified: doVerify,\n\t\tDiffTruncated: len(breakdown) > 0, OriginalDiffBytes: originalDiffBytes,\n\t\tSizeBreakdown: toRenderEntries(breakdown), Usage: usage,\n\t\tPromptPacks: langs,\n\t\tReviewKind:  reviewKind, Completion: completion,\n\t\tManifestFileCount: len(sc.Files), StopReason: stopReason,\n\t}\n\tif spent, limit := ledger.Committed(); limit > 0 {\n\t\tbudgets[\"ledger_committed_tokens\"] = spent\n\t}\n\treport.Prior = priorNotes(repo, result)\n\twriteReport(stdout, stderr, f, report)\n\tmeta.Usage = usageMeta(usage)\n\tmeta.Budgets = budgets\n\tfinalErr := finalizeRunArtifacts(meta, report, repo)\n\tif finalErr == nil {\n\t\tif reportPath, pathErr := record.ReportPath(runID); pathErr == nil {\n\t\t\tlogf(stderr, \"run %s · report %s\", runID, reportPath)\n\t\t}\n\t}\n\treturn reviewExitError(finalErr, gateRank, result.MaxSeverity(), partial)\n}\n\nfunc reviewExitError(finalErr error, gateRank, maxSeverity int, partial bool) error {\n\tif finalErr != nil {\n\t\treturn finalErr\n\t}\n\tif gateRank >= 0 && maxSeverity >= gateRank {\n\t\treturn &gateExit{code: ExitFindings}\n\t}\n\tif partial {\n\t\treturn &gateExit{code: ExitPartial}\n\t}\n\treturn nil\n}\n\nfunc roleMeta(role config.ResolvedRole, systemPrompt string) record.RoleMeta {\n\treturn record.RoleMeta{\n\t\tProfile: role.Profile, BaseURL: role.BaseURL, Model: role.Model, Protocol: role.Protocol,\n\t\tMaxOutputTokens: role.MaxOutputTokens, SessionHeader: role.SessionHeader, PromptDigest: record.Digest(systemPrompt),\n\t}\n}\n\nfunc captureSnapshot(enabled bool, repo, runID string, sc scope.Scope, indexTree string, pin snapshot.Pin) (record.SnapshotMeta, []string) {\n\tif !enabled {\n\t\treturn record.SnapshotMeta{Reason: \"disabled by review.snapshot\"}, []string{\"Git snapshot capture was disabled; this run cannot be replayed.\"}\n\t}\n\thead := sc.HeadOID\n\tif head == \"\" {\n\t\thead = snapshot.HeadOID(repo)\n\t}\n\tbase := sc.BaseOID\n\tif base == \"\" && sc.Base != \"\" {\n\t\tbase = snapshot.RevOID(repo, sc.Base)\n\t}\n\tsnap, err := snapshot.Capture(repo, snapshot.Options{RunID: runID, HeadOID: head, BaseOID: base, IndexTree: indexTree, Worktree: pin})\n\tif err != nil {\n\t\treturn record.SnapshotMeta{Reason: err.Error(), Head: head, Base: base}, []string{\"Git snapshot capture failed: \" + err.Error()}\n\t}\n\tdiffPair := \"base..worktree\"\n\tif sc.Staged {\n\t\tdiffPair = \"head..index\"\n\t} else if sc.Survey {\n\t\tdiffPair = \"head\"\n\t} else if sc.Base == \"\" {\n\t\tdiffPair = \"head..worktree\"\n\t}\n\tmeta := record.SnapshotMeta{\n\t\tCaptured: true, Ref: snap.Ref, Commit: snap.Commit,\n\t\tIndexTree: snap.IndexTree, WorktreeTree: snap.WorktreeTree,\n\t\tHead: snap.Head, Base: snap.Base, DiffPair: diffPair,\n\t\tFileModes:     \"regular and executable files plus symlinks; empty directories are not represented\",\n\t\tExcludedPaths: append([]string(nil), snap.Excluded...),\n\t}\n\tbaseTreeSource := base\n\tif diffPair == \"head..index\" || diffPair == \"head..worktree\" || diffPair == \"head\" {\n\t\tbaseTreeSource = head\n\t}\n\tif baseTreeSource != \"\" {\n\t\tmeta.BaseTree = snapshot.TreeOID(repo, baseTreeSource)\n\t}\n\tvar caveats []string\n\tif len(snap.Excluded) > 0 {\n\t\tcaveats = append(caveats, fmt.Sprintf(\"snapshot excluded %d denylisted untracked path(s)\", len(snap.Excluded)))\n\t}\n\treturn meta, caveats\n}\n\nfunc initializeRunArtifacts(meta record.Meta, input, finderSystem, finderUser, verifierSystem string) error {\n\tif _, err := record.WriteMetaRequired(meta); err != nil {\n\t\treturn fmt.Errorf(\"initialize run record: %w\", err)\n\t}\n\tfor name, content := range map[string]string{\n\t\t\"input\": input, \"finder_system\": finderSystem,\n\t\t\"finder_user\": finderUser, \"verifier_system\": verifierSystem,\n\t} {\n\t\tif _, err := record.WriteArtifactRequired(meta.RunID, name,