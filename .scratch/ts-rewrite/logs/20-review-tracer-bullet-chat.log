{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HUkzLg8Z2PZGUBhYwvusZ2","type":"tool_result","content":"export type BuildMeta = { version:string; commit:string }\nexport type ScopeMeta = {\n    kind:string;\n    base?:string;\n    uncommitted_only?:boolean;\n    staged_only?:boolean;\n    include_vendored?:boolean;\n    paths?:string[];\n    excludes?:string[];\n    base_oid?:string;\n    merge_base_oid?:string;\n    head_oid?:string;\n    survey?:boolean;\n    staged?:boolean;\n    files?:string[];\n}\nexport type DerivedMeta = {\n    mode:string;\n    langs?:string[];\n    quick?:boolean;\n    interactive:boolean;\n    max_turns:number;\n    confidence_floor:number;\n    do_verify:boolean;\n    task?:string;\n    max_severity?:string;\n    max_diff_bytes?:number;\n    max_file_ctx_bytes?:number;\n}\nexport type RoleMeta = {\n    profile?:string;\n    base_url:string;\n    model:string;\n    protocol:string;\n    api?:string;\n    max_output_tokens:number;\n    session_header?:string;\n    prompt_digest?:string;\n}\nexport type SnapshotMeta = {\n    captured:boolean;\n    reason?:string;\n    ref?:string;\n    commit?:string;\n    index_tree?:string;\n    worktree_tree?:string;\n    base_tree?:string;\n    head?:string;\n    base?:string;\n    diff_pair?:string;\n    file_modes?:string;\n    excluded_paths?:string[];\n}\nexport type DigestMeta = {\n    input_kind:string;\n    input:string;\n    input_bytes:number;\n    system_prompt?:string;\n    user_prompt?:string;\n}\nexport type UsageMeta = {\n    uncached_input_tokens:number;\n    cached_input_tokens:number;\n    cache_write_tokens:number;\n    output_tokens:number;\n    calls:number;\n}\nexport type Meta = {\n    run_id:string;\n    replay_of?:string;\n    ts:string;\n    repo:string;\n    invoke_dir?:string;\n    argv?:string[];\n    roast:BuildMeta;\n    scope:ScopeMeta;\n    derived:DerivedMeta;\n    roles:Record<string, RoleMeta>;\n    snapshot:SnapshotMeta;\n    digests:DigestMeta;\n    budgets?:Record<string, unknown>;\n    usage?:Record<string, UsageMeta>;\n    env_names_only?:string[];\n    caveats?:string[];\n}\nexport interface RawResponse {\n    role:string;\n    protocol:Protocol;\n    model:string;\n    contentType:'application/json'|'text/event-stream';\n    // Exact bytes of the body: no request, no headers.\n    body:Uint8Array;\n}\n\nimport { LlmError } from '../llm/errors.js'\nimport { text } from '../textsafe/textsafe.js'\n\nexport const ExitCode = {\n    Clean:0,\n    Findings:1,\n    Usage:2,\n    Auth:3,\n    Partial:4,\n    Cancelled:5,\n} as const\n\nexport type ErrorCategory = 'none'|'findings'|'usage'|'auth'|'endpoint'|\n    'resource_limit'|'partial'|'cancelled'\n\nexport type ErrorFormat = 'text'|'json'\n\nexport class UsageError extends Error {\n    constructor (message:string, options?:ErrorOptions) {\n        super(message, options)\n        this.name = 'UsageError'\n    }\n}\n\nexport class CancelledError extends Error {\n    constructor (message = 'cancelled', options?:ErrorOptions) {\n        super(message, options)\n        this.name = 'CancelledError'\n    }\n}\n\nexport class ExitSignal extends Error {\n    readonly code:1|4\n\n    constructor (code:1|4) {\n        super(`exit ${code}`)\n        this.code = code\n        this.name = 'ExitSignal'\n    }\n}\n\nexport function errorChainHas (\n    err:unknown,\n    test:(e:Error) => boolean\n):boolean {\n    const seen = new Set<unknown>()\n    let cur = err\n    while (cur instanceof Error && !seen.has(cur)) {\n        if (test(cur)) return true\n        seen.add(cur)\n        cur = cur.cause\n    }\n    return false\n}\n\nfunction isAbortError (e:Error):boolean {\n    return e.name === 'AbortError'\n}\n\nexport function isCancellation (err:unknown, signal?:AbortSignal):boolean {\n    if (errorChainHas(err, e => e instanceof CancelledError)) return true\n    if (!signal?.aborted) return false\n    if (!(signal.reason instanceof CancelledError)) return false\n    return errorChainHas(err, isAbortError)\n}\n\nfunction llmKind (err:unknown, kinds:string[]):boolean {\n    return errorChainHas(err, e => {\n        return e instanceof LlmError && kinds.includes(e.kind)\n    })\n}\n\nfunction isUsage (err:unknown):boolean {\n    return errorChainHas(err, e => e instanceof UsageError)\n}\n\nexport function exitCode (err:unknown, signal?:AbortSignal):number {\n    if (err === undefined || err === null) return ExitCode.Clean\n    if (err instanceof ExitSignal) return err.code\n    if (isCancellation(err, signal)) return ExitCode.Cancelled\n    if (llmKind(err, ['auth'])) return ExitCode.Auth\n    if (isUsage(err)) return ExitCode.Usage\n    return ExitCode.Partial\n}\n\nexport function errorCategoryFor (\n    code:number,\n    err:unknown,\n    signal?:AbortSignal\n):ErrorCategory {\n    if (code === ExitCode.Clean) return 'none'\n    if (code === ExitCode.Findings) return 'findings'\n    if (isCancellation(err, signal)) return 'cancelled'\n    if (llmKind(err, ['auth'])) return 'auth'\n    if (llmKind(err, ['endpoint'])) return 'endpoint'\n    if (llmKind(err, ['budget_exhausted', 'work_deadline',\n        'no_final_call'])) {\n        return 'resource_limit'\n    }\n    if (isUsage(err) || code === ExitCode.Usage) return 'usage'\n    if (code === ExitCode.Cancelled) return 'cancelled'\n    return 'partial'\n}\n\nexport function writeError (\n    out:NodeJS.WritableStream,\n    code:number,\n    err:Error,\n    format:ErrorFormat,\n    signal?:AbortSignal\n):void {\n    if (err instanceof ExitSignal) return\n    if (format === 'json') {\n        const body = {\n            error_category:errorCategoryFor(code, err, signal),\n            message:err.message,\n            exit_code:code,\n        }\n        out.write(`${JSON.stringify(body)}\\n`)\n        return\n    }\n    out.write(`roast: ${text(err.message)}\\n`)\n}","is_error":false}]},"parent_tool_use_id":"toolu_013ZjZWsp3co15WosgrPTPBD","agent_id":"a0cf7d3e7bd92336b","sessi