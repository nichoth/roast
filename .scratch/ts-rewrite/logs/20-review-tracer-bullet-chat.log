{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UhWkjoeLEHQQaVSpXoQQn7","type":"tool_result","content":"    return new UsageError(message, { cause:err })\n}\n\n// The config path: `explicit` (--config) unchanged when set, else the\n// nearest .roast.json from the working directory up to the Git toplevel\n// (the working directory itself outside a repository). '' when none.\nexport async function projectConfigPath (\n    explicit:string,\n    ctx:ConfigContext\n):Promise<string> {\n    if (explicit !== '') return explicit\n    let stop = ctx.cwd\n    try {\n        stop = await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n    }\n    return findConfig(ctx.cwd, stop)\n}\n\n// The config the pre-commit hook sees: only <toplevel>/.roast.json.\nexport function gateConfigPath (repo:string):string {\n    return findConfig(repo, repo)\n}\n\nexport async function loadProjectConfig (\n    explicit:string,\n    ctx:ConfigContext\n):Promise<ProjectConfig> {\n    let file:string\n    try {\n        file = await projectConfigPath(explicit, ctx)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw usage(err)\n    }\n    if (file === '') throw new UsageError(NO_PROJECT_CONFIG)\n    let cfg:ProjectConfig\n    try {\n        cfg = loadConfig(file)\n    } catch (err) {\n        throw usage(err)\n    }\n    // Every loaded config carries the stored-credentials store for the\n    // working directory; roles read its files only when they reach the\n    // stored step.\n    const stored = await openCredentialStore(ctx.cwd, ctx.env,\n        { signal:ctx.signal })\n    return withStoredCredentials(cfg, stored)\n}\n----\n\nexport type RoleName = 'finder'|'verifier'\n\ninterface Selection {\n    pin?:boolean;\n    author_routes?:Record<string, string>;\n}\n\nfunction resolveProfile (\n    cfg:ProjectConfig,\n    roleName:string,\n    profileName:string,\n    selection:Selection,\n    env:Env\n):ResolvedRole {\n    if (!Object.hasOwn(cfg.inference_profiles, profileName)) {\n        throw new ConfigError(`role ${roleName} references unknown ` +\n            `inference profile ${JSON.stringify(profileName)}`)\n    }\n    const p = cfg.inference_profiles[profileName]\n    const routes = Object.freeze(Object.assign(Object.create(null),\n        selection.author_routes ?? {})) as Record<string, string>\n    const located = {\n        baseURL:p.endpoint || defaultBaseURL(p.protocol),\n        protocol:p.protocol,\n        stored:cfg.stored,\n    }\n    const { key, source } = resolveCredential(roleName, p.api_key_env ?? '',\n        located, env)\n    return makeRole({\n        ...located,\n        profile:profileName,\n        explicitEndpoint:Boolean(p.endpoint),\n        apiKey:key,\n        model:p.model ?? '',\n        maxOutputTokens:p.max_output_tokens,\n        sessionHeader:p.session_header ?? '',\n        pin:selection.pin ?? false,\n        authorRoutes:routes,\n        credential:Object.freeze(source),\n    })\n}\n\n// Expands a configured role into its profile settings and credential.\n// Only the credential comes from outside the config.\nexport function resolveRole (\n    cfg:ProjectConfig,\n    name:RoleName,\n    env:Env\n):ResolvedRole {\n    const selection = cfg.roles[name]\n    if (!selection?.profile) {\n        throw new ConfigError(`role ${JSON.stringify(name)} is not configured`)\n    }\n    return resolveProfile(cfg, name, selection.profile, selection, env)\n}\n\nexport interface FlipResult {\n    role:ResolvedRole;\n    note?:string;\n    warn?:string;\n}\n\nfunction routeTarget (\n    routes:Readonly<Record<string, string>>,\n    key:string\n):string {\n    return (key !== '' && Object.hasOwn(routes, key)) ? routes[key] : ''\n}\n\n// Keeps finder generation independent of the author: when the finder has\n// a route for the author's model or family, use that profile, unless it\n// is no more independent than the finder.\nexport function resolveFinderFlip (\n    cfg:ProjectConfig,\n    finder:ResolvedRole,\n    authorModel:string,\n    env:Env\n):FlipResult {\n    const authorKey = goTrimSpace(authorModel).toLowerCase()\n    if (authorKey === '') return { role:finder }\n    const authorFamily = inferFamily(authorModel)\n    const finderFamily = inferFamily(finder.model)\n    if (finder.pin) {\n        if (authorFamily !== '' && finderFamily === authorFamily) {\n            return {\n                role:finder,\n                warn:`author-model ${authorModel} shares the finder family ` +\n                    `${authorFamily}, but the finder is pinned; generation ` +\n                    'independence is reduced',\n            }\n        }\n        return { role:finder }\n    }\n    const target = routeTarget(finder.authorRoutes, authorKey) ||\n        routeTarget(finder.authorRoutes, authorFamily)\n    if (target === '') {\n        if (authorFamily === '') {\n            return {\n                role:finder,\n                warn:'could not determine a model family for author-model ' +\n                    `${JSON.stringify(authorModel)} and no exact author ` +\n                    `route is configured; keeping finder ${finder.model}`,\n            }\n        }\n        if (finderFamily === authorFamily) {\n            return {\n                role:finder,\n                warn:`author-model ${authorModel} shares the finder family ` +\n                    `${authorFamily} and no author route is configured; ` +\n                    'generation independence is reduced',\n            }\n        }\n        return { role:finder }\n    }\n    const resolved = resolveProfile(cfg, 'finder', target, {}, env)\n    const targetFamily = inferFamily(resolved.model)\n    if ((authorFamily !== '' &&\n        (targetFamily === '' || targetFamily === authorFamily)) ||\n        resolved.model.toLowerCase() === authorModel.toLowerCase()) {\n        return {\n----\n// The runtime-ready role (spec 02, section 3 `role.ts`). Kept apart from\n// role.ts so credential.ts can build roles without an import cycle.\nimport type { CredentialSource, StoredCredentials } from './credential.js'\n\nexport interface ResolvedRole {\n    readonly profile:string;\n    readonly baseURL:string;\n    // Secret: never logged, recorded, or rendered. Not enumerable, so\n    // JSON.stringify, spread, and util.inspect leave it out.\n    readonly apiKey:string;\n    readonly model:string;\n    readonly protocol:string;\n    readonly maxOutputTokens:number;\n    readonly sessionHeader:string;\n    readonly pin:boolean;\n    readonly authorRoutes:Readonly<Record<string, string>>;\n    readonly credential:CredentialSource;\n    readonly explicitEndpoint:boolean;\n    // Not enumerable either: a store may hold keys.\n    readonly stored?:StoredCredentials;\n}\n\n// A frozen role whose `apiKey` and `stored` are not enumerable.\nexport function makeRole (fields:ResolvedRole):ResolvedRole {\n    const { apiKey, stored, ...visible } = fields\n    const role = { ...visible }\n    Object.defineProperty(role, 'apiKey', { value:apiKey, enumerable:false })\n    Object.defineProperty(role, 'stored', { value:stored, enumerable:false })\n    return Object.freeze(role) as ResolvedRole\n}\n\n// A copy of `role` with `changes` applied. Use this instead of a spread,\n// which drops the non-enumerable key and store.\nexport function updateRole (\n    role:ResolvedRole,\n    changes:Partial<ResolvedRole>\n):ResolvedRole {\n    return makeRole({\n        profile:role.profile,\n        baseURL:role.baseURL,\n        apiKey:role.apiKey,\n        model:role.model,\n        protocol:role.protocol,\n        maxOutputTokens:role.maxOutputTokens,\n        sessionHeader:role.sessionHeader,\n        pin:role.pin,\n        authorRoutes:role.authorRoutes,\n        credential:role.credential,\n        explicitEndpoint:role.explicitEndpoint,\n        stored:role.stored,\n        ...changes,\n    })\n}\n----\n    return updateRole(role, { apiKey:found.key, credential:found.source })\n}\n\n// Applies `--<role>-base-url` / `--<role>-protocol` (undefined = flag not\n// given) and re-binds the credential through the same path as initial\n// resolution. Throws only when a needed stored credential is unusable.\nexport function overrideEndpoint (\n    roleName:string,\n    role:ResolvedRole,\n    overrides:Overrides,\n    env:Env\n):ResolvedRole {\n    const moved = applyEndpointOverrides(role, overrides)\n    return rebindCredential(roleName, moved.role, moved.crossed, env)\n}\n\n// Exposed for the override matrix tests only.\nexport const internal = { applyEndpointOverrides, rebindCredential }\n----\n    'project config again with `npx roast trust`'\n\n// What requireTrust may touch: the CLI context without its command\n// details.\nexport type TrustIo = Pick<RunContext,\n    'stdin'|'stderr'|'lines'|'env'|'signal'>\n\n// Prints every security-relevant value of the projection, each escaped to\n// one line so config text cannot add lines or terminal escapes.\nexport function writeTrustSummary (\n    out:NodeJS.WritableStream,\n    p:TrustProjection\n):void {\n    let text = 'This project config sends code and credentials to:\\n'\n    for (const profile of p.profiles) {\n        const credential = profile.credentialEnv === '' ?\n            '(none named)' :\n            line(profile.credentialEnv)\n        text += `  ${line(profile.selector)}: profile ` +\n            `${line(profile.profile)}\\n` +\n            `    endpoint:   ${line(profile.endpoint)}\\n` +\n            `    protocol:   ${line(profile.protocol)}\\n` +\n            `    credential: ${credential}\\n`\n    }\n    if (p.promptOverrides.length > 0) {\n        text += 'and replaces prompts with these files:\\n'\n        for (const o of p.promptOverrides) {\n            text += `  ${line(o.name)}: ${line(o.path)}\\n`\n        }\n    }\n    out.write(text)\n}\n\n// Fails unless the config needs no approval or this clone approved it.\n// On terminals it asks inline (on stderr); elsewhere it never reads\n// stdin. A trust record that cannot be read is not a usage error.\nexport async function requireTrust (\n    dir:string,\n    cfg:ProjectConfig,\n    io:TrustIo\n):Promise<void> {\n    const p = trustProjection(cfg)\n    if (!requiresApproval(p)) return\n    const hash = trustHash(p)\n    const opts = { env:io.env as NodeJS.ProcessEnv, signal:io.signal }\n    const state = await isApproved(dir, hash, opts)\n    if (state === 'approved') return\n    if (!interactiveTerminals(io.stdin, io.stderr)) {\n        throw new UsageError(state === 'legacy' ?\n            LEGACY_APPROVAL :\n            NOT_APPROVED)","is_error":false}]},"parent_tool_use_id":"toolu_013ZjZWsp3co15WosgrPTPBD","agent_id":"a0cf7d3e7bd92336b","session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"a6018730-a83d-401a-998f-077b196c03cf","timestamp":"2026-11-24T01:28:38.919Z","tool_result_meta":[{"id":"toolu_01UhWkjoeLEHQQaVSpXoQQn7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"Explore","task_description":"Map module APIs for review wiring"}
