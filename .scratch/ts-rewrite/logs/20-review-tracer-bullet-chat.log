{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLteBrTaHcbmQ8UJskCY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QF7VjixuXqprrVVAZhQZmq","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/src/cli/snapshot-meta.ts","content":"// The snapshot capture decision for a review (spec 01, 2.13). The\n// snapshot area's functions are injected; until that area lands, the\n// default capture fails, which records `captured: false` with a reason.\nimport { git, type GitRunOpts } from '../git/git.js'\nimport type { SnapshotMeta } from '../record/meta-types.js'\nimport type { Scope } from '../scope/index.js'\n\n// A pinned worktree tree (snapshot area PinWorktree); null when none.\nexport type WorktreePin = { readonly tree:string }|null\n\nexport interface CaptureOptions {\n    runId:string;\n    headOID:string;\n    baseOID:string;\n    indexTree:string;\n    worktree:WorktreePin;\n}\n\nexport interface Capture {\n    ref:string;\n    commit:string;\n    indexTree:string;\n    worktreeTree:string;\n    head:string;\n    base:string;\n    excluded:string[];\n}\n\nexport interface SnapshotDeps {\n    capture (repo:string, opts:CaptureOptions):Promise<Capture>;\n    // Each resolves '' when the revision does not resolve.\n    headOID (repo:string):Promise<string>;\n    revOID (repo:string, rev:string):Promise<string>;\n    treeOID (repo:string, rev:string):Promise<string>;\n}\n\nexport const DISABLED_REASON = 'disabled by review.snapshot'\nexport const DISABLED_CAVEAT =\n    'Git snapshot capture was disabled; this run cannot be replayed.'\nexport const FILE_MODES = 'regular and executable files plus symlinks; ' +\n    'empty directories are not represented'\n\nasync function revParse (\n    repo:string,\n    rev:string,\n    opts:GitRunOpts\n):Promise<string> {\n    try {\n        const out = await git(repo,\n            ['rev-parse', '--verify', '--quiet', '--end-of-options', rev],\n            opts)\n        return out.toString('utf8').trim()\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        return ''\n    }\n}\n\nexport function defaultSnapshotDeps (opts:GitRunOpts):SnapshotDeps {\n    return {\n        capture () {\n            return Promise.reject(\n                new Error('snapshot capture is not available yet'))\n        },\n        headOID:repo => revParse(repo, 'HEAD^{commit}', opts),\n        revOID:(repo, rev) => revParse(repo, `${rev}^{commit}`, opts),\n        treeOID:(repo, rev) => revParse(repo, `${rev}^{tree}`, opts),\n    }\n}\n\nexport interface SnapshotDecision {\n    meta:SnapshotMeta;\n    caveats:string[];\n}\n\nexport async function captureSnapshot (\n    enabled:boolean,\n    repo:string,\n    runId:string,\n    scope:Pick<Scope, 'headOID'|'base'|'staged'|'survey'>,\n    indexTree:string,\n    pin:WorktreePin,\n    deps:SnapshotDeps\n):Promise<SnapshotDecision> {\n    if (!enabled) {\n        return {\n            meta:{ captured:false, reason:DISABLED_REASON },\n            caveats:[DISABLED_CAVEAT],\n        }\n    }\n    const head = scope.headOID || await deps.headOID(repo)\n    const base = scope.base !== '' ? await deps.revOID(repo, scope.base) : ''\n    let snap:Capture\n    try {\n        snap = await deps.capture(repo, {\n            runId, headOID:head, baseOID:base, indexTree, worktree:pin,\n        })\n    } catch (err) {\n        const reason = err instanceof Error ? err.message : String(err)\n        return {\n            meta:{ captured:false, reason, head, base },\n            caveats:[`Git snapshot capture failed: ${reason}`],\n        }\n    }\n    const diffPair = scope.staged ? 'head..index' :\n        scope.survey ? 'head' :\n            scope.base === '' ? 'head..worktree' : 'base..worktree'\n    const meta:SnapshotMeta = {\n        captured:true,\n        ref:snap.ref,\n        commit:snap.commit,\n        index_tree:snap.indexTree,\n        worktree_tree:snap.worktreeTree,\n        head:snap.head,\n        base:snap.base,\n        diff_pair:diffPair,\n        file_modes:FILE_MODES,\n        excluded_paths:[...snap.excluded],\n    }\n    const src = diffPair === 'base..worktree' ? base : head\n    if (src !== '') meta.base_tree = await deps.treeOID(repo, src)\n    const caveats = snap.excluded.length > 0 ?\n        [`snapshot excluded ${snap.excluded.length} denylisted untracked ` +\n            'path(s)'] :\n        []\n    return { meta, caveats }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":542,"cache_read_input_tokens":168029,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":542},"output_tokens":9,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"f23c3608-bd03-4185-a38e-53823b428927","timestamp":"2026-11-24T01:33:04.329Z","request_id":"req_011ChLteBi3FfGTrTgWn25rJ","wire_tool_inputs":{"toolu_01QF7VjixuXqprrVVAZhQZmq":{"file_path":"/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/src/cli/snapshot-meta.ts","content":"// The snapshot capture decision for a review (spec 01, 2.13). The\n// snapshot area's functions are injected; until that area lands, the\n// default capture fails, which records `captured: false` with a reason.\nimport { git, type GitRunOpts } from '../git/git.js'\nimport type { SnapshotMeta } from '../record/meta-types.js'\nimport type { Scope } from '../scope/index.js'\n\n// A pinned worktree tree (snapshot area PinWorktree); null when none.\nexport type WorktreePin = { readonly tree:string }|null\n\nexport interface CaptureOptions {\n    runId:string;\n    headOID:string;\n    baseOID:string;\n    indexTree:string;\n    worktree:WorktreePin;\n}\n\nexport interface Capture {\n    ref:string;\n    commit:string;\n    indexTree:string;\n    worktreeTree:string;\n    head:string;\n    base:string;\n    excluded:string[];\n}\n\nexport interface SnapshotDeps {\n    capture (repo:string, opts:CaptureOptions):Promise<Capture>;\n    // Each resolves '' when the revision does not resolve.\n    headOID (repo:string):Promise<string>;\n    revOID (repo:string, rev:string):Promise<string>;\n    treeOID (repo:string, rev:string):Promise<string>;\n}\n\nexport const DISABLED_REASON = 'disabled by review.snapshot'\nexport const DISABLED_CAVEAT =\n    'Git snapshot capture was disabled; this run cannot be replayed.'\nexport const FILE_MODES = 'regular and executable files plus symlinks; ' +\n    'empty directories are not represented'\n\nasync function revParse (\n    repo:string,\n    rev:string,\n    opts:GitRunOpts\n):Promise<string> {\n    try {\n        const out = await git(repo,\n            ['rev-parse', '--verify', '--quiet', '--end-of-options', rev],\n            opts)\n        return out.toString('utf8').trim()\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        return ''\n    }\n}\n\nexport function defaultSnapshotDeps (opts:GitRunOpts):SnapshotDeps {\n    return {\n        capture () {\n            return Promise.reject(\n                new Error('snapshot capture is not available yet'))\n        },\n        headOID:repo => revParse(repo, 'HEAD^{commit}', opts),\n        revOID:(repo, rev) => revParse(repo, `${rev}^{commit}`, opts),\n        treeOID:(repo, rev) => revParse(repo, `${rev}^{tree}`, opts),\n    }\n}\n\nexport interface SnapshotDecision {\n    meta:SnapshotMeta;\n    caveats:string[];\n}\n\nexport async function captureSnapshot (\n    enabled:boolean,\n    repo:string,\n    runId:string,\n    scope:Pick<Scope, 'headOID'|'base'|'staged'|'survey'>,\n    indexTree:string,\n    pin:WorktreePin,\n    deps:SnapshotDeps\n):Promise<SnapshotDecision> {\n    if (!enabled) {\n        return {\n            meta:{ captured:false, reason:DISABLED_REASON },\n            caveats:[DISABLED_CAVEAT],\n        }\n    }\n    const head = scope.headOID || await deps.headOID(repo)\n    const base = scope.base !== '' ? await deps.revOID(repo, scope.base) : ''\n    let snap:Capture\n    try {\n        snap = await deps.capture(repo, {\n            runId, headOID:head, baseOID:base, indexTree, worktree:pin,\n        })\n    } catch (err) {\n        const reason = err instanceof Error ? err.message : String(err)\n        return {\n            meta:{ captured:false, reason, head, base },\n            caveats:[`Git snapshot capture failed: ${reason}`],\n        }\n    }\n    const diffPair = scope.staged ? 'head..index' :\n        scope.survey ? 'head' :\n            scope.base === '' ? 'head..worktree' : 'base..worktree'\n    const meta:SnapshotMeta = {\n        captured:true,\n        ref:snap.ref,\n        commit:snap.commit,\n        index_tree:snap.indexTree,\n        worktree_tree:snap.worktreeTree,\n        head:snap.head,\n        base:snap.base,\n        diff_pair:diffPair,\n        file_modes:FILE_MODES,\n        excluded_paths:[...snap.excluded],\n    }\n    const src = diffPair === 'base..worktree' ? base : head\n    if (src !== '') meta.base_tree = await deps.treeOID(repo, src)\n    const caveats = snap.excluded.length > 0 ?\n        [`snapshot excluded ${snap.excluded.length} denylisted untracked ` +\n            'path(s)'] :\n        []\n    return { meta, caveats }\n}\n"}}}
