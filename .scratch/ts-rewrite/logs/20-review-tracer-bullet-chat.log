eadonly headOID:string;\n}\n\nexport interface SizeEntry {\n    path:string;\n    bytes:number;\n}\n\n// Whether there is nothing to review.\nexport function isEmpty (scope:Scope):boolean {\n    if (scope.survey) return scope.files.length === 0\n    return goTrimSpace(scope.diff) === ''\n}\n\nexport async function build (\n    repo:string,\n    opts:BuildOpts,\n    signal?:AbortSignal\n):Promise<Scope> {\n    const run:GitRunOpts = { signal, env:opts.env }\n    const notes:string[] = []\n    const maxSection = opts.maxFileDiffBytes && opts.maxFileDiffBytes > 0 ?\n// and returns a per-file size breakdown, largest first (stable: ties keep\n// files order). Returns a new Scope.\nexport function fit (\n    scope:Scope,\n    maxBytes:number\n):{ scope:Scope, breakdown:SizeEntry[]|null } {\n    if (scope.diffBytes.length <= maxBytes) return { scope, breakdown:null }\n    const breakdown = scope.files\n        .map(path => ({ path, bytes:fileDiffBytes(scope.diffBytes, path) }))\n        .sort((a, b) => b.bytes - a.bytes)\n    const diffBytes = Buffer.concat([\n        scope.diffBytes.subarray(0, maxBytes),\n        Buffer.from('\\n... (diff truncated)\\n'),\n    ])\n    return {\n        scope:{\n// The review scope area's public surface.\nexport {\n    build,\n    fit,\n    isEmpty,\n    type BuildOpts,\n    type Scope,\n    type ScopeKind,\n    type SizeEntry,\n} from './build.js'\nexport {\n    DEFAULT_IGNORES,\n    DIFF_CONFIG,\n    DIFF_FLAGS,\n    PATCH_FLAGS,\n    SECTION_OMITTED_MARKER,\n} from './constants.js'\nexport { gitPatch, GitError } from './git.js'\nexport { SectionCapper } from './patch.js'\nexport { gitRoot } from '../git/git.js'\n):Promise<boolean> {\n    const exit = await runGit(repo, args, opts)\n    return exit.code === 0\n}\n\n// The repository toplevel containing `start`.\nexport async function gitRoot (\n    start:string,\n    opts:GitRunOpts = {}\n):Promise<string> {\n    let out:Buffer\n    try {\n        out = await git(start, ['rev-parse', '-