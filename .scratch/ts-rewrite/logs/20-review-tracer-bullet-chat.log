+    t.equal(res.sent, 1, 'the finder request was in flight')","+    t.equal(res.code, 5, 'exit 5')","+    t.deepEqual(await survivors(r), [], 'no child process remains')","+})","+","+// A `git` that stalls on `diff` and takes 300 ms to exit on SIGTERM, so","+// the review is still winding down when the second SIGINT arrives.","+function slowGit (r:ReviewRepo):{ env:Record<string, string>, marker:string } {","+    const bin = path.join(path.dirname(r.dir), 'slow-bin')","+    fs.mkdirSync(bin)","+    const marker = path.join(bin, 'stalled')","+    const real = execFileSync('sh', ['-c', 'command -v git'], {","+        env:r.env,","+    }).toString().trim()","+    fs.writeFileSync(path.join(bin, 'git'), [","+        '#!/bin/sh',","+        'for a in \"$@\"; do',","+        '  if [ \"$a\" = diff ]; then',","+        '    sleep 10 & p=$!',","+        `    trap 'sleep 0.3; kill $p; exit 1' TERM`,","+        `    : > '${marker}'`,","+        '    wait $p',","+        '    exit 1',","+        '  fi',","+        'done',","+        `exec '${real}' \"$@\"`,","+        '',","+    ].join('\\n'), { mode:0o755 })","+    return { env:{ ...r.env, PATH:`${bin}:${r.env.PATH}` }, marker }","+}","+","+test('the built CLI: a second SIGINT exits 130', async t => {","+    const r = await settingsRepo(t)","+    const { env, marker } = slowGit(r)","+    const res = await spawnReview(r, env, () => fs.existsSync(marker), true)","+    t.ok(fs.existsSync(marker), 'git was stalled')","+    t.equal(res.code, 130, 'exit 130')","+    t.equal(res.sent, 0, 'nothing sent')","+    t.deepEqual(await survivors(r), [], 'no child process remains')"," })"]}]}],"moreFiles":0,"changedFiles":["/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/test/cli/review-errors.ts"]}},"tool_result_meta":[{"id":"toolu_01CCFPeCVvwGjegxkjNVxSmw","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
