{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLtgP9gAUDYakHQcs66e","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Lf95aw7457iALhmMx9Wa9G","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/src/cli/review.ts","content":"// `roast review`, also the default command: the review orchestration of\n// spec 01, 2.8. Verification (step 17) and snapshots are other tickets:\n// the verifier step passes the finder result through, and snapshot\n// capture is injected (see snapshot-meta.ts).\nimport { buildInfo } from '../buildinfo.js'\nimport {\n    type ProjectConfig,\n    credentialEnvNames,\n    promptPath,\n    snapshotEnabled,\n} from '../config/load.js'\nimport { DEFAULT_LIMITS } from '../config/defaults.js'\nimport { resolveFinderFlip, resolveRole, validateRole }\n    from '../config/role.js'\nimport type { ResolvedRole } from '../config/resolved-role.js'\nimport { buildFileContext } from '../context/snippet.js'\nimport { newQuoteGrounder } from '../context/grounding.js'\nimport { explorationTools } from '../context/tools.js'\nimport { LIVE_TREE, pinIndexTree, type Tree } from '../context/tree.js'\nimport { gitRoot } from '../git/git.js'\nimport {\n    type GoDuration,\n    formatGoDuration,\n    parseGoDuration,\n    toMillis,\n} from '../gocompat/duration.js'\nimport { createClient, createModelClient } from '../llm/client.js'\nimport { type Ledger, committed, newLedger } from '../llm/ledger.js'\nimport type {\n    Client, ClientConfig, Protocol, RawResponse, RecordUsage, Tool,\n} from '../llm/types.js'\nimport { finderSystem, verifierSystem } from '../prompts/index.js'\nimport { renderFinderUser } from '../prompts/render.js'\nimport { recordDir } from '../record/dir.js'\nimport { openFindingSpill } from '../record/findings.js'\nimport { appendRunLine, seenBefore } from '../record/index-file.js'\nimport {\n    type Meta,\n    type RoleMeta,\n    captureEnv,\n    digest,\n    removeRun,\n    resolveRunDir,\n    writeArtifact,\n    writeMeta,\n    writeReport as writeRunReport,\n} from '../record/meta.js'\nimport { rfc3339NanoUTC } from '../record/json.js'\nimport { ResponseRecorder } from '../record/responses.js'\nimport { newRunId } from '../record/run-id.js'\nimport { toJSON, toMarkdown, type Report } from '../render/render.js'\nimport { writeReport } from '../render/write.js'\nimport { classifyMode } from '../review/classify.js'\nimport { find } from '../review/find.js'\nimport {\n    type Result, type WireFinding, maxSeverity,\n} from '../review/types.js'\nimport { buildBundle } from '../runbundle/bundle.js'\nimport { build, fit, isEmpty, type BuildOpts } from '../scope/index.js'\nimport { ExitSignal, UsageError } from './errors.js'\nimport type { CommandArgs, CommandDef, RunContext } from './command.js'\nimport { loadProjectConfig } from './config.js'\nimport { logf } from './log.js'\nimport {\n    DEFAULT_MAX_TURNS,\n    SURVEY_MAX_TURNS,\n    type ReviewFlags,\n    parseReviewFlags,\n    reviewBuilder,\n    validateReviewFlags,\n} from './review-flags.js'\nimport {\n    applyRoleFlags,\n    configInt,\n    flagOrConfig,\n    resolveLangs,\n} from './resolve.js'\nimport {\n    type SnapshotDeps,\n    captureSnapshot,\n    defaultSnapshotDeps,\n} from './snapshot-meta.js'\nimport { requireTrust } from './trust.js'\n\nconst QUICK_DIFF_BYTES = 200_000\nconst QUICK_FILE_CTX_BYTES = 100_000\nconst SURVEY_DEADLINE = '25m'\nconst INTERACTIVE_MIN_DIFF_LINES = 80\nconst INTERACTIVE_MIN_FILES = 4\nconst VERIFIER_MAX_TURNS = 8\n\n// Swappable for tests: the snapshot area's functions (ticket 22).\nexport const reviewHooks:{\n    snapshot:((ctx:RunContext) => SnapshotDeps)|null;\n} = { snapshot:null }\n\n// Exit selection after a completed run (spec 01, 2.2): a finalize\n// failure wins over the severity gate.\nexport function reviewExitError (\n    finalErr:Error|null,\n    gateRank:number,\n    maxSev:number,\n    partial:boolean\n):Error|null {\n    if (finalErr) return finalErr\n    if (gateRank >= 0 && maxSev >= gateRank) return new ExitSignal(1)\n    if (partial) return new ExitSignal(4)\n    return null\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\n// Config and role failures are usage errors carrying the config area's\n// message.\nfunction asUsage<T> (fn:() => T):T {\n    try {\n        return fn()\n    } catch (err) {\n        if (err instanceof UsageError) throw err\n        throw new UsageError(message(err), { cause:err })\n    }\n}\n\nfunction wrap (prefix:string, err:unknown):Error {\n    return new Error(`${prefix}: ${message(err)}`, { cause:err })\n}\n\nfunction roleMeta (role:ResolvedRole, system:string):RoleMeta {\n    return {\n        profile:role.profile,\n        base_url:role.baseURL,\n        model:role.model,\n        protocol:role.protocol,\n        max_output_tokens:role.maxOutputTokens,\n        session_header:role.sessionHeader,\n        prompt_digest:digest(system),\n    }\n}\n\nfunction clientConfig (\n    name:string,\n    role:ResolvedRole,\n    capture:(raw:RawResponse) => Promise<void>,\n    maxAttempts:number,\n    requestTimeout:GoDuration,\n    fetch:typeof globalThis.fetch\n):ClientConfig {\n    return {\n        role:name,\n        baseUrl:role.baseURL.replace(/\\/+$/, ''),\n        apiKey:role.apiKey,\n        model:role.model,\n        protocol:role.protocol as ''|Protocol,\n        maxOutputTokens:role.maxOutputTokens,\n        sessionHeader:role.sessionHeader,\n        maxAttempts,\n        requestTimeoutMs:toMillis(requestTimeout),\n        captureResponse:capture,\n        fetch,\n    }\n}\n\nfunction newClient (\n    config:ClientConfig,\n    ledger:Ledger|null\n):Client {\n    return createClient(createModelClient(config), { ledger })\n}\n\nfunction countNewlines (s:string):number {\n    let n = 0\n    for (let i = s.indexOf('\\n'); i >= 0; i = s.indexOf('\\n', i + 1)) n++\n    return n\n}\n\nfunction utf8Bytes (s:string):number {\n    return Buffer.byteLength(s, 'utf8')\n}\n\n// The gate bootstrap offer (spec 01, 2.9) runs here once ticket 30\n// lands; it is a no-op until then.\nasync function maybeBootstrapGate (_ctx:RunContext):Promise<void> {}\n\ninterface Roles {\n    finder:ResolvedRole;\n    verifier:ResolvedRole;\n    doVerify:boolean;\n}\n\nfunction resolveRoles (\n    cfg:ProjectConfig,\n    f:ReviewFlags,\n    ctx:RunContext\n):Roles {\n    return asUsage(() => {\n        let finder = resolveRole(cfg, 'finder', ctx.env)\n        let verifier = resolveRole(cfg, 'verifier', ctx.env)\n        finder = applyRoleFlags('finder', finder, f.finder, ctx.env)\n        verifier = applyRoleFlags('verifier', verifier, f.verifier, ctx.env)\n        const flip = resolveFinderFlip(cfg, finder, f.authorModel, ctx.env)\n        if (flip.note) logf(ctx.stderr, flip.note)\n        if (flip.warn) logf(ctx.stderr, flip.warn)\n        finder = flip.role\n        validateRole('finder', finder)\n        const doVerify = !f.quick && !f.noVerify\n        if (doVerify) validateRole('verifier', verifier)\n        return { finder, verifier, doVerify }\n    })\n}\n\nexport async function runReview (\n    f:ReviewFlags,\n    ctx:RunContext\n):Promise<void> {\n    const gateRank = validateReviewFlags(f)\n    const gitOpts = { env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal }\n    const cfg = await loadProjectConfig(f.config, ctx)\n    const roles = resolveRoles(cfg, f, ctx)\n    const { doVerify } = roles\n\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, gitOpts)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw new UsageError(message(err), { cause:err })\n    }\n    await requireTrust(repo, cfg, ctx)\n\n    const survey = f.scope === 'repo'\n    const limits = cfg.limits ?? {}\n    const excludes = [...(cfg.review.excludes ?? []), ...f.exclude]\n    const maxDiff = configInt(limits.max_diff_bytes, f.quick ?\n        QUICK_DIFF_BYTES : DEFAULT_LIMITS.max_diff_bytes)\n    const buildOpts:BuildOpts = {\n        base:f.base,\n        uncommittedOnly:f.uncommittedOnly,\n        stagedOnly:f.staged,\n        paths:f.paths,\n        excludes,\n        includeVendored:f.includeVendored,\n        scope:f.scope,\n        maxFileDiffBytes:maxDiff,\n        env:gitOpts.env,\n    }\n    let tree:Tree = LIVE_TREE\n    if (f.staged) {\n        try {\n            tree = await pinIndexTree(repo, ctx.signal, { env:gitOpts.env })\n        } catch (err) {\n            if (ctx.signal.aborted) throw err\n            throw wrap('pin staged tree', err)\n        }\n        buildOpts.stagedTreeOID = tree.oid\n    }\n    let sc = await build(repo, buildOpts, ctx.signal)\n    for (const note of sc.notes) logf(ctx.stderr, note)\n\n    if (isEmpty(sc)) {\n        writeReport(ctx as never, f.format as 'both', f.showDropped, {\n            result:{\n                assessment:'NO_DIFF', findings:[], dropped:[], notes:[],\n            },\n            mode:'code',\n            filesReviewed:[],\n            task:f.task,\n        })\n        return\n    }\n\n    const inputKind = survey ? 'manifest' : 'diff'\n    const reviewedInput = survey ? sc.manifest : sc.diff\n    const runId = newRunId()\n    const indexTree = tree.oid\n    // No worktree pin until the snapshot area lands: non-staged reviews\n    // read the live tree, which the context area guards.\n    const snapDeps = reviewHooks.snapshot?.(ctx) ??\n        defaultSnapshotDeps(gitOpts)\n    const snap = await captureSnapshot(snapshotEnabled(cfg), repo, runId,\n        sc, indexTree, null, snapDeps)\n\n    const ground = newQuoteGrounder(repo, tree, sc.diffBytes, gitOpts)\n    const originalDiffBytes = sc.diffBytes.length\n    const maxFileContext = configInt(limits.max_file_ctx_bytes, f.quick ?\n        QUICK_FILE_CTX_BYTES : DEFAULT_LIMITS.max_file_ctx_bytes)\n    const fitted = fit(sc, maxDiff)\n    sc = fitted.scope\n    const breakdown = fitted.breakdown ?? []\n\n    let mode = f.mode\n    if (mode === 'auto') mode = classifyMode([...sc.files])\n    if (!['code', 'prose', 'mixed'].includes(mode)) {\n        throw new UsageError(`invalid --mode ${JSON.stringify(f.mode)}`)\n    }\n    const langs = resolveLangs(f.lang, [...sc.files], mode)\n    const overrides = cfg.prompts ?? {}\n    const finderPrompt = (mode === 'prose' ?\n        overrides.finder_prose :\n        overrides.finder_code) ?? ''\n    const system = await finderSystem(mode, f.scope, f.quick, langs,\n        promptPath(cfg, finderPrompt))\n    const verifierPrompt = await verifierSystem(\n        promptPath(cfg, overrides.verifier ?? ''))\n    const user = survey ?\n        renderFinderUser({\n            task:f.task, survey:true, manifest:sc.manifest,\n            diff:'', fileContext:'',\n        }) :\n        renderFinderUser({\n            task:f.task,\n            survey:false,\n            diff:sc.diff,\n            fileContext:await buildFileContext(repo, sc.files,\n                maxFileContext, tree, gitOpts),\n            manifest:'',\n        })\n\n    const maxTokensTotal = flagOrConfig(f.maxTokensTotal,\n        limits.max_total_tokens, DEFAULT_LIMITS.max_total_tokens)\n    const maxVerified = flagOrConfig(f.maxVerified, limits.max_verified,\n        DEFAULT_LIMITS.max_verified)\n    const requestTimeout = flagOrConfig(f.requestTimeout,\n        limits.request_timeout,\n        parseGoDuration(DEFAULT_LIMITS.request_timeout))\n    const maxAttempts = flagOrConfig(f.maxAttempts, limits.max_attempts,\n        DEFAULT_LIMITS.max_attempts)\n    const ledger = newLedger(maxTokensTotal)\n    let interactive = f.interactive && !f.quick\n    let maxTurns = f.maxTurns ?? DEFAULT_MAX_TURNS\n    if (survey) {\n        interactive = true\n        if (f.maxTurns === undefined) maxTurns = SURVEY_MAX_TURNS\n    }\n    if (interactive && !survey) {\n        const minLines = configInt(cfg.interactive?.min_diff_lines,\n            INTERACTIVE_MIN_DIFF_LINES)\n        const minFiles = configInt(cfg.interactive?.min_files,\n            INTERACTIVE_MIN_FILES)\n        if (countNewlines(sc.diff) < minLines && sc.files.length < minFiles) {\n            logf(ctx.stderr,\n                'diff is small; using a single structured finder call')\n            interactive = false\n        }\n    }\n    const deadlineDuration = flagOrConfig(f.deadline, limits.deadline,\n        parseGoDuration(survey ? SURVEY_DEADLINE : DEFAULT_LIMITS.deadline))\n    const deadline = deadlineDuration > 0n ?\n        Date.now() + toMillis(deadlineDuration) :\n        undefined\n    const promptCeiling = configInt(limits.max_prompt_bytes,\n        DEFAULT_LIMITS.max_prompt_bytes)\n    const budgets:Record<string, unknown> = {\n        deadline_duration:formatGoDuration(deadlineDuration),\n        request_timeout:formatGoDuration(requestTimeout),\n        max_total_tokens:maxTokensTotal,\n        verifier_cap:maxVerified,\n        max_turns:maxTurns,\n        max_attempts:maxAttempts,\n        max_prompt_bytes:promptCeiling,\n    }\n    const tools:readonly Tool[] = interactive ?\n        explorationTools(repo, tree, { env:gitOpts.env }) :\n        []\n    const floor = f.quick ?\n        cfg.review.quick_confidence_floor :\n        cfg.review.confidence_floor\n    const promptBytes = utf8Bytes(system) + utf8Bytes(user)\n    if (promptBytes > promptCeiling) {\n        throw new UsageError(`finder prompt is ${promptBytes} bytes, over ` +\n            `the ${promptCeiling}-byte ceiling; narrow the review scope or ` +\n            'adjust limits.max_diff_bytes, limits.max_file_ctx_bytes, or ' +\n            'limits.max_prompt_bytes in the project config')\n    }\n\n    const meta:Meta = {\n        run_id:runId,\n        ts:rfc3339NanoUTC(new Date()),\n        repo,\n        argv:[...ctx.argv],\n        roast:{ version:buildInfo.version, commit:buildInfo.commit },\n        scope:{\n            kind:f.scope,\n            base:sc.base,\n            uncommitted_only:f.uncommittedOnly,\n            staged_only:f.staged,\n            include_vendored:f.includeVendored,\n            paths:[...f.paths],\n            excludes:[...excludes],\n            base_oid:snap.meta.base ?? '',\n            merge_base_oid:'',\n            head_oid:sc.headOID || (snap.meta.head ?? ''),\n            survey:sc.survey,\n            staged:sc.staged,\n            files:[...sc.files],\n        },\n        derived:{\n            mode,\n            langs:[...langs],\n            quick:f.quick,\n            interactive,\n            max_turns:maxTurns,\n            confidence_floor:floor,\n            do_verify:doVerify,\n            task:f.task,\n            max_severity:f.maxSeverity,\n            max_diff_bytes:maxDiff,\n            max_file_ctx_bytes:maxFileContext,\n        },\n        roles:{\n            finder:roleMeta(roles.finder, system),\n            verifier:roleMeta(roles.verifier, verifierPrompt),\n        },\n        snapshot:snap.meta,\n        digests:{\n            input_kind:inputKind,\n            input:digest(reviewedInput),\n            input_bytes:utf8Bytes(reviewedInput),\n            system_prompt:digest(system),\n            user_prompt:digest(user),\n        },\n        budgets,\n        env_names_only:captureEnv(ctx.env as NodeJS.ProcessEnv,\n            credentialEnvNames(cfg)),\n        caveats:snap.caveats,\n    }\n    const records = await recordDir(repo, gitOpts)\n    await initializeRun(records, meta, {\n        input:reviewedInput,\n        finder_system:system,\n        finder_user:user,\n        verifier_system:verifierPrompt,\n    })\n\n    const recorder = new ResponseRecorder(records, runId)\n    const capture = (raw:RawResponse):Promise<void> => recorder.append(\n        raw.role, raw.protocol, raw.model, raw.contentType, raw.body)\n    const finder = newClient(clientConfig('finder', roles.finder, capture,\n        maxAttempts, requestTimeout, ctx.fetch), ledger)\n    logf(ctx.stderr, `finder=${roles.finder.model} ` +\n        `profile=${roles.finder.profile} ` +\n        `protocol=${roles.finder.protocol} ` +\n        `endpoint=${roles.finder.baseURL}`)\n    const spill = await openFindingSpill(records, runId)\n    const spilled:Promise<void>[] = []\n    let result:Result\n    try {\n        result = await find(finder, {\n            system,\n            user,\n            quick:f.quick,\n            confidenceFloor:floor,\n            interactive,\n            tools,\n            maxTurns,\n            ground,\n            deadline,\n            survey,\n            capture:spill ?\n                (w:WireFinding) => { spilled.push(spill(w)) } :\n                undefined,\n        }, ctx.signal)\n    } finally {\n        await Promise.all(spilled)\n    }\n\n    const usage:Record<string, RecordUsage> = { finder:finder.usage() }\n    const partial = result.incomplete === true\n    // Step 17 (verification) is ticket 21: the result passes through.\n\n    let reviewKind:''|'survey_triage' = ''\n    let completion = ''\n    let stopReason = ''\n    if (survey) {\n        reviewKind = 'survey_triage'\n        const r = result.stopReason ?? ''\n        if (result.incomplete || ['deadline', 'token_budget',\n            'budget_exhausted'].includes(r)) {\n            completion = 'partial'\n            stopReason = r || 'incomplete_no_submission'\n        } else {\n            completion = 'complete'\n            stopReason = 'converged'\n            if (result.assessment === 'NO_FINDINGS') {\n                result.assessment = 'NO_FINDINGS_IN_SAMPLED_AREAS'\n            }\n        }\n    }\n    const { spent, limit } = committed(ledger)\n    if (limit > 0) budgets.ledger_committed_tokens = spent\n    const report:Report = {\n        result,\n        mode,\n        filesReviewed:[...sc.files],\n        task:f.task,\n        runId,\n        budgets,\n        quick:f.quick,\n        verified:doVerify,\n        diffTruncated:breakdown.length > 0,\n        originalDiffBytes,\n        sizeBreakdown:breakdown.map(e => ({ path:e.path, bytes:e.bytes })),\n        usage,\n        promptPacks:langs,\n        reviewKind,\n        completion,\n        manifestFileCount:sc.files.length,\n        stopReason,\n    }\n    report.prior = await priorNotes(records, repo, result)\n    writeReport(ctx as never, f.format as 'both', f.showDropped, report)\n\n    meta.usage = usageMeta(usage)\n    meta.budgets = budgets\n    let finalErr:Error|null = null\n    try {\n        await finalizeRun(records, meta, report, repo)\n        logf(ctx.stderr, `run ${runId} · report ` +\n            `${await resolveRunDir(records, runId)}/report.md`)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        finalErr = err as Error\n    }\n    const exit = reviewExitError(finalErr, gateRank, maxSeverity(result),\n        partial)\n    if (exit) throw exit\n}\n\nasync function initializeRun (\n    records:string,\n    meta:Meta,\n    artifacts:Record<string, string>\n):Promise<void> {\n    try {\n        try {\n            await writeMeta(records, meta)\n        } catch (err) {\n            throw wrap('initialize run record', err)\n        }\n        for (const [name, content] of Object.entries(artifacts)) {\n            try {\n                await writeArtifact(records, meta.run_id, name, content)\n            } catch (err) {\n                throw wrap(`initialize run artifact ${name}`, err)\n            }\n        }\n    } catch (err) {\n        if (records) await removeRun(records, meta.run_id).catch(() => {})\n        throw err\n    }\n}\n\nasync function finalizeRun (\n    records:string,\n    meta:Meta,\n    report:Report,\n    repo:string\n):Promise<void> {\n    try {\n        await writeArtifact(records, meta.run_id, 'result.json',\n            toJSON(report))\n    } catch (err) {\n        throw wrap('finalize run result', err)\n    }\n    try {\n        await writeRunReport(records, meta.run_id, toMarkdown(report, true))\n    } catch (err) {\n        throw wrap('finalize run report', err)\n    }\n    try {\n        await writeMeta(records, meta)\n    } catch (err) {\n        throw wrap('finalize run metadata', err)\n    }\n    let runDir:string\n    try {\n        runDir = await resolveRunDir(records, meta.run_id)\n    } catch (err) {\n        throw wrap('resolve run bundle directory', err)\n    }\n    try {\n        buildBundle(runDir)\n    } catch (err) {\n        throw wrap('build local run bundle', err)\n    }\n    await appendRunLine(records, report, repo, meta.argv ?? null)\n        .catch(() => {})\n}\n\nfunction usageMeta (\n    usage:Record<string, RecordUsage>\n):NonNullable<Meta['usage']> {\n    const out:NonNullable<Meta['usage']> = {}\n    for (const [role, u] of Object.entries(usage)) {\n        out[role] = {\n            uncached_input_tokens:u.uncached_input_tokens,\n            cached_input_tokens:u.cached_input_tokens,\n            cache_write_tokens:u.cache_write_tokens,\n            output_tokens:u.output_tokens,\n            calls:u.calls,\n        }\n    }\n    return out\n}\n\nasync function priorNotes (\n    records:string,\n    repo:string,\n    result:Result\n):Promise<Map<string, string>|null> {\n    const seen = await seenBefore(records, repo, result.findings, 3)\n        .catch(() => new Map())\n    if (seen.size === 0) return null\n    const out = new Map<string, string>()\n    for (const [fp, sighting] of seen) {\n        let note = `seen previously in run ${sighting.runTS}`\n        if (sighting.dropReason) note += ` (dropped: ${sighting.dropReason})`\n        out.set(fp, note)\n    }\n    return out\n}\n\nasync function insideRepository (ctx:RunContext):Promise<boolean> {\n    try {\n        await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n        return true\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        return false\n    }\n}\n\nasync function reviewHandler (\n    args:CommandArgs,\n    ctx:RunContext\n):Promise<void> {\n    await maybeBootstrapGate(ctx)\n    const explicit = ctx.path.length > 0\n    if (!explicit && !(await insideRepository(ctx))) {\n        ctx.stderr.write('roast: not in a Git repository; cd into one to ' +\n            'review, or try `roast doctor` / `roast --help`\\n')\n        ctx.stdout.write(await ctx.rootHelp())\n        return\n    }\n    await runReview(parseReviewFlags(args, ctx.argv), ctx)\n}\n\nexport const reviewCommand:CommandDef = {\n    command:['review', '$0'],\n    describe:'Review the current changes (the default command)',\n    builder:reviewBuilder,\n    handler:reviewHandler,\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1704,"cache_read_input_tokens":172081,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1704},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"bb76c3bd-61e1-43e7-9c32-d475bd7ee024","timestamp":"2026-11-24T01:34:23.554Z","request_id":"req_011ChLtgNzkPJxxC8Ewmmxif","wire_tool_inputs":{"toolu_01Lf95aw7457iALhmMx9Wa9G":{"file_path":"/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/src/cli/review.ts","content":"// `roast review`, also the default command: the review orchestration of\n// spec 01, 2.8. Verification (step 17) and snapshots are other tickets:\n// the verifier step passes the finder result through, and snapshot\n// capture is injected (see snapshot-meta.ts).\nimport { buildInfo } from '../buildinfo.js'\nimport {\n    type ProjectConfig,\n    credentialEnvNames,\n    promptPath,\n    snapshotEnabled,\n} from '../config/load.js'\nimport { DEFAULT_LIMITS } from '../config/defaults.js'\nimport { resolveFinderFlip, resolveRole, validateRole }\n    from '../config/role.js'\nimport type { ResolvedRole } from '../config/resolved-role.js'\nimport { buildFileContext } from '../context/snippet.js'\nimport { newQuoteGrounder } from '../context/grounding.js'\nimport { explorationTools } from '../context/tools.js'\nimport { LIVE_TREE, pinIndexTree, type Tree } from '../context/tree.js'\nimport { gitRoot } from '../git/git.js'\nimport {\n    type GoDuration,\n    formatGoDuration,\n    parseGoDuration,\n    toMillis,\n} from '../gocompat/duration.js'\nimport { createClient, createModelClient } from '../llm/client.js'\nimport { type Ledger, committed, newLedger } from '../llm/ledger.js'\nimport type {\n    Client, ClientConfig, Protocol, RawResponse, RecordUsage, Tool,\n} from '../llm/types.js'\nimport { finderSystem, verifierSystem } from '../prompts/index.js'\nimport { renderFinderUser } from '../prompts/render.js'\nimport { recordDir } from '../record/dir.js'\nimport { openFindingSpill } from '../record/findings.js'\nimport { appendRunLine, seenBefore } from '../record/index-file.js'\nimport {\n    type Meta,\n    type RoleMeta,\n    captureEnv,\n    digest,\n    removeRun,\n    resolveRunDir,\n    writeArtifact,\n    writeMeta,\n    writeReport as writeRunReport,\n} from '../record/meta.js'\nimport { rfc3339NanoUTC } from '../record/json.js'\nimport { ResponseRecorder } from '../record/responses.js'\nimport { newRunId } from '../record/run-id.js'\nimport { toJSON, toMarkdown, type Report } from '../render/render.js'\nimport { writeReport } from '../render/write.js'\nimport { classifyMode } from '../review/classify.js'\nimport { find } from '../review/find.js'\nimport {\n    type Result, type WireFinding, maxSeverity,\n} from '../review/types.js'\nimport { buildBundle } from '../runbundle/bundle.js'\nimport { build, fit, isEmpty, type BuildOpts } from '../scope/index.js'\nimport { ExitSignal, UsageError } from './errors.js'\nimport type { CommandArgs, CommandDef, RunContext } from './command.js'\nimport { loadProjectConfig } from './config.js'\nimport { logf } from './log.js'\nimport {\n    DEFAULT_MAX_TURNS,\n    SURVEY_MAX_TURNS,\n    type ReviewFlags,\n    parseReviewFlags,\n    reviewBuilder,\n    validateReviewFlags,\n} from './review-flags.js'\nimport {\n    applyRoleFlags,\n    configInt,\n    flagOrConfig,\n    resolveLangs,\n} from './resolve.js'\nimport {\n    type SnapshotDeps,\n    captureSnapshot,\n    defaultSnapshotDeps,\n} from './snapshot-meta.js'\nimport { requireTrust } from './trust.js'\n\nconst QUICK_DIFF_BYTES = 200_000\nconst QUICK_FILE_CTX_BYTES = 100_000\nconst SURVEY_DEADLINE = '25m'\nconst INTERACTIVE_MIN_DIFF_LINES = 80\nconst INTERACTIVE_MIN_FILES = 4\nconst VERIFIER_MAX_TURNS = 8\n\n// Swappable for tests: the snapshot area's functions (ticket 22).\nexport const reviewHooks:{\n    snapshot:((ctx:RunContext) => SnapshotDeps)|null;\n} = { snapshot:null }\n\n// Exit selection after a completed run (spec 01, 2.2): a finalize\n// failure wins over the severity gate.\nexport function reviewExitError (\n    finalErr:Error|null,\n    gateRank:number,\n    maxSev:number,\n    partial:boolean\n):Error|null {\n    if (finalErr) return finalErr\n    if (gateRank >= 0 && maxSev >= gateRank) return new ExitSignal(1)\n    if (partial) return new ExitSignal(4)\n    return null\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\n// Config and role failures are usage errors carrying the config area's\n// message.\nfunction asUsage<T> (fn:() => T):T {\n    try {\n        return fn()\n    } catch (err) {\n        if (err instanceof UsageError) throw err\n        throw new UsageError(message(err), { cause:err })\n    }\n}\n\nfunction wrap (prefix:string, err:unknown):Error {\n    return new Error(`${prefix}: ${message(err)}`, { cause:err })\n}\n\nfunction roleMeta (role:ResolvedRole, system:string):RoleMeta {\n    return {\n        profile:role.profile,\n        base_url:role.baseURL,\n        model:role.model,\n        protocol:role.protocol,\n        max_output_tokens:role.maxOutputTokens,\n        session_header:role.sessionHeader,\n        prompt_digest:digest(system),\n    }\n}\n\nfunction clientConfig (\n    name:string,\n    role:ResolvedRole,\n    capture:(raw:RawResponse) => Promise<void>,\n    maxAttempts:number,\n    requestTimeout:GoDuration,\n    fetch:typeof globalThis.fetch\n):ClientConfig {\n    return {\n        role:name,\n        baseUrl:role.baseURL.replace(/\\/+$/, ''),\n        apiKey:role.apiKey,\n        model:role.model,\n        protocol:role.protocol as ''|Protocol,\n        maxOutputTokens:role.maxOutputTokens,\n        sessionHeader:role.sessionHeader,\n        maxAttempts,\n        requestTimeoutMs:toMillis(requestTimeout),\n        captureResponse:capture,\n        fetch,\n    }\n}\n\nfunction newClient (\n    config:ClientConfig,\n    ledger:Ledger|null\n):Client {\n    return createClient(createModelClient(config), { ledger })\n}\n\nfunction countNewlines (s:string):number {\n    let n = 0\n    for (let i = s.indexOf('\\n'); i >= 0; i = s.indexOf('\\n', i + 1)) n++\n    return n\n}\n\nfunction utf8Bytes (s:string):number {\n    return Buffer.byteLength(s, 'utf8')\n}\n\n// The gate bootstrap offer (spec 01, 2.9) runs here once ticket 30\n// lands; it is a no-op until then.\nasync function maybeBootstrapGate (_ctx:RunContext):Promise<void> {}\n\ninterface Roles {\n    finder:ResolvedRole;\n    verifier:ResolvedRole;\n    doVerify:boolean;\n}\n\nfunction resolveRoles (\n    cfg:ProjectConfig,\n    f:ReviewFlags,\n    ctx:RunContext\n):Roles {\n    return asUsage(() => {\n        let finder = resolveRole(cfg, 'finder', ctx.env)\n        let verifier = resolveRole(cfg, 'verifier', ctx.env)\n        finder = applyRoleFlags('finder', finder, f.finder, ctx.env)\n        verifier = applyRoleFlags('verifier', verifier, f.verifier, ctx.env)\n        const flip = resolveFinderFlip(cfg, finder, f.authorModel, ctx.env)\n        if (flip.note) logf(ctx.stderr, flip.note)\n        if (flip.warn) logf(ctx.stderr, flip.warn)\n        finder = flip.role\n        validateRole('finder', finder)\n        const doVerify = !f.quick && !f.noVerify\n        if (doVerify) validateRole('verifier', verifier)\n        return { finder, verifier, doVerify }\n    })\n}\n\nexport async function runReview (\n    f:ReviewFlags,\n    ctx:RunContext\n):Promise<void> {\n    const gateRank = validateReviewFlags(f)\n    const gitOpts = { env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal }\n    const cfg = await loadProjectConfig(f.config, ctx)\n    const roles = resolveRoles(cfg, f, ctx)\n    const { doVerify } = roles\n\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, gitOpts)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw new UsageError(message(err), { cause:err })\n    }\n    await requireTrust(repo, cfg, ctx)\n\n    const survey = f.scope === 'repo'\n    const limits = cfg.limits ?? {}\n    const excludes = [...(cfg.review.excludes ?? []), ...f.exclude]\n    const maxDiff = configInt(limits.max_diff_bytes, f.quick ?\n        QUICK_DIFF_BYTES : DEFAULT_LIMITS.max_diff_bytes)\n    const buildOpts:BuildOpts = {\n        base:f.base,\n        uncommittedOnly:f.uncommittedOnly,\n        stagedOnly:f.staged,\n        paths:f.paths,\n        excludes,\n        includeVendored:f.includeVendored,\n        scope:f.scope,\n        maxFileDiffBytes:maxDiff,\n        env:gitOpts.env,\n    }\n    let tree:Tree = LIVE_TREE\n    if (f.staged) {\n        try {\n            tree = await pinIndexTree(repo, ctx.signal, { env:gitOpts.env })\n        } catch (err) {\n            if (ctx.signal.aborted) throw err\n            throw wrap('pin staged tree', err)\n        }\n        buildOpts.stagedTreeOID = tree.oid\n    }\n    let sc = await build(repo, buildOpts, ctx.signal)\n    for (const note of sc.notes) logf(ctx.stderr, note)\n\n    if (isEmpty(sc)) {\n        writeReport(ctx as never, f.format as 'both', f.showDropped, {\n            result:{\n                assessment:'NO_DIFF', findings:[], dropped:[], notes:[],\n            },\n            mode:'code',\n            filesReviewed:[],\n            task:f.task,\n        })\n        return\n    }\n\n    const inputKind = survey ? 'manifest' : 'diff'\n    const reviewedInput = survey ? sc.manifest : sc.diff\n    const runId = newRunId()\n    const indexTree = tree.oid\n    // No worktree pin until the snapshot area lands: non-staged reviews\n    // read the live tree, which the context area guards.\n    const snapDeps = reviewHooks.snapshot?.(ctx) ??\n        defaultSnapshotDeps(gitOpts)\n    const snap = await captureSnapshot(snapshotEnabled(cfg), repo, runId,\n        sc, indexTree, null, snapDeps)\n\n    const ground = newQuoteGrounder(repo, tree, sc.diffBytes, gitOpts)\n    const originalDiffBytes = sc.diffBytes.length\n    const maxFileContext = configInt(limits.max_file_ctx_bytes, f.quick ?\n        QUICK_FILE_CTX_BYTES : DEFAULT_LIMITS.max_file_ctx_bytes)\n    const fitted = fit(sc, maxDiff)\n    sc = fitted.scope\n    const breakdown = fitted.breakdown ?? []\n\n    let mode = f.mode\n    if (mode === 'auto') mode = classifyMode([...sc.files])\n    if (!['code', 'prose', 'mixed'].includes(mode)) {\n        throw new UsageError(`invalid --mode ${JSON.stringify(f.mode)}`)\n    }\n    const langs = resolveLangs(f.lang, [...sc.files], mode)\n    const overrides = cfg.prompts ?? {}\n    const finderPrompt = (mode === 'prose' ?\n        overrides.finder_prose :\n        overrides.finder_code) ?? ''\n    const system = await finderSystem(mode, f.scope, f.quick, langs,\n        promptPath(cfg, finderPrompt))\n    const verifierPrompt = await verifierSystem(\n        promptPath(cfg, overrides.verifier ?? ''))\n    const user = survey ?\n        renderFinderUser({\n            task:f.task, survey:true, manifest:sc.manifest,\n            diff:'', fileContext:'',\n        }) :\n        renderFinderUser({\n            task:f.task,\n            survey:false,\n            diff:sc.diff,\n            fileContext:await buildFileContext(repo, sc.files,\n                maxFileContext, tree, gitOpts),\n            manifest:'',\n        })\n\n    const maxTokensTotal = flagOrConfig(f.maxTokensTotal,\n        limits.max_total_tokens, DEFAULT_LIMITS.max_total_tokens)\n    const maxVerified = flagOrConfig(f.maxVerified, limits.max_verified,\n        DEFAULT_LIMITS.max_verified)\n    const requestTimeout = flagOrConfig(f.requestTimeout,\n        limits.request_timeout,\n        parseGoDuration(DEFAULT_LIMITS.request_timeout))\n    const maxAttempts = flagOrConfig(f.maxAttempts, limits.max_attempts,\n        DEFAULT_LIMITS.max_attempts)\n    const ledger = newLedger(maxTokensTotal)\n    let interactive = f.interactive && !f.quick\n    let maxTurns = f.maxTurns ?? DEFAULT_MAX_TURNS\n    if (survey) {\n        interactive = true\n        if (f.maxTurns === undefined) maxTurns = SURVEY_MAX_TURNS\n    }\n    if (interactive && !survey) {\n        const minLines = configInt(cfg.interactive?.min_diff_lines,\n            INTERACTIVE_MIN_DIFF_LINES)\n        const minFiles = configInt(cfg.interactive?.min_files,\n            INTERACTIVE_MIN_FILES)\n        if (countNewlines(sc.diff) < minLines && sc.files.length < minFiles) {\n            logf(ctx.stderr,\n                'diff is small; using a single structured finder call')\n            interactive = false\n        }\n    }\n    const deadlineDuration = flagOrConfig(f.deadline, limits.deadline,\n        parseGoDuration(survey ? SURVEY_DEADLINE : DEFAULT_LIMITS.deadline))\n    const deadline = deadlineDuration > 0n ?\n        Date.now() + toMillis(deadlineDuration) :\n        undefined\n    const promptCeiling = configInt(limits.max_prompt_bytes,\n        DEFAULT_LIMITS.max_prompt_bytes)\n    const budgets:Record<string, unknown> = {\n        deadline_duration:formatGoDuration(deadlineDuration),\n        request_timeout:formatGoDuration(requestTimeout),\n        max_total_tokens:maxTokensTotal,\n        verifier_cap:maxVerified,\n        max_turns:maxTurns,\n        max_attempts:maxAttempts,\n        max_prompt_bytes:promptCeiling,\n    }\n    const tools:readonly Tool[] = interactive ?\n        explorationTools(repo, tree, { env:gitOpts.env }) :\n        []\n    const floor = f.quick ?\n        cfg.review.quick_confidence_floor :\n        cfg.review.confidence_floor\n    const promptBytes = utf8Bytes(system) + utf8Bytes(user)\n    if (promptBytes > promptCeiling) {\n        throw new UsageError(`finder prompt is ${promptBytes} bytes, over ` +\n            `the ${promptCeiling}-byte ceiling; narrow the review scope or ` +\n            'adjust limits.max_diff_bytes, limits.max_file_ctx_bytes, or ' +\n            'limits.max_prompt_bytes in the project config')\n    }\n\n    const meta:Meta = {\n        run_id:runId,\n        ts:rfc3339NanoUTC(new Date()),\n        repo,\n        argv:[...ctx.argv],\n        roast:{ version:buildInfo.version, commit:buildInfo.commit },\n        scope:{\n            kind:f.scope,\n            base:sc.base,\n            uncommitted_only:f.uncommittedOnly,\n            staged_only:f.staged,\n            include_vendored:f.includeVendored,\n            paths:[...f.paths],\n            excludes:[...excludes],\n            base_oid:snap.meta.base ?? '',\n            merge_base_oid:'',\n            head_oid:sc.headOID || (snap.meta.head ?? ''),\n            survey:sc.survey,\n            staged:sc.staged,\n            files:[...sc.files],\n        },\n        derived:{\n            mode,\n            langs:[...langs],\n            quick:f.quick,\n            interactive,\n            max_turns:maxTurns,\n            confidence_floor:floor,\n            do_verify:doVerify,\n            task:f.task,\n            max_severity:f.maxSeverity,\n            max_diff_bytes:maxDiff,\n            max_file_ctx_bytes:maxFileContext,\n        },\n        roles:{\n            finder:roleMeta(roles.finder, system),\n            verifier:roleMeta(roles.verifier, verifierPrompt),\n        },\n        snapshot:snap.meta,\n        digests:{\n            input_kind:inputKind,\n            input:digest(reviewedInput),\n            input_bytes:utf8Bytes(reviewedInput),\n            system_prompt:digest(system),\n            user_prompt:digest(user),\n        },\n        budgets,\n        env_names_only:captureEnv(ctx.env as NodeJS.ProcessEnv,\n            credentialEnvNames(cfg)),\n        caveats:snap.caveats,\n    }\n    const records = await recordDir(repo, gitOpts)\n    await initializeRun(records, meta, {\n        input:reviewedInput,\n        finder_system:system,\n        finder_user:user,\n        verifier_system:verifierPrompt,\n    })\n\n    const recorder = new ResponseRecorder(records, runId)\n    const capture = (raw:RawResponse):Promise<void> => recorder.append(\n        raw.role, raw.protocol, raw.model, raw.contentType, raw.body)\n    const finder = newClient(clientConfig('finder', roles.finder, capture,\n        maxAttempts, requestTimeout, ctx.fetch), ledger)\n    logf(ctx.stderr, `finder=${roles.finder.model} ` +\n        `profile=${roles.finder.profile} ` +\n        `protocol=${roles.finder.protocol} ` +\n        `endpoint=${roles.finder.baseURL}`)\n    const spill = await openFindingSpill(records, runId)\n    const spilled:Promise<void>[] = []\n    let result:Result\n    try {\n        result = await find(finder, {\n            system,\n            user,\n            quick:f.quick,\n            confidenceFloor:floor,\n            interactive,\n            tools,\n            maxTurns,\n            ground,\n            deadline,\n            survey,\n            capture:spill ?\n                (w:WireFinding) => { spilled.push(spill(w)) } :\n                undefined,\n        }, ctx.signal)\n    } finally {\n        await Promise.all(spilled)\n    }\n\n    const usage:Record<string, RecordUsage> = { finder:finder.usage() }\n    const partial = result.incomplete === true\n    // Step 17 (verification) is ticket 21: the result passes through.\n\n    let reviewKind:''|'survey_triage' = ''\n    let completion = ''\n    let stopReason = ''\n    if (survey) {\n        reviewKind = 'survey_triage'\n        const r = result.stopReason ?? ''\n        if (result.incomplete || ['deadline', 'token_budget',\n            'budget_exhausted'].includes(r)) {\n            completion = 'partial'\n            stopReason = r || 'incomplete_no_submission'\n        } else {\n            completion = 'complete'\n            stopReason = 'converged'\n            if (result.assessment === 'NO_FINDINGS') {\n                result.assessment = 'NO_FINDINGS_IN_SAMPLED_AREAS'\n            }\n        }\n    }\n    const { spent, limit } = committed(ledger)\n    if (limit > 0) budgets.ledger_committed_tokens = spent\n    const report:Report = {\n        result,\n        mode,\n        filesReviewed:[...sc.files],\n        task:f.task,\n        runId,\n        budgets,\n        quick:f.quick,\n        verified:doVerify,\n        diffTruncated:breakdown.length > 0,\n        originalDiffBytes,\n        sizeBreakdown:breakdown.map(e => ({ path:e.path, bytes:e.bytes })),\n        usage,\n        promptPacks:langs,\n        reviewKind,\n        completion,\n        manifestFileCount:sc.files.length,\n        stopReason,\n    }\n    report.prior = await priorNotes(records, repo, result)\n    writeReport(ctx as never, f.format as 'both', f.showDropped, report)\n\n    meta.usage = usageMeta(usage)\n    meta.budgets = budgets\n    let finalErr:Error|null = null\n    try {\n        await finalizeRun(records, meta, report, repo)\n        logf(ctx.stderr, `run ${runId} \\u00b7 report ` +\n            `${await resolveRunDir(records, runId)}/report.md`)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        finalErr = err as Error\n    }\n    const exit = reviewExitError(finalErr, gateRank, maxSeverity(result),\n        partial)\n    if (exit) throw exit\n}\n\nasync function initializeRun (\n    records:string,\n    meta:Meta,\n    artifacts:Record<string, string>\n):Promise<void> {\n    try {\n        try {\n            await writeMeta(records, meta)\n        } catch (err) {\n            throw wrap('initialize run record', err)\n        }\n        for (const [name, content] of Object.entries(artifacts)) {\n            try {\n                await writeArtifact(records, meta.run_id, name, content)\n            } catch (err) {\n                throw wrap(`initialize run artifact ${name}`, err)\n            }\n        }\n    } catch (err) {\n        if (records) await removeRun(records, meta.run_id).catch(() => {})\n        throw err\n    }\n}\n\nasync function finalizeRun (\n    records:string,\n    meta:Meta,\n    report:Report,\n    repo:string\n):Promise<void> {\n    try {\n        await writeArtifact(records, meta.run_id, 'result.json',\n            toJSON(report))\n    } catch (err) {\n        throw wrap('finalize run result', err)\n    }\n    try {\n        await writeRunReport(records, meta.run_id, toMarkdown(report, true))\n    } catch (err) {\n        throw wrap('finalize run report', err)\n    }\n    try {\n        await writeMeta(records, meta)\n    } catch (err) {\n        throw wrap('finalize run metadata', err)\n    }\n    let runDir:string\n    try {\n        runDir = await resolveRunDir(records, meta.run_id)\n    } catch (err) {\n        throw wrap('resolve run bundle directory', err)\n    }\n    try {\n        buildBundle(runDir)\n    } catch (err) {\n        throw wrap('build local run bundle', err)\n    }\n    await appendRunLine(records, report, repo, meta.argv ?? null)\n        .catch(() => {})\n}\n\nfunction usageMeta (\n    usage:Record<string, RecordUsage>\n):NonNullable<Meta['usage']> {\n    const out:NonNullable<Meta['usage']> = {}\n    for (const [role, u] of Object.entries(usage)) {\n        out[role] = {\n            uncached_input_tokens:u.uncached_input_tokens,\n            cached_input_tokens:u.cached_input_tokens,\n            cache_write_tokens:u.cache_write_tokens,\n            output_tokens:u.output_tokens,\n            calls:u.calls,\n        }\n    }\n    return out\n}\n\nasync function priorNotes (\n    records:string,\n    repo:string,\n    result:Result\n):Promise<Map<string, string>|null> {\n    const seen = await seenBefore(records, repo, result.findings, 3)\n        .catch(() => new Map())\n    if (seen.size === 0) return null\n    const out = new Map<string, string>()\n    for (const [fp, sighting] of seen) {\n        let note = `seen previously in run ${sighting.runTS}`\n        if (sighting.dropReason) note += ` (dropped: ${sighting.dropReason})`\n        out.set(fp, note)\n    }\n    return out\n}\n\nasync function insideRepository (ctx:RunContext):Promise<boolean> {\n    try {\n        await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n        return true\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        return false\n    }\n}\n\nasync function reviewHandler (\n    args:CommandArgs,\n    ctx:RunContext\n):Promise<void> {\n    await maybeBootstrapGate(ctx)\n    const explicit = ctx.path.length > 0\n    if (!explicit && !(await insideRepository(ctx))) {\n        ctx.stderr.write('roast: not in a Git repository; cd into one to ' +\n            'review, or try `roast doctor` / `roast --help`\\n')\n        ctx.stdout.write(await ctx.rootHelp())\n        return\n    }\n    await runReview(parseReviewFlags(args, ctx.argv), ctx)\n}\n\nexport const reviewCommand:CommandDef = {\n    command:['review', '$0'],\n    describe:'Review the current changes (the default command)',\n    builder:reviewBuilder,\n    handler:reviewHandler,\n}\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lf95aw7457iALhmMx9Wa9G","type":"tool_result","content":"The file /Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/src/cli/review.ts has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"7aecda83-e113-4f38-bc91-f24bac6e090e","timestamp":"2026-11-24T01:34:23.686Z","tool_use_result":{"type":"update","filePath":"/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/src/cli/review.ts","content":"// `roast review`, also the default command: the review orchestration of\n// spec 01, 2.8. Verification (step 17) and snapshots are other tickets:\n// the verifier step passes the finder result through, and snapshot\n// capture is injected (see snapshot-meta.ts).\nimport { buildInfo } from '../buildinfo.js'\nimport {\n    type ProjectConfig,\n    credentialEnvNames,\n    promptPath,\n    snapshotEnabled,\n} from '../config/load.js'\nimport { DEFAULT_LIMITS } from '../config/defaults.js'\nimport { resolveFinderFlip, resolveRole, validateRole }\n    from '../config/role.js'\nimport type { ResolvedRole } from '../config/resolved-role.js'\nimport { buildFileContext } from '../context/snippet.js'\nimport { newQuoteGrounder } from '../context/grounding.js'\nimport { explorationTools } from '../context/tools.js'\nimport { LIVE_TREE, pinIndexTree, type Tree } from '../context/tree.js'\nimport { gitRoot } from '../git/git.js'\nimport {\n    type GoDuration,\n    formatGoDuration,\n    parseGoDuration,\n    toMillis,\n} from '../gocompat/duration.js'\nimport { createClient, createModelClient } from '../llm/client.js'\nimport { type Ledger, committed, newLedger } from '../llm/ledger.js'\nimport type {\n    Client, ClientConfig, Protocol, RawResponse, RecordUsage, Tool,\n} from '../llm/types.js'\nimport { finderSystem, verifierSystem } from '../prompts/index.js'\nimport { renderFinderUser } from '../prompts/render.js'\nimport { recordDir } from '../record/dir.js'\nimport { openFindingSpill } from '../record/findings.js'\nimport { appendRunLine, seenBefore } from '../record/index-file.js'\nimport {\n    type Meta,\n    type RoleMeta,\n    captureEnv,\n    digest,\n    removeRun,\n    resolveRunDir,\n    writeArtifact,\n    writeMeta,\n    writeReport as writeRunReport,\n} from '../record/meta.js'\nimport { rfc3339NanoUTC } from '../record/json.js'\nimport { ResponseRecorder } from '../record/responses.js'\nimport { newRunId } from '../record/run-id.js'\nimport { toJSON, toMarkdown, type Report } from '../render/render.js'\nimport { writeReport } from '../render/write.js'\nimport { classifyMode } from '../review/classify.js'\nimport { find } from '../review/find.js'\nimport {\n    type Result, type WireFinding, maxSeverity,\n} from '../review/types.js'\nimport { buildBundle } from '../runbundle/bundle.js'\nimport { build, fit, isEmpty, type BuildOpts } from '../scope/index.js'\nimport { ExitSignal, UsageError } from './errors.js'\nimport type { CommandArgs, CommandDef, RunContext } from './command.js'\nimport { loadProjectConfig } from './config.js'\nimport { logf } from './log.js'\nimport {\n    DEFAULT_MAX_TURNS,\n    SURVEY_MAX_TURNS,\n    type ReviewFlags,\n    parseReviewFlags,\n    reviewBuilder,\n    validateReviewFlags,\n} from './review-flags.js'\nimport {\n    applyRoleFlags,\n    configInt,\n    flagOrConfig,\n    resolveLangs,\n} from './resolve.js'\nimport {\n    type SnapshotDeps,\n    captureSnapshot,\n    defaultSnapshotDeps,\n} from './snapshot-meta.js'\nimport { requireTrust } from './trust.js'\n\nconst QUICK_DIFF_BYTES = 200_000\nconst QUICK_FILE_CTX_BYTES = 100_000\nconst SURVEY_DEADLINE = '25m'\nconst INTERACTIVE_MIN_DIFF_LINES = 80\nconst INTERACTIVE_MIN_FILES = 4\nconst VERIFIER_MAX_TURNS = 8\n\n// Swappable for tests: the snapshot area's functions (ticket 22).\nexport const reviewHooks:{\n    snapshot:((ctx:RunContext) => SnapshotDeps)|null;\n} = { snapshot:null }\n\n// Exit selection after a completed run (spec 01, 2.2): a finalize\n// failure wins over the severity gate.\nexport function reviewExitError (\n    finalErr:Error|null,\n    gateRank:number,\n    maxSev:number,\n    partial:boolean\n):Error|null {\n    if (finalErr) return finalErr\n    if (gateRank >= 0 && maxSev >= gateRank) return new ExitSignal(1)\n    if (partial) return new ExitSignal(4)\n    return null\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\n// Config and role failures are usage errors carrying the config area's\n// message.\nfunction asUsage<T> (fn:() => T):T {\n    try {\n        return fn()\n    } catch (err) {\n        if (err instanceof UsageError) throw err\n        throw new UsageError(message(err), { cause:err })\n    }\n}\n\nfunction wrap (prefix:string, err:unknown):Error {\n    return new Error(`${prefix}: ${message(err)}`, { cause:err })\n}\n\nfunction roleMeta (role:ResolvedRole, system:string):RoleMeta {\n    return {\n        profile:role.profile,\n        base_url:role.baseURL,\n        model:role.model,\n        protocol:role.protocol,\n        max_output_tokens:role.maxOutputTokens,\n        session_header:role.sessionHeader,\n        prompt_digest:digest(system),\n    }\n}\n\nfunction clientConfig (\n    name:string,\n    role:ResolvedRole,\n    capture:(raw:RawResponse) => Promise<void>,\n    maxAttempts:number,\n    requestTimeout:GoDuration,\n    fetch:typeof globalThis.fetch\n):ClientConfig {\n    return {\n        role:name,\n        baseUrl:role.baseURL.replace(/\\/+$/, ''),\n        apiKey:role.apiKey,\n        model:role.model,\n        protocol:role.protocol as ''|Protocol,\n        maxOutputTokens:role.maxOutputTokens,\n        sessionHeader:role.sessionHeader,\n        maxAttempts,\n        requestTimeoutMs:toMillis(requestTimeout),\n        captureResponse:capture,\n        fetch,\n    }\n}\n\nfunction newClient (\n    config:ClientConfig,\n    ledger:Ledger|null\n):Client {\n    return createClient(createModelClient(config), { ledger })\n}\n\nfunction countNewlines (s:string):number {\n    let n = 0\n    for (let i = s.indexOf('\\n'); i >= 0; i = s.indexOf('\\n', i + 1)) n++\n    return n\n}\n\nfunction utf8Bytes (s:string):number {\n    return Buffer.byteLength(s, 'utf8')\n}\n\n// The gate bootstrap offer (spec 01, 2.9) runs here once ticket 30\n// lands; it is a no-op until then.\nasync function maybeBootstrapGate (_ctx:RunContext):Promise<void> {}\n\ninterface Roles {\n    finder:ResolvedRole;\n    verifier:ResolvedRole;\n    doVerify:boolean;\n}\n\nfunction resolveRoles (\n    cfg:ProjectConfig,\n    f:ReviewFlags,\n    ctx:RunContext\n):Roles {\n    return asUsage(() => {\n        let finder = resolveRole(cfg, 'finder', ctx.env)\n        let verifier = resolveRole(cfg, 'verifier', ctx.env)\n        finder = applyRoleFlags('finder', finder, f.finder, ctx.env)\n        verifier = applyRoleFlags('verifier', verifier, f.verifier, ctx.env)\n        const flip = resolveFinderFlip(cfg, finder, f.authorModel, ctx.env)\n        if (flip.note) logf(ctx.stderr, flip.note)\n        if (flip.warn) logf(ctx.stderr, flip.warn)\n        finder = flip.role\n        validateRole('finder', finder)\n        const doVerify = !f.quick && !f.noVerify\n        if (doVerify) validateRole('verifier', verifier)\n        return { finder, verifier, doVerify }\n    })\n}\n\nexport async function runReview (\n    f:ReviewFlags,\n    ctx:RunContext\n):Promise<void> {\n    const gateRank = validateReviewFlags(f)\n    const gitOpts = { env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal }\n    const cfg = await loadProjectConfig(f.config, ctx)\n    const roles = resolveRoles(cfg, f, ctx)\n    const { doVerify } = roles\n\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, gitOpts)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw new UsageError(message(err), { cause:err })\n    }\n    await requireTrust(repo, cfg, ctx)\n\n    const survey = f.scope === 'repo'\n    const limits = cfg.limits ?? {}\n    const excludes = [...(cfg.review.excludes ?? []), ...f.exclude]\n    const maxDiff = configInt(limits.max_diff_bytes, f.quick ?\n        QUICK_DIFF_BYTES : DEFAULT_LIMITS.max_diff_bytes)\n    const buildOpts:BuildOpts = {\n        base:f.base,\n        uncommittedOnly:f.uncommittedOnly,\n        stagedOnly:f.staged,\n        paths:f.paths,\n        excludes,\n        includeVendored:f.includeVendored,\n        scope:f.scope,\n        maxFileDiffBytes:maxDiff,\n        env:gitOpts.env,\n    }\n    let tree:Tree = LIVE_TREE\n    if (f.staged) {\n        try {\n            tree = await pinIndexTree(repo, ctx.signal, { env:gitOpts.env })\n        } catch (err) {\n            if (ctx.signal.aborted) throw err\n            throw wrap('pin staged tree', err)\n        }\n        buildOpts.stagedTreeOID = tree.oid\n    }\n    let sc = await build(repo, buildOpts, ctx.signal)\n    for (const note of sc.notes) logf(ctx.stderr, note)\n\n    if (isEmpty(sc)) {\n        writeReport(ctx as never, f.format as 'both', f.showDropped, {\n            result:{\n                assessment:'NO_DIFF', findings:[], dropped:[], notes:[],\n            },\n            mode:'code',\n            filesReviewed:[],\n            task:f.task,\n        })\n        return\n    }\n\n    const inputKind = survey ? 'manifest' : 'diff'\n    const reviewedInput = survey ? sc.manifest : sc.diff\n    const runId = newRunId()\n    const indexTree = tree.oid\n    // No worktree pin until the snapshot area lands: non-staged reviews\n    // read the live tree, which the context area guards.\n    const snapDeps = reviewHooks.snapshot?.(ctx) ??\n        defaultSnapshotDeps(gitOpts)\n    const snap = await captureSnapshot(snapshotEnabled(cfg), repo, runId,\n        sc, indexTree, null, snapDeps)\n\n    const ground = newQuoteGrounder(repo, tree, sc.diffBytes, gitOpts)\n    const originalDiffBytes = sc.diffBytes.length\n    const maxFileContext = configInt(limits.max_file_ctx_bytes, f.quick ?\n        QUICK_FILE_CTX_BYTES : DEFAULT_LIMITS.max_file_ctx_bytes)\n    const fitted = fit(sc, maxDiff)\n    sc = fitted.scope\n    const breakdown = fitted.breakdown ?? []\n\n    let mode = f.mode\n    if (mode === 'auto') mode = classifyMode([...sc.files])\n    if (!['code', 'prose', 'mixed'].includes(mode)) {\n        throw new UsageError(`invalid --mode ${JSON.stringify(f.mode)}`)\n    }\n    const langs = resolveLangs(f.lang, [...sc.files], mode)\n    const overrides = cfg.prompts ?? {}\n    const finderPrompt = (mode === 'prose' ?\n        overrides.finder_prose :\n        overrides.finder_code) ?? ''\n    const system = await finderSystem(mode, f.scope, f.quick, langs,\n        promptPath(cfg, finderPrompt))\n    const verifierPrompt = await verifierSystem(\n        promptPath(cfg, overrides.verifier ?? ''))\n    const user = survey ?\n        renderFinderUser({\n            task:f.task, survey:true, manifest:sc.manifest,\n            diff:'', fileContext:'',\n        }) :\n        renderFinderUser({\n            task:f.task,\n            survey:false,\n            diff:sc.diff,\n            fileContext:await buildFileContext(repo, sc.files,\n                maxFileContext, tree, gitOpts),\n            manifest:'',\n        })\n\n    const maxTokensTotal = flagOrConfig(f.maxTokensTotal,\n        limits.max_total_tokens, DEFAULT_LIMITS.max_total_tokens)\n    const maxVerified = flagOrConfig(f.maxVerified, limits.max_verified,\n        DEFAULT_LIMITS.max_verified)\n    const requestTimeout = flagOrConfig(f.requestTimeout,\n        limits.request_timeout,\n        parseGoDuration(DEFAULT_LIMITS.request_timeout))\n    const maxAttempts = flagOrConfig(f.maxAttempts, limits.max_attempts,\n        DEFAULT_LIMITS.max_attempts)\n    const ledger = newLedger(maxTokensTotal)\n    let interactive = f.interactive && !f.quick\n    let maxTurns = f.maxTurns ?? DEFAULT_MAX_TURNS\n    if (survey) {\n        interactive = true\n        if (f.maxTurns === undefined) maxTurns = SURVEY_MAX_TURNS\n    }\n    if (interactive && !survey) {\n        const minLines = configInt(cfg.interactive?.min_diff_lines,\n            INTERACTIVE_MIN_DIFF_LINES)\n        const minFiles = configInt(cfg.interactive?.min_files,\n            INTERACTIVE_MIN_FILES)\n        if (countNewlines(sc.diff) < minLines && sc.files.length < minFiles) {\n            logf(ctx.stderr,\n                'diff is small; using a single structured finder call')\n            interactive = false\n        }\n    }\n    const deadlineDuration = flagOrConfig(f.deadline, limits.deadline,\n        parseGoDuration(survey ? SURVEY_DEADLINE : DEFAULT_LIMITS.deadline))\n    const deadline = deadlineDuration > 0n ?\n        Date.now() + toMillis(deadlineDuration) :\n        undefined\n    const promptCeiling = configInt(limits.max_prompt_bytes,\n        DEFAULT_LIMITS.max_prompt_bytes)\n    const budgets:Record<string, unknown> = {\n        deadline_duration:formatGoDuration(deadlineDuration),\n        request_timeout:formatGoDuration(requestTimeout),\n        max_total_tokens:maxTokensTotal,\n        verifier_cap:maxVerified,\n        max_turns:maxTurns,\n        max_attempts:maxAttempts,\n        max_prompt_bytes:promptCeiling,\n    }\n    const tools:readonly Tool[] = interactive ?\n        explorationTools(repo, tree, { env:gitOpts.env }) :\n        []\n    const floor = f.quick ?\n        cfg.review.quick_confidence_floor :\n        cfg.review.confidence_floor\n    const promptBytes = utf8Bytes(system) + utf8Bytes(user)\n    if (promptBytes > promptCeiling) {\n        throw new UsageError(`finder prompt is ${promptBytes} bytes, over ` +\n            `the ${promptCeiling}-byte ceiling; narrow the review scope or ` +\n            'adjust limits.max_diff_bytes, limits.max_file_ctx_bytes, or ' +\n            'limits.max_prompt_bytes in the project config')\n    }\n\n    const meta:Meta = {\n        run_id:runId,\n        ts:rfc3339NanoUTC(new Date()),\n        repo,\n        argv:[...ctx.argv],\n        roast:{ version:buildInfo.version, commit:buildInfo.commit },\n        scope:{\n            kind:f.scope,\n            base:sc.base,\n            uncommitted_only:f.uncommittedOnly,\n            staged_only:f.staged,\n            include_vendored:f.includeVendored,\n            paths:[...f.paths],\n            excludes:[...excludes],\n            base_oid:snap.meta.base ?? '',\n            merge_base_oid:'',\n            head_oid:sc.headOID || (snap.meta.head ?? ''),\n            survey:sc.survey,\n            staged:sc.staged,\n            files:[...sc.files],\n        },\n        derived:{\n            mode,\n            langs:[...langs],\n            quick:f.quick,\n            interactive,\n            max_turns:maxTurns,\n            confidence_floor:floor,\n            do_verify:doVerify,\n            task:f.task,\n            max_severity:f.maxSeverity,\n            max_diff_bytes:maxDiff,\n            max_file_ctx_bytes:maxFileContext,\n        },\n        roles:{\n            finder:roleMeta(roles.finder, system),\n            verifier:roleMeta(roles.verifier, verifierPrompt),\n        },\n        snapshot:snap.meta,\n        digests:{\n            input_kind:inputKind,\n            input:digest(reviewedInput),\n            input_bytes:utf8Bytes(reviewedInput),\n            system_prompt:digest(system),\n            user_prompt:digest(user),\n        },\n        budgets,\n        env_names_only:captureEnv(ctx.env as NodeJS.ProcessEnv,\n            credentialEnvNames(cfg)),\n        caveats:snap.caveats,\n    }\n    const records = await recordDir(repo, gitOpts)\n    await initializeRun(records, meta, {\n        input:reviewedInput,\n        finder_system:system,\n        finder_user:user,\n        verifier_system:verifierPrompt,\n    })\n\n    const recorder = new ResponseRecorder(records, runId)\n    const capture = (raw:RawResponse):Promise<void> => recorder.append(\n        raw.role, raw.protocol, raw.model, raw.contentType, raw.body)\n    const finder = newClient(clientConfig('finder', roles.finder, capture,\n        maxAttempts, requestTimeout, ctx.fetch), ledger)\n    logf(ctx.stderr, `finder=${roles.finder.model} ` +\n        `profile=${roles.finder.profile} ` +\n        `protocol=${roles.finder.protocol} ` +\n        `endpoint=${roles.finder.baseURL}`)\n    const spill = await openFindingSpill(records, runId)\n    const spilled:Promise<void>[] = []\n    let result:Result\n    try {\n        result = await find(finder, {\n            system,\n            user,\n            quick:f.quick,\n            confidenceFloor:floor,\n            interactive,\n            tools,\n            maxTurns,\n            ground,\n            deadline,\n            survey,\n            capture:spill ?\n                (w:WireFinding) => { spilled.push(spill(w)) } :\n                undefined,\n        }, ctx.signal)\n    } finally {\n        await Promise.all(spilled)\n    }\n\n    const usage:Record<string, RecordUsage> = { finder:finder.usage() }\n    const partial = result.incomplete === true\n    // Step 17 (verification) is ticket 21: the result passes through.\n\n    let reviewKind:''|'survey_triage' = ''\n    let completion = ''\n    let stopReason = ''\n    if (survey) {\n        reviewKind = 'survey_triage'\n        const r = result.stopReason ?? ''\n        if (result.incomplete || ['deadline', 'token_budget',\n            'budget_exhausted'].includes(r)) {\n            completion = 'partial'\n            stopReason = r || 'incomplete_no_submission'\n        } else {\n            completion = 'complete'\n            stopReason = 'converged'\n            if (result.assessment === 'NO_FINDINGS') {\n                result.assessment = 'NO_FINDINGS_IN_SAMPLED_AREAS'\n            }\n        }\n    }\n    const { spent, limit } = committed(ledger)\n    if (limit > 0) budgets.ledger_committed_tokens = spent\n    const report:Report = {\n        result,\n        mode,\n        filesReviewed:[...sc.files],\n        task:f.task,\n        runId,\n        budgets,\n        quick:f.quick,\n        verified:doVerify,\n        diffTruncated:breakdown.length > 0,\n        originalDiffBytes,\n        sizeBreakdown:breakdown.map(e => ({ path:e.path, bytes:e.bytes })),\n        usage,\n        promptPacks:langs,\n        reviewKind,\n        completion,\n        manifestFileCount:sc.files.length,\n        stopReason,\n    }\n    report.prior = await priorNotes(records, repo, result)\n    writeReport(ctx as never, f.format as 'both', f.showDropped, report)\n\n    meta.usage = usageMeta(usage)\n    meta.budgets = budgets\n    let finalErr:Error|null = null\n    try {\n        await finalizeRun(records, meta, report, repo)\n        logf(ctx.stderr, `run ${runId} · report ` +\n            `${await resolveRunDir(records, runId)}/report.md`)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        finalErr = err as Error\n    }\n    const exit = reviewExitError(finalErr, gateRank, maxSeverity(result),\n        partial)\n    if (exit) throw exit\n}\n\nasync function initializeRun (\n    records:string,\n    meta:Meta,\n    artifacts:Record<string, string>\n):Promise<void> {\n    try {\n        try {\n            await writeMeta(records, meta)\n        } catch (err) {\n            throw wrap('initialize run record', err)\n        }\n        for (const [name, content] of Object.entries(artifacts)) {\n            try {\n                await writeArtifact(records, meta.run_id, name, content)\n            } catch (err) {\n                throw wrap(`initialize run artifact ${name}`, err)\n            }\n        }\n    } catch (err) {\n        if (records) await removeRun(records, meta.run_id).catch(() => {})\n        throw err\n    }\n}\n\nasync function finalizeRun (\n    records:string,\n    meta:Meta,\n    report:Report,\n    repo:string\n):Promise<void> {\n    try {\n        await writeArtifact(records, meta.run_id, 'result.json',\n            toJSON(report))\n    } catch (err) {\n        throw wrap('finalize run result', err)\n    }\n    try {\n        await writeRunReport(records, meta.run_id, toMarkdown(report, true))\n    } catch (err) {\n        throw wrap('finalize run report', err)\n    }\n    try {\n        await writeMeta(records, meta)\n    } catch (err) {\n        throw wrap('finalize run metadata', err)\n    }\n    let runDir:string\n    try {\n        runDir = await resolveRunDir(records, meta.run_id)\n    } catch (err) {\n        throw wrap('resolve run bundle directory', err)\n    }\n    try {\n        buildBundle(runDir)\n    } catch (err) {\n        throw wrap('build local run bundle', err)\n    }\n    await appendRunLine(records, report, repo, meta.argv ?? null)\n        .catch(() => {})\n}\n\nfunction usageMeta (\n    usage:Record<string, RecordUsage>\n):NonNullable<Meta['usage']> {\n    const out:NonNullable<Meta['usage']> = {}\n    for (const [role, u] of Object.entries(usage)) {\n        out[role] = {\n            uncached_input_tokens:u.uncached_input_tokens,\n            cached_input_tokens:u.cached_input_tokens,\n            cache_write_tokens:u.cache_write_tokens,\n            output_tokens:u.output_tokens,\n            calls:u.calls,\n        }\n    }\n    return out\n}\n\nasync function priorNotes (\n    records:string,\n    repo:string,\n    result:Result\n):Promise<Map<string, string>|null> {\n    const seen = await seenBefore(records, repo, result.findings, 3)\n        .catch(() => new Map())\n    if (seen.size === 0) return null\n    const out = new Map<string, string>()\n    for (const [fp, sighting] of seen) {\n        let note = `seen previously in run ${sighting.runTS}`\n        if (sighting.dropReason) note += ` (dropped: ${sighting.dropReason})`\n        out.set(fp, note)\n    }\n    return out\n}\n\nasync function insideRepository (ctx:RunContext):Promise<boolean> {\n    try {\n        await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n        return true\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        return false\n    }\n}\n\nasync function reviewHandler (\n    args:CommandArgs,\n    ctx:RunContext\n):Promise<void> {\n    await maybeBootstrapGate(ctx)\n    const explicit = ctx.path.length > 0\n    if (!explicit && !(await insideRepository(ctx))) {\n        ctx.stderr.write('roast: not in a Git repository; cd into one to ' +\n            'review, or try `roast doctor` / `roast --help`\\n')\n        ctx.stdout.write(await ctx.rootHelp())\n        return\n    }\n    await runReview(parseReviewFlags(args, ctx.argv), ctx)\n}\n\nexport const reviewCommand:CommandDef = {\n    command:['review', '$0'],\n    describe:'Review the current changes (the default command)',\n    builder:reviewBuilder,\n    handler:reviewHandler,\n}\n","structuredPatch":[{"oldStart":1,"oldLines":10,"newStart":1,"newLines":626,"lines":["-// `roast review`, also the default command. Ticket 20 adds the review","-// flags and the pipeline; until then only the bare-`roast` path that","-// needs no review is implemented.","+// `roast review`, also the default command: the review orchestration of","+// spec 01, 2.8. Verification (step 17) and snapshots are other tickets:","+// the verifier step passes the finder result through, and snapshot","+// capture is injected (see snapshot-meta.ts).","+import { buildInfo } from '../buildinfo.js'","+import {","+    type ProjectConfig,","+    credentialEnvNames,","+    promptPath,","+    snapshotEnabled,","+} from '../config/load.js'","+import { DEFAULT_LIMITS } from '../config/defaults.js'","+import { resolveFinderFlip, resolveRole, validateRole }","+    from '../config/role.js'","+import type { ResolvedRole } from '../config/resolved-role.js'","+import { buildFileContext } from '../context/snippet.js'","+import { newQuoteGrounder } from '../context/grounding.js'","+import { explorationTools } from '../context/tools.js'","+import { LIVE_TREE, pinIndexTree, type Tree } from '../context/tree.js'"," import { gitRoot } from '../git/git.js'","-import type { CommandDef, RunContext } from './command.js'","-import { UsageError } from './errors.js'","+import {","+    type GoDuration,","+    formatGoDuration,","+    parseGoDuration,","+    toMillis,","+} from '../gocompat/duration.js'","+import { createClient, createModelClient } from '../llm/client.js'","+import { type Ledger, committed, newLedger } from '../llm/ledger.js'","+import type {","+    Client, ClientConfig, Protocol, RawResponse, RecordUsage, Tool,","+} from '../llm/types.js'","+import { finderSystem, verifierSystem } from '../prompts/index.js'","+import { renderFinderUser } from '../prompts/render.js'","+import { recordDir } from '../record/dir.js'","+import { openFindingSpill } from '../record/findings.js'","+import { appendRunLine, seenBefore } from '../record/index-file.js'","+import {","+    type Meta,","+    type RoleMeta,","+    captureEnv,","+    digest,","+    removeRun,","+    resolveRunDir,","+    writeArtifact,","+    writeMeta,","+    writeReport as writeRunReport,","+} from '../record/meta.js'","+import { rfc3339NanoUTC } from '../record/json.js'","+import { ResponseRecorder } from '../record/responses.js'","+import { newRunId } from '../record/run-id.js'","+import { toJSON, toMarkdown, type Report } from '../render/render.js'","+import { writeReport } from '../render/write.js'","+import { classifyMode } from '../review/classify.js'","+import { find } from '../review/find.js'","+import {","+    type Result, type WireFinding, maxSeverity,","+} from '../review/types.js'","+import { buildBundle } from '../runbundle/bundle.js'","+import { build, fit, isEmpty, type BuildOpts } from '../scope/index.js'","+import { ExitSignal, UsageError } from './errors.js'","+import type { CommandArgs, CommandDef, RunContext } from './command.js'","+import { loadProjectConfig } from './config.js'","+import { logf } from './log.js'","+import {","+    DEFAULT_MAX_TURNS,","+    SURVEY_MAX_TURNS,","+    type ReviewFlags,","+    parseReviewFlags,","+    reviewBuilder,","+    validateReviewFlags,","+} from './review-flags.js'","+import {","+    applyRoleFlags,","+    configInt,","+    flagOrConfig,","+    resolveLangs,","+} from './resolve.js'","+import {","+    type SnapshotDeps,","+    captureSnapshot,","+    defaultSnapshotDeps,","+} from './snapshot-meta.js'","+import { requireTrust } from './trust.js'"," ","+const QUICK_DIFF_BYTES = 200_000","+const QUICK_FILE_CTX_BYTES = 100_000","+const SURVEY_DEADLINE = '25m'","+const INTERACTIVE_MIN_DIFF_LINES = 80","+const INTERACTIVE_MIN_FILES = 4","+const VERIFIER_MAX_TURNS = 8","+","+// Swappable for tests: the snapshot area's functions (ticket 22).","+export const reviewHooks:{","+    snapshot:((ctx:RunContext) => SnapshotDeps)|null;","+} = { snapshot:null }","+","+// Exit selection after a completed run (spec 01, 2.2): a finalize","+// failure wins over the severity gate.","+export function reviewExitError (","+    finalErr:Error|null,","+    gateRank:number,","+    maxSev:number,","+    partial:boolean","+):Error|null {","+    if (finalErr) return finalErr","+    if (gateRank >= 0 && maxSev >= gateRank) return new ExitSignal(1)","+    if (partial) return new ExitSignal(4)","+    return null","+}","+","+function message (err:unknown):string {","+    return err instanceof Error ? err.message : String(err)","+}","+","+// Config and role failures are usage errors carrying the config area's","+// message.","+function asUsage<T> (fn:() => T):T {","+    try {","+        return fn()","+    } catch (err) {","+        if (err instanceof UsageError) throw err","+        throw new UsageError(message(err), { cause:err })","+    }","+}","+","+function wrap (prefix:string, err:unknown):Error {","+    return new Error(`${prefix}: ${message(err)}`, { cause:err })","+}","+","+function roleMeta (role:ResolvedRole, system:string):RoleMeta {","+    return {","+        profile:role.profile,","+        base_url:role.baseURL,","+        model:role.model,","+        protocol:role.protocol,","+        max_output_tokens:role.maxOutputTokens,","+        session_header:role.sessionHeader,","+        prompt_digest:digest(system),","+    }","+}","+","+function clientConfig (","+    name:string,","+    role:ResolvedRole,","+    capture:(raw:RawResponse) => Promise<void>,","+    maxAttempts:number,","+    requestTimeout:GoDuration,","+    fetch:typeof globalThis.fetch","+):ClientConfig {","+    return {","+        role:name,","+        baseUrl:role.baseURL.replace(/\\/+$/, ''),","+        apiKey:role.apiKey,","+        model:role.model,","+        protocol:role.protocol as ''|Protocol,","+        maxOutputTokens:role.maxOutputTokens,","+        sessionHeader:role.sessionHeader,","+        maxAttempts,","+        requestTimeoutMs:toMillis(requestTimeout),","+        captureResponse:capture,","+        fetch,","+    }","+}","+","+function newClient (","+    config:ClientConfig,","+    ledger:Ledger|null","+):Client {","+    return createClient(createModelClient(config), { ledger })","+}","+","+function countNewlines (s:string):number {","+    let n = 0","+    for (let i = s.indexOf('\\n'); i >= 0; i = s.indexOf('\\n', i + 1)) n++","+    return n","+}","+","+function utf8Bytes (s:string):number {","+    return Buffer.byteLength(s, 'utf8')","+}","+","+// The gate bootstrap offer (spec 01, 2.9) runs here once ticket 30","+// lands; it is a no-op until then.","+async function maybeBootstrapGate (_ctx:RunContext):Promise<void> {}","+","+interface Roles {","+    finder:ResolvedRole;","+    verifier:ResolvedRole;","+    doVerify:boolean;","+}","+","+function resolveRoles (","+    cfg:ProjectConfig,","+    f:ReviewFlags,","+    ctx:RunContext","+):Roles {","+    return asUsage(() => {","+        let finder = resolveRole(cfg, 'finder', ctx.env)","+        let verifier = resolveRole(cfg, 'verifier', ctx.env)","+        finder = applyRoleFlags('finder', finder, f.finder, ctx.env)","+        verifier = applyRoleFlags('verifier', verifier, f.verifier, ctx.env)","+        const flip = resolveFinderFlip(cfg, finder, f.authorModel, ctx.env)","+        if (flip.note) logf(ctx.stderr, flip.note)","+        if (flip.warn) logf(ctx.stderr, flip.warn)","+        finder = flip.role","+        validateRole('finder', finder)","+        const doVerify = !f.quick && !f.noVerify","+        if (doVerify) validateRole('verifier', verifier)","+        return { finder, verifier, doVerify }","+    })","+}","+","+export async function runReview (","+    f:ReviewFlags,","+    ctx:RunContext","+):Promise<void> {","+    const gateRank = validateReviewFlags(f)","+    const gitOpts = { env:ctx.env as NodeJS.ProcessEnv, signal:ctx.signal }","+    const cfg = await loadProjectConfig(f.config, ctx)","+    const roles = resolveRoles(cfg, f, ctx)","+    const { doVerify } = roles","+","+    let repo:string","+    try {","+        repo = await gitRoot(ctx.cwd, gitOpts)","+    } catch (err) {","+        if (ctx.signal.aborted) throw err","+        throw new UsageError(message(err), { cause:err })","+    }","+    await requireTrust(repo, cfg, ctx)","+","+    const survey = f.scope === 'repo'","+    const limits = cfg.limits ?? {}","+    const excludes = [...(cfg.review.excludes ?? []), ...f.exclude]","+    const maxDiff = configInt(limits.max_diff_bytes, f.quick ?","+        QUICK_DIFF_BYTES : DEFAULT_LIMITS.max_diff_bytes)","+    const buildOpts:BuildOpts = {","+        base:f.base,","+        uncommittedOnly:f.uncommittedOnly,","+        stagedOnly:f.staged,","+        paths:f.paths,","+        excludes,","+        includeVendored:f.includeVendored,","+        scope:f.scope,","+        maxFileDiffBytes:maxDiff,","+        env:gitOpts.env,","+    }","+    let tree:Tree = LIVE_TREE","+    if (f.staged) {","+        try {","+            tree = await pinIndexTr