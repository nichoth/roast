{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLtuHdesvqYYHDqMRq87","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Wdeky6ueBtLDtRnZQGgqKx","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/test/cli/review-flags.ts","content":"// Review flag syntax and raw validation (spec 01, 2.6, 2.7, 2.11).\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport {\n    finderScript,\n    finding,\n    profileConfig,\n    requestRecorder,\n    reviewMeta,\n    runDirs,\n    settingsRepo,\n    writeConfig,\n} from '../helpers/review.js'\n\nconst LIMITS = {\n    max_attempts:3,\n    request_timeout:'1m',\n    max_total_tokens:1000,\n    max_verified:2,\n    deadline:'1m',\n}\n\ntest('raw flag validation fails before config and requests', async t => {\n    const r = await settingsRepo(t)\n    writeConfig(r.dir, profileConfig(r.server.url, { limits:LIMITS }))\n    const { approveProjectConfig } = await import('../helpers/review.js')\n    await approveProjectConfig(r)\n    const requests = requestRecorder(r)\n    const cases = [\n        ['--staged', '--uncommitted-only'],\n        ['--format', 'bogus'],\n        ['--max-turns', '0'],\n        ['--max-attempts=0'],\n        ['--request-timeout=-1s'],\n        ['--deadline=-1s'],\n        ['--max-tokens-total=-1'],\n        ['--max-verified=-1'],\n        ['--scope', 'bogus'],\n        ['--scope', 'repo', '--quick'],\n        ['--scope', 'repo', '--staged'],\n        ['--scope', 'repo', '--base', 'HEAD'],\n        ['--max-severity', 'bogus'],\n        ['--max-attempts', '0x10'],\n        ['--max-turns', '1.5'],\n        ['--deadline', '10'],\n        ['--quick', '--uncommitted-only', '--finder-max-output-tokens=0'],\n    ]\n    for (const args of cases) {\n        const res = await r.roast(['review', '--no-verify',\n            '--error-format', 'json', ...args])\n        t.equal(res.code, 2, `${args.join(' ')} exits 2`)\n        const err = JSON.parse(res.stderr.trim().split('\\n').pop() ?? '{}')\n        t.equal(err.error_category, 'usage', `${args.join(' ')} is usage`)\n    }\n    t.equal(requests().length, 0, 'no request sent')\n    t.equal(runDirs(r).length, 0, 'no run directory')\n})\n\ntest('json error output for an invalid --format', async t => {\n    const r = await settingsRepo(t)\n    const res = await r.roast(['review', '--error-format', 'json',\n        '--format', 'invalid'])\n    t.equal(res.code, 2, 'exit 2')\n    const err = JSON.parse(res.stderr)\n    t.equal(err.error_category, 'usage', 'category')\n    t.equal(err.exit_code, 2, 'exit code field')\n    t.ok(typeof err.message === 'string' && err.message, 'message')\n})\n\ntest('list flags append across occurrences', async t => {\n    const r = await settingsRepo(t)\n    const res = await r.roast(['review', '--no-verify', '--format', 'json',\n        '--paths', 'a,b', '--paths', 'c', '--exclude', 'x,y'])\n    t.equal(res.code, 0, res.stderr)\n    // Pathspecs that match nothing give an empty diff: no run record, so\n    // check the parse through a review that matches.\n    const ok = await r.roast(['review', '--no-verify', '--format', 'json',\n        '--paths', 'a,main.go', '--paths', 'c'])\n    t.equal(ok.code, 0, ok.stderr)\n    const meta = reviewMeta(r)\n    t.deepEqual(meta.scope.paths, ['a', 'main.go', 'c'], 'three pathspecs')\n    t.deepEqual(meta.scope.files, ['main.go'], 'pathspec reached scope')\n})\n\ntest('--quick false is read as false', async t => {\n    const r = await settingsRepo(t)\n    const res = await r.roast(['review', '--no-verify', '--format', 'json',\n        '--quick', 'false'])\n    t.equal(res.code, 0, res.stderr)\n    t.equal(reviewMeta(r).derived.quick, false, 'not quick')\n})\n\ntest('empty diff exits 0 with NO_DIFF and no run', async t => {\n    const r = await settingsRepo(t)\n    fs.writeFileSync(path.join(r.dir, '.gitignore'), '.roast.json\\n')\n    const { gitIn } = await import('../helpers/review.js')\n    gitIn(r, ['add', '-A'])\n    gitIn(r, ['commit', '-q', '-m', 'all'])\n    const requests = requestRecorder(r)\n    for (const extra of [[], ['--mode', 'bogus'], ['--lang', 'cobol'],\n        ['--lang', 'none,go'], ['--max-severity', 'INFO']]) {\n        const res = await r.roast(['review', '--no-verify', '--format',\n            'json', ...extra])\n        t.equal(res.code, 0, `${extra.join(' ')} exits 0`)\n        t.equal(JSON.parse(res.stdout).assessment, 'NO_DIFF', 'NO_DIFF')\n    }\n    t.equal(requests().length, 0, 'no request')\n    t.equal(runDirs(r).length, 0, 'no run directory')\n})\n\ntest('invalid --mode or --lang on a real diff exits 2', async t => {\n    const r = await settingsRepo(t, finderScript([finding()]))\n    const requests = requestRecorder(r)\n    for (const extra of [['--mode', 'bogus'], ['--lang', 'cobol'],\n        ['--lang', 'none', '--lang', 'go']]) {\n        const res = await r.roast(['review', '--no-verify', '--format',\n            'json', ...extra])\n        t.equal(res.code, 2, `${extra.join(' ')} exits 2`)\n    }\n    t.equal(requests().length, 0, 'no request')\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":903,"cache_read_input_tokens":198286,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":903},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"ae150786-4a9a-43f6-ba0b-fd9cf1653b72","timestamp":"2026-11-24T01:36:32.146Z","request_id":"req_011ChLtuHSVWxWoAFrs5WV7S","wire_tool_inputs":{"toolu_01Wdeky6ueBtLDtRnZQGgqKx":{"file_path":"/Users/nick/code/roast.ts-rewrite-20-review-tracer-bullet-chat/test/cli/review-flags.ts","content":"// Review flag syntax and raw validation (spec 01, 2.6, 2.7, 2.11).\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test } from '../helpers/test.js'\nimport {\n    finderScript,\n    finding,\n    profileConfig,\n    requestRecorder,\n    reviewMeta,\n    runDirs,\n    settingsRepo,\n    writeConfig,\n} from '../helpers/review.js'\n\nconst LIMITS = {\n    max_attempts:3,\n    request_timeout:'1m',\n    max_total_tokens:1000,\n    max_verified:2,\n    deadline:'1m',\n}\n\ntest('raw flag validation fails before config and requests', async t => {\n    const r = await settingsRepo(t)\n    writeConfig(r.dir, profileConfig(r.server.url, { limits:LIMITS }))\n    const { approveProjectConfig } = await import('../helpers/review.js')\n    await approveProjectConfig(r)\n    const requests = requestRecorder(r)\n    const cases = [\n        ['--staged', '--uncommitted-only'],\n        ['--format', 'bogus'],\n        ['--max-turns', '0'],\n        ['--max-attempts=0'],\n        ['--request-timeout=-1s'],\n        ['--deadline=-1s'],\n        ['--max-tokens-total=-1'],\n        ['--max-verified=-1'],\n        ['--scope', 'bogus'],\n        ['--scope', 'repo', '--quick'],\n        ['--scope', 'repo', '--staged'],\n        ['--scope', 'repo', '--base', 'HEAD'],\n        ['--max-severity', 'bogus'],\n        ['--max-attempts', '0x10'],\n        ['--max-turns', '1.5'],\n        ['--deadline', '10'],\n        ['--quick', '--uncommitted-only', '--finder-max-output-tokens=0'],\n    ]\n    for (const args of cases) {\n        const res = await r.roast(['review', '--no-verify',\n            '--error-format', 'json', ...args])\n        t.equal(res.code, 2, `${args.join(' ')} exits 2`)\n        const err = JSON.parse(res.stderr.trim().split('\\n').pop() ?? '{}')\n        t.equal(err.error_category, 'usage', `${args.join(' ')} is usage`)\n    }\n    t.equal(requests().length, 0, 'no request sent')\n    t.equal(runDirs(r).length, 0, 'no run directory')\n})\n\ntest('json error output for an invalid --format', async t => {\n    const r = await settingsRepo(t)\n    const res = await r.roast(['review', '--error-format', 'json',\n        '--format', 'invalid'])\n    t.equal(res.code, 2, 'exit 2')\n    const err = JSON.parse(res.stderr)\n    t.equal(err.error_category, 'usage', 'category')\n    t.equal(err.exit_code, 2, 'exit code field')\n    t.ok(typeof err.message === 'string' && err.message, 'message')\n})\n\ntest('list flags append across occurrences', async t => {\n    const r = await settingsRepo(t)\n    const res = await r.roast(['review', '--no-verify', '--format', 'json',\n        '--paths', 'a,b', '--paths', 'c', '--exclude', 'x,y'])\n    t.equal(res.code, 0, res.stderr)\n    // Pathspecs that match nothing give an empty diff: no run record, so\n    // check the parse through a review that matches.\n    const ok = await r.roast(['review', '--no-verify', '--format', 'json',\n        '--paths', 'a,main.go', '--paths', 'c'])\n    t.equal(ok.code, 0, ok.stderr)\n    const meta = reviewMeta(r)\n    t.deepEqual(meta.scope.paths, ['a', 'main.go', 'c'], 'three pathspecs')\n    t.deepEqual(meta.scope.files, ['main.go'], 'pathspec reached scope')\n})\n\ntest('--quick false is read as false', async t => {\n    const r = await settingsRepo(t)\n    const res = await r.roast(['review', '--no-verify', '--format', 'json',\n        '--quick', 'false'])\n    t.equal(res.code, 0, res.stderr)\n    t.equal(reviewMeta(r).derived.quick, false, 'not quick')\n})\n\ntest('empty diff exits 0 with NO_DIFF and no run', async t => {\n    const r = await settingsRepo(t)\n    fs.writeFileSync(path.join(r.dir, '.gitignore'), '.roast.json\\n')\n    const { gitIn } = await import('../helpers/review.js')\n    gitIn(r, ['add', '-A'])\n    gitIn(r, ['commit', '-q', '-m', 'all'])\n    const requests = requestRecorder(r)\n    for (const extra of [[], ['--mode', 'bogus'], ['--lang', 'cobol'],\n        ['--lang', 'none,go'], ['--max-severity', 'INFO']]) {\n        const res = await r.roast(['review', '--no-verify', '--format',\n            'json', ...extra])\n        t.equal(res.code, 0, `${extra.join(' ')} exits 0`)\n        t.equal(JSON.parse(res.stdout).assessment, 'NO_DIFF', 'NO_DIFF')\n    }\n    t.equal(requests().length, 0, 'no request')\n    t.equal(runDirs(r).length, 0, 'no run directory')\n})\n\ntest('invalid --mode or --lang on a real diff exits 2', async t => {\n    const r = await settingsRepo(t, finderScript([finding()]))\n    const requests = requestRecorder(r)\n    for (const extra of [['--mode', 'bogus'], ['--lang', 'cobol'],\n        ['--lang', 'none', '--lang', 'go']]) {\n        const res = await r.roast(['review', '--no-verify', '--format',\n            'json', ...extra])\n        t.equal(res.code, 2, `${extra.join(' ')} exits 2`)\n    }\n    t.equal(requests().length, 0, 'no request')\n})\n"}}}
