ig value, or fallback when it is unset.\nfunc configInt(configured *int, fallback int) int {\n\tif configured != nil {\n\t\treturn *configured\n\t}\n\treturn fallback\n}\n\n// flagOrConfigInt returns the flag value when the flag was given, else the\n// project config value, else fallback.\nfunc flagOrConfigInt(flagSet bool, flag int, configured *int,\n\tfallback int) int {\n\tif flagSet {\n\t\treturn flag\n\t}\n\treturn configInt(configured, fallback)\n}\n\n// flagOrConfigDuration returns the flag value when the flag was given, else\n// the project config value, else fallback.\nfunc flagOrConfigDuration(flagSet bool, flag time.Duration,\n\tconfigured *config.Duration, fallback time.Duration) time.Duration {\n\tswitch {\n\tcase flagSet:\n\t\treturn flag\n\tcase configured != nil:\n\t\treturn time.Duration(*configured)\n\t}\n\treturn fallback\n}\n\n// applyRoleFlags applies command-line role overrides, including which\n// credential may follow the role to a new endpoint.\nfunc applyRoleFlags(changed func(string) bool, name string, role config.ResolvedRole, flags roleFlags) (config.ResolvedRole, error) {\n\tvar baseURL, protocol *string\n\tif changed(name + \"-base-url\") {\n\t\tbaseURL = &flags.baseURL\n\t}\n\tif changed(name + \"-protocol\") {\n\t\tprotocol = &flags.protocol\n\t}\n\tif baseURL != nil || protocol != nil {\n\t\tvar err error\n\t\trole, err = config.OverrideEndpoint(name, role, baseURL, protocol)\n\t\tif err != nil {\n\t\t\treturn config.ResolvedRole{}, err\n\t\t}\n\t}\n\tif changed(name + \"-model\") {\n\t\trole.Model = flags.model\n\t}\n\tif changed(name + \"-max-output-tokens\") {\n\t\trole.MaxOutputTokens = flags.maxOutputTokens\n\t}\n\treturn role, nil\n}\n\nfunc clientConfig(roleName string, role config.ResolvedRole, ledger *llm.Ledger, capture func(llm.RawResponse) error, maxAttempts int, requestTimeout time.Duration) llm.ClientConfig {\n\treturn llm.ClientConfig{\n\t\tRole:    roleName,\n\t\tBaseURL: strings.TrimRight(role.BaseURL, \"/\"), APIKe