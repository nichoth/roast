.Now().Add(deadlineDuration)\n649\t\t}\n650\t\tbudgets := map[string]any{\n651\t\t\t\"deadline_duration\": deadlineDuration.String(),\n652\t\t\t\"request_timeout\":   requestTimeout.String(),\n653\t\t\t\"max_total_tokens\":  maxTokensTotal,\n654\t\t\t\"verifier_cap\":      maxVerified,\n655\t\t\t\"max_turns\":         maxTurns,\n656\t\t\t\"max_attempts\":      maxAttempts,\n657\t\t}\n658\t\ttools := []llm.Tool(nil)\n659\t\tif interactive {\n660\t\t\ttools = rcontext.ExplorationTools(repo, tree)\n661\t\t}\n662\t\tfloor := cfg.Review.ConfidenceFloor\n663\t\tif f.quick {\n664\t\t\tfloor = cfg.Review.QuickConfidenceFloor\n665\t\t}\n666\t\tpromptCeiling := configInt(limits.MaxPromptBytes, defaultMaxPromptBytes)\n667\t\tbudgets[\"max_prompt_bytes\"] = promptCeiling\n668\t\tif promptBytes, ceiling := len(system)+len(user), promptCeiling; promptBytes > ceiling {\n669\t\t\treturn &usageError{msg: fmt.Sprintf(\"finder prompt is %d bytes, over the %d-byte ceiling; narrow the review scope or adjust limits.max_diff_bytes, limits.max_file_ctx_bytes, or limits.max_prompt_bytes in the project config\", promptBytes, ceiling)}\n670\t\t}\n671\t\tscopeBaseOID := sc.BaseOID\n672\t\tif scopeBaseOID == \"\" {\n673\t\t\tscopeBaseOID = snapshotMeta.Base\n674\t\t}\n675\t\tscopeHeadOID := sc.HeadOID\n676\t\tif scopeHeadOID == \"\" {\n677\t\t\tscopeHeadOID = snapshotMeta.Head\n678\t\t}\n679\t\tenvNames := record.CaptureEnv(cfg.CredentialEnvNames()...)\n680\t\tmeta := record.Meta{\n681\t\t\tRunID: runID, TS: time.Now().UTC().Format(time.RFC3339Nano), Repo: repo,\n682\t\t\tArgv:  append([]string(nil), os.Args[1:]...),\n683\t\t\tRoast: record.BuildMeta{Version: buildinfo.Version, Commit: buildinfo.Commit},\n684\t\t\tScope: record.ScopeMeta{\n685\t\t\t\tKind: f.scope, Base: sc.Base, UncommittedOnly: f.uncommittedOnly,\n686\t\t\t\tStagedOnly: f.staged, IncludeVendored: f.includeVendored,\n687\t\t\t\tPaths: append([]string(nil), f.paths...), Excludes: append([]string(nil), excludes...),\n688\t\t\t\t