{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ljspk3UNu2yPV5nrTA4Wiw","type":"tool_result","content":"// The runtime-ready role (spec 02, section 3 `role.ts`). Kept apart from\n// role.ts so credential.ts can build roles without an import cycle.\nimport type { CredentialSource, StoredCredentials } from './credential.js'\n\nexport interface ResolvedRole {\n    readonly profile:string;\n    readonly baseURL:string;\n    // Secret: never logged, recorded, or rendered. Not enumerable, so\n    // JSON.stringify, spread, and util.inspect leave it out.\n    readonly apiKey:string;\n    readonly model:string;\n    readonly protocol:string;\n    readonly maxOutputTokens:number;\n    readonly sessionHeader:string;\n    readonly pin:boolean;\n    readonly authorRoutes:Readonly<Record<string, string>>;\n    readonly credential:CredentialSource;\n    readonly explicitEndpoint:boolean;\n    // Not enumerable either: a store may hold keys.\n    readonly stored?:StoredCredentials;\n}\n\n// A frozen role whose `apiKey` and `stored` are not enumerable.\nexport function makeRole (fields:ResolvedRole):ResolvedRole {\n    const { apiKey, stored, ...visible } = fields\n    const role = { ...visible }\n    Object.defineProperty(role, 'apiKey', { value:apiKey, enumerable:false })\n    Object.defineProperty(role, 'stored', { value:stored, enumerable:false })\n    return Object.freeze(role) as ResolvedRole\n}\n\n// A copy of `role` with `changes` applied. Use this instead of a spread,\n// which drops the non-enumerable key and store.\nexport function updateRole (\n    role:ResolvedRole,\n    changes:Partial<ResolvedRole>\n):ResolvedRole {\n    return makeRole({\n        profile:role.profile,\n        baseURL:role.baseURL,\n            env)\n    } catch (err) {\n        throw wrap(roleName, err)\n    }\n}\n\ninterface Overrides {\n    baseURL?:string;\n    protocol?:string;\n}\n\n// Applies the protocol, then the endpoint override. Returns the moved\n// role and whether the protocol override moved it from one provider's\n// default endpoint to another's.\nfunction applyEndpointOverrides (\n    role:ResolvedRole,\n    { baseURL, protocol }:Overrides\n):{ role:ResolvedRole, crossed:boolean } {\n    let crossed = false\n    let next = role\n    if (protocol !== undefined) {\n        const previousDefault = defaultBaseURL(role.protocol)\n        const nextDefault = defaultBaseURL(protocol)\n        next = updateRole(next, { protocol })\n        if (nextDefault !== previousDefault &&\n            (!role.explicitEndpoint ||\n                sameEndpoint(role.baseURL, previousDefault))) {\n            next = updateRole(next, { baseURL:nextDefault })\n            crossed = true\n        }\n    }\n    if (baseURL !== undefined) {\n        next = updateRole(next, { baseURL, explicitEndpoint:true })\n        crossed = false\n    }\n    return { role:next, crossed }\n}\n\n// Re-resolves a credential after the endpoint or protocol changed. A role\n// key, or a profile key on an endpoint that did not cross providers,\n// follows the override; any other key is checked again.\nfunction rebindCredential (\n    roleName:string,\n    role:ResolvedRole,\n    crossed:boolean,\n    env:Env\n):ResolvedRole {\n    const kind = role.credential.kind\n    if (kind === 'role_env') return role\n    if (kind === 'profile_env' && !crossed) return role\n    const roleVar = roleKeyVar(roleName)\n    const roleKey = envValue(env, roleVar)\n    if (roleKey !== '') {\n        return updateRole(role, {\n            apiKey:roleKey,\n            credential:{ kind:'role_env', env:roleVar },\n        })\n    }\n    let found:Credential\n    try {\n        found = ambientCredential(role.protocol, role.baseURL, role.stored,\n            env)\n    } catch (err) {\n        throw wrap(roleName, err)\n    }\n    return updateRole(role, { apiKey:found.key, credential:found.source })\n}\n\n// Applies `--<role>-base-url` / `--<role>-protocol` (undefined = flag not\n// given