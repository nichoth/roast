{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U8rxrCg8ibQSrvBvDLct2S","type":"tool_result","content":"    ],\n}\n\nexport function wireProtocol (role:RoleMeta):string {\n    return role.protocol || role.api || ''\n}\n\nexport function captureEnv (\n    env:NodeJS.ProcessEnv,\n    extraSecrets:readonly string[] = []\n):string[] {\n    const secrets = new Set(extraSecrets)\n    return Object.keys(env).filter(name => env[name] !== undefined &&\n        name.startsWith('ROAST_') && !name.endsWith('_API_KEY') &&\n        !secrets.has(name)).sort(compareBytes)\n}\n\nexport function digest (x:string|Uint8Array):string {\n    return createHash('sha256').update(x).digest('hex')\n}\n\nsrc/record/meta.ts:111:export async function removeRun (dir:string, runId:string):Promise<void> {\n    } finally {\n        stream.destroy()\n    }\n}\n\nexport async function seenBefore (\n    dir:string,\n    repoDir:string,\n    findings:readonly Finding[],\n    lookbackFiles:number = 3\n):Promise<Map<string, PriorSighting>> {\n    const out = new Map<string, PriorSighting>()\n    if (!dir || !findings.length) return out\n    const targets = new Set(findings.map(fingerprint))\n    let entries\n    try {\n        entries = await fs.readdir(dir, { withFileTypes:true })\n    } catch { return out }\n    const files = entries.filter(e => !e.isDirectory() &&\n        e.name.startsWith('runs-') && e.name.endsWith('.jsonl'))\n        .map(e => e.name).sort((a, b) => compareBytes(b, a))\n        .slice(0, lookbackFiles <= 0 ? 3 : lookbackFiles)\n    for (const file of files) {\n        await scanFile(path.join(dir, file), path.resolve(repoDir),\n            targets, out)\n        if (out.size === targets.size) break\n    }\n    return out\n}\n    try {\n        await handle.writeFile(data)\n    } finally {\n        await handle.close()\n    }\n}\n\nexport async function recordDir (\n    cwd:string,\n    opts:GitRunOpts = {}\n):Promise<string> {\n    try {\n        const out = await git(cwd, ['rev-parse', '--show-toplevel'], opts)\n        const top = goTrimSpace(out.toString())\n        return top ? path.join(top, STATE_DIR, 'runs') : ''\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        return ''\n    }\n}\n// pattern: Functional Core\nimport type { RecordUsage } from '../llm/types.js'\nimport type { Finding, Result } from '../review/types.js'\nimport { effectiveSeverity, severityRank } from '../review/types.js'\nimport { headline, renderFinding } from './markdown.js'\nimport { fingerprint } from '../review/fingerprint.js'\n\nexport type SizeEntry = { path:string; bytes:number }\n\nexport type Report = {\n    result:Omit<Result, 'notes'>&{ notes?:string[]|null };\n    mode:string;\n    filesReviewed?:string[]|null;\n    task?:string;\n    runId?:string;\n    budgets?:Record<string, unknown>|null;\n    quick?:boolean;\n    verified?:boolean;\n    diffTruncated?:boolean;\n    originalDiffBytes?:number;\n    sizeBreakdown?:SizeEntry[]|null;\n    usage?:Record<string, RecordUsage>|null;\n    prior?:Map<string, string>|null;\n    promptPacks?:string[]|null;\n    reviewKind?:''|'survey_triage';\n    completion?:string;\n    manifestFileCount?:number;\n    stopReason?:string;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"f4f64e98-e2cc-4f6f-bdf3-a3117da8fc16","timestamp":"2026-11-24T01:33:19.664Z","tool_use_result":{"stdout":"    ],\n}\n\nexport function wireProtocol (role:RoleMeta):string {\n    return role.protocol || role.api || ''\n}\n\nexport function captureEnv (\n    env:NodeJS.ProcessEnv,\n    extraSecrets:readonly string[] = []\n):string[] {\n    const secrets = new Set(extraSecrets)\n    return Object.keys(env).filter(name => env[name] !== undefined &&\n        name.startsWith('ROAST_') && !name.endsWith('_API_KEY') &&\n        !secrets.has(name)).sort(compareBytes)\n}\n\nexport function digest (x:string|Uint8Array):string {\n    return createH