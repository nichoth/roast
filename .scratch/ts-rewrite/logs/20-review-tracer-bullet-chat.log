{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CNY7FKeRyoXMLgpD4nLM6B","type":"tool_result","content":"export interface ClientConfig {\n    // \"finder\", \"verifier\", or a doctor check name.\n    role:string;\n    baseUrl:string;\n    apiKey:string;\n    // Sent verbatim as the body's `model`.\n    model:string;\n    // \"\" means chat.\n    protocol:''|Protocol;\n    maxOutputTokens:number;\n    // Attempts per model call; <= 0 means DEFAULT_MAX_ATTEMPTS.\n    maxAttempts:number;\n    // Per request; 0 disables.\n    requestTimeoutMs:number;\n    sessionHeader?:string;\n    captureResponse?:(raw:RawResponse) => Promise<void>|void;\n    // Overrides the module-level fetch (http.ts) for this client.\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface Usage {\n    uncachedInputTokens:number;\n    cachedInputTokens:number;\n    cacheWriteTokens:number;\n    outputTokens:number;\n    calls:number;\n}\n\nexport interface FinalSpec<T> {\n    decode (value:unknown, rawText?:string):T;\n}\n\nexport interface ConverseOptions<T> {\n    // Exploration, record, and final tools, in order.\n    tools:readonly Tool[];\n    finalTool:string;\n    final:FinalSpec<T>;\n    // Turn at which the final phase starts; <= 0 means 8.\n    maxTurns?:number;\n    onTurn?:(info:TurnInfo) => void;\n    // <= 0 means 3e6.\n    inputByteCeiling?:number;\n    // Absolute time, ms since the epoch.\n    workDeadline?:number;\n    // ms; <= 0 means 90000.\n    wrapUpWindow?:number;\n    onWorkDeadline?:() => void;\n    onBudgetExhausted?:() => void;\n}\n\n// Usage as written into run records: snake_case, disjoint counts.\nexport interface RecordUsage {\n    uncached_input_tokens:number;\n    cached_input_tokens:number;\n    cache_write_tokens:number;\n    output_tokens:number;\n    calls:number;\n}\n\n// One configured model role, as the finder and verifier call it.\nexport interface Client {\n    // The request model name.\n    readonly name:string;\n    converse<T> (\n        system:string,\n        user:string,\n        opts:ConverseOptions<T>,\n        signal:AbortSignal\n    ):Promise<T>;\n    completeStructured<T> (\n        system:string,\n        user:string,\n        schemaName:string,\n        result:{ schema:Record<string, unknown>, decode:FinalSpec<T>['decode'] },\n        signal:AbortSignal\n    ):Promise<T>;\n    usage ():RecordUsage;\n}\nexport const MAX_ERROR_BODY = 32 * 1024\n\nexport interface ModelClient {\n    readonly config:Readonly<ClientConfig>;\n    // '' normalized to 'chat'.\n    readonly protocol:Protocol;\n    // <= 0 normalized to DEFAULT_MAX_ATTEMPTS.\n    readonly maxAttempts:number;\n    // One HTTP attempt. Resolves only after capture succeeded.\n    send (request:ModelRequest):Promise<ModelTurn>;\n    // Exact byte length of the request body `send` would post.\n    requestBytes (request:ModelRequest):number;\n    // Accumulated usage across all calls on this client.\n    usage ():Usage;\n}\n\ninterface Adapter {\n    url (baseUrl:string):string;\n    encode (config:ClientConfig, request:ModelRequest):unknown;\n    decode (events:AsyncIterable<SseEvent>):Promise<ModelTurn>;\n}\n\nconst ADAPTERS:Partial<Record<Protocol, Adapter>> = {\n    chat:{\n        url:chatUrl,\n            { cause:err, details:{ model } })\n    }\n    return err\n}\n\nexport function createModelClient (config:ClientConfig):ModelClient {\n    if (!(config.maxOutputTokens > 0)) {\n        throw new Error(`${config.model}: max output tokens must be positive`)\n    }\n    if (goTrimSpace(config.apiKey) === '') {\n        throw new Error(`${config.model}: API key is not configured`)\n    }\n}\n\nexport interface CreateClientOptions {\n    // The run's shared ledger; none means unlimited.\n    ledger?:Ledger|null;\n    now?:() => number;\n    sleep?:Sleep;\n    sessionId?:() => string;\n}\n\nfunction recordUsage (u:Usage):RecordUsage {\n    return {\n        uncached_input_tokens:u.uncachedInputTokens,\n        cached_input_tokens:u.cachedInputTokens,\n        cache_write_tokens:u.cacheWriteTokens,\n        output_tokens:u.outputTokens,\n        calls:u.calls,\n    }\n}\n\n// The `Client` the finder and verifier call (spec 07, 3.3): both entry\n// points run the agent loop over `model`; usage accumulates across all\n// of this client's conversations.\nexport function createClient (\n    model:ModelClient,\n    opts:CreateClientOptions = {}\n):Client {\n    const total = new UsageAccumulator()\n    const deps:LoopDeps = {\n        client:model,\n        model:model.config.model,\n        maxOutputTokens:model.config.maxOutputTokens,\n        maxAttempts:model.maxAttempts > 0 ?\n            model.maxAttempts :\n            DEFAULT_MAX_ATTEMPTS,\n        ledger:opts.ledger ?? null,\n        addUsage:u => total.add(u),\n        now:opts.now,\n        sleep:opts.sleep,\n        sessionId:opts.sessionId,\n    }\n    return {\n        name:model.config.model,\n        converse (system, user, converseOpts, signal) {\n            return runConversation(deps, system, user, converseOpts, false,\n                signal)\n        },\n        completeStructured (system, user, schemaName, result, signal) {\n            return runConversation(deps, system, user, {\n                tools:[{\n                    name:schemaName,\n                    description:'Return the requested structured result.',\n                    schema:result.schema,\n                }],\n                finalTool:schemaName,\n                final:{ decode:result.decode },\n                maxTurns:1,\n            }, true, signal)\n        },\n        usage () {\n            return recordUsage(total.total())\n        },\n    }\n}","is_error":false}]},"parent_tool_use_id":"toolu_013ZjZWsp3co15WosgrPTPBD","agent_id":"a0cf7d3e7bd92336b","session_id":"5b283ca8-677a-43f7-a7e2-25611b063cf7","uuid":"7ef68cdf-a853-43c7-b172-4f4bfc290d64","timestamp":"2026-11-24T01:28:59.871Z","tool_result_meta":[{"id":"toolu_01CNY7FKeRyoXMLgpD4nLM