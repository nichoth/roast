{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChM49srsDaJmaxWY1geZJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01S5Mv2mYgP79GfvHMA7Pv2F","name":"Bash","input":{"command":"cd /Users/nick/code/roast.ts-rewrite-45-doctor-roundtrip-adapters; cat test/helpers/doctor-probe.ts; sed -n 140,260p src/cli/doctor.ts; sed -n 1,140p test/cli/doctor.ts; sed -n 540,683p test/cli/doctor.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2923,"cache_read_input_tokens":53333,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2923},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8db26e43-7bde-47a9-88ba-95dcb38ede5e","uuid":"21ad1f9b-fb65-4b8f-9cc6-fe9b6fa1631f","timestamp":"2026-11-24T03:37:36.162Z","request_id":"req_011ChM49sgTVu16GfgmqkL5y","wire_tool_inputs":{"toolu_01S5Mv2mYgP79GfvHMA7Pv2F":{"command":"cd /Users/nick/code/roast.ts-rewrite-45-doctor-roundtrip-adapters; cat test/helpers/doctor-probe.ts; sed -n 140,260p src/cli/doctor.ts; sed -n 1,140p test/cli/doctor.ts; sed -n 540,683p test/cli/doctor.ts"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S5Mv2mYgP79GfvHMA7Pv2F","type":"tool_result","content":"// pattern: Imperative Shell\n// Chat, responses, and anthropic fake that requires automatic choice\n// and a stable probe prefix.\nimport type { RecordedRequest, Reply, Script }\n    from './inference-server.js'\nimport { anthropicCalls } from './anthropic-fakes.js'\n\ntype Json = Record<string, unknown>\n\n// The anthropic form of the probe (path `/v1/messages`).\nfunction anthropicProbe (\n    prefixes:Map<string, { messages:unknown[], tools:unknown }>,\n    req:RecordedRequest\n):Reply {\n    const body = req.body as {\n        messages:{ role:string, content:Json[] }[],\n        tools:unknown,\n        tool_choice?:{ type?:string },\n    }\n    if (body.tool_choice !== undefined && body.tool_choice.type !== 'auto') {\n        return { status:400, body:'forced tool choice' }\n    }\n    const messages = body.messages\n    const result = messages.flatMap(m => m.content)\n        .find(b => b.type === 'tool_result')\n    const key = String(req.headers['x-api-key'])\n    if (!result) {\n        prefixes.set(key, { messages, tools:body.tools })\n        return { stream:anthropicCalls([{ name:'doctor_lookup', args:{} }]) }\n    }\n    const prefix = prefixes.get(key)\n    if (!prefix || JSON.stringify(body.tools) !==\n        JSON.stringify(prefix.tools) ||\n        JSON.stringify(messages.slice(0, prefix.messages.length)) !==\n        JSON.stringify(prefix.messages)) {\n        return { status:400, body:'changed conversation prefix' }\n    }\n    const content = result.content as { text:string }[]\n    const token = JSON.parse(content[0].text).token\n    return {\n        stream:anthropicCalls([{\n            name:'doctor_probe', args:{ ok:true, token },\n        }]),\n    }\n}\n\nexport function probeCall (name:string, args:unknown):Reply {\n    return {\n        stream:{\n            choices:[{\n                index:0,\n                message:{\n                    role:'assistant',\n                    tool_calls:[{\n                        id:'doctor-call',\n                        type:'function',\n                        function:{ name, arguments:JSON.stringify(args) },\n                    }]\n                },\n                finish_reason:'tool_calls',\n            }],\n        }\n    }\n}\n\nexport function responsesProbeCall (name:string, args:unknown):Reply {\n    return {\n        stream:{\n            id:'resp-doctor',\n            status:'completed',\n            output:[{\n                type:'function_call',\n                id:'fc-doctor',\n                call_id:'doctor-call',\n                name,\n                arguments:JSON.stringify(args),\n                status:'completed',\n            }],\n            usage:{ input_tokens:1, output_tokens:1, total_tokens:2 },\n        }\n    }\n}\n\nexport function doctorProbe ():Script {\n    const prefixes = new Map<string, { messages:unknown[], tools:unknown }>()\n    return (req:RecordedRequest) => {\n        if (req.path.endsWith('/v1/messages')) {\n            return anthropicProbe(prefixes, req)\n        }\n        const body = req.body as {\n            messages?:Record<string, unknown>[],\n            input?:Record<string, unknown>[],\n            tools:unknown,\n            tool_choice?:unknown,\n        }\n        if (body.tool_choice !== undefined && body.tool_choice !== 'auto') {\n            return { status:400, body:'forced tool choice' }\n        }\n        const responses = body.input !== undefined\n        const call = responses ? responsesProbeCall : probeCall\n        const messages = body.messages ?? body.input ?? []\n        const result = messages.find(m => m.role === 'tool' ||\n            m.type === 'function_call_output')\n        const key = String(req.headers.authorization)\n        if (!result) {\n            prefixes.set(key, { messages, tools:body.tools })\n            return call('doctor_lookup', {})\n        }\n        const prefix = prefixes.get(key)\n        if (!prefix || JSON.stringify(body.tools) !==\n            JSON.stringify(prefix.tools) ||\n            JSON.stringify(messages.slice(0, prefix.messages.length)) !==\n            JSON.stringify(prefix.messages)) {\n            return { status:400, body:'changed conversation prefix' }\n        }\n        const output = responses ? result.output : result.content\n        const token = JSON.parse(String(output)).token\n        return call('doctor_probe', { ok:true, token })\n    }\n}\n            } : { Authorization:`Bearer ${resolved.apiKey}` },\n        })\n        await discardModelsBody(response, signal)\n        const status = `HTTP ${response.status} ${response.statusText}`.trim()\n        if (response.ok) {\n            result.status = 'pass'\n            result.detail = `GET ${url}: ${status}`\n        } else if (response.status >= 300 && response.status < 400) {\n            result.detail = `GET ${url}: redirect refused (${status})`\n        } else if (response.status === 401 || response.status === 403) {\n            result.detail = `credential rejected by ${url}: ${status}`\n        } else if (response.status >= 500) {\n            result.detail = `${url} returned ${status}`\n        } else {\n            result.status = 'warn'\n            result.detail = 'endpoint is reachable but model listing ' +\n                `returned ${status}`\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = `GET ${url}: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nconst probeResult = z.object({ ok:z.boolean(), token:z.string() })\n\nexport async function doctorRoundtripCheck (\n    name:RoleName,\n    resolved:ResolvedRole,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const result:DoctorResult = {\n        name:`${name}-roundtrip`, status:'fail', detail:'',\n    }\n    const signal = AbortSignal.any([\n        ctx.signal, AbortSignal.timeout(35000),\n    ])\n    try {\n        const protocol = resolved.protocol\n        if (protocol !== 'chat' && protocol !== 'responses' &&\n            protocol !== 'anthropic') {\n            throw new Error(`unsupported inference protocol \"${protocol}\"`)\n        }\n        const limit = resolved.maxOutputTokens\n        const client = createClient(createModelClient({\n            role:name,\n            baseUrl:resolved.baseURL,\n            apiKey:resolved.apiKey,\n            model:resolved.model,\n            protocol,\n            maxOutputTokens:limit > 0 && limit <= 512 ? limit : 512,\n            sessionHeader:resolved.sessionHeader,\n            maxAttempts:1,\n            requestTimeoutMs:15000,\n            fetch:ctx.fetch,\n        }))\n        const token = `roast-doctor-${newSessionId().slice(6)}`\n        let looked = false\n        const output = await client.converse(\n            'This is a connectivity check. Call doctor_lookup once, then ' +\n                'call doctor_probe with ok=true and the token ' +\n                'doctor_lookup returned.',\n            'Run the check now.', {\n                tools:[{\n                    name:'doctor_lookup',\n                    description:'Return the diagnostic token.',\n                    schema:{\n                        type:'object',\n                        properties:{},\n                        additionalProperties:false,\n                    },\n                    run:() => {\n                        looked = true\n                        return { token }\n                    },\n                }, {\n                    name:'doctor_probe',\n                    description:'Return the diagnostic result.',\n                    schema:{\n                        type:'object',\n                        properties:{\n                            ok:{ type:'boolean' }, token:{ type:'string' },\n                        },\n                        required:['ok', 'token'],\n                        additionalProperties:false,\n                    },\n                }],\n                finalTool:'doctor_probe',\n                final:{ decode:value => probeResult.parse(value) },\n                maxTurns:2,\n            }, signal)\n        if (!output.ok) {\n            result.detail = 'doctor_probe returned ok=false'\n        } else if (!looked || output.token !== token) {\n            result.detail = 'doctor_probe did not return the token from ' +\n                'doctor_lookup; the tool result did not round-trip'\n        } else {\n            result.status = 'pass'\n            result.detail = `${resolved.model} via ${resolved.protocol} ` +\n                '(two-turn tool loop)'\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = hasSentinel(err, 'auth') ?\n            'credential rejected by the configured inference route' :\n            `${resolved.protocol}/${resolved.model} two-turn tool probe ` +\n                `failed: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nasync function doctorRoleChecks (\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'\nimport { runRoast } from '../helpers/run.js'\nimport { saveCredential, projectCredentialsPath, userCredentialsPath }\n    from '../../src/credentials/credentials.js'\nimport { installationTargets, install, skillHooks }\n    from '../../src/skill/skill.js'\nimport { git } from '../../src/git/git.js'\nimport { startInferenceServer } from '../helpers/inference-server.js'\nimport { doctorProbe, probeCall } from '../helpers/doctor-probe.js'\nimport { providerServer } from '../helpers/provider-server.js'\n\nconst BUILTIN = {\n    version:1,\n    inference_profiles:{ o:{ protocol:'chat', model:'m' } },\n    roles:{ finder:{ profile:'o' }, verifier:{ profile:'o' } },\n}\n\nfunction doctorRepo (t:CleanupTest):TempDir {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    delete r.env.HTTPS_PROXY\n    delete r.env.https_proxy\n    delete r.env.NODE_USE_ENV_PROXY\n    r.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n    r.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n    fs.writeFileSync(path.join(r.dir, '.roast.json'),\n        JSON.stringify(BUILTIN))\n    return r\n}\n\ninterface Row {\n    name:string;\n    status:string;\n    detail:string;\n}\n\nasync function doctor (\n    r:TempDir,\n    args:string[] = [],\n    redirectTo?:string\n) {\n    const server = redirectTo ? undefined : await providerServer(doctorProbe())\n    try {\n        const res = await runRoast(['doctor', '--json', ...args],\n            { cwd:r.dir, env:r.env, redirectTo:redirectTo ?? server?.url })\n        const rows:Row[] = res.stdout.startsWith('[') ?\n            JSON.parse(res.stdout) : []\n        return { ...res, rows }\n    } finally {\n        await server?.close()\n    }\n}\n\ntest('doctor keeps all local checks after missing or invalid config',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        await saveCredential(project, 'openai', 'secret', new Date())\n        fs.unlinkSync(path.join(r.dir, '.roast.json'))\n        const missing = await doctor(r)\n        t.equal(missing.code, 4, 'missing config fails')\n        t.deepEqual(missing.rows.map(x => x.name), [\n            'build', 'config-file', 'git', 'git-gate',\n            'project-credentials', 'proxy-env', 'agents-skill', 'claude-skill',\n        ], 'local checks remain in order')\n        t.equal(missing.rows[1].status, 'fail', 'config-file failure')\n        fs.writeFileSync(path.join(r.dir, '.roast.json'), '{')\n        const invalid = await doctor(r)\n        t.equal(invalid.code, 4, 'invalid config fails')\n        t.equal(invalid.rows.find(x => x.name === 'config')?.status,\n            'fail', 'config failure')\n        t.ok(invalid.rows.some(x => x.name === 'agents-skill'),\n            'skills still checked')\n        const explicit = await doctor(r, ['--config', 'missing.json'])\n        t.equal(explicit.rows.find(x => x.name === 'config-file')?.status,\n            'pass', 'explicit missing path accepted')\n        t.equal(explicit.rows.find(x => x.name === 'config')?.status,\n            'fail', 'explicit missing file fails loading')\n        fs.writeFileSync(path.join(r.dir, 'custom.json'),\n            JSON.stringify(BUILTIN))\n        const relative = await doctor(r, ['--config', 'custom.json'])\n        t.equal(relative.code, 0, 'relative config uses invocation cwd')\n    })\n\ntest('doctor checks gate health and only user-level skill installations',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const targets = await installationTargets('', '', { env:r.env })\n        await install(targets[0].path, false)\n        await git(r.dir, ['config', '--local', 'roast.gate', 'enabled'],\n            { env:r.env })\n        const res = await doctor(r)\n        t.equal(res.code, 0, 'warnings do not fail')\n        t.equal(res.rows.find(x => x.name === 'git-gate')?.status,\n            'warn', 'enabled but absent gate warns')\n        t.equal(res.rows.find(x => x.name === 'agents-skill')?.status,\n            'pass', 'user install found')\n        fs.writeFileSync(path.join(targets[0].path, 'SKILL.md'), 'stale')\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'warn', 'stale warns')\n        fs.rmSync(targets[0].path, { recursive:true })\n        fs.symlinkSync(r.dir, targets[0].path)\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'pass', 'symlink passes')\n        const outside = tempDir()\n        t.cleanup(outside.remove)\n        outside.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n        outside.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n        fs.writeFileSync(path.join(outside.dir, '.roast.json'),\n            JSON.stringify(BUILTIN))\n        const out = await doctor(outside)\n        t.equal(out.code, 0, 'outside repository only warns')\n        t.equal(out.rows.find(x => x.name === 'git')?.status,\n            'warn', 'git warns')\n        t.ok(!out.rows.some(x => x.name === 'git-gate'), 'gate omitted')\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const text = await runRoast(['doctor'], {\n            cwd:r.dir, env:r.env, redirectTo:server.url,\n        })\n        t.equal(text.code, 0, 'text mode')\n        t.equal(text.stdout.split('\\n').filter(Boolean).length,\n            res.rows.length, 'one text line per result')\n        t.equal((await doctor(r, ['extra'])).code, 2, 'rejects positional')\n    })\n\nexport async function approveDoctorConfig (r:TempDir):Promise<void> {\n    const res = await runRoast(['trust', '--yes'],\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            return res => {\n                const key = String(req.headers.authorization).slice(7)\n                res.writeHead(200, key)\n                // The probe must finish after 32 KiB even without an EOF.\n                res.write(Buffer.alloc(32 * 1024, 'x'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, 'large unterminated body does not time out')\n        t.deepEqual(res.rows.filter(x =>\n            x.name.endsWith('-endpoint')).map(x => x.status),\n        ['pass', 'pass'], 'both models requests succeed at the body limit')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_FINDER_API_KEY),\n            'key reflected in status text is redacted')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_VERIFIER_API_KEY),\n            'verifier key reflected in status text is redacted')\n    })\n\ntest('doctor chat roundtrip uses two turns with a stable prefix', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(doctorProbe())\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 0, res.stderr)\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => [x.name, x.status]), [\n        ['finder-roundtrip', 'pass'], ['verifier-roundtrip', 'pass'],\n    ], 'both roles complete the tool loop')\n    t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n    ], 'each endpoint probe is followed by exactly two inference requests')\n})\n\ntest('doctor rejects a guessed token without doctor_lookup', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(() =>\n        probeCall('doctor_probe', { ok:true, token:'roast-doctor-guess' }))\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'guessing does not pass doctor')\n    const rows = res.rows.filter(x => x.name.endsWith('-roundtrip'))\n    t.deepEqual(rows.map(x => x.status), ['fail', 'fail'],\n        'both roles must roundtrip the lookup token')\n    t.ok(rows.every(x => x.detail.includes('doctor_lookup')),\n        'diagnostic identifies the skipped lookup')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 2,\n        'one rejected final answer per role')\n})\n\ntest('doctor rejects a changed lookup token on the final turn', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(req => {\n        const body = req.body as { messages:{ role:string }[] }\n        return body.messages.some(x => x.role === 'tool') ?\n            probeCall('doctor_probe', { ok:true, token:'changed-token' }) :\n            probeCall('doctor_lookup', {})\n    })\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'lookup alone does not prove a roundtrip')\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => x.status), ['fail', 'fail'], 'changed token fails')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 4,\n        'both roles reached the second turn')\n})\n\ntest('doctor sends the configured session header on both chat turns',\n    async t => {\n        const r = doctorRepo(t)\n        fs.writeFileSync(path.join(r.dir, '.roast.json'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{\n                    protocol:'chat',\n                    model:'m',\n                    session_header:'X-Doctor-Session',\n                },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, res.stderr)\n        const requests = server.requests.filter(x => x.method === 'POST')\n        t.equal(requests.length, 4, 'two turns per role')\n        const sessions = requests.map(x => x.headers['x-doctor-session'])\n        t.ok(sessions.every(x => typeof x === 'string' &&\n            /^roast-[A-Z2-7]{26}$/.test(x)), 'session IDs sent')\n        t.equal(sessions[0], sessions[1], 'finder session survives replay')\n        t.equal(sessions[2], sessions[3], 'verifier session survives replay')\n        t.ok(sessions[0] !== sessions[2], 'roles use separate sessions')\n        t.ok(server.requests.filter(x => x.method === 'GET').every(x =>\n            x.headers['x-doctor-session'] === undefined),\n        'session header remains absent from models checks')\n    })\n\ntest('doctor emits approved chat diagnostics for an explicit config',\n    async t => {\n        const r = doctorRepo(t)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const secret = 'doctor-key-never-print'\n        r.env.DOCTOR_KEY = secret\n        const file = path.join(r.dir, 'diagnostic.json')\n        fs.writeFileSync(file, JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', api_key_env:'DOCTOR_KEY' },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const approved = await runRoast([\n            'trust', '--yes', '--config', file,\n        ], { cwd:r.dir, env:r.env })\n        t.equal(approved.code, 0, approved.stderr)\n        const res = await doctor(r, ['--config', file], server.url)\n        t.equal(res.code, 0, res.stderr)\n        t.ok(Array.isArray(JSON.parse(res.stdout)) && res.rows.length >= 8,\n            'stdout is a complete JSON result array')\n        t.equal(res.rows.find(x => x.name === 'finder-credential')?.detail,\n            'DOCTOR_KEY (profile api_key_env)', 'names credential source')\n        t.deepEqual(res.rows.slice(4, 12).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['finder-endpoint', 'pass'], ['finder-roundtrip', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'], ['verifier-roundtrip', 'pass'],\n        ], 'role checks and probes remain in specified order')\n        t.ok(!(res.stdout + res.stderr).includes(secret),\n            'secret absent from output')\n        t.ok(server.requests.every(x =>\n            x.headers.authorization === `Bearer ${secret}`),\n        'profile credential reaches both kinds of request')\n    })","is_error":false}]},"parent_tool_use_id":null,"session_id":"8db26e43-7bde-47a9-88ba-95dcb38ede5e","uuid":"8895d37f-39d2-4b93-bcfa-7ee42e455b50","timestamp":"2026-11-24T03:37:36.246Z","tool_use_result":{"stdout":"// pattern: Imperative Shell\n// Chat, responses, and anthropic fake that requires automatic choice\n// and a stable probe prefix.\nimport type { RecordedRequest, Reply, Script }\n    from './inference-server.js'\nimport { anthropicCalls } from './anthropic-fakes.js'\n\ntype Json = Record<string, unknown>\n\n// The anthropic form of the probe (path `/v1/messages`).\nfunction anthropicProbe (\n    prefixes:Map<string, { messages:unknown[], tools:unknown }>,\n    req:RecordedRequest\n):Reply {\n    const body = req.body as {\n        messages:{ role:string, content:Json[] }[],\n        tools:unknown,\n        tool_choice?:{ type?:string },\n    }\n    if (body.tool_choice !== undefined && body.tool_choice.type !== 'auto') {\n        return { status:400, body:'forced tool choice' }\n    }\n    const messages = body.messages\n    const result = messages.flatMap(m => m.content)\n        .find(b => b.type === 'tool_result')\n    const key = String(req.headers['x-api-key'])\n    if (!result) {\n        prefixes.set(key, { messages, tools:body.tools })\n        return { stream:anthropicCalls([{ name:'doctor_lookup', args:{} }]) }\n    }\n    const prefix = prefixes.get(key)\n    if (!prefix || JSON.stringify(body.tools) !==\n        JSON.stringify(prefix.tools) ||\n        JSON.stringify(messages.slice(0, prefix.messages.length)) !==\n        JSON.stringify(prefix.messages)) {\n        return { status:400, body:'changed conversation prefix' }\n    }\n    const content = result.content as { text:string }[]\n    const token = JSON.parse(content[0].text).token\n    return {\n        stream:anthropicCalls([{\n            name:'doctor_probe', args:{ ok:true, token },\n        }]),\n    }\n}\n\nexport function probeCall (name:string, args:unknown):Reply {\n    return {\n        stream:{\n            choices:[{\n                index:0,\n                message:{\n                    role:'assistant',\n                    tool_calls:[{\n                        id:'doctor-call',\n                        type:'function',\n                        function:{ name, arguments:JSON.stringify(args) },\n                    }]\n                },\n                finish_reason:'tool_calls',\n            }],\n        }\n    }\n}\n\nexport function responsesProbeCall (name:string, args:unknown):Reply {\n    return {\n        stream:{\n            id:'resp-doctor',\n            status:'completed',\n            output:[{\n                type:'function_call',\n                id:'fc-doctor',\n                call_id:'doctor-call',\n                name,\n                arguments:JSON.stringify(args),\n                status:'completed',\n            }],\n            usage:{ input_tokens:1, output_tokens:1, total_tokens:2 },\n        }\n    }\n}\n\nexport function doctorProbe ():Script {\n    const prefixes = new Map<string, { messages:unknown[], tools:unknown }>()\n    return (req:RecordedRequest) => {\n        if (req.path.endsWith('/v1/messages')) {\n            return anthropicProbe(prefixes, req)\n        }\n        const body = req.body as {\n            messages?:Record<string, unknown>[],\n            input?:Record<string, unknown>[],\n            tools:unknown,\n            tool_choice?:unknown,\n        }\n        if (body.tool_choice !== undefined && body.tool_choice !== 'auto') {\n            return { status:400, body:'forced tool choice' }\n        }\n        const responses = body.input !== undefined\n        const call = responses ? responsesProbeCall : probeCall\n        const messages = body.messages ?? body.input ?? []\n        const result = messages.find(m => m.role === 'tool' ||\n            m.type === 'function_call_output')\n        const key = String(req.headers.authorization)\n        if (!result) {\n            prefixes.set(key, { messages, tools:body.tools })\n            return call('doctor_lookup', {})\n        }\n        const prefix = prefixes.get(key)\n        if (!prefix || JSON.stringify(body.tools) !==\n            JSON.stringify(prefix.tools) ||\n            JSON.stringify(messages.slice(0, prefix.messages.length)) !==\n            JSON.stringify(prefix.messages)) {\n            return { status:400, body:'changed conversation prefix' }\n        }\n        const output = responses ? result.output : result.content\n        const token = JSON.parse(String(output)).token\n        return call('doctor_probe', { ok:true, token })\n    }\n}\n            } : { Authorization:`Bearer ${resolved.apiKey}` },\n        })\n        await discardModelsBody(response, signal)\n        const status = `HTTP ${response.status} ${response.statusText}`.trim()\n        if (response.ok) {\n            result.status = 'pass'\n            result.detail = `GET ${url}: ${status}`\n        } else if (response.status >= 300 && response.status < 400) {\n            result.detail = `GET ${url}: redirect refused (${status})`\n        } else if (response.status === 401 || response.status === 403) {\n            result.detail = `credential rejected by ${url}: ${status}`\n        } else if (response.status >= 500) {\n            result.detail = `${url} returned ${status}`\n        } else {\n            result.status = 'warn'\n            result.detail = 'endpoint is reachable but model listing ' +\n                `returned ${status}`\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = `GET ${url}: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nconst probeResult = z.object({ ok:z.boolean(), token:z.string() })\n\nexport async function doctorRoundtripCheck (\n    name:RoleName,\n    resolved:ResolvedRole,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const result:DoctorResult = {\n        name:`${name}-roundtrip`, status:'fail', detail:'',\n    }\n    const signal = AbortSignal.any([\n        ctx.signal, AbortSignal.timeout(35000),\n    ])\n    try {\n        const protocol = resolved.protocol\n        if (protocol !== 'chat' && protocol !== 'responses' &&\n            protocol !== 'anthropic') {\n            throw new Error(`unsupported inference protocol \"${protocol}\"`)\n        }\n        const limit = resolved.maxOutputTokens\n        const client = createClient(createModelClient({\n            role:name,\n            baseUrl:resolved.baseURL,\n            apiKey:resolved.apiKey,\n            model:resolved.model,\n            protocol,\n            maxOutputTokens:limit > 0 && limit <= 512 ? limit : 512,\n            sessionHeader:resolved.sessionHeader,\n            maxAttempts:1,\n            requestTimeoutMs:15000,\n            fetch:ctx.fetch,\n        }))\n        const token = `roast-doctor-${newSessionId().slice(6)}`\n        let looked = false\n        const output = await client.converse(\n            'This is a connectivity check. Call doctor_lookup once, then ' +\n                'call doctor_probe with ok=true and the token ' +\n                'doctor_lookup returned.',\n            'Run the check now.', {\n                tools:[{\n                    name:'doctor_lookup',\n                    description:'Return the diagnostic token.',\n                    schema:{\n                        type:'object',\n                        properties:{},\n                        additionalProperties:false,\n                    },\n                    run:() => {\n                        looked = true\n                        return { token }\n                    },\n                }, {\n                    name:'doctor_probe',\n                    description:'Return the diagnostic result.',\n                    schema:{\n                        type:'object',\n                        properties:{\n                            ok:{ type:'boolean' }, token:{ type:'string' },\n                        },\n                        required:['ok', 'token'],\n                        additionalProperties:false,\n                    },\n                }],\n                finalTool:'doctor_probe',\n                final:{ decode:value => probeResult.parse(value) },\n                maxTurns:2,\n            }, signal)\n        if (!output.ok) {\n            result.detail = 'doctor_probe returned ok=false'\n        } else if (!looked || output.token !== token) {\n            result.detail = 'doctor_probe did not return the token from ' +\n                'doctor_lookup; the tool result did not round-trip'\n        } else {\n            result.status = 'pass'\n            result.detail = `${resolved.model} via ${resolved.protocol} ` +\n                '(two-turn tool loop)'\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = hasSentinel(err, 'auth') ?\n            'credential rejected by the configured inference route' :\n            `${resolved.protocol}/${resolved.model} two-turn tool probe ` +\n                `failed: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nasync function doctorRoleChecks (\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'\nimport { runRoast } from '../helpers/run.js'\nimport { saveCredential, projectCredentialsPath, userCredentialsPath }\n    from '../../src/credentials/credentials.js'\nimport { installationTargets, install, skillHooks }\n    from '../../src/skill/skill.js'\nimport { git } from '../../src/git/git.js'\nimport { startInferenceServer } from '../helpers/inference-server.js'\nimport { doctorProbe, probeCall } from '../helpers/doctor-probe.js'\nimport { providerServer } from '../helpers/provider-server.js'\n\nconst BUILTIN = {\n    version:1,\n    inference_profiles:{ o:{ protocol:'chat', model:'m' } },\n    roles:{ finder:{ profile:'o' }, verifier:{ profile:'o' } },\n}\n\nfunction doctorRepo (t:CleanupTest):TempDir {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    delete r.env.HTTPS_PROXY\n    delete r.env.https_proxy\n    delete r.env.NODE_USE_ENV_PROXY\n    r.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n    r.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n    fs.writeFileSync(path.join(r.dir, '.roast.json'),\n        JSON.stringify(BUILTIN))\n    return r\n}\n\ninterface Row {\n    name:string;\n    status:string;\n    detail:string;\n}\n\nasync function doctor (\n    r:TempDir,\n    args:string[] = [],\n    redirectTo?:string\n) {\n    const server = redirectTo ? undefined : await providerServer(doctorProbe())\n    try {\n        const res = await runRoast(['doctor', '--json', ...args],\n            { cwd:r.dir, env:r.env, redirectTo:redirectTo ?? server?.url })\n        const rows:Row[] = res.stdout.startsWith('[') ?\n            JSON.parse(res.stdout) : []\n        return { ...res, rows }\n    } finally {\n        await server?.close()\n    }\n}\n\ntest('doctor keeps all local checks after missing or invalid config',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        await saveCredential(project, 'openai', 'secret', new Date())\n        fs.unlinkSync(path.join(r.dir, '.roast.json'))\n        const missing = await doctor(r)\n        t.equal(missing.code, 4, 'missing config fails')\n        t.deepEqual(missing.rows.map(x => x.name), [\n            'build', 'config-file', 'git', 'git-gate',\n            'project-credentials', 'proxy-env', 'agents-skill', 'claude-skill',\n        ], 'local checks remain in order')\n        t.equal(missing.rows[1].status, 'fail', 'config-file failure')\n        fs.writeFileSync(path.join(r.dir, '.roast.json'), '{')\n        const invalid = await doctor(r)\n        t.equal(invalid.code, 4, 'invalid config fails')\n        t.equal(invalid.rows.find(x => x.name === 'config')?.status,\n            'fail', 'config failure')\n        t.ok(invalid.rows.some(x => x.name === 'agents-skill'),\n            'skills still checked')\n        const explicit = await doctor(r, ['--config', 'missing.json'])\n        t.equal(explicit.rows.find(x => x.name === 'config-file')?.status,\n            'pass', 'explicit missing path accepted')\n        t.equal(explicit.rows.find(x => x.name === 'config')?.status,\n            'fail', 'explicit missing file fails loading')\n        fs.writeFileSync(path.join(r.dir, 'custom.json'),\n            JSON.stringify(BUILTIN))\n        const relative = await doctor(r, ['--config', 'custom.json'])\n        t.equal(relative.code, 0, 'relative config uses invocation cwd')\n    })\n\ntest('doctor checks gate health and only user-level skill installations',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const targets = await installationTargets('', '', { env:r.env })\n        await install(targets[0].path, false)\n        await git(r.dir, ['config', '--local', 'roast.gate', 'enabled'],\n            { env:r.env })\n        const res = await doctor(r)\n        t.equal(res.code, 0, 'warnings do not fail')\n        t.equal(res.rows.find(x => x.name === 'git-gate')?.status,\n            'warn', 'enabled but absent gate warns')\n        t.equal(res.rows.find(x => x.name === 'agents-skill')?.status,\n            'pass', 'user install found')\n        fs.writeFileSync(path.join(targets[0].path, 'SKILL.md'), 'stale')\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'warn', 'stale warns')\n        fs.rmSync(targets[0].path, { recursive:true })\n        fs.symlinkSync(r.dir, targets[0].path)\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'pass', 'symlink passes')\n        const outside = tempDir()\n        t.cleanup(outside.remove)\n        outside.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n        outside.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n        fs.writeFileSync(path.join(outside.dir, '.roast.json'),\n            JSON.stringify(BUILTIN))\n        const out = await doctor(outside)\n        t.equal(out.code, 0, 'outside repository only warns')\n        t.equal(out.rows.find(x => x.name === 'git')?.status,\n            'warn', 'git warns')\n        t.ok(!out.rows.some(x => x.name === 'git-gate'), 'gate omitted')\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const text = await runRoast(['doctor'], {\n            cwd:r.dir, env:r.env, redirectTo:server.url,\n        })\n        t.equal(text.code, 0, 'text mode')\n        t.equal(text.stdout.split('\\n').filter(Boolean).length,\n            res.rows.length, 'one text line per result')\n        t.equal((await doctor(r, ['extra'])).code, 2, 'rejects positional')\n    })\n\nexport async function approveDoctorConfig (r:TempDir):Promise<void> {\n    const res = await runRoast(['trust', '--yes'],\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            return res => {\n                const key = String(req.headers.authorization).slice(7)\n                res.writeHead(200, key)\n                // The probe must finish after 32 KiB even without an EOF.\n                res.write(Buffer.alloc(32 * 1024, 'x'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, 'large unterminated body does not time out')\n        t.deepEqual(res.rows.filter(x =>\n            x.name.endsWith('-endpoint')).map(x => x.status),\n        ['pass', 'pass'], 'both models requests succeed at the body limit')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_FINDER_API_KEY),\n            'key reflected in status text is redacted')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_VERIFIER_API_KEY),\n            'verifier key reflected in status text is redacted')\n    })\n\ntest('doctor chat roundtrip uses two turns with a stable prefix', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(doctorProbe())\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 0, res.stderr)\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => [x.name, x.status]), [\n        ['finder-roundtrip', 'pass'], ['verifier-roundtrip', 'pass'],\n    ], 'both roles complete the tool loop')\n    t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n    ], 'each endpoint probe is followed by exactly two inference requests')\n})\n\ntest('doctor rejects a guessed token without doctor_lookup', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(() =>\n        probeCall('doctor_probe', { ok:true, token:'roast-doctor-guess' }))\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'guessing does not pass doctor')\n    const rows = res.rows.filter(x => x.name.endsWith('-roundtrip'))\n    t.deepEqual(rows.map(x => x.status), ['fail', 'fail'],\n        'both roles must roundtrip the lookup token')\n    t.ok(rows.every(x => x.detail.includes('doctor_lookup')),\n        'diagnostic identifies the skipped lookup')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 2,\n        'one rejected final answer per role')\n})\n\ntest('doctor rejects a changed lookup token on the final turn', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(req => {\n        const body = req.body as { messages:{ role:string }[] }\n        return body.messages.some(x => x.role === 'tool') ?\n            probeCall('doctor_probe', { ok:true, token:'changed-token' }) :\n            probeCall('doctor_lookup', {})\n    })\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'lookup alone does not prove a roundtrip')\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => x.status), ['fail', 'fail'], 'changed token fails')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 4,\n        'both roles reached the second turn')\n})\n\ntest('doctor sends the configured session header on both chat turns',\n    async t => {\n        const r = doctorRepo(t)\n        fs.writeFileSync(path.join(r.dir, '.roast.json'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{\n                    protocol:'chat',\n                    model:'m',\n                    session_header:'X-Doctor-Session',\n                },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, res.stderr)\n        const requests = server.requests.filter(x => x.method === 'POST')\n        t.equal(requests.length, 4, 'two turns per role')\n        const sessions = requests.map(x => x.headers['x-doctor-session'])\n        t.ok(sessions.every(x => typeof x === 'string' &&\n            /^roast-[A-Z2-7]{26}$/.test(x)), 'session IDs sent')\n        t.equal(sessions[0], sessions[1], 'finder session survives replay')\n        t.equal(sessions[2], sessions[3], 'verifier session survives replay')\n        t.ok(sessions[0] !== sessions[2], 'roles use separate sessions')\n        t.ok(server.requests.filter(x => x.method === 'GET').every(x =>\n            x.headers['x-doctor-session'] === undefined),\n        'session header remains absent from models checks')\n    })\n\ntest('doctor emits approved chat diagnostics for an explicit config',\n    async t => {\n        const r = doctorRepo(t)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const secret = 'doctor-key-never-print'\n        r.env.DOCTOR_KEY = secret\n        const file = path.join(r.dir, 'diagnostic.json')\n        fs.writeFileSync(file, JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', api_key_env:'DOCTOR_KEY' },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const approved = await runRoast([\n            'trust', '--yes', '--config', file,\n        ], { cwd:r.dir, env:r.env })\n        t.equal(approved.code, 0, approved.stderr)\n        const res = await doctor(r, ['--config', file], server.url)\n        t.equal(res.code, 0, res.stderr)\n        t.ok(Array.isArray(JSON.parse(res.stdout)) && res.rows.length >= 8,\n            'stdout is a complete JSON result array')\n        t.equal(res.rows.find(x => x.name === 'finder-credential')?.detail,\n            'DOCTOR_KEY (profile api_key_env)', 'names credential source')\n        t.deepEqual(res.rows.slice(4, 12).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['finder-endpoint', 'pass'], ['finder-roundtrip', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'], ['verifier-roundtrip', 'pass'],\n        ], 'role checks and probes remain in specified order')\n        t.ok(!(res.stdout + res.stderr).includes(secret),\n            'secret absent from output')\n        t.ok(server.requests.every(x =>\n            x.headers.authorization === `Bearer ${secret}`),\n        'profile credential reaches both kinds of request')\n    })","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01S5Mv2mYgP79GfvHMA7Pv2F","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
