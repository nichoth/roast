rt function pinned (t:Tree):boolean {\n    return t.oid !== ''\n}\n\nexport function staged (t:Tree):boolean {\n    return pinned(t) && !t.worktree\n}\n\nexport function pinnedWorktree (oid:string):Tree {\n    return { oid, worktree:oid !== '' }\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nasync function gitText (\n    repo:string,\n    args:string[],\n    signal:AbortSignal,\n    opts:ContextOpts,\n    extraEnv?:Record<string, string>\n):Promise<string> {\n    const out = await git(repo, args, { signal, env:opts.env, extraEnv })\n    return out.toString().trim()\n}\n\nasync function copyIndex (src:string, dst:string):Promise<void> {\n    let data:Buffer\n    try {\n        data = await fs.readFile(src)\n    } catch (err) {\n        if ((err as NodeJS.ErrnoException).code === 'ENOENT') return\n        throw new Error(`read ${src}: ${message(err)}`, { cause:err })\n    }\n    let fh:fs.FileHandle\n    try {\n        fh = await fs.open(dst, 'w', 0o600)\n    } catch (err) {\n        throw new Error(`create ${dst}: ${message(err)}`, { cause:err })\n    }\n    try {\n        await fh.writeFile(data)\n    } catch (err) {\n        throw new Error(`copy index: ${message(err)}`, { cause:err })\n    } finally {\n        await fh.close()\n    }\n}\n\n// Writes the current index (honoring GIT_INDEX_FILE) into a tree object\n// through a temporary copy, without touching the live index, any ref, or\n// any commit.\nexport async function pinIndexTree (\n    repo:string,\n    signal:AbortSignal,\n    opts:Omit<ContextOpts, 'signal'> = {}\n):Promise<Tree> {\n    let gitDir:string\n    try {\n        gitDir = await gitText(repo, ['rev-parse', '--absolute-git-dir'],\n            signal, opts)\n    } catch (err) {\n        signal.throwIfAborted()\n        throw new Error(`resolve git dir: ${message(err)}`, { cause:err })\n    }\n    const env = opts.env ?? process.env\n    let live = env.GIT_INDEX_FILE ?? ''\n    if (live === '') live = path.join(gitDir, 'index')\n    else if (!path.isAbsolute(live)) live = path.join(repo, live)\n\n    let tmp:string\n    try {\n        tmp = await fs.mkdtemp(path.join(os.tmpdir(), 'roast-pin-'))\n    } catch (err) {\n        throw new Error(`temp dir: ${message(err)}`, { cause:err })\n    }\n    try {\n        const idx = path.join(tmp, 'index')\n        await copyIndex(live, idx)\n        let oid:string\n        try {\n            oid = await gitText(repo, ['write-tree'], signal, opts,\n                { GIT_INDEX_FILE:idx })\n        } catch (err) {\n            signal.throwIfAborted()\n            throw new Error(`write-tree: ${message(err)}`, { cause:err })\n        }\n        return { oid, worktree:false }\n    } finally {\n        await fs.rm(tmp, { recursive:true, force:true })\n    }\n}\nEOF"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":69,"subtype":"success","api_error_status":null,"result":"`npm test` (the Go tests plus the launcher tests) is still running in the background. I'll commit once it passes.","ttft_ms":1745,"type":"result","duration_ms":834420,"uuid":"0263990e-943a-42ee-bb3f-24cd060d3955","ttft_stream_ms":1265,"time_to_request_ms":204,"first_content_frame_ms":1265,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":130,"outputTokens":62053,"cacheReadInputTokens":9934665,"cacheCreationInputTokens":195614,"webSearchRequests":0,"costUSD":4.793425000000001,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":12475,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphem