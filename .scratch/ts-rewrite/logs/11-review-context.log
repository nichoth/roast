{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013QvdK5KDGrkkVXHxXG8Ff7","type":"tool_result","content":"// Scope-specific git wrappers on top of the shared runner in src/git/.\n// Only gitPatch spawns git itself: it streams stdout through a\n// SectionCapper so a huge file never sits in memory whole.\nimport { spawn } from 'node:child_process'\nimport { git, gitOk, GitError, type GitRunOpts } from '../git/git.js'\nimport { DIFF_CONFIG } from './constants.js'\nimport { SectionCapper } from './patch.js'\n\nexport { git, gitOk, GitError, type GitRunOpts }\n\n// How long a child gets after SIGTERM before SIGKILL.\nconst KILL_GRACE_MS = 1000\n\n// `DIFF_CONFIG diff <args>`: every diff invocation starts this way.\nexport function diffArgs (...args:readonly string[]):string[] {\n    return [...DIFF_CONFIG, 'diff', ...args]\n}\n\nexport interface PatchResult {\n    out:Buffer;\n    cut:string[];\n}\n\n// Runs a patch-producing git command, cutting each file section at\n// maxSection bytes. A non-zero exit rejects with a GitError; an abort\n// kills git and rejects with the signal's reason.\nexport function gitPatch (\n    repo:string,\n    args:readonly string[],\n    maxSection:number,\n    opts:GitRunOpts = {}\n):Promise<PatchResult> {\n    const { signal } = opts\n    return new Promise((resolve, reject) => {\n        if (signal?.aborted) {\n            reject(signal.reason)\n            return\n        }\n        const env = { ...(opts.env ?? process.env), ...opts.extraEnv }\n        const child = spawn('git', ['-C', repo, ...args], {\n            env,\n            stdio:['ignore', 'pipe', 'pipe'],\n        })\n        const capper = new SectionCapper(maxSection)\n        const err:Buffer[] = []\n        let killTimer:NodeJS.Timeout|undefined\n        let failure:Error|undefined\n\n        function kill ():void {\n            child.kill('SIGTERM')\n            killTimer ??= setTimeout(() => child.kill('SIGKILL'),\n                KILL_GRACE_MS)\n        }\n        signal?.addEventListener('abort', kill, { once:true })\n\n        child.stdout.on('data', (chunk:Buffer) => {\n            if (failure) return\n            try {\n                capper.write(chunk)\n            } catch (e) {\n                failure = e as Error\n                kill()\n            }\n        })\n        child.stdout.on('error', e => {\n            failure ??= e\n            kill()\n        })\n        child.stderr.on('data', (chunk:Buffer) => err.push(chunk))\n        child.on('error', e => { failure ??= e })\n        child.on('close', (code, sig) => {\n            clearTimeout(killTimer)\n            signal?.removeEventListener('abort', kill)\n            if (signal?.aborted) {\n                reject(signal.reason)\n            } else if (failure) {\n                reject(failure)\n            } else if (code !== 0) {\n                reject(new GitError(code, sig,\n                    Buffer.concat(err).toString()))\n            } else {\n                resolve(capper.finish())\n            }\n        })\n    })\n}\n\n// Wraps a git failure as `<prefix>: <cause>`; an abort passes through.\nexport function wrapGitError (\n    prefix:string,\n    err:unknown,\n    signal?:AbortSignal\n):unknown {\n    if (signal?.aborted) return err\n    const msg = err instanceof Error ? err.message : String(err)\n    return new Error(`${prefix}: ${msg}`, { cause:err })\n}\n// Go-compatible string helpers. Each one reproduces a Go standard library\n// behavior that JavaScript's nearest built-in gets subtly wrong, so output\n// matches the Go implementation byte for byte.\n\n// Go unicode.IsSpace: Latin-1 spaces plus the Unicode White_Space set.\n// Unlike JS `\\s`, U+0085 is a space and U+FEFF is not.\nexport function isGoSpace (cp:number):boolean {\n    switch (cp) {\n        case 0x09: case 0x0a: case 0x0b: case 0x0c: case 0x0d:\n        case 0x20: case 0x85: case 0xa0:\n        case 0x1680: case 0x2028: case 0x2029: case 0x202f:\n        case 0x205f: case 0x3000:\n            return true\n    }\n    return cp >= 0x2000 && cp <= 0x200a\n}\n\n// Go strings.TrimSpace.\nexport function goTrimSpace (s:string):string {\n    let start = 0\n    let end = s.length\n    // Every Go space is a single UTF-16 unit, so unit scanning is exact.\n    while (start < end && isGoSpace(s.charCodeAt(start))) start++\n    while (end > start && isGoSpace(s.charCodeAt(end - 1))) end--\n    return s.slice(start, end)\n}\n\n// Go filepath.Ext on a `/`-separated path: the suffix from the last dot in\n// the final element, so `docs/.md` -> `.md` and `file.` -> `.`.\nexport function goExt (path:string):string {\n    for (let i = path.length - 1; i >= 0 && path[i] !== '/'; i--) {\n        if (path[i] === '.') return path.slice(i)\n    }\n    return ''\n}\n\nfunction utf8Len (cp:number):number {\n    if (cp < 0x80) return 1\n    if (cp < 0x800) return 2\n    if (cp < 0x10000) return 3\n    return 4\n}\n\n// The longest prefix of `s` whose UTF-8 encoding fits in `maxBytes`,\n// cut on a code point boundary. A lone surrogate counts as the three\n// bytes of the U+FFFD it encodes to.\nexport function truncateUtf8 (s:string, maxBytes:number):string {\n    let used = 0\n    let end = 0\n    for (const ch of s) {\n        const n = utf8Len(ch.codePointAt(0)!)\n        if (used + n > maxBytes) return s.slice(0, end)\n        used += n\n        end += ch.length\n    }\n    return s\n}\n\n// Go fmt \"%.2f\". Go rounds the exact binary value half to even; toFixed\n// rounds exact ties away from zero. Ties are values where x * 8 is an odd\n// integer (0.125, 0.375, ...).\nexport function formatFixed2 (x:number):string {\n    if (x < 0 || Object.is(x, -0)) return '-' + formatFixed2(-x)\n    const eighths = x * 8\n    if (Number.isInteger(eighths) && eighths % 2 !== 0) {\n        let n = Math.floor(x * 100)\n        if (n % 2 !== 0) n++\n        return (n / 100).toFixed(2)\n    }\n    return x.toFixed(2)\n}\n\n// Orders strings by their UTF-8 bytes (Go string comparison). JS `<`\n// compares UTF-16 units, which puts U+10000 and above before U+E000..FFFF.\nexport function compareBytes (a:string, b:string):number {\n    return Buffer.compare(Buffer.from(a), Buffer.from(b))\n}\n\nconst PRINTABLE = /^[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S}]$/u\n\n// Go unicode.IsPrint: letters, marks, numbers, punctuation, symbols, and\n// the ASCII space only.\nfunction isGoPrint (cp:number):boolean {\n    if (cp === 0x20) return true\n    if (cp >= 0xd800 && cp <= 0xdfff) return false\n    return PRINTABLE.test(String.fromCodePoint(cp))\n}\n\nconst NAMED_ESCAPES:Record<number, string> = {\n    0x07:'\\\\a',\n    0x08:'\\\\b',\n    0x0c:'\\\\f',\n    0x0a:'\\\\n',\n    0x0d:'\\\\r',\n    0x09:'\\\\t',\n    0x0b:'\\\\v',\n}\n\nfunction hex (n:number, width:number):string {\n    return n.toString(16).padStart(width, '0')\n}\n\n// Go strconv.Quote (also fmt %q on a string). A lone surrogate, which Go\n// cannot hold, is quoted as U+FFFD would be if it were not printable:\n// `\\ufffd`.\nexport function goQuote (s:string):string {\n    let out = '\"'\n    for (const ch of s) {\n        const cp = ch.codePointAt(0)!\n        if (cp === 0x22 || cp === 0x5c) {\n            out += '\\\\' + ch\n        } else if (isGoPrint(cp)) {\n            out += ch\n        } else if (NAMED_ESCAPES[cp] !== undefined) {\n            out += NAMED_ESCAPES[cp]\n        } else if (cp < 0x20 || cp === 0x7f) {\n            out += '\\\\x' + hex(cp, 2)\n        } else if (cp >= 0xd800 && cp <= 0xdfff) {\n            out += '\\\\ufffd'\n        } else if (cp < 0x10000) {\n            out += '\\\\u' + hex(cp, 4)\n        } else {\n            out += '\\\\U' + hex(cp, 8)\n        }\n    }\n    return out + '\"'\n}\nimport { test } from '@substrate-system/tapzero'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { execFileSync } from 'node:child_process'\nimport { build, gitPatch } from '../../src/scope/index.js'\nimport { newRepo, tempDir, type TestRepo } from './helpers.js'\n\nconst REAL_GIT = execFileSync('sh', ['-c', 'command -v git'],\n    { encoding:'utf8' }).trim()\n\n// A `git` first on PATH that runs `action` (recording its pid first)\n// when any argument equals `trigger`, and the real git otherwise.\nfunction wrapGit (\n    repo:TestRepo,\n    trigger:string,\n    action:string\n):{ env:NodeJS.ProcessEnv, pidFile:string, dir:string } {\n    const dir = tempDir('roast-wrapgit-')\n    const pidFile = path.join(dir, 'pid')\n    fs.writeFileSync(path.join(dir, 'git'), '#!/bin/sh\\n' +\n        'for a in \"$@\"; do\\n' +\n        `  if [ \"$a\" = \"${trigger}\" ]; then\\n` +\n        `    echo $$ > \"${pidFile}\"\\n` +\n        `    exec ${action}\\n` +\n        '  fi\\n' +\n        'done\\n' +\n        `exec \"${REAL_GIT}\" \"$@\"\\n`, { mode:0o755 })\n    const env = { ...repo.env, PATH:`${dir}:${repo.env.PATH}` }\n    return { env, pidFile, dir }\n}\n\nfunction alive (pid:number):boolean {\n    try {\n        process.kill(pid, 0)\n        return true\n    } catch {\n        return false\n    }\n}\n\nasync function waitFor (file:string):Promise<number> {\n    for (let i = 0; i < 500; i++) {\n        if (fs.existsSync(file)) {\n            const pid = Number(fs.readFileSync(file, 'utf8').trim())\n            if (pid > 0) return pid\n        }\n        await new Promise(resolve => setTimeout(resolve, 10))\n    }\n    throw new Error(`timed out waiting for ${file}`)\n}\n\nasync function rejection (p:Promise<unknown>):Promise<unknown> {\n    try {\n        await p\n    } catch (err) {\n        return err\n    }\n    return undefined\n}\n\ntest('aborting a large gitPatch kills git and rejects with AbortError',\n    async t => {\n        const repo = newRepo()\n        // An endless patch stream.\n        const w = wrapGit(repo, 'diff', 'yes \"+aaaaaaaaaaaaaaaaaaaaaaaa\"')\n        const ac = new AbortController()\n        const p = gitPatch(repo.dir, ['diff'], 1024, {\n            signal:ac.signal,\n            env:w.env,\n        })\n        const pid = await waitFor(w.pidFile)\n        await new Promise(resolve => setTimeout(resolve, 50))\n        ac.abort()\n        const err = await rejection(p)\n        t.ok(err instanceof Error && err.name === 'AbortError',\n            'rejects with an AbortError')\n        t.ok(!alive(pid), 'git was killed')\n        repo.cleanup()\n        fs.rmSync(w.dir, { recursive:true, force:true })\n    })\n// Temporary Git repositories for scope and denylist tests. Each repo gets\n// its own HOME, XDG_CONFIG_HOME and global config file, so the user's Git\n// config never reaches these tests and a test may write hostile config.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { execFileSync } from 'node:child_process'\n\nexport interface TestRepo {\n    dir:string;\n    env:NodeJS.ProcessEnv;\n    // The isolated global config file (GIT_CONFIG_GLOBAL).\n    globalConfig:string;\n    // Runs git in the repo and returns stdout.\n    git (...args:string[]):string;\n    write (rel:string, content:string|Buffer):void;\n    commitAll (msg?:string):void;\n    cleanup ():void;\n}\n\nexport function tempDir (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\nexport function newRepo (opts:{ commit?:boolean } = {}):TestRepo {\n    const home = tempDir('roast-scope-home-')\n    const dir = tempDir('roast-scope-repo-')\n    const globalConfig = path.join(home, 'gitconfig')\n    fs.writeFileSync(globalConfig, '')\n    const env:NodeJS.ProcessEnv = {\n        PATH:process.env.PATH ?? '/usr/bin:/bin',\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        GIT_CONFIG_GLOBAL:globalConfig,\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_AUTHOR_NAME:'test',\n        GIT_AUTHOR_EMAIL:'test@example.com',\n        GIT_COMMITTER_NAME:'test',\n        GIT_COMMITTER_EMAIL:'test@example.com',\n    }\n    const repo:TestRepo = {\n        dir,\n        env,\n        globalConfig,\n        git (...args) {\n            return execFileSync('git', ['-C', dir, ...args], {\n                env,\n                encoding:'utf8',\n                stdio:['ignore', 'pipe', 'pipe'],\n                maxBuffer:Infinity,\n            })\n        },\n        write (rel, content) {\n            const p = path.join(dir, rel)\n            fs.mkdirSync(path.dirname(p), { recursive:true })\n            fs.writeFileSync(p, content)\n        },\n        commitAll (msg = 'commit') {\n            repo.git('add', '-A')\n            repo.git('commit', '-q', '--allow-empty', '-m', msg)\n        },\n        cleanup () {\n            fs.rmSync(dir, { recursive:true, force:true })\n            fs.rmSync(home, { recursive:true, force:true })\n        },\n    }\n    repo.git('init', '-q', '-b', 'main')\n    if (opts.commit !== false) {\n        repo.write('README.md', 'hello\\n')\n        repo.commitAll('initial')\n    }\n    return repo\n}\n\n// Lines of text, n of them, each distinct.\nexport function lines (n:number, prefix = 'line'):string {\n    let out = ''\n    for (let i = 0; i < n; i++) out += `${prefix} ${i}\\n`\n    return out\n}\n\n// Paths named in `diff --git a/P b/P` headers, in order.\nexport function sectionPaths (diff:string):string[] {\n    const out:string[] = []\n    for (const line of diff.split('\\n')) {\n        const m = /^diff --git a\\/(.*) b\\/(.*)$/.exec(line)\n        if (m) out.push(m[2])\n    }\n    return out\n}\n// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\n// The single test entry: imports every test module.\nimport './tooling/buildinfo.js'\nimport './tooling/startup.js'\nimport './tooling/bundle.js'\nimport './tooling/run-import.js'\nimport './tooling/assets.js'\nimport './tooling/test-tap.js'\nimport './tooling/licenses.js'\nimport './tooling/check-package.js'\nimport './textsafe/textsafe.js'\nimport './gocompat/strings.js'\nimport './gocompat/duration.js'\nimport './gocompat/match.js'\nimport './fsutil/atomic.js'\nimport './git/git.js'\nimport './util/pool.js'\nimport './snapshot/denylist.js'\nimport './scope/glob.js'\nimport './scope/patch.js'\nimport './scope/build.js'\nimport './scope/names.js'\nimport './scope/renames.js'\nimport './scope/fit.js'\nimport './scope/staged.js'\nimport './scope/huge.js'\nimport './scope/hardening.js'\nimport './scope/linguist.js'\nimport './scope/abort.js'\nimport './scope/bytes.js'\nimport './cli/errors.js'\nimport './cli/terminal.js'\nimport './cli/env.js'\nimport './cli/run.js'\nimport './cli/process.js'\nimport './cli/log.js'","is_error":false}]},"parent_tool_use_id":null,"session_id":"a2c0557b-d210-43b6-ab70-8720cf7cd94d","uuid":"cb00287f-ba2d-49d4-9360-2ff27ad1b6ad","timestamp":"2026-11-18T19:44:35.141Z","tool_use_result":{"stdout":"// Scope-specific git wrappers on top of the shared runner in src/git/.\n// Only gitPatch spawns git itself: it streams stdout through a\n// SectionCapper so a huge file never sits in memory whole.\nimport { spawn } from 'node:child_process'\nimport { git, gitOk, GitError, type GitRunOpts } from '../git/git.js'\nimport { DIFF_CONFIG } from './constants.js'\nimport { SectionCapper } from './patch.js'\n\nexport { git, gitOk, GitError, type GitRunOpts }\n\n// How long a child gets after SIGTERM before SIGKILL.\nconst KILL_GRACE_MS = 1000\n\n// `DIFF_CONFIG diff <args>`: every diff invocation starts this way.\nexport function diffArgs (...args:readonly string[]):string[] {\n    return [...DIFF_CONFIG, 'diff', ...args]\n}\n\nexport interface PatchResult {\n    out:Buffer;\n    cut:string[];\n}\n\n// Runs a patch-producing git command, cutting each file section at\n// maxSection bytes. A non-zero exit rejects with a GitError; an abort\n// kills git and rejects with the signal's reason.\nexport function gitPatch (\n    repo:string,\n    args:readonly string[],\n    maxSection:number,\n    opts:GitRunOpts = {}\n):Promise<PatchResult> {\n    const { signal } = opts\n    return new Promise((resolve, reject) => {\n        if (signal?.aborted) {\n            reject(signal.reason)\n            return\n        }\n        const env = { ...(opts.env ?? process.env), ...opts.extraEnv }\n        const child = spawn('git', ['-C', repo, ...args], {\n            env,\n            stdio:['ignore', 'pipe', 'pipe'],\n        })\n        const capper = new SectionCapper(maxSection)\n        const err:Buffer[] = []\n        let killTimer:NodeJS.Timeout|undefined\n        let failure:Error|undefined\n\n        function kill ():void {\n            child.kill('SIGTERM')\n            killTimer ??= setTimeout(() => child.kill('SIGKILL'),\n                KILL_GRACE_MS)\n        }\n        signal?.addEventListener('abort', kill, { once:true })\n\n        child.stdout.on('data', (chunk:Buffer) => {\n            if (failure) return\n            try {\n                capper.write(chunk)\n            } catch (e) {\n                failure = e as Error\n                kill()\n            }\n        })\n        child.stdout.on('error', e => {\n            failure ??= e\n            kill()\n        })\n        child.stderr.on('data', (chunk:Buffer) => err.push(chunk))\n        child.on('error', e => { failure ??= e })\n        child.on('close', (code, sig) => {\n            clearTimeout(killTimer)\n            signal?.removeEventListener('abort', kill)\n            if (signal?.aborted) {\n                reject(signal.reason)\n            } else if (failure) {\n                reject(failure)\n            } else if (code !== 0) {\n                reject(new GitError(code, sig,\n                    Buffer.concat(err).toString()))\n            } else {\n                resolve(capper.finish())\n            }\n        })\n    })\n}\n\n// Wraps a git failure as `<prefix>: <cause>`; an abort passes through.\nexport function wrapGitError (\n    prefix:string,\n    err:unknown,\n    signal?:AbortSignal\n):unknown {\n    if (signal?.aborted) return err\n    const msg = err instanceof Error ? err.message : String(err)\n    return new Error(`${prefix}: ${msg}`, { cause:err })\n}\n// Go-compatible string helpers. Each one reproduces a Go standard library\n// behavior that JavaScript's nearest built-in gets subtly wrong, so output\n// matches the Go implementation byte for byte.\n\n// Go unicode.IsSpace: Latin-1 spaces plus the Unicode White_Space set.\n// Unlike JS `\\s`, U+0085 is a space and U+FEFF is not.\nexport function isGoSpace (cp:number):boolean {\n    switch (cp) {\n        case 0x09: case 0x0a: case 0x0b: case 0x0c: case 0x0d:\n        case 0x20: case 0x85: case 0xa0:\n        case 0x1680: case 0x2028: case 0x2029: case 0x202f:\n        case 0x205f: case 0x3000:\n            return true\n    }\n    return cp >= 0x2000 && cp <= 0x200a\n}\n\n// Go strings.TrimSpace.\nexport function goTrimSpace (s:string):string {\n    let start = 0\n    let end = s.length\n    // Every Go space is a single UTF-16 unit, so unit scanning is exact.\n    while (start < end && isGoSpace(s.charCodeAt(start))) start++\n    while (end > start && isGoSpace(s.charCodeAt(end - 1))) end--\n    return s.slice(start, end)\n}\n\n// Go filepath.Ext on a `/`-separated path: the suffix from the last dot in\n// the final element, so `docs/.md` -> `.md` and `file.` -> `.`.\nexport function goExt (path:string):string {\n    for (let i = path.length - 1; i >= 0 && path[i] !== '/'; i--) {\n        if (path[i] === '.') return path.slice(i)\n    }\n    return ''\n}\n\nfunction utf8Len (cp:number):number {\n    if (cp < 0x80) return 1\n    if (cp < 0x800) return 2\n    if (cp < 0x10000) return 3\n    return 4\n}\n\n// The longest prefix of `s` whose UTF-8 encoding fits in `maxBytes`,\n// cut on a code point boundary. A lone surrogate counts as the three\n// bytes of the U+FFFD it encodes to.\nexport function truncateUtf8 (s:string, maxBytes:number):string {\n    let used = 0\n    let end = 0\n    for (const ch of s) {\n        const n = utf8Len(ch.codePointAt(0)!)\n        if (used + n > maxBytes) return s.slice(0, end)\n        used += n\n        end += ch.length\n    }\n    return s\n}\n\n// Go fmt \"%.2f\". Go rounds the exact binary value half to even; toFixed\n// rounds exact ties away from zero. Ties are values where x * 8 is an odd\n// integer (0.125, 0.375, ...).\nexport function formatFixed2 (x:number):string {\n    if (x < 0 || Object.is(x, -0)) return '-' + formatFixed2(-x)\n    const eighths = x * 8\n    if (Number.isInteger(eighths) && eighths % 2 !== 0) {\n        let n = Math.floor(x * 100)\n        if (n % 2 !== 0) n++\n        return (n / 100).toFixed(2)\n    }\n    return x.toFixed(2)\n}\n\n// Orders strings by their UTF-8 bytes (Go string comparison). JS `<`\n// compares UTF-16 units, which puts U+10000 and above before U+E000..FFFF.\nexport function compareBytes (a:string, b:string):number {\n    return Buffer.compare(Buffer.from(a), Buffer.from(b))\n}\n\nconst PRINTABLE = /^[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S}]$/u\n\n// Go unicode.IsPrint: letters, marks, numbers, punctuation, symbols, and\n// the ASCII space only.\nfunction isGoPrint (cp:number):boolean {\n    if (cp === 0x20) return true\n    if (cp >= 0xd800 && cp <= 0xdfff) return false\n    return PRINTABLE.test(String.fromCodePoint(cp))\n}\n\nconst NAMED_ESCAPES:Record<number, string> = {\n    0x07:'\\\\a',\n    0x08:'\\\\b',\n    0x0c:'\\\\f',\n    0x0a:'\\\\n',\n    0x0d:'\\\\r',\n    0x09:'\\\\t',\n    0x0b:'\\\\v',\n}\n\nfunction hex (n:number, width:number):string {\n    return n.toString(16).padStart(width, '0')\n}\n\n// Go strconv.Quote (also fmt %q on a string). A lone surrogate, which Go\n// cannot hold, is quoted as U+FFFD would be if it were not printable:\n// `\\ufffd`.\nexport function goQuote (s:string):string {\n    let out = '\"'\n    for (const ch of s) {\n        const cp = ch.codePointAt(0)!\n        if (cp === 0x22 || cp === 0x5c) {\n            out += '\\\\' + ch\n        } else if (isGoPrint(cp)) {\n            out += ch\n        } else if (NAMED_ESCAPES[cp] !== undefined) {\n            out += NAMED_ESCAPES[cp]\n        } else if (cp < 0x20 || cp === 0x7f) {\n            out += '\\\\x' + hex(cp, 2)\n        } else if (cp >= 0xd800 && cp <= 0xdfff) {\n            out += '\\\\ufffd'\n        } else if (cp < 0x10000) {\n            out += '\\\\u' + hex(cp, 4)\n        } else {\n            out += '\\\\U' + hex(cp, 8)\n        }\n    }\n    return out + '\"'\n}\nimport { test } from '@substrate-system/tapzero'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { execFileSync } from 'node:child_process'\nimport { build, gitPatch } from '../../src/scope/index.js'\nimport { newRepo, tempDir, type TestRepo } from './helpers.js'\n\nconst REAL_GIT = execFileSync('sh', ['-c', 'command -v git'],\n    { encoding:'utf8' }).trim()\n\n// A `git` first on PATH that runs `action` (recording its pid first)\n// when any argument equals `trigger`, and the real git otherwise.\nfunction wrapGit (\n    repo:TestRepo,\n    trigger:string,\n    action:string\n):{ env:NodeJS.ProcessEnv, pidFile:string, dir:string } {\n    const dir = tempDir('roast-wrapgit-')\n    const pidFile = path.join(dir, 'pid')\n    fs.writeFileSync(path.join(dir, 'git'), '#!/bin/sh\\n' +\n        'for a in \"$@\"; do\\n' +\n        `  if [ \"$a\" = \"${trigger}\" ]; then\\n` +\n        `    echo $$ > \"${pidFile}\"\\n` +\n        `    exec ${action}\\n` +\n        '  fi\\n' +\n        'done\\n' +\n        `exec \"${REAL_GIT}\" \"$@\"\\n`, { mode:0o755 })\n    const env = { ...repo.env, PATH:`${dir}:${repo.env.PATH}` }\n    return { env, pidFile, dir }\n}\n\nfunction alive (pid:number):boolean {\n    try {\n        process.kill(pid, 0)\n        return true\n    } catch {\n        return false\n    }\n}\n\nasync function waitFor (file:string):Promise<number> {\n    for (let i = 0; i < 500; i++) {\n        if (fs.existsSync(file)) {\n            const pid = Number(fs.readFileSync(file, 'utf8').trim())\n            if (pid > 0) return pid\n        }\n        await new Promise(resolve => setTimeout(resolve, 10))\n    }\n    throw new Error(`timed out waiting for ${file}`)\n}\n\nasync function rejection (p:Promise<unknown>):Promise<unknown> {\n    try {\n        await p\n    } catch (err) {\n        return err\n    }\n    return undefined\n}\n\ntest('aborting a large gitPatch kills git and rejects with AbortError',\n    async t => {\n        const repo = newRepo()\n        // An endless patch stream.\n        const w = wrapGit(repo, 'diff', 'yes \"+aaaaaaaaaaaaaaaaaaaaaaaa\"')\n        const ac = new AbortController()\n        const p = gitPatch(repo.dir, ['diff'], 1024, {\n            signal:ac.signal,\n            env:w.env,\n        })\n        const pid = await waitFor(w.pidFile)\n        await new Promise(resolve => setTimeout(resolve, 50))\n        ac.abort()\n        const err = await rejection(p)\n        t.ok(err instanceof Error && err.name === 'AbortError',\n            'rejects with an AbortError')\n        t.ok(!alive(pid), 'git was killed')\n        repo.cleanup()\n        fs.rmSync(w.dir, { recursive:true, force:true })\n    })\n// Temporary Git repositories for scope and denylist tests. Each repo gets\n// its own HOME, XDG_CONFIG_HOME and global config file, so the user's Git\n// config never reaches these tests and a test may write hostile config.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { execFileSync } from 'node:child_process'\n\nexport interface TestRepo {\n    dir:string;\n    env:NodeJS.ProcessEnv;\n    // The isolated global config file (GIT_CONFIG_GLOBAL).\n    globalConfig:string;\n    // Runs git in the repo and returns stdout.\n    git (...args:string[]):string;\n    write (rel:string, content:string|Buffer):void;\n    commitAll (msg?:string):void;\n    cleanup ():void;\n}\n\nexport function tempDir (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\nexport function newRepo (opts:{ commit?:boolean } = {}):TestRepo {\n    const home = tempDir('roast-scope-home-')\n    const dir = tempDir('roast-scope-repo-')\n    const globalConfig = path.join(home, 'gitconfig')\n    fs.writeFileSync(globalConfig, '')\n    const env:NodeJS.ProcessEnv = {\n        PATH:process.env.PATH ?? '/usr/bin:/bin',\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        GIT_CONFIG_GLOBAL:globalConfig,\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_AUTHOR_NAME:'test',\n        GIT_AUTHOR_EMAIL:'test@example.com',\n        GIT_COMMITTER_NAME:'test',\n        GIT_COMMITTER_EMAIL:'test@example.com',\n    }\n    const repo:TestRepo = {\n        dir,\n        env,\n        globalConfig,\n        git (...args) {\n            return execFileSync('git', ['-C', dir, ...args], {\n                env,\n                encoding:'utf8',\n                stdio:['ignore', 'pipe', 'pipe'],\n                maxBuffer:Infinity,\n            })\n        },\n        write (rel, content) {\n            const p = path.join(dir, rel)\n            fs.mkdirSync(path.dirname(p), { recursive:true })\n            fs.writeFileSync(p, content)\n        },\n        commitAll (msg = 'commit') {\n            repo.git('add', '-A')\n            repo.git('commit', '-q', '--allow-empty', '-m', msg)\n        },\n        cleanup () {\n            fs.rmSync(dir, { recursive:true, force:true })\n            fs.rmSync(home, { recursive:true, force:true })\n        },\n    }\n    repo.git('init', '-q', '-b', 'main')\n    if (opts.commit !== false) {\n        repo.write('README.md', 'hello\\n')\n        repo.commitAll('initial')\n    }\n    return repo\n}\n\n// Lines of text, n of them, each distinct.\nexport function lines (n:number, prefix = 'line'):string {\n    let out = ''\n    for (let i = 0; i < n; i++) out += `${prefix} ${i}\\n`\n    return out\n}\n\n// Paths named in `diff --git a/P b/P` headers, in order.\nexport function sectionPaths (diff:string):string[] {\n    const out:string[] = []\n    for (const line of diff.split('\\n')) {\n        const m = /^diff --git a\\/(.*) b\\/(.*)$/.exec(line)\n        if (m) out.push(m[2])\n    }\n    return out\n}\n// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\n// The single test entry: imports every test module.\nimport './tooling/buildinfo.js'\nimport './tooling/startup.js'\nimport './tooling/bundle.js'\nimport './tooling/run-import.js'\nimport './tooling/assets.js'\nimport './tooling/test-tap.js'\nimport './tooling/licenses.js'\nimport './tooling/check-package.js'\nimport './textsafe/textsafe.js'\nimport './gocompat/strings.js'\nimport './gocompat/duration.js'\nimport './gocompat/match.js'\nimport './fsutil/atomic.js'\nimport './git/git.js'\nimport './util/pool.js'\nimport './snapshot/denylist.js'\nimport './scope/glob.js'\nimport './scope/patch.js'\nimport './scope/build.js'\nimport './scope/names.js'\nimport './scope/renames.js'\nimport './scope/fit.js'\nimport './scope/staged.js'\nimport './scope/huge.js'\nimport './scope/hardening.js'\nimport './scope/linguist.js'\nimport './scope/abort.js'\nimport './scope/bytes.js'\nimport './cli/errors.js'\nimport './cli/terminal.js'\nimport './cli/env.js'\nimport './cli/run.js'\nimport './cli/process.js'\nimport './cli/log.js'","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013QvdK5KDGrkkVXHxXG8Ff7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
