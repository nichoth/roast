{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016JJudX6UEdQJDk9z8qTKHr","type":"tool_result","content":"// The one git runner. Every area runs git through here; scope and context\n// add their specialized wrappers (patch capping, streaming) on top.\n\nimport { spawn } from 'node:child_process'\n\nexport class GitError extends Error {\n    exitCode:number|null\n    stderr:string\n\n    constructor (exitCode:number|null, signal:string|null, stderr:string) {\n        const status = exitCode === null ?\n            `signal: ${signal}` :\n            `exit status ${exitCode}`\n        const detail = stderr.trim()\n        super(detail ? `${status}: ${detail}` : status)\n        this.name = 'GitError'\n        this.exitCode = exitCode\n        this.stderr = stderr\n    }\n}\n\nexport interface GitRunOpts {\n    // Kills the child on abort; the call rejects with the signal's reason.\n    signal?:AbortSignal;\n    // The environment git runs with, normally the CLI context's env. Only\n    // when absent is process.env used.\n    env?:NodeJS.ProcessEnv;\n    // Variables merged over `env`.\n    extraEnv?:Record<string, string>;\n    // Written to stdin, which is then closed.\n    input?:Buffer|string;\n}\n\n// How long a child gets after SIGTERM before SIGKILL.\nconst KILL_GRACE_MS = 1000\n\ninterface Exit {\n    code:number|null;\n    signal:string|null;\n    stdout:Buffer;\n    stderr:Buffer;\n}\n\nfunction runGit (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts\n):Promise<Exit> {\n    const { signal } = opts\n    return new Promise((resolve, reject) => {\n        if (signal?.aborted) {\n            reject(signal.reason)\n            return\n        }\n        const env = { ...(opts.env ?? process.env), ...opts.extraEnv }\n        const child = spawn('git', ['-C', repo, ...args], {\n            env,\n            stdio:['pipe', 'pipe', 'pipe'],\n        })\n        const out:Buffer[] = []\n        const err:Buffer[] = []\n        let killTimer:NodeJS.Timeout|undefined\n        let spawnError:Error|undefined\n\n        function onAbort ():void {\n            child.kill('SIGTERM')\n            killTimer = setTimeout(() => child.kill('SIGKILL'),\n                KILL_GRACE_MS)\n        }\n        signal?.addEventListener('abort', onAbort, { once:true })\n\n        child.stdout.on('data', (chunk:Buffer) => out.push(chunk))\n        child.stderr.on('data', (chunk:Buffer) => err.push(chunk))\n        child.on('error', e => { spawnError ??= e })\n        // A child that exits without reading stdin closes the pipe; that\n        // EPIPE is not a git failure.\n        child.stdin.on('error', () => {})\n        if (opts.input !== undefined) child.stdin.end(opts.input)\n        else child.stdin.end()\n\n        child.on('close', (code, sig) => {\n            clearTimeout(killTimer)\n            signal?.removeEventListener('abort', onAbort)\n            if (signal?.aborted) {\n                reject(signal.reason)\n            } else if (spawnError) {\n                reject(spawnError)\n            } else {\n                resolve({\n                    code,\n                    signal:sig,\n                    stdout:Buffer.concat(out),\n                    stderr:Buffer.concat(err),\n                })\n            }\n        })\n    })\n}\n\n// Runs `git -C <repo> <args>` and resolves stdout. A non-zero exit\n// rejects with a GitError.\nexport async function git (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<Buffer> {\n    const exit = await runGit(repo, args, opts)\n    if (exit.code !== 0) {\n        throw new GitError(exit.code, exit.signal, exit.stderr.toString())\n    }\n    return exit.stdout\n}\n\n// Exit status only: false on a non-zero exit. Rejects only on abort or\n// when git cannot be started.\nexport async function gitOk (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<boolean> {\n    const exit = await runGit(repo, args, opts)\n    return exit.code === 0\n}\n\n// The repository toplevel containing `start`.\nexport async function gitRoot (\n    start:string,\n    opts:GitRunOpts = {}\n):Promise<string> {\n    let out:Buffer\n    try {\n        out = await git(start, ['rev-parse', '--show-toplevel'], opts)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error('not inside a git repository', { cause:err })\n    }\n    return out.toString().trim()\n}\n// The secret denylist (spec 11, \"Secret denylist\"): untracked paths that\n// are never folded into a review diff, captured into a snapshot, or\n// served from the live working tree.\nimport { goPathMatch } from '../gocompat/match.js'\nimport { git } from '../git/git.js'\nimport { compareBytes, decodePaths } from '../scope/text.js'\n\n// SSH keys match by key-type prefix so suffixed names are covered; a bare\n// `id_*` would also drop ordinary sources such as id_map.go.\nexport const DEFAULT_DENYLIST:readonly string[] = Object.freeze([\n    '.env*', '*.pem', '*_rsa', '*.key', 'creds*',\n    'id_rsa*', 'id_dsa*', 'id_ecdsa*', 'id_ed25519*', 'id_xmss*',\n    'credentials.json', '.npmrc', '.pypirc', '.netrc', '_netrc', '.pgpass',\n    '.git-credentials', '*.p12', '*.pfx',\n])\n\nfunction basename (p:string):string {\n    const i = p.lastIndexOf('/')\n    return i === -1 ? p : p.slice(i + 1)\n}\n\n// Whether a repo-relative `/`-separated path matches any pattern, by its\n// basename or its full path, case-insensitively. A malformed pattern\n// never matches.\nexport function denylisted (\n    path:string,\n    patterns:readonly string[] = DEFAULT_DENYLIST\n):boolean {\n    const full = path.toLowerCase()\n    const base = basename(full)\n    return patterns.some(pattern => {\n        const p = pattern.toLowerCase()\n        return goPathMatch(p, base) || goPathMatch(p, full)\n    })\n}\n\nexport interface DenylistedUntrackedOpts {\n    // Omitted means DEFAULT_DENYLIST; an empty list disables filtering.\n    patterns?:readonly string[];\n    signal?:AbortSignal;\n    env?:NodeJS.ProcessEnv;\n}\n\n// The untracked, non-ignored paths matching the denylist, in byte order.\n// Tracked files are never listed: their content is already in history.\nexport async function denylistedUntracked (\n    repo:string,\n    opts:DenylistedUntrackedOpts = {}\n):Promise<string[]> {\n    const patterns = opts.patterns ?? DEFAULT_DENYLIST\n    if (patterns.length === 0) return []\n    const out = await git(repo,\n        ['ls-files', '--others', '--exclude-standard', '-z'],\n        { signal:opts.signal, env:opts.env })\n    return decodePaths(out).paths\n        .filter(p => p !== '' && denylisted(p, patterns))\n        .sort(compareBytes)\n}\n// Byte-level text helpers for git output (spec 04, 2.15 and 3.4).\nexport { compareBytes } from '../gocompat/strings.js'\n\n// Splits on \"\\n\" and drops empty strings (no trimming).\nexport function nonEmptyLines (s:string):string[] {\n    return s.split('\\n').filter(line => line !== '')\n}\n\n// Splits raw git output on NUL, dropping exactly one trailing empty\n// element. Empty input yields no elements.\nexport function splitNul (buf:Buffer):Buffer[] {\n    const out:Buffer[] = []\n    let start = 0\n    while (start < buf.length) {\n        const nul = buf.indexOf(0, start)\n        if (nul === -1) {\n            out.push(buf.subarray(start))\n            break\n        }\n        out.push(buf.subarray(start, nul))\n        start = nul + 1\n    }\n    return out\n}\n\nexport interface DecodedPaths {\n    paths:string[];\n    // Names that are not valid UTF-8 and were dropped.\n    skipped:number;\n}\n\nconst fatal = new TextDecoder('utf-8', { fatal:true })\n\n// One raw name as a string, or null when it is not valid UTF-8.\nexport function decodeName (raw:Buffer):string|null {\n    try {\n        return fatal.decode(raw)\n    } catch {\n        return null\n    }\n}\n\n// Decodes NUL-separated path names. A name that is 