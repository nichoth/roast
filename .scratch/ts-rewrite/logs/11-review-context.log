renders as an omission notice and the next file is tried.\nexport async function buildFileContext (\n    repo:string,\n    files:readonly string[],\n    budget:number,\n    tree:Tree,\n    opts:ContextOpts = {}\n):Promise<string> {\n    if (files.length === 0) return '(no files)'\n    const chunks:string[] = []\n    let used = 0\n    for (const f of files) {\n        const snippet = await numberedSnippet(repo, f, FILE_SNIPPET_BYTES,\n            tree, opts)\n        const size = Buffer.byteLength(snippet)\n        if (used + size > budget) {\n            chunks.push(`### ${f}\\n(omitted ${EM} context budget exceeded)\\n`)\n            continue\n        }\n        chunks.push(snippet)\n        used += size\n    }\n    return chunks.join('\\n')\n}\n"}}}
