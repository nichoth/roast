nction gitStream (\n    repo:string,\n    args:readonly string[],\n    opts:StreamOpts = {}\n):GitStream {\n    const env = { ...(opts.env ?? process.env), ...opts.extraEnv }\n    const child = spawn('git', ['-C', repo, ...args], {\n        env,\n        stdio:['ignore', 'pipe', 'pipe'],\n    })\n    child.stdout.setEncoding = undefined as never\n    const err:Buffer[] = []\n    let spawnError:Error|undefined\n    let killTimer:NodeJS.Timeout|undefined\n    let exited = false\n\n    function kill ():void {\n        if (exited) return\n        child.kill('SIGTERM')\n        killTimer ??= setTimeout(() => child.kill('SIGKILL'), KILL_GRACE_MS)\n    }\n    const { signal } = opts\n    if (signal?.aborted) kill()\n    else signal?.addEventListener('abort', kill, { once:true })\n\n    child.stderr.on('data', (chunk:Buffer) => err.push(chunk))\n    // A destroyed stdout (consumer stopped iterating) must not crash.\n    child.stdout.on('error', () => {})\n    const done = new Promise<GitStreamExit>(resolve => {\n        child.on('error', e => { spawnError ??= e })\n        child.on('close', code => {\n            exited = true\n            clearTimeout(killTimer)\n            signal?.removeEventListener('abort', kill)\n            resolve({\n                code,\n                stderr:Buffer.concat(err).toString(),\n                error:spawnError,\n            })\n        })\n    })\n    return { stdout:child.stdout, kill, done }\n}\n\nexport interface CappedOutput {\n    // false when git failed and the output was not truncated.\n    ok:boolean;\n    // At most `limit` bytes of stdout.\n    out:Buffer;\n    // stdout held more than `limit` bytes; git was killed.\n    truncated:boolean;\n}\n\n// Reads up to `limit` bytes of stdout, probes for one more, and kills git\n// if more remains. Rejects with the signal's reason on abort.\nexport async function gitCapped (\n    repo:string,\n    args:readonly string[],\n    limit:number,\n    opts:StreamOpts = {}\n):Promise<CappedOutput> {\n    opts.signal?.throwIfAborted()\n    const s = gitStream(repo, args, opts)\n    const chunks:Buffer[] = []\n    let total = 0\n    let truncated = false\n    try {\n        for await (const chunk of s.stdout) {\n            const room = limit - total\n            if (chunk.length > room) {\n                if (room > 0) chunks.push(chunk.subarray(0, room))\n                total = limit\n                truncated = true\n                break\n            }\n            chunks.push(chunk)\n            total += chunk.length\n        }\n    } finally {\n        if (truncated) s.kill()\n    }\n    const exit = await s.done\n    opts.signal?.throwIfAborted()\n    const ok = truncated || (exit.code === 0 && !exit.error)\n    return { ok, out:Buffer.concat(chunks, total), truncated }\n}\n","structuredPatch":[{"oldStart":50,"oldLines":7,"newStart":50,"newLines":6,"lines":["         env,","         stdio:['ignore', 'pipe', 'pipe'],","     })","-    child.stdout.setEncoding = undefined as never","     const err:Buffer[] = []","     let spawnError:Error|undefined","     let killTimer:NodeJS.Timeout|undefined"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01XYojsGhXh1oxpF1DWwttbj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
