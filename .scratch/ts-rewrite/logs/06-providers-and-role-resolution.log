{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AoAHQgw9hREi9tAbUZkgnf","type":"tool_result","content":"//\n// Only the credential comes from outside the config. It is, in order:\n// ROAST_<ROLE>_API_KEY; the profile's api_key_env; the built-in provider's\n// standard key variable (OPENAI_API_KEY, ANTHROPIC_API_KEY, or\n// OPENROUTER_API_KEY); the provider's project-scope stored credential; its\n// user-scope stored credential. The last three apply only when the role is\n// on that provider's built-in endpoint with a protocol it accepts there. A\n// profile with any other endpoint must name its own credential. An\n// unusable credentials file is an error once resolution reaches it.\nfunc (c Config) ResolveRole(name string) (ResolvedRole, error) {\n\tselection, ok := c.Roles[name]\n\tif !ok || selection.Profile == \"\" {\n\t\treturn ResolvedRole{}, fmt.Errorf(\"role %q is not configured\", name)\n\t}\n\treturn c.resolveProfile(name, selection.Profile, selection)\n}\n\nfunc (c Config) resolveProfile(roleName, profileName string, selection Role) (ResolvedRole, error) {\n\tprofile, ok := c.InferenceProfiles[profileName]\n\tif !ok {\n\t\treturn ResolvedRole{}, fmt.Errorf(\"role %s references unknown inference profile %q\", roleName, profileName)\n\t}\n\trole := ResolvedRole{\n\t\tProfile: profileName, BaseURL: profile.Endpoint(), ExplicitEndpoint: profile.BaseURL != \"\",\n\t\tModel: profile.Model, Protocol: profile.Protocol, MaxOutputTokens: profile.MaxOutputTokens,\n\t\tSessionHeader: profile.SessionHeader, Pin: selection.Pin, AuthorRoutes: selection.AuthorRoutes,\n\t\tstored: c.stored,\n\t}\n\tvar err error\n\trole.APIKey, role.Credential, err = resolveCredential(roleName, profile, role)\n\tif err != nil {\n\t\treturn ResolvedRole{}, fmt.Errorf(\"role %s: %w\", roleName, err)\n\t}\n\treturn role, nil\n}\n\n// resolveCredential selects the role's credential: from the environment,\n// then from stored credentials.\nfunc resolveCredential(roleName string, profile InferenceProfile, role ResolvedRole) (string, CredentialSource, error) {\n\troleVar := roleEnvPrefix(roleName) + \"API_KEY\"\n\tif value := os.Getenv(roleVar); value != \"\" {\n\t\treturn value, CredentialSource{Kind: CredentialRoleEnv, Env: roleVar}, nil\n\t}\n\tif profile.APIKeyEnv != \"\" {\n\t\tsource := CredentialSource{Kind: CredentialProfileEnv, Env: profile.APIKeyEnv}\n\t\tif value := os.Getenv(profile.APIKeyEnv); value != \"\" {\n\t\t\treturn value, source, nil\n\t\t}\n\t\t// When that variable is empty, a role on a built-in provider's\n\t\t// endpoint falls back to the provider's standard variable, then its\n\t\t// stored key, as rebindCredential does after an override.\n\t\tvalue, ambient, err := ambientCredential(role.Protocol, role.BaseURL, role.stored)\n\t\tif err != nil || value == \"\" {\n\t\t\treturn \"\", source, err\n\t\t}\n\t\treturn value, ambient, nil\n\t}\n\treturn ambientCredential(role.Protocol, role.BaseURL, role.stored)\n}\n\n// ambientCredential returns a built-in provider's standard key, else its\n// stored key, only when the role is on that provider's endpoint with a\n// protocol it accepts there. Any provider's key that is set but not sent is\n// reported as withheld.\nfunc ambientCredential(protocol, endpoint string, stored StoredCredentials) (string, CredentialSource, error) {\n\tif provider, ok := ProviderAt(endpoint, protocol); ok {\n\t\tif value := os.Getenv(provider.KeyEnv); value != \"\" {\n\t\t\treturn value, CredentialSource{\n\t\t\t\tKind: CredentialProviderEnv, Env: provider.KeyEnv,\n\t\t\t}, nil\n\t\t}\n\t\tkey, source, err := storedCredential(stored, protocol, endpoint)\n\t\tif err != nil || key != \"\" {\n\t\t\treturn key, source, err\n\t\t}\n\t}\n\treturn \"\", CredentialSource{\n\t\tKind: CredentialNone, Withheld: withheldKey(protocol),\n\t}, nil\n}\n\n// withheldKey names a set standard key variable of a built-in provider,\n// preferring the provider at protocol's default endpoint, or \"\" when none\n// is set. ambientCredential calls it only after sending no key, so any\n// variable it names was withheld.\nfunc withheldKey(protocol string) string {\n\tcandidates := []string{providerAPIKeyEnv(protocol)}\n\tfor _, provider := range builtinProviders {\n\t\tcandidates = append(candidates, provider.KeyEnv)\n\t}\n\tfor _, keyVar := range candidates {\n\t\tif keyVar != \"\" && os.Getenv(keyVar) != \"\" {\n\t\t\treturn keyVar\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// storedCredential returns the stored key of the built-in provider at\n// endpoint and protocol. The registry alone decides the provider, so a\n// custom endpoint never receives a stored key.\nfunc storedCredential(stored StoredCredentials, protocol, endpoint string) (string, CredentialSource, error) {\n\tnone := CredentialSource{Kind: CredentialNone}\n\tprovider, ok := ProviderAt(endpoint, protocol)\n\tif !ok || stored == nil {\n\t\treturn \"\", none, nil\n\t}\n\tkey, scope, err := stored.Lookup(provider.Name)\n\tif err != nil || key == \"\" {\n\t\treturn \"\", none, err\n\t}\n\treturn key, CredentialSource{\n\t\tKind: CredentialStored, Provider: provider.Name, Scope: scope,\n\t}, nil\n}\n\n// applyEndpointOverrides applies a role's protocol and endpoint overrides, in\n// that order, and reports whether the protocol override moved the role from\n// one provider's endpoint to another's. An implicit endpoint follows the new\n// protocol to its default; an explicit endpoint moves only\n// when it is the previous protocol's public default. An endpoint override\n// makes the endpoint explicit, so the role is no longer on a provider's\n// endpoint that it did not choose.\nfunc applyEndpointOverrides(role *ResolvedRole, baseURL, protocol *string) bool {\n\tcrossedProvider := false\n\tif protocol != nil {\n\t\tprevious := DefaultBaseURL(role.Protocol)\n\t\trole.Protocol = *protocol\n\t\tif next := DefaultBaseURL(*protocol); next != previous {\n\t\t\tswitch {\n\t\t\tcase !role.ExplicitEndpoint:\n\t\t\t\trole.BaseURL = next\n\t\t\t\tcrossedProvider = true\n\t\t\tcase sameEndpoint(role.BaseURL, previous):\n\t\t\t\trole.BaseURL = next\n\t\t\t\tcrossedProvider = true\n\t\t\t}\n\t\t}\n\t}\n\tif baseURL != nil {\n\t\trole.BaseURL, role.ExplicitEndpoint = *baseURL, true\n\t\tcrossedProvider = false\n\t}\n\treturn crossedProvider\n}\n\n// OverrideEndpoint applies command-line endpoint and protocol overrides\n// (--<role>-base-url and --<role>-protocol), then re-resolves the credential.\n// A nil override is unset. It fails only when a stored credential the role\n// now needs cannot be read.\nfunc OverrideEndpoint(roleName string, role ResolvedRole, baseURL, protocol *string) (ResolvedRole, error) {\n\treturn rebindCredential(roleName, role, applyEndpointOverrides(&role, baseURL, protocol))\n}\n\n// rebindCredential re-resolves a role's credential after its endpoint or\n// protocol changed. A role-scoped key or the profile's own credential follows\n// an explicit endpoint override. An ambient provider key or a stored key is\n// checked again against the new endpoint and protocol. When crossedProvider\n// is true, the profile's credential stays with the provider it was\n// configured for.\nfunc rebindCredential(roleName string, role ResolvedRole, crossedProvider bool) (ResolvedRole, error) {\n\tswitch role.Credential.Kind {\n\tcase CredentialRoleEnv:\n\t\treturn role, nil\n\tcase CredentialProfileEnv:\n\t\tif !crossedProvider {\n\t\t\treturn role, nil\n\t\t}\n\t}\n\tif value := os.Getenv(roleEnvPrefix(roleName) + \"API_KEY\"); value != \"\" {\n\t\trole.APIKey, role.Credential = value, CredentialSource{Kind: CredentialRoleEnv, Env: roleEnvPrefix(roleName) + \"API_KEY\"}\n\t\treturn role, nil\n\t}\n\tvar err error\n\trole.APIKey, role.Credential, err = ambientCredential(role.Protocol, role.BaseURL, role.stored)\n\tif err != nil {\n\t\treturn ResolvedRole{}, fmt.Errorf(\"role %s: %w\", roleName, err)\n\t}\n\treturn role, nil\n}\n\nfunc roleEnvPrefix(roleName string) string {\n\treturn \"ROAST_\" + strings.ToUpper(roleName) + \"_\"\n}\n\n// providerAPIKeyEnv returns the standard key variable of the built-in\n// provider at protocol's default endpoint.\nfunc providerAPIKeyEnv(protocol string) string {\n\tfor _, provider := range builtinProviders {\n\t\tif sameEndpoint(provider.Endpoint, DefaultBaseURL(protocol)) {\n\t\t\treturn provider.KeyEnv\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// sameEndpoint compares endpoints by scheme, host, path without trailing\n// slashes, and query. Unparseable values never match.\nfunc sameEndpoint(a, b string) bool {\n\tleft, errLeft := url.Parse(strings.TrimSpace(a))\n\tright, errRight := url.Parse(strings.TrimSpace(b))\n\tif errLeft != nil || errRight != nil || left.Host == \"\" || right.Host == \"\" {\n\t\treturn false\n\t}\n\treturn strings.EqualFold(left.Scheme, right.Scheme) && strings.EqualFold(left.Host, right.Host) &&\n\t\tstrings.TrimRight(left.Path, \"/\") == strings.TrimRight(right.Path, \"/\") &&\n\t\tleft.RawQuery == right.RawQuery && left.User.String() == right.User.String()\n}\n\n// InferFamily returns a provider-neutral model family when one can be\n// determined from either a bare family or a common provider/model spelling.\nfunc InferFamily(model string) string {\n\tm := strings.ToLower(strings.TrimSpace(model))\n\tif m == \"\" {\n\t\treturn \"\"\n\t}\n\tif before, after, ok := strings.Cut(m, \"/\"); ok {\n\t\tswitch before {\n\t\tcase \"anthropic\", \"openai\", \"google\", \"gemini\", \"mistral\", \"xai\", \"cohere\", \"deepseek\":\n\t\t\treturn canonicalFamily(before)\n\t\t}\n\t\tm = after\n\t}\n\tm = strings.TrimSuffix(strings.TrimSuffix(m, \":api\"), \"[1m]\")\n\tswitch {\n\tcase m == \"anthropic\" || strings.HasPrefix(m, \"claude-\"):\n\t\treturn \"anthropic\"\n\tcase m == \"openai\" || strings.HasPrefix(m, \"gpt-\") || strings.HasPrefix(m, \"codex-\") || strings.HasPrefix(m, \"chatgpt-\") || strings.HasPrefix(m, \"o1\") || strings.HasPrefix(m, \"o3\") || strings.HasPrefix(m, \"o4\"):\n\t\treturn \"openai\"\n\tcase m == \"google\" || m == \"gemini\" || strings.HasPrefix(m, \"gemini-\"):\n\t\treturn \"google\"\n\tcase m == \"mistral\" || strings.HasPrefix(m, \"mistral-\") || strings.HasPrefix(m, \"codestral-\"):\n\t\treturn \"mistral\"\n\tcase m == \"xai\" || strings.HasPrefix(m, \"grok-\"):\n\t\treturn \"xai\"\n\tcase m == \"cohere\" || strings.HasPrefix(m, \"command-\"):\n\t\treturn \"cohere\"\n\tcase m == \"deepseek\" || strings.HasPrefix(m, \"deepseek-\"):\n\t\treturn \"deepseek\"\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\nfunc canonicalFamily(family string) string {\n\tif family == \"gemini\" {\n\t\treturn \"google\"\n\t}\n\treturn family\n}\n\n// FlipResult describes author-aware finder selection.\ntype FlipResult struct {\n\tRole ResolvedRole\n\tNote string\n\tWarn string\n}\n\n// ResolveFinderFlip keeps finder generation independent from the author when\n// the configured finder supplies a route for the author's model family.\nfunc (c Config) ResolveFinderFlip(finder ResolvedRole, authorModel string) (FlipResult, error) {\n\tresult := FlipResult{Role: finder}\n\tauthorKey := strings.ToLower(strings.TrimSpace(authorModel))\n\tif authorKey == \"\" {\n\t\treturn result, nil\n\t}\n\tauthorFamily := InferFamily(authorModel)\n\tif finder.Pin {\n\t\tif authorFamily != \"\" && InferFamily(finder.Model) == authorFamily {\n\t\t\tresult.Warn = fmt.Sprintf(\"author-model %s shares the finder family %s, but the finder is pinned; generation independence is reduced\", authorModel, authorFamily)\n\t\t}\n\t\treturn result, nil\n\t}\n\ttargetName := finder.AuthorRoutes[authorKey]\n\tif targetName == \"\" && authorFamily != \"\" {\n\t\ttargetName = finder.AuthorRoutes[authorFamily]\n\t}\n\tif targetName == \"\" {\n\t\tif authorFamily == \"\" {\n\t\t\tresult.Warn = fmt.Sprintf(\"could not determine a model family for author-model %q and no exact author route is configured; keeping finder %s\", authorModel, finder.Model)\n\t\t} else if InferFamily(finder.Model) == authorFamily {\n\t\t\tresult.Warn = fmt.Sprintf(\"author-model %s shares the finder family %s and no author route is configured; generation independence is reduced\", authorModel, authorFamily)\n\t\t}\n\t\treturn result, nil\n\t}\n\tresolved, err := c.resolveProfile(\"finder\", targetName, Role{})\n\tif err != nil {\n\t\treturn result, err\n\t}\n\ttargetFamily := InferFamily(resolved.Model)\n\tif (authorFamily != \"\" && (targetFamily == \"\" || targetFamily == authorFamily)) || strings.EqualFold(resolved.Model, authorModel) {\n\t\tresult.Warn = fmt.Sprintf(\"author-model %s shares the finder family %s and profile %q uses non-independent model %q; keeping finder %s\", authorModel, authorFamily, targetName, resolved.Model, finder.Model)\n\t\treturn result, nil\n\t}\n\tresult.Role = resolved\n\tif authorFamily == \"\" {\n\t\tresult.Note = fmt.Sprintf(\"author-model %s matched an exact route; using finder profile %s (%s)\", authorModel, targetName, resolved.Model)\n\t} else {\n\t\tresult.Note = fmt.Sprintf(\"author-model %s maps to family %s; using finder profile %s (%s)\", authorModel, authorFamily, targetName, resolved.Model)\n\t}\n\treturn result, nil\n}\n\n// ValidateRole checks one fully-resolved role before any model call.\nfunc ValidateRole(name string, role ResolvedRole) error {\n\tif strings.TrimSpace(role.Model) == \"\" {\n\t\treturn fmt.Errorf(\"%s model is not configured (set inference_profiles.%s.model or --%s-model)\", name, role.Profile, name)\n\t}\n\tif IsPlaceholderModel(role.Model) {\n\t\treturn fmt.Errorf(\"%s model %s is a placeholder: set \"+\n\t\t\t\"inference_profiles.%s.model in the project config to a \"+\n\t\t\t\"model ID, or pass --%s-model\", name, role.Model,\n\t\t\trole.Profile, name)\n\t}\n\tif strings.TrimSpace(role.APIKey) == \"\" {\n\t\troleVar := roleEnvPrefix(name) + \"API_KEY\"\n\t\tprovider, builtin := ProviderAt(role.BaseURL, role.Protocol)\n\t\tswitch {\n\t\tcase builtin && role.Credential.Kind == CredentialProfileEnv:\n\t\t\treturn fmt.Errorf(\"%s API key is not configured (run `npx roast login %s`, or set %s, named by inference_profiles.%s.api_key_env, or %s)\", name, provider.Name, role.Credential.Env, role.Profile, roleVar)\n\t\tcase builtin:\n\t\t\treturn fmt.Errorf(\"%s API key is not configured (run `npx roast login %s`, or set %s or %s)\", name, provider.Name, provider.KeyEnv, roleVar)\n\t\tcase role.Credential.Kind == CredentialProfileEnv:\n\t\t\treturn fmt.Errorf(\"%s API key is not configured (set %s, named by inference_profiles.%s.api_key_env, or %s)\", name, role.Credential.Env, role.Profile, roleVar)\n\t\tcase role.Credential.Withheld != \"\":\n\t\t\treturn fmt.Errorf(\"%s API key is not configured: %s is not sent to %s because it is not that provider's default endpoint (set inference_profiles.%s.api_key_env or %s)\",\n\t\t\t\tname, role.Credential.Withheld, role.BaseURL, role.Profile, roleVar)\n\t\t}\n\t\treturn fmt.Errorf(\"%s API key is not configured (set inference_profiles.%s.api_key_env or %s)\", name, role.Profile, roleVar)\n\t}\n\treturn validateEndpoint(name, role.BaseURL, role.Protocol, role.MaxOutputTokens)\n}\n\nfunc validateEndpoint(name, baseURL, protocol string, maxOutputTokens int) error {\n\tu, err := url.Parse(baseURL)\n\tif err != nil || (u.Scheme != \"http\" && u.Scheme != \"https\") || u.Host == \"\" || u.User != nil || u.RawQuery != \"\" || u.Fragment != \"\" {\n\t\treturn fmt.Errorf(\"%s endpoint must be an http(s) URL without credentials, a query, or a fragment\", name)\n\t}\n\tswitch protocol {\n\tcase \"chat\", \"responses\", \"anthropic\":\n\tdefault:\n\t\treturn fmt.Errorf(\"%s protocol must be chat, responses, or anthropic\", name)\n\t}\n\tif maxOutputTokens <= 0 {\n\t\treturn fmt.Errorf(\"%s max_output_tokens must be positive\", name)\n\t}\n\treturn nil\n}\n34:func (p BuiltinProvider) Accepts(protocol string) bool {\n72:func BuiltinProviders() []BuiltinProvider {\n82:func LookupProvider(name string) (BuiltinProvider, bool) {\n93:func ProviderAt(endpoint, protocol string) (BuiltinProvider, bool) {","is_error":false}]},"parent_tool_use_id":null,"session_id":"682f1424-ed5e-4ad8-82df-9c53c97a2745","uuid":"b6e460b4-066d-4748-89c1-8bf8e0c146e0","timestamp":"2026-11-18T20:10:08.129Z","tool_use_result":{"stdout":"//\n// Only the credential comes from outside the config. It is, in order:\n// ROAST_<ROLE>_API_KEY; the profile's api_key_env; the built-in provider's\n// standard key variable (OPENAI_API_KEY, ANTHROPIC_API_KEY, or\n// OPENROUTER_API_KEY); the provider's project-scope stored credential; its\n// user-scope stored credential. The last three apply only when the role is\n// on that provider's built-in endpoint with a protocol it accepts there. A\n// profile with any other endpoint must name its own credential. An\n// unusable credentials file is an error once resolution reaches it.\nfunc (c Config) ResolveRole(name string) (ResolvedRole, error) {\n\tselection, ok := c.Roles[name]\n\tif !ok || selection.Profile == \"\" {\n\t\treturn ResolvedRole{}, fmt.Errorf(\"role %q is not configured\", name)\n\t}\n\treturn c.resolveProfile(name, selection.Profile, selection)\n}\n\nfunc (c Config) resolveProfile(roleName, profileName string, selection Role) (ResolvedRole, error) {\n\tprofile, ok := c.InferenceProfiles[profileName]\n\tif !ok {\n\t\treturn ResolvedRole{}, fmt.Errorf(\"role %s references unknown inference profile %q\", roleName, profileName)\n\t}\n\trole := ResolvedRole{\n\t\tProfile: profileName, BaseURL: profile.Endpoint(), ExplicitEndpoint: profile.BaseURL != \"\",\n\t\tModel: profile.Model, Protocol: profile.Protocol, MaxOutputTokens: profile.MaxOutputTokens,\n\t\tSessionHeader: profile.SessionHeader, Pin: selection.Pin, AuthorRoutes: selection.AuthorRoutes,\n\t\tstored: c.stored,\n\t}\n\tvar err error\n\trole.APIKey, role.Credential, err = resolveCredential(roleName, profile, role)\n\tif err != nil {\n\t\treturn ResolvedRole{}, fmt.Errorf(\"role %s: %w\", roleName, err)\n\t}\n\treturn role, nil\n}\n\n// resolveCredential selects the role's credential: from the environment,\n// then from stored credentials.\nfunc resolveCredential(roleName string, profile InferenceProfile, role ResolvedRole) (string, CredentialSource, error) {\n\troleVar := roleEnvPrefix(roleName) + \"API_KEY\"\n\tif value := os.Getenv(roleVar); value != \"\" {\n\t\treturn value, CredentialSource{Kind: CredentialRoleEnv, Env: roleVar}, nil\n\t}\n\tif profile.APIKeyEnv != \"\" {\n\t\tsource := CredentialSource{Kind: CredentialProfileEnv, Env: profile.APIKeyEnv}\n\t\tif value := os.Getenv(profile.APIKeyEnv); value != \"\" {\n\t\t\treturn value, source, nil\n\t\t}\n\t\t// When that variable is empty, a role on a built-in provider's\n\t\t// endpoint falls back to the provider's standard variable, then its\n\t\t// stored key, as rebindCredential does after an override.\n\t\tvalue, ambient, err := ambientCredential(role.Protocol, role.BaseURL, role.stored)\n\t\tif err != nil || value == \"\" {\n\t\t\treturn \"\", source, err\n\t\t}\n\t\treturn value, ambient, nil\n\t}\n\treturn ambientCredential(role.Protocol, role.BaseURL, role.stored)\n}\n\n// ambientCredential returns a built-in provider's standard key, else its\n// stored key, only when the role is on that provider's endpoint with a\n// protocol it accepts there. Any provider's key that is set but not sent is\n// reported as withheld.\nfunc ambientCredential(protocol, endpoint string, stored StoredCredentials) (string, CredentialSource, error) {\n\tif provider, ok := ProviderAt(endpoint, protocol); ok {\n\t\tif value := os.Getenv(provider.KeyEnv); value != \"\" {\n\t\t\treturn value, CredentialSource{\n\t\t\t\tKind: CredentialProviderEnv, Env: provider.KeyEnv,\n\t\t\t}, nil\n\t\t}\n\t\tkey, source, err := storedCredential(stored, protocol, endpoint)\n\t\tif err != nil || key != \"\" {\n\t\t\treturn key, source, err\n\t\t}\n\t}\n\treturn \"\", CredentialSource{\n\t\tKind: CredentialNone, Withheld: withheldKey(protocol),\n\t}, nil\n}\n\n// withheldKey names a set standard key variable of a built-in provider,\n// preferring the provider at protocol's default endpoint, or \"\" when none\n// is set. ambientCredential calls it only after sending no key, so any\n// variable it names was withheld.\nfunc withheldKey(protocol string) string {\n\tcandidates := []string{providerAPIKeyEnv(protocol)}\n\tfor _, provider := range builtinProviders {\n\t\tcandidates = append(candidates, provider.KeyEnv)\n\t}\n\tfor _, keyVar := range candidates {\n\t\tif keyVar != \"\" && os.Getenv(keyVar) != \"\" {\n\t\t\treturn keyVar\n\t\t}\n\t}\n\treturn \"\"\n}\n\n// storedCredential returns the stored key of the built-in provider at\n// endpoint and protocol. The registry alone decides the provider, so a\n// custom endpoint never receives a stored key.\nfunc storedCredential(stored StoredCredentials, protocol, endpoint string) (string, CredentialSource, error) {\n\tnone := CredentialSource{Kind: CredentialNone}\n\tprovider, ok := ProviderAt(endpoint, protocol)\n\tif !ok || stored == nil {\n\t\treturn \"\", none, nil\n\t}\n\tkey, scope, err := stored.Lookup(provider.Name)\n\tif err != nil || key == \"\" {\n\t\treturn \"\", none, err\n\t}\n\treturn key, CredentialSource{\n\t\tKind: CredentialStored, Provider: provider.Name, Scope: scope,\n\t}, nil\n}\n\n// applyEndpointOverrides applies a role's protocol and endpoint overrides, in\n// that order, and reports whether the protocol override moved the role from\n// one provider's endpoint to another's. An implicit endpoint follows the new\n// protocol to its default; an explicit endpoint moves only\n// when it is the previous protocol's public default. An endpoint override\n// makes the endpoint explicit, so the role is no longer on a provider's\n// endpoint that it did not choose.\nfunc applyEndpointOverrides(role *ResolvedRole, baseURL, protocol *string) bool {\n\tcrossedProvider := false\n\tif protocol != nil {\n\t\tprevious := DefaultBaseURL(role.Protocol)\n\t\trole.Protocol = *protocol\n\t\tif next := DefaultBaseURL(*protocol); next != previous {\n\t\t\tswitch {\n\t\t\tcase !role.ExplicitEndpoint:\n\t\t\t\trole.BaseURL = next\n\t\t\t\tcrossedProvider = true\n\t\t\tcase sameEndpoint(role.BaseURL, previous):\n\t\t\t\trole.BaseURL = next\n\t\t\t\tcrossedProvider = true\n\t\t\t}\n\t\t}\n\t}\n\tif baseURL != nil {\n\t\trole.BaseURL, role.ExplicitEndpoint = *baseURL, true\n\t\tcrossedProvider = false\n\t}\n\treturn crossedProvider\n}\n\n// OverrideEndpoint applies command-line endpoint and protocol overrides\n// (--<role>-base-url and --<role>-protocol), then re-resolves the credential.\n// A nil override is unset. It fails only when a stored credential the role\n// now needs cannot be read.\nfunc OverrideEndpoint(roleName string, role ResolvedRole, baseURL, protocol *string) (ResolvedRole, error) {\n\treturn rebindCredential(roleName, role, applyEndpointOverrides(&role, baseURL, protocol))\n}\n\n// rebindCredential re-resolves a role's credential after its endpoint or\n// protocol changed. A role-scoped key or the profile's own credential follows\n// an explicit endpoint override. An ambient provider key or a stored key is\n// checked again against the new endpoint and protocol. When crossedProvider\n// is true, the profile's credential stays with the provider it was\n// configured for.\nfunc rebindCredential(roleName string, role ResolvedRole, crossedProvider bool) (ResolvedRole, error) {\n\tswitch role.Credential.Kind {\n\tcase CredentialRoleEnv:\n\t\treturn role, nil\n\tcase CredentialProfileEnv:\n\t\tif !crossedProvider {\n\t\t\treturn role, nil\n\t\t}\n\t}\n\tif value := os.Getenv(roleEnvPrefix(roleName) + \"API_KEY\"); value != \"\" {\n\t\trole.APIKey, role.Credential = value, CredentialSource{Kind: CredentialRoleEnv, Env: roleEnvPrefix(roleName) + \"API_KEY\"}\n\t\treturn role, nil\n\t}\n\tvar err error\n\trole.APIKey, role.Credential, err = ambientCredential(role.Protocol, role.BaseURL, role.stored)\n\tif err != nil {\n\t\treturn ResolvedRole{}, fmt.Errorf(\"role %s: %w\