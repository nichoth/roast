: anthropic,\n\t\t\tstore: &fakeStore{user: map[string]string{\n\t\t\t\t\"anthropic\": \"user-anthropic\"}},\n\t\t\twantKey: \"user-anthropic\",\n\t\t},\n\t\t\"another provider's stored key is not used\": {\n\t\t\tprofile: anthropic,\n\t\t\tstore: &fakeStore{project: map[string]string{\n\t\t\t\t\"openai\": \"project-openai\"}},\n\t\t\twantKey: \"\",\n\t\t},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tclearProviderEnv(t)\n\t\t\tfor key, value := range test.env {\n\t\t\t\tt.Setenv(key, value)\n\t\t\t}\n\t\t\trole, err := resolveStored(t, test.profile, test.store)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif role.APIKey != test.wantKey {\n\t\t\t\tt.Fatalf(\"key = %q from %+v, want %q\", role.APIKey,\n\t\t\t\t\trole.Credential, test.wantKey)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestStoredCredentialNeverReachesACustomEndpoint(t *testing.T) {\n\tfor _, protocol := range []string{\"responses\", \"chat\", \"anthropic\"} {\n\t\tt.Run(protocol, func(t *testing.T) {\n\t\t\tclearProviderEnv(t)\n\t\t\tstore := bothStored()\n\t\t\trole, err := resolveStored(t, \"    model: m\\n    protocol: \"+\n\t\t\t\tprotocol+\"\\n    endpoint: \"+customEndpoint+\"\\n\", store)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif role.APIKey != \"\" {\n\t\t\t\tt.Fatalf(\"custom endpoint got %q\", role.APIKey)\n\t\t\t}\n\t\t\tif len(store.lookups) != 0 {\n\t\t\t\tt.Fatalf(\"custom endpoint looked up %v\", store.lookups)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestStoredCredentialDoesNotFollowAnOverride(t *testing.T) {\n\tanthropicOnly := func() *fakeStore {\n\t\treturn &fakeStore{project: map[string]string{\n\t\t\t\"anthropic\": \"project-anthropic\"}}\n\t}\n\tfor name, test := range map[string]struct {\n\t\tprofile  string\n\t\tstore    *fakeStore\n\t\tprotocol string\n\t\tbaseURL  string\n\t\twantKey  string\n\t}{\n\t\t\"endpoint override to a custom endpoint\": {\n\t\t\tprofile: \"    model: m\\n    protocol: anthropic\\n\",\n\t\t\tstore:   anthropicOnly(), baseURL: customEndpoint,\n\t\t},\n\t\t\"protocol override moves an implicit endpoint\": {\n\t\t\tprofile: \"    model: m\\n    protocol: anthropic\\n\",\n\t\t\tstore:   anthropicOnly(), protocol: \"responses\",\n\t\t},\n\t\t\"protocol override moves an explicit default endpoint\": {\n\t\t\tprofile: \"    model: m\\n    protocol: anthropic\\n\" +\n\t\t\t\t\"    endpoint: \" + DefaultBaseURL(\"anthropic\") + \"\\n\",\n\t\t\tstore: anthropicOnly(), protocol: \"chat\",\n\t\t},\n\t\t\"the new provider's own stored key applies\": {\n\t\t\tprofile: \"    model: m\\n    protocol: anthropic\\n\",\n\t\t\tstore:   bothStored(), protocol: \"responses\",\n\t\t\twantKey: \"project-openai\",\n\t\t},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tclearProviderEnv(t)\n\t\t\trole, err := resolveStored(t, test.profile, test.store)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tvar baseURL, protocol *string\n\t\t\tif test.baseURL != \"\" {\n\t\t\t\tbaseURL = &test.baseURL\n\t\t\t}\n\t\t\tif test.protocol != \"\" {\n\t\t\t\tprotocol = &test.protocol\n\t\t\t}\n\t\t\trole, err = OverrideEndpoint(\"finder\", role, baseURL, protocol)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif role.APIKey != test.wantKey {\n\t\t\t\tt.Fatalf(\"key = %q from %+v, want %q\", role.APIKey,\n\t\t\t\t\trole.Credential, test.wantKey)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestUnusableStoredCredentialsFailResolution(t *testing.T) {\n\tclearProviderEnv(t)\n\tstore := &fakeStore{err: errors.New(\"credentials file is readable\")}\n\tif _, err := resolveStored(t, \"    model: m\\n    protocol: anthropic\\n\",\n\t\tstore); err == nil {\n\t\tt.Fatal(\"an unusable credentials file was skipped\")\n\t}\n\t// An environment credential never needs the file.\n\tt.Setenv(\"ANTHROPIC_API_KEY\", \"ambient\")\n\tif _, err := resolveStored(t, \"    model: m\\n    protocol: anthropic\\n\",\n\t\tstore); err != nil {\n\t\tt.Fatalf(\"env credential still read the file: %v\", err)\n\t}\n}\n\nfunc TestStoredCredentialSourceNamesScopeNotSecret(t *testing.T) {\n\tclearProviderEnv(t)\n\tfor scope, store := range map[string]*fakeStore{\n\t\t\"project\": {project: map[string]string{\"anthropic\": \"secret-p\"}},\n\t\t\"user\":    {user: map[string]string{\"anthropic\": \"secret-u\"}},\n\t} {\n\t\trole, err := resolveStored(t, \"    model: m\\n    protocol: anthropic\\n\",\n\t\t\tstore)\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tgot := role.Credential.String()\n\t\tif !strings.Contains(got, scope) || strings.Contains(got, \"secret\") {\n\t\t\tt.Fatalf(\"%s source = %q\", scope, got)\n\t\t}\n\t}\n}\n\nfunc TestMissingCredentialOnABuiltinProviderSuggestsLogin(t *testing.T) {\n\tclearProviderEnv(t)\n\trole, err := resolveStored(t, \"    model: m\\n    protocol: anthropic\\n\",\n\t\t&fakeStore{})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\terr = ValidateRole(\"finder\", role)\n\tif err == nil || !strings.Contains(err.Error(),\n\t\t\"npx roast login anthropic\") {\n\t\tt.Fatalf(\"validate = %v\", err)\n\t}\n\tprofile := InferenceProfile{Model: \"m\", Protocol: \"anthropic\"}\n\tif got := profile.DescribeCredential(\"finder\"); !strings.Contains(got,\n\t\t\"npx roast login anthropic\") {\n\t\tt.Fatalf(\"describe = %q\", got)\n\t}\n\tcustom := InferenceProfile{Model: \"m\", Protocol: \"chat\",\n\t\tBaseURL: customEndpoint}\n\tif got := custom.DescribeCredential(\"finder\"); strings.Contains(got,\n\t\t\"login\") {\n\t\tt.Fatalf(\"custom endpoint describe = %q\", got)\n\t}\n}\n\n// An unset non-standard api_key_env on a built-in endpoint falls back to\n// the provider's standard variable before any stored key, and a protocol\n// override that keeps the role on that provider does not change the choice.\nfunc TestUnsetProfileVariableOnABuiltinEndpointPrefersProviderVariable(\n\tt *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"OPENROUTER_API_KEY\", \"ambient\")\n\trole, err := resolveStored(t, \"    model: m\\n    protocol: chat\\n\"+\n\t\t\"    endpoint: https://openrouter.ai/api/v1\\n\"+\n\t\t\"    api_key_env: MY_OR_KEY\\n\", bothStored())\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif role.APIKey != \"ambient\" {\n\t\tt.Fatalf(\"key = %q from %+v, want ambient\", role.APIKey,\n\t\t\trole.Credential)\n\t}\n\tprotocol := \"responses\"\n\tmoved, err := OverrideEndpoint(\"finder\", role, nil, &protocol)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif moved.APIKey != role.APIKey {\n\t\tt.Fatalf(\"after override key = %q, before %q\", moved.APIKey,\n\t\t\trole.APIKey)\n\t}\n}\n20:func TestLoadResolvesNamedProfiles(t *testing.T) {\n77:func TestResolveRoleUsesNativeAnthropicDefaults(t *testing.T) {\n112:func TestResolveRoleIgnoresLegacyGlobalOverrides(t *testing.T) {\n145:func TestLoadRejectsProfileCredentialAmbiguity(t *testing.T) {\n167:func TestValidateRoleRejectsEmbeddedCredentials(t *testing.T) {\n177:func TestResolveFinderFlipSelectsNamedProfile(t *testing.T) {\n228:func TestResolveFinderFlipRejectsSameFamilyTarget(t *testing.T) {\n242:func TestResolveFinderFlipSelectsExactAuthorRoute(t *testing.T) {\n258:func TestInferFamily(t *testing.T) {\n281:func TestResolveFinderFlipTreatsSlashIDsLikeBareIDs(t *testing.T) {\n345:func TestLoadSessionHeader(t *testing.T) {\n372:func TestLoadRejectsInvalidSessionHeader(t *testing.T) {\n412:func TestLoadRejectsUploadSection(t *testing.T) {\n419:func TestLoadAcceptsJSONCCommentsAndTrailingCommas(t *testing.T) {\n444:func TestLoadRejectsInvalidProjectConfig(t *testing.T) {\n467:func TestLoadMissingFileIsAnError(t *testing.T) {\n474:func TestFindWalksUpNoFurtherThanStop(t *testing.T) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_018YpMDBdC2TMHYr8gJY5ZQU","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
