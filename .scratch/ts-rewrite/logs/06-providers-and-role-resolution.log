{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018sAbu3qmBiKCTky5TXZnwo","type":"tool_result","content":"1\t// Project config discovery and loading (spec 02, 2.2 to 2.4 and 2.8).\n2\timport fs from 'node:fs'\n3\timport path from 'node:path'\n4\timport type { z } from 'zod'\n5\timport { type GoDuration, parseGoDuration } from '../gocompat/duration.js'\n6\timport {\n7\t    DEFAULT_PROTOCOL,\n8\t    defaultBaseUrl,\n9\t    endpointProblem,\n10\t} from './endpoint.js'\n11\timport {\n12\t    type JsonObject,\n13\t    type JsonValue,\n14\t    isJsonObject,\n15\t    newObject,\n16\t    parseJsonc,\n17\t    setKey,\n18\t} from './jsonc.js'\n19\timport {\n20\t    ConfigSchema,\n21\t    type RawConfig,\n22\t    type RawProfile,\n23\t    type RawRole,\n24\t    SEVERITIES,\n25\t} from './schema.js'\n26\t\n27\texport const PROJECT_CONFIG_NAME = '.roast.json'\n28\t\n29\t// Every config discovery, parse, and validation failure. The CLI wraps\n30\t// it as a usage error.\n31\texport class ConfigError extends Error {\n32\t    constructor (message:string, opts?:{ cause?:unknown }) {\n33\t        super(message, opts)\n34\t        this.name = 'ConfigError'\n35\t    }\n36\t}\n37\t\n38\tfunction causeText (err:unknown):string {\n39\t    return err instanceof Error ? err.message : String(err)\n40\t}\n41\t\n42\tfunction findError (err:unknown):ConfigError {\n43\t    return new ConfigError(`find project config: ${causeText(err)}`,\n44\t        { cause:err })\n45\t}\n46\t\n47\tfunction isNotFound (err:unknown):boolean {\n48\t    const code = (err as NodeJS.ErrnoException|undefined)?.code\n49\t    return code === 'ENOENT' || code === 'ENOTDIR'\n50\t}\n51\t\n52\t// The nearest .roast.json at or above `start`, never looking above\n53\t// `stop`, or '' when there is none. Directories compare by realpath (on\n54\t// macOS a temp dir is /var/... while git prints /private/var/...), but\n55\t// the returned path is spelled through `start`.\n56\texport function findConfig (start:string, stop:string):string {\n57\t    let dir = path.resolve(start)\n58\t    let stopCanonical:string\n59\t    try {\n60\t        stopCanonical = fs.realpathSync(path.resolve(stop))\n61\t    } catch (err) {\n62\t        throw findError(err)\n63\t    }\n64\t    for (;;) {\n65\t        const candidate = path.join(dir, PROJECT_CONFIG_NAME)\n66\t        try {\n67\t            if (!fs.statSync(candidate).isDirectory()) return candidate\n68\t        } catch (err) {\n69\t            if (!isNotFound(err)) throw findError(err)\n70\t        }\n71\t        let canonical:string\n72\t        try {\n73\t            canonical = fs.realpathSync(dir)\n74\t        } catch (err) {\n75\t            throw findError(err)\n76\t        }\n77\t        const parent = path.dirname(dir)\n78\t        if (canonical === stopCanonical || parent === dir) return ''\n79\t        dir = parent\n80\t    }\n81\t}\n82\t\n83\texport const CURRENT_VERSION = 1\n84\texport const DEFAULT_MAX_OUTPUT_TOKENS = 32768\n85\texport const DEFAULT_CONFIDENCE_FLOOR = 0.6\n86\texport const DEFAULT_QUICK_CONFIDENCE_FLOOR = 0.8\n87\tconst MAX_SESSION_HEADER_LENGTH = 64\n88\t\n89\t// The stored-credential store a loaded config carries (filled by the\n90\t// credentials area; config never imports it).\n91\texport interface StoredCredentials {\n92\t    // '' key when none is stored. Throws when a credentials file cannot be\n93\t    // used; it never skips a bad file.\n94\t    lookup (provider:string):{ key:string, scope:'project'|'user'|'' };\n95\t}\n96\t\n97\texport interface NormalizedProfile extends RawProfile {\n98\t    protocol:string;\n99\t    max_output_tokens:number;\n100\t}\n101\t\n102\texport interface NormalizedLimits extends Omit<\n103\t    NonNullable<RawConfig['limits']>, 'deadline'|'request_timeout'\n104\t> {\n105\t    deadline?:GoDuration;\n106\t    request_timeout?:GoDuration;\n107\t}\n108\t\n109\texport interface NormalizedConfig extends Omit<\n110\t    RawConfig, 'inference_profiles'|'roles'|'limits'\n111\t> {\n112\t    inference_profiles:Record<string, NormalizedProfile>;\n113\t    roles:{ finder?:RawRole, verifier?:RawRole };\n114\t    review:NonNullable<RawConfig['review']>&{\n115\t        confidence_floor:number;\n116\t        quick_confidence_floor:number;\n117\t    };\n118\t    limits?:NormalizedLimits;\n119\t}\n120\t\n121\texport interface ProjectConfig extends NormalizedConfig {\n122\t    // The directory holding the config file; '' when not loaded from one.\n123\t    readonly dir:string;\n124\t    readonly stored?:StoredCredentials;\n125\t}\n126\t\n127\ttype Path = readonly (string|number)[]\n128\t\n129\tfunction dotted (at:Path):string {\n130\t    return at.map(String).join('.')\n131\t}\n132\t\n133\t// Step 2: the value is an object whose version is 1.\n134\tfunction checkVersion (value:JsonValue):asserts value is JsonObject {\n135\t    if (!isJsonObject(value)) {\n136\t        const got = Array.isArray(value) ? 'array' : typeof value\n137\t        throw new ConfigError(`config must be a JSON object (got ${got})`)\n138\t    }\n139\t    const version = Object.hasOwn(value, 'version') ?\n140\t        value.version :\n141\t        null\n142\t    if (version === null) {\n143\t        throw new ConfigError('version is required (set \"version\": 1)')\n144\t    }\n145\t    if (typeof version !== 'number' || !Number.isInteger(version)) {\n146\t        throw new ConfigError(\n147\t            `version must be an integer (got ${JSON.stringify(version)})`)\n148\t    }\n149\t    if (version !== CURRENT_VERSION) {\n150\t        throw new ConfigError(`unsupported config version ${version} ` +\n151\t            `(this build supports version ${CURRENT_VERSION})`)\n152\t    }\n153\t}\n154\t\n155\t// Step 3: a profile never holds a credential.\n156\tfunction rejectLiteralCredentials (value:JsonObject):void {\n157\t    const profiles = value.inference_profiles\n158\t    if (!isJsonObject(profiles)) return\n159\t    for (const [name, profile] of Object.entries(profiles)) {\n160\t        if (isJsonObject(profile) && Object.hasOwn(profile, 'api_key')) {\n161\t            throw new ConfigError(`inference_profiles.${name}.api_key is ` +\n162\t                'not allowed: a project config never holds a credential; ' +\n163\t                'name its environment variable with api_key_env')\n164\t        }\n165\t    }\n166\t}\n167\t\n168\t// Maps whose values are objects or strings: a null value there is the\n169\t// zero value, not an absent key (Go map decoding).\n170\tconst MAP_ZERO:Record<string, () => JsonValue> = {\n171\t    inference_profiles:newObject,\n172\t    roles:newObject,\n173\t    author_routes:() => '',\n174\t}\n175\t\n176\t// Step 4: Go parity for null. In fixed-shape objects a null property is\n177\t// deleted; in maps a null value becomes the zero value; a null array\n178\t// element becomes \"\".\n179\tfunction nullsAsUnset (value:JsonValue, mapKey?:string):JsonValue {\n180\t    if (Array.isArray(value)) {\n181\t        return value.map(v => v === null ? '' : nullsAsUnset(v))\n182\t    }\n183\t    if (!isJsonObject(value)) return value\n184\t    const out = newObject()\n185\t    const zero = mapKey === undefined ? undefined : MAP_ZERO[mapKey]\n186\t    for (const [key, v] of Object.entries(value)) {\n187\t        if (v === null) {\n188\t            if (zero) setKey(out, key, zero())\n189\t            continue\n190\t        }\n191\t        // inference_profiles and roles hold objects, whose own keys are\n192\t        // fixed-shape again; author_routes is a map at any depth.\n193\t        const childMap = zero ? undefined : (key in MAP_ZERO ? key : undefined)\n194\t        setKey(out, key, nullsAsUnset(v, childMap))\n195\t    }\n196\t    return out\n197\t}\n198\t\n199\tfunction hasLoneSurrogate (s:string):boolean {\n200\t    for (let i = 0; i < s.length; i++) {\n201\t        const c = s.charCodeAt(i)\n202\t        if (c >= 0xd800 && c <= 0xdbff) {\n203\t            const next = s.charCodeAt(i + 1)\n204\t            if (next >= 0xdc00 && next <= 0xdfff) {\n205\t                i++\n206\t                continue\n207\t            }\n208\t            return true\n209\t        }\n210\t        if (c >= 0xdc00 && c <= 0xdfff) return true\n211\t    }\n212\t    return false\n213\t}\n214\t\n215\t// Step 5a: every key and string is well-formed UTF-16, so the trust hash\n216\t// is always defined.\n217\tfunction rejectLoneSurrogates (value:JsonValue, at:Path = []):void {\n218\t    if (typeof value === 'string') {\n219\t        if (hasLoneSurrogate(value)) {\n220\t            throw new ConfigError(`${dotted(at) || 'config'}: string ` +\n221\t                'contains a lone UTF-16 surrogate')\n222\t        }\n223\t        return\n224\t    }\n225\t    if (Array.isArray(value)) {\n226\t        value.forEach((v, i) => rejectLoneSurrogates(v, [...at, i]))\n227\t        return\n228\t    }\n229\t    if (!isJsonObject(value)) return\n230\t    for (const [key, v] of Object.entries(value)) {\n231\t        if (hasLoneSurrogate(key)) {\n232\t            throw new ConfigError(`${dotted(at) || 'config'}: key ` +\n233\t                'contains a lone UTF-16 surrogate')\n234\t        }\n235\t        rejectLoneSurrogates(v, [...at, key])\n236\t    }\n237\t}\n238\t\n239\tinterface ZodDefLike {\n240\t    type:string;\n241\t    innerType?:ZodLike;\n242\t    shape?:Record<string, ZodLike>;\n243\t    valueType?:ZodLike;\n244\t    element?:ZodLike;\n245\t    format?:string;\n246\t}\n247\t\n248\tinterface ZodLike {\n249\t    _zod:{ def:ZodDefLike };\n250\t}\n251\t\n252\t// Whether `at` names an integer field of the schema.\n253\tfunction isIntegerField (at:Path):boolean {\n254\t    let s:ZodLike|undefined = ConfigSchema as unknown as ZodLike\n255\t    let i = 0\n256\t    while (s) {\n257\t        const def:ZodDefLike = s._zod.def\n258\t        if (def.type === 'optional') {\n259\t            s = def.innerType\n260\t            continue\n261\t        }\n262\t        if (i === at.length) {\n263\t            // `version` is the integer literal 1.\n264\t            return (def.type === 'number' && def.format === 'safeint') ||\n265\t                def.type === 'literal'\n266\t        }\n267\t        const key = at[i++]\n268\t        if (def.type === 'object') s = def.shape?.[String(key)]\n269\t        else if (def.type === 'record') s = def.valueType\n270\t        else if (def.type === 'array') s = def.element\n271\t        else return false\n272\t    }\n273\t    return false\n274\t}\n275\t\n276\tfunction issueMessage (issue:z.core.$ZodIssue):string {\n277\t    const at = dotted(issue.path as Path)\n278\t    if (issue.code === 'unrecognized_keys') {\n279\t        const key = issue.keys[0]\n280\t        if (at === 'roles') {\n281\t            return `roles.${key} is not a role (finder or verifier)`\n282\t        }\n283\t        return `${at ? `${at}: ` : ''}unknown field ${JSON.stringify(key)}`\n284\t    }\n285\t    return `${at || 'config'}: ${issue.message}`\n286\t}\n287\t\n288\t// Parses and structurally validates config text (spec 02, section 3,\n289\t// steps 1 to 5). Errors are thrown as ConfigError without a path prefix.\n290\texport function decode (text:string):RawConfig {\n291\t    let parsed:ReturnType<typeof parseJsonc>\n292\t    try {\n293\t        parsed = parseJsonc(text)\n294\t    } catch (err) {\n295\t        throw new ConfigError((err as Error).message, { cause:err })\n296\t    }\n297\t    const { value, nonIntegerLexemes } = parsed\n298\t    checkVersion(value)\n299\t    rejectLiteralCredentials(value)\n300\t    const cleaned = nullsAsUnset(value)\n301\t    rejectLoneSurrogates(cleaned)\n302\t    const result = ConfigSchema.safeParse(cleaned)\n303\t    if (!result.success) {\n304\t        throw new ConfigError(issueMessage(result.error.issues[0]))\n305\t    }\n306\t    for (const at of nonIntegerLexemes) {\n307\t        if (isIntegerField(at)) {\n308\t            throw new ConfigError(`${dotted(at)}: expected an integer ` +\n309\t                'without a fraction or exponent')\n310\t        }\n311\t    }\n312\t    // zod's output object would turn a `__proto__` key into a prototype,\n313\t    // so the validated input (null-prototype objects) is the config.\n314\t    return cleaned as RawConfig\n315\t}\n316\t\n317\tfunction canonicalFamily (family:string):string {\n318\t    return family === 'gemini' ? 'google' : family\n319\t}\n320\t\n321\tfunction isTokenChar (c:number):boolean {\n322\t    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||\n323\t        (c >= 48 && c <= 57) || \"!#$%&'*+-.^_`|~\".includes(\n324\t        String.fromCharCode(c))\n325\t}\n326\t\n327\tconst RESERVED_SESSION_HEADERS = [\n328\t    'Authorization', 'X-Api-Key', 'Proxy-Authorization', 'Cookie', 'Host',\n329\t    'Content-Type', 'Content-Length', 'Content-Encoding',\n330\t    'Transfer-Encoding', 'Connection', 'Keep-Alive', 'Proxy-Connection',\n331\t    'TE', 'Trailer', 'Upgrade', 'Expect', 'Accept', 'Accept-Encoding',\n332\t    'User-Agent', 'X-Agent-Session-Id', 'Anthropic-Version',\n333\t    'Anthropic-Beta', 'Anthropic-Workspace-Id', 'OpenAI-Organization',\n334\t    'OpenAI-Project',\n335\t].map(h => h.toLowerCase())\n336\t\n337\tfunction checkSessionHeader (field:string, name:string):void {\n338\t    let ok = name.length <= MAX_SESSION_HEADER_LENGTH\n339\t    for (let i = 0; ok && i < name.length; i++) {\n340\t        ok = isTokenChar(name.charCodeAt(i))\n341\t    }\n342\t    if (!ok) {\n343\t        throw new ConfigError(`${field} must be an HTTP header name of at ` +\n344\t            `most ${MAX_SESSION_HEADER_LENGTH} letters, digits, or ` +\n345\t            \"!#$%&'*+-.^_`|~ characters\")\n346\t    }\n347\t    const lower = name.toLowerCase()\n348\t    if (lower.startsWith('x-stainless-') ||\n349\t        RESERVED_SESSION_HEADERS.includes(lower)) {\n350\t        throw new ConfigError(`${field} cannot be ${JSON.stringify(name)}, ` +\n351\t            'which is reserved for credentials, request framing, or a ' +\n352\t            'header Roast or the provider SDK sets')\n353\t    }\n354\t}\n355\t\n356\tconst API_KEY_ENV = /^[A-Za-z_][A-Za-z0-9_]*$/\n357\t\n358\tfunction normalizeProfile (name:string, p:RawProfile):NormalizedProfile {\n359\t    if (name.trim() === '') {\n360\t        throw new ConfigError('inference profile names cannot be empty')\n361\t    }\n362\t    const field = `inference_profiles.${name}`\n363\t    const out:NormalizedProfile = {\n364\t        ...p,\n365\t        protocol:p.protocol || DEFAULT_PROTOCOL,\n366\t        max_output_tokens:p.max_output_tokens || DEFAULT_MAX_OUTPUT_TOKENS,\n367\t    }\n368\t    if (p.api_key_env && !API_KEY_ENV.test(p.api_key_env)) {\n369\t        throw new ConfigError(`${field}.api_key_env is not a valid ` +\n370\t            'environment variable name')\n371\t    }\n372\t    const problem = endpointProblem(field,\n373\t        p.endpoint || defaultBaseUrl(out.protocol), out.protocol,\n374\t        out.max_output_tokens)\n375\t    if (problem) throw new ConfigError(problem)\n376\t    if (p.session_header) {\n377\t        checkSessionHeader(`${field}.session_header`, p.session_header)\n378\t    }\n379\t    return out\n380\t}\n381\t\n382\tfunction normalizeRole (\n383\t    name:string,\n384\t    role:RawRole,\n385\t    profiles:Record<string, NormalizedProfile>\n386\t):RawRole {\n387\t    if (!role.profile) {\n388\t        throw new ConfigError(`roles.${name}.profile is required`)\n389\t    }\n390\t    if (!Object.hasOwn(profiles, role.profile)) {\n391\t        throw new ConfigError(`roles.${name}.profile references unknown ` +\n392\t            `inference profile ${JSON.stringify(role.profile)}`)\n393\t    }\n394\t    if (!role.author_routes) return role\n395\t    const routes = newObject<string>()\n396\t    for (const [rawKey, target] of Object.entries(role.author_routes)) {\n397\t        const key = canonicalFamily(rawKey.trim().toLowerCase())\n398\t        if (key === '') {\n399\t            throw new ConfigError(`roles.${name}.author_routes contains ` +\n400\t                'empty model family')\n401\t        }\n402\t        if (!Object.hasOwn(profiles, target)) {\n403\t            throw new ConfigError(`roles.${name}.author_routes.${key} ` +\n404\t                'references unknown inference profile ' +\n405\t                JSON.stringify(target))\n406\t        }\n407\t        if (Object.hasOwn(routes, key)) {\n408\t            throw new ConfigError(`roles.${name}.author_routes contains ` +\n409\t                `duplicate family ${JSON.stringify(key)}`)\n410\t        }\n411\t        setKey(routes, key, target)\n412\t    }\n413\t    return { ...role, author_routes:routes }\n414\t}\n415\t\n416\tfunction checkFloor (key:string, v:number|undefined):void {\n417\t    if (v !== undefined && (v < 0 || v > 1)) {\n418\t        throw new ConfigError(`${key} must be between 0 and 1 (got ${v})`)\n419\t    }\n420\t}\n421\t\n422\tfunction parseDuration (key:string, s:string|undefined):GoDuration|undefined {\n423\t    if (s === undefined) return undefined\n424\t    let d:GoDuration\n425\t    try {\n426\t        d = parseGoDuration(s)\n427\t    } catch (err) {\n428\t        throw new ConfigError(`${key}: invalid duration ${JSON.stringify(s)}`,\n429\t            { cause:err })\n430\t    }\n431\t    if (d < 0n) throw new ConfigError(`${key} cannot be negative`)\n432\t    return d\n433\t}\n434\t\n435\t// Settings checks in Go's fixed order (spec 02, 2.4).\n436\tfunction validateSettings (raw:RawConfig):void {\n437\t    const ints:[string, number|undefined, number][] = [\n438\t        ['limits.max_total_tokens', raw.limits?.max_total_tokens, 0],\n439\t        ['limits.max_diff_bytes', raw.limits?.max_diff_bytes, 1],\n440\t        ['limits.max_prompt_bytes', raw.limits?.max_prompt_bytes, 1],\n441\t        ['limits.max_file_ctx_bytes', raw.limits?.max_file_ctx_bytes, 1],\n442\t        ['limits.max_attempts', raw.limits?.max_attempts, 1],\n443\t        ['limits.max_verified', raw.limits?.max_verified, 0],\n444\t        ['interactive.min_files', raw.interactive?.min_files, 0],\n445\t        ['interactive.min_diff_lines', raw.interactive?.min_diff_lines, 0],\n446\t        ['gate.timeout_seconds', raw.gate?.timeout_seconds, 0],\n447\t    ]\n448\t    for (const [key, v, min] of ints) {\n449\t        if (v !== undefined && v < min) {\n450\t            throw new ConfigError(\n451\t                `${key} must be an integer >= ${min} (got ${v})`)\n452\t        }\n453\t    }\n454\t    parseDuration('limits.deadline', raw.limits?.deadline)\n455\t    parseDuration('limits.request_timeout', raw.limits?.request_timeout)\n456\t    const severity = raw.gate?.severity\n457\t    if (severity &&\n458\t        !(SEVERITIES as readonly string[]).includes(severity.toUpperCase())) {\n459\t        throw new ConfigError('gate.severity must be INFO, LOW, MEDIUM, ' +\n460\t            `HIGH, or CRITICAL (got ${JSON.stringify(severity)})`)\n461\t    }\n462\t}\n463\t\n464\t// Applies defaults and the checks zod does not express, in Go's order:\n465\t// profiles, roles, confidence floors, then settings.\n466\texport function normalize (raw:RawConfig, dir:string):ProjectConfig {\n467\t    const profiles = newObject<NormalizedProfile>()\n468\t    for (const [name, p] of Object.entries(raw.inference_profiles ?? {})) {\n469\t        setKey(profiles, name, normalizeProfile(name, p))\n470\t    }\n471\t    const roles:NormalizedConfig['roles'] = {}\n472\t    for (const name of Object.keys(raw.roles ?? {})) {\n473\t        const role = raw.roles?.[name as 'finder'|'verifier']\n474\t        if (role) {\n475\t            roles[name as 'finder'|'verifier'] =\n476\t                normalizeRole(name, role, profiles)\n477\t        }\n478\t    }\n479\t    const review = raw.review ?? {}\n480\t    checkFloor('confidence_floor', review.confidence_floor)\n481\t    checkFloor('quick_confidence_floor', review.quick_confidence_floor)\n482\t    validateSettings(raw)\n483\t    const limits:NormalizedLimits|undefined = raw.limits && {\n484\t        ...raw.limits,\n485\t        deadline:parseDuration('limits.deadline', raw.limits.deadline),\n486\t        request_timeout:parseDuration('limits.request_timeout',\n487\t            raw.limits.request_timeout),\n488\t    }\n489\t    if (limits?.deadline === undefined) delete limits?.deadline\n490\t    if (limits?.request_timeout === undefined) delete limits?.request_timeout\n491\t    return {\n492\t        ...raw,\n493\t        inference_profiles:profiles,\n494\t        roles,\n495\t        review:{\n496\t            ...review,\n497\t            confidence_floor:review.confidence_floor ||\n498\t                DEFAULT_CONFIDENCE_FLOOR,\n499\t            quick_confidence_floor:review.quick_confidence_floor ||\n500\t                DEFAULT_QUICK_CONFIDENCE_FLOOR,\n501\t        },\n502\t        limits,\n503\t        dir,\n504\t    }\n505\t}\n506\t\n507\t// Reads, parses, and validates the config at `file`.\n508\texport function loadConfig (file:string):ProjectConfig {\n509\t    let text:string\n510\t    try {\n511\t        text = fs.readFileSync(file, 'utf8')\n512\t    } catch (err) {\n513\t        throw new ConfigError(`open config ${file}: ${causeText(err)}`,\n514\t            { cause:err })\n515\t    }\n516\t    let raw:RawConfig\n517\t    try {\n518\t        raw = decode(text)\n519\t    } catch (err) {\n520\t        throw new ConfigError(`parse config ${file}: ${causeText(err)}`,\n521\t            { cause:err })\n522\t    }\n523\t    return normalize(raw, path.resolve(path.dirname(file)))\n524\t}\n525\t\n526\texport function withStoredCredentials (\n527\t    cfg:ProjectConfig,\n528\t    stored:StoredCredentials\n529\t):ProjectConfig {\n530\t    return { ...cfg, stored }\n531\t}\n532\t\n533\t// The file a prompt override names: relative paths resolve against the\n534\t// config file's directory, so the same file is read wherever Roast runs.\n535\texport function promptPath (cfg:ProjectConfig, p:string):string {\n536\t    if (p === '' || path.isAbsolute(p) || cfg.dir === '') return p\n537\t    return path.join(cfg.dir, p)\n538\t}\n539\t\n540\t// Every credential variable a profile names, in document order.\n541\texport function credentialEnvNames (cfg:ProjectConfig):string[] {\n542\t    return Object.values(cfg.inference_profiles)\n543\t        .map(p => p.api_key_env ?? '')\n544\t        .filter(name => name !== '')\n545\t}\n546\t\n547\texport function snapshotEnabled (cfg:ProjectConfig):boolean {\n548\t    return cfg.review.snapshot ?? true\n549\t}\n550\t\n551\texport function gateOffers (cfg:ProjectConfig):boolean {\n552\t    return cfg.gate?.offer ?? true\n553\t}\n554\t"}]},"parent_tool_use_id":null,"session_id":"682f1424-ed5e-4ad8-82df-9c53c97a2745","uuid":"e91f11f1-476e-475a-a02d-4be53ee1ef62","timestamp":"2026-11-18T20:09:54.990Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.ts-rewrite-06-providers-and-role-resolution/src/config/load.ts","content":"// Project config discovery and loading (spec 02, 2.2 to 2.4 and 2.8).\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport type { z } from 'zod'\nimport { type GoDuration, parseGoDuration } from '../gocompat/duration.js'\nimport {\n    DEFAULT_PROTOCOL,\n    defaultBaseUrl,\n    endpointProblem,\n} from './endpoint.js'\nimport {\n    type JsonObject,\n    type JsonValue,\n    isJsonObject,\n    newObject,\n    parseJsonc,\n    setKey,\n} from './jsonc.js'\nimport {\n    ConfigSchema,\n    type RawConfig,\n    type RawProfile,\n    type RawRole,\n    SEVERITIES,\n} from './schema.js'\n\nexport const PROJECT_CONFIG_NAME = '.roast.json'\n\n// Every config discovery, parse, and validation failure. The CLI wraps\n// it as a usage error.\nexport class ConfigError extends Error {\n    constructor (message:string, opts?:{ cause?:unknown }) {\n        super(message, opts)\n        this.name = 'ConfigError'\n    }\n}\n\nfunction causeText (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nfunction findError (err:unknown):ConfigError {\n    return new ConfigError(`find project config: ${causeText(err)}`,\n        { cause:err })\n}\n\nfunction isNotFound (err:unknown):boolean {\n    const code = (err as NodeJS.ErrnoException|undefined)?.code\n    return code === 'ENOENT' || code === 'ENOTDIR'\n}\n\n// The nearest .roast.json at or above `start`, never looking above\n// `stop`, or '' when there is none. Directories compare by realpath (on\n// macOS a temp dir is /var/... while git prints /private/var/...), but\n// the returned path is spelled through `start`.\nexport function findConfig (start:string, stop:string):string {\n    let dir = path.resolve(start)\n    let stopCanonical:string\n    try {\n        stopCanonical = fs.realpathSync(path.resolve(stop))\n    } catch (err) {\n        throw findError(err)\n    }\n    for (;;) {\n        const candidate = path.join(dir, PROJECT_CONFIG_NAME)\n        try {\n            if (!fs.statSync(candidate).isDirectory()) return candidate\n        } catch (err) {\n            if (!isNotFound(err)) throw findError(err)\n        }\n        let canonical:string\n        try {\n            canonical = fs.realpathSync(dir)\n        } catch (err) {\n            throw findError(err)\n        }\n        const parent = path.dirname(dir)\n        if (canonical === stopCanonical || parent === dir) return ''\n        dir = parent\n    }\n}\n\nexport const CURRENT_VERSION = 1\nexport const DEFAULT_MAX_OUTPUT_TOKENS = 32768\nexport const DEFAULT_CONFIDENCE_FLOOR = 0.6\nexport const DEFAULT_QUICK_CONFIDENCE_FLOOR = 0.8\nconst MAX_SESSION_HEADER_LENGTH = 64\n\n// The stored-credential store a loaded config carries (filled by the\n// credentials area; config never imports it).\nexport interface StoredCredentials {\n    // '' key when none is stored. Throws when a credentials file cannot be\n    // used; it never skips a bad file.\n    lookup (provider:string):{ key:string, scope:'project'|'user'|'' };\n}\n\nexport interface NormalizedProfile extends RawProfile {\n    protocol:string;\n    max_output_tokens:number;\n}\n\nexport interface NormalizedLimits extends Omit<\n    NonNullable<RawConfig['limits']>, 'deadline'|'request_timeout'\n> {\n    deadline?:GoDuration;\n    request_timeout?:GoDuration;\n}\n\nexport interface NormalizedConfig extends Omit<\n    RawConfig, 'inference_profiles'|'roles'|'limits'\n> {\n    inference_profiles:Record<string, NormalizedProfile>;\n    roles:{ finder?:RawRole, verifier?:RawRole };\n    review:NonNullable<RawConfig['review']>&{\n        confidence_floor:number;\n        quick_confidence_floor:number;\n    };\n    limits?:NormalizedLimits;\n}\n\nexport interface ProjectConfig extends NormalizedConfig {\n    // The directory holding the config file; '' when not loaded from one.\n    readonly dir:string;\n    readonly stored?:StoredCredentials;\n}\n\ntype Path = readonly (string|number)[]\n\nfunction dotted (at:Path):string {\n    return at.map(String).join('.')\n}\n\n// Step 2: the value is an object whose version is 1.\nfunction checkVersion (value:JsonValue):asserts value is JsonObject {\n    if (!isJsonObject(value)) {\n        const got = Array.isArray(value) ? 'array' : typeof value\n        throw new ConfigError(`config must be a JSON object (got ${got})`)\n    }\n    const version = Object.hasOwn(value, 'version') ?\n        value.version :\n        null\n    if (version === null) {\n        throw new ConfigError('version is required (set \"version\": 1)')\n    }\n    if (typeof version !== 'number' || !Number.isInteger(version)) {\n        throw new ConfigError(\n            `version must be an integer (got ${JSON.stringify(version)})`)\n    }\n    if (version !== CURRENT_VERSION) {\n        throw new ConfigError(`unsupported config version ${version} ` +\n            `(this build supports version ${CURRENT_VERSION})`)\n    }\n}\n\n// Step 3: a profile never holds a credential.\nfunction rejectLiteralCredentials (value:JsonObject):void {\n    const profiles = value.inference_profiles\n    if (!isJsonObject(profiles)) return\n    for (const [name, profile] of Object.entries(profiles)) {\n        if (isJsonObject(profile) && Object.hasOwn(profile, 'api_key')) {\n            throw new ConfigError(`inference_profiles.${name}.api_key is ` +\n                'not allowed: a project config never holds a credential; ' +\n                'name its environment variable with api_key_env')\n        }\n    }\n}\n\n// Maps whose values are objects or strings: a null value there is the\n// zero value, not an absent key (Go map decoding).\nconst MAP_ZERO:Record<string, () => JsonValue> = {\n    inference_profiles:newObject,\n    roles:newObject,\n    author_routes:() => '',\n}\n\n// Step 4: Go parity for null. In fixed-shape objects a null property is\n// deleted; in maps a null value becomes the zero value; a null array\n// element becomes \"\".\nfunction nullsAsUnset (value:JsonValue, mapKey?:string):JsonValue {\n    if (Array.isArray(value)) {\n        return value.map(v => v === null ? '' : nullsAsUnset(v))\n    }\n    if (!isJsonObject(value)) return value\n    const out = newObject()\n    const zero = mapKey === undefined ? undefined : MAP_ZERO[mapKey]\n    for (const [key, v] of Object.entries(value)) {\n        if (v === null) {\n            if (zero) setKey(out, key, zero())\n            continue\n        }\n        // inference_profiles and roles hold objects, whose own keys are\n        // fixed-shape again; author_routes is a map at any depth.\n        const childMap = zero ? undefined : (key in MAP_ZERO ? key : undefined)\n        setKey(out, key, nullsAsUnset(v, childMap))\n    }\n    return out\n}\n\nfunction hasLoneSurrogate (s:string):boolean {\n    for (let i = 0; i < s.length; i++) {\n        const c = s.charCodeAt(i)\n        if (c >= 0xd800 && c <= 0xdbff) {\n            const next = s.charCodeAt(i + 1)\n            if (next >= 0xdc00 && next <= 0xdfff) {\n                i++\n                continue\n            }\n            return true\n        }\n        if (c >= 0xdc00 && c <= 0xdfff) return true\n    }\n    return false\n}\n\n// Step 5a: every key and string is well-formed UTF-16, so the trust hash\n// is always defined.\nfunction rejectLoneSurrogates (value:JsonValue, at:Path = []):void {\n    if (typeof value === 'string') {\n        if (hasLoneSurrogate(value)) {\n            throw new ConfigError(`${dotted(at) || 'config'}: string ` +\n                'contains a lone UTF-16 surrogate')\n        }\n        return\n    }\n    if (Array.isArray(value)) {\n        value.forEach((v, i) => rejectLoneSurrogates(v, [...at, i]))\n        return\n    }\n    if (!isJsonObject(value)) return\n    for (const [key, v] of Object.entries(value)) {\n        if (hasLoneSurrogate(key)) {\n            throw new ConfigError(`${dotted(at) || 'config'}: key ` +\n                'contains a lone UTF-16 surrogate')\n        }\n        rejectLoneSurrogates(v, [...at, key])\n    }\n}\n\ninterface ZodDefLike {\n    type:string;\n    innerType?:ZodLike;\n    shape?:Record<string, ZodLike>;\n    valueType?:ZodLike;\n    element?:ZodLike;\n    format?:string;\n}\n\ninterface ZodLike {\n    _zod:{ def:ZodDefLike };\n}\n\n// Whether `at` names an integer field of the schema.\nfunction isIntegerField (at:Path):boolean {\n    let s:ZodLike|undefined = ConfigSchema as unknown as ZodLike\n    let i = 0\n    while (s) {\n        const def:ZodDefLike = s._zod.def\n        if (def.type === 'optional') {\n            s = def.innerType\n            continue\n        }\n        if (i === at.length) {\n            // `version` is the integer literal 1.\n            return (def.type === 'number' && def.format === 'safeint') ||\n                def.type === 'literal'\n        }\n        const key = at[i++]\n        if (def.type === 'object') s = def.shape?.[String(key)]\n        else if (def.type === 'record') s = def.valueType\n        else if (def.type === 'array') s = def.element\n        else return false\n    }\n    return false\n}\n\nfunction issueMessage (issue:z.core.$ZodIssue):string {\n    const at = dotted(issue.path as Path)\n    if (issue.code === 'unrecognized_keys') {\n        const key = issue.keys[0]\n        if (at === 'roles') {\n            return `roles.${key} is not a role (finder or verifier)`\n        }\n        return `${at ? `${at}: ` : ''}unknown field ${JSON.stringify(key)}`\n    }\n    return `${at || 'config'}: ${issue.message}`\n}\n\n// Parses and structurally validates config text (spec 02, section 3,\n// steps 1 to 5). Errors are thrown as ConfigError without a path prefix.\nexport function decode (text:string):RawConfig {\n    let parsed:ReturnType<typeof parseJsonc>\n    try {\n        parsed = parseJsonc(text)\n    } catch (err) {\n        throw new ConfigError((err as Error).message, { cause:err })\n    }\n    const { value, nonIntegerLexemes } = parsed\n    checkVersion(value)\n    rejectLiteralCredentials(value)\n    const cleaned = nullsAsUnset(value)\n    rejectLoneSurrogates(cleaned)\n    const result = ConfigSchema.safeParse(cleaned)\n    if (!result.success) {\n        throw new ConfigError(issueMessage(result.error.issues[0]))\n    }\n    for (const at of nonIntegerLexemes) {\n        if (isIntegerField(at)) {\n            throw new ConfigError(`${dotted(at)}: expected an integer ` +\n                'without a fraction or exponent')\n        }\n    }\n    // zod's output object would turn a `__proto__` key into a prototype,\n    // so the validated input (null-prototype objects) is the config.\n    return cleaned as RawConfig\n}\n\nfunction canonicalFamily (family:string):string {\n    return family === 'gemini' ? 'google' : family\n}\n\nfunction isTokenChar (c:number):boolean {\n    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||\n        (c >= 48 && c <= 57) || \"!#$%&'*+-.^_`|~\".includes(\n        String.fromCharCode(c))\n}\n\nconst RESERVED_SESSION_HEADERS = [\n    'Authorization', 'X-Api-Key', 'Proxy-Authorization', 'Cookie', 'Host',\n    'Content-Type', 'Content-Length', 'Content-Encoding',\n    'Transfer-Encoding', 'Connection', 'Keep-Alive', 'Proxy-Connection',\n    'TE', 'Trailer', 'Upgrade', 'Expect', 'Accept', 'Accept-Encoding',\n    'User-Agent', 'X-Agent-Session-Id', 'Anthropic-Version',\n    'Anthropic-Beta', 'Anthropic-Workspace-Id', 'OpenAI-Organization',\n    'OpenAI-Project',\n].map(h => h.toLowerCase())\n\nfunction checkSessionHeader (field:string, name:string):void {\n    let ok = name.length <= MAX_SESSION_HEADER_LENGTH\n    for (let i = 0; ok && i < name.length; i++) {\n        ok = isTokenChar(name.charCodeAt(i))\n    }\n    if (!ok) {\n        throw new ConfigError(`${field} must be an HTTP header name of at ` +\n            `most ${MAX_SESSION_HEADER_LENGTH} letters, digits, or ` +\n            \"!#$%&'*+-.^_`|~ characters\")\n    }\n    const lower = name.toLowerCase()\n    if (lower.startsWith('x-stainless-') ||\n        RESERVED_SESSION_HEADERS.includes(lower)) {\n        throw new ConfigError(`${field} cannot be ${JSON.stringify(name)}, ` +\n            'which is reserved for credentials, request framing, or a ' +\n            'header Roast or the provider SDK sets')\n    }\n}\n\nconst API_KEY_ENV = /^[A-Za-z_][A-Za-z0-9_]*$/\n\nfunction normalizeProfile (name:string, p:RawProfile):NormalizedProfile {\n    if (name.trim() === '') {\n        throw new ConfigError('inference profile names cannot be empty')\n    }\n    const field = `inference_profiles.${name}`\n    const out:NormalizedProfile = {\n        ...p,\n        protocol:p.protocol || DEFAULT_PROTOCOL,\n        max_output_tokens:p.max_output_tokens || DEFAULT_MAX_OUTPUT_TOKENS,\n    }\n    if (p.api_key_env && !API_KEY_ENV.test(p.api_key_env)) {\n        throw new ConfigError(`${field}.api_key_env is not a valid ` +\n            'environment variable name')\n    }\n    const problem = endpointProblem(field,\n        p.endpoint || defaultBaseUrl(out.protocol), out.protocol,\n        out.max_output_tokens)\n    if (problem) throw new ConfigError(problem)\n    if (p.session_header) {\n        checkSessionHeader(`${field}.session_header`, p.session_header)\n    }\n    return out\n}\n\nfunction normalizeRole (\n    name:string,\n    role:RawRole,\n    profiles:Record<string, NormalizedProfile>\n):RawRole {\n    if (!role.profile) {\n        throw new ConfigError(`roles.${name}.profile is required`)\n    }\n    if (!Object.hasOwn(profiles, role.profile)) {\n        throw new ConfigError(`roles.${name}.profile references unknown ` +\n            `inference profile ${JSON.stringify(role.profile)}`)\n    }\n    if (!role.author_routes) return role\n    const routes = newObject<string>()\n    for (const [rawKey, target] of Object.entries(role.author_routes)) {\n        const key = canonicalFamily(rawKey.trim().toLowerCase())\n        if (key === '') {\n            throw new ConfigError(`roles.${name}.author_routes contains ` +\n                'empty model family')\n        }\n        if (!Object.hasOwn(profiles, target)) {\n            throw new ConfigError(`roles.${name}.author_routes.${key} ` +\n                'references unknown inference profile ' +\n                JSON.stringify(target))\n        }\n        if (Object.hasOwn(routes, key)) {\n            throw new ConfigError(`roles.${name}.author_routes contains ` +\n                `duplicate family ${JSON.stringify(key)}`)\n        }\n        setKey(routes, key, target)\n    }\n    return { ...role, author_routes:routes }\n}\n\nfunction checkFloor (key:string, v:number|undefined):void {\n    if (v !== undefined && (v < 0 || v > 1)) {\n        throw new ConfigError(`${key} must be between 0 and 1 (got ${v})`)\n    }\n}\n\nfunction parseDuration (key:string, s:string|undefined):GoDuration|undefined {\n    if (s === undefined) return undefined\n    let d:GoDuration\n    try {\n        d = parseGoDuration(s)\n    } catch (err) {\n        throw new ConfigError(`${key}: invalid duration ${JSON.stringify(s)}`,\n            { cause:err })\n    }\n    if (d < 0n) throw new ConfigError(`${key} cannot be negative`)\n    return d\n}\n\n// Settings checks in Go's fixed order (spec 02, 2.4).\nfunction validateSettings (raw:RawConfig):void {\n    const ints:[string, number|undefined, number][] = [\n        ['limits.max_total_tokens', raw.limits?.max_total_tokens, 0],\n        ['limits.max_diff_bytes', raw.limits?.max_diff_bytes, 1],\n        ['limits.max_prompt_bytes', raw.limits?.max_prompt_bytes, 1],\n        ['limits.max_file_ctx_bytes', raw.limits?.max_file_ctx_bytes, 1],\n        ['limits.max_attempts', raw.limits?.max_attempts, 1],\n        ['limits.max_verified', raw.limits?.max_verified, 0],\n        ['interactive.min_files', raw.interactive?.min_files, 0],\n        ['interactive.min_diff_lines', raw.interactive?.min_diff_lines, 0],\n        ['gate.timeout_seconds', raw.gate?.timeout_seconds, 0],\n    ]\n    for (const [key, v, min] of ints) {\n        if (v !== undefined && v < min) {\n            throw new ConfigError(\n                `${key} must be an integer >= ${min} (got ${v})`)\n        }\n    }\n    parseDuration('limits.deadline', raw.limits?.deadline)\n    parseDuration('limits.request_timeout', raw.limits?.request_timeout)\n    const severity = raw.gate?.severity\n    if (severity &&\n        !(SEVERITIES as readonly string[]).includes(severity.toUpperCase())) {\n        throw new ConfigError('gate.severity must be INFO, LOW, MEDIUM, ' +\n            `HIGH, or CRITICAL (got ${JSON.stringify(severity)})`)\n    }\n}\n\n// Applies defaults and the checks zod does not express, in Go's order:\n// profiles, roles, confidence floors, then settings.\nexport function normalize (raw:RawConfig, dir:string):ProjectConfig {\n    const profiles = newObject<NormalizedProfile>()\n    for (const [name, p] of Object.entries(raw.inference_profiles ?? {})) {\n        setKey(profiles, name, normalizeProfile(name, p))\n    }\n    const roles:NormalizedConfig['roles'] = {}\n    for (const name of Object.keys(raw.roles ?? {})) {\n        const role = raw.roles?.[name as 'finder'|'verifier']\n        if (role) {\n            roles[name as 'finder'|'verifier'] =\n                normalizeRole(name, role, profiles)\n        }\n    }\n    const review = raw.review ?? {}\n    checkFloor('confidence_floor', review.confidence_floor)\n    checkFloor('quick_confidence_floor', review.quick_confidence_floor)\n    validateSettings(raw)\n    const limits:NormalizedLimits|undefined = raw.limits && {\n        ...raw.limits,\n        deadline:parseDuration('limits.deadline', raw.limits.deadline),\n        request_timeout:parseDuration('limits.request_timeout',\n            raw.limits.request_timeout),\n    }\n    if (limits?.deadline === undefined) delete limits?.deadline\n    if (limits?.request_timeout === undefined) delete limits?.request_timeout\n    return {\n        ...raw,\n        inference_profiles:profiles,\n        roles,\n        review:{\n            ...review,\n            confidence_floor:review.confidence_floor ||\n                DEFAULT_CONFIDENCE_FLOOR,\n            quick_confidence_floor:review.quick_confidence_floor ||\n                DEFAULT_QUICK_CONFIDENCE_FLOOR,\n        },\n        limits,\n        dir,\n    }\n}\n\n// Reads, parses, and validates the config at `file`.\nexport function loadConfig (file:string):ProjectConfig {\n    let text:string\n    try {\n        text = fs.readFileSync(file, 'utf8')\n    } catch (err) {\n        throw new ConfigError(`open config ${file}: ${causeText(err)}`,\n            { cause:err })\n    }\n    let raw:RawConfig\n    try {\n        raw = decode(text)\n    } catch (err) {\n        throw new ConfigError(`parse config ${file}: ${causeText(err)}`,\n            { cause:err })\n    }\n    return normalize(raw, path.resolve(path.dirname(file)))\n}\n\nexport function withStoredCredentials (\n    cfg:ProjectConfig,\n    stored:StoredCredentials\n):ProjectConfig {\n    return { ...cfg, stored }\n}\n\n// The file a prompt override names: relative paths resolve against the\n// config file's directory, so the same file is read wherever Roast runs.\nexport function promptPath (cfg:ProjectConfig, p:string):string {\n    if (p === '' || path.isAbsolute(p) || cfg.dir === '') return p\n    return path.join(cfg.dir, p)\n}\n\n// Every credential variable a profile names, in document order.\nexport function credentialEnvNames (cfg:ProjectConfig):string[] {\n    return Object.values(cfg.inference_profiles)\n        .map(p => p.api_key_env ?? '')\n        .filter(name => name !== '')\n}\n\nexport function snapshotEnabled (cfg:ProjectConfig):boolean {\n    return cfg.review.snapshot ?? true\n}\n\nexport function gateOffers (cfg:ProjectConfig):boolean {\n    return cfg.gate?.offer ?? true\n}\n","numLines":554,"startLine":1,"totalLines":554}},"tool_result_meta":[{"id":"toolu_018sAbu3qmBiKCTky5TXZnwo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
