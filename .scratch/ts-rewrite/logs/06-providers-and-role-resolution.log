tOverrides(role *ResolvedRole, baseURL, protocol *string) bool {\n750:func OverrideEndpoint(roleName string, role ResolvedRole, baseURL, protocol *string) (ResolvedRole, error) {\n760:func rebindCredential(roleName string, role ResolvedRole, crossedProvider bool) (ResolvedRole, error) {\n781:func roleEnvPrefix(roleName string) string {\n787:func providerAPIKeyEnv(protocol string) string {\n798:func sameEndpoint(a, b string) bool {\n811:func InferFamily(model string) string {\n844:func canonicalFamily(family string) string {\n860:func (c Config) ResolveFinderFlip(finder ResolvedRole, authorModel string) (FlipResult, error) {\n904:func ValidateRole(name string, role ResolvedRole) error {\n933:func validateEndpoint(name, baseURL, protocol string, maxOutputTokens int) error {","is_error":false}]},"parent_tool_use_id":null,"session_id":"682f1424-ed5e-4ad8-82df-9c53c97a2745","uuid":"7c76f331-d80c-40d4-ba7d-dfa2e8da88df","timestamp":"2026-11-18T20:10:06.317Z","tool_use_result":{"stdout":"38:func DefaultBaseURL(protocol string) string {\n125:func (s CredentialSource) String() string {\n153:func (r Review) SnapshotEnabled() bool {\n161:func (d *Duration) UnmarshalJSON(data []byte) error {\n204:func (g Gate) Offers() bool {\n237:func (c Config) WithStoredCredentials(store StoredCredentials) Config {\n245:func (c Config) PromptPath(path string) string {\n254:func (c Config) CredentialEnvNames() []string {\n267:func Find(start, stop string) (string, error) {\n299:func canonicalDir(dir string) (string, error) {\n312:func Load(path string) (Config, error) {\n331:func decode(data []byte) (Config, error) {\n358:func decodeStrict(data []byte, out any, knownFields bool) error {\n374:func rejectLiteralCredentials(data []byte) error {\n389:func normalize(cfg Config) (Config, error) {\n443:func validateSettings(cfg Config) error {\n491:func IsLoopbackHost(host string) bool {\n500:func normalizeProfile(name string, profile InferenceProfile) (InferenceProfile, error) {\n540:func validateS