{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jp3afbpA1KmPMy2oA2eBRY","type":"tool_result","content":"package config\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"strings\"\n\t\"testing\"\n)\n\nconst (\n\tambientGateway = \"https://ambient-gateway.example/v1\"\n\tcustomEndpoint = \"https://template-endpoint.example/v1\"\n)\n\n// TestCredentialAndEndpointPrecedence enumerates every combination of\n// profile endpoint, profile credential, ambient provider base URL, role-scoped\n// key, and protocol, and checks each against the documented rule. The\n// provider base URL variables are set in half the cases and must never matter.\nfunc TestCredentialAndEndpointPrecedence(t *testing.T) {\n\ttype expectation struct {\n\t\tendpoint string\n\t\tkey      string\n\t\tkind     string\n\t}\n\tfor _, protocol := range []string{\"responses\", \"chat\", \"anthropic\"} {\n\t\tkeyVar := providerAPIKeyEnv(protocol)\n\t\tfor _, endpoint := range []string{\"unset\", \"default\", \"custom\", \"ambient\"} {\n\t\t\tfor _, credential := range []string{\"none\", \"api_key_env\"} {\n\t\t\t\tfor _, ambientBase := range []bool{false, true} {\n\t\t\t\t\tfor _, roleKey := range []bool{false, true} {\n\t\t\t\t\t\tname := fmt.Sprintf(\"%s/endpoint=%s/credential=%s/base_url_env=%v/role_key=%v\", protocol, endpoint, credential, ambientBase, roleKey)\n\t\t\t\t\t\tt.Run(name, func(t *testing.T) {\n\t\t\t\t\t\t\tclearProviderEnv(t)\n\t\t\t\t\t\t\tt.Setenv(keyVar, \"ambient-key\")\n\t\t\t\t\t\t\tt.Setenv(\"PROFILE_KEY\", \"profile-key\")\n\t\t\t\t\t\t\tif ambientBase {\n\t\t\t\t\t\t\t\tt.Setenv(\"OPENAI_BASE_URL\", ambientGateway)\n\t\t\t\t\t\t\t\tt.Setenv(\"ANTHROPIC_BASE_URL\", ambientGateway)\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif roleKey {\n\t\t\t\t\t\t\t\tt.Setenv(\"ROAST_FINDER_API_KEY\", \"role-key\")\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tprofile := fmt.Sprintf(\"    model: m\\n    protocol: %s\\n\", protocol)\n\t\t\t\t\t\t\tswitch endpoint {\n\t\t\t\t\t\t\tcase \"default\":\n\t\t\t\t\t\t\t\tprofile += \"    endpoint: \" + DefaultBaseURL(protocol) + \"\\n\"\n\t\t\t\t\t\t\tcase \"custom\":\n\t\t\t\t\t\t\t\tprofile += \"    endpoint: \" + customEndpoint + \"\\n\"\n\t\t\t\t\t\t\tcase \"ambient\":\n\t\t\t\t\t\t\t\tprofile += \"    endpoint: \" + ambientGateway + \"\\n\"\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif credential == \"api_key_env\" {\n\t\t\t\t\t\t\t\tprofile += \"    api_key_env: PROFILE_KEY\\n\"\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\trole := resolveFinderProfile(t, profile)\n\n\t\t\t\t\t\t\tvar want expectation\n\t\t\t\t\t\t\tswitch endpoint {\n\t\t\t\t\t\t\tcase \"unset\", \"default\":\n\t\t\t\t\t\t\t\twant.endpoint = DefaultBaseURL(protocol)\n\t\t\t\t\t\t\tcase \"custom\":\n\t\t\t\t\t\t\t\twant.endpoint = customEndpoint\n\t\t\t\t\t\t\tcase \"ambient\":\n\t\t\t\t\t\t\t\twant.endpoint = ambientGateway\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tswitch {\n\t\t\t\t\t\t\tcase roleKey:\n\t\t\t\t\t\t\t\twant.key, want.kind = \"role-key\", CredentialRoleEnv\n\t\t\t\t\t\t\tcase credential == \"api_key_env\":\n\t\t\t\t\t\t\t\twant.key, want.kind = \"profile-key\", CredentialProfileEnv\n\t\t\t\t\t\t\tcase endpoint == \"unset\" || endpoint == \"default\":\n\t\t\t\t\t\t\t\twant.key, want.kind = \"ambient-key\", CredentialProviderEnv\n\t\t\t\t\t\t\tdefault:\n\t\t\t\t\t\t\t\twant.kind = CredentialNone\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif role.BaseURL != want.endpoint || role.APIKey != want.key || role.Credential.Kind != want.kind {\n\t\t\t\t\t\t\t\tt.Fatalf(\"got endpoint=%q key=%q kind=%q, want endpoint=%q key=%q kind=%q\",\n\t\t\t\t\t\t\t\t\trole.BaseURL, role.APIKey, role.Credential.Kind, want.endpoint, want.key, want.kind)\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif want.kind == CredentialNone && role.Credential.Withheld != keyVar {\n\t\t\t\t\t\t\t\tt.Fatalf(\"withheld = %q, want %q\", role.Credential.Withheld, keyVar)\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t})\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\n// TestOpenRouterKeyOnlyAtOpenRouter checks that OPENROUTER_API_KEY reaches\n// a role only on OpenRouter's endpoint, and is reported as withheld\n// everywhere else.\nfunc TestOpenRouterKeyOnlyAtOpenRouter(t *testing.T) {\n\tconst router = \"https://openrouter.ai/api/v1\"\n\tfor name, test := range map[string]struct {\n\t\tendpoint, protocol string\n\t\twantKey            string\n\t}{\n\t\t\"openrouter chat\":      {router, \"chat\", \"router-key\"},\n\t\t\"openrouter responses\": {router, \"responses\", \"router-key\"},\n\t\t\"openrouter slash\":     {router + \"/\", \"chat\", \"router-key\"},\n\t\t\"openrouter anthropic\": {router, \"anthropic\", \"\"},\n\t\t\"custom chat\":          {customEndpoint, \"chat\", \"\"},\n\t\t\"custom anthropic\":     {customEndpoint, \"anthropic\", \"\"},\n\t\t\"openai\":               {DefaultBaseURL(\"chat\"), \"chat\", \"\"},\n\t\t\"anthropic\": {DefaultBaseURL(\"anthropic\"), \"anthropic\",\n\t\t\t\"\"},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tclearProviderEnv(t)\n\t\t\tt.Setenv(\"OPENROUTER_API_KEY\", \"router-key\")\n\t\t\trole := resolveFinderProfile(t, fmt.Sprintf(\n\t\t\t\t\"    endpoint: %s\\n    model: m\\n    protocol: %s\\n\",\n\t\t\t\ttest.endpoint, test.protocol))\n\t\t\tif role.APIKey != test.wantKey {\n\t\t\t\tt.Fatalf(\"key = %q, want %q\", role.APIKey, test.wantKey)\n\t\t\t}\n\t\t\tif test.wantKey != \"\" {\n\t\t\t\tif role.Credential.Env != \"OPENROUTER_API_KEY\" {\n\t\t\t\t\tt.Fatalf(\"source = %+v\", role.Credential)\n\t\t\t\t}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif role.Credential.Withheld != \"OPENROUTER_API_KEY\" {\n\t\t\t\tt.Fatalf(\"withheld = %q, want OPENROUTER_API_KEY\",\n\t\t\t\t\trole.Credential.Withheld)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestTemplateProfileWithoutCredentialNeverReceivesAmbientKey(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"ANTHROPIC_API_KEY\", \"personal-anthropic-key\")\n\tt.Setenv(\"OPENAI_API_KEY\", \"personal-openai-key\")\n\tt.Setenv(\"ANTHROPIC_BASE_URL\", ambientGateway)\n\tfor _, protocol := range []string{\"anthropic\", \"responses\"} {\n\t\trole := resolveFinderProfile(t, fmt.Sprintf(\"    endpoint: %s\\n    model: m\\n    protocol: %s\\n\", customEndpoint, protocol))\n\t\tif role.BaseURL != customEndpoint || role.APIKey != \"\" {\n\t\t\tt.Fatalf(\"%s: endpoint=%q key=%q\", protocol, role.BaseURL, role.APIKey)\n\t\t}\n\t\terr := ValidateRole(\"finder\", role)\n\t\tif err == nil || !strings.Contains(err.Error(), \"is not sent to \"+customEndpoint) || !strings.Contains(err.Error(), \"ROAST_FINDER_API_KEY\") {\n\t\t\tt.Fatalf(\"%s: unexpected validation error %v\", protocol, err)\n\t\t}\n\t}\n}\n\nfunc TestRemovedRoleEnvironmentVariablesAreIgnored(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"OPENAI_API_KEY\", \"ambient\")\n\tfor name, value := range map[string]string{\n\t\t\"ROAST_FINDER_BASE_URL\":          \"https://role.example/v1\",\n\t\t\"ROAST_FINDER_PROTOCOL\":          \"anthropic\",\n\t\t\"ROAST_FINDER_MODEL\":             \"env-model\",\n\t\t\"ROAST_FINDER_MAX_OUTPUT_TOKENS\": \"lots\",\n\t\t\"OPENAI_BASE_URL\":                ambientGateway,\n\t} {\n\t\tt.Setenv(name, value)\n\t}\n\trole := resolveFinderProfile(t, \"    model: m\\n\")\n\tif role.BaseURL != DefaultBaseURL(\"responses\") || role.Protocol != \"responses\" ||\n\t\trole.Model != \"m\" || role.MaxOutputTokens != defaultMaxOutputTokens ||\n\t\trole.APIKey != \"ambient\" {\n\t\tt.Fatalf(\"environment changed the role: %#v\", role)\n\t}\n}\n\nfunc TestEndpointComparisonIgnoresATrailingSlash(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"OPENAI_API_KEY\", \"ambient\")\n\trole := resolveFinderProfile(t, \"    model: m\\n    endpoint: \"+DefaultBaseURL(\"responses\")+\"/\\n\")\n\tif role.APIKey != \"ambient\" {\n\t\tt.Fatalf(\"ambient key withheld from the default endpoint: %#v\", role)\n\t}\n}\n\nfunc TestAuthorRouteProfileUsesTheSameCredentialRule(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"ANTHROPIC_BASE_URL\", ambientGateway)\n\tt.Setenv(\"ANTHROPIC_API_KEY\", \"ambient\")\n\tcfg, err := Load(writeConfig(t, `{\"version\": 1,\n\t\t\"inference_profiles\": {\n\t\t\t\"primary\": {\"model\": \"gpt-primary\"},\n\t\t\t\"independent\": {\"endpoint\": \"`+customEndpoint+`\",\n\t\t\t\t\"model\": \"claude-reviewer\", \"protocol\": \"anthropic\"},\n\t\t\t\"verifier\": {\"model\": \"v\"}},\n\t\t\"roles\": {\n\t\t\t\"finder\": {\"profile\": \"primary\",\n\t\t\t\t\"author_routes\": {\"openai\": \"independent\"}},\n\t\t\t\"verifier\": {\"profile\": \"verifier\"}}}`))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfinder, err := cfg.ResolveRole(\"finder\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tflip, err := cfg.ResolveFinderFlip(finder, \"gpt-author\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif flip.Role.Profile != \"independent\" || flip.Role.BaseURL != customEndpoint || flip.Role.APIKey != \"\" {\n\t\tt.Fatalf(\"author route = %#v\", flip.Role)\n\t}\n}\n\n// TestEndpointFlagOverrides checks where a command-line protocol or endpoint\n// override lands and which credential follows it.\nfunc TestEndpointFlagOverrides(t *testing.T) {\n\tconst gateway = \"https://gateway.example/v1\"\n\tfor name, test := range map[string]struct {\n\t\tprofile      string\n\t\tenv          map[string]string\n\t\tprotocol     string\n\t\tbaseURL      string\n\t\twantEndpoint string\n\t\twantKey      string\n\t}{\n\t\t\"unset endpoint goes to the new provider default\": {\n\t\t\tprofile:      \"    model: m\\n    api_key_env: MY_OPENAI\\n\",\n\t\t\tenv:          map[string]string{\"MY_OPENAI\": \"openai-profile\", \"ANTHROPIC_BASE_URL\": gateway, \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol:     \"anthropic\",\n\t\t\twantEndpoint: DefaultBaseURL(\"anthropic\"), wantKey: \"anthropic-key\",\n\t\t},\n\t\t\"explicit default endpoint with a trailing slash moves\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: \" + DefaultBaseURL(\"responses\") + \"/\\n    api_key_env: MY_OPENAI\\n\",\n\t\t\tenv:          map[string]string{\"MY_OPENAI\": \"openai-profile\", \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol:     \"anthropic\",\n\t\t\twantEndpoint: DefaultBaseURL(\"anthropic\"), wantKey: \"anthropic-key\",\n\t\t},\n\t\t\"explicit custom endpoint stays with its credential\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: \" + customEndpoint + \"\\n    api_key_env: MY_GATEWAY\\n\",\n\t\t\tenv:          map[string]string{\"MY_GATEWAY\": \"gateway-profile\", \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol:     \"anthropic\",\n\t\t\twantEndpoint: customEndpoint, wantKey: \"gateway-profile\",\n\t\t},\n\t\t\"same provider protocol keeps the profile credential\": {\n\t\t\tprofile:      \"    model: m\\n    api_key_env: MY_OPENAI\\n\",\n\t\t\tenv:          map[string]string{\"MY_OPENAI\": \"openai-profile\", \"OPENAI_API_KEY\": \"openai-key\"},\n\t\t\tprotocol:     \"chat\",\n\t\t\twantEndpoint: DefaultBaseURL(\"chat\"), wantKey: \"openai-profile\",\n\t\t},\n\t\t\"endpoint override with a protocol override keeps the profile credential\": {\n\t\t\tprofile:  \"    model: m\\n    api_key_env: MY_OPENAI\\n\",\n\t\t\tenv:      map[string]string{\"MY_OPENAI\": \"openai-profile\", \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol: \"anthropic\", baseURL: \"https://chosen.example/v1\",\n\t\t\twantEndpoint: \"https://chosen.example/v1\", wantKey: \"openai-profile\",\n\t\t},\n\t\t\"endpoint override moves a role off OpenRouter without its key\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: https://openrouter.ai/api/v1\\n    protocol: chat\\n\",\n\t\t\tenv:          map[string]string{\"OPENROUTER_API_KEY\": \"router-key\"},\n\t\t\tbaseURL:      \"https://chosen.example/v1\",\n\t\t\twantEndpoint: \"https://chosen.example/v1\", wantKey: \"\",\n\t\t},\n\t\t\"protocol override on OpenRouter keeps its endpoint and key\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: https://openrouter.ai/api/v1\\n    protocol: chat\\n\",\n\t\t\tenv:          map[string]string{\"OPENROUTER_API_KEY\": \"router-key\", \"OPENAI_API_KEY\": \"openai-key\"},\n\t\t\tprotocol:     \"responses\",\n\t\t\twantEndpoint: \"https://openrouter.ai/api/v1\", wantKey: \"router-key\",\n\t\t},\n\t\t\"anthropic protocol on OpenRouter drops its key\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: https://openrouter.ai/api/v1\\n    protocol: chat\\n\",\n\t\t\tenv:          map[string]string{\"OPENROUTER_API_KEY\": \"router-key\", \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol:     \"anthropic\",\n\t\t\twantEndpoint: \"https://openrouter.ai/api/v1\", wantKey: \"\",\n\t\t},\n\t\t\"endpoint override never carries an ambient key\": {\n\t\t\tprofile:      \"    model: m\\n\",\n\t\t\tenv:          map[string]string{\"OPENAI_API_KEY\": \"openai-key\"},\n\t\t\tbaseURL:      \"https://chosen.example/v1\",\n\t\t\twantEndpoint: \"https://chosen.example/v1\", wantKey: \"\",\n\t\t},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tclearProviderEnv(t)\n\t\t\tfor key, value := range test.env {\n\t\t\t\tt.Setenv(key, value)\n\t\t\t}\n\t\t\tvar baseURL, protocol *string\n\t\t\tif test.protocol != \"\" {\n\t\t\t\tprotocol = &test.protocol\n\t\t\t}\n\t\t\tif test.baseURL != \"\" {\n\t\t\t\tbaseURL = &test.baseURL\n\t\t\t}\n\t\t\trole, err := OverrideEndpoint(\"finder\", resolveFinderProfile(t, test.profile), baseURL, protocol)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif role.BaseURL != test.wantEndpoint || role.APIKey != test.wantKey {\n\t\t\t\tt.Errorf(\"endpoint=%q key=%q source=%v, want endpoint=%q key=%q\", role.BaseURL, role.APIKey, role.Credential, test.wantEndpoint, test.wantKey)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestRebindCredential(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"OPENAI_API_KEY\", \"openai\")\n\tt.Setenv(\"ANTHROPIC_API_KEY\", \"anthropic\")\n\tambient := ResolvedRole{BaseURL: DefaultBaseURL(\"responses\"), Protocol: \"responses\", APIKey: \"openai\", Credential: CredentialSource{Kind: CredentialProviderEnv, Env: \"OPENAI_API_KEY\"}}\n\tprofile := ResolvedRole{BaseURL: customEndpoint, Protocol: \"responses\", APIKey: \"profile\", Credential: CredentialSource{Kind: CredentialProfileEnv, Env: \"PROFILE_KEY\"}}\n\tfor name, test := range map[string]struct {\n\t\trole     ResolvedRole\n\t\tendpoint string\n\t\tprotocol string\n\t\tcrossed  bool\n\t\twantKey  string\n\t}{\n\t\t\"ambient key to custom endpoint\":     {ambient, customEndpoint, \"responses\", false, \"\"},\n\t\t\"ambient key to other provider\":      {ambient, DefaultBaseURL(\"anthropic\"), \"anthropic\", true, \"anthropic\"},\n\t\t\"ambient key protocol on gateway\":    {ambient, DefaultBaseURL(\"responses\"), \"anthropic\", false, \"\"},\n\t\t\"profile key follows explicit flag\":  {profile, \"https://flag.example/v1\", \"responses\", false, \"profile\"},\n\t\t\"profile key stays with provider\":    {profile, DefaultBaseURL(\"anthropic\"), \"anthropic\", true, \"anthropic\"},\n\t\t\"ambient key at the default address\": {ambient, DefaultBaseURL(\"chat\"), \"chat\", false, \"openai\"},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\trole := test.role\n\t\t\trole.BaseURL, role.Protocol = test.endpoint, test.protocol\n\t\t\tgot, err := rebindCredential(\"finder\", role, test.crossed)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif got.APIKey != test.wantKey {\n\t\t\t\tt.Fatalf(\"key = %q from %v, want %q\", got.APIKey, got.Credential, test.wantKey)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestCredentialSourceNeverIncludesSecret(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"PROFILE_KEY\", \"super-secret-value\")\n\trole := resolveFinderProfile(t, \"    model: m\\n    api_key_env: PROFILE_KEY\\n\")\n\tif got := role.Credential.String(); got != \"PROFILE_KEY (profile api_key_env)\" || strings.Contains(got, \"super-secret-value\") {\n\t\tt.Fatalf(\"credential source = %q\", got)\n\t}\n}\n\n// resolveFinderProfile resolves the finder role from one profile body.\nfunc resolveFinderProfile(t *testing.T, profile string) ResolvedRole {\n\tt.Helper()\n\tcfg, err := Load(writeConfig(t, `{\"version\": 1, \"inference_profiles\": {\"finder\": `+\n\t\tprofileJSON(t, profile)+`, \"verifier\": {\"model\": \"v\"}},\n\t\t\"roles\": {\"finder\": {\"profile\": \"finder\"}, \"verifier\": {\"profile\": \"verifier\"}}}`))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\trole, err := cfg.ResolveRole(\"finder\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn role\n}\n\n// profileJSON turns indented \"key: value\" lines into a JSON profile object\n// with string values.\nfunc profileJSON(t *testing.T, lines string) string {\n\tt.Helper()\n\tfields := map[string]string{}\n\tfor line := range strings.Lines(lines) {\n\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \": \")\n\t\tif !ok {\n\t\t\tt.Fatalf(\"malformed profile line %q\", line)\n\t\t}\n\t\tfields[key] = value\n\t}\n\traw, err := json.Marshal(fields)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn string(raw)\n}\n\n// clearProviderEnv blanks the variables resolution reads so one subtest's\n// settings cannot leak into the next.\nfunc clearProviderEnv(t *testing.T) {\n\tt.Helper()\n\tfor _, name := range []string{\n\t\t\"OPENAI_API_KEY\", \"OPENAI_BASE_URL\", \"ANTHROPIC_API_KEY\", \"ANTHROPIC_BASE_URL\",\n\t\t\"OPENROUTER_API_KEY\",\n\t\t\"ROAST_FINDER_API_KEY\", \"ROAST_FINDER_BASE_URL\", \"ROAST_FINDER_PROTOCOL\", \"ROAST_FINDER_MODEL\", \"ROAST_FINDER_MAX_OUTPUT_TOKENS\",\n\t} {\n\t\tt.Setenv(name, \"\")\n\t}\n}\npackage config\n\nimport (\n\t\"slices\"\n\t\"testing\"\n)\n\nfunc TestLookupBuiltinProvider(t *testing.T) {\n\ttests := []struct {\n\t\tname      string\n\t\tendpoint  string\n\t\tprotocols []string\n\t\tkeyEnv    string\n\t\tkeyPage   string\n\t\tlogin     LoginMethod\n\t}{\n\t\t{\"openai\", \"https://api.openai.com/v1\",\n\t\t\t[]string{\"responses\", \"chat\"}, \"OPENAI_API_KEY\",\n\t\t\t\"https://platform.openai.com/api-keys\", LoginPaste},\n\t\t{\"anthropic\", \"https://api.anthropic.com/v1\",\n\t\t\t[]string{\"anthropic\"}, \"ANTHROPIC_API_KEY\",\n\t\t\t\"https://console.anthropic.com/settings/keys\", LoginPaste},\n\t\t{\"openrouter\", \"https://openrouter.ai/api/v1\",\n\t\t\t[]string{\"chat\", \"responses\"}, \"OPENROUTER_API_KEY\",\n\t\t\t\"https://openrouter.ai/settings/keys\", LoginBrowser},\n\t}\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tp, ok := LookupProvider(tt.name)\n\t\t\tif !ok {\n\t\t\t\tt.Fatalf(\"LookupProvider(%q) not found\", tt.name)\n\t\t\t}\n\t\t\tif p.Name != tt.name || p.Endpoint != tt.endpoint ||\n\t\t\t\t!slices.Equal(p.Protocols, tt.protocols) ||\n\t\t\t\tp.KeyEnv != tt.keyEnv || p.KeyPage != tt.keyPage ||\n\t\t\t\tp.Login != tt.login {\n\t\t\t\tt.Fatalf(\"LookupProvider(%q) = %+v\", tt.name, p)\n\t\t\t}\n\t\t})\n\t}\n\tif _, ok := LookupProvider(\"OpenAI\"); ok {\n\t\tt.Fatal(\"provider names are exact\")\n\t}\n}\n\nfunc TestProviderAt(t *testing.T) {\n\ttests := []struct {\n\t\tendpoint, protocol, want string\n\t}{\n\t\t{\"https://api.openai.com/v1\", \"responses\", \"openai\"},\n\t\t{\"https://api.openai.com/v1/\", \"chat\", \"openai\"},\n\t\t{\"HTTPS://API.OPENAI.COM/v1\", \"responses\", \"openai\"},\n\t\t{\"https://api.openai.com/v1\", \"anthropic\", \"\"},\n\t\t{\"https://api.anthropic.com/v1\", \"anthropic\", \"anthropic\"},\n\t\t{\"https://api.anthropic.com/v1\", \"chat\", \"\"},\n\t\t{\"https://api.anthropic.com/v1\", \"responses\", \"\"},\n\t\t{\"https://openrouter.ai/api/v1\", \"chat\", \"openrouter\"},\n\t\t{\"https://openrouter.ai/api/v1\", \"responses\", \"openrouter\"},\n\t\t{\"https://openrouter.ai/api/v1\", \"anthropic\", \"\"},\n\t\t{\"https://gateway.example/v1\", \"responses\", \"\"},\n\t\t{\"http://api.openai.com/v1\", \"responses\", \"\"},\n\t\t{\"https://api.openai.com/v2\", \"responses\", \"\"},\n\t\t{\"\", \"responses\", \"\"},\n\t}\n\tfor _, tt := range tests {\n\t\tgot, ok := ProviderAt(tt.endpoint, tt.protocol)\n\t\tif ok != (tt.want != \"\") || got.Name != tt.want {\n\t\t\tt.Errorf(\"ProviderAt(%q, %q) = %q, %v; want %q\",\n\t\t\t\ttt.endpoint, tt.protocol, got.Name, ok, tt.want)\n\t\t}\n\t}\n}\n\n// TestProviderAtIsUnique checks that every registered endpoint and protocol\n// pair maps back to exactly the provider that registered it.\nfunc TestProviderAtIsUnique(t *testing.T) {\n\tfor _, p := range BuiltinProviders() {\n\t\tfor _, protocol := range p.Protocols {\n\t\t\tgot, ok := ProviderAt(p.Endpoint, protocol)\n\t\t\tif !ok || got.Name != p.Name {\n\t\t\t\tt.Errorf(\"ProviderAt(%q, %q) = %q, %v; want %q\",\n\t\t\t\t\tp.Endpoint, protocol, got.Name, ok, p.Name)\n\t\t\t}\n\t\t}\n\t}\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"682f1424-ed5e-4ad8-82df-9c53c97a2745","uuid":"6f6784b6-2add-43bc-9c40-15400b851e08","timestamp":"2026-11-18T20:10:01.418Z","tool_use_result":{"stdout":"package config\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"strings\"\n\t\"testing\"\n)\n\nconst (\n\tambientGateway = \"https://ambient-gateway.example/v1\"\n\tcustomEndpoint = \"https://template-endpoint.example/v1\"\n)\n\n// TestCredentialAndEndpointPrecedence enumerates every combination of\n// profile endpoint, profile credential, ambient provider base URL, role-scoped\n// key, and protocol, and checks each against the documented rule. The\n// provider base URL variables are set in half the cases and must never matter.\nfunc TestCredentialAndEndpointPrecedence(t *testing.T) {\n\ttype expectation struct {\n\t\tendpoint string\n\t\tkey      string\n\t\tkind     string\n\t}\n\tfor _, protocol := range []string{\"responses\", \"chat\", \"anthropic\"} {\n\t\tkeyVar := providerAPIKeyEnv(protocol)\n\t\tfor _, endpoint := range []string{\"unset\", \"default\", \"custom\", \"ambient\"} {\n\t\t\tfor _, credential := range []string{\"none\", \"api_key_env\"} {\n\t\t\t\tfor _, ambientBase := range []bool{false, true} {\n\t\t\t\t\tfor _, roleKey := range []bool{false, true} {\n\t\t\t\t\t\tname := fmt.Sprintf(\"%s/endpoint=%s/credential=%s/base_url_env=%v/role_key=%v\", protocol, endpoint, credential, ambientBase, roleKey)\n\t\t\t\t\t\tt.Run(name, func(t *testing.T) {\n\t\t\t\t\t\t\tclearProviderEnv(t)\n\t\t\t\t\t\t\tt.Setenv(keyVar, \"ambient-key\")\n\t\t\t\t\t\t\tt.Setenv(\"PROFILE_KEY\", \"profile-key\")\n\t\t\t\t\t\t\tif ambientBase {\n\t\t\t\t\t\t\t\tt.Setenv(\"OPENAI_BASE_URL\", ambientGateway)\n\t\t\t\t\t\t\t\tt.Setenv(\"ANTHROPIC_BASE_URL\", ambientGateway)\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif roleKey {\n\t\t\t\t\t\t\t\tt.Setenv(\"ROAST_FINDER_API_KEY\", \"role-key\")\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tprofile := fmt.Sprintf(\"    model: m\\n    protocol: %s\\n\", protocol)\n\t\t\t\t\t\t\tswitch endpoint {\n\t\t\t\t\t\t\tcase \"default\":\n\t\t\t\t\t\t\t\tprofile += \"    endpoint: \" + DefaultBaseURL(protocol) + \"\\n\"\n\t\t\t\t\t\t\tcase \"custom\":\n\t\t\t\t\t\t\t\tprofile += \"    endpoint: \" + customEndpoint + \"\\n\"\n\t\t\t\t\t\t\tcase \"ambient\":\n\t\t\t\t\t\t\t\tprofile += \"    endpoint: \" + ambientGateway + \"\\n\"\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif credential == \"api_key_env\" {\n\t\t\t\t\t\t\t\tprofile += \"    api_key_env: PROFILE_KEY\\n\"\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\trole := resolveFinderProfile(t, profile)\n\n\t\t\t\t\t\t\tvar want expectation\n\t\t\t\t\t\t\tswitch endpoint {\n\t\t\t\t\t\t\tcase \"unset\", \"default\":\n\t\t\t\t\t\t\t\twant.endpoint = DefaultBaseURL(protocol)\n\t\t\t\t\t\t\tcase \"custom\":\n\t\t\t\t\t\t\t\twant.endpoint = customEndpoint\n\t\t\t\t\t\t\tcase \"ambient\":\n\t\t\t\t\t\t\t\twant.endpoint = ambientGateway\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tswitch {\n\t\t\t\t\t\t\tcase roleKey:\n\t\t\t\t\t\t\t\twant.key, want.kind = \"role-key\", CredentialRoleEnv\n\t\t\t\t\t\t\tcase credential == \"api_key_env\":\n\t\t\t\t\t\t\t\twant.key, want.kind = \"profile-key\", CredentialProfileEnv\n\t\t\t\t\t\t\tcase endpoint == \"unset\" || endpoint == \"default\":\n\t\t\t\t\t\t\t\twant.key, want.kind = \"ambient-key\", CredentialProviderEnv\n\t\t\t\t\t\t\tdefault:\n\t\t\t\t\t\t\t\twant.kind = CredentialNone\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif role.BaseURL != want.endpoint || role.APIKey != want.key || role.Credential.Kind != want.kind {\n\t\t\t\t\t\t\t\tt.Fatalf(\"got endpoint=%q key=%q kind=%q, want endpoint=%q key=%q kind=%q\",\n\t\t\t\t\t\t\t\t\trole.BaseURL, role.APIKey, role.Credential.Kind, want.endpoint, want.key, want.kind)\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tif want.kind == CredentialNone && role.Credential.Withheld != keyVar {\n\t\t\t\t\t\t\t\tt.Fatalf(\"withheld = %q, want %q\", role.Credential.Withheld, keyVar)\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t})\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\n// TestOpenRouterKeyOnlyAtOpenRouter checks that OPENROUTER_API_KEY reaches\n// a role only on OpenRouter's endpoint, and is reported as withheld\n// everywhere else.\nfunc TestOpenRouterKeyOnlyAtOpenRouter(t *testing.T) {\n\tconst router = \"https://openrouter.ai/api/v1\"\n\tfor name, test := range map[string]struct {\n\t\tendpoint, protocol string\n\t\twantKey            string\n\t}{\n\t\t\"openrouter chat\":      {router, \"chat\", \"router-key\"},\n\t\t\"openrouter responses\": {router, \"responses\", \"router-key\"},\n\t\t\"openrouter slash\":     {router + \"/\", \"chat\", \"router-key\"},\n\t\t\"openrouter anthropic\": {router, \"anthropic\", \"\"},\n\t\t\"custom chat\":          {customEndpoint, \"chat\", \"\"},\n\t\t\"custom anthropic\":     {customEndpoint, \"anthropic\", \"\"},\n\t\t\"openai\":               {DefaultBaseURL(\"chat\"), \"chat\", \"\"},\n\t\t\"anthropic\": {DefaultBaseURL(\"anthropic\"), \"anthropic\",\n\t\t\t\"\"},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tclearProviderEnv(t)\n\t\t\tt.Setenv(\"OPENROUTER_API_KEY\", \"router-key\")\n\t\t\trole := resolveFinderProfile(t, fmt.Sprintf(\n\t\t\t\t\"    endpoint: %s\\n    model: m\\n    protocol: %s\\n\",\n\t\t\t\ttest.endpoint, test.protocol))\n\t\t\tif role.APIKey != test.wantKey {\n\t\t\t\tt.Fatalf(\"key = %q, want %q\", role.APIKey, test.wantKey)\n\t\t\t}\n\t\t\tif test.wantKey != \"\" {\n\t\t\t\tif role.Credential.Env != \"OPENROUTER_API_KEY\" {\n\t\t\t\t\tt.Fatalf(\"source = %+v\", role.Credential)\n\t\t\t\t}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif role.Credential.Withheld != \"OPENROUTER_API_KEY\" {\n\t\t\t\tt.Fatalf(\"withheld = %q, want OPENROUTER_API_KEY\",\n\t\t\t\t\trole.Credential.Withheld)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestTemplateProfileWithoutCredentialNeverReceivesAmbientKey(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"ANTHROPIC_API_KEY\", \"personal-anthropic-key\")\n\tt.Setenv(\"OPENAI_API_KEY\", \"personal-openai-key\")\n\tt.Setenv(\"ANTHROPIC_BASE_URL\", ambientGateway)\n\tfor _, protocol := range []string{\"anthropic\", \"responses\"} {\n\t\trole := resolveFinderProfile(t, fmt.Sprintf(\"    endpoint: %s\\n    model: m\\n    protocol: %s\\n\", customEndpoint, protocol))\n\t\tif role.BaseURL != customEndpoint || role.APIKey != \"\" {\n\t\t\tt.Fatalf(\"%s: endpoint=%q key=%q\", protocol, role.BaseURL, role.APIKey)\n\t\t}\n\t\terr := ValidateRole(\"finder\", role)\n\t\tif err == nil || !strings.Contains(err.Error(), \"is not sent to \"+customEndpoint) || !strings.Contains(err.Error(), \"ROAST_FINDER_API_KEY\") {\n\t\t\tt.Fatalf(\"%s: unexpected validation error %v\", protocol, err)\n\t\t}\n\t}\n}\n\nfunc TestRemovedRoleEnvironmentVariablesAreIgnored(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"OPENAI_API_KEY\", \"ambient\")\n\tfor name, value := range map[string]string{\n\t\t\"ROAST_FINDER_BASE_URL\":          \"https://role.example/v1\",\n\t\t\"ROAST_FINDER_PROTOCOL\":          \"anthropic\",\n\t\t\"ROAST_FINDER_MODEL\":             \"env-model\",\n\t\t\"ROAST_FINDER_MAX_OUTPUT_TOKENS\": \"lots\",\n\t\t\"OPENAI_BASE_URL\":                ambientGateway,\n\t} {\n\t\tt.Setenv(name, value)\n\t}\n\trole := resolveFinderProfile(t, \"    model: m\\n\")\n\tif role.BaseURL != DefaultBaseURL(\"responses\") || role.Protocol != \"responses\" ||\n\t\trole.Model != \"m\" || role.MaxOutputTokens != defaultMaxOutputTokens ||\n\t\trole.APIKey != \"ambient\" {\n\t\tt.Fatalf(\"environment changed the role: %#v\", role)\n\t}\n}\n\nfunc TestEndpointComparisonIgnoresATrailingSlash(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"OPENAI_API_KEY\", \"ambient\")\n\trole := resolveFinderProfile(t, \"    model: m\\n    endpoint: \"+DefaultBaseURL(\"responses\")+\"/\\n\")\n\tif role.APIKey != \"ambient\" {\n\t\tt.Fatalf(\"ambient key withheld from the default endpoint: %#v\", role)\n\t}\n}\n\nfunc TestAuthorRouteProfileUsesTheSameCredentialRule(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"ANTHROPIC_BASE_URL\", ambientGateway)\n\tt.Setenv(\"ANTHROPIC_API_KEY\", \"ambient\")\n\tcfg, err := Load(writeConfig(t, `{\"version\": 1,\n\t\t\"inference_profiles\": {\n\t\t\t\"primary\": {\"model\": \"gpt-primary\"},\n\t\t\t\"independent\": {\"endpoint\": \"`+customEndpoint+`\",\n\t\t\t\t\"model\": \"claude-reviewer\", \"protocol\": \"anthropic\"},\n\t\t\t\"verifier\": {\"model\": \"v\"}},\n\t\t\"roles\": {\n\t\t\t\"finder\": {\"profile\": \"primary\",\n\t\t\t\t\"author_routes\": {\"openai\": \"independent\"}},\n\t\t\t\"verifier\": {\"profile\": \"verifier\"}}}`))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfinder, err := cfg.ResolveRole(\"finder\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tflip, err := cfg.ResolveFinderFlip(finder, \"gpt-author\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif flip.Role.Profile != \"independent\" || flip.Role.BaseURL != customEndpoint || flip.Role.APIKey != \"\" {\n\t\tt.Fatalf(\"author route = %#v\", flip.Role)\n\t}\n}\n\n// TestEndpointFlagOverrides checks where a command-line protocol or endpoint\n// override lands and which credential follows it.\nfunc TestEndpointFlagOverrides(t *testing.T) {\n\tconst gateway = \"https://gateway.example/v1\"\n\tfor name, test := range map[string]struct {\n\t\tprofile      string\n\t\tenv          map[string]string\n\t\tprotocol     string\n\t\tbaseURL      string\n\t\twantEndpoint string\n\t\twantKey      string\n\t}{\n\t\t\"unset endpoint goes to the new provider default\": {\n\t\t\tprofile:      \"    model: m\\n    api_key_env: MY_OPENAI\\n\",\n\t\t\tenv:          map[string]string{\"MY_OPENAI\": \"openai-profile\", \"ANTHROPIC_BASE_URL\": gateway, \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol:     \"anthropic\",\n\t\t\twantEndpoint: DefaultBaseURL(\"anthropic\"), wantKey: \"anthropic-key\",\n\t\t},\n\t\t\"explicit default endpoint with a trailing slash moves\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: \" + DefaultBaseURL(\"responses\") + \"/\\n    api_key_env: MY_OPENAI\\n\",\n\t\t\tenv:          map[string]string{\"MY_OPENAI\": \"openai-profile\", \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol:     \"anthropic\",\n\t\t\twantEndpoint: DefaultBaseURL(\"anthropic\"), wantKey: \"anthropic-key\",\n\t\t},\n\t\t\"explicit custom endpoint stays with its credential\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: \" + customEndpoint + \"\\n    api_key_env: MY_GATEWAY\\n\",\n\t\t\tenv:          map[string]string{\"MY_GATEWAY\": \"gateway-profile\", \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol:     \"anthropic\",\n\t\t\twantEndpoint: customEndpoint, wantKey: \"gateway-profile\",\n\t\t},\n\t\t\"same provider protocol keeps the profile credential\": {\n\t\t\tprofile:      \"    model: m\\n    api_key_env: MY_OPENAI\\n\",\n\t\t\tenv:          map[string]string{\"MY_OPENAI\": \"openai-profile\", \"OPENAI_API_KEY\": \"openai-key\"},\n\t\t\tprotocol:     \"chat\",\n\t\t\twantEndpoint: DefaultBaseURL(\"chat\"), wantKey: \"openai-profile\",\n\t\t},\n\t\t\"endpoint override with a protocol override keeps the profile credential\": {\n\t\t\tprofile:  \"    model: m\\n    api_key_env: MY_OPENAI\\n\",\n\t\t\tenv:      map[string]string{\"MY_OPENAI\": \"openai-profile\", \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol: \"anthropic\", baseURL: \"https://chosen.example/v1\",\n\t\t\twantEndpoint: \"https://chosen.example/v1\", wantKey: \"openai-profile\",\n\t\t},\n\t\t\"endpoint override moves a role off OpenRouter without its key\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: https://openrouter.ai/api/v1\\n    protocol: chat\\n\",\n\t\t\tenv:          map[string]string{\"OPENROUTER_API_KEY\": \"router-key\"},\n\t\t\tbaseURL:      \"https://chosen.example/v1\",\n\t\t\twantEndpoint: \"https://chosen.example/v1\", wantKey: \"\",\n\t\t},\n\t\t\"protocol override on OpenRouter keeps its endpoint and key\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: https://openrouter.ai/api/v1\\n    protocol: chat\\n\",\n\t\t\tenv:          map[string]string{\"OPENROUTER_API_KEY\": \"router-key\", \"OPENAI_API_KEY\": \"openai-key\"},\n\t\t\tprotocol:     \"responses\",\n\t\t\twantEndpoint: \"https://openrouter.ai/api/v1\", wantKey: \"router-key\",\n\t\t},\n\t\t\"anthropic protocol on OpenRouter drops its key\": {\n\t\t\tprofile:      \"    model: m\\n    endpoint: https://openrouter.ai/api/v1\\n    protocol: chat\\n\",\n\t\t\tenv:          map[string]string{\"OPENROUTER_API_KEY\": \"router-key\", \"ANTHROPIC_API_KEY\": \"anthropic-key\"},\n\t\t\tprotocol:     \"anthropic\",\n\t\t\twantEndpoint: \"https://openrouter.ai/api/v1\", wantKey: \"\",\n\t\t},\n\t\t\"endpoint override never carries an ambient key\": {\n\t\t\tprofile:      \"    model: m\\n\",\n\t\t\tenv:          map[string]string{\"OPENAI_API_KEY\": \"openai-key\"},\n\t\t\tbaseURL:      \"https://chosen.example/v1\",\n\t\t\twantEndpoint: \"https://chosen.example/v1\", wantKey: \"\",\n\t\t},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tclearProviderEnv(t)\n\t\t\tfor key, value := range test.env {\n\t\t\t\tt.Setenv(key, value)\n\t\t\t}\n\t\t\tvar baseURL, protocol *string\n\t\t\tif test.protocol != \"\" {\n\t\t\t\tprotocol = &test.protocol\n\t\t\t}\n\t\t\tif test.baseURL != \"\" {\n\t\t\t\tbaseURL = &test.baseURL\n\t\t\t}\n\t\t\trole, err := OverrideEndpoint(\"finder\", resolveFinderProfile(t, test.profile), baseURL, protocol)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif role.BaseURL != test.wantEndpoint || role.APIKey != test.wantKey {\n\t\t\t\tt.Errorf(\"endpoint=%q key=%q source=%v, want endpoint=%q key=%q\", role.BaseURL, role.APIKey, role.Credential, test.wantEndpoint, test.wantKey)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestRebindCredential(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"OPENAI_API_KEY\", \"openai\")\n\tt.Setenv(\"ANTHROPIC_API_KEY\", \"anthropic\")\n\tambient := ResolvedRole{BaseURL: DefaultBaseURL(\"responses\"), Protocol: \"responses\", APIKey: \"openai\", Credential: CredentialSource{Kind: CredentialProviderEnv, Env: \"OPENAI_API_KEY\"}}\n\tprofile := ResolvedRole{BaseURL: customEndpoint, Protocol: \"responses\", APIKey: \"profile\", Credential: CredentialSource{Kind: CredentialProfileEnv, Env: \"PROFILE_KEY\"}}\n\tfor name, test := range map[string]struct {\n\t\trole     ResolvedRole\n\t\tendpoint string\n\t\tprotocol string\n\t\tcrossed  bool\n\t\twantKey  string\n\t}{\n\t\t\"ambient key to custom endpoint\":     {ambient, customEndpoint, \"responses\", false, \"\"},\n\t\t\"ambient key to other provider\":      {ambient, DefaultBaseURL(\"anthropic\"), \"anthropic\", true, \"anthropic\"},\n\t\t\"ambient key protocol on gateway\":    {ambient, DefaultBaseURL(\"responses\"), \"anthropic\", false, \"\"},\n\t\t\"profile key follows explicit flag\":  {profile, \"https://flag.example/v1\", \"responses\", false, \"profile\"},\n\t\t\"profile key stays with provider\":    {profile, DefaultBaseURL(\"anthropic\"), \"anthropic\", true, \"anthropic\"},\n\t\t\"ambient key at the default address\": {ambient, DefaultBaseURL(\"chat\"), \"chat\", false, \"openai\"},\n\t} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\trole := test.role\n\t\t\trole.BaseURL, role.Protocol = test.endpoint, test.protocol\n\t\t\tgot, err := rebindCredential(\"finder\", role, test.crossed)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif got.APIKey != test.wantKey {\n\t\t\t\tt.Fatalf(\"key = %q from %v, want %q\", got.APIKey, got.Credential, test.wantKey)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestCredentialSourceNeverIncludesSecret(t *testing.T) {\n\tclearProviderEnv(t)\n\tt.Setenv(\"PROFILE_KEY\", \"super-secret-value\")\n\trole := resolveFinderProfile(t, \"    model: m\\n    api_key_env: PROFILE_KEY\\n\")\n\tif got := role.Credential.String(); got != \"PROFILE_KEY (profile api_key_env)\" || strings.Contains(got, \"super-secret-value\") {\n\t\tt.Fatalf(\"credential source = %q\", got)\n\t}\n}\n\n// resolveFinderProfile resolves the finder role from one profile body.\nfunc resolveFinderProfile(t *testing.T, profile string) ResolvedRole {\n\tt.Helper()\n\tcfg, err := Load(writeConfig(t, `{\"version\": 1, \"inference_profiles\": {\"finder\": `+\n\t\tprofileJSON(t, profile)+`, \"verifier\": {\"model\": \"v\"}},\n\t\t\"roles\": {\"finder\": {\"profile\": \"finder\"}, \"verifier\": {\"profile\": \"verifier\"}}}`))\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\trole, err := cfg.ResolveRole(\"finder\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn role\n}\n\n// profileJSON turns indented \"key: value\" lines into a JSON profile object\n// with string values.\nfunc profileJSON(t *testing.T, lines string) string {\n\tt.Helper()\n\tfields := map[string]string{}\n\tfor line := range strings.Lines(lines) {\n\t\tkey, value, ok := strings.Cut(strings.TrimSpace(line), \": \")\n\t\tif !ok {\n\t\t\tt.Fatalf(\"malformed profile line %q\", line)\n\t\t}\n\t\tfields[key] = value\n\t}\n\traw, err := json.Marshal(fields)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn string(raw)\n}\n\n// clearProviderEnv blanks the variables resolution reads so one subtest's\n// settings cannot leak into the next.\nfunc clearProviderEnv(t *testing.T) {\n\tt.Helper()\n\tfor _, name := range []string{\n\t\t\"OPENAI_API_KEY\", \"OPENAI_BASE_URL\", \"ANTHROPIC_API_KEY\", \"ANTHROPIC_BASE_URL\",\n\t\t\"OPENROUTER_API_KEY\",\n\t\t\"ROAST_FINDER_API_KEY\", \"ROAST_FINDER_BASE_URL\", \"ROAST_FINDER_PROTOCOL\", \"ROAST_FINDER_MODEL\", \"ROAST_FINDER_MAX_OUTPUT_TOKENS\",\n\t} {\n\t\tt.Setenv(name, \"\")\n\t}\n}\npackage config\n\nimport (\n\t\"slices\"\n\t\"testing\"\n)\n\nfunc TestLookupBuiltinProvider(t *testing.T) {\n\ttests := []struct {\n\t\tname      string\n\t\tendpoint  string\n\t\tprotocols []string\n\t\tkeyEnv    string\n\t\tkeyPage   string\n\t\tlogin     LoginMethod\n\t}{\n\t\t{\"openai\", \"https://api.openai.com/v1\",\n\t\t\t[]string{\"responses\", \"chat\"}, \"OPENAI_API_KEY\",\n\t\t\t\"https://platform.openai.com/api-keys\", LoginPaste},\n\t\t{\"anthropic\", \"https://api.anthropic.com/v1\",\n\t\t\t[]string{\"anthropic\"}, \"ANTHROPIC_API_KEY\",\n\t\t\t\"https://console.anthropic.com/settings/keys\", LoginPaste},\n\t\t{\"openrouter\", \"https://openrouter.ai/api/v1\",\n\t\t\t[]string{\"chat\", \"responses\"}, \"OPENROUTER_API_KEY\",\n\t\t\t\"https://openrouter.ai/settings/keys\", LoginBrowser},\n\t}\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tp, ok := LookupProvider(tt.name)\n\t\t\tif !ok {\n\t\t\t\tt.Fatalf(\"LookupProvider(%q) not found\", tt.name)\n\t\t\t}\n\t\t\tif p.Name != tt.name || p.Endpoint != tt.endpoint ||\n\t\t\t\t!slices.Equal(p.Protocols, tt.protocols) ||\n\t\t\t\tp.KeyEnv != tt.keyEnv || p.KeyPage != tt.keyPage ||\n\t\t\t\tp.Login != tt.login {\n\t\t\t\tt.Fatalf(\"LookupProvider(%q) = %+v\", tt.name, p)\n\t\t\t}\n\t\t})\n\t}\n\tif _, ok := LookupProvider(\"OpenAI\"); ok {\n\t\tt.Fatal(\"provider names are exact\")\n\t}\n}\n\nfunc TestProviderAt(t *testing.T) {\n\ttests := []struct {\n\t\tendpoint, protocol, want string\n\t}{\n\t\t{\"https://api.openai.com/v1\", \"responses\", \"openai\"},\n\t\t{\"https://api.openai.com/v1/\", \"chat\", \"openai\"},\n\t\t{\"HTTPS://API.OPENAI.COM/v1\", \"responses\", \"openai\"},\n\t\t{\"https://api.openai.com/v1\", \"anthropic\", \"\"},\n\t\t{\"https://api.anthropic.com/v1\", \"anthropic\", \"anthropic\"},\n\t\t{\"https://api.anthropic.com/v1\", \"chat\", \"\"},\n\t\t{\"https://api.anthropic.com/v1\", \"responses\", \"\"},\n\t\t{\"https://openrouter.ai/api/v1\", \"chat\", \"openrouter\"},\n\t\t{\"https://openrouter.ai/api/v1\", \"responses\", \"openrouter\"},\n\t\t{\"https://openrouter.ai/api/v1\", \"anthropic\", \"\"},\n\t\t{\"https://gateway.example/v1\", \"responses\", \"\"},\n\t\t{\"http://api.openai.com/v1\", \"responses\", \"\"},\n\t\t{\"https://api.openai.com/v2\", \"responses\", \"\"},\n\t\t{\"\", \"responses\", \"\"},\n\t}\n\tfor _, tt := range tests {\n\t\tgot, ok := ProviderAt(tt.endpoint, tt.protocol)\n\t\tif ok != (tt.want != \"\") || got.Name != tt.want {\n\t\t\tt.Errorf(\"ProviderAt(%q, %q) = %q, %v; want %q\",\n\t\t\t\ttt.endpoint, tt.protocol, got.Name, ok, tt.want)\n\t\t}\n\t}\n}\n\n// TestProviderAtIsUnique checks that every registered endpoint and protocol\n// pair maps back to exactly the provider that registered it.\nfunc TestProviderAtIsUnique(t *testing.T) {\n\tfor _, p := range BuiltinProviders() {\n\t\tfor _, protocol := range p.Protocols {\n\t\t\tgot, ok := ProviderAt(p.Endpoint, protocol)\n\t\t\tif !ok || got.Name != p.Name {\n\t\t\t\tt.Errorf(\"ProviderAt(%q, %q) = %q, %v; want %q\",\n\t\t\t\t\tp.Endpoint, protocol, got.Name, ok, p.Name)\n\t\t\t}\n\t\t}\n\t}\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Jp3afbpA1KmPMy2oA2eBRY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
