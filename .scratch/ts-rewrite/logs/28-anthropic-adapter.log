    const turn:ModelTurn = {\n        parts,\n        finishReason,\n        usage:normalizeUsage(chatUsage(usage)),\n    }\n    if (rawFinish !== '' && RAW_EXPOSED.has(finishReason)) {\n        turn.rawFinishReason = rawFinish\n    }\n    if (ordered.length > 0 && SUPPRESS_CALLS.has(finishReason)) {\n        turn.rawFinishReason = rawFinish\n        return turn\n    }\n    for (const c of ordered) {\n        parts.push({\n            type:'tool-call',\n            id:c.id,\n            name:c.name,\n            input:c.args === '' ? '{}' : c.args,\n        })\n    }\n    return turn\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0195JZF6mhRrg8hU6nAhfTww","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
