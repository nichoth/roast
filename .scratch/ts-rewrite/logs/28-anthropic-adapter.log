{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HxFd23FdThsciSJtMHUS6q","type":"tool_result","content":"// The agent loop over the real `chat` adapter against the fake inference\n// server (spec 07, 5.2, 5.5, and 5.6 [HTTP] items).\nimport type { ServerResponse } from 'node:http'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport {\n    startInferenceServer,\n    type InferenceServer,\n    type Script,\n} from '../helpers/inference-server.js'\nimport { createClient, createModelClient } from '../../src/llm/client.js'\nimport type { LlmError } from '../../src/llm/errors.js'\nimport { hasSentinel } from '../../src/llm/errors.js'\nimport type { ClientConfig } from '../../src/llm/types.js'\nimport {\n    failure,\n    finalTool,\n    options,\n    readTool,\n    signal,\n} from './agent-helpers.js'\n\nasync function server (t:CleanupTest, script:Script):Promise<InferenceServer> {\n    const s = await startInferenceServer(script)\n    t.cleanup(() => s.close())\n    return s\n}\n\nfunction cfg (url:string, over:Partial<ClientConfig> = {}):ClientConfig {\n    return {\n        role:'finder',\n        baseUrl:`${url}/v1`,\n        apiKey:'sk-test',\n        model:'deepseek-chat',\n        protocol:'chat',\n        maxOutputTokens:4096,\n        maxAttempts:0,\n        requestTimeoutMs:0,\n        ...over,\n    }\n}\n\nconst USAGE = { prompt_tokens:10, completion_tokens:2, total_tokens:12 }\n\nfunction response (\n    message:Record<string, unknown>,\n    finish:string,\n    usage:unknown = USAGE\n) {\n    return {\n        id:'c1',\n        model:'m',\n        choices:[{\n            index:0,\n            message:{ role:'assistant', ...message },\n            finish_reason:finish,\n        }],\n        usage,\n    }\n}\n\nfunction toolCall (name:string, args:unknown, id = 'call-1') {\n    return response({\n        tool_calls:[{\n            id,\n            type:'function',\n            function:{ name, arguments:JSON.stringify(args) },\n        }],\n    }, 'tool_calls')\n}\n\nfunction client (url:string, over:Partial<ClientConfig> = {}) {\n    return createClient(createModelClient(cfg(url, over)), {\n        sleep:async () => {},\n    })\n}\n\ntest('http: usage normalization through Client.usage()', async t => {\n    const s = await server(t, () => ({\n        stream:{\n            ...toolCall('submit', { summary:'ok' }),\n20:export function weightedTokens (usage:Usage):number {\n27:export class Ledger {\n76:export function newLedger (limit:number):Ledger|null {\n84:export function reserve (\n94:export function committed (","is_error":false}]},"parent_tool_use_id":null,"session_id":"ce6241dd-6cf9-4ea5-b772-4d4bcdb98f32","uuid":"6d0ad7ae-b176-4f6e-be42-845fa860359f","timestamp":"2026-11-24T02:49:38.943Z","tool_use_result":{"stdout":"// The agent loop over the real `chat` adapter against the fake inference\n// server (spec 07, 5.2, 5.5, and 5.6 [HTTP] items).\nimport type { ServerResponse } from 'node:http'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport {\n    startInferenceServer,\n    type InferenceServer,\n    type Script,\n} from '../helpers/inference-server.js'\nimport { createClient, createModelClient } from '../../src/llm/client.js'\nimport type { LlmError } from '../../src/llm/errors.js'\nimport { hasSentinel } from '../../src/llm/errors.js'\nimport type { ClientConfig } from '../../src/llm/types.js'\nimport {\n    failure,\n    finalTool,\n    options,\n    readTool,\n    signal,\n} from './agent-helpers.js'\n\nasync function server (t:CleanupTest, script:Script):Promise<InferenceServer> {\n    const s = await startInferenceServer(script)\n    t.cleanup(() => s.close())\n    return s\n}\n\nfunction cfg (url:string, over:Partial<ClientConfig> = {}):ClientConfig {\n    return {\n        role:'finder',\n        baseUrl:`${url}/v1`,\n        apiKey:'sk-test',\n        model:'deepseek-chat',\n        protocol:'chat',\n        maxOutputTokens:4096,\n        maxAttempts:0,\n        requestTimeoutMs:0,\n        ...over,\n    }\n}\n\nconst USAGE = { prompt_tokens:10, completion_tokens:2, total_tokens:12 }\n\nfunction response (\n    message:Record<string, unknown>,\n    finish:string,\n    usage:unknown = USAGE\n) {\n    return {\n        id:'c1',\n        model:'m',\n        choices:[{\n            index:0,\n            message:{ role:'assistant', ...message },\n            finish_reason:finish,\n        }],\n        usage,\n    }\n}\n\nfunction toolCall (name:string, args:unknown, id = 'call-1') {\n    return response({\n        tool_calls:[{\n            id,\n            type:'function',\n            function:{ name, arguments:JSON.stringify(args) },\n        }],\n    }, 'tool_calls')\n}\n\nfunction client (url:string, over:Partial<ClientConfig> = {}) {\n    return createClient(createModelClient(cfg(url, over)), {\n        sleep:async () => {},\n    })\n}\n\ntest('http: usage normalization through Client.usage()', async t => {\n    const s = await server(t, () => ({\n        stream:{\n            ...toolCall('submit', { summary:'ok' }),\n20:export function weightedTokens (usage:Usage):number {\n27:export class Ledger {\n76:export function newLedger (limit:number):Ledger|null {\n84:export function reserve (\n94:export function committed (","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HxFd23FdThsciSJtMHUS6q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
