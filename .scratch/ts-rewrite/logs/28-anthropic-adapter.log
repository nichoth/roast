{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017nz6CqFTZxd2ZjjRedhmTm","type":"tool_result","content":"1\t// pattern: Imperative Shell\n2\t// Chat fake that requires automatic choice and a stable probe prefix.\n3\timport type { RecordedRequest, Reply, Script }\n4\t    from './inference-server.js'\n5\t\n6\texport function probeCall (name:string, args:unknown):Reply {\n7\t    return {\n8\t        stream:{\n9\t            choices:[{\n10\t                index:0,\n11\t                message:{\n12\t                    role:'assistant',\n13\t                    tool_calls:[{\n14\t                        id:'doctor-call',\n15\t                        type:'function',\n16\t                        function:{ name, arguments:JSON.stringify(args) },\n17\t                    }]\n18\t                },\n19\t                finish_reason:'tool_calls',\n20\t            }],\n21\t        }\n22\t    }\n23\t}\n24\t\n25\texport function doctorProbe ():Script {\n26\t    const prefixes = new Map<string, { messages:unknown[], tools:unknown }>()\n27\t    return (req:RecordedRequest) => {\n28\t        const body = req.body as {\n29\t            messages:Record<string, unknown>[],\n30\t            tools:unknown,\n31\t            tool_choice?:unknown,\n32\t        }\n33\t        if (body.tool_choice !== undefined && body.tool_choice !== 'auto') {\n34\t            return { status:400, body:'forced tool choice' }\n35\t        }\n36\t        const messages = body.messages\n37\t        const result = messages.find(m => m.role === 'tool')\n38\t        const key = String(req.headers.authorization)\n39\t        if (!result) {\n40\t            prefixes.set(key, { messages, tools:body.tools })\n41\t            return probeCall('doctor_lookup', {})\n42\t        }\n43\t        const prefix = prefixes.get(key)\n44\t        if (!prefix || JSON.stringify(body.tools) !==\n45\t            JSON.stringify(prefix.tools) ||\n46\t            JSON.stringify(messages.slice(0, prefix.messages.length)) !==\n47\t            JSON.stringify(prefix.messages)) {\n48\t            return { status:400, body:'changed conversation prefix' }\n49\t        }\n50\t        const token = JSON.parse(String(result.content)).token\n51\t        return probeCall('doctor_probe', { ok:true, token })\n52\t    }\n53\t}\n54\t"}]},"parent_tool_use_id":null,"session_id":"ce6241dd-6cf9-4ea5-b772-4d4bcdb98f32","uuid":"9f66481e-0b18-4e27-9633-217e914b8742","timestamp":"2026-11-24T03:10:17.805Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/nick/code/roast.ts-rewrite-28-anthropic-adapter/test/helpers/doctor-probe.ts","content":"// pattern: Imperative Shell\n// Chat fake that requires automatic choice and a stable probe prefix.\nimport type { RecordedRequest, Reply, Script }\n    from './inference-server.js'\n\nexport function probeCall (name:string, args:unknown):Reply {\n    return {\n        stream:{\n            choices:[{\n                index:0,\n                message:{\n                    role:'assistant',\n                    tool_calls:[{\n                        id:'doctor-call',\n                        type:'function',\n                        function:{ name, arguments:JSON.stringify(args) },\n                    }]\n                },\n                finish_reason:'tool_calls',\n            }],\n        }\n    }\n}\n\nexport function doctorProbe ():Script {\n    const prefixes = new Map<string, { messages:unknown[], tools:unknown }>()\n    return (req:RecordedRequest) => {\n        const body = req.body as {\n            messages:Record<string, unknown>[],\n            tools:unknown,\n            tool_choice?:unknown,\n        }\n        if (body.tool_choice !== undefined && body.tool_choice !== 'auto') {\n            return { status:400, body:'forced tool choice' }\n        }\n        const messages = body.messages\n        const result = messages.find(m => m.role === 'tool')\n        const key = String(req.headers.authorization)\n        if (!result) {\n            prefixes.set(key, { messages, tools:body.tools })\n            return probeCall('doctor_lookup', {})\n        }\n        const prefix = prefixes.get(key)\n        if (!prefix || JSON.stringify(body.tools) !==\n            JSON.stringify(prefix.tools) ||\n            JSON.stringify(messages.slice(0, prefix.messages.length)) !==\n            JSON.stringify(prefix.messages)) {\n            return { status:400, body:'changed conversation prefix' }\n        }\n        const token = JSON.parse(String(result.content)).token\n        return probeCall('doctor_probe', { ok:true, token })\n    }\n}\n","numLines":54,"startLine":1,"totalLines":54}},"tool_result_meta":[{"id":"toolu_017nz6CqFTZxd2ZjjRedhmTm","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
