{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SZArznq7LB7fuQydtkVGaq","type":"tool_result","content":"    type:'object',\n    properties:{\n        summary:{ type:'string' },\n        id:{ type:'integer' },\n    },\n    required:['summary'],\n    additionalProperties:false,\n}\n\n// Mirrors decoding into a typed result: present properties must have the\n// right type; absent ones (and null) are allowed.\nexport function decodeSummary (value:unknown):Summary {\n    if (value === null) return {}\n    if (typeof value !== 'object' || Array.isArray(value)) {\n        throw new Error('result is not an object')\n    }\n    const v = value as Record<string, unknown>\n    const out:Summary = {}\n    if (v.summary !== undefined && v.summary !== null) {\n        if (typeof v.summary !== 'string') {\n            throw new Error('summary is not a string')\n        }\n        out.summary = v.summary\n    }\n    if (v.id !== undefined && v.id !== null) {\n        if (typeof v.id === 'bigint') out.id = v.id\n        else if (typeof v.id === 'number' && Number.isInteger(v.id)) {\n            out.id = v.id\n        } else throw new Error('id is not an integer')\n    }\n    return out\n}\n\n// A record tool that counts its runs.\nexport function recordTool (\n    onRun?:() => void\n):Tool&{ runs:number } {\n    const tool = {\n        name:'report',\n        description:'Record one finding.',\n        schema:{ type:'object', properties:{ title:{ type:'string' } } },\n        recordsResult:true,\n        runs:0,\n        run () {\n            tool.runs++\n            onRun?.()\n            return { ok:true }\n        },\n    }\n    return tool\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"ce6241dd-6cf9-4ea5-b772-4d4bcdb98f32","uuid":"f2599000-5e68-427b-9f3c-44f493d1770d","timestamp":"2026-11-24T02:49:43.454Z","tool_use_result":{"stdout":"    type:'object',\n    properties:{\n        summary:{ type:'string' },\n        id:{ type:'integer' },\n    },\n    required:['summary'],\n    additionalProperties:false,\n}\n\n// Mirrors decoding into a typed result: present properties must have the\n// right type; absent ones (and null) are allowed.\nexport function decodeSummary (value:unknown):Summary {\n    if (value === null) return {}\n    if (typeof value !== 'object' || Array.isArray(value)) {\n        throw new Error('result is not an object')\n    }\n    const v = value as Record<string, unknown>\n    const out:Summary = {}\n    if (v.summary !== undefined && v.summary !== null) {\n        if (typeof v.summary !== 'string') {\n            throw new Error('summary is not a string')\n        }\n        out.summary = v.summary\n    }\n    if (v.id !== undefined && v.id !== null) {\n        if (typeof v.id === 'bigint') out.id = v.id\n        else if (typeof v.id === 'number' && Number.isInteger(v.id)) {\n            out.id = v.id\n        } else throw new Error('id is not an integer')\n    }\n    return out\n}\n\n// A record tool that counts its runs.\nexport function recordTool (\n    onRun?:() => void\n):Tool&{ runs:number } {\n    const tool = {\n        name:'report',\n        description:'Record one finding.',\n        schema:{ type:'object', properties:{ title:{ type:'string' } } },\n        recordsResult:true,\n        runs:0,\n        run () {\n            tool.runs++\n            onRun?.()\n            return { ok:true }\n        },\n    }\n    return tool\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01SZArznq7LB7fuQydtkVGaq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
