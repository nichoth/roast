{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0195JZF6mhRrg8hU6nAhfTww","type":"tool_result","content":"            status:response.status,\n            headers,\n            providerType:fields.type,\n            providerCode:fields.code,\n            providerMessage:fields.message,\n        })\n    if (response.status >= 300 && response.status < 400) {\n        return new EndpointError(\n            `${SENTINEL_MESSAGE.endpoint}: ${model}: redirect refused: ` +\n                err.message,\n            { cause:err, details:{ model } })\n    }\n    return err\n}\n\nexport function createModelClient (config:ClientConfig):ModelClient {\n    if (!(config.maxOutputTokens > 0)) {\n        throw new Error(`${config.model}: max output tokens must be positive`)\n    }\n    if (goTrimSpace(config.apiKey) === '') {\n        throw new Error(`${config.model}: API key is not configured`)\n    }\n    const protocol = (config.protocol === '' ?\n        'chat' :\n        config.protocol) as Protocol\n    const adapter = adapterFor(protocol)\n    const maxAttempts = config.maxAttempts > 0 ?\n        config.maxAttempts :\n        DEFAULT_MAX_ATTEMPTS\n    const gate = new CaptureGate()\n    const total = new UsageAccumulator()\n    const url = adapter.url(config.baseUrl)\n\n    function encodeBody (request:ModelRequest):Uint8Array {\n        const body = adapter.encode(config, request)\n        return new TextEncoder().encode(JSON.stringify(body))\n    }\n\n    async function attempt (\n        request:ModelRequest,\n        signal:AbortSignal\n    ):Promise<ModelTurn> {\n        const fetchFn = config.fetch ?? currentFetch()\n        const response = await fetchFn(url, {\n            method:'POST',\n            headers:requestHeaders(protocol, config.apiKey,\n                request.sessionId, config.sessionHeader),\n            body:encodeBody(request),\n            redirect:'manual',\n            signal,\n        })\n        if (response.status < 200 || response.status >= 300) {\n            throw await httpError(response, url, config.model, signal)\n        }\n        const body = await openCapturedBody(response, {\n            role:config.role,\n            protocol,\n            model:config.model,\n            captureResponse:config.captureResponse,\n        }, gate, signal)\n        let turn:ModelTurn|undefined\n        let failure:unknown\n        try {\n            turn = await adapter.decode(parseSse(body.chunks))\n        } catch (err) {\n            failure = err\n        }\n        if (turn) {\n            total.add(turn.usage)\n            request.onUsage?.(turn.usage)\n        }\n        // A capture failure here replaces any turn or error.\n        await body.release()\n        if (!turn) throw failure\n        signal.throwIfAborted()\n        return turn\n    }\n\n    return {\n        config,\n        protocol,\n        maxAttempts,\n        requestBytes (request:ModelRequest):number {\n            return encodeBody(request).length\n        },\n        usage ():Usage {\n            return total.total()\n        },\n        async send (request:ModelRequest):Promise<ModelTurn> {\n            if (gate.failure) throw gate.failure\n            request.signal.throwIfAborted()\n            const timeout = config.requestTimeoutMs > 0 ?\n                AbortSignal.timeout(config.requestTimeoutMs) :\n                undefined\n            const signal = timeout ?\n                AbortSignal.any([request.signal, timeout]) :\n                request.signal\n            try {\n                return await attempt(request, signal)\n            } catch (err) {\n                if (err instanceof CaptureError) throw err\n                if (request.signal.aborted) throw request.signal.reason\n                if (timeout?.aborted) {\n                    throw new EndpointError(\n                        `${SENTINEL_MESSAGE.endpoint}: ${config.model}: ` +\n                            'request timed out after ' +\n                            `${config.requestTimeoutMs}ms`,\n                        {\n                            cause:timeout.reason,\n                            details:{ model:config.model },\n                        })\n// The swappable `fetch` (the TS form of Go's redirectDefaultTransport,\n// shared with login and doctor) and the Roast-controlled request headers\n// (spec 06, 2.3). Nothing here reads the environment.\n\nimport { buildInfo } from '../buildinfo.js'\nimport type { Protocol } from './types.js'\n\nlet override:typeof globalThis.fetch|undefined\n\n// Replaces the fetch every client without its own `fetch` uses (tests).\nexport function setFetch (f:typeof globalThis.fetch):void {\n    override = f\n}\n\nexport function resetFetch ():void {\n    override = undefined\n}\n\nexport function currentFetch ():typeof globalThis.fetch {\n    return override ?? globalThis.fetch\n}\n\nexport function userAgent ():string {\n    return `roast/${buildInfo.version}`\n}\n\n// Every header of one request. The session headers are set last; header\n// names are case-insensitive, so a session header spelled like another\n// header yields one header holding the session ID.\nexport function requestHeaders (\n    protocol:Protocol,\n    apiKey:string,\n    sessionId:string,\n    sessionHeader?:string\n):Headers {\n    const h = new Headers()\n    h.set('Content-Type', 'application/json')\n    h.set('Accept', 'text/event-stream')\n    if (protocol === 'anthropic') {\n        h.set('X-Api-Key', apiKey)\n        h.set('Anthropic-Version', '2023-06-01')\n    } else {\n        h.set('Authorization', `Bearer ${apiKey}`)\n    }\n    h.set('User-Agent', userAgent())\n    h.set('X-Agent-Session-Id', sessionId)\n    if (sessionHeader) h.set(sessionHeader, sessionId)\n    return h\n}\n// Protocol-neutral types for the LLM layer (spec 06, 3.1; spec 07, 3.3).\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\n\nexport interface RawResponse {\n    role:string;\n    protocol:Protocol;\n    model:string;\n    contentType:'application/json'|'text/event-stream';\n    // Exact bytes of the body: no request, no headers.\n    body:Uint8Array;\n}\n\nexport interface ClientConfig {\n    // \"finder\", \"verifier\", or a doctor check name.\n    role:string;\n    baseUrl:string;\n    apiKey:string;\n    // Sent verbatim as the body's `model`.\n    model:string;\n    // \"\" means chat.\n    protocol:''|Protocol;\n    maxOutputTokens:number;\n    // Attempts per model call; <= 0 means DEFAULT_MAX_ATTEMPTS.\n    maxAttempts:number;\n    // Per request; 0 disables.\n    requestTimeoutMs:number;\n    sessionHeader?:string;\n    captureResponse?:(raw:RawResponse) => Promise<void>|void;\n    // Overrides the module-level fetch (http.ts) for this client.\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface ToolDefinition {\n    name:string;\n    description:string;\n    // The complete caller JSON Schema.\n    schema:Record<string, unknown>;\n}\n\n// A tool the agent loop offers the model (spec 07, 3.3). The final tool\n// has no `run`.\nexport interface Tool {\n    name:string;\n    description:string;\n    schema:Record<string, unknown>;\n    run?:(args:Record<string, unknown>, signal:AbortSignal) =>\n        unknown|Promise<unknown>;\n    recordsResult?:boolean;\n}\n\nexport type AssistantPart =\n    | { type:'text', text:string }\n    | {\n        type:'reasoning';\n        text:string;\n        signature?:string;\n        redactedData?:string;\n    }\n    // `input` is the raw argument string as received.\n    | { type:'tool-call', id:string, name:string, input:string }\n\nexport interface ToolResult {\n    callId:string;\n    name:string;\n    output:string;\n    isError:boolean;\n}\n\nexport type ConversationItem =\n    | { role:'user', text:string }\n    | { role:'assistant', parts:AssistantPart[] }\n    | { role:'tool', results:ToolResult[] }\n\nexport interface Usage {\n    uncachedInputTokens:number;\n    cachedInputTokens:number;\n    cacheWriteTokens:number;\n    outputTokens:number;\n    calls:number;\n}\n\nexport interface ModelRequest {\n    system:string;\n    items:ConversationItem[];\n    tools:ToolDefinition[];\n    sessionId:string;\n    // Already composed by the agent loop (caller, deadline, timeout).\n    signal:AbortSignal;\n    onUsage?:(usage:Usage) => void;\n}\n\nexport type FinishReason =\n    'stop'|'length'|'content-filter'|'tool-calls'|'error'|'other'|'unknown'\n\nexport interface ModelTurn {\n    // Arrival order; replayed verbatim.\n    parts:AssistantPart[];\n    finishReason:FinishReason;\n    rawFinishReason?:string;\n    // Normalized, calls: 1.\n    usage:Usage;\n}\n\n// Progress report for one dispatched exploration or record call, or a\n// call to an unknown tool (spec 07, 2.10).\nexport interface TurnInfo {\n    turn:number;\n    tool:string;\n    args:Record<string, unknown>;\n}\n\n// Type validation of the final arguments (spec 07, 2.7). `decode`\n// receives the value parsed with integer preservation (unsafe integers\n// are `bigint`) and the original argument text for lexical checks, and\n// throws an Error whose message is the detail.\nexport interface FinalSpec<T> {\n    decode (value:unknown, rawText?:string):T;\n}\n\nexport interface ConverseOptions<T> {\n    // Exploration, record, and final tools, in order.\n    tools:readonly Tool[];\n    finalTool:string;\n    final:FinalSpec<T>;\n    // Turn at which the final phase starts; <= 0 means 8.\n    maxTurns?:number;\n    onTurn?:(info:TurnInfo) => void;\n    // <= 0 means 3e6.\n    inputByteCeiling?:number;\n    // Absolute time, ms since the epoch.\n    workDeadline?:number;\n    // ms; <= 0 means 90000.\n    wrapUpWindow?:number;\n    onWorkDeadline?:() => void;\n    onBudgetExhausted?:() => void;\n}\n\n// Usage as written into run records: snake_case, disjoint counts.\nexport interface RecordUsage {\n    uncached_input_tokens:number;\n    cached_input_tokens:number;\n    cache_write_tokens:number;\n    output_tokens:number;\n    calls:number;\n}\n\n// One configured model role, as the finder and verifier call it.\nexport interface Client {\n    // The request model name.\n    readonly name:string;\n    converse<T> (\n        system:string,\n        user:string,\n        opts:ConverseOptions<T>,\n        signal:AbortSignal\n    ):Promise<T>;\n    completeStructured<T> (\n        system:string,\n        user:string,\n        schemaName:string,\n        result:{ schema:Record<string, unknown>, decode:FinalSpec<T>['decode'] },\n        signal:AbortSignal\n    ):Promise<T>;\n    usage ():RecordUsage;\n}\n// The `chat` protocol (OpenAI Chat Completions; OpenRouter, DeepSeek,\n// others): a pure request encoder and stream decoder (spec 06, 2.6.1 and\n// 2.8.1).\n\nimport {\n    IncompleteStreamError,\n    ProviderError,\n    streamError,\n} from './errors.js'\nimport { wellFormed } from './json.js'\nimport { isChatReasoningModel } from './models.js'\nimport type { SseEvent } from './sse.js'\nimport type {\n    AssistantPart,\n    ConversationItem,\n    FinishReason,\n    ModelTurn,\n    ToolDefinition,\n} from './types.js'\nimport { chatUsage, normalizeUsage } from './usage.js'\n\nexport interface EncodeConfig {\n    model:string;\n    maxOutputTokens:number;\n}\n\nexport interface EncodeRequest {\n    system:string;\n    items:readonly ConversationItem[];\n    tools:readonly ToolDefinition[];\n}\n\nexport function trimSlashes (url:string):string {\n    let end = url.length\n    while (end > 0 && url.charCodeAt(end - 1) === 47) end--\n    return url.slice(0, end)\n}\n\nexport function chatUrl (baseUrl:string):string {\n    return `${trimSlashes(baseUrl)}/chat/completions`\n}\n\nfunction assistantMessage (\n    parts:readonly AssistantPart[]\n):Record<string, unknown>|null {\n    const texts:string[] = []\n    const reasoning:string[] = []\n    const calls:unknown[] = []\n    for (const p of parts) {\n        if (p.type === 'text') texts.push(p.text)\n        else if (p.type === 'reasoning') reasoning.push(p.text)\n        else {\n            calls.push({\n                id:p.id,\n                type:'function',\n                function:{ name:p.name, arguments:p.input },\n            })\n        }\n    }\n    if (texts.length === 0 && calls.length === 0) return null\n    const msg:Record<string, unknown> = { role:'assistant' }\n    if (texts.length > 0) msg.content = texts.join('\\n')\n    if (calls.length > 0) msg.tool_calls = calls\n    if (reasoning.length > 0) msg.reasoning_content = reasoning.join('\\n')\n    return msg\n}\n\nfunction messages (req:EncodeRequest):unknown[] {\n    const out:unknown[] = []\n    if (req.system !== '') out.push({ role:'system', content:req.system })\n    for (const item of req.items) {\n        if (item.role === 'user') {\n            out.push({ role:'user', content:item.text })\n        } else if (item.role === 'assistant') {\n            const msg = assistantMessage(item.parts)\n            if (msg) out.push(msg)\n        } else {\n            for (const r of item.results) {\n                out.push({\n                    role:'tool',\n                    tool_call_id:r.callId,\n                    content:r.output,\n                })\n            }\n        }\n    }\n    return out\n}\n\n// The request body. Tool choice is always automatic.\nexport function encodeChat (\n    config:EncodeConfig,\n    req:EncodeRequest\n):Record<string, unknown> {\n    const body:Record<string, unknown> = {\n        model:config.model,\n        messages:messages(req),\n    }\n    if (isChatReasoningModel(config.model)) {\n        body.max_completion_tokens = config.maxOutputTokens\n    } else {\n        body.max_tokens = config.maxOutputTokens\n    }\n    body.stream = true\n    body.stream_options = { include_usage:true }\n    if (req.tools.length > 0) {\n        body.tools = req.tools.map(tool => ({\n            type:'function',\n            function:{\n                name:tool.name,\n                description:tool.description ?? '',\n                parameters:structuredClone(tool.schema),\n                strict:false,\n            },\n        }))\n        body.tool_choice = 'auto'\n    }\n    return body\n}\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\nfunction str (v:unknown):string {\n    return typeof v === 'string' ? wellFormed(v) : ''\n}\n\nfunction protocolError (message:string, cause?:unknown):ProviderError {\n    return new ProviderError(message, { retryable:false, cause })\n}\n\ninterface OpenCall {\n    index:number;\n    id:string;\n    name:string;\n    args:string;\n}\n\nconst FINISH:Record<string, FinishReason> = {\n    stop:'stop',\n    length:'length',\n    content_filter:'content-filter',\n    tool_calls:'tool-calls',\n    function_call:'tool-calls',\n    insufficient_system_resource:'error',\n}\n\nconst RAW_EXPOSED = new Set<FinishReason>([\n    'length',\n    'content-filter',\n    'error',\n    'unknown',\n])\n\nconst SUPPRESS_CALLS = new Set<FinishReason>([\n    'length',\n    'content-filter',\n    'error',\n])\n\nfunction validJson (s:string):boolean {\n    try {\n        JSON.parse(s)\n        return true\n    } catch {\n        return false\n    }\n}\n\n// The provider error carried by a chunk's top-level `error` member.\nfunction chunkError (value:unknown):ProviderError {\n    const e = obj(value)\n    const code = typeof e.code === 'number' ? String(e.code) : str(e.code)\n    const message = str(e.message) ||\n        (typeof value === 'string' ? value : JSON.stringify(value))\n    return streamError(str(e.type), code, message)\n}\n\n// Assembles one turn from chat.completion.chunk events (spec 06, 2.8.1).\n// Stops reading at `[DONE]`; throws the 2.10 error kinds.\nexport async function decodeChat (\n    events:AsyncIterable<SseEvent>\n):Promise<ModelTurn> {\n    const parts:AssistantPart[] = []\n    let text:{ type:'text', text:string }|null = null\n    let reasoning:{ type:'reasoning', text:string }|null = null\n    let reasoningEnded = false\n    const calls = new Map<number, OpenCall>()\n    let rawFinish = ''\n    let usage:unknown\n\n    function openReasoning ():{ type:'reasoning', text:string } {\n        if (!reasoning) {\n            reasoning = { type:'reasoning', text:'' }\n            parts.push(reasoning)\n            text = null\n        }\n        return reasoning\n    }\n\n    function onDelta (delta:Json, finish:string):void {\n        const content = str(delta.content)\n        const toolCalls = Array.isArray(delta.tool_calls) ?\n            delta.tool_calls :\n            []\n        const boundary = content !== '' ||\n            Array.isArray(delta.tool_calls) || finish !== ''\n        const field = delta.reasoning_content ?? delta.reasoning\n        const thought = str(field)\n        if (thought !== '') {\n            openReasoning().text += thought\n        } else if (typeof field === 'string' && !boundary &&\n            !reasoningEnded) {\n            openReasoning()\n        }\n        if (boundary && reasoning) {\n            reasoning = null\n            reasoningEnded = true\n        }\n        if (content !== '') {\n            if (!text) {\n                text = { type:'text', text:'' }\n                parts.push(text)\n            }\n            text.text += content\n        }\n        for (const raw of toolCalls) onToolCall(obj(raw))\n    }\n\n    function onToolCall (tc:Json):void {\n        const index = typeof tc.index === 'number' ? tc.index : 0\n        const fn = obj(tc.function)\n        const name = str(fn.name)\n        const args = str(fn.arguments)\n        const open = calls.get(index)\n        if (open) {\n            open.args += args\n            return\n        }\n        if (name === '' && args === '') return\n        const type = tc.type === undefined || tc.type === null ?\n            'function' :\n        