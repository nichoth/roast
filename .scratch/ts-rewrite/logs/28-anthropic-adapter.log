{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLzi5q8iydAq9X5acq8t","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011cT3DoD8CbX341h9RDSZXM","name":"Bash","input":{"command":"python3 - <<'EOF'\np='test/helpers/anthropic-fakes.ts'\ns=open(p).read()\nold_start=s.index(\"// Go deepSeekThinkingServer:\")\nold_end=s.index(\"function deepSeekChat\")\nnew='''// Go deepSeekThinkingServer as a script: any forced tool choice is a\n// 400, and with tools present every earlier assistant message must\n// replay its reasoning (`reasoning_content` on chat, a leading\n// `thinking` block on anthropic). `respond(req, n)` answers the n-th\n// (1-based) request; `rejected` collects the requests answered 400.\nexport function deepSeekScript (\n    protocol:'chat'|'anthropic',\n    respond:(req:RecordedRequest, n:number) => DeepSeekAnswer\n):{ script:Script, rejected:RecordedRequest[] } {\n    const rejected:RecordedRequest[] = []\n    let count = 0\n    const script:Script = req => res => {\n        const body = (req.body ?? {}) as {\n            tool_choice?:unknown,\n            tools?:unknown[],\n            messages?:Json[],\n        }\n        const call = ++count\n        const choice = body.tool_choice\n        let auto = choice === undefined || choice === null ||\n            choice === 'auto'\n        if (choice !== null && typeof choice === 'object') {\n            auto = (choice as Json).type === 'auto'\n        }\n        if (!auto) {\n            rejected.push(req)\n            reject(res, {\n                error:{\n                    message:'Thinking mode does not support this ' +\n                        'tool_choice',\n                    type:'invalid_request_error',\n                },\n            })\n            return\n        }\n        const hasTools = (body.tools ?? []).length > 0\n        for (const m of body.messages ?? []) {\n            if (m.role !== 'assistant' || !hasTools) continue\n            const ok = protocol === 'chat' ?\n                'reasoning_content' in m :\n                Array.isArray(m.content) &&\n                    (m.content[0] as Json|undefined)?.type === 'thinking'\n            if (!ok) {\n                rejected.push(req)\n                reject(res, {\n                    type:'error',\n                    error:{\n                        type:'invalid_request_error',\n                        message:'The thinking in the thinking mode must ' +\n                            'be passed back to the API.',\n                    },\n                })\n                return\n            }\n        }\n        const answer = respond(req, call)\n        writeInferenceStream(res, protocol, protocol === 'chat' ?\n            deepSeekChat(answer, call) :\n            deepSeekAnthropic(answer, call))\n    }\n    return { script, rejected }\n}\n\nexport async function startDeepSeekServer (\n    protocol:'chat'|'anthropic',\n    respond:(req:RecordedRequest, n:number) => DeepSeekAnswer\n):Promise<DeepSeekServer> {\n    const { script, rejected } = deepSeekScript(protocol, respond)\n    const server = await startInferenceServer(script)\n    return Object.assign(server, { rejected })\n}\n\n'''\ns=s[:old_start]+new+s[old_end:]\ns=s.replace(\"\"\"    type RecordedRequest,\n} from './inference-server.js'\"\"\",\"\"\"    type RecordedRequest,\n    type Script,\n} from './inference-server.js'\"\"\")\nopen(p,'w').write(s)\nEOF\nnpm run typecheck 2>&1 | grep error"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2050,"cache_read_input_tokens":161383,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2050},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ce6241dd-6cf9-