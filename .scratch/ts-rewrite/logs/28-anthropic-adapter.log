.Second)\n\t\t\t\tcase \"budget\":\n\t\t\t\t\t// Refuses exploration but admits the reserved wrap-up call.\n\t\t\t\t\tc.cfg.Ledger = NewLedger(4000)\n\t\t\t\t}\n\t\t\t\tvar out answer\n\t\t\t\tvar err error\n\t\t\t\tif strings.HasPrefix(mode, \"structured\") {\n\t\t\t\t\terr = c.CompleteStructured(t.Context(), \"system\", \"user\", \"submit\", &out)\n\t\t\t\t} else {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif event != \"\" {\n\t\t\tif _, err := fmt.Fprintf(w, \"event: %s\\n\", event); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\t_, err = fmt.Fprintf(w, \"data: %s\\n\\n\", data)\n\t\treturn err\n\t}\n\tswitch protocol {\n\tcase \"anthropic\":\n\t\tstart := maps.Clone(response)\n\t\tstart[\"content\"], start[\"stop_reason\"] = []any{}, nil\n\t\tusage := maps.Clone(response[\"usage\"].(map[string]any))\n\t\tusage[\"output_tokens\"] = 0\n\t\tstart[\"usage\"] = usage\n\t\tif err := emit(\"message_start\", map[string]any{\"type\": \"message_start\", \"message\": start}); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tfor index, raw := range response[\"content\"].([]any) {\n\t\t\tblock := raw.(map[string]any)\n\t\t\tstartBlock := maps.Clone(block)\n\t\t\tvar deltas []map[string]any\n\t\t\tswitch block[\"type\"] {\n\t\t\tcase \"thinking\":\n\t\t\t\tstartBlock[\"thinking\"], startBlock[\"signature\"] = \"\", \"\"\n\t\t\t\tdeltas = []map[string]any{\n\t\t\t\t\t{\"type\": \"thinking_delta\", \"thinking\": block[\"thinking\"]},\n\t\t\t\t\t{\"type\": \"signature_delta\", \"signature\": block[\"signature\"]},\n\t\t\t\t}\n\t\t\tcase \"text\":\n\t\t\t\tstartBlock[\"text\"] = \"\"\n\t\t\t\tdeltas = []map[string]any{{\"type\": \"text_delta\", \"text\": block[\"text\"]}}\n\t\t\tdefault:\n\t\t\t\tinput, err := json.Marshal(block[\"input\"])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n\t\t\t\tstartBlock[\"input\"] = map[string]any{}\n\t\t\t\tdeltas = []map[string]any{{\"type\": \"input_json_delta\", \"partial_json\": string(input)}}\n\t\t\t}\n\t\t\tevents := []map[string]any{{\"type\": \"content_block_start\", \"index\": index, \"content_block\": startBlock}}\n\t\t\tfor _, delta := range deltas {\n\t\t\t\tevents = append(events, map[string]any{\"type\": \"content_block_delta\", \"index\": index, \"delta\": delta})\n\t\t\t}\n\t\t\tevents = append(events, map[string]any{\"type\": \"content_block_stop\", \"index\": index})\n\t\t\tfor _, event := range events {\n\t\t\t\tif err := emit(event[\"type\"].(string), event); err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tif err := emit(\"message_delta\", map[string]any{\"type\": \"message_delta\", \"delta\": map[string]any{\"stop_reason\": response[\"stop_reason\"], \"stop_sequence\": nil}, \"usage\": response[\"usage\"]}); err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn emit(\"message_stop\", map[string]any{\"type\": \"message_stop\"})\n\tcase \"responses\":\n\t\tstart := maps.Clone(response)\n\t\tstart[\"output\"], start[\"status\"] = []any{}, \"in_progress\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AN4kPQXjvxSMbdR45Mmvic","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
