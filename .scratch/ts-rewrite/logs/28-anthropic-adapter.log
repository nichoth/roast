FINDER_FIRST]:findingsReply([finding()]),\n    [A_VERIFIER_FIRST]:verdictReply(),\n}\n\nfunction failure (status:number, type:string, message:string):Reply {\n    return {\n        status,\n        headers:{ 'Content-Type':'application/json' },\n        body:JSON.stringify({ type:'error', error:{ type, message } }),\n    }\n}\n\n// The M3 replies, by case name, in Anthropic form.\nconst REPLIES:Record<string, ReplyTable> = {\n    'clean review':{ [A_FINDER_FIRST]:findingsReply([]) },\n    'findings confirmed by the verifier':CONFIRMED,\n    '--format json':CONFIRMED,\n    '--staged':CONFIRMED,\n    '--max-severity trips':ONE_HIGH,\n    '--max-severity does not trip':ONE_HIGH,\n    'provider HTTP 500 after retries':{\n        [A_FINDER_FIRST]:failure(500, 'api_error', 'upstream exploded'),\n    },\n    'provider HTTP 401':{\n        [A_FINDER_FIRST]:failure(401, 'authentication_error', 'bad key'),\n    },\n}\n\nfunction anthropicCase (c:ReviewCase):ReviewCase {\n    const replies = REPLIES[c.name]\n    if (!replies) throw new Error(`no anthropic replies for ${c.name}`)\n    return { ...c, replies }\n}\n\nexport const M4_SCENARIOS:readonly Scenario[] = M3_CASES.map(c =>\n    review(anthropicCase(c), 'anthropic', 'review anthropic'))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1214,"cache_read_input_tokens":185261,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1214},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ce6241dd-6cf9-4ea5-b772-4d4bcdb98f32","uuid":"40f16d11-c908-4509-b7e9-b0b545d0bbe2","timestamp":"2026-11-24T03:00:25.749Z","request_id":"req_011ChM1Jh77gkcP1L7BJLfZE","wire_tool_inputs":{"toolu_011jyxpd8dGSghTrN1dNrjQE":{"file_path":"/Users/nick/code/roast.ts-r