{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLzHuhkm68wBu4hjVLi3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JjDdfTqvbaqyUWo7aEgHF9","name":"Bash","input":{"command":"cat test/helpers/inference-stream.ts test/helpers/inference-server.ts; sed -n 1,80p test/llm/chat-decode.ts; sed -n 1,60p test/llm/chat-encode.ts"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6376,"cache_read_input_tokens":81195,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6376},"output_tokens":35,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ce6241dd-6cf9-4ea5-b772-4d4bcdb98f32","uuid":"b6e5951c-c238-4499-a4ba-fe8886b40abd","timestamp":"2026-11-24T02:46:58.176Z","request_id":"req_011ChLzHuXaubZ6jVGi4jUa7","wire_tool_inputs":{"toolu_01JjDdfTqvbaqyUWo7aEgHF9":{"command":"cd /Users/nick/code/roast.ts-rewrite-28-anthropic-adapter && cat test/helpers/inference-stream.ts test/helpers/inference-server.ts; sed -n 1,80p test/llm/chat-decode.ts; sed -n 1,60p test/llm/chat-encode.ts"}},"wire_ingest_context":{"toolu_01JjDdfTqvbaqyUWo7aEgHF9":{"cwd":"/Users/nick/code/roast.ts-rewrite-28-anthropic-adapter"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JjDdfTqvbaqyUWo7aEgHF9","type":"tool_result","content":"// Fixture writer for fake inference servers (spec 01, 3.8; Go\n// testutil.WriteInferenceStream): from a complete response object, emit\n// the protocol's native SSE stream. Only `chat` exists so far; the\n// `responses` and `anthropic` formats join it in later tickets.\n\n// The part of `http.ServerResponse` the writer uses.\nexport interface StreamSink {\n    setHeader (name:string, value:string):unknown;\n    write (chunk:string):unknown;\n    end ():unknown;\n}\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\nfunction event (data:unknown, name?:string):string {\n    const head = name ? `event: ${name}\\n` : ''\n    const body = typeof data === 'string' ? data : JSON.stringify(data)\n    return `${head}data: ${body}\\n\\n`\n}\n\n// Three chunks (delta, finish, usage) and `[DONE]`.\nfunction chatEvents (response:Json):string[] {\n    const base = {\n        id:response.id,\n        object:'chat.completion.chunk',\n        created:1,\n        model:response.model,\n    }\n    const choices = Array.isArray(response.choices) ? response.choices : []\n    const deltas = choices.map((c:unknown) => {\n        const choice = obj(c)\n        const delta = { ...obj(choice.message) }\n        if (Array.isArray(delta.tool_calls)) {\n            delta.tool_calls = delta.tool_calls.map((tc:unknown, i:number) => (\n                { ...obj(tc), index:i }\n            ))\n        }\n        return { index:choice.index, delta, finish_reason:null }\n    })\n    const finishes = choices.map((c:unknown) => {\n        const choice = obj(c)\n        return {\n            index:choice.index,\n            delta:{},\n            finish_reason:choice.finish_reason,\n        }\n    })\n    return [\n        event({ ...base, choices:deltas }),\n        event({ ...base, choices:finishes }),\n        event({ ...base, choices:[], usage:response.usage }),\n        event('[DONE]'),\n    ]\n}\n\nexport function writeInferenceStream (\n    res:StreamSink,\n    protocol:string,\n    response:unknown\n):void {\n    let events:string[]\n    if (protocol === 'chat') events = chatEvents(obj(response))\n    else throw new Error(`unsupported inference protocol \"${protocol}\"`)\n    res.setHeader('Content-Type', 'text/event-stream')\n    for (const e of events) res.write(e)\n    res.end()\n}\n\n// `writeInferenceStream` from a JSON string.\nexport function writeJSONStream (\n    res:StreamSink,\n    protocol:string,\n    body:string\n):void {\n    writeInferenceStream(res, protocol, JSON.parse(body))\n}\n// A `node:http` fake inference server (Go httptest plus providerServer):\n// it records every request and answers from a script that looks at the\n// request (path, body, headers) and the request's position.\nimport {\n    createServer,\n    type IncomingHttpHeaders,\n    type ServerResponse,\n} from 'node:http'\nimport type { AddressInfo } from 'node:net'\nimport { writeInferenceStream } from './inference-stream.js'\n\nexport interface RecordedRequest {\n    method:string;\n    path:string;\n    headers:IncomingHttpHeaders;\n    // Header names and values exactly as sent, in order.\n    rawHeaders:string[];\n    rawBody:Buffer;\n    // The parsed JSON body; undefined when it is not JSON.\n    body:unknown;\n}\n\nexport type Reply =\n    // A complete response object, streamed in the protocol's SSE format;\n    // the protocol defaults to the one the request path implies.\n    | { stream:unknown, protocol?:string }\n    | { status:number, headers?:Record<string, string>, body?:string|Buffer }\n    // Full control: write the response yourself.\n    | ((res:ServerResponse, req:RecordedRequest) => void|Promise<void>)\n\n// Picks the reply for the n-th request (0-based).\nexport type Script = (req:RecordedRequest, n:number) => Reply\n\nexport interface InferenceServer {\n    // `http://127.0.0.1:<port>`.\n    url:string;\n    requests:RecordedRequest[];\n    close ():Promise<void>;\n}\n\nexport function protocolForPath (path:string):string {\n    if (path.endsWith('/chat/completions')) return 'chat'\n    if (path.endsWith('/responses')) return 'responses'\n    if (path.endsWith('/v1/messages')) return 'anthropic'\n    return ''\n}\n\nasync function reply (res:ServerResponse, req:RecordedRequest, r:Reply) {\n    if (typeof r === 'function') {\n        await r(res, req)\n        return\n    }\n    if ('stream' in r) {\n        writeInferenceStream(res, r.protocol ?? protocolForPath(req.path),\n            r.stream)\n        return\n    }\n    res.writeHead(r.status, r.headers ?? {})\n    res.end(r.body ?? '')\n}\n\nexport async function startInferenceServer (\n    script:Script\n):Promise<InferenceServer> {\n    const requests:RecordedRequest[] = []\n    const server = createServer((req, res) => {\n        const parts:Buffer[] = []\n        req.on('data', (c:Buffer) => parts.push(c))\n        req.on('end', () => {\n            const rawBody = Buffer.concat(parts)\n            let body:unknown\n            try {\n                body = JSON.parse(rawBody.toString('utf8'))\n            } catch {\n                body = undefined\n            }\n            const rec:RecordedRequest = {\n                method:req.method ?? '',\n                path:req.url ?? '',\n                headers:req.headers,\n                rawHeaders:req.rawHeaders,\n                rawBody,\n                body,\n            }\n            const n = requests.length\n            requests.push(rec)\n            Promise.resolve()\n                .then(() => reply(res, rec, script(rec, n)))\n                .catch((err:unknown) => {\n                    if (!res.headersSent) res.writeHead(500)\n                    res.end(String(err))\n                })\n        })\n    })\n    await new Promise<void>(resolve => {\n        server.listen(0, '127.0.0.1', resolve)\n    })\n    const { port } = server.address() as AddressInfo\n    return {\n        url:`http://127.0.0.1:${port}`,\n        requests,\n        close () {\n            server.closeAllConnections()\n            return new Promise<void>(resolve => server.close(() => resolve()))\n        },\n    }\n}\nimport { test } from '@substrate-system/tapzero'\nimport { decodeChat } from '../../src/llm/chat.js'\nimport { parseSse, type SseEvent } from '../../src/llm/sse.js'\nimport {\n    IncompleteStreamError,\n    ProviderError,\n    isRetryable,\n} from '../../src/llm/errors.js'\nimport {\n    writeInferenceStream,\n    writeJSONStream,\n    type StreamSink,\n} from '../helpers/inference-stream.js'\n\nasync function * events (...chunks:unknown[]):AsyncGenerator<SseEvent> {\n    for (const c of chunks) {\n        yield { event:'', data:typeof c === 'string' ? c : JSON.stringify(c) }\n    }\n}\n\nfunction chunk (delta:Record<string, unknown>, finish:string|null = null,\n    usage?:unknown) {\n    const c:Record<string, unknown> = {\n        choices:[{ index:0, delta, finish_reason:finish }],\n    }\n    if (usage !== undefined) c.usage = usage\n    return c\n}\n\nconst usageA = {\n    prompt_tokens:100,\n    completion_tokens:5,\n    total_tokens:105,\n    prompt_tokens_details:{ cached_tokens:30 }\n}\n\nclass Sink implements StreamSink {\n    headers:Record<string, string> = {}\n    out = ''\n    ended = false\n    setHeader (name:string, value:string) { this.headers[name] = value }\n    write (s:string) { this.out += s; return true }\n    end () { this.ended = true }\n}\n\nasync function * bytes (s:string) { yield new TextEncoder().encode(s) }\n\nasync function failure (p:Promise<unknown>):Promise<unknown> {\n    try {\n        await p\n    } catch (err) {\n        return err\n    }\n    return undefined\n}\n\ntest('chat decodes text, reasoning, and tool calls', async t => {\n    const turn = await decodeChat(events(\n        chunk({ reasoning_content:'think' }),\n        chunk({ reasoning_content:' more' }),\n        chunk({ content:'hi' }),\n        chunk({\n            tool_calls:[{\n                index:1,\n                id:'b',\n                type:'function',\n                function:{ name:'grep', arguments:'{\"q\":' }\n            }]\n        }),\n        chunk({\n            tool_calls:[{\n                index:0,\n                id:'a',\n                function:{ name:'read', arguments:'' }\n            }]\n        }),\n        chunk({ tool_calls:[{ index:1, function:{ arguments:'\"x\"}' } }] }),\n        chunk({ tool_calls:[{ index:2, function:{ name:'', arguments:'' } }] }),\n        chunk({}, 'tool_calls'),\n        { choices:[], usage:usageA },\nimport { test } from '@substrate-system/tapzero'\nimport { encodeChat, chatUrl } from '../../src/llm/chat.js'\nimport type {\n    ConversationItem,\n    ToolDefinition,\n} from '../../src/llm/types.js'\n\nconst schema = {\n    type:'object',\n    properties:{\n        path:{ type:'string' },\n        range:{\n            type:'object',\n            properties:{ start:{ type:'integer' }, end:{ type:'integer' } },\n            required:['start', 'end'],\n            additionalProperties:false,\n        },\n    },\n    required:['path'],\n    additionalProperties:false,\n}\n\nconst tools:ToolDefinition[] = [\n    { name:'read', description:'Read a file', schema },\n    { name:'done', description:'', schema:{ type:'object' } },\n]\n\nfunction body (model:string, items:ConversationItem[] = [], t = tools) {\n    return encodeChat({ model, maxOutputTokens:4096 }, {\n        system:'sys', items, tools:t,\n    })\n}\n\ntest('chat url trims trailing slashes', t => {\n    t.equal(chatUrl('https://x.example/v1//'),\n        'https://x.example/v1/chat/completions')\n})\n\ntest('chat output limit field by model ID', t => {\n    const reasoning = body('openai/gpt-5')\n    t.equal(reasoning.max_completion_tokens, 4096, 'reasoning model')\n    t.ok(!('max_tokens' in reasoning), 'no max_tokens for reasoning')\n    const plain = body('deepseek-chat')\n    t.equal(plain.max_tokens, 4096, 'max_tokens otherwise')\n    t.ok(!('max_completion_tokens' in plain), 'no max_completion_tokens')\n})\n\ntest('chat request shape: streaming, auto tool choice, full schemas', t => {\n    const b = body('m')\n    t.equal(b.model, 'm', 'model verbatim')\n    t.equal(b.stream, true, 'stream')\n    t.deepEqual(b.stream_options, { include_usage:true }, 'usage option')\n    t.equal(b.tool_choice, 'auto', 'tool choice auto')\n    t.deepEqual(b.tools, [\n        {\n            type:'function',\n            function:{\n                name:'read',\n                description:'Read a file',\n                parameters:schema,","is_error":false}]},"parent_tool_use_id":null,"session_id":"ce6241dd-6cf9-4ea5-b772-4d4bcdb98f32","uuid":"d7520090-75d3-4838-9274-4b90136c96c2","timestamp":"2026-11-24T02:46:58.280Z","tool_use_result":{"stdout":"// Fixture writer for fake inference servers (spec 01, 3.8; Go\n// testutil.WriteInferenceStream): from a complete response object, emit\n// the protocol's native SSE stream. Only `chat` exists so far; the\n// `responses` and `anthropic` formats join it in later tickets.\n\n// The part of `http.ServerResponse` the writer uses.\nexport interface StreamSink {\n    setHeader (name:string, value:string):unknown;\n    write (chunk:string):unknown;\n    end ():unknown;\n}\n\ntype Json = Record<string, unknown>\n\nfunction obj (v:unknown):Json {\n    return v !== null && typeof v === 'object' && !Array.isArray(v) ?\n        v as Json :\n        {}\n}\n\nfunction event (data:unknown, name?:string):string {\n    const head = name ? `event: ${name}\\n` : ''\n    const body = typeof data === 'string' ? data : JSON.stringify(data)\n    return `${head}data: ${body}\\n\\n`\n}\n\n// Three chunks (delta, finish, usage) and `[DONE]`.\nfunction chatEvents (response:Json):string[] {\n    const base =