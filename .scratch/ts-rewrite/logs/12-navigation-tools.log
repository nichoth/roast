ath.Join; drop the trailing\n    // slash Go Clean drops too.\n    let candidate = path.join(root, userPath)\n    if (candidate.length > 1 && candidate.endsWith('/')) {\n        candidate = candidate.slice(0, -1)\n    }\n    const resolved = resolveDeepest(candidate)\n    if (resolved !== root && !resolved.startsWith(root + '/')) return null\n    if (inGitDir(root, candidate) || inGitDir(root, resolved)) return null\n    return candidate\n}\n\nasync function tracked (\n    repo:string,\n    rel:string,\n    opts:ContextOpts\n):Promise<boolean> {\n    try {\n        const out = await git(repo, ['ls-files', '-z', '--cached', '--', rel],\n            { ...opts, extraEnv:{ GIT_LITERAL_PATHSPECS:'1' } })\n        return out.length > 0\n    } catch {\n        opts.signal?.throwIfAborted()\n        return false\n    }\n}\n\n// Whether `rel` belongs to the corpus a review serves: not ignored, and\n// not an untracked file matching the secret denylist. Fails closed.\nasync function liveCorpusAllows (\n    repo:string,\n    rel:string,\n    opts:ContextOpts\n):Promise<boolean> {\n    if (rel === '.') return true\n    if (denylisted(rel) && !(await tracked(repo, rel, opts))) return false\n    // check-ignore refuses literal pathspecs, so the `./` prefix is what\n    // keeps a leading `:` from being read as pathspec magic. Exit 1 is\n    // \"not ignored\"; 0 is ignored, anything else an error.\n    try {\n        await git(repo, ['check-ignore', '-q', '--', './' + rel],\n            { ...opts, extraEnv:{ GIT_LITERAL_PATHSPECS:'0' } })\n        return false\n    } catch (err) {\n        opts.signal?.throwIfAborted()\n        return err instanceof GitError && err.exitCode === 1\n    }\n}\n\n// resolveUnderRepo plus the corpus rules a pinned tree enforces by\n// construction, applied to the path as given and to its symlink target.\nexport async function resolveLive (\n    repo:string,\n    userPath:string,\n    opts:ContextOpts = {}\n):Promise<string|null> {\n    const p = resolveUnderRepo(repo, userPath)\n    if (p === null) return null\n    const root = repoRoot(repo)\n    const targets = [p]\n    const target = resolveDeepest(p)\n    if (target !== p) targets.push(target)\n    for (const abs of targets) {\n        if (!(await liveCorpusAllows(repo, relTo(root, abs), opts))) {\n            return null\n        }\n    }\n    return p\n}\n\n// Whether `p` would land in Git's revision grammar instead of naming the\n// pinned-tree entry `p` (stage selectors, `:/` search, `./` aliases).\n// Only the canonical index spelling is accepted.\nfunction stagedPathIsMagic (p:string):boolean {\n    if (p === '' || p.startsWith(':')) return true\n    if (p.length > 1 && p[1] === ':' && p[0] >= '0' && p[0] <= '3') {\n        return true\n    }\n    return p.split('/').some(seg => seg === '' || seg === '.' || seg === '..')\n}\n\nexport function stagedPathCanonical (p:string):boolean {\n    return !stagedPathIsMagic(p)\n}\n// The reviewed tree (spec 05, 2.2): live working tree, pinned index tree,\n// or captured worktree tree. Every reader in this area takes one Tree.\nimport fs from 'node:fs/promises'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { git } from '../git/git.js'\nimport type { ContextOpts } from './git.js'\n\nexport type Tree = {\n    // '' means the live working tree.\n    readonly oid:string;\n    // true: captured worktree; false with an oid: index tree.\n    readonly worktree:boolean;\n}\n\nexport const LIVE_TREE:Tree = Object.freeze({ oid:'', worktree:false })\n\nexport function pinned (t:Tree):boolean {\n    return t.oid !== ''\n}\n\nexport function staged (t:Tree):boolean {\n    return pinned(t) && !t.worktree\n}\n\nexport function pinnedWorktree (oid:string):Tree {\n    return { oid, worktree:oid !== '' }\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nasync function copyIndex (src:string, dst:string):Promise<void> {\n    let data:Buffer\n    try {\n        data = await fs.readFile(src)\n    } catch (err) {\n        // Git treats a missing index as an empty one.\n        if ((err as NodeJS.ErrnoException).code === 'ENOENT') return\n        throw new Error(`read ${src}: ${message(err)}`, { cause:err })\n    }\n    let fh:fs.FileHandle\n    try {\n        fh = await fs.open(dst, 'w', 0o600)\n    } catch (err) {\n        throw new Error(`create ${dst}: ${message(err)}`, { cause:err })\n    }\n    try {\n        await fh.writeFile(data)\n    } catch (err) {\n        throw new Error(`copy index: ${message(err)}`, { cause:err })\n    } finally {\n        await fh.close()\n    }\n}\n\n// Writes the current index (honoring GIT_INDEX_FILE) into a tree object\n// through a temporary copy, without touching the live index, any ref, or\n// any commit. `opts.env` is the environment git runs with (and the one\n// GIT_INDEX_FILE is read from); process.env when absent.\nexport async function pinIndexTree (\n    repo:string,\n    signal:AbortSignal,\n    opts:Omit<ContextOpts, 'signal'> = {}\n):Promise<Tree> {\n    const runOpts = { signal, env:opts.env }\n    let gitDir:string\n    try {\n        gitDir = (await git(repo, ['rev-parse', '--absolute-git-dir'],\n            runOpts)).toString().trim()\n    } catch (err) {\n        signal.throwIfAborted()\n        throw new Error(`resolve git dir: ${message(err)}`, { cause:err })\n    }\n    const environment = opts.env ?? process.env\n    let live = environment.GIT_INDEX_FILE ?? ''\n    if (live === '') live = path.join(gitDir, 'index')\n    else if (!path.isAbsolute(live)) live = path.join(repo, live)\n\n    let tmp:string\n    try {\n        tmp = await fs.mkdtemp(path.join(os.tmpdir(), 'roast-pin-'))\n    } catch (err) {\n        throw new Error(`temp dir: ${message(err)}`, { cause:err })\n    }\n    try {\n        const idx = path.join(tmp, 'index')\n        await copyIndex(live, idx)\n        let oid:string\n        try {\n            oid = (await git(repo, ['write-tree'], {\n                ...runOpts,\n                extraEnv:{ GIT_INDEX_FILE:idx },\n            })).toString().trim()\n        } catch (err) {\n            signal.throwIfAborted()\n            throw new Error(`write-tree: ${message(err)}`, { cause:err })\n        }\n        return { oid, worktree:false }\n    } finally {\n        await fs.rm(tmp, { recursive:true, force:true })\n    }\n}\n// Blob reads from a pinned tree (spec 05, 2.4). The path must already be\n// the canonical index spelling; anything else is absent.\nimport { git, GitError } from '../git/git.js'\nimport { gitCapped, type ContextOpts } from './git.js'\nimport { stagedPathCanonical } from './paths.js'\nimport type { Tree } from './tree.js'\n\n// The tree's blob for `relpath`, or null when the path is not canonical or\n// not in the tree.\nexport async function stagedContent (\n    repo:string,\n    tree:Tree,\n    relpath:string,\n    opts:ContextOpts = {}\n):Promise<Buffer|null> {\n    if (!stagedPathCanonical(relpath)) return null\n    try {\n        return await git(repo, ['cat-file', 'blob', `${tree.oid}:${relpath}`],\n            opts)\n    } catch (err) {\n        opts.signal?.throwIfAborted()\n        if (err instanceof GitError) return null\n        throw err\n    }\n}\n\nexport interface CeilingContent {\n    content:Buffer;\n    // The blob held more than the ceiling; only the first part was read.\n    truncated:boolean;\n}\n\n// At most `ceiling` bytes of the tree's blob, streamed: the child is\n// killed once the ceiling is exceeded. null as for stagedContent.\nexport async function stagedContentCeiling (\n    repo:string,\n    tree:Tree,\n    relpath:string,\n    ceiling:number,\n    opts:ContextOpts = {}\n):Promise<CeilingContent|null> {\n    if (!stagedPathCanonical(relpath)) return null\n    const res = await gitCapped(repo,\n        ['cat-file', 'blob', `${tree.oid}:${relpath}`], ceiling, opts)\n    if (!res.ok) return null\n    return { content:res.out, truncated:res.truncated }\n}\n    // Overrides the module-level fetch (http.ts) for this client.\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface ToolDefinition {\n    name:string;\n    description:string;\n    // The complete caller JSON Schema.\n    schema:Record<string, unknown>;\n}\n\n// A tool the agent loop offers the model (spec 07, 3.3). The final tool\n// has no `run`.\nexport interface Tool {\n    name:string;\n    description:string;\n    schema:Record<string, unknown>;\n    run?:(args:Record<string, unknown>, signal:AbortSignal) =>\n        unknown|Promise<unknown>;\n    recordsResult?:boolean;\n}\n\nexport type AssistantPart =\n    | { type:'text', text:string }\n    | {\n        type:'reasoning';\n        text:string;\n        signature?:string;\n        redactedData?:string;\n    }\n    // `input` is the raw argument string as received.\n    | { type:'tool-call', id:string, name:string, input:string }\n\nexport interface ToolResult {\n    callId:string;\n    name:string;\n    output:string;\n    isError:boolean;\n}\n\nexport type ConversationItem =\nsrc/llm/json.ts:7:export function encodeToolResult (value:unknown):string {\nsrc/llm/json.ts:21:export function wellFormed (s:string):string {\nsrc/llm/json.ts:41:export function decodeModelText (bytes:Uint8Array):string {\nsrc/gocompat/match.ts:174:export function goPathMatch (pattern:string, name:string):boolean {\nsrc/gocompat/duration.ts:4:export type GoDuration = bigint\nsrc/gocompat/duration.ts:36:export function parseGoDuration (orig:string):GoDuration {\nsrc/gocompat/duration.ts:108:export function isGoDuration (s:string):boolean {\nsrc/gocompat/duration.ts:118:export function toMillis (ns:GoDuration):number {\nsrc/gocompat/duration.ts:133:export function formatGoDuration (d:GoDuration):string {\nsrc/gocompat/strings.ts:7:export function isGoSpace (cp:number):boolean {\nsrc/gocompat/strings.ts:19:export function goTrimSpace (s:string):string {\nsrc/gocompat/strings.ts:30:export function goExt (path:string):string {\nsrc/gocompat/strings.ts:47:export function truncateUtf8 (s:string, maxBytes:number):string {\nsrc/gocompat/strings.ts:62:export function formatFixed2 (x:number):string {\nsrc/gocompat/strings.ts:75:export function compareBytes (a:string, b:string):number {\nsrc/gocompat/strings.ts:106:export function goQuote (s:string):string {\nsrc/snapshot/denylist.ts:10:export const DEFAULT_DENYLIST:readonly string[] = Object.freeze([\nsrc/snapshot/denylist.ts:25:export function denylisted (\nsrc/snapshot/denylist.ts:37:export interface DenylistedUntrackedOpts {\nsrc/snapshot/denylist.ts:46:export async function denylistedUntracked (\nsrc/context/snippet.ts:14:export const FILE_SNIPPET_BYTES = 120000\nsrc/context/snippet.ts:112:export async function numberedSnippet (\nsrc/context/snippet.ts:180:export async function buildFileContext (","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Nxh5DDvrrHNgKfjKEUDUAk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
