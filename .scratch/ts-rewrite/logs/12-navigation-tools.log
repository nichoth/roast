pet size each file gets in buildFileContext.\nexport const FILE_SNIPPET_BYTES = 120000\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\n// Splits on `\\n`, dropping one trailing empty element.\nfunction splitLines (b:Buffer):Buffer[] {\n    if (b.length === 0) return []\n    const lines:Buffer[] = []\n    let start = 0\n    for (;;) {\n        const end = b.indexOf(0x0a, start)\n        if (end === -1) {\n            if (start < b.length) lines.push(b.subarray(start))\n            return lines\n        }\n        lines.push(b.subarray(start, end))\n        start = end + 1\n    }\n}\n\nfunction numbered (n:number, line:Buffer):string {\n    return `${String(n).padStart(5)}  ${line.toString('utf8')}`\n}\n\ninterface Read {\n    content:Buffer;\n    header:string;\n}\n\n// The pinned blob, or a notice string.\nasync function readPinned (\n    repo:string,\n    relpath:string,\n    ceiling:number,\n    tree:Tree,\n    opts:ContextOpts\n):Promise<Read|string> {\n    const res = await stagedContentCeiling(repo, tree, relpath, ceiling, opts)\n    if (res === null) {\n        return staged(tree) ?\n            `### ${relpath}\\n(not in the index ${EM} staged deletion?)\\n` :\n            `### ${relpath}\\n(not in the captured worktree)\\n`\n    }\n    let header = ''\n    if (res.truncated) {\n31:    \"lint\": \"node --import ./scripts/eslint-ts6.ts node_modules/eslint/bin/eslint.js src test scripts eslint.config.js --ignore-pattern 'src/launcher.ts' --ignore-pattern 'test/*.test.ts' --ignore-pattern 'test/release-fixture.ts' --ignore-pattern 'scripts/build.ts' --ignore-pattern 'scripts/check-pack.ts' --ignore-pattern 'scripts/check-release.ts' --ignore-pattern 'scripts/platforms.ts' --ignore-pattern 'scripts/release.ts' --ignore-pattern 'scripts/version.ts'\",\n32:    \"typecheck\": \"tsc -p tsconfig.json\",\n34:    \"bundle\": \"npm run schema && node scripts/bundle.ts\",\n37:    \"build:test\": \"node scripts/b