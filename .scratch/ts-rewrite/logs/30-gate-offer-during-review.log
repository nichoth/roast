{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MuEp6hbNiBkRRW48Pp3Jx6","type":"tool_result","content":"// Gate test repositories (spec 12, 5): every git child runs with the\n// global and system config cut out, and new repos disable background\n// maintenance so a detached `git gc` cannot race temp-dir removal.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { tempRepo, tempDir, type TempDir } from '../helpers/repo.js'\nimport type { CleanupTest } from '../helpers/test.js'\n\nexport const ISOLATED_GIT = {\n    GIT_CONFIG_GLOBAL:'/dev/null',\n    GIT_CONFIG_SYSTEM:'/dev/null',\n    GIT_CONFIG_NOSYSTEM:'1',\n}\n\nexport interface GateRepo extends TempDir {\n    hooks:string;\n    hook:string;\n    sidecar:string;\n}\n\n// Runs git in `repo` with `env`, returning trimmed stdout.\nexport function git (\n    repo:string,\n    env:Record<string, string>,\n    ...args:string[]\n):string {\n    return execFileSync('git', ['-C', repo, ...args], {\n        env,\n        encoding:'utf8',\n        stdio:['ignore', 'pipe', 'pipe'],\n    }).trim()\n}\n\n// A local config value, '' when unset.\nexport function localConfig (r:GateRepo, key:string):string {\n    try {\n        return git(r.dir, r.env, 'config', '--local', '--get', key)\n    } catch {\n        return ''\n    }\n}\n\nexport function gateRepo (t:CleanupTest, toplevelConfig = true):GateRepo {\n    const base = tempRepo('roast-gate-')\n    t.cleanup(base.remove)\n    const env = { ...base.env, ...ISOLATED_GIT }\n    for (const [k, v] of [\n        ['maintenance.auto', 'false'],\n        ['gc.auto', '0'],\n        ['user.email', 'roast-test@example.com'],\n        ['user.name', 'roast test'],\n        ['commit.gpgsign', 'false'],\n    ]) {\n        git(base.dir, env, 'config', k, v)\n    }\n    if (toplevelConfig) {\n        fs.writeFileSync(path.join(base.dir, '.roast.json'), '{\"version\": 1}')\n    }\n    const hooks = path.join(base.dir, '.git', 'hooks')\n    return {\n        ...base,\n        env,\n        hooks,\n        hook:path.join(hooks, 'pre-commit'),\n        sidecar:path.join(hooks, 'roast-pre-commit'),\n    }\n}\n\n// A scratch directory outside any repository.\nexport function scratch (t:CleanupTest):string {\n    const d = tempDir('roast-gate-scratch-')\n    t.cleanup(d.remove)\n    return d.dir\n}\n\nexport function writeHook (file:string, body:string, mode = 0o755):void {\n    fs.mkdirSync(path.dirname(file), { recursive:true })\n    fs.writeFileSync(file, body)\n    fs.chmodSync(file, mode)\n}\n\nexport function read (file:string):string {\n    return fs.readFileSync(file, 'utf8')\n}\n\nexport function modeOf (file:string):number {\n    return fs.statSync(file).mode & 0o777\n}\n// A hooks directory shared by two repositories through core.hooksPath\n// (spec 12, 5, \"Shared dispatcher\").\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { runRoast } from '../helpers/run.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport { inspect, isActive } from '../../src/gate/hook.js'\nimport {\n    git,\n    localConfig,\n    read,\n    scratch,\n    writeHook,\n    type GateRepo,\n} from './helpers.js'\nimport { CLEAN, commit, newStub, seededRepo } from './exec-helpers.js'\n\nconst SCRIPT = fs.readFileSync(\n    path.join(ROOT, 'internal', 'gate', 'pre-commit.sh'), 'utf8')\n\nconst LEGACY = '#!/bin/sh\\n# roast-gate-hook: v1\\n# legacy\\nexit 0\\n'\n\n// A roast.gate=enabled from a non-local scope (command-line config from\n// the environment), which must never enroll a repository.\nconst NON_LOCAL_ENABLED = {\n    GIT_CONFIG_COUNT:'1',\n    GIT_CONFIG_KEY_0:'roast.gate',\n    GIT_CONFIG_VALUE_0:'enabled',\n}\n\ninterface Shared {\n    first:GateRepo;\n    second:GateRepo;\n    hooks:string;\n    hook:string;\n    sidecar:string;\n}\n\nfunction sharedRepos (t:CleanupTest):Shared {\n    const first = seededRepo(t)\n    const second = seededRepo(t)\n    const hooks = scratch(t)\n    for (const r of [first, second]) {\n        git(r.dir, r.env, 'config', 'core.hooksPath', hooks)\n    }\n    return {\n        first,\n        second,\n        hooks,\n        hook:path.join(hooks, 'pre-commit'),\n        sidecar:path.join(hooks, 'roast-pre-commit'),\n    }\n}\n\nfunction gate (r:GateRepo, sub:string) {\n    return runRoast(['gate', sub], { cwd:r.dir, env:r.env })\n}\n\ntest('a shared hook does not review without local consent', async t => {\n    for (const decision of ['', 'declined', 'unexpected']) {\n        const s = sharedRepos(t)\n        t.equal((await gate(s.first, 'enable')).code, 0, 'enable first')\n        git(s.second.dir, s.second.env, 'config', '--local', '--unset-all',\n            'roast.gate')\n        if (decision) {\n            git(s.second.dir, s.second.env, 'config', '--local',\n                'roast.gate', decision)\n        }\n        const stub = newStub(t, s.first.dir, s.second.dir)\ninternal/gate/shared_test.go:78:func TestBootstrapDoesNotAdoptInheritedGate(t *testing.T) {\ninternal/gate/shared_test.go-79-\tfor _, interactive := range []bool{false, true} {\ninternal/gate/shared_test.go-80-\t\tt.Run(map[bool]string{false: \"noninteractive\", true: \"interactive\"}[interactive], func(t *testing.T) {\ninternal/gate/shared_test.go-81-\t\t\tfirst, second, hooks := sharedRepos(t)\ninternal/gate/shared_test.go-82-\t\t\tif err := RecordDecision(second, DecisionNone); err != nil {\ninternal/gate/shared_test.go-83-\t\t\t\tt.Fatal(err)\ninternal/gate/shared_test.go-84-\t\t\t}\ninternal/gate/shared_test.go-85-\t\t\twriteHook(t, filepath.Join(hooks, HookName), \"#!/bin/sh\\n\"+HookMarker+\"\\n# legacy dispatcher\\nexit 0\\n\", 0o755)\ninternal/gate/shared_test.go-86-\t\t\tvar prompt func(string) (bool, error)\ninternal/gate/shared_test.go-87-\t\t\tasked := false\ninternal/gate/shared_test.go-88-\t\t\tif interactive {\ninternal/gate/shared_test.go-89-\t\t\