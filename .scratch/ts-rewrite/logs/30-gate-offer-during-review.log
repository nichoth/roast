efixBytes + GREP_LINE_BYTES)\nsrc/cli/terminal.ts:70:    async readLine ():Promise<string|null> {\nsrc/cli/terminal.ts:95:    const answer = await lines.readLine()\nsrc/cli/terminal.ts:110:    const answer = await lines.readLine()\nsrc/cli/terminal.ts:170:        answer = await lines.readLine()\nsrc/cli/terminal.ts:214:    interactiveTerminals:defaultInteractiveTerminals,\nsrc/cli/terminal.ts:218:export function interactiveTerminals (\nsrc/cli/terminal.ts:222:    return terminalHooks.interactiveTerminals(stdin, stderr)\nsrc/cli/login.ts:26:import { interactiveTerminals, openBrowser, readSecret } from './terminal.js'\nsrc/cli/login.ts:181:    if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {\nsrc/cli/login.ts:255:    if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {\nsrc/cli/init.ts:12:import { interactiveTerminals, promptYesDefault } from './terminal.js'\nsrc/cli/init.ts:21:        if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {\nsrc/cli/trust.ts:19:import { interactiveTerminals, promptNoDefault } from './terminal.js'\nsrc/cli/trust.ts:77:    if (!interactiveTerminals(io.stdin, io.stderr)) {\nsrc/cli/review.ts:194:async function maybeBootstrapGate (_ctx:RunContext):Promise<void> {}\nsrc/cli/review.ts:656:    await maybeBootstrapGate(ctx)\nsrc/cli/openrouter-login.ts:226:        answer = await abortable(ctx.lines.readLine(), ctx.signal)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01QXEszTaGAmwPz1CxYABjTa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
