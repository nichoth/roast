eta.js'\nimport { rfc3339NanoUTC } from '../record/json.js'\nimport { ResponseRecorder } from '../record/responses.js'\nimport { newRunId } from '../record/run-id.js'\nimport { toJSON, toMarkdown, type Report } from '../render/render.js'\nimport { writeReport } from '../render/write.js'\nimport { classifyMode } from '../review/classify.js'\nimport { find } from '../review/find.js'\nimport {\n    type Result, type WireFinding, maxSeverity,\n} from '../review/types.js'\nimport { buildBundle } from '../runbundle/bundle.js'\n}\n\nfunction countNewlines (s:string):number {\n    let n = 0\n    for (let i = s.indexOf('\\n'); i >= 0; i = s.indexOf('\\n', i + 1)) n++\n    return n\n}\n\nfunction utf8Bytes (s:string):number {\n    return Buffer.byteLength(s, 'utf8')\n}\n\n// The gate bootstrap offer (spec 01, 2.9) runs here once ticket 30\n// lands; it is a no-op until then.\nasync function maybeBootstrapGate (_ctx:RunContext):Promise<void> {}\n\ninterface Roles {\n    finder:ResolvedRole;\n    verifier:ResolvedRole;\n    doVerify:boolean;\n}\n}\n\nasync function priorNotes (\n    records:string,\n    repo:string,\n    result:Result\n):Promise<Map<string, string>|null> {\n    const seen = await seenBefore(records, repo, result.findings, 3)\n        .catch(() => new Map())\n    if (seen.size === 0) return null\n    const out = new Map<string, string>()\n    for (const [fp, sighting] of seen) {\n        let note = `seen previously in run ${sighting.runTS}`\n        if (sighting.dropReason) note += ` (dropped: ${sighting.dropReason})`\n        out.set(fp, note)\n    }\n    return out\n}\n\nasync function insideRepository (ctx:RunContext):Promise<boolean> {\n    try {\n        await gitRoot(ctx.cwd, {\n            env:ctx.env as NodeJS.ProcessEnv,\n            signal:ctx.signal,\n        })\n        return true\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        return false\n    }\n}\n\nasync function reviewHandler (\n    args:CommandArgs,\n    ctx:RunContext\n):Promise<void> {\n    await maybeBootstrapGate(ctx)\n    const explicit = ctx.path.length > 0\n    if (!explicit && !(await insideRepository(ctx))) {\n        ctx.stderr.write('roast: not in a Git repository; cd into one to ' +\n            'review, or try `roast doctor` / `roast --help`\\n')\n        ctx.stdout.write(await ctx.rootHelp())\n        return\n    }\n    await runReview(parseReviewFlags(args, ctx.argv), ctx)\n}\n\nexport const reviewCommand:CommandDef = {\n    command:['review', '$0'],\n    describe:'Review the current changes (the default command)',\n    builder:reviewBuilder,\n    handler:reviewHandler,\n}\nsrc/gate/constants.ts:6:export const HOOK_SCRIPT:string = hookScript\nsrc/gate/constants.ts:8:export const HOOK_NAME = 'pre-commit'\nsrc/gate/constants.ts:9:export const SIDECAR_NAME = 'roast-pre-commit'\nsrc/gate/constants.ts:10:export const HOOK_MARKER = '# roast-gate-hook: v1'\nsrc/gate/constants.ts:11:export const HOOK_HEADER = `#!/bin/sh\\n${HOOK_MARKER}\\n`\nsrc/gate/constants.ts:12:export const APPEND_BEGIN =\nsrc/gate/constants.ts:14:export const APPEND_END = '# <<< roast pre-commit gate <<<'\nsrc/gate/constants.ts:16:export const CONFIG_KEY_DECISION = 'roast.gate'\nsrc/gate/constants.ts:17:export const CONFIG_KEY_NOTICE = 'roast.gate-notice'\nsrc/gate/constants.ts:22:export function manualLine ():string {\nsrc/gate/decision.ts:9:export type Decision = 'none'|'enabled'|'declined'\nsrc/gate/decision.ts:16:export async function readDecision (repo:string, env:Env):Promise<Decision> {\nsrc/gate/decision.ts:26:export async function recordDecision (\nsrc/gate/decision.ts:40:export function recordNotice (repo:string, env:Env):Promise<void> {\nsrc/gate/git-config.ts:6:export type Env = Readonly<Record<string, string|undefined>>\nsrc/gate/git-config.ts:17:export async function configGet (\nsrc/gate/git-config.ts:31:export async function configSet (\nsrc/gate/git-config.ts:46:export function configUnset (\nsrc/gate/git-config.ts:56:export functio