[] = []\n\n// Adds a command to every later run; returns a function removing it.\nexport function registerCommand (def:CommandDef):() => void {\n    registered.push(def)\n    return () => {\n        const i = registered.indexOf(def)\n        if (i >= 0) registered.splice(i, 1)\n    }\n}\n\nexport function registeredCommands ():readonly CommandDef[] {\n    return registered\n}\n    if (!hasHeader(await readFile(file))) return\n    try {\n        await fs.rm(file)\n    } catch (err) {\n        if (!isCode(err, 'ENOENT')) throw fail(`remove ${file}`, err)\n    }\n}\n\n// Refreshes an existing Roast-owned regular sidecar; never creates one.\nasync function refreshOwnedSidecar (file:string):Promise<void> {\n    let info\n    try {\n        info = await fs.lstat(file)\n    } catch (err) {\n        if (isCode(err, 'ENOENT')) return\n        throw fail(`stat ${file}`, err)\n    }\n    if (!info.isFile()) return\n    const body = await readFile(file)\n    if (hasHeader(body) && !body.equals(SCRIPT_BYTES)) {\n        await writeSidecar(file)\n    }\n}\n\n// Inserts the block right after the shebang (a tail block would never run\n// in a hook ending in `exit 0`), keeping the hook's mode exactly, so a\n// `roast gate enable|disable|status` and the hidden `gate settings` the\n// pre-commit hook calls (spec 12, 2.10).\nimport type { Argv } from 'yargs'\nimport { recordDecision } from '../gate/decision.js'\nimport { manualLine } from '../gate/constants.js'\nimport { inspect, install, remove, summary } from '../gate/hook.js'\nimport { gitRoot } from '../git/git.js'\nimport type { CommandArgs, CommandDef, RunContext } from './command.js'\nimport { NO_GATE_CONFIG, gateConfigPath, loadProjectConfig } from './config.js'\nimport { UsageError } from './errors.js'\n\nimport {\n    GATE_DEFAULT_TIMEOUT, GATE_DEFAULT_SEVERITY,\n} from '../config/defaults.js'\nexport {\n    GATE_DEFAULT_TIMEOUT, GATE_DEFAULT_SEVERITY,\n} from '../config/defaults.js'\n\n// Prints the gate's timeout and severi