{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChLv3cfDcicRoB6bD38wp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011JEWJtscCaohurnYf8Z77i","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-30-gate-offer-during-review/test/cli/gate-offer.ts","content":"// The gate offer before a review (spec 01, 2.9; spec 12, 2.11), driven\n// through the in-process CLI against the fake inference server. Outcomes\n// are observed through local git config and hook files.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport { simulateTerminals } from '../helpers/terminal.js'\nimport {\n    type ReviewRepo,\n    requestRecorder,\n    settingsRepo,\n} from '../helpers/review.js'\nimport { ISOLATED_GIT, git } from '../gate/helpers.js'\n\nconst SCRIPT = fs.readFileSync(\n    path.join(ROOT, 'internal', 'gate', 'pre-commit.sh'), 'utf8')\n\nconst REVIEW = ['review', '--quick', '--format', 'json']\n\ninterface OfferRepo extends ReviewRepo {\n    hook:string;\n    // A local git config value, '' when unset.\n    local (key:string):string;\n}\n\nasync function offerRepo (\n    t:CleanupTest,\n    opts:{ config?:object|null, approve?:boolean } = {}\n):Promise<OfferRepo> {\n    const r = await settingsRepo(t, undefined, opts)\n    Object.assign(r.env, ISOLATED_GIT)\n    return {\n        ...r,\n        hook:path.join(r.dir, '.git', 'hooks', 'pre-commit'),\n        local:(key:string) => {\n            try {\n                return git(r.dir, r.env, 'config', '--local', '--get', key)\n            } catch {\n                return ''\n            }\n        },\n    }\n}\n\ntest('a yes on a terminal installs the gate and the review runs',\n    async t => {\n        simulateTerminals(t, true)\n        const r = await offerRepo(t)\n        const requests = requestRecorder(r)\n        const res = await r.roast(REVIEW, { stdin:'y\\n' })\n        t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n        t.equal(r.local('roast.gate'), 'enabled', 'records enabled')\n        t.equal(fs.readFileSync(r.hook, 'utf8'), SCRIPT, 'hook installed')\n        t.ok(requests().length > 0, 'the review reached the fake server')\n    })\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4719,"cache_read_input_tokens":95821,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4719},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7bd047a4-2a9e-4212-bc74-c03950f158ae","uuid":"89c91e14-1f2d-41c7-b7eb-be1a72a2ecd9","timestamp":"2026-11-24T01:51:25.322Z","request_id":"req_011ChLv3cWncx3Fxj89Qfo9X","wire_tool_inputs":{"toolu_011JEWJtscCaohurnYf8Z77i":{"file_path":"/Users/nick/code/roast.ts-rewrite-30-gate-offer-during-review/test/cli/gate-offer.ts","content":"// The gate offer before a review (spec 01, 2.9; spec 12, 2.11), driven\n// through the in-process CLI against the fake inference server. Outcomes\n// are observed through local git config and hook files.\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport { simulateTerminals } from '../helpers/terminal.js'\nimport {\n    type ReviewRepo,\n    requestRecorder,\n    settingsRepo,\n} from '../helpers/review.js'\nimport { ISOLATED_GIT, git } from '../gate/helpers.js'\n\nconst SCRIPT = fs.readFileSync(\n    path.join(ROOT, 'internal', 'gate', 'pre-commit.sh'), 'utf8')\n\nconst REVIEW = ['review', '--quick', '--format', 'json']\n\ninterface OfferRepo extends ReviewRepo {\n    hook:string;\n    // A local git config value, '' when unset.\n    local (key:string):string;\n}\n\nasync function offerRepo (\n    t:CleanupTest,\n    opts:{ config?:object|null, approve?:boolean } = {}\n):Promise<OfferRepo> {\n    const r = await settingsRepo(t, undefined, opts)\n    Object.assign(r.env, ISOLATED_GIT)\n    return {\n        ...r,\n        hook:path.join(r.dir, '.git', 'hooks', 'pre-commit'),\n        local:(key:string) => {\n            try {\n                return git(r.dir, r.env, 'config', '--local', '--get', key)\n            } catch {\n                return ''\n            }\n        },\n    }\n}\n\ntest('a yes on a terminal installs the gate and the review runs',\n    async t => {\n        simulateTerminals(t, true)\n        const r = await offerRepo(t)\n        const requests = requestRecorder(r)\n        const res = await r.roast(REVIEW, { stdin:'y\\n' })\n        t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n        t.equal(r.local('roast.gate'), 'enabled', 'records enabled')\n        t.equal(fs.readFileSync(r.hook, 'utf8'), SCRIPT, 'hook installed')\n        t.ok(requests().length > 0, 'the review reached the fake server')\n    })\n"}}}
