{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XmKihpcjgpYS83WUS7R7kR","type":"tool_result","content":"        roles:{ finder:{ profile:'o' }, verifier:{ profile:'o' } },\n        review:{ snapshot:false },\n    })\n    r.env.OPENAI_API_KEY = 'ambient-openai-key'\n    delete r.env.ROAST_FINDER_API_KEY\n    const res = await r.roast(REVIEW)\n    t.equal(res.code, 0, res.stderr)\n    t.deepEqual(res.hosts, ['api.openai.com'], 'built-in endpoint')\n    t.ok(!fs.existsSync(trustFile(r)), 'no trust record written')\n})\n\ntest('the inline trust prompt approves on y and declines otherwise',\n    async t => {\n        simulateTerminals(t, true)\n        const r = await settingsRepo(t, undefined, { approve:false })\n        const requests = requestRecorder(r)\n        for (const answer of ['', 'n\\n', 'no\\n', 'yy\\n']) {\n            const res = await r.roast(REVIEW, { stdin:answer })\n            t.equal(res.code, 2, `${JSON.stringify(answer)} declines`)\n            t.ok(!fs.existsSync(trustFile(r)), 'no record')\n        }\n        t.equal(requests().length, 0, 'declined reviews send nothing')\n        const yes = await r.roast(REVIEW, { stdin:'y\\n' })\n        t.equal(yes.code, 0, yes.stderr)\n        t.ok(fs.existsSync(trustFile(r)), 'approval recorded')\n        t.equal(requests().length, 1, 'review proceeds')\n        t.equal((await r.roast(REVIEW)).code, 0, 'approval persists')\n    })\n\ntest('without terminals the review never reads stdin', async t => {\n    simulateTerminals(t, false)\n    const r = await settingsRepo(t, undefined, { approve:false })\n    let reads = 0\n    const stdin = new Readable({\n        read () {\n            reads++\n            this.push('y\\n')\n            this.push(null)\n        },\n    })\n    const res = await r.roast(REVIEW, { stdin })\n    async t => {\n        const h = harness(t)\n        const err = await failure(requireTrust(h.repo.dir, CUSTOM, h.io))\n        t.ok(err instanceof UsageError, 'usage error without prompting')\n        t.equal(h.reads(), 0, 'stdin untouched')\n    })\n\ntest('requireTrust on terminals approves on y', async t => {\n    for (const legacy of [false, true]) {\n        const h = harness(t, 'y\\n')\n        simulateTerminals(t, true)\n        if (legacy) writeRecord(h, '{\"version\":1,\"approved\":[\"x\"]}')\n        const err = await failure(requireTrust(h.repo.dir, CUSTOM, h.io))\n        t.equal(err, undefined, 'resolves')\n        t.ok(h.stderr.text().includes('https://gw.example/v1'),\n            'summary on stderr')\n        t.ok(h.stderr.text().includes('[y/N]'), 'asks on stderr')\n        t.deepEqual(JSON.parse(fs.readFileSync(h.file, 'utf8')),\n            { version:2, approved:[HASH] }, 'record written')\n    }\n})\n\ntest('requireTrust on terminals declined records nothing', async t => {\n    for (const answer of ['', '\\n', 'n\\n', 'no\\n', 'yy\\n']) {\n        const h = harness(t, answer)\n        simulateTerminals(t, true)\n        const err = await failure(requireTrust(h.repo.dir, CUSTOM, h.io))\n        t.ok(err instanceof UsageError, `${JSON.stringify(answer)}: usage`)\n        t.ok(!fs.existsSync(h.file), 'nothing written')\n    }\n})\n\ntest('requireTrust rethrows a malformed record as non-usage', async t => {\n    for (const terminals of [false, true]) {\n        const h = harness(t, 'y\\n')\n        simulateTerminals(t, terminals)\n        writeRecord(h, '{not json')\n        const err = await failure(requireTrust(h.repo.dir, CUSTOM, h.io))\n        t.ok(err instanceof Error, 'fails')\n        t.equal(exitCode(err), ExitCode.Partial, 'exit 4')\n        t.equal(h.reads(), 0, 'stdin untouched')\n        t.equal(fs.readFileSync(h.file, 'utf8'), '{not json',\n            'file unchanged')\n    }\n})","is_error":false}]},"parent_tool_use_id":null,"session_id":"7bd047a4-2a9e-4212-bc74-c03950f158ae","uuid":"dd4c0291-ba5d-4cf7-b6e5-91d7bd94a86f","timestamp":"2026-11-24T01:51:10.671Z","tool_use_result":{"stdout":"     