{"duration_api_ms":222271,"stop_reason":"end_turn","session_id":"7bd047a4-2a9e-4212-bc74-c03950f158ae","total_cost_usd":2.2990258000000003,"usage":{"input_tokens":84,"cache_creation_input_tokens":119240,"cache_read_input_tokens":4248149,"output_tokens":24757,"output_tokens_details":{"thinking_tokens":4664},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":119240,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":22,"cache_read_input_tokens":131009,"cache_creation_input_tokens":190,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":190},"type":"message"}],"speed":"standard","fallback_credit":null},"modelUsage":{"claude-opus-5-5":{"inputTokens":84,"outputTokens":24757,"cacheReadInputTokens":4248149,"cacheCreationInputTokens":119240,"webSearchRequests":0,"costUSD":2.2990258000000003,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4664,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":119240,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[{"tool_name":"Bash","tool_use_id":"toolu_011MEeYA1fNjoDSVWtGbPQ1D","tool_input":{"command":"cat >> test/cli/gate-offer.ts <<'EOF'\n\n// A stdin that answers `y` and counts how often it was read.\nfunction countingStdin ():{ stdin:Readable, reads:() => number } {\n    let reads = 0\n    const stdin = new Readable({\n        read () {\n            reads++\n            this.push('y\\n')\n            this.push(null)\n        },\n    })\n    return { stdin, reads:() => reads }\n}\n\n// Every local roast.* key and value.\nfunction gateKeys (r:OfferRepo):string {\n    try {\n        return git(r.dir, r.env, 'config', '--local', '--get-regexp',\n            '^roast\\\\.')\n    } catch {\n        return ''\n    }\n}\n\ntest('a no is remembered and never asked again', async t => {\n    simulateTerminals(t, true)\n    const r = await offerRepo(t)\n    const res = await r.roast(REVIEW, { stdin:'n\\n' })\n    t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n    t.equal(r.local('roast.gate'), 'declined', 'records declined')\n    t.ok(!fs.existsSync(r.hook), 'no hook')\n    const again = countingStdin()\n    const second = await r.roast(REVIEW, { stdin:again.stdin })\n    t.equal(second.code, 0, 'second review exits 0')\n    t.equal(again.reads(), 0, 'the offer reads no stdin')\n    t.ok(!fs.existsSync(r.hook), 'still no hook')\n})\n\ntest('without terminals the offer is a one-time hint', async t => {\n    simulateTerminals(t, false)\n    const r = await offerRepo(t)\n    const res = await r.roast(REVIEW)\n    t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n    t.equal(r.local('roast.gate-notice'), 'sent', 'notice recorded')\n    t.equal(r.local('roast.gate'), '', 'no decision')\n    t.ok(!fs.existsSync(r.hook), 'no hook')\n    const before = gateKeys(r)\n    t.equal((await r.roast(REVIEW)).code, 0, 'second review exits 0')\n    t.equal(gateKeys(r), before, 'config unchanged')\n    t.ok(!fs.existsSync(r.hook), 'still no hook')\n})\n\ntest('GIT_INDEX_FILE suppresses the offer', async t => {\n    for (const terminals of [false, true]) {\n        simulateTerminals(t, terminals)\n        const r = await offerRepo(t)\n        r.env.GIT_INDEX_FILE = path.join(r.dir, '.git', 'index')\n        const stdin = countingStdin()\n        await r.roast(REVIEW, { stdin:stdin.stdin })\n        t.equal(gateKeys(r), '', 'no roast.gate keys')\n        t.equal(stdin.reads(), 0, 'no prompt')\n        t.ok(!fs.existsSync(r.hook), 'no hook')\n    }\n})\n\ntest('gate.offer false neither prompts nor hints', async t => {\n    for (const terminals of [false, true]) {\n        simulateTerminals(t, terminals)\n        const r = await offerRepo(t, { config:{} })\n        writeConfig(r.dir, profileConfig(r.server.url,\n            { gate:{ offer:false } }))\n        await approveProjectConfig(r)\n        const stdin = countingStdin()\n        const res = await r.roast(REVIEW, { stdin:stdin.stdin })\n        t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n        t.equal(stdin.reads(), 0, 'no prompt')\n        t.equal(gateKeys(r), '', 'notice not consumed')\n        t.ok(!fs.existsSync(r.hook), 'no hook')\n    }\n})\n\ntest('ROAST_NO_HOOK does not stop the offer', async t => {\n    simulateTerminals(t, false)\n    const r = await offerRepo(t)\n    r.env.ROAST_NO_HOOK = '1'\n    const res = await r.roast(REVIEW)\n    t.equal(res.code, 0, `exits 0 ${res.stderr}`)\n    t.equal(r.local('roast.gate-notice'), 'sent', 'hinted')\n})\n\ntest('only a toplevel config gets an offer', async t => {\n    simulateTerminals(t, false)\n    const sub = await offerRepo(t, { config:null })\n    const dir = path.join(sub.dir, 'pkg')\n    writeConfig(dir, profileConfig(sub.server.url))\n    await approveProjectConfig(sub, [], dir)\n    const res = await sub.roast(REVIEW, { cwd:dir })\n    t.equal(res.code, 0, `subdirectory config reviews ${res.stderr}`)\n    t.equal(gateKeys(sub), '', 'no offer for a subdirectory config')\n\n    for (const format of ['json', 'markdown']) {\n        const top = await offerRepo(t)\n        const out = await top.roast(['review', '--quick', '--format', format])\n        t.equal(out.code, 0, `exits 0 ${out.stderr}`)\n        t.equal(top.local('roast.gate-notice'), 'sent',\n            `offer under --format ${format}`)\n    }\n\n    const quiet = await offerRepo(t)\n    const out = await quiet.roast([...REVIEW, '--error-format', 'json'])\n    t.equal(out.code, 0, `exits 0 ${out.stderr}`)\n    t.equal(gateKeys(quiet), '', 'no offer under --error-format json')\n})\n\ntest('a toplevel config that fails to load gives no offer', async t => {\n    simulateTerminals(t, false)\n    const r = await offerRepo(t)\n    writeConfig(r.dir, profileConfig(r.server.url,\n        { gate:{ offer:'no' } }))\n    const res = await r.roast(REVIEW)\n    t.equal(res.code, 2, 'the review reports the config error')\n    t.equal(gateKeys(r), '', 'no offer')\n    t.ok(!fs.existsSync(r.hook), 'no hook')\n})\nEOF\npython3 - <<'EOF'\np='test/cli/gate-offer.ts'\ns=open(p).read()\ns=s.replace(\"\"\"import fs from 'node:fs'\nimport path from 'node:path'\n\"\"\",\"\"\"import fs from 'node:fs'\nimport path from 'node:path'\nimport { Readable } from 'node:stream'\n\"\"\",1)\ns=s.replace(\"\"\"    type ReviewRepo,\n    requestRecorder,\n    settingsRepo,\n\"\"\",\"\"\"    type ReviewRepo,\n    approveProjectConfig,\n    profileConfig,\n    requestRecorder,\n    settingsRepo,\n    writeConfig,\n\"\"\",1)\nopen(p,'w').write(s)\nEOF\nnpm run test:one -- test/cli/gate-offer.ts 2>&1 | grep -E \"✖|total|passing|failing|Error\" | head -30"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":49,"subtype":"success","api_error_status":null,"result":"Still running with no output yet; waiting for the monitor notice.","ttft_ms":2096,"type":"result","duration_ms":1102619,"uuid":"5fbeb91a-51ae-4198-82e8-e3dde519b0a9","ttft_stream_ms":1725,"time_to_request_ms":602,"first_content_frame_ms":1725,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":84,"outputTokens":24757,"cacheReadInputTokens":4248149,"cacheCreationInputTokens":119240,"webSearchRequests":0,"costUSD":2.2990258000000003,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":4664,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":119240,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"cred