ection restored')\n    t.equal(terminalHooks.openBrowser, realBrowser, 'opener restored')\n})\nEOF\n/tmp/yx/rt.sh test/cli/log.ts 2>&1 | grep -i \"error\" | head -3"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1744,"cache_read_input_tokens":141831,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1744},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4755d765-a6df-4b24-a4bc-26dbeaee612d","uuid":"d6bf2575-7af3-482d-b132-db795a7e6317","timestamp":"2026-11-18T19:30:31.924Z","request_id":"req_011ChAwxbt9M3jR1yQm3XuzP","wire_tool_inputs":{"toolu_014U7hqC76h3yKZ4bWnu9eTD":{"command":"cd /Users/nick/code/roast.ts-rewrite-04-cli-core && cat > test/cli/log.ts <<'EOF'\nimport { test } from '../helpers/test.js'\nimport { logf } from '../../src/cli/log.js'\nimport {\n    interactiveTerminals,\n    openBrowser,\n    terminalHooks,\n} from '../../src/cli/terminal.js'\nimport { BufferStream, inputStream } from '../helpers/streams.js'\nimport { captureBrowser, simulateTerminals } from '../helpers/terminal.js'\n\ntest('logf writes one prefixed, sanitized line', t => {\n    const out = new BufferStream()\n    logf(out, 'scope a\\x1b[2J.go')\n    const s = out.text()\n    t.ok(s.startsWith('roast: '), 'prefixed')\n    t.ok(s.endsWith('\\n'), 'newline terminated')\n    t.ok(!s.includes('\\x1b'), 'no ESC byte')\n})\n\ntest('simulateTerminals and captureBrowser swap and restore', async t => {\n    const realTerminals = terminalHooks.interactiveTerminals\n    const realBrowser = terminalHooks.openBrowser\n    await new Promise<void>(resolve => {\n        // A nested test body, so its cleanups run before the checks below.\n        void (async () => {\n            const cleanups:(() => void)[] = []