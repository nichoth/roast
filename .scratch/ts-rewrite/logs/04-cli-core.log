repo = tempRepo()\n        cwd = repo.dir\n        env ??= repo.env\n        remove = repo.remove\n    }\n    const stdout = new BufferStream()\n    const stderr = new BufferStream()\n    const hosts:string[] = []\n    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?\n        inputStream(opts.stdin ?? '') :\n        opts.stdin\n    try {\n        const res = await run(args, {\n            stdin,\n            stdout,\n            stderr,\n            env:env ?? {},\n            cwd,\n            signal:opts.signal,\n            fetch:opts.redirectTo ?\n                redirectingFetch(opts.redirectTo, hosts) :\n                undefined,\n        })\n        return {\n            ...res,\n            stdout:stdout.text(),\n            stderr:stderr.text(),\n            hosts,\n        }\n    } finally {\n        remove?.()\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":415,"cache_read_input_tokens":120407,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":415},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4755d765-a6df-4b24-a4bc-26dbeaee612d","uuid":"36e5c8d9-18cc-4d8e-920f-748bff4fb410","timestamp":"2026-11-18T19:28:01.017Z","request_id":"req_011ChAwioHbeAUwByLJPuWkk","wire_tool_inputs":{"toolu_01HkiALUVTPRuhv9k8zin5SH":{"file_path":"/Users/nick/code/roast.ts-rewrite-04-cli-core/test/helpers/run.ts","content":"// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a\n// temporary Git repository as cwd, a clean environment, and optionally a\n// fetch that sends every request to a fake server.\nimport { run, type RunResult } from '../../src/cli/run.js'\nimport { BufferStream, inputStream } from './streams.js'\nimport { tempRepo } from