structor (message:string, options?:ErrorOptions) {\n        super('no_final_call', message, options)\n        this.name = 'NoFinalCallError'\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":446,"cache_read_input_tokens":104067,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":446},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4755d765-a6df-4b24-a4bc-26dbeaee612d","uuid":"2e01652c-a7ad-4769-8360-82040da6d20e","timestamp":"2026-11-18T19:25:27.337Z","request_id":"req_011ChAwaFhbMzuEhmcT6dzpA","wire_tool_inputs":{"toolu_014WZPMtXpGHdWVD4CpFTS1B":{"file_path":"/Users/nick/code/roast.ts-rewrite-04-cli-core/src/llm/errors.ts","content":"// The llm area's error kinds. The CLI maps them to exit codes and error\n// categories by walking an error's `cause` chain (src/cli/errors.ts).\n// Ticket 13 extends this file with the protocol adapters' details.\n\nexport type LlmErrorKind =\n    'auth'|'endpoint'|'budget_exhausted'|'work_deadline'|'no_final_call'\n\nexport class LlmError extends Error {\n    readonly kind:LlmErrorKind\n\n    constructor (kind:LlmErrorKind, message:string, options?:ErrorOptions) {\n        super(message, options)\n        this.kind = kind\n        this.name = 'LlmError'\n    }\n}\n\n// The provider answered 401 or 403.\nexport class AuthError extends LlmError {\n    constructor (message:string, options?:ErrorOptions) {\n        super('auth', message, options)\n        this.name = 'AuthError'\n    }\n}\n\n// The endpoint failed: transport errors, redirects, 5xx, bad responses.\nexport class EndpointError extends LlmError {\n    constructor (message:string, options?:ErrorOptions) {\n        super('endpoint', message, options)\n        this.name = 'Endpoi