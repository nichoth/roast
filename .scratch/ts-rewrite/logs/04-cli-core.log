\nconst { run } = await import('./cli/run.js')\nconst { code } = await run(process.argv.slice(2), {\n    stdin:process.stdin,\n    stdout:process.stdout,\n    stderr:process.stderr,\n    env:process.env,\n    cwd:process.cwd(),\n})\n\n// Wait for both streams to flush, then exit even if a handle lingers.\nfunction flush (stream:NodeJS.WriteStream):Promise<void> {\n    return new Promise(resolve => stream.write('', () => resolve()))\n}\nawait Promise.all([flush(process.stdout), flush(process.stderr)])\nprocess.exitCode = code\nprocess.exit(code)\n// The CLI core: run(argv, io). It never reads process globals and never\n// calls process.exit, so tests drive it in-process. In M0 it handles only\n// the root --version / -v and --help; ticket 04 grows the command tree.\nimport yargs from 'yargs'\nimport { buildInfo, formatBuildInfo } from '../buildinfo.js'\n\nexport interface CliIO {\n    stdin:NodeJS.ReadableStream;\n    stdout:NodeJS.WritableStream;\n    stderr:NodeJS.WritableStream;\n    env:Readonly<Record<string, string|undefined>>;\n    cwd:string;\n    signal?:AbortSignal;\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface RunResult {\n    code:number;\n    error?:Error;\n}\n\nconst EXIT_USAGE = 2\n\nfunction parser (argv:string[]) {\n    return yargs(argv)\n        .scriptName('roast')\n        .locale('en')\n        .detectLocale(false) // English only, whatever LANG/LC_ALL say\n        .exitProcess(false)\n        .strict()\n        .usage('$0 [command] [flags]')\n        .version(false) // root-only --version / -v is handled in run\n        .option('version', {\n            alias:'v',\n            type:'boolean',\n            describe:'Print the version and exit',\n        })\n        .help('help')\n        .alias('help', 'h')\n}\n\n// A root-level flag is one that no subcommand token precedes.\nfunction hasRootFlag (argv:string[], names:string[]):boolean {\n    for (const arg of argv) {\n        if (!arg.startsWith('-')) return false\n        if (arg === '--') return false\n        if (names.includes(arg)) return true\n    }\n    return false\n}\n\nexport async function run (argv:string[], io:CliIO):Promise<RunResult> {\n    if (hasRootFlag(argv, ['--version', '-v'])) {\n        io.stdout.write(`roast version ${formatBuildInfo(buildInfo)}\\n`)\n        return { code:0 }\n    }\n    if (hasRootFlag(argv, ['--help', '-h'])) {\n        io.stdout.write(`${await parser(argv).getHelp()}\\n`)\n        return { code:0 }\n    }\n    const error = new Error(\n        `roast ${argv.join(' ')}: not implemented yet in the TypeScript CLI`\n    )\n    io.stderr.write(`${error.message}\\n`)\n    return { code:EXIT_USAGE, error }\n}\n{\n  \"name\": \"@substrate-system/roast\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Adversarial review\",\n  \"license\": \"(MIT OR Apache-2.0)\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"roast\": \"dist/launcher.js\"\n  },\n  \"files\": [\n    \"dist/\",\n    \"roast.schema.json\",\n    \"LICENSE.txt\",\n    \"LICENSE-MIT.txt\",\n    \"LICENSE-APACHE.txt\"\n  ],\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"devEngines\": {\n    \"runtime\": {\n      \"name\": \"node\",\n      \"version\": \">=22.18\"\n    }\n  },\n  \"scripts\": {\n    \"toc\": \"markdown-toc --maxdepth 3 -i README.md\",\n    \"lint\": \"node --import ./scripts/eslint-ts6.ts node_modules/eslint/bin/eslint.js src test scripts eslint.config.js --ignore-pattern 'src/launcher.ts' --ignore-pattern 'test/*.test.ts' --ignore-pattern 'test/release-fixture.ts' --ignore-pattern 'scripts/build.ts' --ignore-pattern 'scripts/check-pack.ts' --ignore-pattern 'scripts/check-release.ts' --ignore-pattern 'scripts/platforms.ts' --ignore-pattern 'scripts/release.ts' --ignore-pattern 'scripts/version.ts'\",\n    \"typecheck\": \"tsc -p tsconfig.json\",\n    \"build\": \"node scripts/build.ts\",\n    \"bundle\": \"node scripts/bundle.ts\",\n    \"build:launcher\": \"tsc -p tsconfig.lau