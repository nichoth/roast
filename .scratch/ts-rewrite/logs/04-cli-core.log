e: run(argv, io). It never reads process globals and never\n// calls process.exit, so tests drive it in-process. In M0 it handles only\n// the root --version / -v and --help; ticket 04 grows the command tree.\nimport yargs from 'yargs'\nimport { buildInfo, formatBuildInfo } from '../buildinfo.js'\n\nexport interface CliIO {\n    stdin:NodeJS.ReadableStream;\n    stdout:NodeJS.WritableStream;\n    stderr:NodeJS.WritableStream;\n    env:Readonly<Record<string, string|undefined>>;\n    cwd:string;\n    signal?:AbortSignal;\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface RunResult {\n    code:number;\n    error?:Error;\n}\n\nconst EXIT_USAGE = 2\n\nfunction parser (argv:string[]) {\n    return yargs(argv)\n        .scriptName('roast')\n        .locale('en')\n        .detectLocale(false) // English only, whatever LANG/LC_ALL say\n        .exitProcess(false)\n        .strict()\n        .usage('$0 [command] [flags]')\n        .version(false) // root-only --version / -v is handled in run\n        .option('version', {\n            alias:'v',\n            type:'boolean',\n            describe:'Print the version and exit',\n        })\n        .help('help')\n        .alias('help', 'h')\n}\n\n// A root-level flag is one that no subcommand token precedes.\nfunction hasRootFlag (argv:string[], names:string[]):boolean {\n    for (const arg of argv) {\n        if (!arg.startsWith('-')) return false\n        if (arg === '--') return false\n        if (names.includes(arg)) return true\n    }\n    return false\n}\n\nexport async function run (argv:string[], io:CliIO):Promise<RunResult> {\n    if (hasRootFlag(argv, ['--version', '-v'])) {\n        io.stdout.write(`roast version ${formatBuildInfo(buildInfo)}\\n`)\n        return { code:0 }\n    }\n    if (hasRootFlag(argv, ['--help', '-h'])) {\n        io.stdout.write(`${await parser(argv).getHelp()}\\n`)\n        return { code:0 }\n    }\n    const error = new Error(\n        `roast ${argv.join(' ')}: not implemented yet in