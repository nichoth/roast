{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAwYNt8poHEcHCqVmdRB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TjgFUNP6c42BJRATqh9pLK","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-04-cli-core/test/helpers/streams.ts","content":"import { PassThrough, Writable } from 'node:stream'\n\n// A writable that keeps everything written to it.\nexport class BufferStream extends Writable {\n    chunks:Buffer[] = []\n\n    _write (\n        chunk:Buffer|string,\n        _enc:BufferEncoding,\n        done:(err?:Error|null) => void\n    ):void {\n        this.chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk))\n        done()\n    }\n\n    text ():string {\n        return Buffer.concat(this.chunks).toString('utf8')\n    }\n}\n\n// A readable stdin fed with fixed text, then EOF.\nexport function inputStream (text = ''):NodeJS.ReadableStream {\n    const s = new PassThrough()\n    s.end(text)\n    return s\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2313,"cache_read_input_tokens":98933,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2313},"output_tokens":35,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4755d765-a6df-4b24-a4bc-26dbeaee612d","uuid":"397a5387-daf5-439c-b199-1a1cc566bc72","timestamp":"2026-11-18T19:25:15.333Z","request_id":"req_011ChAwYNbXWL4txZQVGYQ58","wire_tool_inputs":{"toolu_01TjgFUNP6c42BJRATqh9pLK":{"file_path":"/Users/nick/code/roast.ts-rewrite-04-cli-core/test/helpers/streams.ts","content":"import { PassThrough, Writable } from 'node:stream'\n\n// A writable that keeps everything written to it.\nexport class BufferStream extends Writable {\n    chunks:Buffer[] = []\n\n    _write (\n        chunk:Buffer|string,\n        _enc:BufferEncoding,\n        done:(err?:Error|null) => void\n    ):void {\n        this.chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk))\n        done()\n    }\n\n    text ():string {\n        return Buffer.concat(this.chunks).toString('utf8')\n    }\n}\n\n// A readable stdin fed with fixed text, then EOF.\nexport function inputStream (text = ''):NodeJS.ReadableStream {\n    const s = new PassThrough()\n    s.end(text)\n    return s\n}\n"}}}
