mode')\n    t.equal(s.base, '', 'no base')\n    t.equal(s.headOID, head, 'head OID')\n    t.deepEqual([...s.files],\n        ['README.md', 'cmd/main.go', 'internal/bar.go', 'internal/foo.go'],\n        'files are the sorted tracked list')\n    t.ok(!isEmpty(s), 'not empty')\n    const lines = s.manifest.split('\\n')\n    const headLine = lines.find(l => l.startsWith('HEAD: '))\n    t.ok(headLine?.includes(head.slice(0, 7)), 'HEAD line has the OID')\n    t.ok(lines.includes('internal (2)'), 'per-directory count')\n    t.ok(lines.includes('cmd (1)'), 'per-directory count for cmd')\n    t.ok(lines.includes('README.md (1)'), 'a root file is its own entry')\n    for (const f of s.files) t.ok(lines.includes(f), `lists ${f}`)\n    t.ok(!s.manifest.includes(EXPLAIN), 'plain names: no explanation')\n    repo.cleanup()\n})\n","structuredPatch":[{"oldStart":32,"oldLines":3,"newStart":32,"newLines":151,"lines":["     t.ok(!s.manifest.includes(EXPLAIN), 'plain names: no explanation')","     repo.cleanup()"," })","+","+test('repo survey drops excludes and linguist-generated paths', async t => {","+    const repo = newRepo()","+    repo.write('keep.go', 'package p\\n')","+    repo.write('skip.go', 'package p\\n')","+    repo.write('vendor/foo/bar.go', 'package p\\n')","+    repo.write('gen.pb.go', 'package p\\n')","+    repo.write('.gitattributes', 'gen.pb.go linguist-generated\\n')","+    repo.commitAll()","+    const s = await build(repo.dir, {","+        scope:'repo',","+        excludes:['skip.go'],","+        env:repo.env,","+    })","+    t.deepEqual([...s.files], ['.gitattributes', 'README.md', 'keep.go'],","+        'files')","+    for (const gone of ['skip.go', 'vendor/foo/bar.go', 'gen.pb.go']) {","+        t.ok(!s.manifest.includes(gone), `${gone} absent from manifest`)","+    }","+    const all = await build(repo.dir, {","+        scope:'repo',","+        includeVendored:true,","+        env:repo.env,","+    })","+    t.ok(all.files.includes('gen.pb.go'), 'include-vend