he dirty shared index the gate must\ninternal/scope/scope_test.go-863-\t// NOT review when the commit is scoped to b.go.\ninternal/scope/scope_test.go-864-\twriteFile(t, repo, \"a.go\", \"package p\\n// a-v2-staged-not-committed\\n\")\ninternal/scope/scope_test.go-865-\twriteFile(t, repo, \"b.go\", \"package p\\n// b-v2-in-this-commit\\n\")\ninternal/scope/scope_test.go-866-\tgitAdd(t, repo, \"a.go\")\ninternal/scope/scope_test.go-867-\ninternal/scope/scope_test.go-868-\t// Alternate index holding only b.go's change — what git hands a hook for\ninternal/scope/scope_test.go-869-\t// `git commit b.go`.\ninternal/scope/scope_test.go-870-\talt := filepath.Join(t.TempDir(), \"next-index\")\ninternal/scope/scope_test.go-871-\tt.Setenv(\"GIT_INDEX_FILE\", alt)\ninternal/scope/scope_test.go-872-\tgitRun(t, repo, \"read-tree\", \"HEAD\")\ninternal/scope/scope_test.go-873-\tgitRun(t, repo, \"add\", \"b.go\")\ninternal/scope/scope_test.go-874-\ninternal/scope/scope_test.go-875-\ts, err := Build(repo, BuildOpts{StagedOnly: true})\ninternal/scope/scope_test.go-876-\tif err != nil {\n// Temporary Git repositories for scope and denylist tests. Each repo gets\n// its own HOME, XDG_CONFIG_HOME and global config file, so the user's Git\n// config never reaches these tests and a test may write hostile config.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { execFileSync } from 'node:child_process'\n\nexport interface TestRepo {\n    dir:string;\n    env:NodeJS.ProcessEnv;\n    // The isolated global config file (GIT_CONFIG_GLOBAL).\n    globalConfig:string;\n    // Runs git in the repo and returns stdout.\n    git (...args:string[]):string;\n    write (rel:string, content:string|Buffer):void;\n    commitAll (msg?:string):void;\n    cleanup ():void;\n}\n\nexport function tempDir (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\nexport function newRepo (opts:{ commit?:boolean } = {}):TestRepo {\n    const home = tempDir('roast-scope-home-')\n    const dir = tempDir('roast-scope-repo-')\n    const globalConfig = path.join(home, 'gitconfig')\n    fs.writeFileSync(globalConfig, '')\n    const env:NodeJS.ProcessEnv = {\n        PATH:process.env.PATH ?? '/usr/bin:/bin',\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        GIT_CONFIG_GLOBAL:globalConfig,\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_AUTHOR_NAME:'test',\n        GIT_AUTHOR_EMAIL:'test@example.com',\n        GIT_COMMITTER_NAME:'test',\n        GIT_COMMITTER_EMAIL:'test@example.com',\n    }\n    const repo:TestRepo = {\n        dir,\n        env,\n        globalConfig,\n        git (...args) {\n            return execFileSync('git', ['-C', dir, ...args], {\n                env,\n                encoding:'utf8',\n                stdio:['ignore', 'pipe', 'pipe'],\n                maxBuffer:Infinity,\n            })\n        },\n        write (rel, content) {\n            const p = path.join(dir, rel)\n            fs.mkdirSync(path.dirname(p), { recursive:true })\n            fs.writeFileSync(p, content)\n        },\n        commitAll (msg = 'commit') {\n            repo.git('add', '-A')\n            repo.git('commit', '-q', '--allow-empty', '-m', msg)\n        },\n        cleanup () {\n            fs.rmSync(dir, { recursive:true, force:true })\n            fs.rmSync(home, { recursive:true, force:true })\n        },\n    }\n    repo.git('init', '-q', '-b', 'main')\n    if (opts.commit !== false) {\n        repo.write('README.md', 'hello\\n')\n        repo.commitAll('initial')\n    }\n    return repo\n}\n\n// Lines of text, n of them, each distinct.\nexport function lines (n:number, prefix = 'line'):string {\n    let out = ''\n    for (let i = 0; i < n; i++) out += `${prefix} ${i}\\n`\n    return out\n}\n\n// Paths named in `diff --git a/P b/P` headers, in order.\nexport function sectionPaths (diff:string):string[] {\n    const out:string[] = []\n    for (const line of diff.split('\\n')) {\n        const m = /^diff --git a\\/(.*) b\\/(.*)$/.exec(line)\n        if (m) out.push(m[2])\n    }\n    return out\n}\nimport { test } from '@substrate-system/tapzero'\nimport { build, isEmpty } from '../../src/scope/index.js'\nimport { newRepo, sectionPaths } from './helpers.js'\n\ntest('excludes filter both the diff text and files', async t => {\n    const repo = newRepo()\n    repo.write('keep.go', 'package p\\n')\n    repo.write('skip.go', 'package p\\n')\n    repo.commitAll()\n    repo.write('keep.go', 'package p\\n// changed\\n')\n    repo.write('skip.go', 'package p\\n// changed\\n')\n    repo.git('add', '.')\n    const s = await build(repo.dir, {\n        stagedOnly:true,\n        excludes:['skip.go'],\n        env:repo.env,\n    })\n    t.deepEqual([...s.files], ['keep.go'], 'files')\n    t.ok(!s.diff.includes('skip.go'), 'excluded file not in diff')\n    t.deepEqual(sectionPaths(s.diff), ['keep.go'], 'diff sections')\n    t.ok(s.staged, 'staged flag')\n    t.equal(s.base, '', 'no base in staged mode')\n    repo.cleanup()\n})\n\ntest('untracked synthesis honors paths and excludes', async t => {\n    const repo = newRepo()\n    repo.write('include.go', 'package p\\n')\n    repo.write('exclude.go', 'package p\\n')\n    repo.write('node_modules/dep.js', '// lib\\n')\n    repo.write('other/x.go', 'package x\\n')\n    const s = await build(repo.dir, {\n        excludes:['exclude.go'],\n        env:repo.env,\n    })\n    t.deepEqual([...s.files], ['include.go', 'other/x.go'],\n        'excludes and default ignores applied to untracked')\n    t.ok(s.diff.includes('+package p\\n'), 'synthesized content')\n    const narrowed = await build(repo.dir, {\n        paths:['other'],\n        env:repo.env,\n    })\n    t.deepEqual([...narrowed.files], ['other/x.go'],\n        'a bare directory path selects its subtree')\n    repo.cleanup()\n})\n\ntest('scope unset equals explicit diff', async t => {\n    const repo = newRepo()\n    repo.write('a.go', 'package a\\n')\n    repo.commitAll()\n    repo.write('a.go', 'package a\\n// edit\\n')\n    repo.write('new.go', 'package n\\n')\n    const unset = await build(repo.dir, { env:repo.env })\n    const explicit = await build(repo.dir, { scope:'diff', env:repo.env })\n    t.equal(unset.diff, explicit.diff, 'same diff')\n    t.deepEqual(unset.files, explicit.files, 'same files')\n    t.deepEqual(unset.notes, explicit.notes, 'same notes')\n    t.ok(unset.diffBytes.equals(explicit.diffBytes), 'same bytes')\n    t.deepEqual([...unset.files], ['a.go', 'new.go'], 'files')","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_013mJxQGzfuhg3aM3f2qFUEy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
