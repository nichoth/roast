// A `node:http` fake inference server (Go httptest plus providerServer):
// it records every request and answers from a script that looks at the
// request (path, body, headers) and the request's position.
import {
    createServer,
    type IncomingHttpHeaders,
    type ServerResponse,
} from 'node:http'
import type { AddressInfo } from 'node:net'
import { writeInferenceStream } from './inference-stream.js'

export interface RecordedRequest {
    method:string;
    path:string;
    headers:IncomingHttpHeaders;
    // Header names and values exactly as sent, in order.
    rawHeaders:string[];
    rawBody:Buffer;
    // The parsed JSON body; undefined when it is not JSON.
    body:unknown;
}

export type Reply =
    // A complete response object, streamed in the protocol's SSE format;
    // the protocol defaults to the one the request path implies.
    | { stream:unknown, protocol?:string }
    | { status:number, headers?:Record<string, string>, body?:string|Buffer }
    // Full control: write the response yourself.
    | ((res:ServerResponse, req:RecordedRequest) => void|Promise<void>)

// Picks the reply for the n-th request (0-based).
export type Script = (req:RecordedRequest, n:number) => Reply

export interface InferenceServer {
    // `http://127.0.0.1:<port>`.
    url:string;
    requests:RecordedRequest[];
    close ():Promise<void>;
}

export function protocolForPath (path:string):string {
    if (path.endsWith('/chat/completions')) return 'chat'
    if (path.endsWith('/responses')) return 'responses'
    if (path.endsWith('/v1/messages')) return 'anthropic'
    return ''
}

async function reply (res:ServerResponse, req:RecordedRequest, r:Reply) {
    if (typeof r === 'function') {
        await r(res, req)
        return
    }
    if ('stream' in r) {
        writeInferenceStream(res, r.protocol ?? protocolForPath(req.path),
            r.stream)
        return
    }
    res.writeHead(r.status, r.headers ?? {})
    res.end(r.body ?? '')
}

export async function startInferenceServer (
    script:Script
):Promise<InferenceServer> {
    const requests:RecordedRequest[] = []
    const server = createServer((req, res) => {
        const parts:Buffer[] = []
        req.on('data', (c:Buffer) => parts.push(c))
        req.on('end', () => {
            const rawBody = Buffer.concat(parts)
            let body:unknown
            try {
                body = JSON.parse(rawBody.toString('utf8'))
            } catch {
                body = undefined
            }
            const rec:RecordedRequest = {
                method:req.method ?? '',
                path:req.url ?? '',
                headers:req.headers,
                rawHeaders:req.rawHeaders,
                rawBody,
                body,
            }
            const n = requests.length
            requests.push(rec)
            Promise.resolve()
                .then(() => reply(res, rec, script(rec, n)))
                .catch((err:unknown) => {
                    if (!res.headersSent) res.writeHead(500)
                    res.end(String(err))
                })
        })
    })
    await new Promise<void>(resolve => {
        server.listen(0, '127.0.0.1', resolve)
    })
    const { port } = server.address() as AddressInfo
    return {
        url:`http://127.0.0.1:${port}`,
        requests,
        close () {
            server.closeAllConnections()
            return new Promise<void>(resolve => server.close(() => resolve()))
        },
    }
}
// pattern: Imperative Shell
// Shared provider fake for login and init. Inference replies can be
// supplied by callers when they also exercise a model request.
import {
    startInferenceServer,
    type Script,
} from './inference-server.js'

export async function providerServer (inference?:Script) {
    const credentials:string[] = []
    const hooks = {
        answerModels:(key:string):number => key === '' ? 401 : 200,
    }
    const server = await startInferenceServer((req, n) => {
        const key = String(req.headers['x-api-key'] ??
            req.headers.authorization ?? '')
        credentials.push(key)
        if (req.method === 'GET' && req.path === '/v1/models') {
            if (req.headers['x-api-key'] &&
                req.headers['anthropic-version'] !== '2023-06-01') {
                return { status:400 }
            }
            return { status:hooks.answerModels(key), body:'{}' }
        }
        return inference?.(req, n) ?? { status:404 }
    })
    return { ...server, credentials, hooks }
}
// Bundles the CLI (default), the test entry (--test), the live-test
// entry (--live), or the Go-vs-TS differential harness (--diff) with
// esbuild. Run directly by Node (type stripping), so
// only erasable TypeScript syntax is allowed here.
import { execFileSync } from 'node:child_process'
import { readFileSync } from 'node:fs'
import { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
import { resolve } from 'node:path'
import { build } from 'esbuild'
import type { Metafile } from 'esbuild'
import { ROOT, baseOptions } from './esbuild-options.ts'
import {
    bundledPackageDirs,
    readBundledPackages,
    renderNotices,
} from './licenses.ts'

const SHEBANG = '#!/usr/bin/env node'
// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into
// a runtime "Dynamic require is not supported" error unless a `require`
// is in scope.
const REQUIRE_SHIM = [
    "import { createRequire as __roastRequire } from 'node:module'",
    'const require = __roastRequire(import.meta.url)',
].join('\n')

type Mode = 'cli'|'test'|'live'|'diff'

function parseMode (args:string[]):Mode {
    if (args.length === 0) return 'cli'
    if (args.length === 1 && args[0] === '--test') return 'test'
    if (args.length === 1 && args[0] === '--live') return 'live'
    if (args.length === 1 && args[0] === '--diff') return 'diff'
    throw new Error('usage: node scripts/bundle.ts [--test|--live|--diff], ' +
        `got ${args.join(' ')}`)
}

// Runs git at the repository root; `unknown` when git fails (a build
// from a tarball, no git on PATH).
function git (args:string[]):string {
    try {
        const out = execFileSync('git', args, {
            cwd:ROOT,
            encoding:'utf8',
            stdio:['ignore', 'pipe', 'ignore'],
        }).trim()
        return out || 'unknown'
    } catch {
        return 'unknown'
    }
}

async function packageVersion ():Promise<string> {
    const text = await readFile(new URL('package.json', `file://${ROOT}`),
        'utf8')
    const version = JSON.parse(text).version
    if (typeof version !== 'string') {
        throw new Error('package.json has no string version')
    }
    return version
}

// Writes dist/THIRD_PARTY_LICENSES.txt from the metafile (spec 15, 2.6).
// Throws, naming the package, when a bundled package fails validation.
async function writeThirdPartyNotices (metafile:Metafile):Promise<void> {
    const dirs = bundledPackageDirs(metafile, 'dist/cli.js')
        .map(dir => resolve(ROOT, dir))
    const notices = renderNotices(readBundledPackages(dirs),
        path => readFileSync(path, 'utf8'))
    await writeFile(new URL('dist/THIRD_PARTY_LICENSES.txt',
        `file://${ROOT}`), notices)
}

async function bundleCli ():Promise<void> {
    const dist = new URL('dist/', `file://${ROOT}`)
    await rm(dist, { recursive:true, force:true })
    await mkdir(dist, { recursive:true })

    const version = await packageVersion()
    const commit = git(['rev-parse', '--short=7', 'HEAD'])
    const date = git(['log', '-1', '--format=%cI'])

    const result = await build({
        ...baseOptions(),
        entryPoints:['src/cli.ts'],
        outfile:'dist/cli.js',
        tsconfig:'tsconfig.build.json',
        metafile:true,
        banner:{ js:`${SHEBANG}\n${REQUIRE_SHIM}` },
        define:{
            __ROAST_VERSION__:JSON.stringify(version),
            __ROAST_COMMIT__:JSON.stringify(commit),
            __ROAST_DATE__:JSON.stringify(date),
        },
    })
    const metafile = result.metafile
    if (!metafile) throw new Error('esbuild returned no metafile')
    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))
    await writeThirdPartyNotices(metafile)
    await chmod(new URL('cli.js', dist), 0o755)
}

async function bundleTests (entry:string, outfile:string):Promise<void> {
    await build({
        ...baseOptions(),
        entryPoints:[entry],
        outfile,
        tsconfig:'tsconfig.json',
        banner:{ js:REQUIRE_SHIM },
    })
}

async function main ():Promise<void> {
    const mode = parseMode(process.argv.slice(2))
    if (mode === 'cli') return bundleCli()
    if (mode === 'test') {
        return bundleTests('test/index.ts', 'test/test-bundle.js')
    }
    if (mode === 'diff') {
        return bundleTests('test/diff/index.ts', 'test/diff-bundle.js')
    }
    return bundleTests('test/live/index.ts', 'test/live-bundle.js')
}

try {
    await main()
} catch (err) {
    // esbuild has already printed its own diagnostics for build errors.
    console.error(err instanceof Error ? err.message : err)
    process.exitCode = 1
}
// pattern: Imperative Shell
// Paste login uses only the registry's built-in endpoints and the
// command's shared reader, fetch, environment, and cancellation signal.
import {
    builtinProviders,
    lookupProvider,
    type BuiltinProvider,
} from '../config/provider.js'
import {
    projectCredentialsPath,
    saveCredential,
    userCredentialsPath,
    type CredentialScope,
} from '../credentials/credentials.js'
import { goQuote } from '../gocompat/strings.js'
import { abortable } from '../llm/capture.js'
import { AuthError, EndpointError } from '../llm/errors.js'
import type { CommandDef, RunContext } from './command.js'
import { UsageError } from './errors.js'
import { interactiveTerminals, openBrowser, readSecret } from './terminal.js'

export type LoginContext = Pick<RunContext,
    'cwd'|'env'|'signal'|'fetch'|'stdin'|'stdout'|'stderr'|'lines'>

export interface LoginFlags {
    global:boolean;
    noBrowser:boolean;
}

export interface LoginTarget {
    path:string;
    scope:CredentialScope;
}

export function providerNames ():string {
    return builtinProviders().map(p => p.name).join(', ')
}

export async function loginPath (
    global:boolean,
    ctx:LoginContext
):Promise<LoginTarget> {
    if (global) {
        return { path:userCredentialsPath(ctx.env), scope:'user' }
    }
    try {
        const path = await projectCredentialsPath(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
        return { path, scope:'project' }
    } catch (err) {
        if (ctx.signal.aborted) throw err
        throw new UsageError('not in a Git repository; use --global ' +
            'to store the key for the user', { cause:err })
    }
}

export function keyCheckPath (provider:BuiltinProvider):string {
    return provider.name === 'openrouter' ? '/key' : '/models'
}

class KeyRejected extends Error {}

// Discard at most 32 KiB, then cancel even if the provider keeps sending.
async function drainValidationBody (
    response:Response,
    signal:AbortSignal
):Promise<void> {
    if (!response.body) return
    const reader = response.body.getReader()
    let size = 0
    try {
        while (size < 32 * 1024) {
            const chunk = await abortable(reader.read(), signal)
            if (chunk.done) return
            size += chunk.value.byteLength
        }
    } finally {
        await reader.cancel().catch(() => {})
        reader.releaseLock()
    }
}

export async function validateKey (
    provider:BuiltinProvider,
    key:string,
    ctx:LoginContext
):Promise<void> {
    const url = provider.endpoint.replace(/\/+$/, '') +
        keyCheckPath(provider)
    const signal = AbortSignal.any([
        ctx.signal,
        AbortSignal.timeout(30_000),
    ])
    const prefix = 'llm: inference endpoint failure: check key at ' + url
    let response:Response
    try {
        response = await ctx.fetch(url, {
            method:'GET',
            redirect:'manual',
            signal,
            headers:provider.protocols[0] === 'anthropic' ? {
                'x-api-key':key,
                'anthropic-version':'2023-06-01',
            } : { Authorization:`Bearer ${key}` },
        })
        await drainValidationBody(response, signal)
    } catch (err) {
        const message = err instanceof Error ? err.message : String(err)
        throw new EndpointError(`${prefix}: ${message}`, { cause:err })
    }
    if (response.status >= 300 && response.status < 400) {
        throw new EndpointError(`${prefix}: redirect refused`)
    }
    if (response.status === 401 || response.status === 403) {
        throw new KeyRejected()
    }
    if (!response.ok) {
        throw new EndpointError(`${prefix}: HTTP ${response.status} ` +
            response.statusText)
    }
}

async function pasteLogin (
    provider:BuiltinProvider,
    flags:LoginFlags,
    ctx:LoginContext
):Promise<string> {
    ctx.stderr.write(`Create a ${provider.name} API key at:\n` +
        `  ${provider.keyPage}\n`)
    if (!flags.noBrowser) {
        const err = await openBrowser(provider.keyPage, ctx.signal)
        if (err) {
            ctx.stderr.write(`could not open a browser (${err.message}); ` +
                'open the URL above\n')
        }
    }
    for (let attempt = 0; attempt < 3; attempt++) {
        let key:string
        try {
            key = await readSecret(ctx.stderr, ctx.stdin, ctx.lines,
                'Paste the key: ')
        } catch (err) {
            const message = err instanceof Error ? err.message : String(err)
            throw new Error(`read key: ${message}`, { cause:err })
        }
        if (key === '') {
            ctx.stderr.write('no key entered\n')
            continue
        }
        try {
            await validateKey(provider, key, ctx)
            return key
        } catch (err) {
            if (!(err instanceof KeyRejected)) throw err
            ctx.stderr.write(`${provider.name} rejected the key; ` +
                'try again\n')
        }
    }
    throw new AuthError('llm: authentication failed: no accepted ' +
        `${provider.name} key after 3 tries; nothing stored`)
}

export async function runLogin (
    name:string,
    flags:LoginFlags,
    ctx:LoginContext
):Promise<void> {
    const provider = lookupProvider(name)
    if (!provider) {
        throw new UsageError(`unknown provider ${goQuote(name)}; ` +
            `built-in providers: ${providerNames()}`)
    }
    if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {
        throw new UsageError('login needs an interactive terminal; ' +
            `set ${provider.keyEnv} instead`)
    }
    const target = await loginPath(flags.global, ctx)
    if (provider.login !== 'paste') {
        throw new Error(`login to ${provider.name} is not supported; ` +
            `set ${provider.keyEnv}`)
    }
    const key = await pasteLogin(provider, flags, ctx)
    await saveCredential(target.path, provider.name, key, new Date())
    ctx.stdout.write(`stored ${provider.name} credential ` +
        `(${target.scope} scope)\n`)
}

export const loginCommand:CommandDef = {
    command:'login <provider>',
    describe:'Store an API key for a built-in provider',
    builder:y => y
        .positional('provider', { type:'string' })
        .option('global', {
            type:'boolean',
            default:false,
            describe:'Store the credential for the user',
        })
        .option('no-browser', {
            type:'boolean',
            default:false,
            describe:'Print the key page URL without opening a browser',
        }),
    handler:(args, ctx) => runLogin(String(args.provider), {
        global:args.global === true,
        noBrowser:args['no-browser'] === true,
    }, ctx),
}

