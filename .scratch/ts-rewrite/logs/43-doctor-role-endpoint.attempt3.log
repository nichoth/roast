// Temporary directories and Git repositories for CLI tests, with an
// environment that isolates the user's home and config directories and
// gives Git an identity (CI runners have none).
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { cleanEnv } from './env.js'

export interface TempDir {
    dir:string;
    env:Record<string, string>;
    remove ():void;
}

function makeTemp (prefix:string):string {
    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))
}

// The base test environment: the process env without provider or roast
// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside
// `root`, a Git identity, and no Git discovery above `root`.
export function isolatedEnv (root:string):Record<string, string> {
    const home = path.join(root, '.home')
    fs.mkdirSync(home, { recursive:true })
    return {
        ...cleanEnv(process.env),
        HOME:home,
        XDG_CONFIG_HOME:path.join(home, '.config'),
        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),
        GIT_AUTHOR_NAME:'Roast Test',
        GIT_AUTHOR_EMAIL:'roast-test@example.com',
        GIT_COMMITTER_NAME:'Roast Test',
        GIT_COMMITTER_EMAIL:'roast-test@example.com',
        GIT_CEILING_DIRECTORIES:path.dirname(root),
        GIT_CONFIG_NOSYSTEM:'1',
    }
}

// A temporary directory that is not inside any Git repository. The test
// working directory is `dir/work`.
export function tempDir (prefix = 'roast-dir-'):TempDir {
    const root = makeTemp(prefix)
    const dir = path.join(root, 'work')
    fs.mkdirSync(dir)
    return {
        dir,
        env:isolatedEnv(root),
        remove:() => fs.rmSync(root, { recursive:true, force:true }),
    }
}

// A temporary Git repository at `dir` (realpath, so it compares equal to
// what Git prints).
export function tempRepo (prefix = 'roast-repo-'):TempDir {
    const t = tempDir(prefix)
    execFileSync('git', ['init', '-q', t.dir], { env:t.env })
    return t
}
// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse
// order when the test body finishes, pass or fail.
import { test as tapTest, type Test } from '@substrate-system/tapzero'

export type CleanupTest = Test&{
    cleanup (fn:() => void|Promise<void>):void;
}

export function test (
    name:string,
    fn:(t:CleanupTest) => void|Promise<void>
):void {
    tapTest(name, async t => {
        const cleanups:(() => void|Promise<void>)[] = []
        const ct = Object.assign(t, {
            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },
        })
        try {
            await fn(ct)
        } finally {
            for (const f of cleanups.reverse()) await f()
        }
    })
}
// Response body ownership and raw-response capture (spec 06, 2.11): a
// size cap, the Content-Length check, streaming capture that never reads
// ahead of the parser, and the client's sticky failure gate.

import { CaptureError } from './errors.js'
import type { Protocol, RawResponse } from './types.js'

export const MAX_CAPTURED_RESPONSE_SIZE = 16 << 20

// A client's capture state: after the first failure every later request
// fails with the same error without contacting the server.
export class CaptureGate {
    failure?:CaptureError
}

export interface CaptureOptions {
    role:string;
    protocol:Protocol;
    model:string;
    captureResponse?:(raw:RawResponse) => Promise<void>|void;
    // Overrides MAX_CAPTURED_RESPONSE_SIZE (tests).
    limit?:number;
}

export interface CapturedBody {
    // Body chunks, read only as the consumer pulls them.
    chunks:AsyncIterable<Uint8Array>;
    // Idempotent: cancels the body if it is not at EOF, then hands the
    // bytes read to the capture callback. Throws a CaptureError.
    release ():Promise<void>;
}

function latch (
    gate:CaptureGate,
    role:string,
    detail:string,
    cause?:unknown
):CaptureError {
    const err = new CaptureError(
        `capture ${role} provider response: ${detail}`, { cause })
    gate.failure ??= err
    return err
}

function mediaType (contentType:string|null):string {
    return (contentType ?? '').split(';')[0].trim().toLowerCase()
}

function concat (parts:Uint8Array[], size:number):Uint8Array {
    const out = new Uint8Array(size)
    let off = 0
    for (const p of parts) {
        out.set(p, off)
        off += p.length
    }
    return out
}

// `p`, or the signal's reason as soon as it aborts.
export function abortable<T> (p:Promise<T>, signal?:AbortSignal):Promise<T> {
    if (!signal) return p
    if (signal.aborted) return Promise.reject(signal.reason)
    return new Promise<T>((resolve, reject) => {
        const onAbort = () => reject(signal.reason)
        signal.addEventListener('abort', onAbort, { once:true })
        p.then(v => {
            signal.removeEventListener('abort', onAbort)
            resolve(v)
        }, (e:unknown) => {
            signal.removeEventListener('abort', onAbort)
            reject(e)
        })
    })
}

async function runCallback (
    opts:CaptureOptions,
    gate:CaptureGate,
    contentType:RawResponse['contentType'],
    body:Uint8Array
):Promise<void> {
    if (!opts.captureResponse) return
    try {
        await opts.captureResponse({
            role:opts.role,
            protocol:opts.protocol,
            model:opts.model,
            contentType,
            body,
        })
    } catch (err) {
        const msg = err instanceof Error ? err.message : String(err)
        throw latch(gate, opts.role, msg, err)
    }
}

// Opens a 2xx response body for the SSE parser.
export async function openCapturedBody (
    response:Response,
    opts:CaptureOptions,
    gate:CaptureGate,
    signal?:AbortSignal
):Promise<CapturedBody> {
    const limit = opts.limit ?? MAX_CAPTURED_RESPONSE_SIZE
    const reader = response.body?.getReader()
    let done = !reader
    let released = false

    async function cancel ():Promise<void> {
        if (done || !reader) return
        done = true
        await reader.cancel().catch(() => {})
    }

    // The next chunk, or null at EOF.
    async function read ():Promise<Uint8Array|null> {
        if (!reader) return null
        const r = await abortable(reader.read(), signal)
        return r.done ? null : r.value
    }

    const capturing = opts.captureResponse !== undefined
    const length = Number(response.headers.get('content-length') ?? '')
    if (capturing && Number.isFinite(length) && length > limit) {
        await cancel()
        throw latch(gate, opts.role,
            `body exceeds ${limit}-byte limit`)
    }

    const sse = mediaType(response.headers.get('content-type')) ===
        'text/event-stream'
    if (capturing && !sse) {
        const parts:Uint8Array[] = []
        let size = 0
        while (!done) {
            const value = await read()
            if (value === null) {
                done = true
                break
            }
            size += value.length
            if (size > limit) {
                await cancel()
                throw latch(gate, opts.role,
                    `body exceeds ${limit}-byte limit`)
            }
            parts.push(value)
        }
        const body = concat(parts, size)
        try {
            JSON.parse(new TextDecoder().decode(body))
        } catch {
            throw latch(gate, opts.role,
                `${opts.model} returned invalid raw JSON`)
        }
        await runCallback(opts, gate, 'application/json', body)
        async function * once () { yield body }
        return { chunks:once(), release:async () => {} }
    }

    const parts:Uint8Array[] = []
    let size = 0
    let overflowed = false

    async function * chunks ():AsyncGenerator<Uint8Array> {
        while (!done) {
            const value = await read()
            if (value === null) {
                done = true
                return
            }
            if (capturing) {
                if (size + value.length > limit) {
                    overflowed = true
                    await cancel()
                    throw latch(gate, opts.role,
                        `body exceeds ${limit}-byte limit`)
                }
                parts.push(value)
                size += value.length
            }
            yield value
        }
    }

    return {
        chunks:chunks(),
        async release ():Promise<void> {
            if (released) return
            released = true
            await cancel()
            if (!capturing || overflowed) return
            await runCallback(opts, gate, 'text/event-stream',
                concat(parts, size))
        },
    }
}

