// Role resolution, the finder flip, and role validation (spec 02, 2.5,
// 2.10, 2.11).
import { goTrimSpace } from '../gocompat/strings.js'
import {
    type Env,
    resolveCredential,
    roleKeyVar,
} from './credential.js'
import { endpointProblem } from './endpoint.js'
import { inferFamily } from './family.js'
import { ConfigError, type ProjectConfig } from './load.js'
import { defaultBaseURL, providerAt } from './provider.js'
import {
    type ResolvedRole,
    makeRole,
    updateRole,
} from './resolved-role.js'

export { type ResolvedRole, updateRole }

export type RoleName = 'finder'|'verifier'

interface Selection {
    pin?:boolean;
    author_routes?:Record<string, string>;
}

function resolveProfile (
    cfg:ProjectConfig,
    roleName:string,
    profileName:string,
    selection:Selection,
    env:Env
):ResolvedRole {
    if (!Object.hasOwn(cfg.inference_profiles, profileName)) {
        throw new ConfigError(`role ${roleName} references unknown ` +
            `inference profile ${JSON.stringify(profileName)}`)
    }
    const p = cfg.inference_profiles[profileName]
    const routes = Object.freeze(Object.assign(Object.create(null),
        selection.author_routes ?? {})) as Record<string, string>
    const located = {
        baseURL:p.endpoint || defaultBaseURL(p.protocol),
        protocol:p.protocol,
        stored:cfg.stored,
    }
    const { key, source } = resolveCredential(roleName, p.api_key_env ?? '',
        located, env)
    return makeRole({
        ...located,
        profile:profileName,
        explicitEndpoint:Boolean(p.endpoint),
        apiKey:key,
        model:p.model ?? '',
        maxOutputTokens:p.max_output_tokens,
        sessionHeader:p.session_header ?? '',
        pin:selection.pin ?? false,
        authorRoutes:routes,
        credential:Object.freeze(source),
    })
}

// Expands a configured role into its profile settings and credential.
// Only the credential comes from outside the config.
export function resolveRole (
    cfg:ProjectConfig,
    name:RoleName,
    env:Env
):ResolvedRole {
    const selection = cfg.roles[name]
    if (!selection?.profile) {
        throw new ConfigError(`role ${JSON.stringify(name)} is not configured`)
    }
    return resolveProfile(cfg, name, selection.profile, selection, env)
}

export interface FlipResult {
    role:ResolvedRole;
    note?:string;
    warn?:string;
}

function routeTarget (
    routes:Readonly<Record<string, string>>,
    key:string
):string {
    return (key !== '' && Object.hasOwn(routes, key)) ? routes[key] : ''
}

// Keeps finder generation independent of the author: when the finder has
// a route for the author's model or family, use that profile, unless it
// is no more independent than the finder.
export function resolveFinderFlip (
    cfg:ProjectConfig,
    finder:ResolvedRole,
    authorModel:string,
    env:Env
):FlipResult {
    const authorKey = goTrimSpace(authorModel).toLowerCase()
    if (authorKey === '') return { role:finder }
    const authorFamily = inferFamily(authorModel)
    const finderFamily = inferFamily(finder.model)
    if (finder.pin) {
        if (authorFamily !== '' && finderFamily === authorFamily) {
            return {
                role:finder,
                warn:`author-model ${authorModel} shares the finder family ` +
                    `${authorFamily}, but the finder is pinned; generation ` +
                    'independence is reduced',
            }
        }
        return { role:finder }
    }
    const target = routeTarget(finder.authorRoutes, authorKey) ||
        routeTarget(finder.authorRoutes, authorFamily)
    if (target === '') {
        if (authorFamily === '') {
            return {
                role:finder,
                warn:'could not determine a model family for author-model ' +
                    `${JSON.stringify(authorModel)} and no exact author ` +
                    `route is configured; keeping finder ${finder.model}`,
            }
        }
        if (finderFamily === authorFamily) {
            return {
                role:finder,
                warn:`author-model ${authorModel} shares the finder family ` +
                    `${authorFamily} and no author route is configured; ` +
                    'generation independence is reduced',
            }
        }
        return { role:finder }
    }
    const resolved = resolveProfile(cfg, 'finder', target, {}, env)
    const targetFamily = inferFamily(resolved.model)
    if ((authorFamily !== '' &&
        (targetFamily === '' || targetFamily === authorFamily)) ||
        resolved.model.toLowerCase() === authorModel.toLowerCase()) {
        return {
            role:finder,
            warn:`author-model ${authorModel} shares the finder family ` +
                `${authorFamily} and profile ${JSON.stringify(target)} uses ` +
                `non-independent model ${JSON.stringify(resolved.model)}; ` +
                `keeping finder ${finder.model}`,
        }
    }
    const note = authorFamily === '' ?
        `author-model ${authorModel} matched an exact route; using finder ` +
            `profile ${target} (${resolved.model})` :
        `author-model ${authorModel} maps to family ${authorFamily}; using ` +
            `finder profile ${target} (${resolved.model})`
    return { role:resolved, note }
}

// A starter placeholder such as `<finder-model>`.
export function isPlaceholderModel (model:string):boolean {
    const m = goTrimSpace(model)
    return m.length > 2 && m.startsWith('<') && m.endsWith('>')
}

// The endpoint rule (spec 02, 2.4) for a resolved role or flag value.
export function validateEndpoint (
    field:string,
    baseURL:string,
    protocol:string,
    maxOutputTokens:number
):void {
    const problem = endpointProblem(field, baseURL, protocol,
        maxOutputTokens)
    if (problem) throw new ConfigError(problem)
}

function missingKey (name:string, role:ResolvedRole):string {
    const roleVar = roleKeyVar(name)
    const provider = providerAt(role.baseURL, role.protocol)
    const { kind, env, withheld } = role.credential
    const profileVar = `${env}, named by inference_profiles.` +
        `${role.profile}.api_key_env`
    const prefix = `${name} API key is not configured`
    if (provider && kind === 'profile_env') {
        return `${prefix} (run \`npx roast login ${provider.name}\`, or ` +
            `set ${profileVar}, or ${roleVar})`
    }
    if (provider) {
        return `${prefix} (run \`npx roast login ${provider.name}\`, or ` +
            `set ${provider.keyEnv} or ${roleVar})`
    }
    if (kind === 'profile_env') {
        return `${prefix} (set ${profileVar}, or ${roleVar})`
    }
    if (withheld) {
        return `${prefix}: ${withheld} is not sent to ${role.baseURL} ` +
            "because it is not that provider's default endpoint (set " +
            `inference_profiles.${role.profile}.api_key_env or ${roleVar})`
    }
    return `${prefix} (set inference_profiles.${role.profile}.api_key_env ` +
        `or ${roleVar})`
}

// Checks a fully resolved role before any model call; first failure wins.
export function validateRole (name:string, role:ResolvedRole):void {
    if (goTrimSpace(role.model) === '') {
        throw new ConfigError(`${name} model is not configured (set ` +
            `inference_profiles.${role.profile}.model or --${name}-model)`)
    }
    if (isPlaceholderModel(role.model)) {
        throw new ConfigError(`${name} model ${role.model} is a ` +
            `placeholder: set inference_profiles.${role.profile}.model in ` +
            `the project config to a model ID, or pass --${name}-model`)
    }
    if (goTrimSpace(role.apiKey) === '') {
        throw new ConfigError(missingKey(name, role))
    }
    validateEndpoint(name, role.baseURL, role.protocol, role.maxOutputTokens)
}
// Credential resolution and endpoint overrides (spec 02, 2.6 and 2.9).
// `env` is always passed in; nothing here reads process.env. A key never
// appears in a CredentialSource or an error message.
import { ConfigError } from './load.js'
import {
    builtinProviders,
    defaultBaseURL,
    providerAt,
    sameEndpoint,
} from './provider.js'
import { type ResolvedRole, updateRole } from './resolved-role.js'

export type Env = Readonly<Record<string, string|undefined>>

// The stored-credential store a loaded config carries (filled by the
// credentials area; config never imports it).
export interface StoredCredentials {
    // null or a '' key when none is stored. Throws when a credentials file
    // cannot be used; it never skips a bad file.
    lookup (provider:string):{
        key:string,
        scope:'project'|'user'|'',
    }|null;
}

export type CredentialKind =
    'role_env'|'profile_env'|'provider_env'|'stored'|'none'

export interface CredentialSource {
    readonly kind:CredentialKind;
    // The variable read, for env kinds.
    readonly env?:string;
    // stored: provider name and scope ('project' or 'user').
    readonly provider?:string;
    readonly scope?:string;
    // none: a set provider key that was not sent.
    readonly withheld?:string;
}

export interface Credential {
    key:string;
    source:CredentialSource;
}

// A variable counts only when it is set to a non-empty string.
export function envValue (env:Env, name:string):string {
    if (name === '' || !Object.hasOwn(env, name)) return ''
    const v = env[name]
    return typeof v === 'string' ? v : ''
}

export function roleKeyVar (role:string):string {
    return `ROAST_${role.toUpperCase()}_API_KEY`
}

// Where a credential came from, never the credential itself.
export function describeSource (s:CredentialSource):string {
    switch (s.kind) {
        case 'role_env': return `${s.env} (role override)`
        case 'profile_env': return `${s.env} (profile api_key_env)`
        case 'provider_env': return `${s.env} (ambient provider key)`
        case 'stored':
            return `stored ${s.scope} credential for ${s.provider}`
        default:
            return s.withheld ?
                `none; ${s.withheld} is set but is sent only to its ` +
                    "provider's default endpoint" :
                'none'
    }
}

function wrap (roleName:string, err:unknown):ConfigError {
    const cause = err instanceof Error ? err.message : String(err)
    return new ConfigError(`role ${roleName}: ${cause}`, { cause:err })
}

// A set standard key variable of a built-in provider, preferring the
// provider at the protocol's default endpoint, or ''. Called only after no
// key was sent, so any variable it names was withheld.
function withheldKey (protocol:string, env:Env):string {
    const providers = builtinProviders()
    const preferred = providers.find(p =>
        sameEndpoint(p.endpoint, defaultBaseURL(protocol)))
    const candidates = [
        ...(preferred ? [preferred.keyEnv] : []),
        ...providers.map(p => p.keyEnv),
    ]
    return candidates.find(name => envValue(env, name) !== '') ?? ''
}

// The stored key of the built-in provider at endpoint and protocol. The
// registry alone decides the provider, so a custom endpoint never
// receives a stored key.
function storedCredential (
    stored:StoredCredentials|undefined,
    protocol:string,
    endpoint:string
):Credential|null {
    const provider = providerAt(endpoint, protocol)
    if (!provider || !stored) return null
    const found = stored.lookup(provider.name)
    if (!found || found.key === '') return null
    return {
        key:found.key,
        source:{ kind:'stored', provider:provider.name, scope:found.scope },
    }
}

// A built-in provider's standard key, else its stored key, only when the
// role is on that provider's endpoint with a protocol it accepts there.
// Throws when the store is reached and unusable.
export function ambientCredential (
    protocol:string,
    endpoint:string,
    stored:StoredCredentials|undefined,
    env:Env
):Credential {
    const provider = providerAt(endpoint, protocol)
    if (provider) {
        const key = envValue(env, provider.keyEnv)
        if (key !== '') {
            return { key, source:{ kind:'provider_env', env:provider.keyEnv } }
        }
        const fromStore = storedCredential(stored, protocol, endpoint)
        if (fromStore) return fromStore
    }
    const withheld = withheldKey(protocol, env)
    return { key:'', source:{ kind:'none', withheld } }
}

// The credential of a freshly resolved role: the role variable, the
// profile's variable, then the ambient provider key or stored key.
export function resolveCredential (
    roleName:string,
    apiKeyEnv:string,
    role:Pick<ResolvedRole, 'protocol'|'baseURL'|'stored'>,
    env:Env
):Credential {
    const roleVar = roleKeyVar(roleName)
    const roleKey = envValue(env, roleVar)
    if (roleKey !== '') {
        return { key:roleKey, source:{ kind:'role_env', env:roleVar } }
    }
    try {
        if (apiKeyEnv !== '') {
            const source:CredentialSource = {
                kind:'profile_env',
                env:apiKeyEnv,
            }
            const key = envValue(env, apiKeyEnv)
            if (key !== '') return { key, source }
            // An unset profile variable on a built-in endpoint falls back
            // to the provider's variable, then its stored key, as
            // rebindCredential does after an override.
            const ambient = ambientCredential(role.protocol, role.baseURL,
                role.stored, env)
            return ambient.key === '' ? { key:'', source } : ambient
        }
        return ambientCredential(role.protocol, role.baseURL, role.stored,
            env)
    } catch (err) {
        throw wrap(roleName, err)
    }
}

interface Overrides {
    baseURL?:string;
    protocol?:string;
}

// Applies the protocol, then the endpoint override. Returns the moved
// role and whether the protocol override moved it from one provider's
// default endpoint to another's.
function applyEndpointOverrides (
    role:ResolvedRole,
    { baseURL, protocol }:Overrides
):{ role:ResolvedRole, crossed:boolean } {
    let crossed = false
    let next = role
    if (protocol !== undefined) {
        const previousDefault = defaultBaseURL(role.protocol)
        const nextDefault = defaultBaseURL(protocol)
        next = updateRole(next, { protocol })
        if (nextDefault !== previousDefault &&
            (!role.explicitEndpoint ||
                sameEndpoint(role.baseURL, previousDefault))) {
            next = updateRole(next, { baseURL:nextDefault })
            crossed = true
        }
    }
    if (baseURL !== undefined) {
        next = updateRole(next, { baseURL, explicitEndpoint:true })
        crossed = false
    }
    return { role:next, crossed }
}

// Re-resolves a credential after the endpoint or protocol changed. A role
// key, or a profile key on an endpoint that did not cross providers,
// follows the override; any other key is checked again.
function rebindCredential (
    roleName:string,
    role:ResolvedRole,
    crossed:boolean,
    env:Env
):ResolvedRole {
    const kind = role.credential.kind
    if (kind === 'role_env') return role
    if (kind === 'profile_env' && !crossed) return role
    const roleVar = roleKeyVar(roleName)
    const roleKey = envValue(env, roleVar)
    if (roleKey !== '') {
        return updateRole(role, {
            apiKey:roleKey,
            credential:{ kind:'role_env', env:roleVar },
        })
    }
    let found:Credential
    try {
        found = ambientCredential(role.protocol, role.baseURL, role.stored,
            env)
    } catch (err) {
        throw wrap(roleName, err)
    }
    return updateRole(role, { apiKey:found.key, credential:found.source })
}

// Applies `--<role>-base-url` / `--<role>-protocol` (undefined = flag not
// given) and re-binds the credential through the same path as initial
// resolution. Throws only when a needed stored credential is unusable.
export function overrideEndpoint (
    roleName:string,
    role:ResolvedRole,
    overrides:Overrides,
    env:Env
):ResolvedRole {
    const moved = applyEndpointOverrides(role, overrides)
    return rebindCredential(roleName, moved.role, moved.crossed, env)
}

// Exposed for the override matrix tests only.
export const internal = { applyEndpointOverrides, rebindCredential }
// The built-in provider registry (spec 02, 2.7): the one place that says
// which endpoint, protocols, standard key variable, key page, and login
// method each provider has. Trust standardness, ambient credentials, the
// `init` starter, and login all consult it.
import { goTrimSpace } from '../gocompat/strings.js'

export const DEFAULT_OPENAI_BASE_URL = 'https://api.openai.com/v1'
export const DEFAULT_ANTHROPIC_BASE_URL = 'https://api.anthropic.com/v1'
export const OPENROUTER_BASE_URL = 'https://openrouter.ai/api/v1'

export type Protocol = 'chat'|'responses'|'anthropic'
export type LoginMethod = 'paste'|'browser'

export interface BuiltinProvider {
    readonly name:string;
    readonly endpoint:string;
    // The first is the one starter profiles use.
    readonly protocols:readonly Protocol[];
    readonly keyEnv:string;
    readonly keyPage:string;
    readonly login:LoginMethod;
}

// No two entries share an (endpoint, protocol) pair, so providerAt finds
// at most one. Order matters for withheldKey and listings.
const REGISTRY:readonly BuiltinProvider[] = Object.freeze([
    {
        name:'openai',
        endpoint:DEFAULT_OPENAI_BASE_URL,
        protocols:['responses', 'chat'],
        keyEnv:'OPENAI_API_KEY',
        keyPage:'https://platform.openai.com/api-keys',
        login:'paste',
    },
    {
        name:'anthropic',
        endpoint:DEFAULT_ANTHROPIC_BASE_URL,
        protocols:['anthropic'],
        keyEnv:'ANTHROPIC_API_KEY',
        keyPage:'https://console.anthropic.com/settings/keys',
        login:'paste',
    },
    {
        name:'openrouter',
        endpoint:OPENROUTER_BASE_URL,
        protocols:['chat', 'responses'],
        keyEnv:'OPENROUTER_API_KEY',
        keyPage:'https://openrouter.ai/settings/keys',
        login:'browser',
    },
].map(p => Object.freeze({
    ...p,
    protocols:Object.freeze([...p.protocols]) as readonly Protocol[],
} as BuiltinProvider)))

function copy (p:BuiltinProvider):BuiltinProvider {
    return { ...p, protocols:[...p.protocols] }
}

// Copies of the registry, in registry order.
export function builtinProviders ():BuiltinProvider[] {
    return REGISTRY.map(copy)
}

// The provider with exactly this name (case-sensitive).
export function lookupProvider (name:string):BuiltinProvider|undefined {
    const p = REGISTRY.find(p => p.name === name)
    return p && copy(p)
}

// The provider that accepts `protocol` at `endpoint`.
export function providerAt (
    endpoint:string,
    protocol:string
):BuiltinProvider|undefined {
    const p = REGISTRY.find(p =>
        (p.protocols as readonly string[]).includes(protocol) &&
        sameEndpoint(p.endpoint, endpoint))
    return p && copy(p)
}

// The implicit endpoint of a profile that sets none. OpenRouter is never
// one.
export function defaultBaseURL (protocol:string):string {
    return protocol === 'anthropic' ?
        DEFAULT_ANTHROPIC_BASE_URL :
        DEFAULT_OPENAI_BASE_URL
}

// Parses an endpoint with WHATWG URL, or null when it does not parse or
// has an empty host. WHATWG repairs `https:///v1` and `https:v1` into a
// host; Go sees an empty one, so text after the scheme must start with
// `//` and a non-empty authority.
export function parseEndpoint (s:string):URL|null {
    const colon = s.indexOf(':')
    if (colon < 0) return null
    const rest = s.slice(colon + 1)
    if (!rest.startsWith('//')) return null
    const end = rest.slice(2).search(/[/?#]/)
    const authority = end < 0 ? rest.slice(2) : rest.slice(2, 2 + end)
    // Userinfo alone (`https://u@/v1`) leaves no host either.
    if (authority.slice(authority.lastIndexOf('@') + 1) === '') return null
    let u:URL
    try {
        u = new URL(s)
    } catch {
        return null
    }
    return u.host === '' ? null : u
}

function stripTrailingSlashes (p:string):string {
    let end = p.length
    while (end > 0 && p[end - 1] === '/') end--
    return p.slice(0, end)
}

// Endpoints compare by scheme and host (case-insensitive), path without
// trailing slashes, raw query, and userinfo. Unparseable values never
// match.
export function sameEndpoint (a:string, b:string):boolean {
    const left = parseEndpoint(goTrimSpace(a))
    const right = parseEndpoint(goTrimSpace(b))
    if (!left || !right) return false
    return left.protocol === right.protocol &&
        left.host === right.host &&
        stripTrailingSlashes(left.pathname) ===
            stripTrailingSlashes(right.pathname) &&
        left.search === right.search &&
        left.username === right.username &&
        left.password === right.password
}
