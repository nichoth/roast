  //   "request_timeout": "10m",
  //   "max_total_tokens": 3000000,
  //   "max_diff_bytes": 1000000,
  //   "max_prompt_bytes": 8000000,
  //   "max_file_ctx_bytes": 400000,
  //   "max_attempts": 4,
  //   "max_verified": 25
  // },

  // The pre-commit gate.
  // "gate": {
  //   "timeout_seconds": 180,
  //   "severity": "HIGH",
