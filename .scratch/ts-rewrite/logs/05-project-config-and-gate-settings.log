{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAycQP1vVEcTDttqQPjv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016U9oJMCVXLHnQaxU5HpidZ","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-05-project-config-and-gate-settings/src/config/json-schema.ts","content":"// Renders roast.schema.json, the editor schema for .roast.json, from the\n// zod schema (spec 02, \"Schema generation\"; spec 15, 2.7).\nimport { z } from 'zod'\nimport { ConfigSchema } from './schema.js'\n\ntype JsonSchema = Record<string, unknown>\n\nconst SAFE_INT_BOUNDS = new Set([\n    Number.MAX_SAFE_INTEGER,\n    Number.MIN_SAFE_INTEGER,\n])\n\nfunction isObject (v:unknown):v is JsonSchema {\n    return typeof v === 'object' && v !== null && !Array.isArray(v)\n}\n\n// Rewrites zod's draft-7 output into the editor schema's plain form:\n// - `{description, allOf:[{$ref}]}` (zod's way to describe a reference)\n//   becomes `{$ref, description}`, the form editors and the Go drift\n//   test read;\n// - z.int()'s implicit safe-integer bounds and z.record()'s\n//   `propertyNames: {type: string}` are dropped (they say nothing);\n// - the literal `version` is an integer, not a number.\nfunction tidy (node:unknown):unknown {\n    if (Array.isArray(node)) return node.map(tidy)\n    if (!isObject(node)) return node\n    const out:JsonSchema = {}\n    for (const [key, value] of Object.entries(node)) {\n        if (key === 'propertyNames') continue\n        if ((key === 'minimum' || key === 'maximum') &&\n            SAFE_INT_BOUNDS.has(value as number)) continue\n        out[key] = tidy(value)\n    }\n    const allOf = out.allOf\n    if (Array.isArray(allOf) && allOf.length === 1 && isObject(allOf[0]) &&\n        typeof allOf[0].$ref === 'string') {\n        delete out.allOf\n        out.$ref = allOf[0].$ref\n    }\n    if (out.type === 'number' && typeof out.const === 'number' &&\n        Number.isInteger(out.const)) {\n        out.type = 'integer'\n    }\n    return out\n}\n\nexport function projectSchema ():JsonSchema {\n    const generated = z.toJSONSchema(ConfigSchema, {\n        target:'draft-7',\n        io:'input',\n    }) as JsonSchema\n    const { $schema, ...rest } = tidy(generated) as JsonSchema\n    return {\n        $schema,\n        $id:'https://github.com/nichoth/roast/roast.schema.json',\n        title:'Roast project config (.roast.json)',\n        description:'Every non-secret Roast setting. Credentials come ' +\n            'only from environment variables; a profile names its ' +\n            'variable with api_key_env.',\n        ...rest,\n    }\n}\n\n// The full text of roast.schema.json.\nexport function renderProjectSchema ():string {\n    return JSON.stringify(projectSchema(), null, 2) + '\\n'\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1539,"cache_read_input_tokens":156118,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1539},"output_tokens":36,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2c04a591-2f82-49dd-a2ef-471292a90a1e","uuid":"d7d7e52a-0975-4b2d-9ec3-9f815fe7b149","timestamp":"2026-11-18T19:52:12.523Z","request_id":"req_011ChAycQ7u2wqbCZM3gZGuq","wire_tool_inputs":{"toolu_016U9oJMCVXLHnQaxU5HpidZ":{"file_path":"/Users/nick/code/roast.ts-rewrite-05-project-config-and-gate-settings/src/config/json-schema.ts","content":"// Renders roast.schema.json, the editor schema for .roast.json, from the\n// zod schema (spec 02, \"Schema generation\"; spec 15, 2.7).\nimport { z } from 'zod'\nimport { ConfigSchema } from './schema.js'\n\ntype JsonSchema = Record<string, unknown>\n\nconst SAFE_INT_BOUNDS = new Set([\n    Number.MAX_SAFE_INTEGER,\n    Number.MIN_SAFE_INTEGER,\n])\n\nfunction isObject (v:unknown):v is JsonSchema {\n    return typeof v === 'object' && v !== null && !Array.isArray(v)\n}\n\n// Rewrites zod's draft-7 output into the editor schema's plain form:\n// - `{description, allOf:[{$ref}]}` (zod's way to describe a reference)\n//   becomes `{$ref, description}`, the form editors and the Go drift\n//   test read;\n// - z.int()'s implicit safe-integer bounds and z.record()'s\n//   `propertyNames: {type: string}` are dropped (they say nothing);\n// - the literal `version` is an integer, not a number.\nfunction tidy (node:unknown):unknown {\n    if (Array.isArray(node)) return node.map(tidy)\n    if (!isObject(node)) return node\n    const out:JsonSchema = {}\n    for (const [key, value] of Object.entries(node)) {\n        if (key === 'propertyNames') continue\n        if ((key === 'minimum' || key === 'maximum') &&\n            SAFE_INT_BOUNDS.has(value as number)) continue\n        out[key] = tidy(value)\n    }\n    const allOf = out.allOf\n    if (Array.isArray(allOf) && allOf.length === 1 && isObject(allOf[0]) &&\n        typeof allOf[0].$ref === 'string') {\n        delete out.allOf\n        out.$ref = allOf[0].$ref\n    }\n    if (out.type === 'number' && typeof out.const === 'number' &&\n        Number.isInteger(out.const)) {\n        out.type = 'integer'\n    }\n    return out\n}\n\nexport function projectSchema ():JsonSchema {\n    const generated = z.toJSONSchema(ConfigSchema, {\n        target:'draft-7',\n        io:'input',\n    }) as JsonSchema\n    const { $schema, ...rest } = tidy(generated) as JsonSchema\n    return {\n        $schema,\n        $id:'https://github.com/nichoth/roast/roast.schema.json',\n        title:'Roast project config (.roast.json)',\n        description:'Every non-secret Roast setting. Credentials come ' +\n            'only from environment variables; a profile names its ' +\n            'variable with api_key_env.',\n        ...rest,\n    }\n}\n\n// The full text of roast.schema.json.\nexport function renderProjectSchema ():string {\n    return JSON.stringify(projectSchema(), null, 2) + '\\n'\n}\n"}}}
