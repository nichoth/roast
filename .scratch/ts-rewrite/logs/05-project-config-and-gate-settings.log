nimum\": 0,\n          \"maximum\": 1,\n          \"description\": \"Minimum confidence for a --quick review. Default 0.8.\"\n        },\n        \"excludes\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" },\n          \"description\": \"Path patterns left out of every review.\"\n        },\n        \"snapshot\": {\n          \"type\": \"boolean\",\n          \"description\": \"Record a Git snapshot of each review for replay. Default true.\"\n        }\n      }\n    },\n    \"prompts\": {\n      \"type\": \"object\",\n      \"description\": \"Project files that replace the embedded prompt templates. A relative path is relative to the directory holding this config file. Setting any of these requires `npx roast trust` approval.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"finder_code\": {\n          \"type\": \"string\",\n          \"description\": \"Finder prompt for code changes.\"\n        },\n        \"finder_prose\": {\n          \"type\": \"string\",\n          \"description\": \"Finder prompt for prose changes.\"\n        },\n        \"verifier\": {\n          \"type\": \"string\",\n          \"description\": \"Verifier prompt.\"\n        }\n      }\n    },\n    \"limits\": {\n      \"type\": \"object\",\n      \"description\": \"Per-review limits. An unset limit uses the built-in default.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"deadline\": {\n          \"$ref\": \"#/definitions/duration\",\n          \"description\": \"Wall-clock limit for one review. Default \\\"10m\\\"; \\\"0s\\\" disables.\"\n        },\n        \"request_timeout\": {\n          \"$ref\": \"#/definitions/duration\",\n          \"description\": \"Limit for one model request. Default \\\"10m\\\".\"\n        },\n        \"max_total_tokens\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"Token budget for one review. Default 3000000; 0 disables