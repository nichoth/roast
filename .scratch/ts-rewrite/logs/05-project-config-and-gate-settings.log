here := path\n\t\tif where == \"\" {\n\t\t\twhere = \"(root)\"\n\t\t}\n\t\t*problems = append(*problems, strings.ReplaceAll(format, \"%s\",\n\t\t\twhere))\n\t}\n\tfor typ.Kind() == reflect.Pointer {\n\t\ttyp = typ.Elem()\n\t}\n\tif node.Ref != \"\" {\n\t\tname, ok := strings.CutPrefix(node.Ref, \"#/definitions/\")\n\t\ttarget := definitions[name]\n\t\tif !ok || target == nil {\n\t\t\treport(\"%s: unresolved $ref \" + node.Ref)\n\t\t\treturn\n\t\t}\n\t\tnode = target\n\t}\n\tif typ == reflect.TypeFor[Duration]() {\n\t\tif !hasType(node, \"string\") {\n\t\t\treport(\"%s: schema type should be string (a duration)\")\n\t\t}\n\t\treturn\n\t}\n\tswitch typ.Kind() {\n\tcase reflect.Struct:\n\t\tif !hasType(node, \"object\") {\n\t\t\treport(\"%s: schema type should be object\")\n\t\t}\n\t\tif string(node.AdditionalProperties) != \"false\" {\n\t\t\treport(\"%s: schema should set additionalProperties: false\")\n\t\t}\n\t\tfields := map[string]reflect.Type{}\n\t\tfor field := range typ.Fields() {\n\t\t\tname, _, _ := strings.Cut(field.Tag.Get(\"json\"), \",\")\n\t\t\tif name == \"\" || name == \"-\" {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tfields[name] = field.Type\n\t\t}\n\t\tfor _, name := range sortedKeys(fields) {\n\t\t\tchild, ok := node.Properties[name]\n\t\t\tif !ok {\n\t\t\t\treport(\"%s: field \" + name + \" is missing from the schema\")\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tcompareSchema(join(path, name), fields[name], child, problems)\n\t\t}\n\t\tfor _, name := range sortedKeys(node.Properties) {\n\t\t\tif _, ok := fields[name]; !ok {\n\t\t\t\treport(\"%s: schema property \" + name +\n\t\t\t\t\t\" has no config field\")\n\t\t\t}\n\t\t}\n\tcase reflect.Map:\n\t\tif !hasType(node, \"object\") {\n\t\t\treport(\"%s: schema type should be object\")\n\t\t}\n\t\t// A map with a fixed key set lists each key as a property.\n\t\tif len(node.Properties) > 0 {\n\t\t\tfor _, name := range sortedKeys(node.Properties) {\n\t\t\t\tcompareSchema(join(path, name), typ.Elem(),\n\t\t\t\t\tnode.P