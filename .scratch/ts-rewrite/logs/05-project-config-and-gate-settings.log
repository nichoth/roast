{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GMfRb5UCRWuvugzptidxQ9","type":"tool_result","content":"// The CLI core: run(argv, io). It never reads process globals, never\n// touches the real terminal, and never calls process.exit, so tests drive\n// it in-process. It parses argv with yargs, runs the selected command,\n// writes any error to io.stderr, and returns the exit code.\nimport yargs, { type Argv } from 'yargs'\nimport { Parser } from 'yargs/helpers'\nimport { buildInfo, formatBuildInfo } from '../buildinfo.js'\nimport {\n    type CommandArgs,\n    type CommandDef,\n    type RunContext,\n    registeredCommands,\n} from './command.js'\nimport { builtinCommands } from './commands.js'\nimport {\n    type ErrorFormat,\n    UsageError,\n    exitCode,\n    writeError,\n} from './errors.js'\nimport { LineReader } from './terminal.js'\n\nexport interface CliIO {\n    stdin:NodeJS.ReadableStream;\n    stdout:NodeJS.WritableStream;\n    stderr:NodeJS.WritableStream;\n    env:Readonly<Record<string, string|undefined>>;\n    cwd:string;\n    signal?:AbortSignal;\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface RunResult {\n    code:number;\n    error?:Error;\n}\n\nconst PARSER_CONFIGURATION = {\n    'boolean-negation':false, // --no-verify is a real flag\n    'camel-case-expansion':false,\n    'dot-notation':false,\n    'parse-numbers':false, // integers are parsed by our own helper\n    'parse-positional-numbers':false,\n    'duplicate-arguments-array':false, // scalar flags: last wins\n    'strip-aliased':true,\n}\n\nconst ERROR_FORMATS:readonly string[] = ['text', 'json']\n\ninterface Selected {\n    def:CommandDef;\n    args:CommandArgs;\n    path:string[];\n}\n\nfunction commandNames (def:CommandDef):string[] {\n    const cmds = typeof def.command === 'string' ?\n        [def.command] :\n        [...def.command]\n    return cmds.map(c => c.split(' ')[0])\n}\n\n// Registers `def` (and its subcommands) on `y`. The yargs handler only\n// records the selection; run() calls the real handler after parsing, so\n// parse errors and command errors stay apart.\nfunction addCommand (\n    y:Argv,\n    def:CommandDef,\n    parent:string[],\n    select:(s:Selected) => void\n):Argv {\n    const names = commandNames(def)\n    const name = names.find(n => n !== '$0') ?? '$0'\n    return y.command(\n        def.command as string|string[],\n        def.describe as string,\n        sub => {\n            let b = def.builder ? def.builder(sub) : sub\n            for (const child of def.subcommands ?? []) {\n                b = addCommand(b, child, [...parent, name], select)\n            }\n            return b\n        },\n        args => {\n            // A default command matched without its name in argv.\n            const named = args._[parent.length] === name\n            const path = named ? [...parent, name] : parent\n            select({ def, args:args as CommandArgs, path })\n        }\n    )\n}\n\nfunction parser (select:(s:Selected) => void):Argv {\n    let y:Argv = yargs()\n        .scriptName('roast')\n        .locale('en')\n        .detectLocale(false) // English only, whatever LANG/LC_ALL say\n        .parserConfiguration(PARSER_CONFIGURATION)\n        .strict()\n        .exitProcess(false)\n        .showHelpOnFail(false)\n        .fail((msg, err) => {\n            throw new UsageError(msg ?? err?.message ?? 'invalid usage',\n                { cause:err })\n        })\n        .usage('$0 [command] [flags]\\n\\nAdversarial cross-model code ' +\n            'review. A finder proposes potential defects, then an ' +\n            'independent verifier adjudicates each claim against the ' +\n            'local checkout.')\n        .option('error-format', {\n            type:'string',\n            default:'text',\n            global:true,\n            describe:'Error output format (text|json)',\n        })\n        .version(false) // root-only --version / -v is handled in run\n        .option('version', {\n            alias:'v',\n            type:'boolean',\n            global:false,\n            describe:'Print the version and exit',\n        })\n        .help('help')\n        .alias('help', 'h')\n    for (const def of [...builtinCommands, ...registeredCommands()]) {\n        y = addCommand(y, def, [], select)\n    }\n    return y\n}\n\n// Parses argv. Resolves with the selected command, or with help output\n// when --help was given.\nasync function parse (\n    argv:string[]\n):Promise<{ selected?:Selected, output:string }> {\n    let selected:Selected|undefined\n    let output = ''\n    await parser(s => { selected = s }).parseAsync(argv, {},\n        (_err, _args, out) => { output = out ?? '' })\n    return { selected, output }\n}\n\nasync function helpFor (path:string[]):Promise<string> {\n    const { output } = await parse([...path, '--help'])\n    return output.endsWith('\\n') ? output : `${output}\\n`\n}\n\n// The --error-format yargs would parse from argv, for reporting a parse\n// failure; text when absent or invalid.\nfunction parsedErrorFormat (argv:string[]):ErrorFormat {\n    const parsed = Parser(argv, {\n        string:['error-format'],\n        configuration:PARSER_CONFIGURATION,\n    })\n    const v = parsed['error-format']\n    return v === 'json' ? 'json' : 'text'\n}\n\n// A root-level flag is one that no subcommand token precedes.\nfunction hasRootFlag (argv:string[], names:string[]):boolean {\n    for (let i = 0; i < argv.length; i++) {\n        const arg = argv[i]\n        if (arg === '--' || !arg.startsWith('-')) return false\n        if (names.includes(arg)) return true\n        if (arg === '--error-format') i++ // skip its value\n    }\n    return false\n}\n\nfunction toError (e:unknown):Error {\n    return e instanceof Error ? e : new Error(String(e))\n}\n\nexport async function run (argv:string[], io:CliIO):Promise<RunResult> {\n    const signal = io.signal ?? new AbortController().signal\n    let format:ErrorFormat = 'text'\n    try {\n        if (hasRootFlag(argv, ['--version', '-v'])) {\n            io.stdout.write(\n                `roast version ${formatBuildInfo(buildInfo)}\\n`)\n            return { code:0 }\n        }\n        let parsed:Awaited<ReturnType<typeof parse>>\n        try {\n            parsed = await parse(argv)\n        } catch (err) {\n            format = parsedErrorFormat(argv)\n            throw err\n        }\n        const { selected, output } = parsed\n        if (!selected) {\n            // --help (or a yargs-handled path with nothing to run).\n            if (output) {\n                io.stdout.write(output.endsWith('\\n') ?\n                    output :\n                    `${output}\\n`)\n            }\n            return { code:0 }\n        }\n        const errorFormat = String(selected.args['error-format'])\n        if (!ERROR_FORMATS.includes(errorFormat)) {\n            throw new UsageError(\n                `invalid --error-format ${JSON.stringify(errorFormat)} ` +\n                '(text|json)')\n        }\n        format = errorFormat as ErrorFormat\n        const extra = selected.args._.slice(selected.path.length)\n        if (extra.length > 0) {\n            throw new UsageError(\n                `unexpected argument ${JSON.stringify(String(extra[0]))}`)\n        }\n        const ctx:RunContext = {\n            stdin:io.stdin,\n            stdout:io.stdout,\n            stderr:io.stderr,\n            env:io.env,\n            cwd:io.cwd,\n            signal,\n            fetch:io.fetch ?? globalThis.fetch,\n            lines:new LineReader(io.stdin),\n            errorFormat:format,\n            path:selected.path,\n            rootHelp:() => helpFor([]),\n        }\n        const { def } = selected\n        if (def.handler) {\n            await def.handler(selected.args, ctx)\n        } else {\n            io.stdout.write(await helpFor(selected.path))\n        }\n        return { code:0 }\n    } catch (e) {\n        const error = toError(e)\n        const code = exitCode(error, signal)\n        writeError(io.stderr, code, error, format, signal)\n        return { code, error }\n    }\n}\n// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a\n// temporary Git repository as cwd, a clean environment, and optionally a\n// fetch that sends every request to a fake server.\nimport { run, type RunResult } from '../../src/cli/run.js'\nimport { BufferStream, inputStream } from './streams.js'\nimport { tempRepo } from './repo.js'\n\nexport interface RunRoastOpts {\n    // Working directory; a fresh temporary repository when absent.\n    cwd?:string;\n    // The environment; the repository's isolated env when absent.\n    env?:Record<string, string>;\n    stdin?:NodeJS.ReadableStream|string;\n    signal?:AbortSignal;\n    // Origin (`http://127.0.0.1:port`) every request is redirected to.\n    redirectTo?:string;\n}\n\nexport interface RunRoastResult extends RunResult {\n    stdout:string;\n    stderr:string;\n    // The original host of every redirected request, in order.\n    hosts:string[];\n}\n\n// A fetch that rewrites each URL's origin to `origin`, recording the\n// original host (Go redirectDefaultTransport).\nexport function redirectingFetch (\n    origin:string,\n    hosts:string[]\n):typeof globalThis.fetch {\n    return (input, init) => {\n        const req = new Request(input, init)\n        const url = new URL(req.url)\n        hosts.push(url.host)\n        const target = new URL(url.pathname + url.search, origin)\n        return globalThis.fetch(new Request(target, req))\n    }\n}\n\nexport async function runRoast (\n    args:string[],\n    opts:RunRoastOpts = {}\n):Promise<RunRoastResult> {\n    let cwd = opts.cwd\n    let env = opts.env\n    let remove:(() => void)|undefined\n    if (cwd === undefined) {\n        const repo = tempRepo()\n        cwd = repo.dir\n        env ??= repo.env\n        remove = repo.remove\n    }\n    const stdout = new BufferStream()\n    const stderr = new BufferStream()\n    const hosts:string[] = []\n    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?\n        inputStream(opts.stdin ?? '') :\n        opts.stdin\n    try {\n        const res = await run(args, {\n            stdin,\n            stdout,\n            stderr,\n            env:env ?? {},\n            cwd,\n            signal:opts.signal,\n            fetch:opts.redirectTo ?\n                redirectingFetch(opts.redirectTo, hosts) :\n                undefined,\n        })\n        return {\n            ...res,\n            stdout:stdout.text(),\n            stderr:stderr.text(),\n            hosts,\n        }\n    } finally {\n        remove?.()\n    }\n}\n// Temporary directories and Git repositories for CLI tests, with an\n// environment that isolates the user's home and config directories and\n// gives Git an identity (CI runners have none).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { cleanEnv } from './env.js'\n\nexport interface TempDir {\n    dir:string;\n    env:Record<string, string>;\n    remove ():void;\n}\n\nfunction makeTemp (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\n// The base test environment: the process env without provider or roast\n// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside\n// `root`, a Git identity, and no Git discovery above `root`.\nexport function isolatedEnv (root:string):Record<string, string> {\n    const home = path.join(root, '.home')\n    fs.mkdirSync(home, { recursive:true })\n    return {\n        ...cleanEnv(process.env),\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n        GIT_AUTHOR_NAME:'Roast Test',\n        GIT_AUTHOR_EMAIL:'roast-test@example.com',\n        GIT_COMMITTER_NAME:'Roast Test',\n        GIT_COMMITTER_EMAIL:'roast-test@example.com',\n        GIT_CEILING_DIRECTORIES:path.dirname(root),\n        GIT_CONFIG_NOSYSTEM:'1',\n    }\n}\n\n// A temporary directory that is not inside any Git repository. The test\n// working directory is `dir/work`.\nexport function tempDir (prefix = 'roast-dir-'):TempDir {\n    const root = makeTemp(prefix)\n    const dir = path.join(root, 'work')\n    fs.mkdirSync(dir)\n    return {\n        dir,\n        env:isolatedEnv(root),\n        remove:() => fs.rmSync(root, { recursive:true, force:true }),\n    }\n}\n\n// A temporary Git repository at `dir` (realpath, so it compares equal to\n// what Git prints).\nexport function tempRepo (prefix = 'roast-repo-'):TempDir {\n    const t = tempDir(prefix)\n    execFileSync('git', ['init', '-q', t.dir], { env:t.env })\n    return t\n}\n// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\n// The single test entry: imports every test module.\nimport './tooling/buildinfo.js'\nimport './tooling/startup.js'\nimport './tooling/bundle.js'\nimport './tooling/run-import.js'\nimport './tooling/assets.js'\nimport './tooling/test-tap.js'\nimport './tooling/licenses.js'\nimport './tooling/check-package.js'\nimport './textsafe/textsafe.js'\nimport './gocompat/strings.js'\nimport './gocompat/duration.js'\nimport './gocompat/match.js'\nimport './fsutil/atomic.js'\nimport './git/git.js'\nimport './util/pool.js'\nimport './snapshot/denylist.js'\nimport './scope/glob.js'\nimport './scope/patch.js'\nimport './scope/build.js'\nimport './scope/names.js'\nimport './scope/renames.js'\nimport './scope/fit.js'\nimport './scope/staged.js'\nimport './scope/huge.js'\nimport './scope/hardening.js'\nimport './scope/linguist.js'\nimport './scope/abort.js'\nimport './scope/bytes.js'\nimport './cli/errors.js'\nimport './cli/terminal.js'\nimport './cli/env.js'\nimport './cli/run.js'\nimport './cli/process.js'\nimport './cli/log.js'","is_error":false}]},"parent_tool_use_id":null,"session_id":"2c04a591-2f82-49dd-a2ef-471292a90a1e","uuid":"f1c9d52d-b01d-4aeb-97b1-c63a30a656b2","timestamp":"2026-11-18T19:44:38.650Z","tool_use_result":{"stdout":"// The CLI core: run(argv, io). It never reads process globals, never\n// touches the real terminal, and never calls process.exit, so tests drive\n// it in-process. It parses argv with yargs, runs the selected command,\n// writes any error to io.stderr, and returns the exit code.\nimport yargs, { type Argv } from 'yargs'\nimport { Parser } from 'yargs/helpers'\nimport { buildInfo, formatBuildInfo } from '../buildinfo.js'\nimport {\n    type CommandArgs,\n    type CommandDef,\n    type RunContext,\n    registeredCommands,\n} from './command.js'\nimport { builtinCommands } from './commands.js'\nimport {\n    type ErrorFormat,\n    UsageError,\n    exitCode,\n    writeError,\n} from './errors.js'\nimport { LineReader } from './terminal.js'\n\nexport interface CliIO {\n    stdin:NodeJS.ReadableStream;\n    stdout:NodeJS.WritableStream;\n    stderr:NodeJS.WritableStream;\n    env:Readonly<Record<string, string|undefined>>;\n    cwd:string;\n    signal?:AbortSignal;\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface RunResult {\n    code:number;\n    error?:Error;\n}\n\nconst PARSER_CONFIGURATION = {\n    'boolean-negation':false, // --no-verify is a real flag\n    'camel-case-expansion':false,\n    'dot-notation':false,\n    'parse-numbers':false, // integers are parsed by our own helper\n    'parse-positional-numbers':false,\n    'duplicate-arguments-array':false, // scalar flags: last wins\n    'strip-aliased':true,\n}\n\nconst ERROR_FORMATS:readonly string[] = ['text', 'json']\n\ninterface Selected {\n    def:CommandDef;\n    args:CommandArgs;\n    path:string[];\n}\n\nfunction commandNames (def:CommandDef):string[] {\n    const cmds = typeof def.command === 'string' ?\n        [def.command] :\n        [...def.command]\n    return cmds.map(c => c.split(' ')[0])\n}\n\n// Registers `def` (and its subcommands) on `y`. The yargs handler only\n// records the selection; run() calls the real handler after parsing, so\n// parse errors and command errors stay apart.\nfunction addCommand (\n    y:Argv,\n    def:CommandDef,\n    parent:string[],\n    select:(s:Selected) => void\n):Argv {\n    const names = commandNames(def)\n    const name = names.find(n => n !== '$0') ?? '$0'\n    return y.command(\n        def.command as string|string[],\n        def.describe as string,\n        sub => {\n            let b = def.builder ? def.builder(sub) : sub\n            for (const child of def.subcommands ?? []) {\n                b = addCommand(b, child, [...parent, name], select)\n            }\n            return b\n        },\n        args => {\n            // A default command matched without its name in argv.\n            const named = args._[parent.length] === name\n            const path = named ? [...parent, name] : parent\n            select({ def, args:args as CommandArgs, path })\n        }\n    )\n}\n\nfunction parser (select:(s:Selected) => void):Argv {\n    let y:Argv = yargs()\n        .scriptName('roast')\n        .locale('en')\n        .detectLocale(false) // English only, whatever LANG/LC_ALL say\n        .parserConfiguration(PARSER_CONFIGURATION)\n        .strict()\n        .exitProcess(false)\n        .showHelpOnFail(false)\n        .fail((msg, err) => {\n            throw new UsageError(msg ?? err?.message ?? 'invalid usage',\n                { cause:err })\n        })\n        .usage('$0 [command] [flags]\\n\\nAdversarial cross-model code ' +\n            'review. A finder proposes potential defects, then an ' +\n            'independent verifier adjudicates each claim against the ' +\n            'local checkout.')\n        .option('error-format', {\n            type:'string',\n            default:'text',\n            global:true,\n            describe:'Error output format (text|json)',\n        })\n        .version(false) // root-only --version / -v is handled in run\n        .option('version', {\n            alias:'v',\n            type:'boolean',\n            global:false,\n            describe:'Print the version and exit',\n        })\n        .help('help')\n        .alias('help', 'h')\n    for (const def of [...builtinCommands, ...registeredCommands()]) {\n        y = addCommand(y, def, [], select)\n    }\n    return y\n}\n\n// Parses argv. Resolves with the selected command, or with help output\n// when --help was given.\nasync function parse (\n    argv:string[]\n):Promise<{ selected?:Selected, output:string }> {\n    let selected:Selected|undefined\n    let output = ''\n    await parser(s => { selected = s }).parseAsync(argv, {},\n        (_err, _args, out) => { output = out ?? '' })\n    return { selected, output }\n}\n\nasync function helpFor (path:string[]):Promise<string> {\n    const { output } = await parse([...path, '--help'])\n    return output.endsWith('\\n') ? output : `${output}\\n`\n}\n\n// The --error-format yargs would parse from argv, for reporting a parse\n// failure; text when absent or invalid.\nfunction parsedErrorFormat (argv:string[]):ErrorFormat {\n    const parsed = Parser(argv, {\n        string:['error-format'],\n        configuration:PARSER_CONFIGURATION,\n    })\n    const v = parsed['error-format']\n    return v === 'json' ? 'json' : 'text'\n}\n\n// A root-level flag is one that no subcommand token precedes.\nfunction hasRootFlag (argv:string[], names:string[]):boolean {\n    for (let i = 0; i < argv.length; i++) {\n        const arg = argv[i]\n        if (arg === '--' || !arg.startsWith('-')) return false\n        if (names.includes(arg)) return true\n        if (arg === '--error-format') i++ // skip its value\n    }\n    return false\n}\n\nfunction toError (e:unknown):Error {\n    return e instanceof Error ? e : new Error(String(e))\n}\n\nexport async function run (argv:string[], io:CliIO):Promise<RunResult> {\n    const signal = io.signal ?? new AbortController().signal\n    let format:ErrorFormat = 'text'\n    try {\n        if (hasRootFlag(argv, ['--version', '-v'])) {\n            io.stdout.write(\n                `roast version ${formatBuildInfo(buildInfo)}\\n`)\n            return { code:0 }\n        }\n        let parsed:Awaited<ReturnType<typeof parse>>\n        try {\n            parsed = await parse(argv)\n        } catch (err) {\n            format = parsedErrorFormat(argv)\n            throw err\n        }\n        const { selected, output } = parsed\n        if (!selected) {\n            // --help (or a yargs-handled path with nothing to run).\n            if (output) {\n                io.stdout.write(output.endsWith('\\n') ?\n                    output :\n                    `${output}\\n`)\n            }\n            return { code:0 }\n        }\n        const errorFormat = String(selected.args['error-format'])\n        if (!ERROR_FORMATS.includes(errorFormat)) {\n            throw new UsageError(\n                `invalid --error-format ${JSON.stringify(errorFormat)} ` +\n                '(text|json)')\n        }\n        format = errorFormat as ErrorFormat\n        const extra = selected.args._.slice(selected.path.length)\n        if (extra.length > 0) {\n            throw new UsageError(\n                `unexpected argument ${JSON.stringify(String(extra[0]))}`)\n        }\n        const ctx:RunContext = {\n            stdin:io.stdin,\n            stdout:io.stdout,\n            stderr:io.stderr,\n            env:io.env,\n            cwd:io.cwd,\n            signal,\n            fetch:io.fetch ?? globalThis.fetch,\n            lines:new LineReader(io.stdin),\n            errorFormat:format,\n            path:selected.path,\n            rootHelp:() => helpFor([]),\n        }\n        const { def } = selected\n        if (def.handler) {\n            await def.handler(selected.args, ctx)\n        } else {\n            io.stdout.write(await helpFor(selected.path))\n        }\n        return { code:0 }\n    } catch (e) {\n        const error = toError(e)\n        const code = exitCode(error, signal)\n        writeError(io.stderr, code, error, format, signal)\n        return { code, error }\n    }\n}\n// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a\n// temporary Git repository as cwd, a clean environment, and optionally a\n// fetch that sends every request to a fake server.\nimport { run, type RunResult } from '../../src/cli/run.js'\nimport { BufferStream, inputStream } from './streams.js'\nimport { tempRepo } from './repo.js'\n\nexport interface RunRoastOpts {\n    // Working directory; a fresh temporary repository when absent.\n    cwd?:string;\n    // The environment; the repository's isolated env when absent.\n    env?:Record<string, string>;\n    stdin?:NodeJS.ReadableStream|string;\n    signal?:AbortSignal;\n    // Origin (`http://127.0.0.1:port`) every request is redirected to.\n    redirectTo?:string;\n}\n\nexport interface RunRoastResult extends RunResult {\n    stdout:string;\n    stderr:string;\n    // The original host of every redirected request, in order.\n    hosts:string[];\n}\n\n// A fetch that rewrites each URL's origin to `origin`, recording the\n// original host (Go redirectDefaultTransport).\nexport function redirectingFetch (\n    origin:string,\n    hosts:string[]\n):typeof globalThis.fetch {\n    return (input, init) => {\n        const req = new Request(input, init)\n        const url = new URL(req.url)\n        hosts.push(url.host)\n        const target = new URL(url.pathname + url.search, origin)\n        return globalThis.fetch(new Request(target, req))\n    }\n}\n\nexport async function runRoast (\n    args:string[],\n    opts:RunRoastOpts = {}\n):Promise<RunRoastResult> {\n    let cwd = opts.cwd\n    let env = opts.env\n    let remove:(() => void)|undefined\n    if (cwd === undefined) {\n        const repo = tempRepo()\n        cwd = repo.dir\n        env ??= repo.env\n        remove = repo.remove\n    }\n    const stdout = new BufferStream()\n    const stderr = new BufferStream()\n    const hosts:string[] = []\n    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?\n        inputStream(opts.stdin ?? '') :\n        opts.stdin\n    try {\n        const res = await run(args, {\n            stdin,\n            stdout,\n            stderr,\n            env:env ?? {},\n            cwd,\n            signal:opts.signal,\n            fetch:opts.redirectTo ?\n                redirectingFetch(opts.redirectTo, hosts) :\n                undefined,\n        })\n        return {\n            ...res,\n            stdout:stdout.text(),\n            stderr:stderr.text(),\n            hosts,\n        }\n    } finally {\n        remove?.()\n    }\n}\n// Temporary directories and Git repositories for CLI tests, with an\n// environment that isolates the user's home and config directories and\n// gives Git an identity (CI runners have none).\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { cleanEnv } from './env.js'\n\nexport interface TempDir {\n    dir:string;\n    env:Record<string, string>;\n    remove ():void;\n}\n\nfunction makeTemp (prefix:string):string {\n    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))\n}\n\n// The base test environment: the process env without provider or roast\n// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside\n// `root`, a Git identity, and no Git discovery above `root`.\nexport function isolatedEnv (root:string):Record<string, string> {\n    const home = path.join(root, '.home')\n    fs.mkdirSync(home, { recursive:true })\n    return {\n        ...cleanEnv(process.env),\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n        GIT_AUTHOR_NAME:'Roast Test',\n        GIT_AUTHOR_EMAIL:'roast-test@example.com',\n        GIT_COMMITTER_NAME:'Roast Test',\n        GIT_COMMITTER_EMAIL:'roast-test@example.com',\n        GIT_CEILING_DIRECTORIES:path.dirname(root),\n        GIT_CONFIG_NOSYSTEM:'1',\n    }\n}\n\n// A temporary directory that is not inside any Git repository. The test\n// working directory is `dir/work`.\nexport function tempDir (prefix = 'roast-dir-'):TempDir {\n    const root = makeTemp(prefix)\n    const dir = path.join(root, 'work')\n    fs.mkdirSync(dir)\n    return {\n        dir,\n        env:isolatedEnv(root),\n        remove:() => fs.rmSync(root, { recursive:true, force:true }),\n    }\n}\n\n// A temporary Git repository at `dir` (realpath, so it compares equal to\n// what Git prints).\nexport function tempRepo (prefix = 'roast-repo-'):TempDir {\n    const t = tempDir(prefix)\n    execFileSync('git', ['init', '-q', t.dir], { env:t.env })\n    return t\n}\n// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\n// The single test entry: imports every test module.\nimport './tooling/buildinfo.js'\nimport './tooling/startup.js'\nimport './tooling/bundle.js'\nimport './tooling/run-import.js'\nimport './tooling/assets.js'\nimport './tooling/test-tap.js'\nimport './tooling/licenses.js'\nimport './tooling/check-package.js'\nimport './textsafe/textsafe.js'\nimport './gocompat/strings.js'\nimport './gocompat/duration.js'\nimport './gocompat/match.js'\nimport './fsutil/atomic.js'\nimport './git/git.js'\nimport './util/pool.js'\nimport './snapshot/denylist.js'\nimport './scope/glob.js'\nimport './scope/patch.js'\nimport './scope/build.js'\nimport './scope/names.js'\nimport './scope/renames.js'\nimport './scope/fit.js'\nimport './scope/staged.js'\nimport './scope/huge.js'\nimport './scope/hardening.js'\nimport './scope/linguist.js'\nimport './scope/abort.js'\nimport './scope/bytes.js'\nimport './cli/errors.js'\nimport './cli/terminal.js'\nimport './cli/env.js'\nimport './cli/run.js'\nimport './cli/process.js'\nimport './cli/log.js'","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01GMfRb5UCRWuvugzptidxQ9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAy3ckVtENGi587u3pN1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JHbKA6snvLGX77Kz717Myh","name":"Bash","input":{"command":"cd /Users/nick/code/roast.ts-rewrite-05-project-config-and-gate-settings; sed -n 100,160p src/git/git.ts; cat roast.schema.json; cat scripts/bundle.ts | head -120; cat test/tooling/bundle.ts | head -60"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8111,"cache_read_input_tokens":85682,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8111},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2c04a591-2f82-49dd-a2ef-471292a90a1e","uuid":"374a0fc5-8576-4c06-be54-8a85b3bafd63","timestamp":"2026-11-18T19:44:40.647Z","request_id":"req_011ChAy3cY5yrgjSy6Ksx9BV","wire_tool_inputs":{"toolu_01JHbKA6snvLGX77Kz717Myh":{"command":"cd /Users/nick/code/roast.ts-rewrite-05-project-config-and-gate-settings; sed -n 100,160p src/git/git.ts; cat roast.schema.json; cat scripts/bundle.ts | head -120; cat test/tooling/bundle.ts | head -60"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JHbKA6snvLGX77Kz717Myh","type":"tool_result","content":"// Runs `git -C <repo> <args>` and resolves stdout. A non-zero exit\n// rejects with a GitError.\nexport async function git (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<Buffer> {\n    const exit = await runGit(repo, args, opts)\n    if (exit.code !== 0) {\n        throw new GitError(exit.code, exit.signal, exit.stderr.toString())\n    }\n    return exit.stdout\n}\n\n// Exit status only: false on a non-zero exit. Rejects only on abort or\n// when git cannot be started.\nexport async function gitOk (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<boolean> {\n    const exit = await runGit(repo, args, opts)\n    return exit.code === 0\n}\n\n// The repository toplevel containing `start`.\nexport async function gitRoot (\n    start:string,\n    opts:GitRunOpts = {}\n):Promise<string> {\n    let out:Buffer\n    try {\n        out = await git(start, ['rev-parse', '--show-toplevel'], opts)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error('not inside a git repository', { cause:err })\n    }\n    return out.toString().trim()\n}\n{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"$id\": \"https://github.com/nichoth/roast/roast.schema.json\",\n  \"title\": \"Roast project config (.roast.json)\",\n  \"description\": \"Every non-secret Roast setting. Credentials come only from environment variables; a profile names its variable with api_key_env.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"version\"],\n  \"properties\": {\n    \"$schema\": {\n      \"type\": \"string\",\n      \"description\": \"Editor schema reference. Roast ignores it.\"\n    },\n    \"version\": {\n      \"type\": \"integer\",\n      \"const\": 1,\n      \"description\": \"Config schema version. Must be 1.\"\n    },\n    \"inference_profiles\": {\n      \"type\": \"object\",\n      \"description\": \"Named model, endpoint, protocol, and credential variable combinations that roles select.\",\n      \"additionalProperties\": { \"$ref\": \"#/definitions/inference_profile\" }\n    },\n    \"roles\": {\n      \"type\": \"object\",\n      \"description\": \"Which inference profile each role uses.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"finder\": {\n          \"$ref\": \"#/definitions/role\",\n          \"description\": \"Proposes defects in the change.\"\n        },\n        \"verifier\": {\n          \"$ref\": \"#/definitions/role\",\n          \"description\": \"Checks each proposed defect against the code.\"\n        }\n      }\n    },\n    \"review\": {\n      \"type\": \"object\",\n      \"description\": \"Review defaults.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"confidence_floor\": {\n          \"type\": \"number\",\n          \"minimum\": 0,\n          \"maximum\": 1,\n          \"description\": \"Minimum confidence to report a finding. Default 0.6.\"\n        },\n        \"quick_confidence_floor\": {\n          \"type\": \"number\",\n          \"minimum\": 0,\n          \"maximum\": 1,\n          \"description\": \"Minimum confidence for a --quick review. Default 0.8.\"\n        },\n        \"excludes\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" },\n          \"description\": \"Path patterns left out of every review.\"\n        },\n        \"snapshot\": {\n          \"type\": \"boolean\",\n          \"description\": \"Record a Git snapshot of each review for replay. Default true.\"\n        }\n      }\n    },\n    \"prompts\": {\n      \"type\": \"object\",\n      \"description\": \"Project files that replace the embedded prompt templates. A relative path is relative to the directory holding this config file. Setting any of these requires `npx roast trust` approval.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"finder_code\": {\n          \"type\": \"string\",\n          \"description\": \"Finder prompt for code changes.\"\n        },\n        \"finder_prose\": {\n          \"type\": \"string\",\n          \"description\": \"Finder prompt for prose changes.\"\n        },\n        \"verifier\": {\n          \"type\": \"string\",\n          \"description\": \"Verifier prompt.\"\n        }\n      }\n    },\n    \"limits\": {\n      \"type\": \"object\",\n      \"description\": \"Per-review limits. An unset limit uses the built-in default.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"deadline\": {\n          \"$ref\": \"#/definitions/duration\",\n          \"description\": \"Wall-clock limit for one review. Default \\\"10m\\\"; \\\"0s\\\" disables.\"\n        },\n        \"request_timeout\": {\n          \"$ref\": \"#/definitions/duration\",\n          \"description\": \"Limit for one model request. Default \\\"10m\\\".\"\n        },\n        \"max_total_tokens\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"Token budget for one review. Default 3000000; 0 disables.\"\n        },\n        \"max_diff_bytes\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Largest diff sent to the finder. Default 1000000.\"\n        },\n        \"max_prompt_bytes\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Largest prompt sent in one request. Default 8000000.\"\n        },\n        \"max_file_ctx_bytes\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Largest file context sent with the diff. Default 400000.\"\n        },\n        \"max_attempts\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Attempts per model request, including the first. Default 4.\"\n        },\n        \"max_verified\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"Most findings sent to the verifier. Default 25.\"\n        }\n      }\n    },\n    \"interactive\": {\n      \"type\": \"object\",\n      \"description\": \"Diff size below which an --interactive review uses a single finder call instead.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"min_files\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"Minimum changed files. Default 4.\"\n        },\n        \"min_diff_lines\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"Minimum changed lines. Default 80.\"\n        }\n      }\n    },\n    \"gate\": {\n      \"type\": \"object\",\n      \"description\": \"The pre-commit gate.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"timeout_seconds\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"Gate watchdog in seconds. Default 180; 0 disables.\"\n        },\n        \"severity\": {\n          \"type\": \"string\",\n          \"enum\": [\"INFO\", \"LOW\", \"MEDIUM\", \"HIGH\", \"CRITICAL\"],\n          \"description\": \"Lowest severity that blocks a commit. Default HIGH.\"\n        },\n        \"offer\": {\n          \"type\": \"boolean\",\n          \"description\": \"Whether the first interactive review offers to enable the gate. Default true.\"\n        }\n      }\n    }\n  },\n  \"definitions\": {\n    \"duration\": {\n      \"type\": \"string\",\n      \"pattern\": \"^([0-9]+(\\\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$|^0$\",\n      \"description\": \"A Go duration such as \\\"90s\\\" or \\\"10m\\\".\"\n    },\n    \"inference_profile\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"endpoint\": {\n          \"type\": \"string\",\n          \"format\": \"uri\",\n          \"description\": \"Base URL. Defaults to the protocol's public endpoint (https://api.openai.com/v1 or https://api.anthropic.com/v1). Any other endpoint requires `npx roast trust` approval and api_key_env.\"\n        },\n        \"model\": {\n          \"type\": \"string\",\n          \"description\": \"Model ID sent to the endpoint.\"\n        },\n        \"protocol\": {\n          \"type\": \"string\",\n          \"enum\": [\"responses\", \"chat\", \"anthropic\"],\n          \"description\": \"Wire protocol. Default responses.\"\n        },\n        \"api_key_env\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[A-Za-z_][A-Za-z0-9_]*$\",\n          \"description\": \"Name of the environment variable that holds the credential. A config never holds the credential itself.\"\n        },\n        \"max_output_tokens\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Output token limit per request. Default 32768.\"\n        },\n        \"session_header\": {\n          \"type\": \"string\",\n          \"maxLength\": 64,\n          \"description\": \"Extra request header that carries the per-conversation session ID, for gateways that need one.\"\n        }\n      }\n    },\n    \"role\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"profile\"],\n      \"properties\": {\n        \"profile\": {\n          \"type\": \"string\",\n          \"description\": \"Name of an inference profile.\"\n        },\n        \"pin\": {\n          \"type\": \"boolean\",\n          \"description\": \"Finder only: keep this profile even when it shares the author's model family.\"\n        },\n        \"author_routes\": {\n          \"type\": \"object\",\n          \"description\": \"Finder only: maps an author model or model family to another inference profile.\",\n          \"additionalProperties\": { \"type\": \"string\" }\n        }\n      }\n    }\n  }\n}\n// Bundles the CLI (default), the test entry (--test), or the live-test\n// entry (--live) with esbuild. Run directly by Node (type stripping), so\n// only erasable TypeScript syntax is allowed here.\nimport { execFileSync } from 'node:child_process'\nimport { readFileSync } from 'node:fs'\nimport { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'\nimport { resolve } from 'node:path'\nimport { fileURLToPath } from 'node:url'\nimport { build } from 'esbuild'\nimport type { BuildOptions, Metafile } from 'esbuild'\nimport {\n    bundledPackageDirs,\n    readBundledPackages,\n    renderNotices,\n} from './licenses.ts'\n\nconst ROOT = fileURLToPath(new URL('..', import.meta.url))\n\nconst SHEBANG = '#!/usr/bin/env node'\n// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into\n// a runtime \"Dynamic require is not supported\" error unless a `require`\n// is in scope.\nconst REQUIRE_SHIM = [\n    \"import { createRequire as __roastRequire } from 'node:module'\",\n    'const require = __roastRequire(import.meta.url)',\n].join('\\n')\n\ntype Mode = 'cli'|'test'|'live'\n\nfunction parseMode (args:string[]):Mode {\n    if (args.length === 0) return 'cli'\n    if (args.length === 1 && args[0] === '--test') return 'test'\n    if (args.length === 1 && args[0] === '--live') return 'live'\n    throw new Error(`usage: node scripts/bundle.ts [--test|--live], got ${\n        args.join(' ')}`)\n}\n\n// Options shared by every bundle (spec 15, 2.5).\nfunction baseOptions ():BuildOptions {\n    return {\n        absWorkingDir:ROOT,\n        bundle:true,\n        platform:'node',\n        format:'esm',\n        target:'node22',\n        mainFields:['module', 'main'],\n        keepNames:true,\n        minify:false,\n        sourcemap:false,\n        loader:{ '.tmpl':'text', '.md':'text', '.sh':'text' },\n        logLevel:'warning',\n    }\n}\n\n// Runs git at the repository root; `unknown` when git fails (a build\n// from a tarball, no git on