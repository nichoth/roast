import { fileURLToPath } from 'node:url'\n\n// The test bundle lives in test/, so the repository root is one up.\nexport const ROOT = fileURLToPath(new URL('..', import.meta.url))\n\nexport interface SpawnResult {\n    code:number|null;\n    stdout:string;\n    stderr:string;\n}\n\n// Runs a command to completion and collects its output.\nexport function run (\n    command:string,\n    args:string[],\n    opts:{ cwd?:string, env?:NodeJS.ProcessEnv } = {}\n):Promise<SpawnResult> {\n    return new Promise((resolve, reject) => {\n        const child = spawn(command, args, {\n            cwd:opts.cwd ?? ROOT,\n            env:opts.env ?? process.env,\n            stdio:['ignore', 'pipe', 'pipe'],\n        })\n        let stdout = ''\n        let stderr = ''\n        child.stdout.setEncoding('utf8')\n        child.stderr.setEncoding('utf8')\n        child.stdout.on('data', chunk => { stdout += chunk })\n        child.stderr.on('data', chunk => { stderr += chunk })\n        child.on('error', reject)\n        child.on('close', code => resolve({ code, stdout, stderr }))\n    })\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01AR429NQY2e8cSG3QeWhkpi","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
