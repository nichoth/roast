t\n):Promise<ProjectConfig> {\n    let file:string\n    try {\n        file = await projectConfigPath(explicit, ctx)\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        throw usage(err)\n    }\n    if (file === '') throw new UsageError(NO_PROJECT_CONFIG)\n    let cfg:ProjectConfig\n    try {\n        cfg = loadConfig(file)\n    } catch (err) {\n        throw usage(err)\n    }\n    const stored = configHooks.storedCredentials?.(ctx)\n    return stored ? withStoredCredentials(cfg, stored) : cfg\n}\n"}}}
