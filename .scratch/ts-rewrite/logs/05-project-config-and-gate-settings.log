 result.metafile\n    if (!metafile) throw new Error('esbuild returned no metafile')\n    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))\n    await writeThirdPartyNotices(metafile)\n    await chmod(new URL('cli.js', dist), 0o755)\n}\n\nasync function bundleTests (entry:string, outfile:string):Promise<void> {\nimport { readFile, stat, open } from 'node:fs/promises'\nimport { join } from 'node:path'\nimport { test } from '@substrate-system/tapzero'\nimport { ROOT, run } from '../helpers/spawn.js'\n\nconst CLI = join(ROOT, 'dist', 'cli.js')\n\n// The process env without anything that could pick a locale.\nfunction baseEnv ():NodeJS.ProcessEnv {\n    const env = { ...process.env }\n    for (const key of Object.keys(env)) {\n        if (key === 'LANG' || key === 'LANGUAGE' || key.startsWith('LC_')) {\n            delete env[key]\n        }\n    }\n    return env\n}\n\ntest('--version prints the package.json version', async t => {\n    const pkg = JSON.parse(await readFile(join(ROOT, 'package.json'),\n        'utf8'))\n    for (const flag of ['--version', '-v']) {\n        const res = await run(process.execPath, [CLI, flag])\n        t.equal(res.code, 0, `${flag} exits 0`)\n        t.ok(res.stdout.includes(pkg.version),\n            `${flag} output contains the package version`)\n    }\n})\n\ntest('--help output does not depend on the locale', async t => {\n    const german = await run(process.execPath, [CLI, '--help'], {\n        env:{ ...baseEnv(), LC_ALL:'de_DE.UTF-8', LANG:'de_DE.UTF-8' },\n    })\n    const c = await run(process.execPath, [CLI, '--help'], {\n        env:{ ...baseEnv(), LC_ALL:'C' },\n    })\n    t.equal(german.code, 0, 'help exits 0 under a German locale')\n    t.equal(c.code, 0, 'help exits 0 under the C locale')\n    t.ok(c.stdout.length > 0, 'help is printed to stdout')\n    t.equal(german.stdout, c.stdout, 'help output is identical')\n})\n\ntest('dist/cli.js has a shebang and the owner execute bit', async t => {\n    const file = await open(CLI, 'r')\n    const head = Buffer.alloc(20)\n    await file.read(head, 0, 20, 0)\n    await file.close()\n    t.equal(head.toString('utf8'), '#!/usr/bin/env node\\n',\n        'the first line is the node shebang')\n    const mode = (await stat(CLI)).mode\n    t.ok(mode & 0o100, 'the owner can execute it')\n})\n\ntest('the entry exits 2 on a Node version below 22.18', async t => {\n    const fakeVersion = 'data:text/javascript,' + encodeURIComponent(\n        'Object.defineProperty(process.versions, \"node\", ' +\n        '{ value: \"22.17.1\" })'\n    )\n    const res = await run(process.execPath, [\n        '--import', fakeVersion, CLI, '--version',","is_error":false}]},"parent_tool_use_id":null,"session_id":"2c04a591-2f82-49dd-a2ef-471292a90a1e","uuid":"60168e31-ed4b-49da-b28f-a42b3a4e151f","timestamp":"2026-11-18T19:44:40.773Z","tool_use_result":{"stdout":"// Runs `git -C <repo> <args>` and resolves stdout. A non-zero exit\n// rejects with a GitError.\nexport async function git (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<Buffer> {\n    const exit = await runGit(repo, args, opts)\n    if (exit.code !== 0) {\n        throw new GitError(exit.code, exit.signal, exit.stderr.toString())\n    }\n    return exit.stdout\n}\n\n// Exit status only: false on a non-zero exit. Rejects only on abort or\n// when git cannot be started.\nexport async function gitOk (\n    repo:string,\n    args:readonly string[],\n    opts:GitRunOpts = {}\n):Promise<boolean> {\n    const exit = await runGit(repo, args, opts)\n    return exit.code === 0\n}\n\n// The repository toplevel containing `start`.\nexport async function gitRoot (\n    start:string,\n    opts:GitRunOpts = {}\n):Promise<string> {\n    let out:Buffer\n    try {\n        out = await git(start, ['rev-parse', '--show-toplevel'], opts)\n    } catch (err) {\n        if (opts.signal?.aborted) throw err\n        throw new Error('not inside a git repository', { cause:err })\