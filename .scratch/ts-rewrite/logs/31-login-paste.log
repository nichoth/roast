// A `node:http` fake inference server (Go httptest plus providerServer):
// it records every request and answers from a script that looks at the
// request (path, body, headers) and the request's position.
import {
    createServer,
    type IncomingHttpHeaders,
    type ServerResponse,
} from 'node:http'
import type { AddressInfo } from 'node:net'
import { writeInferenceStream } from './inference-stream.js'

export interface RecordedRequest {
    method:string;
    path:string;
    headers:IncomingHttpHeaders;
    // Header names and values exactly as sent, in order.
    rawHeaders:string[];
    rawBody:Buffer;
    // The parsed JSON body; undefined when it is not JSON.
    body:unknown;
}

export type Reply =
    // A complete response object, streamed in the protocol's SSE format;
    // the protocol defaults to the one the request path implies.
    | { stream:unknown, protocol?:string }
    | { status:number, headers?:Record<string, string>, body?:string|Buffer }
    // Full control: write the response yourself.
    | ((res:ServerResponse, req:RecordedRequest) => void|Promise<void>)

// Picks the reply for the n-th request (0-based).
export type Script = (req:RecordedRequest, n:number) => Reply

export interface InferenceServer {
    // `http://127.0.0.1:<port>`.
    url:string;
    requests:RecordedRequest[];
    close ():Promise<void>;
}

export function protocolForPath (path:string):string {
    if (path.endsWith('/chat/completions')) return 'chat'
    if (path.endsWith('/responses')) return 'responses'
    if (path.endsWith('/v1/messages')) return 'anthropic'
    return ''
}

async function reply (res:ServerResponse, req:RecordedRequest, r:Reply) {
    if (typeof r === 'function') {
        await r(res, req)
        return
    }
    if ('stream' in r) {
        writeInferenceStream(res, r.protocol ?? protocolForPath(req.path),
            r.stream)
        return
    }
    res.writeHead(r.status, r.headers ?? {})
    res.end(r.body ?? '')
}

export async function startInferenceServer (
    script:Script
):Promise<InferenceServer> {
    const requests:RecordedRequest[] = []
    const server = createServer((req, res) => {
        const parts:Buffer[] = []
        req.on('data', (c:Buffer) => parts.push(c))
        req.on('end', () => {
            const rawBody = Buffer.concat(parts)
            let body:unknown
            try {
                body = JSON.parse(rawBody.toString('utf8'))
            } catch {
                body = undefined
            }
            const rec:RecordedRequest = {
                method:req.method ?? '',
                path:req.url ?? '',
                headers:req.headers,
                rawHeaders:req.rawHeaders,
                rawBody,
                body,
            }
            const n = requests.length
            requests.push(rec)
            Promise.resolve()
                .then(() => reply(res, rec, script(rec, n)))
                .catch((err:unknown) => {
                    if (!res.headersSent) res.writeHead(500)
                    res.end(String(err))
                })
        })
    })
    await new Promise<void>(resolve => {
        server.listen(0, '127.0.0.1', resolve)
    })
    const { port } = server.address() as AddressInfo
    return {
        url:`http://127.0.0.1:${port}`,
        requests,
        close () {
            server.closeAllConnections()
            return new Promise<void>(resolve => server.close(() => resolve()))
        },
    }
}
// Temporary directories and Git repositories for CLI tests, with an
// environment that isolates the user's home and config directories and
// gives Git an identity (CI runners have none).
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { cleanEnv } from './env.js'

export interface TempDir {
    dir:string;
    env:Record<string, string>;
    remove ():void;
}

function makeTemp (prefix:string):string {
    return fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), prefix)))
}

// The base test environment: the process env without provider or roast
// variables, with HOME, XDG_CONFIG_HOME, and CLAUDE_CONFIG_DIR inside
// `root`, a Git identity, and no Git discovery above `root`.
export function isolatedEnv (root:string):Record<string, string> {
    const home = path.join(root, '.home')
    fs.mkdirSync(home, { recursive:true })
    return {
        ...cleanEnv(process.env),
        HOME:home,
        XDG_CONFIG_HOME:path.join(home, '.config'),
        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),
        GIT_AUTHOR_NAME:'Roast Test',
        GIT_AUTHOR_EMAIL:'roast-test@example.com',
        GIT_COMMITTER_NAME:'Roast Test',
        GIT_COMMITTER_EMAIL:'roast-test@example.com',
        GIT_CEILING_DIRECTORIES:path.dirname(root),
        GIT_CONFIG_NOSYSTEM:'1',
    }
}

// A temporary directory that is not inside any Git repository. The test
// working directory is `dir/work`.
export function tempDir (prefix = 'roast-dir-'):TempDir {
    const root = makeTemp(prefix)
    const dir = path.join(root, 'work')
    fs.mkdirSync(dir)
    return {
        dir,
        env:isolatedEnv(root),
        remove:() => fs.rmSync(root, { recursive:true, force:true }),
    }
}

// A temporary Git repository at `dir` (realpath, so it compares equal to
// what Git prints).
export function tempRepo (prefix = 'roast-repo-'):TempDir {
    const t = tempDir(prefix)
    execFileSync('git', ['init', '-q', t.dir], { env:t.env })
    return t
}
// The built-in provider registry (spec 02, 2.7): the one place that says
// which endpoint, protocols, standard key variable, key page, and login
// method each provider has. Trust standardness, ambient credentials, the
// `init` starter, and login all consult it.
import { goTrimSpace } from '../gocompat/strings.js'

export const DEFAULT_OPENAI_BASE_URL = 'https://api.openai.com/v1'
export const DEFAULT_ANTHROPIC_BASE_URL = 'https://api.anthropic.com/v1'
export const OPENROUTER_BASE_URL = 'https://openrouter.ai/api/v1'

export type Protocol = 'chat'|'responses'|'anthropic'
export type LoginMethod = 'paste'|'browser'

export interface BuiltinProvider {
    readonly name:string;
    readonly endpoint:string;
    // The first is the one starter profiles use.
    readonly protocols:readonly Protocol[];
    readonly keyEnv:string;
    readonly keyPage:string;
    readonly login:LoginMethod;
}

// No two entries share an (endpoint, protocol) pair, so providerAt finds
// at most one. Order matters for withheldKey and listings.
const REGISTRY:readonly BuiltinProvider[] = Object.freeze([
    {
        name:'openai',
        endpoint:DEFAULT_OPENAI_BASE_URL,
        protocols:['responses', 'chat'],
        keyEnv:'OPENAI_API_KEY',
        keyPage:'https://platform.openai.com/api-keys',
        login:'paste',
    },
    {
        name:'anthropic',
        endpoint:DEFAULT_ANTHROPIC_BASE_URL,
        protocols:['anthropic'],
        keyEnv:'ANTHROPIC_API_KEY',
        keyPage:'https://console.anthropic.com/settings/keys',
        login:'paste',
    },
    {
        name:'openrouter',
        endpoint:OPENROUTER_BASE_URL,
        protocols:['chat', 'responses'],
        keyEnv:'OPENROUTER_API_KEY',
        keyPage:'https://openrouter.ai/settings/keys',
        login:'browser',
    },
].map(p => Object.freeze({
    ...p,
    protocols:Object.freeze([...p.protocols]) as readonly Protocol[],
} as BuiltinProvider)))

function copy (p:BuiltinProvider):BuiltinProvider {
    return { ...p, protocols:[...p.protocols] }
}

// Copies of the registry, in registry order.
export function builtinProviders ():BuiltinProvider[] {
    return REGISTRY.map(copy)
}

// The provider with exactly this name (case-sensitive).
export function lookupProvider (name:string):BuiltinProvider|undefined {
    const p = REGISTRY.find(p => p.name === name)
    return p && copy(p)
}

// The provider that accepts `protocol` at `endpoint`.
export function providerAt (
    endpoint:string,
    protocol:string
):BuiltinProvider|undefined {
    const p = REGISTRY.find(p =>
        (p.protocols as readonly string[]).includes(protocol) &&
        sameEndpoint(p.endpoint, endpoint))
    return p && copy(p)
}

// The implicit endpoint of a profile that sets none. OpenRouter is never
// one.
export function defaultBaseURL (protocol:string):string {
    return protocol === 'anthropic' ?
        DEFAULT_ANTHROPIC_BASE_URL :
        DEFAULT_OPENAI_BASE_URL
}

// Parses an endpoint with WHATWG URL, or null when it does not parse or
// has an empty host. WHATWG repairs `https:///v1` and `https:v1` into a
// host; Go sees an empty one, so text after the scheme must start with
// `//` and a non-empty authority.
export function parseEndpoint (s:string):URL|null {
    const colon = s.indexOf(':')
    if (colon < 0) return null
    const rest = s.slice(colon + 1)
    if (!rest.startsWith('//')) return null
    const end = rest.slice(2).search(/[/?#]/)
    const authority = end < 0 ? rest.slice(2) : rest.slice(2, 2 + end)
    // Userinfo alone (`https://u@/v1`) leaves no host either.
    if (authority.slice(authority.lastIndexOf('@') + 1) === '') return null
    let u:URL
    try {
        u = new URL(s)
    } catch {
        return null
    }
    return u.host === '' ? null : u
}

function stripTrailingSlashes (p:string):string {
    let end = p.length
    while (end > 0 && p[end - 1] === '/') end--
    return p.slice(0, end)
}

// Endpoints compare by scheme and host (case-insensitive), path without
// trailing slashes, raw query, and userinfo. Unparseable values never
// match.
export function sameEndpoint (a:string, b:string):boolean {
    const left = parseEndpoint(goTrimSpace(a))
    const right = parseEndpoint(goTrimSpace(b))
    if (!left || !right) return false
    return left.protocol === right.protocol &&
        left.host === right.host &&
        stripTrailingSlashes(left.pathname) ===
            stripTrailingSlashes(right.pathname) &&
        left.search === right.search &&
        left.username === right.username &&
        left.password === right.password
}
