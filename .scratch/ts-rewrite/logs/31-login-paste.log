// Shared terminal helpers (spec 01, 2.16): yes/no prompt, secret input,
// terminal detection, browser opening. Terminal detection and browser
// opening are swappable through `terminalHooks` so tests never touch a
// real terminal or launch a browser.
import { spawn } from 'node:child_process'
import { isatty } from 'node:tty'
import { goTrimSpace } from '../gocompat/strings.js'
import { CancelledError } from './errors.js'

// Reads a stream one character or line at a time. One reader serves every
// prompt in a command, so input buffered past one answer is kept for the
// next. The stream is attached lazily, on the first read.
export class LineReader {
    private readonly stream:NodeJS.ReadableStream
    private buf = ''
    private ended = false
    private error:Error|undefined
    private attached = false
    private wake:(() => void)|undefined

    constructor (stream:NodeJS.ReadableStream) {
        this.stream = stream
    }

    private attach ():void {
        if (this.attached) return
        this.attached = true
        const notify = ():void => {
            const w = this.wake
            this.wake = undefined
            w?.()
        }
        this.stream.setEncoding('utf8')
        this.stream.on('data', (chunk:string) => {
            this.buf += chunk
            notify()
        })
        this.stream.on('end', () => {
            this.ended = true
            notify()
        })
        this.stream.on('error', (err:Error) => {
            this.error = err
            notify()
        })
    }

    // Waits until the buffer holds data, the stream ended, or failed.
    private async fill ():Promise<void> {
        this.attach()
        while (this.buf === '' && !this.ended && !this.error) {
            this.stream.resume()
            await new Promise<void>(resolve => { this.wake = resolve })
        }
        this.stream.pause()
        if (this.buf === '' && this.error) throw this.error
    }

    // The next character, or null at end of input.
    async readChar ():Promise<string|null> {
        await this.fill()
        if (this.buf === '') return null
        const c = String.fromCodePoint(this.buf.codePointAt(0) as number)
        this.buf = this.buf.slice(c.length)
        return c
    }

    // The next line without its line ending, or null at end of input with
    // nothing read. A last line without a newline is returned as is.
    async readLine ():Promise<string|null> {
        let line = ''
        for (;;) {
            await this.fill()
            if (this.buf === '') return line === '' ? null : line
            const i = this.buf.indexOf('\n')
            if (i >= 0) {
                line += this.buf.slice(0, i)
                this.buf = this.buf.slice(i + 1)
                return line.endsWith('\r') ? line.slice(0, -1) : line
            }
            line += this.buf
            this.buf = ''
        }
    }
}

// Writes `<question> [Y/n] ` and reads one answer: empty, y, or yes (any
// case) is true; anything else, or end of input, is false.
export async function promptYesDefault (
    out:NodeJS.WritableStream,
    lines:LineReader,
    question:string
):Promise<boolean> {
    out.write(`${question} [Y/n] `)
    const answer = await lines.readLine()
    if (answer === null) return false
    const a = goTrimSpace(answer).toLowerCase()
    return a === '' || a === 'y' || a === 'yes'
}

// Writes `<question> [y/N] ` and reads one answer: only y or yes (any
// case, surrounding space ignored) is true; empty input, anything else,
// or end of input is false.
export async function promptNoDefault (
    out:NodeJS.WritableStream,
    lines:LineReader,
    question:string
):Promise<boolean> {
    out.write(`${question} [y/N] `)
    const answer = await lines.readLine()
    if (answer === null) return false
    const a = goTrimSpace(answer).toLowerCase()
    return a === 'y' || a === 'yes'
}

interface RawTTY {
    isTTY?:boolean;
    setRawMode?:(on:boolean) => unknown;
}

function rawCapable (stdin:NodeJS.ReadableStream):stdin is
    NodeJS.ReadableStream&Required<RawTTY> {
    const s = stdin as NodeJS.ReadableStream&RawTTY
    return s.isTTY === true && typeof s.setRawMode === 'function'
}

const CTRL_C = '\x03'
const CTRL_D = '\x04'
const BACKSPACE = '\x08'
const DELETE = '\x7f'

// Reads one line in raw mode without echo. Ctrl-C cancels.
async function readRawLine (lines:LineReader):Promise<string|null> {
    let line = ''
    for (;;) {
        const c = await lines.readChar()
        if (c === null) return line === '' ? null : line
        if (c === '\r' || c === '\n') return line
        if (c === CTRL_C) throw new CancelledError()
        if (c === CTRL_D && line === '') return null
        if (c === BACKSPACE || c === DELETE) {
            line = line.slice(0, -1)
            continue
        }
        line += c
    }
}

// Writes `prompt` and reads one secret. On a TTY it reads in raw mode
// without echo (Ctrl-C is cancellation); otherwise one plain line from
// the shared reader. The result is trimmed; end of input with no text is
// an error.
export async function readSecret (
    out:NodeJS.WritableStream,
    stdin:NodeJS.ReadableStream,
    lines:LineReader,
    prompt:string
):Promise<string> {
    out.write(prompt)
    let answer:string|null
    if (rawCapable(stdin)) {
        stdin.setRawMode(true)
        try {
            answer = await readRawLine(lines)
        } finally {
            stdin.setRawMode(false)
            out.write('\n')
        }
    } else {
        answer = await lines.readLine()
    }
    if (answer === null) throw new Error('no input: end of file')
    return goTrimSpace(answer)
}

function isTerminal (stream:unknown):boolean {
    const s = stream as { isTTY?:boolean, fd?:unknown }
    return s.isTTY === true && typeof s.fd === 'number' && isatty(s.fd)
}

// Both streams are real terminals. A stream without a file descriptor,
// such as a test buffer, never is.
function defaultInteractiveTerminals (
    stdin:NodeJS.ReadableStream,
    stderr:NodeJS.WritableStream
):boolean {
    return isTerminal(stdin) && isTerminal(stderr)
}

// Starts `open <url>` (darwin) or `xdg-open <url>` without waiting for
// it. Resolves with a spawn error, or undefined once started. The child
// is killed when `signal` aborts.
function defaultOpenBrowser (
    url:string,
    signal?:AbortSignal
):Promise<Error|undefined> {
    const cmd = process.platform === 'darwin' ? 'open' : 'xdg-open'
    return new Promise(resolve => {
        const child = spawn(cmd, [url], {
            stdio:'ignore',
            detached:true,
            signal,
        })
        child.on('spawn', () => {
            child.unref()
            resolve(undefined)
        })
        // Also swallows the AbortError emitted when `signal` kills it.
        child.on('error', err => resolve(err))
    })
}

export const terminalHooks = {
    interactiveTerminals:defaultInteractiveTerminals,
    openBrowser:defaultOpenBrowser,
}

export function interactiveTerminals (
    stdin:NodeJS.ReadableStream,
    stderr:NodeJS.WritableStream
):boolean {
    return terminalHooks.interactiveTerminals(stdin, stderr)
}

export function openBrowser (
    url:string,
    signal?:AbortSignal
):Promise<Error|undefined> {
    return terminalHooks.openBrowser(url, signal)
}
// Swaps the terminal hooks for a test and restores them at test end.
import { terminalHooks } from '../../src/cli/terminal.js'

interface Cleanup {
    cleanup (fn:() => void):void;
}

// Makes interactiveTerminals answer `value` until the test ends.
export function simulateTerminals (t:Cleanup, value:boolean):void {
    const saved = terminalHooks.interactiveTerminals
    terminalHooks.interactiveTerminals = () => value
    t.cleanup(() => { terminalHooks.interactiveTerminals = saved })
}

// Replaces openBrowser with a recorder; returns the URLs it was asked to
// open. Nothing is launched.
export function captureBrowser (t:Cleanup):string[] {
    const saved = terminalHooks.openBrowser
    const opened:string[] = []
    terminalHooks.openBrowser = async url => {
        opened.push(url)
        return undefined
    }
    t.cleanup(() => { terminalHooks.openBrowser = saved })
    return opened
}
// runRoast: the CLI run in-process (spec 01, 3.7) with buffer streams, a
// temporary Git repository as cwd, a clean environment, and optionally a
// fetch that sends every request to a fake server.
import { run, type RunResult } from '../../src/cli/run.js'
import { BufferStream, inputStream } from './streams.js'
import { tempRepo } from './repo.js'

export interface RunRoastOpts {
    // Working directory; a fresh temporary repository when absent.
    cwd?:string;
    // The environment; the repository's isolated env when absent.
    env?:Record<string, string>;
    stdin?:NodeJS.ReadableStream|string;
    signal?:AbortSignal;
    // Origin (`http://127.0.0.1:port`) every request is redirected to.
    redirectTo?:string;
}

export interface RunRoastResult extends RunResult {
    stdout:string;
    stderr:string;
    // The original host of every redirected request, in order.
    hosts:string[];
}

// A fetch that rewrites each URL's origin to `origin`, recording the
// original host (Go redirectDefaultTransport).
export function redirectingFetch (
    origin:string,
    hosts:string[]
):typeof globalThis.fetch {
    return (input, init) => {
        const req = new Request(input, init)
        const url = new URL(req.url)
        hosts.push(url.host)
        const target = new URL(url.pathname + url.search, origin)
        return globalThis.fetch(new Request(target, req))
    }
}

export async function runRoast (
    args:string[],
    opts:RunRoastOpts = {}
):Promise<RunRoastResult> {
    let cwd = opts.cwd
    let env = opts.env
    let remove:(() => void)|undefined
    if (cwd === undefined) {
        const repo = tempRepo()
        cwd = repo.dir
        env ??= repo.env
        remove = repo.remove
    }
    const stdout = new BufferStream()
    const stderr = new BufferStream()
    const hosts:string[] = []
    const stdin = typeof opts.stdin === 'string' || !opts.stdin ?
        inputStream(opts.stdin ?? '') :
        opts.stdin
    try {
        const res = await run(args, {
            stdin,
            stdout,
            stderr,
            env:env ?? {},
            cwd,
            signal:opts.signal,
            fetch:opts.redirectTo ?
                redirectingFetch(opts.redirectTo, hosts) :
                undefined,
        })
        return {
            ...res,
            stdout:stdout.text(),
            stderr:stderr.text(),
            hosts,
        }
    } finally {
        remove?.()
    }
}
// The built-in subcommands. Each area adds its CommandDef here
// (runs, gate, skill, doctor, ignore, trust, init, login, logout).
import type { CommandDef } from './command.js'
import { gateCommand } from './gate.js'
import { ignoreCommand } from './ignore.js'
import { reviewCommand } from './review.js'
import { skillCommand } from './skill.js'
import { trustCommand } from './trust.js'

export const builtinCommands:readonly CommandDef[] = [
    reviewCommand,
    skillCommand,
    gateCommand,
    ignoreCommand,
    trustCommand,
]
// The command registration API. Area tickets describe their commands as
// CommandDefs and list them in src/cli/commands.ts; tests add their own
// with registerCommand. run.ts builds the yargs tree from both.
import type { Argv, ArgumentsCamelCase } from 'yargs'
import type { ErrorFormat } from './errors.js'
import type { LineReader } from './terminal.js'

// Everything a command handler may touch. Handlers never read process
// globals: cwd, env, signal, and fetch come from here.
export interface RunContext {
    stdin:NodeJS.ReadableStream;
    stdout:NodeJS.WritableStream;
    stderr:NodeJS.WritableStream;
    env:Readonly<Record<string, string|undefined>>;
    cwd:string;
    signal:AbortSignal;
    fetch:typeof globalThis.fetch;
    // The one line reader every prompt in this invocation shares.
    lines:LineReader;
    errorFormat:ErrorFormat;
    // The command tokens that selected this handler, such as
    // ['gate', 'enable']; empty for bare `roast`.
    path:string[];
    // Root help, for commands that print it.
    rootHelp ():Promise<string>;
}

export type CommandArgs = ArgumentsCamelCase<Record<string, unknown>>

export interface CommandDef {
    // A yargs command string, such as 'show <id>', or aliases.
    command:string|readonly string[];
    // Help description; false hides the command.
    describe:string|false;
    // Declares the command's flags and positionals.
    builder?:(y:Argv) => Argv;
    // Throws UsageError, ExitSignal, or any other error; never writes
    // the error itself. A command with subcommands and no handler
    // prints its help.
    handler?:(args:CommandArgs, ctx:RunContext) => void|Promise<void>;
    subcommands?:readonly CommandDef[];
}

const registered:CommandDef[] = []

// Adds a command to every later run; returns a function removing it.
export function registerCommand (def:CommandDef):() => void {
    registered.push(def)
    return () => {
        const i = registered.indexOf(def)
        if (i >= 0) registered.splice(i, 1)
    }
}

export function registeredCommands ():readonly CommandDef[] {
    return registered
}
// Exit codes, error categories, and error output (spec 01, 2.2 to 2.4).
import { LlmError } from '../llm/errors.js'
import { text } from '../textsafe/textsafe.js'

export const ExitCode = {
    Clean:0,
    Findings:1,
    Usage:2,
    Auth:3,
    Partial:4,
    Cancelled:5,
} as const

export type ErrorCategory = 'none'|'findings'|'usage'|'auth'|'endpoint'|
    'resource_limit'|'partial'|'cancelled'

export type ErrorFormat = 'text'|'json'

// A bad flag, command, config, or anything else the user must fix.
export class UsageError extends Error {
    constructor (message:string, options?:ErrorOptions) {
        super(message, options)
        this.name = 'UsageError'
    }
}

// The run was cancelled (first SIGINT/SIGTERM, Ctrl-C at a prompt).
export class CancelledError extends Error {
    constructor (message = 'cancelled', options?:ErrorOptions) {
        super(message, options)
        this.name = 'CancelledError'
    }
}

// A successful command asking for a non-zero exit with nothing printed
// (Go gateExit): 1 for gating findings, 4 for a partial review.
export class ExitSignal extends Error {
    readonly code:1|4

    constructor (code:1|4) {
        super(`exit ${code}`)
        this.code = code
        this.name = 'ExitSignal'
    }
}

// Walks err, err.cause, ... and reports whether any link passes `test`.
// Stops on a cycle or at the first non-Error.
export function errorChainHas (
    err:unknown,
    test:(e:Error) => boolean
):boolean {
    const seen = new Set<unknown>()
    let cur = err
    while (cur instanceof Error && !seen.has(cur)) {
        if (test(cur)) return true
        seen.add(cur)
        cur = cur.cause
    }
    return false
}

function isAbortError (e:Error):boolean {
    return e.name === 'AbortError'
}

// Cancellation: a CancelledError in the chain, or an AbortError raised
// while `signal` is aborted with a CancelledError reason. A TimeoutError
// is never cancellation.
export function isCancellation (err:unknown, signal?:AbortSignal):boolean {
    if (errorChainHas(err, e => e instanceof CancelledError)) return true
    if (!signal?.aborted) return false
    if (!(signal.reason instanceof CancelledError)) return false
    return errorChainHas(err, isAbortError)
}

function llmKind (err:unknown, kinds:string[]):boolean {
    return errorChainHas(err, e => {
        return e instanceof LlmError && kinds.includes(e.kind)
    })
}

function isUsage (err:unknown):boolean {
    return errorChainHas(err, e => e instanceof UsageError)
}

export function exitCode (err:unknown, signal?:AbortSignal):number {
    if (err === undefined || err === null) return ExitCode.Clean
    if (err instanceof ExitSignal) return err.code
    if (isCancellation(err, signal)) return ExitCode.Cancelled
    if (llmKind(err, ['auth'])) return ExitCode.Auth
    if (isUsage(err)) return ExitCode.Usage
    return ExitCode.Partial
}

export function errorCategoryFor (
    code:number,
    err:unknown,
    signal?:AbortSignal
):ErrorCategory {
    if (code === ExitCode.Clean) return 'none'
    if (code === ExitCode.Findings) return 'findings'
    if (isCancellation(err, signal)) return 'cancelled'
    if (llmKind(err, ['auth'])) return 'auth'
    if (llmKind(err, ['endpoint'])) return 'endpoint'
    if (llmKind(err, ['budget_exhausted', 'work_deadline',
        'no_final_call'])) {
        return 'resource_limit'
    }
    if (isUsage(err) || code === ExitCode.Usage) return 'usage'
    if (code === ExitCode.Cancelled) return 'cancelled'
    return 'partial'
}

// Writes an error to `out`: `roast: <message>` sanitized, or one JSON
// object. An ExitSignal writes nothing.
export function writeError (
    out:NodeJS.WritableStream,
    code:number,
    err:Error,
    format:ErrorFormat,
    signal?:AbortSignal
):void {
    if (err instanceof ExitSignal) return
    if (format === 'json') {
        const body = {
            error_category:errorCategoryFor(code, err, signal),
            message:err.message,
            exit_code:code,
        }
        out.write(`${JSON.stringify(body)}\n`)
        return
    }
    out.write(`roast: ${text(err.message)}\n`)
}

