diff --git a/src/cli/login.ts b/src/cli/login.ts
new file mode 100644
index 0000000000000000000000000000000000000000..95f731c7ab54df7c3a52524df8391f1e449c05bb
--- /dev/null
+++ b/src/cli/login.ts
@@ -0,0 +1,209 @@
+// pattern: Imperative Shell
+// Paste login uses only the registry's built-in endpoints and the
+// command's shared reader, fetch, environment, and cancellation signal.
+import {
+    builtinProviders,
+    lookupProvider,
+    type BuiltinProvider,
+} from '../config/provider.js'
+import {
+    projectCredentialsPath,
+    saveCredential,
+    userCredentialsPath,
+    type CredentialScope,
+} from '../credentials/credentials.js'
+import { goQuote } from '../gocompat/strings.js'
+import { abortable } from '../llm/capture.js'
+import { AuthError, EndpointError } from '../llm/errors.js'
+import type { CommandDef, RunContext } from './command.js'
+import { UsageError } from './errors.js'
+import { interactiveTerminals, openBrowser, readSecret } from './terminal.js'
+
+export type LoginContext = Pick<RunContext,
+    'cwd'|'env'|'signal'|'fetch'|'stdin'|'stdout'|'stderr'|'lines'>
+
+export interface LoginFlags {
+    global:boolean;
+    noBrowser:boolean;
+}
+
+export interface LoginTarget {
+    path:string;
+    scope:CredentialScope;
+}
+
+export function providerNames ():string {
+    return builtinProviders().map(p => p.name).join(', ')
+}
+
+export async function loginPath (
+    global:boolean,
+    ctx:LoginContext
+):Promise<LoginTarget> {
+    if (global) {
+        return { path:userCredentialsPath(ctx.env), scope:'user' }
+    }
+    try {
+        const path = await projectCredentialsPath(ctx.cwd, {
+            env:ctx.env as NodeJS.ProcessEnv,
+            signal:ctx.signal,
+        })
+        return { path, scope:'project' }
+    } catch (err) {
+        if (ctx.signal.aborted) throw err
+        throw new UsageError('not in a Git repository; use --global ' +
+            'to store the key for the user', { cause:err })
+    }
+}
+
+export function keyCheckPath (provider:BuiltinProvider):string {
+    return provider.name === 'openrouter' ? '/key' : '/models'
+}
+
+class KeyRejected extends Error {}
+
+// Discard at most 32 KiB, then cancel even if the provider keeps sending.
+async function drainValidationBody (
+    response:Response,
+    signal:AbortSignal
+):Promise<void> {
+    if (!response.body) return
+    const reader = response.body.getReader()
+    let size = 0
+    try {
+        while (size < 32 * 1024) {
+            const chunk = await abortable(reader.read(), signal)
+            if (chunk.done) return
+            size += chunk.value.byteLength
+        }
+    } finally {
+        await reader.cancel().catch(() => {})
+        reader.releaseLock()
+    }
+}
+
+export async function validateKey (
+    provider:BuiltinProvider,
+    key:string,
+    ctx:LoginContext
+):Promise<void> {
+    const url = provider.endpoint.replace(/\/+$/, '') +
+        keyCheckPath(provider)
+    const signal = AbortSignal.any([
+        ctx.signal,
+        AbortSignal.timeout(30_000),
+    ])
+    const prefix = 'llm: inference endpoint failure: check key at ' + url
+    let response:Response
+    try {
+        response = await ctx.fetch(url, {
+            method:'GET',
+            redirect:'manual',
+            signal,
+            headers:provider.protocols[0] === 'anthropic' ? {
+                'x-api-key':key,
+                'anthropic-version':'2023-06-01',
+            } : { Authorization:`Bearer ${key}` },
+        })
+        await drainValidationBody(response, signal)
+    } catch (err) {
+        const message = err instanceof Error ? err.message : String(err)
+        throw new EndpointError(`${prefix}: ${message}`, { cause:err })
+    }
+    if (response.status >= 300 && response.status < 400) {
+        throw new EndpointError(`${prefix}: redirect refused`)
+    }
+    if (response.status === 401 || response.status === 403) {
+        throw new KeyRejected()
+    }
+    if (!response.ok) {
+        throw new EndpointError(`${prefix}: HTTP ${response.status} ` +
+            response.statusText)
+    }
+}
+
+async function pasteLogin (
+    provider:BuiltinProvider,
+    flags:LoginFlags,
+    ctx:LoginContext
+):Promise<string> {
+    ctx.stderr.write(`Create a ${provider.name} API key at:\n` +
+        `  ${provider.keyPage}\n`)
+    if (!flags.noBrowser) {
+        const err = await openBrowser(provider.keyPage, ctx.signal)
+        if (err) {
+            ctx.stderr.write(`could not open a browser (${err.message}); ` +
+                'open the URL above\n')
+        }
+    }
+    for (let attempt = 0; attempt < 3; attempt++) {
+        let key:string
+        try {
+            key = await readSecret(ctx.stderr, ctx.stdin, ctx.lines,
+                'Paste the key: ')
+        } catch (err) {
+            const message = err instanceof Error ? err.message : String(err)
+            throw new Error(`read key: ${message}`, { cause:err })
+        }
+        if (key === '') {
+            ctx.stderr.write('no key entered\n')
+            continue
+        }
+        try {
+            await validateKey(provider, key, ctx)
+            return key
+        } catch (err) {
+            if (!(err instanceof KeyRejected)) throw err
+            ctx.stderr.write(`${provider.name} rejected the key; ` +
+                'try again\n')
+        }
+    }
+    throw new AuthError('llm: authentication failed: no accepted ' +
+        `${provider.name} key after 3 tries; nothing stored`)
+}
+
+export async function runLogin (
+    name:string,
+    flags:LoginFlags,
+    ctx:LoginContext
+):Promise<void> {
+    const provider = lookupProvider(name)
+    if (!provider) {
+        throw new UsageError(`unknown provider ${goQuote(name)}; ` +
+            `built-in providers: ${providerNames()}`)
+    }
+    if (!interactiveTerminals(ctx.stdin, ctx.stderr)) {
+        throw new UsageError('login needs an interactive terminal; ' +
+            `set ${provider.keyEnv} instead`)
+    }
+    const target = await loginPath(flags.global, ctx)
+    if (provider.login !== 'paste') {
+        throw new Error(`login to ${provider.name} is not supported; ` +
+            `set ${provider.keyEnv}`)
+    }
+    const key = await pasteLogin(provider, flags, ctx)
+    await saveCredential(target.path, provider.name, key, new Date())
+    ctx.stdout.write(`stored ${provider.name} credential ` +
+        `(${target.scope} scope)\n`)
+}
+
+export const loginCommand:CommandDef = {
+    command:'login <provider>',
+    describe:'Store an API key for a built-in provider',
+    builder:y => y
+        .positional('provider', { type:'string' })
+        .option('global', {
+            type:'boolean',
+            default:false,
+            describe:'Store the credential for the user',
+        })
+        .option('no-browser', {
+            type:'boolean',
+            default:false,
+            describe:'Print the key page URL without opening a browser',
+        }),
+    handler:(args, ctx) => runLogin(String(args.provider), {
+        global:args.global === true,
+        noBrowser:args['no-browser'] === true,
+    }, ctx),
+}
diff --git a/test/cli/login.ts b/test/cli/login.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2d69142aa394db39076bca4758eda5711f21e9f2
--- /dev/null
+++ b/test/cli/login.ts
@@ -0,0 +1,87 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { tempRepo } from '../helpers/repo.js'
+import { runRoast } from '../helpers/run.js'
+import { providerServer } from '../helpers/provider-server.js'
+import {
+    captureBrowser,
+    simulateTerminals,
+} from '../helpers/terminal.js'
+import { loadCredentials } from '../../src/credentials/credentials.js'
+
+test('login openai --global validates Bearer auth and stores user scope',
+    async t => {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const server = await providerServer()
+        t.cleanup(() => server.close())
+        simulateTerminals(t, true)
+        captureBrowser(t)
+        const key = 'sk-openai-A1B2C3D4E5'
+        const result = await runRoast(['login', 'openai', '--global'], {
+            cwd:repo.dir,
+            env:repo.env,
+            stdin:key + '\n',
+            redirectTo:server.url,
+        })
+        t.equal(result.code, 0, 'login succeeds')
+        const user = path.join(repo.env.XDG_CONFIG_HOME, 'roast',
+            'credentials.json')
+        t.equal((await loadCredentials(user)).get('openai')?.key, key,
+            'user file contains the key')
+        t.ok(!fs.existsSync(path.join(repo.dir, '.git', 'roast',
+            'credentials.json')), 'no project file')
+        t.deepEqual(server.credentials, [`Bearer ${key}`],
+            'validation uses Bearer authorization')
+        t.equal(server.requests[0]?.method, 'GET', 'GET check')
+        t.equal(server.requests[0]?.path, '/v1/models', 'models check')
+    })
+
+test('login anthropic stores a trimmed project key privately', async t => {
+    const repo = tempRepo()
+    t.cleanup(repo.remove)
+    const server = await providerServer()
+    t.cleanup(() => server.close())
+    simulateTerminals(t, true)
+    captureBrowser(t)
+    const key = 'sk-ant-Q7W8E9R0T1Y2'
+    const result = await runRoast(['login', 'anthropic'], {
+        cwd:repo.dir,
+        env:repo.env,
+        stdin:`  ${key}  \n`,
+        redirectTo:server.url,
+    })
+    t.equal(result.code, 0, 'login succeeds')
+    const file = path.join(repo.dir, '.git', 'roast', 'credentials.json')
+    t.equal((await loadCredentials(file)).get('anthropic')?.key, key,
+        'trimmed key is stored')
+    t.equal(fs.statSync(file).mode & 0o777, 0o600, 'private file')
+    t.equal(fs.statSync(path.dirname(file)).mode & 0o777, 0o700,
+        'private directory')
+    t.deepEqual(server.credentials, [key], 'validation carries the key')
+    t.deepEqual(result.hosts, ['api.anthropic.com'], 'built-in endpoint')
+})
+
+test('login opens the key page, tolerates opener failure, or skips it',
+    async t => {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const server = await providerServer()
+        t.cleanup(() => server.close())
+        simulateTerminals(t, true)
+        const opened = captureBrowser(t, new Error('no browser available'))
+        for (const noBrowser of [false, true]) {
+            const result = await runRoast([
+                'login', 'openai', ...(noBrowser ? ['--no-browser'] : []),
+            ], {
+                cwd:repo.dir,
+                env:repo.env,
+                stdin:'sk-browser-U9I8O7P6\n',
+                redirectTo:server.url,
+            })
+            t.equal(result.code, 0, 'login succeeds despite opener failure')
+        }
+        t.deepEqual(opened, ['https://platform.openai.com/api-keys'],
+            'only the browser-enabled login opens the exact key page')
+    })
