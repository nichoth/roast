tring;\n    // Already composed by the agent loop (caller, deadline, timeout).\n    signal:AbortSignal;\n    onUsage?:(usage:Usage) => void;\n}\n\nexport type FinishReason =\n    'stop'|'length'|'content-filter'|'tool-calls'|'error'|'other'|'unknown'\n\nexport interface ModelTurn {\n    // Arrival order; replayed verbatim.\n    parts:AssistantPart[];\n    finishReason:FinishReason;\n    rawFinishReason?:string;\n    // Normalized, calls: 1.\n    usage:Usage;\n}\n\n// Progress report for one dispatched exploration or record call, or a\n// call to an unknown tool (spec 07, 2.10).\nexport interface TurnInfo {\n    turn:number;\n    tool:string;\n    args:Record<string, unknown>;\n}\n\n// Type validation of the final arguments (spec 07, 2.7). `decode`\n// receives the value parsed with integer preservation (unsafe integers\n// are `bigint`) and the original argument text for lexical checks, and\n// throws an Error whose message is the detail.\nexport interface FinalSpec<T> {\n    decode (value:unknown, rawText?:string):T;\n}\n\nexport interface ConverseOptions<T> {\n    // Exploration, record, and final tools, in order.\n    tools:readonly Tool[];\n    finalTool:string;\n    final:FinalSpec<T>;\n    // Turn at which the final phase starts; <= 0 means 8.\n    maxTurns?:number;\n    onTurn?:(info:TurnInfo) => void;\n    // <= 0 means 3e6.\n    inputByteCeiling?:number;\n    // Absolute time, ms since the epoch.\n    workDeadline?:number;\n    // ms; <= 0 means 90000.\n    wrapUpWindow?:number;\n    onWorkDeadline?:() => void;\n    onBudgetExhausted?:() => void;\n}\n\n// Usage as written into run records: snake_case, disjoint counts.\nexport interface RecordUsage {\n    uncached_input_tokens:number;\n    cached_input_tokens:number;\n    cache_write_tokens:number;\n    output_tokens:number;\n    calls:number;\n}\n\n// One configured model role, as the finder and verifier call it.\nexport interface Client {\n    // The request model name.\n    readonly name:string;\n    converse<T> (\n        system:string,\n        user:string,\n        opts:ConverseOptions<T>,\n        signal:AbortSignal\n    ):Promise<T>;\n    completeStructured<T> (\n        system:string,\n        user:string,\n        schemaName:string,\n        result:{ schema:Record<string, unknown>, decode:FinalSpec<T>['decode'] },\n        signal:AbortSignal\n    ):Promise<T>;\n    usage ():RecordUsage;\n}\n                        })\n                }\n                throw err\n            }\n        },\n    }\n}\n\nexport interface CreateClientOptions {\n    // The run's shared ledger; none means unlimited.\n    ledger?:Ledger|null;\n    now?:() => number;\n    sleep?:Sleep;\n    sessionId?:() => string;\n}\n\nfunction recordUsage (u:Usage):RecordUsage {\n    return {\n        uncached_input_tokens:u.uncachedInputTokens,\n        cached_input_tokens:u.cachedInputTokens,\n        cache_write_tokens:u.cacheWriteTokens,\n        output_tokens:u.outputTokens,\n        calls:u.calls,\n    }\n}\n\n// The `Client` the finder and verifier call (spec 07, 3.3): both entry\n// points run the agent loop over `model`; usage accumulates across all\n// of this client's conversations.\nexport function createClient (\n    model:ModelClient,\n    opts:CreateClientOptions = {}\n):Client {\n    const total = new UsageAccumulator()\n    const deps:LoopDeps = {\n        client:model,\n        model:model.config.model,\n        maxOutputTokens:model.config.maxOutputTokens,\n        maxAttempts:model.maxAttempts > 0 ?\n            model.maxAttempts :\n            DEFAULT_MAX_ATTEMPTS,\n        ledger:opts.ledger ?? null,\n        addUsage:u => total.add(u),\n        now:opts.now,\n        sleep:opts.sleep,\n        sessionId:opts.sessionId,\n    }\n    return {\n        name:model.config.model,\n        converse (system, user, converseOpts, signal) {\n            return runConversation(deps, system, user, converseOpts, false,\n                signal)\n        },\n        completeStructured (system, user, schemaName, result, signal) {\n            return runConversation(deps, system, user, {\n                tools:[{\n                    name:schemaName,\n                    description:'Return the requested structured result.',\n                    schema:result.schema,\n                }],\n                finalTool:schemaName,\n                final:{ decode:result.decode },\n                maxTurns:1,\n            }, true, signal)\n        },\n        usage () {\n            return recordUsage(total.total())\n        },\n    }\n}\n// pattern: Functional Core\n\nimport { formatFixed2 } from '../gocompat/strings.js'\n\n/** Inputs for the diff or repository-survey finder user message. */\nexport type FinderUserVars = {\n    task:string;\n    survey:boolean;\n    diff:string;\n    fileContext:string;\n    manifest:string;\n}\n\n/** Finder reasoning is deliberately excluded to avoid anchoring. */\nexport type VerifierVars = {\n    severity:string;\n    confidence:number;\n    file:string;\n    lines:string;\n    description:string;\n    codeQuote:string;\n    fixedCode:string;\n    fileSnippet:string;\n}\n\n/** Render finder_user.tmpl, inserting the supplied data verbatim. */\nexport function renderFinderUser (v:Readonly<FinderUserVars>):string {\n    const body = v.survey ? [\n        '## Repository under review (MANIFEST \\u2014 the map, ' +\n            'not the contents)',\n        '',\n        'The repository contents are not inline below. ' +\n            'Use the local tools to inspect relevant files.',\n        '',\n        '<manifest>',\n        v.manifest,\n        '</manifest>',\n        '',\n        'Every finding must include `code_quote` copied verbatim ' +\n            'from code retrieved through the tools and a concrete ' +\n            '`fixed_code` replacement.',\n    ] : [\n        '## Changes under review',\n        '',\n        '<diff>',\n        v.diff,\n        '</diff>',\n        '',\n        '## Files touched (full current contents,