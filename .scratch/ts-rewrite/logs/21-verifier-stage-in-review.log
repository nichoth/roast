n        for (const interactive of [false, true]) {\n            const h = harness([call(interactive ?\n                'submit_findings' : 'findings', {\n                assessment:'NO_FINDINGS',\n                findings:[wire({ severity:'low' }),\n                    wire({ file:'b.ts', fixed_code:'' })],\n            })])\n            const r = await find(h.client, input({ interactive }), signal())\n            t.equal(r.assessment, 'FINDINGS_PRESENT')\n            t.equal(r.findings[0].severity, 'LOW')\n            t.equal(r.dropped[0]._drop_reason, 'missing_fixed_code')\n            t.ok(!r.incomplete)\n            t.equal(h.requests.length, 1)\n            t.equal(h.requests[0].system, 'sys')\n            t.deepEqual(h.requests[0].tools\n                .filter(tool => tool.name !== '__roast_continue')\n                .map(tool => tool.name),\n            interactive ? ['report_finding', 'submit_findings'] :\n                ['findings'])\n        }\n    })\n70:import './review/classify.js'\n95:import './review/types.js'\n96:import './review/validate.js'\n97:import './review/fingerprint.js'\n98:import './review/schema.js'\n99:import './review/find.js'\n100:import './review/find-http.js'\n111:import './cli/review.js'\n112:import './cli/review-flags.js'\n113:import './cli/review-config.js'\n114:import './cli/review-trust.js'\n115:import './cli/review-records.js'\n116:import './cli/review-errors.js'\n117:import './cli/review-units.js'","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019XhQTs7urMnHn1Vmr7PkFn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
