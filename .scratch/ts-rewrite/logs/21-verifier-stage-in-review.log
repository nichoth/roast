c writeReport(stdout, stderr io.Writer, f *reviewFlags, report render.Report) {\n\tif f.format == \"json\" || f.format == \"both\" {\n            }\n        } finally {\n            await fh.close()\n        }\n    } catch (err) {\n        return `### ${relpath}\\n(read error: ${message(err)})\\n`\n    }\n}\n\n// One file with real 1-indexed line numbers, middle-truncated to about\n// maxBytes so both ends stay visible. Problems render as a notice; only\n// an abort rejects.\nexport async function numberedSnippet (\n    repo:string,\n    relpath:string,\n    maxBytes:number,\n    tree:Tree,\n    opts:ContextOpts = {}\n):Promise<string> {\n    const invalid =\n        `### ${relpath}\\n(path is outside the repository or invalid)\\n`\n    if (pinned(tree)) {\n        if (!stagedPathCanonical(relpath)) return invalid\n    } else if ((await resolveLive(repo, relpath, opts)) === null) {\n        return invalid\n    }\n    const ceiling = 8 * maxBytes\n    const read = pinned(tree) ?\n        await readPinned(repo, relpath, ceiling, tree, opts) :\n        await readLive(repo, relpath, ceiling)\n    opts.signal?.throwIfAborted()\n    if (typeof read === 'string') return read\n    const { content } = read\n    const lines = splitLines(content)\n\n    if (content.length <= maxBytes) {\n210:\t\t\tReasoning:  fmt.Sprintf(\"verifier did not reach a verdict: %v\", err),","is_error":false}]},"parent_tool_use_id":null,"session_id":"ecb2be46-319d-4607-acba-e6c06893d41b","uuid":"e3433a43-0b85-4c45-9e02-475d64a05c67","timestamp":"2026-11-24T01:51:00.583Z","tool_use_result":{"stdout":"- Short: \"Adversarial cross-model code review\". Long: \"A finder proposes\n  potential defects, then an independent verifier adjudicates each claim\n  against the local checkout.\" Help text need not match cobra exactly, but\n  root help must describe the tool.\n- Takes every `review` flag (section 2.6) and no positional arguments.\n  A positional argument, including an unknown subcommand name such as\