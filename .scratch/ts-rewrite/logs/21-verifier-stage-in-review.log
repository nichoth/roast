   role:'finder',\n        baseUrl:'http://fake.invalid',\n        apiKey:'sk-test',\n        model:'fake-model',\n        protocol:'chat',\n        maxOutputTokens:100,\n        maxAttempts:4,\n        requestTimeoutMs:0,\n        ...over,\n    }\n    const requests:Recorded[] = []\n    const model:ModelClient = {\n        config,\n        protocol:'chat',\n        maxAttempts:config.maxAttempts > 0 ? config.maxAttempts : 4,\n        requestBytes:() => 100,\n        usage:zeroUsage,\n        async send (req:ModelRequest):Promise<ModelTurn> {\n            const n = requests.length\n            requests.push({\n                system:req.system,\n                items:structuredClone(req.items),\n                tools:structuredClone(req.tools),\n                sessionId:req.sessionId,\n                signal:req.signal,\n                abortedAtSend:req.signal.aborted,\n            })\n            let step:Step|undefined\n            if (typeof script === 'function' && !Array.isArray(script)) {\n                step = script(req, n)\n            } else {\n                step = script[n]\n            }\n            if (step === undefined) throw new Error(`script exhausted at ${n}`)\n            if (step instanceof Error) throw step\n7:export function isGoSpace (cp:number):boolean {\n19:export function goTrimSpace (s:string):string {\n30:export function goExt (path:string):string {\n47:export function truncateUtf8 (s:string, maxBytes:number):string {\n62:export function formatFixed2 (x:number):string {\n75:export function compareBytes (a:string, b:string):number {\n106:export function goQuote (s:string):string {\n116:export function text (s:string):string {\n122:export function line (s:string):string {\n128:export function textBytes (b:Uint8Array):string {\n133:export function lineBytes (b:Uint8Array):string {","is_error":false}]},"parent_tool_use_id":null,"session_id":"ecb2be46-319d-4607-acba-e6c06893d41b","uuid":"659a6fc1-80ae-457b-bb17-3f8e2a25412d","timestamp":