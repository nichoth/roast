ifferences no allowlist entry explains.\nexport function unexplained (\n    scenario:string,\n    diffs:readonly Difference[],\n    entries:readonly AllowEntry[] = ALLOWLIST\n):Difference[] {\n    return diffs.filter(d => !entries.some(e => applies(e, scenario, d)))\n}\n","structuredPatch":[{"oldStart":14,"oldLines":7,"newStart":14,"newLines":15,"lines":["     reason:string;"," }"," ","-export const ALLOWLIST:readonly AllowEntry[] = []","+export const ALLOWLIST:readonly AllowEntry[] = [","+    {","+        change:7,","+        scenario:/^(gate settings|trust --yes): field name in another case$/,","+        path:/^(exit|stdout\\..+)$/,","+        reason:'Go matches \"Gate\" to the gate field case-insensitively and ' +","+            'succeeds; TS rejects it as an unknown field (exit 2)',","+    },","+]"," "," function applies (entry:AllowEntry, scenario:string, d:Difference):boolean {","     const s = entry.scenario"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_019EPQRosmobPY4Vq3i2eNr1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
