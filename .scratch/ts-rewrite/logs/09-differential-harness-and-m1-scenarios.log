{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NUXFEru3qEdRpRA11qMxjg","type":"tool_result","content":"21:\t\tnewGateSettingsCommand(stdout))\n31:// newGateSettingsCommand prints the project config's gate settings as\n33:// binary so the settings come from the same Roast version as the review.\n34:func newGateSettingsCommand(stdout io.Writer) *cobra.Command {\n37:\t\tUse: \"settings\", Short: \"Print the gate settings the pre-commit hook uses\",\npackage cli\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/bluesky-social/roast/internal/config\"\n\t\"github.com/bluesky-social/roast/internal/scope\"\n\t\"github.com/bluesky-social/roast/internal/textsafe\"\n\t\"github.com/bluesky-social/roast/internal/trust\"\n\t\"github.com/spf13/cobra\"\n)\n\n// errUntrusted is returned by a review whose project config needs approval\n// that this clone has not given. It is a usage error, so its exit code is\n// never ExitFindings and the gate allows the commit.\nvar errUntrusted = &usageError{msg: \"the project config names endpoints, \" +\n\t\"credential variables, or prompt files that are not approved for this \" +\n\t\"clone; review and approve them with `npx roast trust`\"}\n\n// requireTrust fails unless cfg needs no approval or the repository\n// containing dir has approved its projection. When stdin and stderr are both\n// terminals it shows the trust summary on stderr and asks; only \"y\" records\n// approval. It makes no network request.\nfunc requireTrust(dir string, cfg config.Config, stdin io.Reader,\n\tstderr io.Writer) error {\n\tprojection := cfg.TrustProjection()\n\tif !projection.RequiresApproval() {\n\t\treturn nil\n\t}\n\tok, err := trust.Approved(dir, projection.Hash())\n\tif err != nil {\n\t\treturn err\n\t}\n\tif ok {\n\t\treturn nil\n\t}\n\tif !interactiveTerminals(stdin, stderr) {\n\t\treturn errUntrusted\n\t}\n\twriteTrustSummary(stderr, projection)\n\tok, err = promptNoDefault(stderr, stdin, \"Trust this project config?\")\n\tif err != nil {\n\t\treturn err\n\t}\n\tif !ok {\n\t\treturn &usageError{msg: \"project config not approved; nothing \" +\n\t\t\t\"recorded and nothing sent\"}\n\t}\n\tif err := trust.Approve(dir, projection.Hash()); err != nil {\n\t\treturn err\n\t}\n\tfmt.Fprintln(stderr, \"Approved for this clone.\")\n\treturn nil\n}\n\n// writeTrustSummary prints every security-relevant value of the projection,\n// with control characters escaped.\nfunc writeTrustSummary(w io.Writer, projection config.TrustProjection) {\n\tfmt.Fprintln(w, \"This project config sends code and credentials to:\")\n\tfor _, profile := range projection.Profiles {\n\t\tcredential := profile.CredentialEnv\n\t\tif credential == \"\" {\n\t\t\tcredential = \"(none named)\"\n\t\t}\n\t\tfmt.Fprintf(w, \"  %s: profile %s\\n\", textsafe.Line(profile.Selector),\n\t\t\ttextsafe.Line(profile.Profile))\n\t\tfmt.Fprintf(w, \"    endpoint:   %s\\n\", textsafe.Line(profile.Endpoint))\n\t\tfmt.Fprintf(w, \"    protocol:   %s\\n\", textsafe.Line(profile.Protocol))\n\t\tfmt.Fprintf(w, \"    credential: %s\\n\", textsafe.Line(credential))\n\t}\n\tif len(projection.PromptOverrides) > 0 {\n\t\tfmt.Fprintln(w, \"and replaces prompts with these files:\")\n\t\tfor _, prompt := range projection.PromptOverrides {\n\t\t\tfmt.Fprintf(w, \"  %s: %s\\n\", textsafe.Line(prompt.Name),\n\t\t\t\ttextsafe.Line(prompt.Path))\n\t\t}\n\t}\n60:// Role selects an inference profile. The finder may route away from the\n62:type Role struct {\n64:\t// Pin keeps this role selected even when it belongs to the same model\n71:// ResolvedRole is the complete, runtime-ready role. APIKey is secret and must\n73:type ResolvedRole struct {\n103:\tCredentialRoleEnv     = \"role_env\"\n110:// CredentialSource describes where a role's credential came from without\n121:\t// because the role's endpoint is not that provider's own endpoint.\n127:\tcase CredentialRoleEnv:\n128:\t\treturn s.Env + \" (role override)\"\n221:\tRoles             map[string]Role             `json:\"roles\"`\n231:\t// stored supplies stored credentials to ResolveRole; nil means none.\n235:// WithStoredCredentials returns c resolving roles with stored credentials\n393:\tif cfg.Roles == nil {\n394:\t\tcfg.Roles = map[string]Role{}\n403:\tfor name, role := range cfg.Roles {\n405:\t\t\treturn Config{}, fmt.Errorf(\"roles.%s is not a role (finder or verifier)\", name)\n407:\t\tif role.Profile == \"\" {\n408:\t\t\treturn Config{}, fmt.Errorf(\"roles.%s.profile is required\", name)\n410:\t\tif _, ok := cfg.InferenceProfiles[role.Profile]; !ok {\n411:\t\t\treturn Config{}, fmt.Errorf(\"roles.%s.profile references unknown inference profile %q\", name, role.Profile)\n413:\t\tnormalizedRoutes := make(map[string]string, len(role.AuthorRoutes))\n414:\t\tfor family, profileName := range role.AuthorRoutes {\n417:\t\t\t\treturn Config{}, fmt.Errorf(\"roles.%s.author_routes contains empty model family\", name)\n420:\t\t\t\treturn Config{}, fmt.Errorf(\"roles.%s.author_routes.%s references unknown inference profile %q\", name, family, profileName)\n423:\t\t\t\treturn Config{}, fmt.Errorf(\"roles.%s.author_routes contains duplicate family %q\", name, family)\n427:\t\trole.AuthorRoutes = normalizedRoutes\n428:\t\tcfg.Roles[name] = role\n576:// obtains its credential when selected for role.\n577:func (p InferenceProfile) DescribeCredential(role string) string {\n578:\troleVar := roleEnvPrefix(role) + \"API_KEY\"\n593:\t\t\tprovider.KeyEnv, provider.Name, roleVar)\n595:\t\treturn \"none named; set \" + roleVar\n599:// ResolveRole expands a role selection into the complete runtime role.\n602:// ROAST_<ROLE>_API_KEY; the profile's api_key_env; the built-in provider's\n605:// user-scope stored credential. The last three apply only when the role is\n609:func (c Config) ResolveRole(name string) (ResolvedRole, error) {\n610:\tselection, ok := c.Roles[name]\n612:\t\treturn ResolvedRole{}, fmt.Errorf(\"role %q is not configured\", name)\n617:func (c