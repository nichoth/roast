{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChB3Wfwx9nqepSd461HBB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011wFZBc7t79EjxLFxi5GU2o","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-09-differential-harness-and-m1-scenarios/test/diff/fixture.ts","content":"// Fixture repositories and the scrubbed environment each CLI runs in\n// (spec 15, 2.13). Both sides' repositories come from the same function\n// with fixed contents, identity, and dates, so their commit IDs match.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\n\nconst SCRUBBED_PREFIXES = [\n    'ROAST_', 'OPENAI_', 'OPENROUTER_', 'ANTHROPIC_', 'GIT_',\n]\nconst FIXED_DATE = '2026-01-02T03:04:05Z'\n\n// The process environment without provider, Roast, debug, or Git\n// variables, with a private HOME and XDG_CONFIG_HOME under `home`, a\n// fixed Git identity and dates, and no Git config outside the fixture.\nexport function scrubbedEnv (\n    base:Readonly<Record<string, string|undefined>>,\n    home:string\n):Record<string, string> {\n    const env:Record<string, string> = {}\n    for (const [key, value] of Object.entries(base)) {\n        if (value === undefined) continue\n        const upper = key.toUpperCase()\n        if (upper === 'DEBUG') continue\n        if (SCRUBBED_PREFIXES.some(p => upper.startsWith(p))) continue\n        env[key] = value\n    }\n    fs.mkdirSync(home, { recursive:true })\n    const gitconfig = path.join(home, '.gitconfig')\n    fs.writeFileSync(gitconfig, '')\n    return {\n        ...env,\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_CONFIG_GLOBAL:gitconfig,\n        GIT_CEILING_DIRECTORIES:path.dirname(home),\n        GIT_AUTHOR_NAME:'Roast Diff',\n        GIT_AUTHOR_EMAIL:'roast-diff@example.com',\n        GIT_COMMITTER_NAME:'Roast Diff',\n        GIT_COMMITTER_EMAIL:'roast-diff@example.com',\n        GIT_AUTHOR_DATE:FIXED_DATE,\n        GIT_COMMITTER_DATE:FIXED_DATE,\n    }\n}\n\n// A Git repository at `dir` holding `files` in one commit. Returns the\n// commit ID.\nexport function buildFixture (\n    dir:string,\n    files:Readonly<Record<string, string>>,\n    env:Record<string, string>\n):string {\n    const git = (args:string[]) => execFileSync('git', ['-C', dir, ...args],\n        { env, encoding:'utf8', stdio:['ignore', 'pipe', 'pipe'] })\n    fs.mkdirSync(dir, { recursive:true })\n    git(['init', '-q', '-b', 'main'])\n    for (const [name, text] of Object.entries(files)) {\n        const file = path.join(dir, name)\n        fs.mkdirSync(path.dirname(file), { recursive:true })\n        fs.writeFileSync(file, text)\n    }\n    git(['add', '-A'])\n    git(['commit', '-q', '--allow-empty', '-m', 'fixture'])\n    return git(['rev-parse', 'HEAD']).trim()\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":522,"cache_read_input_tokens":131925,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":522},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c00c7f3-71f4-4751-b678-7052dcc92742","uuid":"3ca64d5b-97f8-4578-a4a8-357c187f722d","timestamp":"2026-11-18T20:43:47.821Z","request_id":"req_011ChB3Wfhox5tJ4G7P6Putt","wire_tool_inputs":{"toolu_011wFZBc7t79EjxLFxi5GU2o":{"file_path":"/Users/nick/code/roast.ts-rewrite-09-differential-harness-and-m1-scenarios/test/diff/fixture.ts","content":"// Fixture repositories and the scrubbed environment each CLI runs in\n// (spec 15, 2.13). Both sides' repositories come from the same function\n// with fixed contents, identity, and dates, so their commit IDs match.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport path from 'node:path'\n\nconst SCRUBBED_PREFIXES = [\n    'ROAST_', 'OPENAI_', 'OPENROUTER_', 'ANTHROPIC_', 'GIT_',\n]\nconst FIXED_DATE = '2026-01-02T03:04:05Z'\n\n// The process environment without provider, Roast, debug, or Git\n// variables, with a private HOME and XDG_CONFIG_HOME under `home`, a\n// fixed Git identity and dates, and no Git config outside the fixture.\nexport function scrubbedEnv (\n    base:Readonly<Record<string, string|undefined>>,\n    home:string\n):Record<string, string> {\n    const env:Record<string, string> = {}\n    for (const [key, value] of Object.entries(base)) {\n        if (value === undefined) continue\n        const upper = key.toUpperCase()\n        if (upper === 'DEBUG') continue\n        if (SCRUBBED_PREFIXES.some(p => upper.startsWith(p))) continue\n        env[key] = value\n    }\n    fs.mkdirSync(home, { recursive:true })\n    const gitconfig = path.join(home, '.gitconfig')\n    fs.writeFileSync(gitconfig, '')\n    return {\n        ...env,\n        HOME:home,\n        XDG_CONFIG_HOME:path.join(home, '.config'),\n        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_CONFIG_GLOBAL:gitconfig,\n        GIT_CEILING_DIRECTORIES:path.dirname(home),\n        GIT_AUTHOR_NAME:'Roast Diff',\n        GIT_AUTHOR_EMAIL:'roast-diff@example.com',\n        GIT_COMMITTER_NAME:'Roast Diff',\n        GIT_COMMITTER_EMAIL:'roast-diff@example.com',\n        GIT_AUTHOR_DATE:FIXED_DATE,\n        GIT_COMMITTER_DATE:FIXED_DATE,\n    }\n}\n\n// A Git repository at `dir` holding `files` in one commit. Returns the\n// commit ID.\nexport function buildFixture (\n    dir:string,\n    files:Readonly<Record<string, string>>,\n    env:Record<string, string>\n):string {\n    const git = (args:string[]) => execFileSync('git', ['-C', dir, ...args],\n        { env, encoding:'utf8', stdio:['ignore', 'pipe', 'pipe'] })\n    fs.mkdirSync(dir, { recursive:true })\n    git(['init', '-q', '-b', 'main'])\n    for (const [name, text] of Object.entries(files)) {\n        const file = path.join(dir, name)\n        fs.mkdirSync(path.dirname(file), { recursive:true })\n        fs.writeFileSync(file, text)\n    }\n    git(['add', '-A'])\n    git(['commit', '-q', '--allow-empty', '-m', 'fixture'])\n    return git(['rev-parse', 'HEAD']).trim()\n}\n"}}}
