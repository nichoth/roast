(home, '.config'),\n        CLAUDE_CONFIG_DIR:path.join(home, '.claude'),\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_CONFIG_GLOBAL:gitconfig,\n        GIT_CEILING_DIRECTORIES:path.dirname(home),\n        GIT_AUTHOR_NAME:'Roast Diff',\n        GIT_AUTHOR_EMAIL:'roast-diff@example.com',\n        GIT_COMMITTER_NAME:'Roast Diff',\n        GIT_COMMITTER_EMAIL:'roast-diff@example.com',\n        GIT_AUTHOR_DATE:FIXED_DATE,\n        GIT_COMMITTER_DATE:FIXED_DATE,\n    }\n}\n\n// A Git repository at `dir` holding `files` in one commit. Returns the\n// commit ID.\nexport function buildFixture (\n    dir:string,\n    files:Readonly<Record<string, string>>,\n    env:Record<string, string>\n):string {\n    const git = (args:string[]) => execFileSync('git', ['-C', dir, ...args],\n        { env, encoding:'utf8', stdio:['ignore', 'pipe', 'pipe'] })\n    fs.mkdirSync(dir, { recursive:true })\n    git(['init', '-q', '-b', 'main'])\n    for (const [name, text] of Object.entries(files)) {\n        const file = path.join(dir, name)\n        fs.mkdirSync(path.dirname(file), { recursive:true })\n        fs.writeFileSync(file, text)\n    }\n    git(['add', '-A'])\n    git(['commit', '-q', '--allow-empty', '-m', 'fixture'])\n    return git(['rev-parse', 'HEAD']).trim()\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_011wFZBc7t79EjxLFxi5GU2o","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChB3Wfwx9nqepSd461HBB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Qi8LjVpRETxJpvrTpXCpPg","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-09-differential-harness-and-m1-scenarios/test/diff/scenario.ts","content":"// Runs one scenario on both CLIs and lists the differences (spec 15,\n// 2.13). Compared: exit codes (also of the `trust --yes` step), stdout\n// when the scenario declares a structured format, run records and\n// requests when the scenario asks. Never compared: stderr, help text,\n// rendered Markdown, trust messages, trust.json, debug output.\nimport { spawn } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport type {\n    InferenceServer,\n    RecordedRequest,\n} from '../helpers/inference-server.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport { unexplained } from './allowlist.js'\nimport {\n    type Difference,\n    deepDiff,\n    parseJsonOutput,\n    parseKeyValues,\n} from './compare.js'\nimport { buildFixture, scrubbedEnv } from './fixture.js'\nimport { type NormalizeContext, normalize } from './normalize.js'\nimport { type Decoded, compareRecords, readRecords } from './records.js'\nimport { compareRequests } from './requests.js'\n\nexport interface Cli {\n    name:string;\n    command:string;\n    args:string[];\n}\n\nexport const TS_CLI:Cli = {\n    name:'ts',\n    command:process.execPath,\n    args:[path.join(ROOT, 'dist', 'cli.js')],\n}\n\nexport function goCli (binary:string):Cli {\n    return { name:'go', command:binary, args:[] }\n}\n\nexport interface ScenarioContext {\n    // The fake inference server's URL; '' without a server.\n    url:string;\n}\n\nexport interface Scenario {\n    name:string;\n    // Committed fixture contents, by repository-relative path.\n    files:Readonly<Record<string, string>>|\n        ((ctx:ScenarioContext) => Record<string, string>);\n    // Repository-relative working directory; the toplevel by default.\n    cwd?:string;\n    // Arguments of an approval step (`trust --yes ...`) run first.\n    trust?:string[];\n    argv:string[];\n    // How stdout is compared; not at all when unset.\n    stdout?:'json'|'kv';\n    // Extra environment, set after scrubbing (credential variables).\n    env?:(ctx:ScenarioContext) => Record<string, string>;\n    // Starts the fake inference server shared by both CLIs.\n    server?:() => Promise<InferenceServer>;\n    records?:boolean;\n    requests?:boolean;\n}\n\nexport interface CliRun {\n    trustExit?:number|string;\n    exit:number|string;\n    stdout:string;\n    stderr:string;\n    records:Map<string, Decoded>;\n    requests:RecordedRequest[];\n    ctx:NormalizeContext;\n}\n\nexport interface ScenarioResult {\n    diffs:Difference[];\n    unexplained:Difference[];\n    go:CliRun;\n    ts:CliRun;\n}\n\nconst RUN_TIMEOUT_MS = 120_000\n\ninterface Exec {\n    exit:number|string;\n    stdout:string;\n    stderr:string;\n}\n\nfunction exec (\n    cli:Cli,\n    argv:string[],\n    cwd:string,\n    env:Record<string, string>\n):Promise<Exec> {\n    return new Promise((resolve, reject) => {\n        const child = spawn(cli.command, [...cli.args, ...argv], {\n            cwd,\n            env,\n            stdio:['ignore', 'pipe', 'pipe'],\n        })\n        let stdout = ''\n        let stderr = ''\n        let timedOut = false\n        const timer = setTimeout(() => {\n            timedOut = true\n            child.kill('SIGKILL')\n        }, RUN_TIMEOUT_MS)\n        child.stdout.setEncoding('utf8')\n        child.stderr.setEncoding('utf8')\n        child.stdout.on('data', chunk => { stdout += chunk })\n        child.stderr.on('data', chunk => { stderr += chunk })\n        child.on('error', err => {\n            clearTimeout(timer)\n            reject(err)\n        })\n        child.on('close', (code, signal) => {\n            clearTimeout(timer)\n            const exit = timedOut ?\n                'timeout' :\n                code ?? `signal ${signal ?? 'unknown'}`\n            resolve({ exit, stdout, stderr })\n        })\n    })\n}\n\nasync function runSide (\n    cli:Cli,\n    s:Scenario,\n    root:string,\n    server:InferenceServer|undefined\n):Promise<CliRun> {\n    const side = path.join(root, cli.name)\n    const repo = path.join(side, 'repo')\n    const home = path.join(side, 'home')\n    const sctx:ScenarioContext = { url:server?.url ?? '' }\n    const env = { ...scrubbedEnv(process.env, home), ...s.env?.(sctx) }\n    const files = typeof s.files === 'function' ? s.files(sctx) : s.files\n    buildFixture(repo, files, env)\n    const cwd = path.join(repo, s.cwd ?? '')\n    const before = server?.requests.length ?? 0\n    let trustExit:number|string|undefined\n    if (s.trust) trustExit = (await exec(cli, s.trust, cwd, env)).exit\n    const r = await exec(cli, s.argv, cwd, env)\n    return {\n        trustExit,\n        exit:r.exit,\n        stdout:r.stdout,\n        stderr:r.stderr,\n        records:s.records ? readRecords(repo) : new Map(),\n        requests:server?.requests.slice(before) ?? [],\n        ctx:{ paths:[repo, home] },\n    }\n}\n\nfunction parseStdout (\n    format:'json'|'kv',\n    text:string,\n    ctx:NormalizeContext\n):unknown {\n    const parsed = format === 'json' ?\n        parseJsonOutput(text) :\n        parseKeyValues(text)\n    return normalize(parsed, ctx)\n}\n\nexport function compareRuns (s:Scenario, go:CliRun, ts:CliRun):Difference[] {\n    const out:Difference[] = []\n    if (go.trustExit !== ts.trustExit) {\n        out.push({ path:'trust.exit', go:go.trustExit, ts:ts.trustExit })\n    }\n    if (go.exit !== ts.exit) out.push({ path:'exit', go:go.exit, ts:ts.exit })\n    if (s.stdout) {\n        deepDiff(parseStdout(s.stdout, go.stdout, go.ctx),\n            parseStdout(s.stdout, ts.stdout, ts.ctx), 'stdout', out)\n    }\n    if (s.records) {\n        out.push(...compareRecords(go.records, ts.records, go.ctx, ts.ctx))\n    }\n    if (s.requests) {\n        out.push(...compareRequests(go.requests, ts.requests, go.ctx,\n            ts.ctx))\n    }\n    return out\n}\n\n// Runs `s` with `go` then `ts`, each in its own fixture repository and\n// home under one temporary directory, sharing one fake server.\nexport async function runScenario (\n    s:Scenario,\n    clis:{ go:Cli, ts:Cli }\n):Promise<ScenarioResult> {\n    const root = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-')))\n    const server = s.server ? await s.server() : undefined\n    try {\n        const go = await runSide({ ...clis.go, name:'go' }, s, root, server)\n        const ts = await runSide({ ...clis.ts, name:'ts' }, s, root, server)\n        const diffs = compareRuns(s, go, ts)\n        return { diffs, unexplained:unexplained(s.name, diffs), go, ts }\n    } finally {\n        await server?.close()\n        fs.rmSync(root, { recursive:true, force:true })\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":522,"cache_read_input_tokens":131925,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":522},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c00c7f3-71f4-4751-b678-7052dcc92742","uuid":"5c2ba42b-2c94-4458-80d7-8ea764fe9485","timestamp":"2026-11-18T20:44:07.108Z","request_id":"req_011ChB3Wfhox5tJ4G7P6Putt","wire_tool_inputs":{"toolu_01Qi8LjVpRETxJpvrTpXCpPg":{"file_path":"/Users/nick/code/roast.ts-rewrite-09-differential-harness-and-m1-scenarios/test/diff/scenario.ts","content":"// Runs one scenario on both CLIs and lists the differences (spec 15,\n// 2.13). Compared: exit codes (also of the `trust --yes` step), stdout\n// when the scenario declares a structured format, run records and\n// requests when the scenario asks. Never compared: stderr, help text,\n// rendered Markdown, trust messages, trust.json, debug output.\nimport { spawn } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport type {\n    InferenceServer,\n    RecordedRequest,\n} from '../helpers/inference-server.js'\nimport { ROOT } from '../helpers/spawn.js'\nimport { unexplained } from './allowlist.js'\nimport {\n    type Difference,\n    deepDiff,\n    parseJsonOutput,\n    parseKeyValues,\n} from './compare.js'\nimport { buildFixture, scrubbedEnv } from './fixture.js'\nimport { type NormalizeContext, normalize } from './normalize.js'\nimport { type Decoded, compareRecords, readRecords } from './records.js'\nimport { compareRequests } from './requests.js'\n\nexport interface Cli {\n    name:string;\n    command:string;\n    args:string[];\n}\n\nexport const TS_CLI:Cli = {\n    name:'ts',\n    command:process.execPath,\n    args:[path.join(ROOT, 'dist', 'cli.js')],\n}\n\nexport function goCli (binary:string):Cli {\n    return { name:'go', command:binary, args:[] }\n}\n\nexport interface ScenarioContext {\n    // The fake inference server's URL; '' without a server.\n    url:string;\n}\n\nexport interface Scenario {\n    name:string;\n    // Committed fixture contents, by repository-relative path.\n    files:Readonly<Record<string, string>>|\n        ((ctx:ScenarioContext) => Record<string, string>);\n    // Repository-relative working directory; the toplevel by default.\n    cwd?:string;\n    // Arguments of an approval step (`trust --yes ...`) run first.\n    trust?:string[];\n    argv:string[];\n    // How stdout is compared; not at all when unset.\n    stdout?:'json'|'kv';\n    // Extra environment, set after scrubbing (credential variables).\n    env?:(ctx:ScenarioContext) => Record<string, string>;\n    // Starts the fake inference server shared by both CLIs.\n    server?:() => Promise<InferenceServer>;\n    records?:boolean;\n    requests?:boolean;\n}\n\nexport interface CliRun {\n    trustExit?:number|string;\n    exit:number|string;\n    stdout:string;\n    stderr:string;\n    records:Map<string, Decoded>;\n    requests:RecordedRequest[];\n    ctx:NormalizeContext;\n}\n\nexport interface ScenarioResult {\n    diffs:Difference[];\n    unexplained:Difference[];\n    go:CliRun;\n    ts:CliRun;\n}\n\nconst RUN_TIMEOUT_MS = 120_000\n\ninterface Exec {\n    exit:number|string;\n    stdout:string;\n    stderr:string;\n}\n\nfunction exec (\n    cli:Cli,\n    argv:string[],\n    cwd:string,\n    env:Record<string, string>\n):Promise<Exec> {\n    return new Promise((resolve, reject) => {\n        const child = spawn(cli.command, [...cli.args, ...argv], {\n            cwd,\n            env,\n            stdio:['ignore', 'pipe', 'pipe'],\n        })\n        let stdout = ''\n        let stderr = ''\n        let timedOut = false\n        const timer = setTimeout(() => {\n            timedOut = true\n            child.kill('SIGKILL')\n        }, RUN_TIMEOUT_MS)\n        child.stdout.setEncoding('utf8')\n        child.stderr.setEncoding('utf8')\n        child.stdout.on('data', chunk => { stdout += chunk })\n        child.stderr.on('data', chunk => { stderr += chunk })\n        child.on('error', err => {\n            clearTimeout(timer)\n            reject(err)\n        })\n        child.on('close', (code, signal) => {\n            clearTimeout(timer)\n            const exit = timedOut ?\n                'timeout' :\n                code ?? `signal ${signal ?? 'unknown'}`\n            resolve({ exit, stdout, stderr })\n        })\n    })\n}\n\nasync function runSide (\n    cli:Cli,\n    s:Scenario,\n    root:string,\n    server:InferenceServer|undefined\n):Promise<CliRun> {\n    const side = path.join(root, cli.name)\n    const repo = path.join(side, 'repo')\n    const home = path.join(side, 'home')\n    const sctx:ScenarioContext = { url:server?.url ?? '' }\n    const env = { ...scrubbedEnv(process.env, home), ...s.env?.(sctx) }\n    const files = typeof s.files === 'function' ? s.files(sctx) : s.files\n    buildFixture(repo, files, env)\n    const cwd = path.join(repo, s.cwd ?? '')\n    const before = server?.requests.length ?? 0\n    let trustExit:number|string|undefined\n    if (s.trust) trustExit = (await exec(cli, s.trust, cwd, env)).exit\n    const r = await exec(cli, s.argv, cwd, env)\n    return {\n        trustExit,\n        exit:r.exit,\n        stdout:r.stdout,\n        stderr:r.stderr,\n        records:s.records ? readRecords(repo) : new Map(),\n        requests:server?.requests.slice(before) ?? [],\n        ctx:{ paths:[repo, home] },\n    }\n}\n\nfunction parseStdout (\n    format:'json'|'kv',\n    text:string,\n    ctx:NormalizeContext\n):unknown {\n    const parsed = format === 'json' ?\n        parseJsonOutput(text) :\n        parseKeyValues(text)\n    return normalize(parsed, ctx)\n}\n\nexport function compareRuns (s:Scenario, go:CliRun, ts:CliRun):Difference[] {\n    const out:Difference[] = []\n    if (go.trustExit !== ts.trustExit) {\n        out.push({ path:'trust.exit', go:go.trustExit, ts:ts.trustExit })\n    }\n    if (go.exit !== ts.exit) out.push({ path:'exit', go:go.exit, ts:ts.exit })\n    if (s.stdout) {\n        deepDiff(parseStdout(s.stdout, go.stdout, go.ctx),\n            parseStdout(s.stdout, ts.stdout, ts.ctx), 'stdout', out)\n    }\n    if (s.records) {\n        out.push(...compareRecords(go.records, ts.records, go.ctx, ts.ctx))\n    }\n    if (s.requests) {\n        out.push(...compareRequests(go.requests, ts.requests, go.ctx,\n            ts.ctx))\n    }\n    return out\n}\n\n// Runs `s` with `go` then `ts`, each in its own fixture repository and\n// home under one temporary directory, sharing one fake server.\nexport async function runScenario (\n    s:Scenario,\n    clis:{ go:Cli, ts:Cli }\n):Promise<ScenarioResult> {\n    const root = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-')))\n    const server = s.server ? await s.server() : undefined\n    try {\n        const go = await runSide({ ...clis.go, name:'go' }, s, root, server)\n        const ts = await runSide({ ...clis.ts, name:'ts' }, s, root, server)\n        const diffs = compareRuns(s, go, ts)\n        return { diffs, unexplained:unexplained(s.name, diffs), go, ts }\n    } finally {\n        await server?.close()\n        fs.rmSync(root, { recursive:true, force:true })\n    }\n}\n"}}}
