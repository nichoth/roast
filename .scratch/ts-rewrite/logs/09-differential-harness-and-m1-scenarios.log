ched.\nconst DURATION_KEY = /^(?:duration|elapsed)(?:_ms|_seconds)?$|_ms$/\n\nexport function normalizeString (s:string, ctx:NormalizeContext):string {\n    let out = s\n    const paths = [...ctx.paths].filter(p => p !== '')\n        .sort((a, b) => b.length - a.length)\n    for (const p of paths) out = out.split(p).join('<REPO>')\n    return out.replace(RUN_ID, '<RUN_ID>')\n        .replace(TIME, '<TIME>')\n        .replace(SESSION, '<SESSION>')\n}\n\nfunction isObject (v:unknown):v is Record<string, unknown> {\n    return typeof v === 'object' && v !== null && !Array.isArray(v) &&\n        !Buffer.isBuffer(v)\n}\n\n// A normalized deep copy of a parsed JSON value.\nexport function normalize (value:unknown, ctx:NormalizeContext):unknown {\n    if (typeof value === 'string') return normalizeString(value, ctx)\n    if (Array.isArray(value)) return value.map(v => normalize(v, ctx))\n    if (!isObject(value)) return value\n    const out:Record<string, unknown> = {}\n    for (const [key, v] of Object.entries(value)) {\n        const k = normalizeString(key, ctx)\n        if (DURATION_KEY.test(key) &&\n            (typeof v === 'number' || typeof v === 'string')) {\n            out[k] = '<DURATION>'\n        } else if (key === 'roast' && isObject(v)) {\n            out[k] = normalizeBuild(v, ctx)\n        } else {\n            out[k] = normalize(v, ctx)\n        }\n    }\n    return out\n}\n\n// `roast.version` / `roast.commit` identify the build, not the behavior.\nfunction normalizeBuild (\n    v:Record<string, unknown>,\n    ctx:NormalizeContext\n):Record<string, unknown> {\n    const out = normalize({ ...v, version:null, commit:null }, ctx) as\n        Record<string, unknown>\n    if ('version' in v) out.version = '<VERSION>'\n    else delete out.version\n    if ('commit' in v) out.commit = '<COMMIT>'\n    else delete out.commit\n    return out\n}\n","structuredPatch":[{"oldStart":57,"oldLines":11,"newStart":57,"newLines":8,"lines":["     v:Record<string, unknown>,",