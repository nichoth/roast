ue\n        if (name === 'content-type') out[name] = v\n        else if (name === 'authorization') out[name] = v.split(' ')[0]\n        else out[name] = '<present>'\n    }\n    return out\n}\n\nfunction view (req:RecordedRequest, ctx:NormalizeContext):unknown {\n    return normalize({\n        method:req.method,\n        path:req.path,\n        body:req.body === undefined ?\n            { '<raw>':req.rawBody.toString('utf8') } :\n            req.body,\n        headers:headerView(req),\n    }, ctx)\n}\n\nfunction groups (\n    reqs:RecordedRequest[],\n    ctx:NormalizeContext\n):Map<string, unknown[]> {\n    const out = new Map<string, unknown[]>()\n    for (const r of reqs) {\n        const key = groupKey(r)\n        const list = out.get(key) ?? []\n        list.push(view(r, ctx))\n        out.set(key, list)\n    }\n    for (const list of out.values()) {\n        list.sort((a, b) => {\n            const x = JSON.stringify(a)\n            const y = JSON.stringify(b)\n            return x < y ? -1 : x > y ? 1 : 0\n        })\n    }\n    return out\n}\n\nexport function compareRequests (\n    go:RecordedRequest[],\n    ts:RecordedRequest[],\n    goCtx:NormalizeContext,\n    tsCtx:NormalizeContext\n):Difference[] {\n    const a = groups(go, goCtx)\n    const b = groups(ts, tsCtx)\n    const out:Difference[] = []\n    for (const key of [...new Set([...a.keys(), ...b.keys()])].sort()) {\n        deepDiff(a.get(key) ?? [], b.get(key) ?? [], `requests[${key}]`, out)\n    }\n    return out\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5604,"cache_read_input_tokens":118861,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5604},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4c0