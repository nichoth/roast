{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012JShoAM35CPZ3og5edMKbk","type":"tool_result","content":"AGENTS.md\nCHANGELOG.md\ncmd/\nCONTEXT.md\nCONTRIBUTING.md\ndocs/\neslint.config.js\ngo.mod\ngo.sum\ninternal/\nLICENSE-APACHE.txt\nLICENSE-MIT.txt\nLICENSE.txt\nnode_modules/\npackage.json\npackages/\nREADME.md\nrenovate.json\nroast.schema.json\nscripts/\nSECURITY.md\nsrc/\ntest/\ntsconfig.build.json\ntsconfig.json\ntsconfig.launcher.json\n.scratch:\nts-rewrite/\n\nscripts:\nbuild.ts\nbundle.ts\ncheck-pack.ts\ncheck-package.ts\ncheck-release.ts\nesbuild-options.ts\neslint-ts6.ts\nlicenses_test.go\nlicenses.sh\nlicenses.ts\nplatforms.ts\nrelease.ts\nschema.ts\nversion.ts\n\ntest:\ncheck-pack.test.ts\ncli/\nconfig/\ncontext/\nfsutil/\ngate/\ngit/\ngocompat/\nhelpers/\nindex.ts\nlauncher.test.ts\nlive/\nllm/\nmanifest.test.ts\nprepublish.test.ts\nrelease-fixture.ts\nrelease.test.ts\nscope/\nskill/\nsnapshot/\ntextsafe/\ntooling/\ntrust/\nutil/\nversion.test.ts\n\ntest/helpers:\nenv.ts\ninference-server.ts\ninference-stream.ts\nrepo.ts\nrun.ts\nspawn.ts\nstreams.ts\nterminal.ts\ntest.ts\n{\n  \"name\": \"@substrate-system/roast\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Adversarial review\",\n  \"license\": \"(MIT OR Apache-2.0)\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"roast\": \"dist/launcher.js\"\n  },\n  \"files\": [\n    \"dist/\",\n    \"roast.schema.json\",\n    \"LICENSE.txt\",\n    \"LICENSE-MIT.txt\",\n    \"LICENSE-APACHE.txt\"\n  ],\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"devEngines\": {\n    \"runtime\": {\n      \"name\": \"node\",\n      \"version\": \">=22.18\"\n    }\n  },\n  \"scripts\": {\n    \"toc\": \"markdown-toc --maxdepth 3 -i README.md\",\n    \"lint\": \"node --import ./scripts/eslint-ts6.ts node_modules/eslint/bin/eslint.js src test scripts eslint.config.js --ignore-pattern 'src/launcher.ts' --ignore-pattern 'test/*.test.ts' --ignore-pattern 'test/release-fixture.ts' --ignore-pattern 'scripts/build.ts' --ignore-pattern 'scripts/check-pack.ts' --ignore-pattern 'scripts/check-release.ts' --ignore-pattern 'scripts/platforms.ts' --ignore-pattern 'scripts/release.ts' --ignore-pattern 'scripts/version.ts'\",\n    \"typecheck\": \"tsc -p tsconfig.json\",\n    \"build\": \"npm run schema && node scripts/build.ts\",\n    \"bundle\": \"npm run schema && node scripts/bundle.ts\",\n    \"schema\": \"node scripts/schema.ts\",\n    \"build:launcher\": \"tsc -p tsconfig.launcher.json\",\n    \"build:test\": \"node scripts/bundle.ts --test\",\n    \"test\": \"go test ./... && npm run build:launcher && node --test \\\"test/**/*.test.ts\\\"\",\n    \"test:tap\": \"bash -o pipefail -c 'node test/test-bundle.js | tap-spec'\",\n    \"test:ts\": \"npm run bundle && npm run build:test && npm run test:tap\",\n    \"test:live\": \"node scripts/bundle.ts --live && bash -o pipefail -c 'node test/live-bundle.js | tap-spec'\",\n    \"version\": \"npm run toc && node scripts/version.ts && git add README.md\",\n    \"prepublishOnly\": \"node scripts/check-release.ts\",\n    \"check:pack\": \"node scripts/check-pack.ts\",\n    \"release\": \"node scripts/release.ts\"\n  },\n  \"devDependencies\": {\n    \"@substrate-system/debug\": \"^0.9.64\",\n    \"@substrate-system/redeye\": \"^0.1.7\",\n    \"@substrate-system/tapzero\": \"^0.10.15\",\n    \"@types/node\": \"^22.18.0\",\n    \"@types/yargs\": \"^17.0.33\",\n    \"@typescript/typescript6\": \"^6.0.2\",\n    \"ajv\": \"^8.20.0\",\n    \"auto-changelog\": \"^2.4.0\",\n    \"esbuild\": \"^0.27.0\",\n    \"eslint\": \"^10.6.0\",\n    \"jsonc-parser\": \"^3.3.1\",\n    \"markdown-toc\": \"^1.2.0\",\n    \"newneostandard\": \"^0.14.1\",\n    \"tap-spec\": \"^5.0.0\",\n    \"typescript\": \"^7.0.2\",\n    \"typescript-eslint\": \"^8.62.0\",\n    \"yargs\": \"^18.2.0\",\n    \"zod\": \"^4.6.7\"\n  },\n  \"optionalDependencies\": {\n    \"@substrate-system/roast-darwin-arm64\": \"0.0.0\",\n    \"@substrate-system/roast-darwin-x64\": \"0.0.0\",\n    \"@substrate-system/roast-linux-arm64\": \"0.0.0\",\n    \"@substrate-system/roast-linux-x64\": \"0.0.0\",\n    \"@substrate-system/roast-win32-arm64\": \"0.0.0\",\n    \"@substrate-system/roast-win32-x64\": \"0.0.0\"\n  },\n  \"keywords\": [\n    \"AI\"\n  ],\n  \"homepage\": \"https://github.com/nichoth/roast#readme\",\n  \"bugs\": {\n    \"url\": \"https://github.com/nichoth/roast/issues\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/nichoth/roast.git\"\n  },\n  \"author\": \"nichoth\"\n}\nname: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n  workflow_dispatch: {}\n\npermissions: {}\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n\njobs:\n  quality:\n    name: Test and build\n    runs-on: ubuntu-26.04\n    timeout-minutes: 30\n    permissions:\n      contents: read\n    steps:\n      - name: Checkout\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Set up Go\n        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n        with:\n          go-version-file: go.mod\n          cache-dependency-path: |\n            go.sum\n            .github/tools/*/go.sum\n\n      - name: Set up Node\n        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 24\n\n      - name: Download dependencies\n        run: go mod download\n\n      - name: Check formatting\n        shell: bash\n        run: |\n          set -euo pipefail\n          unformatted=\"$(gofmt -l .)\"\n          if [[ -n \"${unformatted}\" ]]; then\n            echo \"${unformatted}\"\n            exit 1\n          fi\n\n      - name: Check module files\n        run: |\n          set -euo pipefail\n          go mod tidy\n          for modfile in .github/tools/*/go.mod; do\n            (cd \"${modfile%/*}\" && go mod tidy)\n          done\n          git diff --exit-code -- go.mod go.sum .github/tools\n          # git diff alone does not report a missing go.sum recreated by tidy.\n          test -z \"$(git ls-files --others --exclude-standard -- go.mod go.sum .github/tools)\"\n\n      - name: Check workflows and shell scripts\n        run: |\n          go tool -modfile=.github/tools/actionlint/go.mod actionlint\n          shellcheck scripts/*.sh\n\n      - name: Install npm dependencies\n        # .npmrc sets package-lock=false, so no lockfile is committed. Write\n        # one from package.json so npm ci can install from it.\n        run: |\n          npm install --package-lock-only --package-lock=true --no-audit --no-fund\n          npm ci --no-audit --no-fund\n\n      - name: Test\n        env:\n          # npm test runs go test ./...; keep the race detector in CI.\n          GOFLAGS: -race\n        run: npm test\n\n      - name: Vet\n        run: go vet ./...\n\n      - name: Staticcheck\n        # Keep the importer compatible with the compiler without adding\n        # CI-only tool dependencies to Roast's runtime module.\n        run: go tool -modfile=.github/tools/staticcheck/go.mod staticcheck ./...\n\n      - name: Build all platform packages\n        run: npm run build\n\n      - name: Check package contents\n        # Packs every package in dry-run mode; nothing is published.\n        run: npm run check:pack\n\n  typescript:\n    name: TypeScript (${{ matrix.os }}, Node ${{ matrix.node }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 30\n    permissions:\n      contents: read\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-26.04, macos-latest]\n        node: [22, 24]\n    steps:\n      - name: Checkout\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Set up Node\n        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: ${{ matrix.node }}\n\n      - name: Install npm dependencies\n        # .npmrc sets package-lock=false, so no lockfile is committed. Write\n        # one from package.json so npm ci can install from it.\n        run: |\n          npm install --package-lock-only --package-lock=true --no-audit --no-fund\n          npm ci --no-audit --no-fund\n\n      - name: Lint\n        run: npm run lint\n\n      - name: Typecheck\n        run: npm run typecheck\n\n      - name: Test\n        run: npm run test:ts\n\n  security:\n    name: Security and licenses\n    runs-on: ubuntu-26.04\n    timeout-minutes: 20\n    permissions:\n      contents: read\n    steps:\n      - name: Checkout full history\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Set up Go\n        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n        with:\n          go-version-file: go.mod\n          cache-dependency-path: |\n            go.sum\n            .github/tools/*/go.sum\n\n      - name: Scan Git history for secrets\n        run: go tool -modfile=.github/tools/gitleaks/go.mod gitleaks git --redact --no-banner .\n\n      - name: Check reachable vulnerabilities\n        run: go tool -modfile=.github/tools/govulncheck/go.mod govulncheck ./...\n\n      - name: Check dependency licenses\n        run: >-\n          go tool -modfile=.github/tools/licenses/go.mod go-licenses check ./...\n          --allowed_licenses=Apache-2.0,BSD-2-Clause,BSD-3-Clause,ISC,MIT,MPL-2.0,Unlicense\n\n      - name: Generate release license notices for all targets\n        run: bash scripts/licenses.sh\n// Bundles the CLI (default), the test entry (--test), or the live-test\n// entry (--live) with esbuild. Run directly by Node (type stripping), so\n// only erasable TypeScript syntax is allowed here.\nimport { execFileSync } from 'node:child_process'\nimport { readFileSync } from 'node:fs'\nimport { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'\nimport { resolve } from 'node:path'\nimport { build } from 'esbuild'\nimport type { Metafile } from 'esbuild'\nimport { ROOT, baseOptions } from './esbuild-options.ts'\nimport {\n    bundledPackageDirs,\n    readBundledPackages,\n    renderNotices,\n} from './licenses.ts'\n\nconst SHEBANG = '#!/usr/bin/env node'\n// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into\n// a runtime \"Dynamic require is not supported\" error unless a `require`\n// is in scope.\nconst REQUIRE_SHIM = [\n    \"import { createRequire as __roastRequire } from 'node:module'\",\n    'const require = __roastRequire(import.meta.url)',\n].join('\\n')\n\ntype Mode = 'cli'|'test'|'live'\n\nfunction parseMode (args:string[]):Mode {\n    if (args.length === 0) return 'cli'\n    if (args.length === 1 && args[0] === '--test') return 'test'\n    if (args.length === 1 && args[0] === '--live') return 'live'\n    throw new Error(`usage: node scripts/bundle.ts [--test|--live], got ${\n        args.join(' ')}`)\n}\n\n// Runs git at the repository root; `unknown` when git fails (a build\n// from a tarball, no git on PATH).\nfunction git (args:string[]):string {\n    try {\n        const out = execFileSync('git', args, {\n            cwd:ROOT,\n            encoding:'utf8',\n            stdio:['ignore', 'pipe', 'ignore'],\n        }).trim()\n        return out || 'unknown'\n    } catch {\n        return 'unknown'\n    }\n}\n\nasync function packageVersion ():Promise<string> {\n    const text = await readFile(new URL('package.json', `file://${ROOT}`),\n        'utf8')\n    const version = JSON.parse(text).version\n    if (typeof version !== 'string') {\n        throw new Error('package.json has no string version')\n    }\n    return version\n}\n\n// Writes dist/THIRD_PARTY_LICENSES.txt from the metafile (spec 15, 2.6).\n// Throws, naming the package, when a bundled package fails validation.\nasync function writeThirdPartyNotices (metafile:Metafile):Promise<void> {\n    const dirs = bundledPackageDirs(metafile, 'dist/cli.js')\n        .map(dir => resolve(ROOT, dir))\n    const notices = renderNotices(readBundledPackages(dirs),\n        path => readFileSync(path, 'utf8'))\n    await writeFile(new URL('dist/THIRD_PARTY_LICENSES.txt',\n        `file://${ROOT}`), notices)\n}\n\nasync function bundleCli ():Promise<void> {\n    const dist = new URL('dist/', `file://${ROOT}`)\n    await rm(dist, { recursive:true, force:true })\n    await mkdir(dist, { recursive:true })\n\n    const version = await packageVersion()\n    const commit = git(['rev-parse', '--short=7', 'HEAD'])\n    const date = git(['log', '-1', '--format=%cI'])\n\n    const result = await build({\n        ...baseOptions(),\n        entryPoints:['src/cli.ts'],\n        outfile:'dist/cli.js',\n        tsconfig:'tsconfig.build.json',\n        metafile:true,\n        banner:{ js:`${SHEBANG}\\n${REQUIRE_SHIM}` },\n        define:{\n            __ROAST_VERSION__:JSON.stringify(version),\n            __ROAST_COMMIT__:JSON.stringify(commit),\n            __ROAST_DATE__:JSON.stringify(date),\n        },\n    })\n    const metafile = result.metafile\n    if (!metafile) throw new Error('esbuild returned no metafile')\n    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))\n    await writeThirdPartyNotices(metafile)\n    await chmod(new URL('cli.js', dist), 0o755)\n}\n\nasync function bundleTests (entry:string, outfile:string):Promise<void> {\n    await build({\n        ...baseOptions(),\n        entryPoints:[entry],\n        outfile,\n        tsconfig:'tsconfig.json',\n        banner:{ js:REQUIRE_SHIM },\n    })\n}\n\nasync function main ():Promise<void> {\n    const mode = parseMode(process.argv.slice(2))\n    if (mode === 'cli') return bundleCli()\n    if (mode === 'test') {\n        return bundleTests('test/index.ts', 'test/test-bundle.js')\n    }\n    return bundleTests('test/live/index.ts', 'test/live-bundle.js')\n}\n\ntry {\n    await main()\n} catch (err) {\n    // esbuild has already printed its own diagnostics for build errors.\n    console.error(err instanceof Error ? err.message : err)\n    process.exitCode = 1\n}\n// esbuild options shared by every bundle (spec 15, 2.5): the CLI, the\n// test entries, and the schema generator. Run directly by Node (type\n// stripping), so only erasable TypeScript syntax is allowed here.\nimport { fileURLToPath } from 'node:url'\nimport type { BuildOptions } from 'esbuild'\n\nexport const ROOT = fileURLToPath(new URL('..', import.meta.url))\n\nexport function baseOptions ():BuildOptions {\n    return {\n        absWorkingDir:ROOT,\n        bundle:true,\n        platform:'node',\n        format:'esm',\n        target:'node22',\n        mainFields:['module', 'main'],\n        keepNames:true,\n        minify:false,\n        sourcemap:false,\n        loader:{ '.tmpl':'text', '.md':'text', '.sh':'text' },\n        logLevel:'warning',\n    }\n}\n./.scratch/ts-rewrite/spec/15-packaging.md","is_error":false}]},"parent_tool_use_id":null,"session_id":"4c00c7f3-71f4-4751-b678-7052dcc92742","uuid":"7387c33a-efca-4a55-80ec-efff1681d0b8","timestamp":"2026-11-18T20:38:10.527Z","tool_use_result":{"stdout":"AGENTS.md\nCHANGELOG.md\ncmd/\nCONTEXT.md\nCONTRIBUTING.md\ndocs/\neslint.config.js\ngo.mod\ngo.sum\ninternal/\nLICENSE-APACHE.txt\nLICENSE-MIT.txt\nLICENSE.txt\nnode_modules/\npackage.json\npackages/\nREADME.md\nrenovate.json\nroast.schema.json\nscripts/\nSECURITY.md\nsrc/\ntest/\ntsconfig.build.json\ntsconfig.json\ntsconfig.launcher.json\n.scratch:\nts-rewrite/\n\nscripts:\nbuild.ts\nbundle.ts\ncheck-pack.ts\ncheck-package.ts\ncheck-release.ts\nesbuild-options.ts\neslint-ts6.ts\nlicenses_test.go\nlicenses.sh\nlicenses.ts\nplatforms.ts\nrelease.ts\nschema.ts\nversion.ts\n\ntest:\ncheck-pack.test.ts\ncli/\nconfig/\ncontext/\nfsutil/\ngate/\ngit/\ngocompat/\nhelpers/\nindex.ts\nlauncher.test.ts\nlive/\nllm/\nmanifest.test.ts\nprepublish.test.ts\nrelease-fixture.ts\nrelease.test.ts\nscope/\nskill/\nsnapshot/\ntextsafe/\ntooling/\ntrust/\nutil/\nversion.test.ts\n\ntest/helpers:\nenv.ts\ninference-server.ts\ninference-stream.ts\nrepo.ts\nrun.ts\nspawn.ts\nstreams.ts\nterminal.ts\ntest.ts\n{\n  \"name\": \"@substrate-system/roast\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Adversarial review\",\n  \"license\": \"(MIT OR Apache-2.0)\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"roast\": \"dist/launcher.js\"\n  },\n  \"files\": [\n    \"dist/\",\n    \"roast.schema.json\",\n    \"LICENSE.txt\",\n    \"LICENSE-MIT.txt\",\n    \"LICENSE-APACHE.txt\"\n  ],\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"devEngines\": {\n    \"runtime\": {\n      \"name\": \"node\",\n      \"version\": \">=22.18\"\n    }\n  },\n  \"scripts\": {\n    \"toc\": \"markdown-toc --maxdepth 3 -i README.md\",\n    \"lint\": \"node --import ./scripts/eslint-ts6.ts node_modules/eslint/bin/eslint.js src test scripts eslint.config.js --ignore-pattern 'src/launcher.ts' --ignore-pattern 'test/*.test.ts' --ignore-pattern 'test/release-fixture.ts' --ignore-pattern 'scripts/build.ts' --ignore-pattern 'scripts/check-pack.ts' --ignore-pattern 'scripts/check-release.ts' --ignore-pattern 'scripts/platforms.ts' --ignore-pattern 'scripts/release.ts' --ignore-pattern 'scripts/version.ts'\",\n    \"typecheck\": \"tsc -p tsconfig.json\",\n    \"build\": \"npm run schema && node scripts/build.ts\",\n    \"bundle\": \"npm run schema && node scripts/bundle.ts\",\n    \"schema\": \"node scripts/schema.ts\",\n    \"build:launcher\": \"tsc -p tsconfig.launcher.json\",\n    \"build:test\": \"node scripts/bundle.ts --test\",\n    \"test\": \"go test ./... && npm run build:launcher && node --test \\\"test/**/*.test.ts\\\"\",\n    \"test:tap\": \"bash -o pipefail -c 'node test/test-bundle.js | tap-spec'\",\n    \"test:ts\": \"npm run bundle && npm run build:test && npm run test:tap\",\n    \"test:live\": \"node scripts/bundle.ts --live && bash -o pipefail -c 'node test/live-bundle.js | tap-spec'\",\n    \"version\": \"npm run toc && node scripts/version.ts && git add README.md\",\n    \"prepublishOnly\": \"node scripts/check-release.ts\",\n    \"check:pack\": \"node scripts/check-pack.ts\",\n    \"release\": \"node scripts/release.ts\"\n  },\n  \"devDependencies\": {\n    \"@substrate-system/debug\": \"^0.9.64\",\n    \"@substrate-system/redeye\": \"^0.1.7\",\n    \"@substrate-system/tapzero\": \"^0.10.15\",\n    \"@types/node\": \"^22.18.0\",\n    \"@types/yargs\": \"^17.0.33\",\n    \"@typescript/typescript6\": \"^6.0.2\",\n    \"ajv\": \"^8.20.0\",\n    \"auto-changelog\": \"^2.4.0\",\n    \"esbuild\": \"^0.27.0\",\n    \"eslint\": \"^10.6.0\",\n    \"jsonc-parser\": \"^3.3.1\",\n    \"markdown-toc\": \"^1.2.0\",\n    \"newneostandard\": \"^0.14.1\",\n    \"tap-spec\": \"^5.0.0\",\n    \"typescript\": \"^7.0.2\",\n    \"typescript-eslint\": \"^8.62.0\",\n    \"yargs\": \"^18.2.0\",\n    \"zod\": \"^4.6.7\"\n  },\n  \"optionalDependencies\": {\n    \"@substrate-system/roast-darwin-arm64\": \"0.0.0\",\n    \"@substrate-system/roast-darwin-x64\": \"0.0.0\",\n    \"@substrate-system/roast-linux-arm64\": \"0.0.0\",\n    \"@substrate-system/roast-linux-x64\": \"0.0.0\",\n    \"@substrate-system/roast-win32-arm64\": \"0.0.0\",\n    \"@substrate-system/roast-win32-x64\": \"0.0.0\"\n  },\n  \"keywords\": [\n    \"AI\"\n  ],\n  \"homepage\": \"https://github.com/nichoth/roast#readme\",\n  \"bugs\": {\n    \"url\": \"https://github.com/nichoth/roast/issues\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/nichoth/roast.git\"\n  },\n  \"author\": \"nichoth\"\n}\nname: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n  workflow_dispatch: {}\n\npermissions: {}\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n\njobs:\n  quality:\n    name: Test and build\n    runs-on: ubuntu-26.04\n    timeout-minutes: 30\n    permissions:\n      contents: read\n    steps:\n      - name: Checkout\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Set up Go\n        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n        with:\n          go-version-file: go.mod\n          cache-dependency-path: |\n            go.sum\n            .github/tools/*/go.sum\n\n      - name: Set up Node\n        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 24\n\n      - name: Download dependencies\n        run: go mod download\n\n      - name: Check formatting\n        shell: bash\n        run: |\n          set -euo pipefail\n          unformatted=\"$(gofmt -l .)\"\n          if [[ -n \"${unformatted}\" ]]; then\n            echo \"${unformatted}\"\n            exit 1\n          fi\n\n      - name: Check module files\n        run: |\n          set -euo pipefail\n          go mod tidy\n          for modfile in .github/tools/*/go.mod; do\n            (cd \"${modfile%/*}\" && go mod tidy)\n          done\n          git diff --exit-code -- go.mod go.sum .github/tools\n          # git diff alone does not report a missing go.sum recreated by tidy.\n          test -z \"$(git ls-files --others --exclude-standard -- go.mod go.sum .github/tools)\"\n\n      - name: Check workflows and shell scripts\n        run: |\n          go tool -modfile=.github/tools/actionlint/go.mod actionlint\n          shellcheck scripts/*.sh\n\n      - name: Install npm dependencies\n        # .npmrc sets package-lock=false, so no lockfile is committed. Write\n        # one from package.json so npm ci can install from it.\n        run: |\n          npm install --package-lock-only --package-lock=true --no-audit --no-fund\n          npm ci --no-audit --no-fund\n\n      - name: Test\n        env:\n          # npm test runs go test ./...; keep the race detector in CI.\n          GOFLAGS: -race\n        run: npm test\n\n      - name: Vet\n        run: go vet ./...\n\n      - name: Staticcheck\n        # Keep the importer compatible with the compiler without adding\n        # CI-only tool dependencies to Roast's runtime module.\n        run: go tool -modfile=.github/tools/staticcheck/go.mod staticcheck ./...\n\n      - name: Build all platform packages\n        run: npm run build\n\n      - name: Check package contents\n        # Packs every package in dry-run mode; nothing is published.\n        run: npm run check:pack\n\n  typescript:\n    name: TypeScript (${{ matrix.os }}, Node ${{ matrix.node }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 30\n    permissions:\n      contents: read\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-26.04, macos-latest]\n        node: [22, 24]\n    steps:\n      - name: Checkout\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Set up Node\n        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: ${{ matrix.node }}\n\n      - name: Install npm dependencies\n        # .npmrc sets package-lock=false, so no lockfile is committed. Write\n        # one from package.json so npm ci can install from it.\n        run: |\n          npm install --package-lock-only --package-lock=true --no-audit --no-fund\n          npm ci --no-audit --no-fund\n\n      - name: Lint\n        run: npm run lint\n\n      - name: Typecheck\n        run: npm run typecheck\n\n      - name: Test\n        run: npm run test:ts\n\n  security:\n    name: Security and licenses\n    runs-on: ubuntu-26.04\n    timeout-minutes: 20\n    permissions:\n      contents: read\n    steps:\n      - name: Checkout full history\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Set up Go\n        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n        with:\n          go-version-file: go.mod\n          cache-dependency-path: |\n            go.sum\n            .github/tools/*/go.sum\n\n      - name: Scan Git history for secrets\n        run: go tool -modfile=.github/tools/gitleaks/go.mod gitleaks git --redact --no-banner .\n\n      - name: Check reachable vulnerabilities\n        run: go tool -modfile=.github/tools/govulncheck/go.mod govulncheck ./...\n\n      - name: Check dependency licenses\n        run: >-\n          go tool -modfile=.github/tools/licenses/go.mod go-licenses check ./...\n          --allowed_licenses=Apache-2.0,BSD-2-Clause,BSD-3-Clause,ISC,MIT,MPL-2.0,Unlicense\n\n      - name: Generate release license notices for all targets\n        run: bash scripts/licenses.sh\n// Bundles the CLI (default), the test entry (--test), or the live-test\n// entry (--live) with esbuild. Run directly by Node (type stripping), so\n// only erasable TypeScript syntax is allowed here.\nimport { execFileSync } from 'node:child_process'\nimport { readFileSync } from 'node:fs'\nimport { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'\nimport { resolve } from 'node:path'\nimport { build } from 'esbuild'\nimport type { Metafile } from 'esbuild'\nimport { ROOT, baseOptions } from './esbuild-options.ts'\nimport {\n    bundledPackageDirs,\n    readBundledPackages,\n    renderNotices,\n} from './licenses.ts'\n\nconst SHEBANG = '#!/usr/bin/env node'\n// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into\n// a runtime \"Dynamic require is not supported\" error unless a `require`\n// is in scope.\nconst REQUIRE_SHIM = [\n    \"import { createRequire as __roastRequire } from 'node:module'\",\n    'const require = __roastRequire(import.meta.url)',\n].join('\\n')\n\ntype Mode = 'cli'|'test'|'live'\n\nfunction parseMode (args:string[]):Mode {\n    if (args.length === 0) return 'cli'\n    if (args.length === 1 && args[0] === '--test') return 'test'\n    if (args.length === 1 && args[0] === '--live') return 'live'\n    throw new Error(`usage: node scripts/bundle.ts [--test|--live], got ${\n        args.join(' ')}`)\n}\n\n// Runs git at the repository root; `unknown` when git fails (a build\n// from a tarball, no git on PATH).\nfunction git (args:string[]):string {\n    try {\n        const out = execFileSync('git', args, {\n            cwd:ROOT,\n            encoding:'utf8',\n            stdio:['ignore', 'pipe', 'ignore'],\n        }).trim()\n        return out || 'unknown'\n    } catch {\n        return 'unknown'\n    }\n}\n\nasync function packageVersion ():Promise<string> {\n    const text = await readFile(new URL('package.json', `file://${ROOT}`),\n        'utf8')\n    const version = JSON.parse(text).version\n    if (typeof version !== 'string') {\n        throw new Error('package.json has no string version')\n    }\n    return version\n}\n\n// Writes dist/THIRD_PARTY_LICENSES.txt from the metafile (spec 15, 2.6).\n// Throws, naming the package, when a bundled package fails validation.\nasync function writeThirdPartyNotices (metafile:Metafile):Promise<void> {\n    const dirs = bundledPackageDirs(metafile, 'dist/cli.js')\n        .map(dir => resolve(ROOT, dir))\n    const notices = renderNotices(readBundledPackages(dirs),\n        path => readFileSync(path, 'utf8'))\n    await writeFile(new URL('dist/THIRD_PARTY_LICENSES.txt',\n        `file://${ROOT}`), notices)\n}\n\nasync function bundleCli ():Promise<void> {\n    const dist = new URL('dist/', `file://${ROOT}`)\n    await rm(dist, { recursive:true, force:true })\n    await mkdir(dist, { recursive:true })\n\n    const version = await packageVersion()\n    const commit = git(['rev-parse', '--short=7', 'HEAD'])\n    const date = git(['log', '-1', '--format=%cI'])\n\n    const result = await build({\n        ...baseOptions(),\n        entryPoints:['src/cli.ts'],\n        outfile:'dist/cli.js',\n        tsconfig:'tsconfig.build.json',\n        metafile:true,\n        banner:{ js:`${SHEBANG}\\n${REQUIRE_SHIM}` },\n        define:{\n            __ROAST_VERSION__:JSON.stringify(version),\n            __ROAST_COMMIT__:JSON.stringify(commit),\n            __ROAST_DATE__:JSON.stringify(date),\n        },\n    })\n    const metafile = result.metafile\n    if (!metafile) throw new Error('esbuild returned no metafile')\n    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))\n    await writeThirdPartyNotices(metafile)\n    await chmod(new URL('cli.js', dist), 0o755)\n}\n\nasync function bundleTests (entry:string, outfile:string):Promise<void> {\n    await build({\n        ...baseOptions(),\n        entryPoints:[entry],\n        outfile,\n        tsconfig:'tsconfig.json',\n        banner:{ js:REQUIRE_SHIM },\n    })\n}\n\nasync function main ():Promise<void> {\n    const mode = parseMode(process.argv.slice(2))\n    if (mode === 'cli') return bundleCli()\n    if (mode === 'test') {\n        return bundleTests('test/index.ts', 'test/test-bundle.js')\n    }\n    return bundleTests('test/live/index.ts', 'test/live-bundle.js')\n}\n\ntry {\n    await main()\n} catch (err) {\n    // esbuild has already printed its own diagnostics for build errors.\n    console.error(err instanceof Error ? err.message : err)\n    process.exitCode = 1\n}\n// esbuild options shared by every bundle (spec 15, 2.5): the CLI, the\n// test entries, and the schema generator. Run directly by Node (type\n// stripping), so only erasable TypeScript syntax is allowed here.\nimport { fileURLToPath } from 'node:url'\nimport type { BuildOptions } from 'esbuild'\n\nexport const ROOT = fileURLToPath(new URL('..', import.meta.url))\n\nexport function baseOptions ():BuildOptions {\n    return {\n        absWorkingDir:ROOT,\n        bundle:true,\n        platform:'node',\n        format:'esm',\n        target:'node22',\n        mainFields:['module', 'main'],\n        keepNames:true,\n        minify:false,\n        sourcemap:false,\n        loader:{ '.tmpl':'text', '.md':'text', '.sh':'text' },\n        logLevel:'warning',\n    }\n}\n./.scratch/ts-rewrite/spec/15-packaging.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012JShoAM35CPZ3og5edMKbk","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
