{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChB3HVMrPr1d4kDqjNfT5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EaLkNX3W7ZHTjHSK2mUdzw","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-09-differential-harness-and-m1-scenarios/test/diff/selftest/baseline.ts","content":"// Self-tests for the Go baseline build, driven by a fake `go` first on\n// PATH and a temporary repository standing in for this checkout.\nimport { execFileSync } from 'node:child_process'\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { test } from '../../helpers/test.js'\nimport { ensureBaseline } from '../baseline.js'\n\ninterface Fixture {\n    root:string;\n    repo:string;\n    bin:string;\n    log:string;\n    tmpRoot:string;\n    cachePath:string;\n    env:NodeJS.ProcessEnv;\n    remove ():void;\n}\n\nfunction git (repo:string, args:string[], env:NodeJS.ProcessEnv):string {\n    return execFileSync('git', ['-C', repo, ...args], {\n        env,\n        encoding:'utf8',\n    })\n}\n\n// A repository with one commit, a fake `go` that logs its working\n// directory, arguments, CGO_ENABLED, and GOFLAGS, then writes the `-o`\n// file (or fails when `fail` is set).\nfunction fixture (fail:boolean):Fixture {\n    const root = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-baseline-')))\n    const repo = path.join(root, 'repo')\n    const bin = path.join(root, 'bin')\n    const log = path.join(root, 'go.log')\n    const tmpRoot = path.join(root, 'tmp')\n    fs.mkdirSync(repo)\n    fs.mkdirSync(bin)\n    fs.mkdirSync(tmpRoot)\n    const env:NodeJS.ProcessEnv = {\n        PATH:`${bin}${path.delimiter}${process.env.PATH ?? ''}`,\n        HOME:root,\n        GIT_CONFIG_NOSYSTEM:'1',\n        GIT_CONFIG_GLOBAL:'/dev/null',\n        GIT_AUTHOR_NAME:'t',\n        GIT_AUTHOR_EMAIL:'t@example.com',\n        GIT_COMMITTER_NAME:'t',\n        GIT_COMMITTER_EMAIL:'t@example.com',\n        GOFLAGS:'-race',\n        CGO_ENABLED:'1',\n    }\n    git(repo, ['init', '-q'], env)\n    fs.writeFileSync(path.join(repo, 'file.txt'), 'x\\n')\n    git(repo, ['add', '.'], env)\n    git(repo, ['commit', '-q', '-m', 'one'], env)\n    const script = [\n        '#!/bin/sh',\n        `echo \"$PWD|$*|CGO=$CGO_ENABLED|GOFLAGS=\\${GOFLAGS-unset}\" >> '${log}'`,\n        fail ? 'echo \"build failed\" >&2; exit 1' : '',\n        'out=\"\"',\n        'while [ $# -gt 0 ]; do',\n        '  if [ \"$1\" = \"-o\" ]; then out=\"$2\"; fi',\n        '  shift',\n        'done',\n        'printf \"#!/bin/sh\\\\n\" > \"$out\"',\n        'chmod +x \"$out\"',\n    ].join('\\n')\n    fs.writeFileSync(path.join(bin, 'go'), script + '\\n', { mode:0o755 })\n    return {\n        root,\n        repo,\n        bin,\n        log,\n        tmpRoot,\n        cachePath:path.join(root, 'cache', 'roast-go-test'),\n        env,\n        remove:() => fs.rmSync(root, { recursive:true, force:true }),\n    }\n}\n\nfunction logLines (f:Fixture):string[] {\n    if (!fs.existsSync(f.log)) return []\n    return fs.readFileSync(f.log, 'utf8').split('\\n').filter(Boolean)\n}\n\nfunction worktrees (f:Fixture):number {\n    return git(f.repo, ['worktree', 'list', '--porcelain'], f.env)\n        .split('\\n').filter(l => l.startsWith('worktree ')).length\n}\n\ntest('baseline: builds once, then reuses the cached binary', async t => {\n    const f = fixture(false)\n    t.cleanup(() => f.remove())\n    const opts = {\n        root:f.repo,\n        rev:'HEAD',\n        cachePath:f.cachePath,\n        env:f.env,\n        tmpRoot:f.tmpRoot,\n    }\n    const first = await ensureBaseline(opts)\n    t.equal(first.kind, 'binary', 'the first call yields a binary')\n    t.ok(first.kind === 'binary' && first.built, 'and builds it')\n    t.ok(fs.existsSync(f.cachePath), 'the binary is at the cache path')\n    const lines = logLines(f)\n    t.equal(lines.length, 1, 'go ran once')\n    const [cwd, args, cgo, goflags] = lines[0].split('|')\n    t.ok(cwd !== f.repo && !cwd.startsWith(f.repo + path.sep),\n        'go ran in a separate worktree')\n    t.ok(args.includes('build') && args.includes('-trimpath'),\n        'with go build -trimpath')\n    t.ok(args.includes('buildinfo.Version=baseline'),\n        'with the baseline version ldflag')\n    t.ok(args.endsWith('./cmd/roast'), 'building ./cmd/roast')\n    t.equal(cgo, 'CGO=0', 'with CGO_ENABLED=0')\n    t.equal(goflags, 'GOFLAGS=unset', 'and GOFLAGS removed')\n    t.equal(worktrees(f), 1, 'the temporary worktree is removed')\n    t.deepEqual(fs.readdirSync(f.tmpRoot), [],\n        'the temporary directory is removed')\n\n    const second = await ensureBaseline(opts)\n    t.ok(second.kind === 'binary' && !second.built,\n        'the second call reuses the binary')\n    t.equal(logLines(f).length, 1, 'without running go again')\n})\n\ntest('baseline: a failing build removes the worktree', async t => {\n    const f = fixture(true)\n    t.cleanup(() => f.remove())\n    let err:unknown\n    try {\n        await ensureBaseline({\n            root:f.repo,\n            rev:'HEAD',\n            cachePath:f.cachePath,\n            env:f.env,\n            tmpRoot:f.tmpRoot,\n        })\n    } catch (e) {\n        err = e\n    }\n    t.ok(err instanceof Error, 'the build failure is an error')\n    t.ok(String(err).includes('build failed'), 'carrying go\\'s stderr')\n    t.equal(logLines(f).length, 1, 'go ran')\n    t.equal(worktrees(f), 1, 'the temporary worktree is removed')\n    t.deepEqual(fs.readdirSync(f.tmpRoot), [],\n        'the temporary directory is removed')\n    t.ok(!fs.existsSync(f.cachePath), 'no binary is cached')\n})\n\ntest('baseline: without go on PATH, nothing is built', async t => {\n    const f = fixture(false)\n    t.cleanup(() => f.remove())\n    const result = await ensureBaseline({\n        root:f.repo,\n        rev:'HEAD',\n        cachePath:f.cachePath,\n        env:{ ...f.env, PATH:path.join(