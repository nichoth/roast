{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChB3agz4uLwNo9Zasuijp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WVke6B6oXc9pw1d8LapJSw","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-09-differential-harness-and-m1-scenarios/test/diff/selftest/harness.ts","content":"// Self-tests for the scenario runner: it detects an injected\n// divergence, and two runs of one CLI compare equal after normalization.\n// They use the TS CLI and stub CLIs, so they need no Go.\nimport fs from 'node:fs'\nimport os from 'node:os'\nimport path from 'node:path'\nimport { test } from '../../helpers/test.js'\nimport { startInferenceServer } from '../../helpers/inference-server.js'\nimport { type Cli, type Scenario, TS_CLI, runScenario } from '../scenario.js'\nimport { M1_SCENARIOS } from '../scenarios/m1.js'\n\nfunction stubDir ():{ dir:string, remove ():void } {\n    const dir = fs.realpathSync(fs.mkdtempSync(\n        path.join(os.tmpdir(), 'roast-diff-stub-')))\n    return { dir, remove:() => fs.rmSync(dir, { recursive:true }) }\n}\n\nfunction shellStub (dir:string, body:string):Cli {\n    const file = path.join(dir, 'stub.sh')\n    fs.writeFileSync(file, `#!/bin/sh\\n${body}\\n`, { mode:0o755 })\n    return { name:'stub', command:file, args:[] }\n}\n\nfunction scenario (name:string):Scenario {\n    const s = M1_SCENARIOS.find(x => x.name === name)\n    if (!s) throw new Error(`no scenario ${name}`)\n    return s\n}\n\ntest('harness: the TS CLI against itself has no differences', async t => {\n    const s = scenario('gate settings: custom gate section')\n    const r = await runScenario(s, { go:TS_CLI, ts:TS_CLI })\n    t.equal(r.go.exit, 0, 'the scenario succeeds')\n    t.deepEqual(r.diffs, [], 'and both sides compare equal')\n})\n\ntest('harness: a stub that exits with another code is a divergence',\n    async t => {\n        const d = stubDir()\n        t.cleanup(() => d.remove())\n        const stub = shellStub(d.dir,\n            'printf \"timeout_seconds=42\\\\nseverity=MEDIUM\\\\n\"; exit 3')\n        const s = scenario('gate settings: custom gate section')\n        const r = await runScenario(s, { go:TS_CLI, ts:stub })\n        t.deepEqual(r.unexplained.map(x => x.path), ['exit'],\n            'the exit code difference is unexplained')\n    })\n\ntest('harness: a stub with other settings is a divergence', async t => {\n    const d = stubDir()\n    t.cleanup(() => d.remove())\n    const stub = shellStub(d.dir,\n        'printf \"timeout_seconds=42\\\\nseverity=HIGH\\\\n\"')\n    const s = scenario('gate settings: custom gate section')\n    const r = await runScenario(s, { go:TS_CLI, ts:stub })\n    t.deepEqual(r.unexplained.map(x => x.path), ['stdout.severity'],\n        'the stdout difference is unexplained')\n})\n\n// A CLI whose every run has a fresh run ID, timestamp, build identity,\n// duration, User-Agent, and session ID, writes records naming its\n// repository, and sends one request to the fake server.\nconst VOLATILE_STUB = `\nimport crypto from 'node:crypto'\nimport fs from 'node:fs'\nimport path from 'node:path'\nimport zlib from 'node:zlib'\nconst rand = n => crypto.randomBytes(n).toString('hex')\nconst now = new Date(Date.now() + crypto.randomInt(1e9))\nconst id = now.toISOString().replace(/[-:]/g, '').replace(/\\\\.\\\\d+Z$/, 'Z') +\n    '-' + rand(4)\nconst ts = now.toISOString()\nconst cwd = process.cwd()\nconst runs = path.join(cwd, '.roast', 'runs')\nconst run = path.join(runs, id)\nfs.mkdirSync(run, { recursive:true })\nfs.writeFileSync(path.join(run, 'meta.json'), JSON.stringify({\n    run_id:id, ts, repo:cwd, duration_ms:crypto.randomInt(1e6),\n    roast:{ version:rand(3), commit:rand(4) },\n}))\nfs.writeFileSync(path.join(run, 'result.json.gz'),\n    zlib.gzipSync(JSON.stringify({ run_id:id, report:path.join(run, 'r') })))\nfs.writeFileSync(path.join(runs, 'runs-2026-01.jsonl'),\n    JSON.stringify({ run_id:id, ts }) + '\\\\n')\nconst b32 = 'abcdefghijklmnopqrstuvwxyz234567'\nlet session = 'roast-'\nfor (let i = 0; i < 26; i++) session += b32[crypto.randomInt(32)]\nawait fetch(process.env.STUB_URL + '/v1/chat/completions', {\n    method:'POST',\n    headers:{\n        'content-type':'application/json',\n        'user-agent':'stub/' + rand(2),\n        'x-agent-session-id':session,\n        authorization:'Bearer k',\n    },\n    body:JSON.stringify({\n        model:'m',\n        messages:[{ role:'user', content:'review ' + cwd + ' ' + session }],\n    }),\n})\nprocess.stdout.write(JSON.stringify({ run_id:id, ts, dir:run }) + '\\\\n')\n`\n\ntest('harness: normalization makes two runs of one CLI equal', async t => {\n    const d = stubDir()\n    t.cleanup(() => d.remove())\n    const file = path.join(d.dir, 'stub.mjs')\n    fs.writeFileSync(file, VOLATILE_STUB)\n    const cli:Cli = { name:'stub', command:process.execPath, args:[file] }\n    const s:Scenario = {\n        name:'self: volatile stub',\n        files:{ 'README.md':'fixture\\n' },\n        argv:[],\n        stdout:'json',\n        env:ctx => ({ STUB_URL:ctx.url }),\n        server:() => startInferenceServer(() => ({ status:200, body:'{}' })),\n        records:true,\n        requests:true,\n    }\n    const r = await runScenario(s, { go:cli, ts:cli })\n    t.equal(r.go.exit, 0, 'the first run succeeds')\n    t.equal(r.ts.exit, 0, 'the second run succeeds')\n    t.ok(r.go.stdout !== r.ts.stdout, 'the raw outputs differ')\n    t.equal(r.go.records.size, 3, 'records were read')\n    t.equal(r.go.requests.length, 1, 'the first run\\'s request')\n    t.equal(r.ts.requests.length, 1, 'the second run\\'s request')\n    t.deepEqual(r.diffs, [], 'nothing differs after normalization')\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6902,"cache_read_input_tokens":132447,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_i