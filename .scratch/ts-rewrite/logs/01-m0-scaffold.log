eads/main' }}\n\njobs:\n  quality:\n    name: Test and build\n    runs-on: ubuntu-26.04\n    timeout-minutes: 30\n    permissions:\n      contents: read\n    steps:\n      - name: Checkout\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n\n      - name: Set up Go\n        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n        with:\n          go-version-file: go.mod\n          cache-dependency-path: |\n            go.sum\n            .github/tools/*/go.sum\n\n      - name: Set up Node\n        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 24\n\n      - name: Download dependencies\n        run: go mod download\n\n      - name: Check formatting\n        shell: bash\n        run: |\n          set -euo pipefail\n          unformatted=\"$(gofmt -l .)\"\n          if [[ -n \"${unformatted}\" ]]; then\n            echo \"${unformatted}\"\n            exit 1\n          fi\n\n      - name: Check module files\n        run: |\n          set -euo pipefail\n          go mod tidy\n          for modfile in .github/tools/*/go.mod; do\n            (cd \"${modfile%/*}\" && go mod tidy)\n          done\n          git diff --exit-code -- go.mod go.sum .github/tools\n          # git diff alone does not report a missing go.sum recreated by tidy.\n          test -z \"$(git ls-files --others --exclude-standard -- go.mod go.sum .github/tools)\"\n\n      - name: Check workflows and shell scripts\n        run: |\n          go tool -modfile=.github/tools/actionlint/go.mod actionlint\n          shellcheck scripts/*.sh\n\n      - name: Install npm dependencies\n        # .npmrc sets package-lock=false, so no lockfile is committed. Write\n        # one from package.json so npm ci can install from it.\n        run: |\n          npm install --package-lock-only --package-lock=true --no-audit --no-fund\n          npm ci --no-audit --no-fund\n\n      - name: Test\n        env:\n          # npm test runs go test ./...; keep the race detector in CI.\n          GOFLAGS: -race\n        run: npm test\n\n      - name: Vet\n        run: go vet ./...\n\n      - name: Staticcheck\n        # Keep the importer compatible with the compiler without adding\n        # CI-only tool dependencies to Roast's runtime module.\n        run: go tool -modfile=.github/tools/staticcheck/go.mod staticcheck ./...\n\n      - name: Build all platform packages\n        run: npm run build\n\n      - name: Check package contents\n        # Packs every package in dry-run mode; nothing is published.\n        run: npm run check:pack\n\n  security:\n    name: Security and licenses\n    runs-on: ubuntu-26.04\n    timeout-minutes: 20\n    permissions:\n      contents: read\n    steps:\n      - name: Checkout full history\n        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n\n      - name: Set up Go\n        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0\n        with:\n          go-version-file: go.mod\n          cache-dependency-path: |\n            go.sum\n            .github/tools/*/go.sum\n\n      - name: Scan Git history for secrets\n        run: go tool -modfile=.github/tools/gitleaks/go.mod gitleaks git --redact --no-banner .\n\n      - name: Check reachable vulnerabilities\n        run: go tool -modfile=.github/tools/govulncheck/go.mod govulncheck ./...\n\n      - name: Check dependency licenses\n        run: >-\n          go tool -modfile=.github/tools/licenses/go.mod go-licenses check ./...\n          --allowed_licenses=Apache-2.0,BSD-2-Clause,BSD-3-Clause,ISC,MIT,MPL-2.0,Unlicense\n\n      - name: Generate release license notices for all targets\n        run: bash scripts/licenses.sh\n","structuredPatch":[{"oldStart":95,"oldLines":6,"newStart":95,"newLines":44,"lines":["       