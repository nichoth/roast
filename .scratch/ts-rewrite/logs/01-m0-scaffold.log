it mkdir(join(dir, 'test'))\n        await writeFile(join(dir, 'test', 'test-bundle.js'), bundle)\n        return await run('sh', ['-c', script], {\n            cwd:dir,\n            env:{\n                ...process.env,\n                PATH:join(ROOT, 'node_modules', '.bin') + delimiter +\n                    (process.env.PATH ?? ''),\n            },\n        })\n    } finally {\n        await rm(dir, { recursive:true, force:true })\n    }\n}\n\ntest('test:tap exits 0 when the test bundle passes', async t => {\n    const res = await testTap(\n        \"console.log('TAP version 13\\\\nok 1 - fine\\\\n1..1')\\n\")\n    t.equal(res.code, 0, 'exits 0')\n})\n\ntest('test:tap exits non-zero when an assertion fails', async t => {\n    const res = await testTap(\n        \"console.log('TAP version 13\\\\nnot ok 1 - broken\\\\n1..1')\\n\" +\n        'process.exitCode = 1\\n')\n    t.ok(res.code !== 0, 'exits non-zero')\n})\n\ntest('test:tap exits non-zero when the test bundle crashes', async t => {\n    const res = await testTap(\n        \"console.log('TAP version 13\\\\nok 1 - fine')\\n\" +\n        \"throw new Error('crash before the plan')\\n\")\n    t.ok(res.code !== 0, 'exits non-zero')\n})\nEOF\necho \"import './tooling/test-tap.js'\" >> test/index.ts\n# red: temporarily use the pipefail-less form to see the tests catch it\nnode -e 'const fs=require(\"fs\");const p=JSON.parse(fs.readFileSync(\"package.json\"));p.scripts[\"test:tap\"]=\"node test/test-bundle.js | tap-spec\";fs.writeFileSync(\"package.json\",JSON.stringify(p,null,2)+\"\\n\")'\nnpm run build:test 2>&1 | grep ERROR; node test/test-bundle.js | npx tap-spec 2>&1 | grep -E 'passing|failing|✖'\ngit checkout package.json && npm run build:test 2>&1 | grep ERROR; npm run test:tap 2>&1 | grep -E 'total|passing|failing|✖'","timeout":120000}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foregrou