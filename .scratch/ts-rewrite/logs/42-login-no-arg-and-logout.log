type ConfigContext = Pick<RunContext, 'cwd'|'env'|'signal'>

function usage (err:unknown):UsageError {
    const message = err instanceof Error ? err.message : String(err)
    return new UsageError(message, { cause:err })
}

// The config path: `explicit` (--config) unchanged when set, else the
// nearest .roast.json from the working directory up to the Git toplevel
// (the working directory itself outside a repository). '' when none.
export async function projectConfigPath (
    explicit:string,
    ctx:ConfigContext
):Promise<string> {
    if (explicit !== '') return explicit
    let stop = ctx.cwd
    try {
        stop = await gitRoot(ctx.cwd, {
            env:ctx.env as NodeJS.ProcessEnv,
            signal:ctx.signal,
        })
    } catch (err) {
        if (ctx.signal.aborted) throw err
    }
    return findConfig(ctx.cwd, stop)
}

// The config the pre-commit hook sees: only <toplevel>/.roast.json.
export function gateConfigPath (repo:string):string {
    return findConfig(repo, repo)
}

export async function loadProjectConfig (
    explicit:string,
    ctx:ConfigContext
):Promise<ProjectConfig> {
    let file:string
    try {
        file = await projectConfigPath(explicit, ctx)
    } catch (err) {
        if (ctx.signal.aborted) throw err
        throw usage(err)
    }
    if (file === '') throw new UsageError(NO_PROJECT_CONFIG)
    let cfg:ProjectConfig
    try {
        cfg = loadConfig(file)
    } catch (err) {
        throw usage(err)
    }
    // Every loaded config carries the stored-credentials store for the
    // working directory; roles read its files only when they reach the
    // stored step.
    const stored = await openCredentialStore(ctx.cwd, ctx.env,
        { signal:ctx.signal })
    return withStoredCredentials(cfg, stored)
}
import fs from 'node:fs'
import path from 'node:path'
import { PassThrough } from 'node:stream'
import { test } from '../helpers/test.js'
import { tempDir, tempRepo } from '../helpers/repo.js'
import { runRoast } from '../helpers/run.js'
import { providerServer } from '../helpers/provider-server.js'
import {
    captureBrowser,
    simulateTerminals,
} from '../helpers/terminal.js'
import { loadCredentials } from '../../src/credentials/credentials.js'
import { loadProjectConfig } from '../../src/cli/config.js'
import { resolveRole } from '../../src/config/role.js'

test('Ctrl-C at a raw-mode login prompt cancels without storing a key',
    async t => {
        for (const provider of ['openai', 'anthropic']) {
            const repo = tempRepo()
            t.cleanup(repo.remove)
            const server = await providerServer()
            t.cleanup(() => server.close())
            simulateTerminals(t, true)
            captureBrowser(t)
            const rawCalls:Array<boolean> = []
            const stdin = Object.assign(new PassThrough(), {
                isTTY:true,
                setRawMode:(on:boolean) => { rawCalls.push(on) },
            })
            t.cleanup(() => { stdin.destroy() })
            stdin.end('sk-partial-A1B2\x03sk-unused-C3D4\r')
            const result = await runRoast(['login', provider], {
                cwd:repo.dir,
                env:repo.env,
                stdin,
                redirectTo:server.url,
            })
            t.equal(result.code, 5, 'raw Ctrl-C is cancellation')
            t.deepEqual(rawCalls, [true, false], 'raw mode restored')
            t.equal(server.requests.length, 0, 'partial key is never sent')
            t.ok(!fs.existsSync(path.join(repo.dir, '.git', 'roast')),
                'no project state written')
            t.ok(!fs.existsSync(path.join(repo.env.XDG_CONFIG_HOME,
                'roast')), 'no user state written')
            t.equal(result.stdout, '', 'no success output')
            t.ok(!result.stderr.includes('sk-partial-A1B2'),
                'partial key is not echoed')
        }
    })

