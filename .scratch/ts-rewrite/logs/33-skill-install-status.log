NFIG_DIR\", \"\")\n\tt.Setenv(\"XDG_CONFIG_HOME\", \"\")\n\treturn home\n}\n\n// chdirToNewRepoSubdir creates a Git repository with a nested directory,\n// changes into that directory, and returns the resolved Git toplevel.\nfunc chdirToNewRepoSubdir(t *testing.T) string {\n\tt.Helper()\n\trepo := t.TempDir()\n\tgitPath, err := exec.LookPath(\"git\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcmd := exec.Command(gitPath, \"-C\", repo, \"init\")\n\tif output, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git init: %v: %s\", err, output)\n\t}\n\ttop, err := filepath.EvalSymlinks(repo)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsub := filepath.Join(top, \"pkg\", \"nested\")\n\tif err := os.MkdirAll(sub, 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Chdir(sub)\n\treturn top\n}\n\nfunc treeFiles(t *testing.T, root string) []string {\n\tt.Helper()\n\tvar files []string\n\terr := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !entry.IsDir() {\n\t\t\tfiles = append(files, path)\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn files\n}\n\nfunc TestSkillInstallFromSubdirectoryWritesToGitToplevel(t *testing.T) {\n\thome := isolateSkillHome(t)\n\ttop := chdirToNewRepoSubdir(t)\n\n\tvar stdout, stderr bytes.Buffer\n\tcode, err := ExecuteContext(t.Context(), []string{\"skill\", \"install\"}, &stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"install code=%d err=%v stdout=%s stderr=%s\", code, err, stdout.String(), stderr.String())\n\t}\n\tskillFile := filepath.Join(top, \".agents\", \"skills\", \"roast\", \"SKILL.md\")\n\tif _, err := os.Stat(skillFile); err != nil {\n\t\tt.Fatalf(\"project skill not installed: %v; stdout=%s\", err, stdout.String())\n\t}\n\tif files := treeFiles(t, home); len(files) != 0 {\n\t\tt.Fatalf(\"install wrote under home: %v\", files)\n\t}\n\tif files := treeFiles(t, filepath.Join(top, \"pkg\")); len(files) != 0 {\n\t\tt.Fatalf(\"install wrote under the working subdirectory: %v\", files)\n\t}\n}\n\nfunc TestSkillStatusReportsProjectInstallAsCurrent(t *testing.T) {\n\tisolateSkillHome(t)\n\ttop := chdirToNewRepoSubdir(t)\n\n\tvar stdout, stderr bytes.Buffer\n\tcode, err := ExecuteContext(t.Context(), []string{\"skill\", \"status\"}, &stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"status code=%d err=%v stderr=%s\", code, err, stderr.String())\n\t}\n\tprojectPath := filepath.Join(top, \".agents\", \"skills\", \"roast\")\n\tif !strings.Contains(stdout.String(), \"agents\\tnot_installed\\t\"+projectPath) {\n\t\tt.Fatalf(\"status before install = %q\", stdout.String())\n\t}\n\n\tstdout.Reset()\n\tcode, err = ExecuteContext(t.Context(), []string{\"skill\", \"install\"}, &stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"install code=%d err=%v stderr=%s\", code, err, stderr.String())\n\t}\n\n\tstdout.Reset()\n\tcode, err = ExecuteContext(t.Context(), []string{\"skill\", \"status\"}, &stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"status code=%d err=%v stderr=%s\", code, err, stderr.String())\n\t}\n\tfor _, line := range strings.Split(strings.TrimSpace(stdout.String()), \"\\n\") {\n\t\tfields := strings.Split(line, \"\\t\")\n\t\tif len(fields) < 3 || fields[1] != \"up_to_date\" || !strings.HasPrefix(fields[2], top+string(filepath.Separator)) {\n\t\t\tt.Fatalf(\"status after install line = %q\", line)\n\t\t}\n\t}\n\tif !strings.Contains(stdout.String(), \"agents\\tup_to_date\\t\"+projectPath) {\n\t\tt.Fatalf(\"status after install = %q\", stdout.String())\n\t}\n}\n\nfunc TestSkillCommandsOutsideGitNeedGlobalOrDir(t *testing.T) {\n\tisolateSkillHome(t)\n\tt.Chdir(t.TempDir())\n\tfor _, sub := range []string{\"install\", \"status\"} {\n\t\tvar stdout, stderr bytes.Buffer\n\t\tcode, _ := ExecuteContext(t.Context(), []string{\"skill\", sub}, &stdout, &stderr)\n\t\tif code != ExitUsage {\n\t\t\tt.Fatalf(\"skill %s outside git code=%d stdout=%s stderr=%s\", sub, code, stdout.String(), stderr.String())\n\t\t}\n\t}\n}\n\nfunc TestSkillGlobalUsesUserLevelDirectories(t *testing.T) {\n\thome := isolateSkillHome(t)\n\ttop := chdirToNewRepoSubdir(t)\n\n\tvar stdout, stderr bytes.Buffer\n\tcode, err := ExecuteContext(t.Context(), []string{\"skill\", \"install\", \"--global\"}, &stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"install code=%d err=%v stderr=%s\", code, err, stderr.String())\n\t}\n\tif _, err := os.Stat(filepath.Join(home, \".agents\", \"skills\", \"roast\", \"SKILL.md\")); err != nil {\n\t\tt.Fatalf(\"global skill not installed: %v; stdout=%s\", err, stdout.String())\n\t}\n\tif _, err := os.Stat(filepath.Join(top, \".agents\")); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"--global wrote into the project: %v\", err)\n\t}\n\n\tstdout.Reset()\n\tcode, err = ExecuteContext(t.Context(), []string{\"skill\", \"status\", \"--global\"}, &stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"status code=%d err=%v stderr=%s\", code, err, stderr.String())\n\t}\n\tglobalPath := filepath.Join(home, \".agents\", \"skills\", \"roast\")\n\tif !strings.Contains(stdout.String(), \"agents\\tup_to_date\\t\"+globalPath) {\n\t\tt.Fatalf(\"status --global = %q\", stdout.String())\n\t}\n\n\tstdout.Reset()\n\tcode, err = ExecuteContext(t.Context(), []string{\"skill\", \"status\"}, &stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"status code=%d err=%v stderr=%s\", code, err, stderr.String())\n\t}\n\tif !strings.Contains(stdout.String(), \"agents\\tnot_installed\\t\"+filepath.Join(top, \".agents\", \"skills\", \"roast\")) {\n\t\tt.Fatalf(\"project status after --global install = %q\", stdout.String())\n\t}\n}\n\nfunc TestSkillDirLimitsToOneParentWithAndWithoutGlobal(t *testing.T) {\n\tfor _, extra := range [][]string{nil, {\"--global\"}} {\n\t\thome := isolateSkillHome(t)\n\t\ttop := chdirToNewRepoSubdir(t)\n\t\tparent :