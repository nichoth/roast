nfiguredRoot() = %q\", got)\n\t}\n}\npackage cli\n\nimport (\n\t\"bytes\"\n\t\"io/fs\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestSkillInstallAndStatusCommands(t *testing.T) {\n\tparent := t.TempDir()\n\tvar stdout, stderr bytes.Buffer\n\tcode, err := ExecuteContext(t.Context(), []string{\"skill\", \"install\", \"--dir\", parent}, &stdout, &stderr)\n\tif err != nil || code != ExitClean {\n\t\tt.Fatalf(\"install code=%d err=%v stdout=%s stderr=%s\", code, err, stdout.String(), stderr.String())\n\t}\n\tif !strings.Contains(stdout.String(), filepath.Join(parent, \"roast\")) {\n\t\tt.Fatalf(\"install output = %q\", stdout.String())\n\t}\n\n\tstdout.Reset()\n\tcode, err = ExecuteContext(t.Context(), []string{\"skill\", \"status\", \"--dir\", parent}, &stdout, &stderr)\n\tif err != nil || code != ExitClean || !strings.HasPrefix(stdout.String(), \"custom\\tup_to_date\\t\") {\n\t\tt.Fatalf(\"status code=%d err=%v stdout=%s stderr=%s\", code, err, stdout.String(), stderr.String())\n\t}\n}\n\n// isolateSkillHome points every user-level skill location at an empty\n// temporary home so tests can prove nothing is written there.\nfunc isolateSkillHome(t *testing.T) string {\n\tt.Helper()\n\thome := t.TempDir()\n\tt.Setenv(\"HOME\", home)\n\tt.Setenv(\"CLAUDE_CONFIG_DIR\", \"\")\n\tt.Setenv(\"XDG_CONFIG_HOME\", \"\")\n\treturn home\n}\n\n// chdirToNewRepoSubdir creates a Git repository with a nested directory,\n// changes into that directory, and returns the resolved Git toplevel.\nfunc chdirToNewRepoSubdir(t *testing.T) string {\n\tt.Helper()\n\trepo := t.TempDir()\n\tgitPath, err := exec.LookPath(\"git\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcmd := exec.Command(gitPath, \"-C\", repo, \"init\")\n\tif output, err := cmd.CombinedOutput(); err != nil {\n\t\tt.Fatalf(\"git init: %v: %s\", err, output)\n\t}\n\ttop, err := filepath.EvalSymlinks(repo)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsub := filepath.Join(top, \"pkg\", \