{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KoswbwdH9G5ksmN4unWGoU","type":"tool_result","content":"./\n../\nts-rewrite/\n./.scratch/ts-rewrite/spec/14-doctor-init-skill.md\ninternal/skill/assets/roast/SKILL.md\n// Package skill installs and inspects Roast's embedded agent skill.\npackage skill\n\nimport (\n\t\"bytes\"\n\t\"embed\"\n\t\"fmt\"\n\t\"io/fs\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strings\"\n)\n\nconst assetRoot = \"assets/roast\"\n\n//go:embed all:assets/roast\nvar assets embed.FS\n\n// State describes the installed skill's relationship to this binary.\ntype State string\n\nconst (\n\tNotInstalled State = \"not_installed\"\n\tSymlink      State = \"symlink\"\n\tUpToDate     State = \"up_to_date\"\n\tStale        State = \"stale\"\n)\n\n// Status is the result of inspecting one skill installation.\ntype Status struct {\n\tState State\n\tPath  string\n\tStale []string\n}\n\n// InstallationTarget is one harness-visible parent directory for the skill.\ntype InstallationTarget struct {\n\tHarness string\n\tParent  string\n\tPath    string\n}\n\n// DefaultParent returns the shared user-level skill directory used by Codex and\n// other agents which implement the Agent Skills convention.\nfunc DefaultParent() (string, error) {\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"resolve user home: %w\", err)\n\t}\n\treturn filepath.Join(home, \".agents\", \"skills\"), nil\n}\n\n// Target returns the roast skill directory below parent. An empty parent uses\n// DefaultParent.\nfunc Target(parent string) (string, error) {\n\tif parent == \"\" {\n\t\tvar err error\n\t\tparent, err = DefaultParent()\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t}\n\treturn filepath.Join(parent, \"roast\"), nil\n}\n\n// InstallationTargets returns the explicit --dir target when parent is set.\n// Otherwise it returns the project's agent skill directories below\n// projectRoot, or the user-level directories when projectRoot is empty.\nfunc InstallationTargets(parent, projectRoot string) ([]InstallationTarget, error) {\n\tif parent != \"\" {\n\t\tpath, err := Target(parent)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\treturn []InstallationTarget{{Harness: \"custom\", Parent: parent, Path: path}}, nil\n\t}\n\thome, err := os.UserHomeDir()\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"resolve user home: %w\", err)\n\t}\n\tclaudeRoot := configuredRoot(home, os.Getenv(\"CLAUDE_CONFIG_DIR\"), \".claude\")\n\tclaudePresent := claudeDetected(claudeRoot)\n\tif projectRoot != \"\" {\n\t\tprojectClaude := filepath.Join(projectRoot, \".claude\")\n\t\treturn projectTargets(projectRoot, claudePresent || directoryExists(projectClaude)), nil\n\t}\n\tconfigRoot := configuredRoot(home, os.Getenv(\"XDG_CONFIG_HOME\"), \".config\")\n\tpolytokenRoot := filepath.Join(configRoot, \"polytoken\")\n\tpolytokenPresent := directoryExists(polytokenRoot)\n\tif !polytokenPresent {\n\t\t_, polytokenErr := exec.LookPath(\"polytoken\")\n\t\tpolytokenPresent = polytokenErr == nil\n\t}\n\treturn installationTargets(home, claudeRoot, claudePresent, polytokenRoot, polytokenPresent), nil\n}\n\nfunc claudeDetected(claudeRoot string) bool {\n\tif os.Getenv(\"CLAUDE_CONFIG_DIR\") != \"\" || directoryExists(claudeRoot) {\n\t\treturn true\n\t}\n\t_, err := exec.LookPath(\"claude\")\n\treturn err == nil\n}\n\n// projectTargets returns the agent skill directories inside a project. The\n// shared .agents/skills location is always included; .claude/skills is\n// included when Claude Code is in use.\nfunc projectTargets(root string, claudePresent bool) []InstallationTarget {\n\tparents := []InstallationTarget{{Harness: \"agents\", Parent: filepath.Join(root, \".agents\", \"skills\")}}\n\tif claudePresent {\n\t\tparents = append(parents, InstallationTarget{Harness: \"claude\", Parent: filepath.Join(root, \".claude\", \"skills\")})\n\t}\n\treturn finalizeTargets(parents)\n}\n\nfunc installationTargets(home, claudeRoot string, claudePresent bool, polytokenRoot string, polytokenPresent bool) []InstallationTarget {\n\tparents := []InstallationTarget{{Harness: \"agents\", Parent: filepath.Join(home, \".agents\", \"skills\")}}\n\tif claudePresent {\n\t\tparents = append(parents, InstallationTarget{Harness: \"claude\", Parent: filepath.Join(claudeRoot, \"skills\")})\n\t}\n\tif polytokenPresent {\n\t\tparents = append(parents, InstallationTarget{Harness: \"polytoken\", Parent: filepath.Join(polytokenRoot, \"skills\")})\n\t}\n\treturn finalizeTargets(parents)\n}\n\nfunc finalizeTargets(parents []InstallationTarget) []InstallationTarget {\n\tseen := make(map[string]bool, len(parents))\n\tout := make([]InstallationTarget, 0, len(parents))\n\tfor _, target := range parents {\n\t\ttarget.Parent = filepath.Clean(target.Parent)\n\t\ttarget.Path = filepath.Join(target.Parent, \"roast\")\n\t\tif seen[target.Path] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[target.Path] = true\n\t\tout = append(out, target)\n\t}\n\treturn out\n}\n\nfunc configuredRoot(home, override, fallback string) string {\n\tswitch {\n\tcase override == \"\":\n\t\treturn filepath.Join(home, fallback)\n\tcase override == \"~\":\n\t\treturn home\n\tcase strings.HasPrefix(override, \"~/\"):\n\t\treturn filepath.Join(home, override[2:])\n\tdefault:\n\t\treturn filepath.Clean(override)\n\t}\n}\n\nfunc directoryExists(path string) bool {\n\tinfo, err := os.Stat(path)\n\treturn err == nil && info.IsDir()\n}\n\nfunc embeddedFiles() (map[string][]byte, error) {\n\tfiles := make(map[string][]byte)\n\terr := fs.WalkDir(assets, assetRoot, func(path string, entry fs.DirEntry, walkErr error) error {\n\t\tif walkErr != nil {\n\t\t\treturn walkErr\n\t\t}\n\t\tif entry.IsDir() {\n\t\t\treturn nil\n\t\t}\n\t\tdata, err := assets.ReadFile(path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\trel, err := filepath.Rel(assetRoot, path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tfiles[rel] = data\n\t\treturn nil\n\t})\n\treturn files, err\n}\n\n// Inspect reports whether target contains the skill embedded in this binary.\nfunc Inspect(target string) (Status, error) {\n\tstatus := Status{State: NotInstalled, Path: target}\n\tinfo, err := os.Lstat(target)\n\tif os.IsNotExist(err) {\n\t\treturn status, nil\n\t}\n\tif err != nil {\n\t\treturn status, fmt.Errorf(\"stat skill directory %s: %w\", target, err)\n\t}\n\tif info.Mode()&os.ModeSymlink != 0 {\n\t\tstatus.State = Symlink\n\t\treturn status, nil\n\t}\n\tif !info.IsDir() {\n\t\treturn status, fmt.Errorf(\"skill path %s is not a directory\", target)\n\t}\n\n\tfiles, err := embeddedFiles()\n\tif err != nil {\n\t\treturn status, fmt.Errorf(\"read embedded skill: %w\", err)\n\t}\n\tfor rel, want := range files {\n\t\tgot, readErr := os.ReadFile(filepath.Join(target, rel))\n\t\tif readErr != nil || !bytes.Equal(got, want) {\n\t\t\tstatus.Stale = append(status.Stale, rel)\n\t\t}\n\t}\n\tsort.Strings(status.Stale)\n\tif len(status.Stale) > 0 {\n\t\tstatus.State = Stale\n\t} else {\n\t\tstatus.State = UpToDate\n\t}\n\treturn status, nil\n}\n\n// Install writes the embedded skill into target. Existing differing files are\n// preserved unless force is true. A symlinked target is treated as a developer\n// checkout and is never modified.\nfunc Install(target string, force bool) (Status, error) {\n\tstatus, err := Inspect(target)\n\tif err != nil {\n\t\treturn status, err\n\t}\n\tswitch status.State {\n\tcase Symlink, UpToDate:\n\t\treturn status, nil\n\tcase Stale:\n\t\tif !force {\n\t\t\treturn status, fmt.Errorf(\"skill files differ; re-run with --force to overwrite\")\n\t\t}\n\t}\n\n\tfiles, err := embeddedFiles()\n\tif err != nil {\n\t\treturn status, fmt.Errorf(\"read embedded skill: %w\", err)\n\t}\n\tif err := os.MkdirAll(target, 0o755); err != nil {\n\t\treturn status, fmt.Errorf(\"create skill directory %s: %w\", target, err)\n\t}\n\tpaths := make([]string, 0, len(files))\n\tfor rel := range files {\n\t\tpaths = append(paths, rel)\n\t}\n\tsort.Strings(paths)\n\tfor _, rel := range paths {\n\t\tdestination := filepath.Join(target, rel)\n\t\tif info, statErr := os.Lstat(destination); statErr == nil && info.Mode()&os.ModeSymlink != 0 {\n\t\t\treturn status, fmt.Errorf(\"refusing to overwrite symlink %s\", destination)\n\t\t} else if statErr != nil && !os.IsNotExist(statErr) {\n\t\t\treturn status, fmt.Errorf(\"stat %s: %w\", destination, statErr)\n\t\t}\n\t\tif err := os.MkdirAll(filepath.Dir(destination), 0o755); err != nil {\n\t\t\treturn status, fmt.Errorf(\"create skill directory: %w\", err)\n\t\t}\n\t\tif err := os.WriteFile(destination, files[rel], 0o644); err != nil {\n\t\t\treturn status, fmt.Errorf(\"write skill file %s: %w\", destination, err)\n\t\t}\n\t}\n\treturn Inspect(target)\n}\npackage cli\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"strings\"\n\n\t\"github.com/spf13/cobra\"\n\n\t\"github.com/bluesky-social/roast/internal/scope\"\n\t\"github.com/bluesky-social/roast/internal/skill\"\n)\n\n// skillTargets resolves where skill commands operate: --dir wins, then\n// --global selects the user-level directories, and otherwise the project's\n// agent skill directories at the Git toplevel are used.\nfunc skillTargets(parent string, global bool) ([]skill.InstallationTarget, error) {\n\tif parent != \"\" || global {\n\t\treturn skill.InstallationTargets(parent, \"\")\n\t}\n\troot, err := scope.GitRoot(\".\")\n\tif err != nil {\n\t\treturn nil, &usageError{msg: err.Error() + \"; run inside a project or pass --global\"}\n\t}\n\treturn skill.InstallationTargets(\"\", root)\n}\n\nfunc newSkillCommand(stdout io.Writer) *cobra.Command {\n\tcmd := &cobra.Command{\n\t\tUse:           \"skill\",\n\t\tShort:         \"Manage the Roast agent skill\",\n\t\tArgs:          noArgs,\n\t\tSilenceUsage:  true,\n\t\tSilenceErrors: true,\n\t\tRunE:          showHelp,\n\t}\n\tcmd.AddCommand(newSkillInstallCommand(stdout), newSkillStatusCommand(stdout))\n\treturn cmd\n}\n\nfunc newSkillInstallCommand(stdout io.Writer) *cobra.Command {\n\tvar parent string\n\tvar force, global bool\n\tcmd := &cobra.Command{\n\t\tUse:           \"install\",\n\t\tShort:         \"Install the Roast agent skill\",\n\t\tArgs:          noArgs,\n\t\tSilenceUsage:  true,\n\t\tSilenceErrors: true,\n\t\tRunE: func(_ *cobra.Command, _ []string) error {\n\t\t\ttargets, err := skillTargets(parent, global)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tbefore := make([]skill.Status, len(targets))\n\t\t\tfor i, target := range targets {\n\t\t\t\tbefore[i], err = skill.Inspect(target.Path)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n\t\t\t\tif before[i].State == skill.Stale && !force {\n\t\t\t\t\treturn fmt.Errorf(\"%s skill files differ (%s); re-run with --force to overwrite\", target.Harness, strings.Join(before[i].Stale, \", \"))\n\t\t\t\t}\n\t\t\t}\n\t\t\tfor i, target := range targets {\n\t\t\t\tafter, installErr := skill.Install(target.Path, force)\n\t\t\t\tif installErr != nil {\n\t\t\t\t\treturn installErr\n\t\t\t\t}\n\t\t\t\tswitch before[i].State {\n\t\t\t\tcase skill.Symlink:\n\t\t\t\t\tfmt.Fprintf(stdout, \"%s\\tsymlink (development install), left unchanged\\t%s\\n\", target.Harness, target.Path)\n\t\t\t\tcase skill.UpToDate:\n\t\t\t\t\tfmt.Fprintf(stdout, \"%s\\talready up to date\\t%s\\n\", target.Harness, target.Path)\n\t\t\t\tdefault:\n\t\t\t\t\tfmt.Fprintf(stdout, \"%s\\tinstalled (%s)\\t%s\\n\", target.Harness, after.State, target.Path)\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn nil\n\t\t},\n\t}\n\tcmd.Flags().StringVar(&parent, \"dir\", \"\", \"install only below this parent skills directory; /roast is appended\")\n\tcmd.Flags().BoolVar(&global, \"global\", false, \"install into the user-level skill directories instead of the project\")\n\tcmd.Flags().BoolVar(&force, \"force\", false, \"overwrite installed skill files that differ\")\n\treturn cmd\n}\n\nfunc newSkillStatusCommand(stdout io.Writer) *cobra.Command {\n\tvar parent string\n\tvar global bool\n\tcmd := &cobra.