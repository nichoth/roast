+++ b/src/cli/runs-format.ts
@@ -0,0 +1,30 @@
+// pattern: Functional Core
+
+function pad (value:string, width:number):string {
+    return value + ' '.repeat(Math.max(0, width - [...value].length))
+}
+
+export function formatRunLine (line:string):string|null {
+    let value:unknown
+    try { value = JSON.parse(line) } catch { return null }
+    if (value !== null &&
+        (typeof value !== 'object' || Array.isArray(value))) return null
+    const run = (value ?? {}) as Record<string, unknown>
+    for (const key of ['ts', 'run_id', 'repo', 'mode', 'assessment']) {
+        if (run[key] != null && typeof run[key] !== 'string') return null
+    }
+    if (run.quick != null && typeof run.quick !== 'boolean') return null
+    for (const key of ['n_findings', 'n_refuted']) {
+        if (run[key] != null && !Number.isInteger(run[key])) return null
+    }
+    const files = run.files_reviewed ?? []
+    if (!Array.isArray(files) || files.some(file =>
+        file !== null && typeof file !== 'string')) return null
+
+    return `${run.ts ?? ''}  ${pad(String(run.run_id ?? ''), 25)} ` +
+        `${pad(String(run.mode ?? ''), 8)} ` +
+        `q=${pad(String(run.quick ?? false), 5)} ` +
+        `${pad(String(run.assessment ?? ''), 30)} ` +
+        `findings=${run.n_findings ?? 0} refuted=${run.n_refuted ?? 0} ` +
+        `files=${files.length}  ${run.repo ?? ''}\n`
+}
diff --git a/src/cli/runs.ts b/src/cli/runs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2abe39fd8769a7fc01d18f633a2aa5a23e2b0fa9
--- /dev/null
+++ b/src/cli/runs.ts
@@ -0,0 +1,126 @@
+// pattern: Imperative Shell
+import fs from 'node:fs/promises'
+import { createReadStream } from 'node:fs'
+import path from 'node:path'
+import { compareBytes } from '../gocompat/strings.js'
+import { recordDir } from '../record/dir.js'
+import { reportPath } from '../record/meta.js'
+import { textBytes } from '../textsafe/textsafe.js'
+import type { CommandDef } from './command.js'
+import { UsageError } from './errors.js'
+import { formatRunLine } from './runs-format.js'
+
+const MAX_SCAN_BYTES = 16 * 1024 * 1024
+
+async function * scanLines (file:string):AsyncGenerator<Buffer> {
+    const stream = createReadStream(file)
+    let parts:Array<Buffer> = []
+    let size = 0
+    try {
+        for await (const chunk of stream) {
+            const data = chunk as Buffer
+            let start = 0
+            let end:number
+            while ((end = data.indexOf(10, start)) !== -1) {
+                size += end - start
+                if (size >= MAX_SCAN_BYTES) return
+                parts.push(data.subarray(start, end))
+                const line = Buffer.concat(parts, size)
+                yield line.at(-1) === 13 ? line.subarray(0, -1) : line
+                parts = []
+                size = 0
+                start = end + 1
+            }
+            size += data.length - start
+            if (size >= MAX_SCAN_BYTES) return
+            if (start < data.length) parts.push(data.subarray(start))
+        }
+        if (size) {
+            const line = Buffer.concat(parts, size)
+            yield line.at(-1) === 13 ? line.subarray(0, -1) : line
+        }
+    } catch {
+        // Unreadable monthly files do not hide later months.
+    } finally {
+        stream.destroy()
+    }
+}
+
+async function runLines (dir:string, limit:number):Promise<Array<Buffer>> {
+    let names:Array<string>
+    try {
+        names = (await fs.readdir(dir)).filter(name =>
+            name.startsWith('runs-') && name.endsWith('.jsonl'))
+            .sort(compareBytes)
+    } catch { return [] }
+    const lines:Array<Buffer> = []
+    for (const name of names) {
+        for await (const line of scanLines(path.join(dir, name))) {
+            lines.push(line)
+        }
+    }
+    return limit > 0 ? lines.slice(-limit) : lines
+}
+
+export const runsCommand:CommandDef = {
+    command:'runs',
+    describe:'Show and inspect local review runs',
+    subcommands:[{
+        command:'show <run-id>',
+        describe:"Print a run's Markdown report",
+        builder:y => y.positional('run-id', { type:'string' }),
+        handler:async (args, ctx) => {
+            const dir = await recordDir(ctx.cwd, {
+                env:ctx.env,
+                signal:ctx.signal,
+            })
+            const file = await reportPath(dir, String(args['run-id']))
+            let content:Buffer
+            try {
+                content = await fs.readFile(file)
+            } catch (err) {
+                throw new Error('run has no report artifact', { cause:err })
+            }
+            ctx.stdout.write(textBytes(content))
+        },
+    }],
+    builder:y => y.option('limit', {
+        type:'string',
+        default:'20',
+        describe:'Maximum runs to show',
+    }).option('json', {
+        type:'boolean',
+        default:false,
+        describe:'Emit raw JSONL records',
+    }),
+    handler:async (args, ctx) => {
+        const raw = String(args.limit)
+        if (!/^[+-]?\d+$/.test(raw) ||
+            BigInt(raw) < -(1n << 63n) || BigInt(raw) >= (1n << 63n)) {
+            throw new UsageError(`invalid --limit ${JSON.stringify(raw)}: ` +
+                'expected a decimal integer')
+        }
+        const limit = Number(raw)
+        const dir = await recordDir(ctx.cwd, {
+            env:ctx.env,
+            signal:ctx.signal,
+        })
+        if (!dir) {
+            throw new UsageError('cannot resolve record directory: ' +
+                'run inside a Git repository')
+        }
+        const lines = await runLines(dir, limit)
+        if (!lines.length) {
+            ctx.stderr.write(`roast: no run records in ${dir}\n`)
+        }
+        for (const line of lines) {
+            if (args.json) {
+                ctx.stdout.write(line)
+                ctx.stdout.write('\n')
+            } else {
+                const formatted = formatRunLine(line.toString('utf8'))
+                if (formatted !== null) ctx.stdout.write(formatted)
+            }
+        }
+    },
+}
diff --git a/test/cli/runs.ts b/test/cli/runs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3a91080c7c6fe88cb97f0b6f39a3f016a5be4188
--- /dev/null
+++ b/test/cli/runs.ts
@@ -0,0 +1,233 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { runRoast } from '../helpers/run.js'
+import { recordRepo } from '../record/repo.js'
+import { tempDir } from '../helpers/repo.js'
+import { makeRunDir, recordDir } from '../../src/record/dir.js'
+import { appendRunLine } from '../../src/record/index-file.js'
+import { writeReport } from '../../src/record/meta.js'
+import { report } from '../render/fixtures.js'
+import type { TempDir } from '../helpers/repo.js'
+
+async function indexMonth (
+    repo:TempDir,
+    month:number,
+    runId:string
+):Promise<string> {
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    await appendRunLine(dir, report({ runId }), repo.dir, [],
+        new Date(2026, month - 1, 15))
+    return path.join(dir, `runs-2026-${String(month).padStart(2, '0')}.jsonl`)
+}
+
+test('runs with no records succeeds without creating state', async t => {
+    const repo = recordRepo(t)
+    const res = await runRoast(['runs'], { cwd:repo.dir, env:repo.env })
+    t.equal(res.code, 0, 'exits 0')
+    t.equal(res.stdout, '', 'stdout is empty')
+    t.ok(res.stderr.length > 0, 'reports the empty index on stderr')
+    t.ok(!(await fs.readdir(repo.dir)).includes('.roast'),
+        'listing does not create state')
+})
+
+test('runs outside a Git repository is a usage error', async t => {
+    recordRepo(t)
+    const outside = tempDir()
+    t.cleanup(outside.remove)
+    const res = await runRoast(['runs', '--error-format=json'], {
+        cwd:outside.dir,
+        env:outside.env,
+    })
+    t.equal(res.code, 2, 'exits 2')
+    t.equal(res.stdout, '', 'stdout is empty')
+    t.equal(JSON.parse(res.stderr).error_category, 'usage')
+})
+
+test('runs rejects removed subcommands and other positionals', async t => {
+    const repo = recordRepo(t)
+    for (const arg of ['sync', 'status', 'bogus', '123', '--']) {
+        const args = arg === '--' ? ['--', 'extra'] : [arg]
+        const res = await runRoast(['runs', ...args], {
+            cwd:repo.dir,
+            env:repo.env,
+        })
+        t.equal(res.code, 2, `${args.join(' ')} exits 2`)
+        t.equal(res.stdout, '', 'stdout is empty')
+    }
+})
+
+test('runs JSON tails raw lines across monthly indexes', async t => {
+    const repo = recordRepo(t)
+    const newer = await indexMonth(repo, 11, 'newer')
+    await indexMonth(repo, 10, 'older')
+    const valid = await fs.readFile(newer, 'utf8')
+    const invalid = '  { malformed JSON, preserved verbatim }  '
+    await fs.appendFile(newer, invalid + '\n')
+    const res = await runRoast(['runs', '--json', '--limit', '2'], {
+        cwd:repo.dir,
+        env:repo.env,
+    })
+    t.equal(res.code, 0, 'exits 0')
+    t.equal(res.stdout, valid + invalid + '\n', 'last two raw lines')
+    t.equal(res.stderr, '', 'no diagnostic for malformed JSON')
+})
+
+test('runs formats parseable index records and skips malformed lines',
+    async t => {
+        const repo = recordRepo(t)
+        const file = await indexMonth(repo, 10, 'first')
+        await indexMonth(repo, 11, 'second')
+        await fs.appendFile(file, 'not json\n{"run_id":false}\n')
+        const res = await runRoast(['runs'], {
+            cwd:repo.dir,
+            env:repo.env,
+        })
+        t.equal(res.code, 0, 'exits 0')
+        const lines = res.stdout.trimEnd().split('\n')
+        t.equal(lines.length, 2, 'one line per valid record')
+        t.ok(lines[0].includes('first'), 'older run is first')
+        t.ok(lines[1].includes('second'), 'newer run follows')
+        t.ok(lines.every(line => line.includes('findings=1 refuted=0')),
+            'includes counts from index')
+    })
+
+test('runs defaults to twenty records and nonpositive limits list all',
+    async t => {
+        const repo = recordRepo(t)
+        const file = await indexMonth(repo, 10, 'run-0')
+        const dir = path.dirname(file)
+        for (let i = 1; i < 23; i++) {
+            await appendRunLine(dir, report({ runId:`run-${i}` }),
+                repo.dir, [], new Date(2026, 9, 15))
+        }
+        const all = await fs.readFile(file, 'utf8')
+        for (const limit of ['0', '-1', '+0']) {
+            const res = await runRoast(['runs', '--json', '--limit', limit],
+                { cwd:repo.dir, env:repo.env })
+            t.equal(res.code, 0, `${limit} exits 0`)
+            t.equal(res.stdout, all, `${limit} lists all records`)
+        }
+        const res = await runRoast(['runs', '--json'], {
+            cwd:repo.dir,
+            env:repo.env,
+        })
+        t.equal(res.code, 0)
+        t.equal(res.stdout.split('\n').length - 1, 20)
+        t.equal(JSON.parse(res.stdout.split('\n')[0]).run_id, 'run-3')
+    })
+
+test('runs scanner strips one CR and preserves empty and final lines',
+    async t => {
+        const repo = recordRepo(t)
+        const file = await indexMonth(repo, 10, 'first')
+        const line = (await fs.readFile(file, 'utf8')).trimEnd()
+        await fs.writeFile(file, line + '\r\n\nlast\r\r')
+        const res = await runRoast(['runs', '--json', '--limit', '0'], {
+            cwd:repo.dir,
+            env:repo.env,
+        })
+        t.equal(res.code, 0)
+        t.equal(res.stdout, line + '\n\nlast\r\n')
+    })
+
+test('runs show prints the stored report without appending anything',
+    async t => {
+        const repo = recordRepo(t)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const markdown = '# Review\n\nA stored report with no final newline.'
+        await writeReport(dir, 'run-abcdef', markdown)
+        const subdir = path.join(repo.dir, 'nested')
+        await fs.mkdir(subdir)
+        for (const id of ['run-abcdef', 'run-abc']) {
+            const res = await runRoast(['runs', 'show', id], {
+                cwd:subdir,
+                env:repo.env,
+            })
+            t.equal(res.code, 0, `${id} exits 0`)
+            t.equal(res.stdout, markdown, 'exact report roundtrip')
+            t.equal(res.stderr, '', 'no diagnostics')
+        }
+    })
+
+test('runs show visibly escapes stored terminal controls', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    const file = await writeReport(dir, 'unsafe',
+        'a\u001b[31m\u0007\u009b\n\tend')
+    await fs.appendFile(file, Buffer.from([0x9b]))
+    const res = await runRoast(['runs', 'show', 'unsafe'], {
+        cwd:repo.dir,
+        env:repo.env,
+    })
+    t.equal(res.code, 0)
+    t.ok(![...res.stdout].some(ch => {
+        const cp = ch.codePointAt(0)!
+        return cp === 0x1b || cp === 7 || (cp >= 0x80 && cp <= 0x9f)
+    }), 'no ESC, BEL or C1 controls reach stdout')
+    t.equal(res.stdout, 'a\\x1b[31m\\x07\\u009b\n\tend\\x9b',
+        'controls and invalid bytes remain visible')
+})
+
+test('runs show requires exactly one run ID', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    await writeReport(dir, 'first', 'must not print')
+    for (const ids of [[], ['first', 'second']]) {
+        const res = await runRoast([
+            'runs', 'show', ...ids, '--error-format=json',
+        ], { cwd:repo.dir, env:repo.env })
+        t.equal(res.code, 2)
+        t.equal(res.stdout, '')
+        t.equal(JSON.parse(res.stderr).error_category, 'usage')
+    }
+})
+
+test('runs show rejects traversal IDs before reading outside reports',
+    async t => {
+        const repo = recordRepo(t)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        await writeReport(dir, 'valid', 'inside')
+        const outside = path.join(repo.dir, '.roast', 'report.md')
+        await fs.writeFile(outside, 'outside sentinel')
+        const before = await fs.readdir(dir)
+        for (const id of ['..', 'a/b', '.', 'a\\b']) {
+            const res = await runRoast(['runs', 'show', id], {
+                cwd:repo.dir,
+                env:repo.env,
+            })
+            t.equal(res.code, 4, `${id} is a plain error`)
+            t.equal(res.stdout, '', 'no outside report is printed')
+        }
+        t.equal(await fs.readFile(outside, 'utf8'), 'outside sentinel')
+        t.deepEqual(await fs.readdir(dir), before, 'state unchanged')
+    })
+
+test('runs show fails for missing reports and unresolved IDs', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    await makeRunDir(dir, 'missing-report')
+    await writeReport(dir, 'ambiguous-a', 'first')
+    await writeReport(dir, 'ambiguous-b', 'second')
+    for (const id of ['missing-report', 'absent', 'ambiguous']) {
+        const res = await runRoast(['runs', 'show', id], {
+            cwd:repo.dir,
+            env:repo.env,
+        })
+        t.equal(res.code, 4, `${id} exits 4`)
+        t.equal(res.stdout, '', 'prints no report')
+    }
+})
+
+test('runs limit accepts only signed decimal integers', async t => {
+    const repo = recordRepo(t)
+    await indexMonth(repo, 10, 'valid')
+    for (const limit of ['1.0', '1e3', '0x10', 'NaN', '1.5', '',
+        '9223372036854775808']) {
+        const res = await runRoast([
+            'runs', '--json', `--limit=${limit}`, '--error-format=json',
+        ], { cwd:repo.dir, env:repo.env })
+        t.equal(res.code, 2, `${JSON.stringify(limit)} is a usage error`)
+        t.equal(res.stdout, '')
+    }
+})
