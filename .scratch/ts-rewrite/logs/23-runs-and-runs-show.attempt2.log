// `roast ignore` (spec 12, 2.13): /.roast/ in the toplevel .gitignore.
import fs from 'node:fs'
import path from 'node:path'
import { test } from '../helpers/test.js'
import { runRoast } from '../helpers/run.js'
import { gateRepo, read, scratch, type GateRepo } from '../gate/helpers.js'

function ignore (r:GateRepo, cwd = r.dir) {
    return runRoast(['ignore'], { cwd, env:r.env })
}

test('ignore creates the toplevel .gitignore', async t => {
    const r = gateRepo(t, false)
    const sub = path.join(r.dir, 'a', 'b')
    fs.mkdirSync(sub, { recursive:true })
    const res = await ignore(r, sub)
    t.equal(res.code, 0, `exits 0 ${res.stderr}`)
    t.equal(read(path.join(r.dir, '.gitignore')), '/.roast/\n', 'created')
    t.equal((fs.statSync(path.join(r.dir, '.gitignore')).mode & 0o777) &
        0o644, 0o644, 'readable by everyone')
    t.ok(!fs.existsSync(path.join(sub, '.gitignore')), 'not in the subdir')
})

test('ignore appends to an existing .gitignore', async t => {
    const cases:[string, string][] = [
        ['node_modules/\n', 'node_modules/\n/.roast/\n'],
        ['node_modules/\ndist', 'node_modules/\ndist\n/.roast/\n'],
        ['', '/.roast/\n'],
    ]
    for (const [before, after] of cases) {
        const r = gateRepo(t, false)
        const file = path.join(r.dir, '.gitignore')
        fs.writeFileSync(file, before)
        const res = await ignore(r)
        t.equal(res.code, 0, 'exits 0')
        t.equal(read(file), after, `${JSON.stringify(before)} appended`)
    }
})

test('ignore leaves an equivalent entry unchanged', async t => {
    for (const entry of ['/.roast/', '/.roast', '.roast/', '.roast',
        '  .roast/  ']) {
        const r = gateRepo(t, false)
        const file = path.join(r.dir, '.gitignore')
        const body = `dist\n${entry}\nnode_modules`
        fs.writeFileSync(file, body)
        const res = await ignore(r)
        t.equal(res.code, 0, 'exits 0')
        t.equal(read(file), body, `${JSON.stringify(entry)} kept as is`)
    }
})

test('ignore twice is idempotent', async t => {
    const r = gateRepo(t, false)
    await ignore(r)
    const once = read(path.join(r.dir, '.gitignore'))
    const res = await ignore(r)
    t.equal(res.code, 0, 'exits 0')
    t.equal(read(path.join(r.dir, '.gitignore')), once, 'unchanged')
})

test('ignore outside a repository is a usage error', async t => {
    const r = gateRepo(t, false)
    const outside = scratch(t)
    const res = await runRoast(['ignore'], { cwd:outside, env:r.env })
    t.equal(res.code, 2, 'exits 2')
    t.ok(!fs.existsSync(path.join(outside, '.gitignore')), 'writes nothing')
    const extra = await runRoast(['ignore', 'x'], { cwd:r.dir, env:r.env })
    t.equal(extra.code, 2, 'an extra argument exits 2')
})
import { tempRepo, type TempDir } from '../helpers/repo.js'
import type { CleanupTest } from '../helpers/test.js'

export function recordRepo (t:CleanupTest):TempDir {
    const repo = tempRepo()
    const cwd = process.cwd()
    const keys = ['HOME', 'XDG_CONFIG_HOME', 'CLAUDE_CONFIG_DIR']
    const previous = keys.map(key => process.env[key])
    for (const key of keys) process.env[key] = repo.env[key]
    process.chdir(repo.dir)
    t.cleanup(() => {
        process.chdir(cwd)
        keys.forEach((key, i) => {
            if (previous[i] === undefined) delete process.env[key]
            else process.env[key] = previous[i]
        })
        repo.remove()
    })
    return repo
}
// pattern: Imperative Shell
import path from 'node:path'
import fs from 'node:fs/promises'
import { git } from '../git/git.js'
import type { GitRunOpts } from '../git/git.js'
import { goTrimSpace } from '../gocompat/strings.js'

export const STATE_DIR = '.roast'

export class NoRecordDirError extends Error {
    constructor () {
        super('resolve record directory: run inside a Git repository')
        this.name = 'NoRecordDirError'
    }
}

export function isValidName (name:string):boolean {
    return name !== '' && name !== '.' && name !== '..' &&
        !name.includes('/') && !name.includes('\\') && !name.includes('\0')
}

export async function ensureDir (dir:string):Promise<void> {
    if (!dir) throw new NoRecordDirError()
    const state = path.dirname(dir)
    try {
        await fs.lstat(state)
    } catch (err) {
        if ((err as NodeJS.ErrnoException).code !== 'ENOENT') throw err
        await fs.mkdir(state, { recursive:true, mode:0o700 })
        await fs.writeFile(path.join(state, '.gitignore'), '*\n', {
            mode:0o644,
        })
    }
    await fs.mkdir(dir, { recursive:true, mode:0o700 })
}

export async function makeRunDir (
    dir:string,
    runId:string
):Promise<string> {
    if (!isValidName(runId)) {
        throw new Error(`invalid run id ${JSON.stringify(runId)}`)
    }
    await ensureDir(dir)
    const runDir = path.join(dir, runId)
    await fs.mkdir(runDir, { recursive:true, mode:0o700 })
    for (const target of [dir, runDir]) await fs.chmod(target, 0o700)
    return runDir
}

export async function openPrivate (
    file:string,
    flags:string|number
):Promise<fs.FileHandle> {
    const handle = await fs.open(file, flags, 0o600)
    try {
        await handle.chmod(0o600)
        return handle
    } catch (err) {
        await handle.close().catch(() => {})
        throw err
    }
}

export async function writePrivate (
    file:string,
    data:string|Uint8Array
):Promise<void> {
    const handle = await openPrivate(file, 'w')
    try {
        await handle.writeFile(data)
    } finally {
        await handle.close()
    }
}

export async function recordDir (
    cwd:string,
    opts:GitRunOpts = {}
):Promise<string> {
    try {
        const out = await git(cwd, ['rev-parse', '--show-toplevel'], opts)
        const top = goTrimSpace(out.toString())
        return top ? path.join(top, STATE_DIR, 'runs') : ''
    } catch (err) {
        if (opts.signal?.aborted) throw err
        return ''
    }
}
// pattern: Imperative Shell
import path from 'node:path'
import fs from 'node:fs/promises'
import { createReadStream } from 'node:fs'
import { ensureDir, openPrivate } from './dir.js'
import type { Report } from '../render/render.js'
import { runLine, priorLine, type PriorSighting } from './index-line.js'
import { rfc3339Local, compareBytes } from './json.js'
import type { Finding } from '../review/types.js'
import { fingerprint } from '../review/fingerprint.js'

export type { PriorSighting } from './index-line.js'

export async function appendRunLine (
    dir:string,
    report:Report,
    repo:string,
    argv:readonly string[]|null,
    now:Date = new Date()
):Promise<void> {
    if (!dir) return
    try {
        await ensureDir(dir)
        const line = runLine(report, path.resolve(repo), argv, now)
        const file = path.join(dir,
            `runs-${rfc3339Local(now).slice(0, 7)}.jsonl`)
        const handle = await openPrivate(file, 'a')
        try {
            await handle.writeFile(line)
        } finally {
            await handle.close()
        }
    } catch { /* The monthly index is strictly best effort. */ }
}

async function scanFile (
    file:string,
    repo:string,
    targets:ReadonlySet<string>,
    out:Map<string, PriorSighting>
):Promise<void> {
    const stream = createReadStream(file)
    let pending = Buffer.alloc(0)
    const max = 4 * 1024 * 1024
    try {
        for await (const chunk of stream) {
            pending = Buffer.concat([pending, chunk])
            let end:number
            while ((end = pending.indexOf(10)) !== -1) {
                if (end >= max) return
                priorLine(pending.subarray(0, end).toString(),
                    repo, targets, out)
                pending = pending.subarray(end + 1)
            }
            if (pending.length >= max) return
        }
        if (pending.length) priorLine(pending.toString(), repo, targets, out)
    } catch {
        // Unreadable monthly files do not block older files.
    } finally {
        stream.destroy()
    }
}

export async function seenBefore (
    dir:string,
    repoDir:string,
    findings:readonly Finding[],
    lookbackFiles:number = 3
):Promise<Map<string, PriorSighting>> {
    const out = new Map<string, PriorSighting>()
    if (!dir || !findings.length) return out
    const targets = new Set(findings.map(fingerprint))
    let entries
    try {
        entries = await fs.readdir(dir, { withFileTypes:true })
    } catch { return out }
    const files = entries.filter(e => !e.isDirectory() &&
        e.name.startsWith('runs-') && e.name.endsWith('.jsonl'))
        .map(e => e.name).sort((a, b) => compareBytes(b, a))
        .slice(0, lookbackFiles <= 0 ? 3 : lookbackFiles)
    for (const file of files) {
        await scanFile(path.join(dir, file), path.resolve(repoDir),
            targets, out)
        if (out.size === targets.size) break
    }
    return out
}
// pattern: Functional Core
import type { Report } from '../render/render.js'
import { toJSON } from '../render/render.js'
import { DROP } from '../review/types.js'
import { goStringify, rfc3339Local, sortedMap } from './json.js'
import { orderedMap, FIELDS } from './meta-json.js'

export type PriorSighting = { runTS:string; dropReason:string }

export function priorLine (
    line:string,
    repo:string,
    targets:ReadonlySet<string>,
    out:Map<string, PriorSighting>
):void {
    try {
        const raw:unknown = JSON.parse(line)
        if (raw === null || typeof raw !== 'object') return
        const r = raw as Record<string, unknown>
        if (r.repo !== repo || (r.ts != null && typeof r.ts !== 'string')) {
            return
        }
        const findings = [r.findings, r.dropped_findings]
            .flatMap(value => {
                if (value == null) return []
                if (!Array.isArray(value)) throw new Error('invalid findings')
                return value as unknown[]
            }).map(value => {
                if (value === null) return {}
                if (typeof value !== 'object') throw new Error('invalid item')
                const f = value as Record<string, unknown>
                for (const key of ['fingerprint', '_drop_reason']) {
                    if (f[key] != null && typeof f[key] !== 'string') {
                        throw new Error('invalid finding field')
                    }
                }
                return f
            })
        for (const f of findings) {
            const fp = f.fingerprint as string|undefined
            if (fp && targets.has(fp) && !out.has(fp)) {
                out.set(fp, {
                    runTS:(r.ts as string|null) ?? '',
                    dropReason:(f._drop_reason as string|null) ?? '',
                })
            }
        }
    } catch { /* Malformed index lines do not hide later valid lines. */ }
}

export function runLine (
    report:Report,
    repo:string,
    argv:readonly string[]|null,
    now:Date
):string {
    // Reuse the render area's ordered finding/usage representation,
    // without the transient annotation of prior sightings.
    const rendered = JSON.parse(toJSON({ ...report, prior:null }))
    return goStringify({
        ts:rfc3339Local(now),
        ...(report.runId ? { run_id:report.runId } : {}),
        repo,
        argv,
        mode:report.mode,
        quick:report.quick ?? false,
        verified:report.verified ?? false,
        assessment:report.result.assessment,
        n_findings:report.result.findings.length,
        n_dropped:report.result.dropped.length,
        n_refuted:report.result.dropped.filter(f =>
            f._drop_reason === DROP.REFUTED_BY_VERIFIER).length,
        files_reviewed:report.filesReviewed ?? null,
        findings:rendered.findings,
        dropped_findings:rendered.dropped_findings,
        usage:report.usage ? orderedMap(report.usage, FIELDS.usage) : null,
        prompt_packs:report.promptPacks ?? null,
        ...(report.budgets != null ?
            { budgets:sortedMap(report.budgets) } : {}),
    }) + '\n'
}

