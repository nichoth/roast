// pattern: Functional Core
import { parseTree, type ParseError } from 'jsonc-parser'

type RunSummary = {
    ts:string;
    run_id:string;
    repo:string;
    mode:string;
    assessment:string;
    quick:boolean;
    n_findings:bigint;
    n_refuted:bigint;
    files:number;
}

function pad (value:string, width:number):string {
    return value + ' '.repeat(Math.max(0, width - [...value].length))
}

export function formatRunLine (line:string):string|null {
    const errors:Array<ParseError> = []
    const root = parseTree(line, errors, {
        disallowComments:true,
        allowTrailingComma:false,
        allowEmptyContent:false,
    })
    if (errors.length || !root ||
        (root.type !== 'object' && root.type !== 'null')) return null
    const run:RunSummary = {
        ts:'',
        run_id:'',
        repo:'',
        mode:'',
        assessment:'',
        quick:false,
        n_findings:0n,
        n_refuted:0n,
        files:0,
    }
    // Decode every occurrence: a later valid value cannot hide an earlier
    // type error, and null leaves scalar fields unchanged, as in Go.
    for (const property of root.children ?? []) {
        const [key, node] = property.children ?? []
        if (!key || !node) return null
        const name = String(key.value)
        switch (name) {
            case 'ts':
            case 'run_id':
            case 'repo':
            case 'mode':
            case 'assessment':
                if (node.type === 'null') break
                if (typeof node.value !== 'string') return null
                run[name] = node.value
                break
            case 'quick':
                if (node.type === 'null') break
                if (typeof node.value !== 'boolean') return null
                run.quick = node.value
                break
            case 'n_findings':
            case 'n_refuted': {
                if (node.type === 'null') break
                const raw = line.slice(node.offset,
                    node.offset + node.length)
                if (node.type !== 'number' || !/^-?\d+$/.test(raw)) {
                    return null
                }
                const count = BigInt(raw)
                if (count < -(1n << 63n) || count >= (1n << 63n)) {
                    return null
                }
                run[name] = count
                break
            }
            case 'files_reviewed':
                if (node.type === 'null') {
                    run.files = 0
                    break
                }
                if (node.type !== 'array' || node.children?.some(child =>
                    child.type !== 'string' && child.type !== 'null')) {
                    return null
                }
                run.files = node.children?.length ?? 0
                break
        }
    }

    return `${run.ts}  ${pad(run.run_id, 25)} ${pad(run.mode, 8)} ` +
        `q=${pad(String(run.quick), 5)} ${pad(run.assessment, 30)} ` +
        `findings=${run.n_findings} refuted=${run.n_refuted} ` +
        `files=${run.files}  ${run.repo}\n`
}
