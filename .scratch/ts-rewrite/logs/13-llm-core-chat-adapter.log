onst choice = obj(c)\n        return {\n            index:choice.index,\n            delta:{},\n            finish_reason:choice.finish_reason,\n        }\n    })\n    return [\n        event({ ...base, choices:deltas }),\n        event({ ...base, choices:finishes }),\n        event({ ...base, choices:[], usage:response.usage }),\n        event('[DONE]'),\n    ]\n}\n\nexport function writeInferenceStream (\n    res:StreamSink,\n    protocol:string,\n    response:unknown\n):void {\n    let events:string[]\n    if (protocol === 'chat') events = chatEvents(obj(response))\n    else throw new Error(`unsupported inference protocol \"${protocol}\"`)\n    res.setHeader('Content-Type', 'text/event-stream')\n    for (const e of events) res.write(e)\n    res.end()\n}\n\n// `writeInferenceStream` from a JSON string.\nexport function writeJSONStream (\n    res:StreamSink,\n    protocol:string,\n    body:string\n):void {\n    writeInferenceStream(res, protocol, JSON.parse(body))\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4207,"cache_read_input_tokens":133709,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4207},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e41e09b0-fa4c-45a2-9b40-31ad5830b305","uuid":"0579fd8c-ca1a-40dc-bb06-9be779640661","timestamp":"2026-11-18T19:50:23.827Z","request_id":"req_011ChAyU7ypexDfa1zPV5Qpu","wire_tool_inputs":{"toolu_016XFTEMtqydk9iLspft2wCB":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/test/helpers/inference-stream.ts","content":"// Fixture writer for fake inference servers (spec 01, 3.8; Go\n// testutil.WriteInferenceStream): from a complete response object, emit\n// the protocol's native SSE stream. Only `chat` exis