{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAy8R5v16cqnGTqr4Pj5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SEjSpHtgbEmaLyFAX9H8zQ","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/src/llm/types.ts","content":"// Protocol-neutral types for the LLM layer (spec 06, 3.1; spec 07, 3.3).\n\nexport type Protocol = 'chat'|'responses'|'anthropic'\n\nexport interface RawResponse {\n    role:string;\n    protocol:Protocol;\n    model:string;\n    contentType:'application/json'|'text/event-stream';\n    // Exact bytes of the body: no request, no headers.\n    body:Uint8Array;\n}\n\nexport interface ClientConfig {\n    // \"finder\", \"verifier\", or a doctor check name.\n    role:string;\n    baseUrl:string;\n    apiKey:string;\n    // Sent verbatim as the body's `model`.\n    model:string;\n    // \"\" means chat.\n    protocol:''|Protocol;\n    maxOutputTokens:number;\n    // Attempts per model call; <= 0 means DEFAULT_MAX_ATTEMPTS.\n    maxAttempts:number;\n    // Per request; 0 disables.\n    requestTimeoutMs:number;\n    sessionHeader?:string;\n    captureResponse?:(raw:RawResponse) => Promise<void>|void;\n    // Overrides the module-level fetch (http.ts) for this client.\n    fetch?:typeof globalThis.fetch;\n}\n\nexport interface ToolDefinition {\n    name:string;\n    description:string;\n    // The complete caller JSON Schema.\n    schema:Record<string, unknown>;\n}\n\n// A tool the agent loop offers the model (spec 07, 3.3). The final tool\n// has no `run`.\nexport interface Tool {\n    name:string;\n    description:string;\n    schema:Record<string, unknown>;\n    run?:(args:Record<string, unknown>, signal:AbortSignal) =>\n        unknown|Promise<unknown>;\n    recordsResult?:boolean;\n}\n\nexport type AssistantPart =\n    | { type:'text', text:string }\n    | {\n        type:'reasoning';\n        text:string;\n        signature?:string;\n        redactedData?:string;\n    }\n    // `input` is the raw argument string as received.\n    | { type:'tool-call', id:string, name:string, input:string }\n\nexport interface ToolResult {\n    callId:string;\n    name:string;\n    output:string;\n    isError:boolean;\n}\n\nexport type ConversationItem =\n    | { role:'user', text:string }\n    | { role:'assistant', parts:AssistantPart[] }\n    | { role:'tool', results:ToolResult[] }\n\nexport interface Usage {\n    uncachedInputTokens:number;\n    cachedInputTokens:number;\n    cacheWriteTokens:number;\n    outputTokens:number;\n    calls:number;\n}\n\nexport interface ModelRequest {\n    system:string;\n    items:ConversationItem[];\n    tools:ToolDefinition[];\n    sessionId:string;\n    // Already composed by the agent loop (caller, deadline, timeout).\n    signal:AbortSignal;\n    onUsage?:(usage:Usage) => void;\n}\n\nexport type FinishReason =\n    'stop'|'length'|'content-filter'|'tool-calls'|'error'|'other'|'unknown'\n\nexport interface ModelTurn {\n    // Arrival order; replayed verbatim.\n    parts:AssistantPart[];\n    finishReason:FinishReason;\n    rawFinishReason?:string;\n    // Normalized, calls: 1.\n    usage:Usage;\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":246,"cache_read_input_tokens":111467,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":246},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e41e09b0-fa4c-45a2-9b40-31ad5830b305","uuid":"5f7101c2-f38b-47b1-9bf2-89ca9208de89","timestamp":"2026-11-18T19:46:11.529Z","request_id":"req_011ChAy8Qsm1GUo6h17GLM7W","wire_tool_inputs":{"toolu_01SEjSpHtgbEmaLyFAX9H8zQ":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/src/llm/types.ts","content":"//