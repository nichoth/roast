{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAyQqDRtQ623tVTfSzUu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LPQP4XbCjBDyELu5XFr75b","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/src/llm/chat.ts","content":"// The `chat` protocol (OpenAI Chat Completions; OpenRouter, DeepSeek,\n// others): a pure request encoder and stream decoder (spec 06, 2.6.1 and\n// 2.8.1).\n\nimport { isChatReasoningModel } from './models.js'\nimport type {\n    AssistantPart,\n    ConversationItem,\n    ToolDefinition,\n} from './types.js'\n\nexport interface EncodeConfig {\n    model:string;\n    maxOutputTokens:number;\n}\n\nexport interface EncodeRequest {\n    system:string;\n    items:readonly ConversationItem[];\n    tools:readonly ToolDefinition[];\n}\n\nexport function trimSlashes (url:string):string {\n    let end = url.length\n    while (end > 0 && url.charCodeAt(end - 1) === 47) end--\n    return url.slice(0, end)\n}\n\nexport function chatUrl (baseUrl:string):string {\n    return `${trimSlashes(baseUrl)}/chat/completions`\n}\n\nfunction assistantMessage (\n    parts:readonly AssistantPart[]\n):Record<string, unknown>|null {\n    const texts:string[] = []\n    const reasoning:string[] = []\n    const calls:unknown[] = []\n    for (const p of parts) {\n        if (p.type === 'text') texts.push(p.text)\n        else if (p.type === 'reasoning') reasoning.push(p.text)\n        else {\n            calls.push({\n                id:p.id,\n                type:'function',\n                function:{ name:p.name, arguments:p.input },\n            })\n        }\n    }\n    if (texts.length === 0 && calls.length === 0) return null\n    const msg:Record<string, unknown> = { role:'assistant' }\n    if (texts.length > 0) msg.content = texts.join('\\n')\n    if (calls.length > 0) msg.tool_calls = calls\n    if (reasoning.length > 0) msg.reasoning_content = reasoning.join('\\n')\n    return msg\n}\n\nfunction messages (req:EncodeRequest):unknown[] {\n    const out:unknown[] = []\n    if (req.system !== '') out.push({ role:'system', content:req.system })\n    for (const item of req.items) {\n        if (item.role === 'user') {\n            out.push({ role:'user', content:item.text })\n        } else if (item.role === 'assistant') {\n            const msg = assistantMessage(item.parts)\n            if (msg) out.push(msg)\n        } else {\n            for (const r of item.results) {\n                out.push({\n                    role:'tool',\n                    tool_call_id:r.callId,\n                    content:r.output,\n                })\n            }\n        }\n    }\n    return out\n}\n\n// The request body. Tool choice is always automatic.\nexport function encodeChat (\n    config:EncodeConfig,\n    req:EncodeRequest\n):Record<string, unknown> {\n    const body:Record<string, unknown> = {\n        model:config.model,\n        messages:messages(req),\n    }\n    if (isChatReasoningModel(config.model)) {\n        body.max_completion_tokens = config.maxOutputTokens\n    } else {\n        body.max_tokens = config.maxOutputTokens\n    }\n    body.stream = true\n    body.stream_options = { include_usage:true }\n    if (req.tools.length > 0) {\n        body.tools = req.tools.map(tool => ({\n            type:'function',\n            function:{\n                name:tool.name,\n                description:tool.description ?? '',\n                parameters:structuredClone(tool.schema),\n                strict:false,\n            },\n        }))\n        body.tool_choice = 'auto'\n    }\n    return body\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":0,"cache_read_input_tokens":131880,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"globa