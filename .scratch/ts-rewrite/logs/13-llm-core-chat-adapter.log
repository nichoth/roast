js'\nimport './scope/huge.js'\nimport './scope/hardening.js'\nimport './scope/linguist.js'\nimport './scope/abort.js'\nimport './scope/bytes.js'\nimport './cli/errors.js'\nimport './cli/terminal.js'\nimport './cli/env.js'\nimport './cli/run.js'\nimport './cli/process.js'\nimport './cli/log.js'\n// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse\n// order when the test body finishes, pass or fail.\nimport { test as tapTest, type Test } from '@substrate-system/tapzero'\n\nexport type CleanupTest = Test&{\n    cleanup (fn:() => void|Promise<void>):void;\n}\n\nexport function test (\n    name:string,\n    fn:(t:CleanupTest) => void|Promise<void>\n):void {\n    tapTest(name, async t => {\n        const cleanups:(() => void|Promise<void>)[] = []\n        const ct = Object.assign(t, {\n            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },\n        })\n        try {\n            await fn(ct)\n        } finally {\n            for (const f of cleanups.reverse()) await f()\n        }\n    })\n}\ntest/cli/:\nenv.ts\nerrors.ts\nlog.ts\nprocess.ts\nrun.ts\nterminal.ts\n\ntest/fsutil/:\natomic.ts\n\ntest/git/:\ngit.ts\n\ntest/gocompat/:\nduration.ts\nmatch.ts\nstrings.ts\n\ntest/helpers/:\nenv.ts\nrepo.ts\nrun.ts\nspawn.ts\nstreams.ts\nterminal.ts\ntest.ts\n\ntest/live/:\nindex.ts\n\ntest/scope/:\nabort.ts\nbuild.ts\nbytes.ts\nfit.ts\nglob.ts\nhardening.ts\nhelpers.ts\nhuge.ts\nlinguist.ts\nnames.ts\npatch.ts\nrenames.ts\nstaged.ts\n\ntest/snapshot/:\ndenylist.ts\n\ntest/textsafe/:\ntextsafe.ts\n\ntest/tooling/:\nassets.ts\nbuildinfo.ts\nbundle.ts\ncheck-package.ts\nlicenses.ts\nrun-import.ts\nstartup.ts\ntest-tap.ts\n\ntest/util/:\npool.ts\n{\n  \"compilerOptions\": {\n    \"module\": \"ES2022\",\n    \"target\": \"ES2022\",\n    \"moduleResolution\": \"Bundler\",\n    \"lib\": [\"ES2022\"],\n    \"types\": [\"node\"],\n    \"allowJs\": false,\n    \"skipLibCheck\": true,\n    \"strict\": true,\n    \"isolatedModules\": true,\n    \"forceConsistentCasingInFileNames\": true,\n    \"resolveJsonModule\": true,\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  },\n  \"include\": [\"src\", \"test\", \"scripts\"],\n  \"exclude\": [\n    \"src/launcher.ts\",\n    \"test/*.test.ts\",\n    \"test/release-fixture.ts\",\n    \"scripts/build.ts\",\n    \"scripts/check-pack.ts\",\n    \"scripts/check-release.ts\",\n    \"scripts/platforms.ts\",\n    \"scripts/release.ts\",\n    \"scripts/version.ts\"\n  ]\n}\n./AGENTS.md","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01JLv6Adm5eBD9UeBU6UujhV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
