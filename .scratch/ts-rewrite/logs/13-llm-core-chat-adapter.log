s:0,\n        cachedInputTokens:0,\n        cacheWriteTokens:0,\n        outputTokens:0,\n        calls:0,\n    }\n}\n\n// A client's running total across its calls.\nexport class UsageAccumulator {\n    private sum:Usage = zeroUsage()\n\n    add (u:Usage):void {\n        this.sum.uncachedInputTokens += u.uncachedInputTokens\n        this.sum.cachedInputTokens += u.cachedInputTokens\n        this.sum.cacheWriteTokens += u.cacheWriteTokens\n        this.sum.outputTokens += u.outputTokens\n        this.sum.calls += u.calls\n    }\n\n    total ():Usage {\n        return { ...this.sum }\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":324,"cache_read_input_tokens":123288,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":324},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e41e09b0-fa4c-45a2-9b40-31ad5830b305","uuid":"4dde7f76-b3e0-4a91-a3f2-3bc81387b9b1","timestamp":"2026-11-18T19:47:55.221Z","request_id":"req_011ChAyEqCuRnaSsouaKXYZa","wire_tool_inputs":{"toolu_01NMLGMiJ6TiwM2MDupKTWnC":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/src/llm/usage.ts","content":"// Usage normalization (spec 06, 2.9): provider fields -> disjoint\n// intermediate counts (stage 1, per protocol) -> Usage (stage 2, shared).\n// Cached tokens are subtracted exactly once (deliberate change 13).\n\nimport type { Usage } from './types.js'\n\nexport interface IntermediateUsage {\n    input:number;\n    cacheRead:number;\n    cacheWrite:number;\n    output:number;\n}\n\nfunction num (v:unknown):number {\n    return typeof v === 'number' && Number.isFinite(v) ? v : 0\n}\n\nfunction obj (v:unknown):Record<string, unknown> {\n    return v !== null && typeof v === 'object' &