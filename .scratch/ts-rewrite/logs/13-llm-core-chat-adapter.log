{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAyoCCLqvAdR59s91RpK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KTt5RHHnAtGMsq1LEGqeDD","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/test/llm/capture.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { CaptureGate, openCapturedBody } from '../../src/llm/capture.js'\nimport { CaptureError } from '../../src/llm/errors.js'\n\nfunction sseResponse (pieces:Uint8Array[]):Response {\n    let i = 0\n    const stream = new ReadableStream<Uint8Array>({\n        pull (c) {\n            if (i < pieces.length) c.enqueue(pieces[i++])\n            else c.close()\n        },\n    }, { highWaterMark:0 })\n    return new Response(stream, {\n        headers:{ 'Content-Type':'text/event-stream' },\n    })\n}\n\ntest('streaming capture never holds more than the cap', async t => {\n    const pieces = Array.from({ length:10 }, () => new Uint8Array(30))\n    const gate = new CaptureGate()\n    let calls = 0\n    const body = await openCapturedBody(sseResponse(pieces), {\n        role:'verifier',\n        protocol:'chat',\n        model:'m',\n        limit:100,\n        captureResponse:() => { calls++ },\n    }, gate)\n    let yielded = 0\n    let err:unknown\n    try {\n        for await (const c of body.chunks) yielded += c.length\n    } catch (e) {\n        err = e\n    }\n    await body.release()\n    t.ok(err instanceof CaptureError, 'overflow is a capture error')\n    t.equal(yielded, 90, 'only chunks within the cap were passed on')\n    t.equal(calls, 0, 'callback not called')\n    t.equal(gate.failure, err, 'gate latched')\n})\n\ntest('capture at exactly the cap succeeds', async t => {\n    const pieces = [new Uint8Array(60), new Uint8Array(40)]\n    const gate = new CaptureGate()\n    let captured = -1\n    const body = await openCapturedBody(sseResponse(pieces), {\n        role:'finder',\n        protocol:'chat',\n        model:'m',\n        limit:100,\n        captureResponse:raw => { captured = raw.body.length },\n    }, gate)\n    for await (const _ of body.chunks) { /* drain */ }\n    await body.release()\n    await body.release()\n    t.equal(captured, 100, 'all bytes captured')\n    t.equal(gate.failure, undefined, 'no failure')\n})\n\ntest('without a callback nothing is buffered or captured', async t => {\n    const gate = new CaptureGate()\n    const body = await openCapturedBody(new Response('not json', {\n        headers:{ 'Content-Type':'application/json' },\n    }), { role:'finder', protocol:'chat', model:'m' }, gate)\n    let n = 0\n    for await (const c of body.chunks) n += c.length\n    await body.release()\n    t.equal(n, 8, 'body passed through unchanged')\n    t.equal(gate.failure, undefined, 'no JSON validation without capture')\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":700,"cache_read_input_tokens":172392,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":700},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e41e09b0-fa4c-45a2-9b40-31ad5830b305","uuid":"8f1a8da1-a60a-4eea-a5f9-0f25f131ef3b","timestamp":"2026-11-18T19:54:40.071Z","request_id":"req_011ChAyoBzCoEoBLFpQBZiWb","wire_tool_inputs":{"toolu_01KTt5RHHnAtGMsq1LEGqeDD":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/test/llm/capture.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { CaptureGate, openCapturedBody } from '../../src/llm/capture.js'\nimport { CaptureError } from '../../src/llm/errors.js'\n\nfunction sseResponse (pieces:Uint8Array[]):Response {\n    let i = 0\n    const stream = new ReadableStream<Uint8Array>({\n        pull (c)