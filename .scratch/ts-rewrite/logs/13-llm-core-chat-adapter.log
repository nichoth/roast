{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011ChAyJfXqsYy1TqWCx8m3w","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UwcnQWosHEFLRErzs8oMHR","name":"Write","input":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/test/llm/chat-encode.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { encodeChat, chatUrl } from '../../src/llm/chat.js'\nimport type {\n    ConversationItem,\n    ToolDefinition,\n} from '../../src/llm/types.js'\n\nconst schema = {\n    type:'object',\n    properties:{\n        path:{ type:'string' },\n        range:{\n            type:'object',\n            properties:{ start:{ type:'integer' }, end:{ type:'integer' } },\n            required:['start', 'end'],\n            additionalProperties:false,\n        },\n    },\n    required:['path'],\n    additionalProperties:false,\n}\n\nconst tools:ToolDefinition[] = [\n    { name:'read', description:'Read a file', schema },\n    { name:'done', description:'', schema:{ type:'object' } },\n]\n\nfunction body (model:string, items:ConversationItem[] = [], t = tools) {\n    return encodeChat({ model, maxOutputTokens:4096 }, {\n        system:'sys', items, tools:t,\n    })\n}\n\ntest('chat url trims trailing slashes', t => {\n    t.equal(chatUrl('https://x.example/v1//'),\n        'https://x.example/v1/chat/completions')\n})\n\ntest('chat output limit field by model ID', t => {\n    const reasoning = body('openai/gpt-5')\n    t.equal(reasoning.max_completion_tokens, 4096, 'reasoning model')\n    t.ok(!('max_tokens' in reasoning), 'no max_tokens for reasoning')\n    const plain = body('deepseek-chat')\n    t.equal(plain.max_tokens, 4096, 'max_tokens otherwise')\n    t.ok(!('max_completion_tokens' in plain), 'no max_completion_tokens')\n})\n\ntest('chat request shape: streaming, auto tool choice, full schemas', t => {\n    const b = body('m')\n    t.equal(b.model, 'm', 'model verbatim')\n    t.equal(b.stream, true, 'stream')\n    t.deepEqual(b.stream_options, { include_usage:true }, 'usage option')\n    t.equal(b.tool_choice, 'auto', 'tool choice auto')\n    t.deepEqual(b.tools, [\n        { type:'function', function:{\n            name:'read', description:'Read a file', parameters:schema,\n            strict:false,\n        } },\n        { type:'function', function:{\n            name:'done', description:'', parameters:{ type:'object' },\n            strict:false,\n        } },\n    ], 'tools carry the full schema and an empty description')\n    const params = (b.tools as {function:{parameters:unknown}}[])[0]\n        .function.parameters\n    t.ok(params !== schema, 'schema is a copy')\n    const none = body('m', [], [])\n    t.ok(!('tools' in none) && !('tool_choice' in none),\n        'no tools, no tool_choice')\n})\n\ntest('chat never sends a forced tool choice', t => {\n    for (const model of ['deepseek-reasoner', 'gpt-5', 'm']) {\n        const b = body(model, [{ role:'user', text:'u' }])\n        t.equal(b.tool_choice, 'auto', model)\n    }\n})\n\ntest('chat message encoding', t => {\n    const items:ConversationItem[] = [\n        { role:'user', text:'hello' },\n        { role:'assistant', parts:[\n            { type:'reasoning', text:'' },\n            { type:'text', text:'a' },\n            { type:'text', text:'b' },\n            { type:'tool-call', id:'c1', name:'read', input:'{\"path\":\"x\"}' },\n        ] },\n        { role:'tool', results:[\n            { callId:'c1', name:'read', output:'contents', isError:false },\n            { callId:'c2', name:'read', output:'boom', isError:true },\n        ] },\n        { role:'assistant', parts:[{ type:'reasoning', text:'only' }] },\n        { role:'assistant', parts:[{ type:'text', text:'final' }] },\n    ]\n    t.deepEqual(body('m', items).messages, [\n        { role:'system', content:'sys' },\n        { role:'user', content:'hello' },\n        {\n            role:'assistant',\n            content:'a\\nb',\n            tool_calls:[{ id:'c1', type:'function', function:{\n                name:'read', arguments:'{\"path\":\"x\"}',\n            } }],\n            reasoning_content:'',\n        },\n        { role:'tool', tool_call_id:'c1', content:'contents' },\n        { role:'tool', tool_call_id:'c2', content:'boom' },\n        { role:'assistant', content:'final' },\n    ])\n})\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":178,"cache_read_input_tokens":129923,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":178},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e41e09b0-fa4c-45a2-9b40-31ad5830b305","uuid":"ec5c403d-c6d4-450e-9efe-9fddab4c001d","timestamp":"2026-11-18T19:48:15.333Z","request_id":"req_011ChAyJfHTGF9RoDxJpjxjp","wire_tool_inputs":{"toolu_01UwcnQWosHEFLRErzs8oMHR":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/test/llm/chat-encode.ts","content":"import { test } from '@substrate-system/tapzero'\nimport { encodeChat, chatUrl } from '../../src/llm/chat.js'\nimport type {\n    ConversationItem,\n    ToolDefinition,\n} from '../../src/llm/types.js'\n\nconst schema = {\n    type:'object',\n    properties:{\n        path:{ type:'string' },\n        range:{\n            type:'object',\n            properties:{ start:{ type:'integer' }, end:{ type:'integer' } },\n            required:['start', 'end'],\n            additionalProperties:false,\n        },\n    },\n    required:['path'],\n    additionalProperties:false,\n}\n\nconst tools:ToolDefinition[] = [\n    { name:'read', description:'Read a file', schema },\n    { name:'done', description:'', schema:{ type:'object' } },\n]\n\nfunction body (model:string, items:ConversationItem[] = [], t = tools) {\n    