ssion ID.\nexport function requestHeaders (\n    protocol:Protocol,\n    apiKey:string,\n    sessionId:string,\n    sessionHeader?:string\n):Headers {\n    const h = new Headers()\n    h.set('Content-Type', 'application/json')\n    h.set('Accept', 'text/event-stream')\n    if (protocol === 'anthropic') {\n        h.set('X-Api-Key', apiKey)\n        h.set('Anthropic-Version', '2023-06-01')\n    } else {\n        h.set('Authorization', `Bearer ${apiKey}`)\n    }\n    h.set('User-Agent', userAgent())\n    h.set('X-Agent-Session-Id', sessionId)\n    if (sessionHeader) h.set(sessionHeader, sessionId)\n    return h\n}\nEOF"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6649,"cache_read_input_tokens":146483,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6649},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e41e09b0-fa4c-45a2-9b40-31ad5830b305","uuid":"c880d9b3-2bba-4896-a635-a50d781d1762","timestamp":"2026-11-18T19:52:05.185Z","request_id":"req_011ChAybrqxfZjD3gSrJPD5T","wire_tool_inputs":{"toolu_012GBQPSoPbsFM1hMpaFVpG5":{"command":"cd /Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter && cat > src/llm/session.ts <<'EOF'\n// Conversation session IDs (spec 06, 2.3): `roast-` plus 26 characters of\n// the RFC 4648 base32 alphabet, 128 bits from a CSPRNG (Go\n// `\"roast-\" + rand.Text()`).\n\nconst ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'\n\n// Unpadded base32 of 16 random bytes.\nexport function newSessionId ():string {\n    const bytes = crypto.getRandomValues(new Uint8Array(16))\n    let out = ''\n    let acc = 0\n    let bits = 0\n    for (const b of bytes) {\n        acc = (acc << 8) | b\n        bits += 8\n        while (bits >= 5) {\n            bits -= 5\n   