length; i++) {\n                const c = buf.charCodeAt(i)\n                if (c === 10 || c === 13) break\n            }\n            if (i === buf.length) {\n                if (final && buf.length > 0) {\n                    const rest = buf\n                    buf = ''\n                    yield rest\n                }\n                return\n            }\n            const line = buf.slice(0, i)\n            skipLF = buf.charCodeAt(i) === 13\n            buf = buf.slice(i + 1)\n            yield line\n        }\n    }\n\n    for await (const chunk of chunks) {\n        buf += decoder.decode(chunk, { stream:true })\n        for (const line of lines(false)) {\n            const ev = applyLine(line, st)\n            if (ev) yield ev\n        }\n    }\n    buf += decoder.decode()\n    for (const line of lines(true)) {\n        const ev = applyLine(line, st)\n        if (ev) yield ev\n    }\n    const last = applyLine('', st)\n    if (last) yield last\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":144,"cache_read_input_tokens":107292,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":144},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e41e09b0-fa4c-45a2-9b40-31ad5830b305","uuid":"2f30334d-5213-4189-b704-dc74c24cc84a","timestamp":"2026-11-18T19:45:19.520Z","request_id":"req_011ChAy5m76Bnx8ALNN2NyAE","wire_tool_inputs":{"toolu_01B3Q3rCdua2APrnNA5FVse1":{"file_path":"/Users/nick/code/roast.ts-rewrite-13-llm-core-chat-adapter/src/llm/sse.ts","content":"// The shared, pull-based SSE parser (spec 06, 2.7). Bytes are read only\n// as the consumer asks for the next event; it never buffers more than the\n// current chunk plus a partial line.\n\nexport interface SseEvent {\n