package record

import (
	"errors"
	"fmt"
	"io/fs"
	"os"
	"path/filepath"
)

// StateDir is the project-local directory, at the Git toplevel, that holds
// Roast's run records. It ignores itself so its contents are never
// committed by accident.
const StateDir = ".roast"

// ensureDir creates the records directory dir (StateDir/runs). When it has
// to create StateDir itself, it also writes a .gitignore inside it that
// ignores everything.
func ensureDir(dir string) error {
	state := filepath.Dir(dir)
	if _, err := os.Lstat(state); errors.Is(err, fs.ErrNotExist) {
		if err := os.MkdirAll(state, 0o700); err != nil {
			return fmt.Errorf("create %s: %w", state, err)
		}
		ignore := filepath.Join(state, ".gitignore")
		if err := os.WriteFile(ignore, []byte("*\n"), 0o644); err != nil {
			return fmt.Errorf("write %s: %w", ignore, err)
		}
	}
	if err := os.MkdirAll(dir, 0o700); err != nil {
		return fmt.Errorf("create record directory %s: %w", dir, err)
	}
	return nil
}

// makeRunDir creates dir/<runID> and protects it and the records directory.
// The project directory above them is left alone.
func makeRunDir(dir, runID string) (string, error) {
	if runID == "" || filepath.Base(runID) != runID || runID == "." {
		return "", fmt.Errorf("invalid run id %q", runID)
	}
	if err := ensureDir(dir); err != nil {
		return "", err
	}
	runDir := filepath.Join(dir, runID)
	if err := os.MkdirAll(runDir, 0o700); err != nil {
		return "", fmt.Errorf("create run directory %s: %w", runDir, err)
	}
	for _, path := range []string{dir, runDir} {
		if err := os.Chmod(path, 0o700); err != nil {
			return "", fmt.Errorf("protect run directory %s: %w", path, err)
		}
	}
	return runDir, nil
}

// openPrivateFile also tightens existing files before writing. Creation modes
// alone do not change the permissions of artifacts from older versions.
func openPrivateFile(path string, flags int) (*os.File, error) {
	f, err := os.OpenFile(path, flags, 0o600)
	if err != nil {
		return nil, err
	}
	if err := f.Chmod(0o600); err != nil {
		_ = f.Close()
		return nil, err
	}
	return f, nil
}

func writePrivateFile(path string, data []byte) error {
	f, err := openPrivateFile(path, os.O_CREATE|os.O_WRONLY|os.O_TRUNC)
	if err != nil {
		return err
	}
	if _, err := f.Write(data); err != nil {
		_ = f.Close()
		return err
	}
	return f.Close()
}

