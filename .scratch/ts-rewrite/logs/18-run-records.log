+    t.equal(lines[0].n_refuted, 1)
+    t.equal(lines[0].findings[0].fingerprint, fingerprint(finding()))
+    t.equal(lines[0].dropped_findings[0].fingerprint, fingerprint(finding()))
+    t.deepEqual(lines[0].usage, null)
