+export type BuildMeta = { version:string; commit:string }
+export type ScopeMeta = {
+    kind:string;
+    base?:string;
+    uncommitted_only?:boolean;
+    staged_only?:boolean;
+    include_vendored?:boolean;
+    paths?:string[];
+    excludes?:string[];
+    base_oid?:string;
+    merge_base_oid?:string;
+    head_oid?:string;
+    survey?:boolean;
+    staged?:boolean;
+    files?:string[];
+}
+export type DerivedMeta = {
+    mode:string;
+    langs?:string[];
+    quick?:boolean;
+    interactive:boolean;
+    max_turns:number;
+    confidence_floor:number;
+    do_verify:boolean;
+    task?:string;
+    max_severity?:string;
+    max_diff_bytes?:number;
+    max_file_ctx_bytes?:number;
+}
+export type RoleMeta = {
+    profile?:string;
+    base_url:string;
+    model:string;
+    protocol:string;
+    api?:string;
+    max_output_tokens:number;
+    session_header?:string;
+    prompt_digest?:string;
+}
+export type SnapshotMeta = {
+    captured:boolean;
+    reason?:string;
+    ref?:string;
+    commit?:string;
+    index_tree?:string;
+    worktree_tree?:string;
+    base_tree?:string;
+    head?:string;
+    base?:string;
+    diff_pair?:string;
+    file_modes?:string;
+    excluded_paths?:string[];
+}
+export type DigestMeta = {
+    input_kind:string;
+    input:string;
+    input_bytes:number;
+    system_prompt?:string;
+    user_prompt?:string;
+}
+export type UsageMeta = {
+    uncached_input_tokens:number;
+    cached_input_tokens:number;
+    cache_write_tokens:number;
+    output_tokens:number;
+    calls:number;
+}
+export type Meta = {
+    run_id:string;
+    replay_of?:string;
+    ts:string;
+    repo:string;
+    invoke_dir?:string;
+    argv?:string[];
+    roast:BuildMeta;
+    scope:ScopeMeta;
+    derived:DerivedMeta;
+    roles:Record<string, RoleMeta>;
+    snapshot:SnapshotMeta;
+    digests:DigestMeta;
+    budgets?:Record<string, unknown>;
+    usage?:Record<string, UsageMeta>;
+    env_names_only?:string[];
+    caveats?:string[];
+}
diff --git a/src/record/meta.ts b/src/record/meta.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3bd4788139c3c9fd58f01f7ed934b27894b960d9
--- /dev/null
+++ b/src/record/meta.ts
@@ -0,0 +1,93 @@
+// pattern: Imperative Shell
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { gzipSync, gunzipSync } from 'node:zlib'
+import {
+    isValidName, makeRunDir, writePrivate, NoRecordDirError,
+} from './dir.js'
+import { compareBytes } from './json.js'
+import { serializeMeta } from './meta-json.js'
+import type { Meta } from './meta-types.js'
+import { decodeMeta } from './meta-read.js'
+
+export type * from './meta-types.js'
+export { serializeMeta } from './meta-json.js'
+export { wireProtocol, captureEnv, digest } from './meta-json.js'
+
+function validate (name:string, label:string):void {
+    if (!isValidName(name)) {
+        throw new Error(`${label} ${JSON.stringify(name)}`)
+    }
+}
+
+export async function resolveRunDir (
+    dir:string,
+    id:string
+):Promise<string> {
+    validate(id, 'invalid run id')
+    if (!dir) throw new NoRecordDirError()
+    let entries
+    try {
+        entries = await fs.readdir(dir, { withFileTypes:true })
+    } catch (err) {
+        throw new Error(`no run artifacts in ${dir}`, { cause:err })
+    }
+    const matches = entries.filter(e => e.isDirectory() &&
+        e.name.startsWith(id)).map(e => e.name).sort(compareBytes)
+    if (matches.length === 0) {
+        throw new Error(`no run matches ${JSON.stringify(id)} under ${dir}`)
+    }
+    if (matches.length > 1) {
+        throw new Error(`${JSON.stringify(id)} is ambiguous: matches ` +
+            matches.join(', '))
+    }
+    return path.join(dir, matches[0])
+}
+
+export async function writeMeta (dir:string, meta:Meta):Promise<string> {
+    validate(meta.run_id, 'write meta: invalid run id')
+    const runDir = await makeRunDir(dir, meta.run_id)
+    const file = path.join(runDir, 'meta.json')
+    const tmp = file + '.tmp'
+    await writePrivate(tmp, serializeMeta(meta))
+    try {
+        await fs.rename(tmp, file)
+    } catch (err) {
+        await fs.rm(tmp, { force:true }).catch(() => {})
+        throw new Error(`publish ${file}`, { cause:err })
+    }
+    return file
+}
+
+export async function readMeta (
+    dir:string,
+    id:string
+):Promise<{ meta:Meta; runDir:string }> {
+    const runDir = await resolveRunDir(dir, id)
+    const file = path.join(runDir, 'meta.json')
+    const text = await fs.readFile(file, 'utf8')
+    return { meta:decodeMeta(text), runDir }
+}
+
+export async function writeArtifact (
+    dir:string,
+    runId:string,
+    name:string,
+    content:string|Uint8Array
+):Promise<string> {
+    validate(runId, 'write artifact: invalid run id')
+    validate(name, 'write artifact: invalid name')
+    const runDir = await makeRunDir(dir, runId)
+    const file = path.join(runDir, name + '.gz')
+    await writePrivate(file, gzipSync(content))
+    return file
+}
+
+export async function readArtifact (
+    runDir:string,
+    name:string
+):Promise<string> {
+    validate(name, 'read artifact: invalid name')
+    return gunzipSync(await fs.readFile(path.join(runDir, name + '.gz')))
+        .toString('utf8')
+}
diff --git a/src/record/responses.ts b/src/record/responses.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8cfb19cb13d47c5b919eec37e204550ea54a320c
--- /dev/null
+++ b/src/record/responses.ts
@@ -0,0 +1,55 @@
+// pattern: Imperative Shell
+import path from 'node:path'
+import { isValidName, makeRunDir, openPrivate } from './dir.js'
+import { goStringify, encodeResponseBody } from './json.js'
+
+export const PROVIDER_RESPONSES_FILE = 'provider-responses.jsonl'
+
+export class ResponseRecorder {
+    readonly dir:string
+    readonly runId:string
+    private tail:Promise<void> = Promise.resolve()
+    private sequence = 0
+
+    constructor (dir:string, runId:string) {
+        this.dir = dir
+        this.runId = runId
+    }
+
+    append (
+        role:string,
+        protocol:string,
+        model:string,
+        contentType:string,
+        body:Uint8Array
+    ):Promise<void> {
+        let encoded:string
+        try {
+            if (!isValidName(this.runId)) {
+                throw new Error('record provider response: invalid run id')
+            }
+            encoded = encodeResponseBody(contentType, body)
+        } catch (err) {
+            return Promise.reject(err)
+        }
+        const write = this.tail.then(async () => {
+            const header = goStringify({
+                sequence:this.sequence + 1,
+                role, protocol, model, content_type:contentType,
+            })
+            const line = header.slice(0, -1) + ',"body":' + encoded + '}\n'
+            const runDir = await makeRunDir(this.dir, this.runId)
+            const file = path.join(runDir, PROVIDER_RESPONSES_FILE)
+            const handle = await openPrivate(file, 'a')
+            try {
+                await handle.writeFile(line)
+                await handle.sync()
+            } finally {
+                await handle.close()
+            }
+            this.sequence++
+        })
+        this.tail = write.catch(() => {})
+        return write
+    }
+}
