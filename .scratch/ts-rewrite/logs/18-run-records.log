diff --git a/test/record/dir.ts b/test/record/dir.ts
new file mode 100644
index 0000000000000000000000000000000000000000..de6944feadce27731a7bbee342e3aae7d9b4ac2f
--- /dev/null
+++ b/test/record/dir.ts
@@ -0,0 +1,34 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { tempDir, tempRepo } from '../helpers/repo.js'
+import { recordDir, makeRunDir } from '../../src/record/dir.js'
+
+test('records resolve at the Git root and ignore overrides', async t => {
+    const repo = tempRepo()
+    const outside = tempDir()
+    t.cleanup(repo.remove)
+    t.cleanup(outside.remove)
+    const sub = path.join(repo.dir, 'sub')
+    await fs.mkdir(sub)
+    t.equal(await recordDir(sub, {
+        env:{ ...repo.env, ROAST_RECORD_DIR:outside.dir },
+    }), path.join(repo.dir, '.roast/runs'))
+    t.equal(await recordDir(outside.dir, { env:outside.env }), '')
+    t.equal(await recordDir(repo.dir, { env:{ PATH:'' } }), '')
+})
+
+test('first run ignores state and existing state stays alone', async t => {
+    const repo = tempRepo()
+    t.cleanup(repo.remove)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    await makeRunDir(dir, 'first')
+    const ignore = path.join(repo.dir, '.roast/.gitignore')
+    t.equal(await fs.readFile(ignore, 'utf8'), '*\n')
+    await fs.writeFile(ignore, 'custom\n')
+    await makeRunDir(dir, 'second')
+    t.equal(await fs.readFile(ignore, 'utf8'), 'custom\n')
+    await fs.unlink(ignore)
+    await makeRunDir(dir, 'third')
+    t.ok(!(await fs.readdir(path.dirname(ignore))).includes('.gitignore'))
+})
diff --git a/test/record/index-file.ts b/test/record/index-file.ts
new file mode 100644
index 0000000000000000000000000000000000000000..de5fd4020ccf58f659393e8e07309068e74f2b78
--- /dev/null
+++ b/test/record/index-file.ts
@@ -0,0 +1,124 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { tempRepo, tempDir } from '../helpers/repo.js'
+import { finding, report } from '../render/fixtures.js'
+import { recordDir } from '../../src/record/dir.js'
+import { fingerprint } from '../../src/review/fingerprint.js'
+import { appendRunLine, seenBefore } from '../../src/record/index-file.js'
+
+test('monthly index records completed runs using local time', async t => {
+    const repo = tempRepo()
+    const outside = tempDir()
+    t.cleanup(repo.remove)
+    t.cleanup(outside.remove)
+    const zone = process.env.TZ
+    process.env.TZ = 'Etc/GMT+8'
+    t.cleanup(() => {
+        if (zone === undefined) delete process.env.TZ
+        else process.env.TZ = zone
+    })
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    const r = report({
+        runId:'run', promptPacks:['frontend', 'security'], verified:true,
+        budgets:{ z:1, a:2 }, prior:new Map([['fp', 'do not persist']]),
+    })
+    r.result.dropped = [finding({ _drop_reason:'refuted_by_verifier' })]
+    const now = new Date('2026-11-01T03:04:05.120Z')
+    await appendRunLine(dir, r, repo.dir, ['review'], now)
+    await appendRunLine(dir, r, repo.dir, null, now)
+    const files = await fs.readdir(dir)
+    t.deepEqual(files, ['runs-2026-10.jsonl'])
+    const lines = (await fs.readFile(path.join(dir, files[0]), 'utf8'))
+        .trim().split('\n').map(s => JSON.parse(s))
+    t.equal(lines.length, 2)
+    t.deepEqual(Object.keys(lines[0]), [
+        'ts', 'run_id', 'repo', 'argv', 'mode', 'quick', 'verified',
+        'assessment', 'n_findings', 'n_dropped', 'n_refuted',
+        'files_reviewed', 'findings', 'dropped_findings', 'usage',
+        'prompt_packs', 'budgets',
+    ])
+    t.equal(lines[0].ts, '2026-10-31T19:04:05-08:00')
+    t.equal(lines[0].repo, repo.dir)
+    t.deepEqual(lines[0].argv, ['review'])
+    t.deepEqual(lines[1].argv, null)
