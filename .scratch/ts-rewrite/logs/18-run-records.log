new file mode 100644
index 0000000000000000000000000000000000000000..58236e3ea720420196f3ff604296a5095ac252ed
--- /dev/null
+++ b/test/record/json.ts
@@ -0,0 +1,31 @@
+import { test } from '../helpers/test.js'
+import {
+    compactJSON, goStringify, rfc3339NanoUTC, rfc3339Local,
+} from '../../src/record/json.js'
+
+test('record JSON preserves string values and native numeric tokens', t => {
+    const values = ['', '<>&\u2028\u2029', '\n\t"\\', '\u00e9\ud83c\udf0d']
+    for (const value of values) {
+        t.deepEqual(JSON.parse(goStringify({ value })), { value })
+    }
+    t.equal(compactJSON(' \n [ 1.0, 12345678901234567890, -0, 1e+09, ' +
+        '" a \\\" b ", { "x" : null } ] \t'),
+    '[1.0,12345678901234567890,-0,1e+09," a \\\" b ",{"x":null}]')
+    t.equal(rfc3339NanoUTC(new Date('2026-11-01T00:00:00.000Z')),
+        '2026-11-01T00:00:00Z')
+    t.equal(rfc3339NanoUTC(new Date('2026-11-01T00:00:00.120Z')),
+        '2026-11-01T00:00:00.12Z')
+    t.equal(rfc3339NanoUTC(new Date('2026-11-01T00:00:00.001Z')),
+        '2026-11-01T00:00:00.001Z')
+    const old = process.env.TZ
+    process.env.TZ = 'UTC'
+    t.cleanup(() => {
+        if (old === undefined) delete process.env.TZ
+        else process.env.TZ = old
+    })
+    t.equal(rfc3339Local(new Date('2026-11-01T00:00:00.120Z')),
+        '2026-11-01T00:00:00Z')
+    process.env.TZ = 'Asia/Kolkata'
+    t.equal(rfc3339Local(new Date('2026-11-01T00:00:00.120Z')),
+        '2026-11-01T05:30:00+05:30')
+})
diff --git a/test/record/meta.ts b/test/record/meta.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4871037d11b9586f3e7a2720bc91f4c5695c57e4
--- /dev/null
+++ b/test/record/meta.ts
@@ -0,0 +1,203 @@
+import { recordRepo } from './repo.js'
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { createHash } from 'node:crypto'
+import { gunzipSync } from 'node:zlib'
+import { test } from '../helpers/test.js'
+import { recordDir } from '../../src/record/dir.js'
+import {
+    type Meta, writeMeta, readMeta, writeArtifact, readArtifact,
+    serializeMeta,
+    wireProtocol,
+    captureEnv,
+    digest,
+    writeReport, reportPath,
+    removeRun, resolveRunDir,
+} from '../../src/record/meta.js'
+
+export function meta (repo:string):Meta {
+    return {
+        run_id:'20260919T120000Z-1234abcd',
+        ts:'2026-09-19T12:00:00Z',
+        repo,
+        roast:{ version:'dev', commit:'dev' },
+        scope:{ kind:'diff', paths:[], staged_only:false },
+        derived:{
+            mode:'code',
+            interactive:false,
+            max_turns:3,
+            confidence_floor:0.8,
+            do_verify:true
+        },
+        roles:{
+            verifier:{
+                base_url:'https://example.test',
+                model:'v',
+                protocol:'chat',
+                max_output_tokens:100
+            },
+            finder:{
+                base_url:'https://example.test',
+                model:'f',
+                protocol:'chat',
+                max_output_tokens:100
+            }
+        },
+        snapshot:{ captured:false },
+        digests:{ input_kind:'diff', input:'abc', input_bytes:7 },
+        budgets:{ z:1, a:{ z:2, a:3 } },
+        argv:[],
+        caveats:[],
+        env_names_only:[],
+    }
+}
+
+test('metadata and gzip artifacts preserve replay evidence', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    const m = meta(repo.dir)
+    Object.assign(m, { api_key:'secret-api-key-value' })
+    Object.assign(m.roles.finder, { apiKey:'secret-api-key-value' })
+    m.env_names_only = captureEnv({
+        ROAST_FINDER_API_KEY:'secret-api-key-value',
+        ROAST_GATEWAY_TOKEN:'secret-api-key-value',
+    }, ['ROAST_GATEWAY_TOKEN'])
+    const file = await writeMeta(dir, m)
+    const got = await readMeta(dir, '20260919')
+    t.equal(got.meta.run_id, m.run_id)
+    t.equal(got.meta.roles.finder.model, m.roles.finder.model)
+    t.equal(got.meta.roles.verifier.base_url, m.roles.verifier.base_url)
+    t.equal(got.runDir, path.join(dir, m.run_id))
+    const raw = await fs.readFile(file, 'utf8')
+    t.equal(raw, serializeMeta(m))
+    const out = JSON.parse(raw)
+    t.deepEqual(Object.keys(out), [
+        'run_id', 'ts', 'repo', 'roast', 'scope', 'derived', 'roles',
+        'snapshot', 'digests', 'budgets',
+    ])
+    t.deepEqual(Object.keys(out.roles), ['finder', 'verifier'])
+    t.deepEqual(Object.keys(out.budgets), ['a', 'z'])
+    t.deepEqual(Object.keys(out.budgets.a), ['a', 'z'])
+    t.deepEqual(out.scope, { kind:'diff' })
+    t.ok(raw.endsWith('\n'))
+    t.ok(raw.includes('\n  "run_id":'))
+    const text = '<>&\u2028\u2029 \u00e9\n'
+    await writeArtifact(dir, m.run_id, 'input', text)
+    t.equal(await readArtifact(got.runDir, 'input'), text)
+    await writeArtifact(dir, m.run_id, 'empty', '')
+    t.equal(await readArtifact(got.runDir, 'empty'), '')
+    m.caveats = [text]
+    t.ok(serializeMeta(m).includes('<>&\u2028\u2029'))
+    for (const name of await fs.readdir(got.runDir)) {
+        const data = await fs.readFile(path.join(got.runDir, name))
+        t.ok(!data.includes('secret-api-key-value'))
+    }
+})
+
+test('invalid names are rejected without touching project state', async t => {
+    const repo = recordRepo(t)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    for (const id of ['', '.', '..', 'a/b', 'a\\b', 'a\0b']) {
+        const operations = [
+            () => writeMeta(dir, { ...meta(repo.dir), run_id:id }),
+            () => writeArtifact(dir, id, 'input', 'text'),
+            () => writeArtifact(dir, 'run', id, 'text'),
+            () => readArtifact(dir, id),
+            () => readMeta(dir, id),
+            () => resolveRunDir(dir, id),
+            () => removeRun(dir, id),
+        ]
+        for (const operation of operations) {
+            t.ok(await operation().then(() => false, () => true))
+        }
+    }
+    t.ok(await fs.lstat(path.dirname(dir)).then(() => false, () => true))
+    await writeReport(dir, 'good', 'preserved')
+    const ignore = path.join(repo.dir, '.roast/.gitignore')
+    t.ok(await removeRun(dir, '..').then(() => false, () => true))
+    t.equal(await fs.readFile(ignore, 'utf8'), '*\n')
+    await removeRun(dir, 'good')
+    t.ok(await fs.lstat(path.join(dir, 'good')).then(() => false, () => true))
+    await removeRun('', 'good')
+    t.equal(await fs.readFile(ignore, 'utf8'), '*\n')
+})
+
+test('stored reports resolve by unique prefix and reject ambiguity',
+    async t => {
+        const repo = recordRepo(t)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const text = '# Report\n\n<raw> \u00e9\n'
+        const file = await writeReport(dir, 'run-123', text)
+        t.equal(await reportPath(dir, 'run'), file)
+        const resolved = await reportPath(dir, 'run-1')
+        t.equal(await fs.readFile(resolved, 'utf8'), text)
+        await writeReport(dir, 'run-456', 'other')
+        t.ok(await reportPath(dir, 'run').then(() => false, () => true))
+        t.ok(await reportPath(dir, 'missing').then(() => false, () => true))
+        // Symlinks and files do not count as matching run directories.
+        await fs.symlink(path.join(dir, 'run-123'), path.join(dir, 'link'))
+        t.ok(await reportPath(dir, 'link').then(() => false, () => true))
+        await fs.writeFile(path.join(dir, 'ordinary'), '')
+        t.ok(await reportPath(dir, 'ordinary').then(() => false, () => true))
+    })
+
+test('diff digests and gzip artifacts preserve invalid UTF-8 bytes',
+    async t => {
+        const repo = recordRepo(t)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const bytes = Buffer.from([0x64, 0x69, 0x66, 0x66, 0xff, 0xc0, 0x0a])
+        const expected = createHash('sha256').update(bytes).digest('hex')
+        t.equal(digest(bytes), expected)
+        t.ok(digest(bytes) !== digest(bytes.toString('utf8')))
+        const file = await writeArtifact(dir, 'run', 'input', bytes)
+        t.deepEqual(gunzipSync(await fs.readFile(file)), bytes)
+        t.equal(digest('abc'),
+            'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad')
+    })
+
+test('captureEnv keeps sorted diagnostic names and excludes keys', t => {
+    const names = captureEnv({
+        ROAST_Z:'not-the-name',
+        ROAST_A:'123',
+        ROAST_FINDER_API_KEY:'secret-api-key-value',
+        ROAST_VERIFIER_API_KEY:'secret-api-key-value',
+        ROAST_OTHER_API_KEY:'secret-api-key-value',
+        ROAST_CUSTOM_TOKEN:'secret-api-key-value',
+        OPENAI_API_KEY:'secret-api-key-value',
+        unrelated:'unrelated',
+        ROAST_UNSET:undefined,
+    }, ['ROAST_CUSTOM_TOKEN'])
+    t.deepEqual(names, ['ROAST_A', 'ROAST_Z'])
+})
+
+test('legacy metadata uses api with exact keys and Go zero values',
+    async t => {
+        const repo = recordRepo(t)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const m = meta(repo.dir)
+        const file = await writeMeta(dir, m)
+        await fs.writeFile(file, JSON.stringify({
+            Run_ID:'wrong case',
+            roles:{ finder:{ api:'responses' } },
+            scope:null,
+            extra:'ignored',
+        }))
+        const got = (await readMeta(dir, m.run_id)).meta
+        t.equal(wireProtocol(got.roles.finder), 'responses')
+        t.equal(got.roles.finder.protocol, '')
+        t.equal(wireProtocol({
+            ...got.roles.finder,
+            protocol:'anthropic'
+        }), 'anthropic')
+        t.equal(got.run_id, '')
+        t.equal(got.scope.kind, '')
+        t.equal(got.derived.max_turns, 0)
+        t.ok(!Object.hasOwn(got, 'extra'))
+        await fs.writeFile(file, '{"roles":{"finder":{"model":123}}}')
+        t.ok(await readMeta(dir, m.run_id).then(() => false, () => true))
+        await fs.writeFile(file, '{"derived":{"max_turns":1.5}}')
+        t.ok(await readMeta(dir, m.run_id).then(() => false, () => true))
+        await fs.writeFile(file, '{"derived":{"max_turns":1.0}}')
+        t.ok(await readMeta(dir, m.run_id).then(() => false, () => true))
+    })
+
diff --git a/test/record/permissions.ts b/test/record/permissions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..77e1ae51bb88b8d535209c8e166f6923d337ddc4
--- /dev/null
+++ b/test/record/permissions.ts
@@ -0,0 +1,77 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { recordRepo } from './repo.js'
+import { meta } from './meta.js'
+import { finding } from '../render/fixtures.js'
+import { recordDir, makeRunDir } from '../../src/record/dir.js'
+import {
+    writeMeta, writeArtifact, writeReport,
+} from '../../src/record/meta.js'
+import { ResponseRecorder } from '../../src/record/responses.js'
+import { openFindingSpill } from '../../src/record/findings.js'
+import { fingerprint } from '../../src/review/fingerprint.js'
+
+for (const wide of [false, true]) {
+    const name = `run files protect ${wide ? 'existing' : 'new'} evidence`
+    test(name, async t => {
+        const repo = recordRepo(t)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const m = meta(repo.dir)
+        const run = await makeRunDir(dir, m.run_id)
+        const rootMode = (await fs.stat(repo.dir)).mode
+        const state = path.dirname(dir)
+        await fs.chmod(state, 0o755)
+        const names = [
+            'meta.json', 'meta.json.tmp', 'input.gz', 'report.md',
+            'provider-responses.jsonl', 'findings.jsonl',
+        ]
+        if (wide) {
+            for (const name of names) {
+                await fs.writeFile(path.join(run, name), '', { mode:0o644 })
+                await fs.chmod(path.join(run, name), 0o644)
+            }
+        }
+        const recorder = new ResponseRecorder(dir, m.run_id)
+        const spill = await openFindingSpill(dir, m.run_id)
+        t.ok(spill)
+        const writes = [
+            () => writeMeta(dir, m),
+            () => writeArtifact(dir, m.run_id, 'input', 'data'),
+            () => writeReport(dir, m.run_id, 'report'),
+            () => recorder.append('finder', 'chat', 'm', 'application/json',
+                Buffer.from('{}')),
+            () => spill!(finding()),
+            () => spill!(finding()),
+        ]
+        for (const write of writes) {
+            await fs.chmod(dir, 0o755)
+            await fs.chmod(run, 0o755)
+            await write()
+            t.equal((await fs.stat(dir)).mode & 0o777, 0o700)
+            t.equal((await fs.stat(run)).mode & 0o777, 0o700)
+        }
+        for (const name of names.filter(n => !n.endsWith('.tmp'))) {
+            t.equal((await fs.stat(path.join(run, name))).mode & 0o777, 0o600)
+        }
+        t.equal((await fs.stat(repo.dir)).mode, rootMode)
+        t.equal((await fs.stat(state)).mode & 0o777, 0o755)
+        const lines = (await fs.readFile(path.join(run, 'findings.jsonl'),
+            'utf8')).trim().split('\n').map(s => JSON.parse(s))
+        t.equal(lines.length, 2)
+        t.equal(lines[0].fingerprint, fingerprint(finding()))
+        t.deepEqual(lines[0].finding, finding())
+        t.ok(/^\d{4}-.*Z$/.test(lines[0].ts))
+    })
+}
+
+test('finding spill is best effort when recording fails', async t => {
+    const repo = recordRepo(t)
+    t.deepEqual(await openFindingSpill('', 'run'), null)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    t.deepEqual(await openFindingSpill(dir, '..'), null)
+    const sink = await openFindingSpill(dir, 'run')
+    await fs.mkdir(path.join(dir, 'run/findings.jsonl'))
+    await sink!(finding())
+    t.ok((await fs.stat(path.join(dir, 'run/findings.jsonl'))).isDirectory())
+})
diff --git a/test/record/repo.ts b/test/record/repo.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d092d9b0382ab4e0f6322ddc9e5319fa95c0643a
--- /dev/null
+++ b/test/record/repo.ts
@@ -0,0 +1,20 @@
+import { tempRepo, type TempDir } from '../helpers/repo.js'
+import type { CleanupTest } from '../helpers/test.js'
+
+export function recordRepo (t:CleanupTest):TempDir {
+    const repo = tempRepo()
+    const cwd = process.cwd()
+    const keys = ['HOME', 'XDG_CONFIG_HOME', 'CLAUDE_CONFIG_DIR']
+    const previous = keys.map(key => process.env[key])
+    for (const key of keys) process.env[key] = repo.env[key]
+    process.chdir(repo.dir)
+    t.cleanup(() => {
+        process.chdir(cwd)
+        keys.forEach((key, i) => {
+            if (previous[i] === undefined) delete process.env[key]
+            else process.env[key] = previous[i]
+        })
+        repo.remove()
+    })
+    return repo
+}
diff --git a/test/record/responses.ts b/test/record/responses.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8ba9b870cac2d9b8e6ab84d9bd135fc8217fb2a0
--- /dev/null
+++ b/test/record/responses.ts
@@ -0,0 +1,77 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import { test } from '../helpers/test.js'
+import { tempRepo } from '../helpers/repo.js'
+import { recordDir } from '../../src/record/dir.js'
+import {
+    ResponseRecorder, PROVIDER_RESPONSES_FILE,
+} from '../../src/record/responses.js'
+
+test('concurrent captured responses have durable gap-free sequences',
+    async t => {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const recorder = new ResponseRecorder(dir, 'run')
+        const results = await Promise.allSettled(Array.from({ length:20 },
+            (_, i) => recorder.append('verifier', 'chat', 'model',
+                'application/json', Buffer.from(`{"i":${i}}`))))
+        t.ok(results.every(r => r.status === 'fulfilled'))
+        const text = await fs.readFile(
+            path.join(dir, 'run', PROVIDER_RESPONSES_FILE), 'utf8')
+        t.ok(text.endsWith('\n'))
+        const lines = text.trim().split('\n').map(s => JSON.parse(s))
+        t.equal(lines.length, 20)
+        t.deepEqual(lines.map(l => l.sequence),
+            Array.from({ length:20 }, (_, i) => i + 1))
+        t.deepEqual(lines.map(l => l.body.i),
+            Array.from({ length:20 }, (_, i) => i))
+        t.deepEqual(Object.keys(lines[0]), [
+            'sequence', 'role', 'protocol', 'model', 'content_type', 'body',
+        ])
+    })
+
+test('response bodies retain raw streams and JSON number spellings',
+    async t => {
+        const repo = tempRepo()
+        t.cleanup(repo.remove)
+        const dir = await recordDir(repo.dir, { env:repo.env })
+        const recorder = new ResponseRecorder(dir, 'run')
+        const raw = ': ping\r\n\r\ndata: {"text":"\ufeff\u00e9 <>&"}\r\n\r\n'
+        await recorder.append('finder', 'chat', 'm',
+            'text/event-stream', Buffer.from(raw))
+        await recorder.append('finder', 'chat', 'm', 'application/json',
+            Buffer.from(' { "n":1.0, "n":12345678901234567890, ' +
+                '"s":"a \\" b <>&\u2028\u2029", "e":1e+09 } '))
+        const text = await fs.readFile(
+            path.join(dir, 'run', PROVIDER_RESPONSES_FILE), 'utf8')
+        const lines = text.trim().split('\n')
+        t.equal(JSON.parse(lines[0]).body, raw)
+        t.ok(lines[1].includes('"n":1.0,"n":12345678901234567890'))
+        t.ok(lines[1].includes('"e":1e+09'))
+        t.ok(lines[1].includes('<>&\u2028\u2029'))
+        for (const [ct, body] of [
+            ['application/json', Buffer.from('{bad')],
+            ['text/event-stream', Buffer.from([0xff])],
+            ['text/plain', Buffer.from('{}')],
+        ] as const) {
+            t.ok(await recorder.append('f', 'chat', 'm', ct, body)
+                .then(() => false, () => true))
+        }
+        await recorder.append('finder', 'chat', 'm',
+            'application/json', Buffer.from('null'))
+        const after = await fs.readFile(
+            path.join(dir, 'run', PROVIDER_RESPONSES_FILE), 'utf8')
+        t.deepEqual(after.trim().split('\n').map(s => JSON.parse(s).sequence),
+            [1, 2, 3])
+    })
+
+test('invalid captures never create a run directory', async t => {
+    const repo = tempRepo()
+    t.cleanup(repo.remove)
+    const dir = await recordDir(repo.dir, { env:repo.env })
+    const r = new ResponseRecorder(dir, 'run')
+    t.ok(await r.append('f', 'chat', 'm', 'application/json',
+        Buffer.from('not JSON')).then(() => false, () => true))
+    t.ok(await fs.lstat(path.dirname(dir)).then(() => false, () => true))
+})
