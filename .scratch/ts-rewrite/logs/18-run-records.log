+}
+export type DerivedMeta = {
+    mode:string;
+    langs?:string[];
+    quick?:boolean;
+    interactive:boolean;
+    max_turns:number;
+    confidence_floor:number;
+    do_verify:boolean;
+    task?:string;
+    max_severity?:string;
