+    model:string;
+    protocol:string;
+    api?:string;
+    max_output_tokens:number;
+    session_header?:string;
+    prompt_digest?:string;
+}
+export type SnapshotMeta = {
+    captured:boolean;
+    reason?:string;
+    ref?:string;
+    commit?:string;
+    index_tree?:string;
+    worktree_tree?:string;
+    base_tree?:string;
+    head?:string;
+    base?:string;
