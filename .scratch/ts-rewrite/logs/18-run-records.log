	Calls               int `json:"calls"`
}

const MetaFile = "meta.json"

func Digest(s string) string {
	sum := sha256.Sum256([]byte(s))
	return hex.EncodeToString(sum[:])
}

// RunDir resolves a full run id or unique prefix.
func RunDir(id string) (string, error) {
	if id == "" || filepath.Base(id) != id || id == "." {
		return "", fmt.Errorf("invalid run id %q", id)
	}
	dir := DefaultDir()
	if dir == "" {
		return "", errNoRecordDir
	}
	root := dir
	entries, err := os.ReadDir(root)
	if err != nil {
		return "", fmt.Errorf("no run artifacts in %s: %w", dir, err)
	}
	var matches []string
	for _, entry := range entries {
		if entry.IsDir() && strings.HasPrefix(entry.Name(), id) {
			matches = append(matches, entry.Name())
		}
	}
	sort.Strings(matches)
	switch len(matches) {
	case 0:
		return "", fmt.Errorf("no run matches %q under %s", id, root)
	case 1:
		return filepath.Join(root, matches[0]), nil
	default:
		return "", fmt.Errorf("%q is ambiguous: matches %s", id, strings.Join(matches, ", "))
	}
}

func WriteMetaRequired(meta Meta) (string, error) {
	dir := DefaultDir()
	if dir == "" {
		return "", errNoRecordDir
	}
	if meta.RunID == "" || filepath.Base(meta.RunID) != meta.RunID || meta.RunID == "." {
		return "", fmt.Errorf("write meta: invalid run id %q", meta.RunID)
	}
	runDir, err := makeRunDir(dir, meta.RunID)
	if err != nil {
		return "", err
	}
	data, err := json.MarshalIndent(meta, "", "  ")
	if err != nil {
		return "", fmt.Errorf("marshal metadata: %w", err)
	}
	path := filepath.Join(runDir, MetaFile)
	tmp := path + ".tmp"
	if err := writePrivateFile(tmp, append(data, '\n')); err != nil {
		return "", fmt.Errorf("write %s: %w", tmp, err)
	}
	if err := os.Rename(tmp, path); err != nil {
		_ = os.Remove(tmp)
		return "", fmt.Errorf("publish %s: %w", path, err)
	}
	return path, nil
}

// WriteMeta is the best-effort compatibility form used by fixture builders.
func WriteMeta(meta Meta) string {
	path, _ := WriteMetaRequired(meta)
	return path
}

func ReadMeta(id string) (Meta, string, error) {
	runDir, err := RunDir(id)
	if err != nil {
		return Meta{}, "", err
	}
	path := filepath.Join(runDir, MetaFile)
	data, err := os.ReadFile(path)
	if err != nil {
		return Meta{}, runDir, fmt.Errorf("run %s has no %s: %w", filepath.Base(runDir), MetaFile, err)
	}
	var meta Meta
	if err := json.Unmarshal(data, &meta); err != nil {
		return Meta{}, runDir, fmt.Errorf("parse %s: %w", path, err)
	}
	return meta, runDir, nil
}

// RemoveRun removes an incomplete run directory before inference starts.
func RemoveRun(runID string) error {
	if runID == "" || filepath.Base(runID) != runID || runID == "." {
		return fmt.Errorf("remove partial run: invalid run id %q", runID)
	}
	dir := DefaultDir()
	if dir == "" {
		return nil
	}
	return os.RemoveAll(filepath.Join(dir, runID))
}

func WriteArtifactRequired(runID, name, content string) (string, error) {
	if runID == "" || filepath.Base(runID) != runID || runID == "." {
		return "", fmt.Errorf("write artifact: invalid run id %q", runID)
	}
	if name == "" || filepath.Base(name) != name || name == "." {
		return "", fmt.Errorf("write artifact: invalid name %q", name)
	}
	dir := DefaultDir()
	if dir == "" {
		return "", errNoRecordDir
	}
	runDir, err := makeRunDir(dir, runID)
	if err != nil {
		return "", err
	}
	var compressed bytes.Buffer
	writer := gzip.NewWriter(&compressed)
	if _, err := writer.Write([]byte(content)); err != nil {
		return "", fmt.Errorf("compress artifact %q: %w", name, err)
	}
	if err := writer.Close(); err != nil {
		return "", fmt.Errorf("finish artifact %q: %w", name, err)
	}
	path := filepath.Join(runDir, name+".gz")
	if err := writePrivateFile(path, compressed.Bytes()); err != nil {
		return "", fmt.Errorf("write %s: %w", path, err)
	}
	return path, nil
}

// WriteArtifact is the best-effort compatibility form used by local tools.
func WriteArtifact(runID, name, content string) string {
	if content == "" {
		return ""
	}
	path, _ := WriteArtifactRequired(runID, name, content)
	return path
}

func ReadArtifact(runDir, name string) (string, error) {
	if name == "" || filepath.Base(name) != name || name == "." {
		return "", fmt.Errorf("read artifact: invalid name %q", name)
	}
	path := filepath.Join(runDir, name+".gz")
	file, err := os.Open(path)
	if err != nil {
		return "", err
	}
	defer func() { _ = file.Close() }()
	reader, err := gzip.NewReader(file)
	if err != nil {
		return "", fmt.Errorf("read %s: %w", path, err)
	}
	defer func() { _ = reader.Close() }()
	data, err := io.ReadAll(reader)
	if err != nil {
		return "", fmt.Errorf("read %s: %w", path, err)
	}
	return string(data), nil
}

var envSecretNames = map[string]struct{}{
	"ROAST_FINDER_API_KEY":   {},
	"ROAST_VERIFIER_API_KEY": {},
}

// CaptureEnv returns the names, never the values, of the ROAST_ variables set
// for this run, leaving out credentials. No ROAST_ variable tunes a review
// (the project config does), so a name is a hint for whoever reads the run.
func CaptureEnv(additionalSecrets ...string) []string {
	secrets := make(map[string]struct{}, len(envSecretNames)+len(additionalSecrets))
	for name := range envSecretNames {
		secrets[name] = struct{}{}
	}
	for _, name := range additionalSecrets {
		secrets[name] = struct{}{}
	}
	var names []string
	for _, item := range os.Environ() {
		name, _, ok := strings.Cut(item, "=")
		if !ok || !strings.HasPrefix(name, "ROAST_") {
			continue
		}
		if _, secret := secrets[name]; secret || strings.HasSuffix(name, "_API_KEY") {
			continue
		}
		names = append(names, name)
	}
	sort.Strings(names)
	return names
}
package record

import (
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"sync"
	"unicode/utf8"
)

// ProviderResponsesFile is the append-only provider-response transcript.
// It records native response bodies, never request headers or credentials.
const ProviderResponsesFile = "provider-responses.jsonl"

// ResponseRecorder serializes model responses from concurrent verifier calls.
type ResponseRecorder struct {
	runID string
	mu    sync.Mutex
	seq   int
}

func NewResponseRecorder(runID string) *ResponseRecorder {
	return &ResponseRecorder{runID: runID}
}

// Append durably appends a native provider body. JSON stays JSON; raw SSE is
// stored losslessly as a JSON string, identified by its content_type.
func (r *ResponseRecorder) Append(role, protocol, model, contentType string, body []byte) error {
	if r == nil || r.runID == "" || filepath.Base(r.runID) != r.runID || r.runID == "." {
		return fmt.Errorf("record provider response: invalid run id")
	}
	encodedBody := json.RawMessage(body)
	switch contentType {
	case "application/json":
		if !json.Valid(body) {
			return fmt.Errorf("record provider response: body is not valid JSON")
		}
	case "text/event-stream":
		if !utf8.Valid(body) {
			return fmt.Errorf("record provider response: event stream is not valid UTF-8")
		}
		encodedBody, _ = json.Marshal(string(body))
	default:
		return fmt.Errorf("record provider response: unsupported content type %q", contentType)
	}
	r.mu.Lock()
	defer r.mu.Unlock()
	r.seq++
	line, err := json.Marshal(struct {
		Sequence    int             `json:"sequence"`
		Role        string          `json:"role"`
		Protocol    string          `json:"protocol"`
		Model       string          `json:"model"`
		ContentType string          `json:"content_type"`
		Body        json.RawMessage `json:"body"`
	}{r.seq, role, protocol, model, contentType, encodedBody})
	if err != nil {
		return fmt.Errorf("marshal provider response: %w", err)
	}
	dir := DefaultDir()
	if dir == "" {
		return errNoRecordDir
	}
	runDir, err := makeRunDir(dir, r.runID)
	if err != nil {
		return err
	}
	path := filepath.Join(runDir, ProviderResponsesFile)
	f, err := openPrivateFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY)
	if err != nil {
		return fmt.Errorf("open %s: %w", path, err)
	}
	if _, err := f.Write(append(line, '\n')); err != nil {
		_ = f.Close()
		return fmt.Errorf("append %s: %w", path, err)
	}
	if err := f.Sync(); err != nil {
		_ = f.Close()
		return fmt.Errorf("sync %s: %w", path, err)
	}
	if err := f.Close(); err != nil {
		return fmt.Errorf("close %s: %w", path, err)
	}
	return nil
}
