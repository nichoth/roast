new file mode 100644
index 0000000000000000000000000000000000000000..5dbcfee2dbad8c80fed1bebd46a7cdda982f0e5b
--- /dev/null
+++ b/src/record/dir.ts
@@ -0,0 +1,89 @@
+// pattern: Imperative Shell
+import path from 'node:path'
+import fs from 'node:fs/promises'
+import { git } from '../git/git.js'
+import type { GitRunOpts } from '../git/git.js'
+import { goTrimSpace } from '../gocompat/strings.js'
+
+export const STATE_DIR = '.roast'
+
+export class NoRecordDirError extends Error {
+    constructor () {
+        super('resolve record directory: run inside a Git repository')
+        this.name = 'NoRecordDirError'
+    }
+}
+
+export function isValidName (name:string):boolean {
+    return name !== '' && name !== '.' && name !== '..' &&
+        !name.includes('/') && !name.includes('\\') && !name.includes('\0')
+}
+
+export async function ensureDir (dir:string):Promise<void> {
+    if (!dir) throw new NoRecordDirError()
+    const state = path.dirname(dir)
+    try {
+        await fs.lstat(state)
+    } catch (err) {
+        if ((err as NodeJS.ErrnoException).code !== 'ENOENT') throw err
+        await fs.mkdir(state, { recursive:true, mode:0o700 })
+        await fs.writeFile(path.join(state, '.gitignore'), '*\n', {
+            mode:0o644,
+        })
+    }
+    await fs.mkdir(dir, { recursive:true, mode:0o700 })
+}
+
+export async function makeRunDir (
+    dir:string,
+    runId:string
+):Promise<string> {
+    if (!isValidName(runId)) {
+        throw new Error(`invalid run id ${JSON.stringify(runId)}`)
+    }
+    await ensureDir(dir)
+    const runDir = path.join(dir, runId)
+    await fs.mkdir(runDir, { recursive:true, mode:0o700 })
+    for (const target of [dir, runDir]) await fs.chmod(target, 0o700)
+    return runDir
+}
+
+export async function openPrivate (
+    file:string,
+    flags:string|number
+):Promise<fs.FileHandle> {
+    const handle = await fs.open(file, flags, 0o600)
+    try {
+        await handle.chmod(0o600)
+        return handle
+    } catch (err) {
+        await handle.close().catch(() => {})
+        throw err
+    }
+}
+
+export async function writePrivate (
+    file:string,
+    data:string|Uint8Array
+):Promise<void> {
+    const handle = await openPrivate(file, 'w')
+    try {
+        await handle.writeFile(data)
+    } finally {
+        await handle.close()
+    }
+}
+
+export async function recordDir (
+    cwd:string,
+    opts:GitRunOpts = {}
+):Promise<string> {
+    try {
+        const out = await git(cwd, ['rev-parse', '--show-toplevel'], opts)
+        const top = goTrimSpace(out.toString())
+        return top ? path.join(top, STATE_DIR, 'runs') : ''
+    } catch (err) {
+        if (opts.signal?.aborted) throw err
+        return ''
+    }
+}
diff --git a/src/record/json.ts b/src/record/json.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b88b9d326d5cea8455b28a2ccb834fd0cec4afda
--- /dev/null
+++ b/src/record/json.ts
@@ -0,0 +1,22 @@
+// pattern: Functional Core
+export { compareBytes } from '../gocompat/strings.js'
+
+// The spec index overrides the area's older HTML-escaping rule.
+export function goStringify (value:unknown, indent?:number):string {
+    const text = JSON.stringify(value, null, indent)
+    if (text === undefined) throw new Error('value is not JSON')
+    return text
+}
+
+export function rfc3339NanoUTC (d:Date):string {
+    return d.toISOString().replace(/\.([0-9]*?)0+Z$/, '.$1Z')
+        .replace('.Z', 'Z')
+}
+
+export function sortedMap (value:unknown):unknown {
+    if (Array.isArray(value)) return value.map(sortedMap)
+    if (value === null || typeof value !== 'object') return value
+    return Object.fromEntries(Object.entries(value)
+        .sort(([a], [b]) => Buffer.compare(Buffer.from(a), Buffer.from(b)))
+        .map(([key, item]) => [key, sortedMap(item)]))
+}
diff --git a/src/record/meta-json.ts b/src/record/meta-json.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1b63e568bf89111a5e7d883c3fcd84c825de3c80
--- /dev/null
+++ b/src/record/meta-json.ts
@@ -0,0 +1,91 @@
+// pattern: Functional Core
+import type { Meta, RoleMeta } from './meta-types.js'
+import { goStringify, sortedMap, compareBytes } from './json.js'
+
+// Ordered field lists are the replay wire contract. A trailing ? means
+// Go omitempty; required fields are retained even at their zero value.
+export const META_FIELDS = [
+    'run_id', 'replay_of?', 'ts', 'repo', 'invoke_dir?', 'argv?', 'roast',
+    'scope', 'derived', 'roles', 'snapshot', 'digests', 'budgets?', 'usage?',
+    'env_names_only?', 'caveats?',
+]
+export const FIELDS:Record<string, string[]> = {
+    roast:['version', 'commit'],
+    scope:[
+        'kind', 'base?', 'uncommitted_only?', 'staged_only?',
+        'include_vendored?', 'paths?', 'excludes?', 'base_oid?',
+        'merge_base_oid?', 'head_oid?', 'survey?', 'staged?', 'files?',
+    ],
+    derived:[
+        'mode', 'langs?', 'quick?', 'interactive', 'max_turns',
+        'confidence_floor', 'do_verify', 'task?', 'max_severity?',
+        'max_diff_bytes?', 'max_file_ctx_bytes?',
+    ],
+    role:[
+        'profile?', 'base_url', 'model', 'protocol', 'api?',
+        'max_output_tokens', 'session_header?', 'prompt_digest?',
+    ],
+    snapshot:[
+        'captured', 'reason?', 'ref?', 'commit?', 'index_tree?',
+        'worktree_tree?', 'base_tree?', 'head?', 'base?', 'diff_pair?',
+        'file_modes?', 'excluded_paths?',
+    ],
+    digests:[
+        'input_kind', 'input', 'input_bytes', 'system_prompt?', 'user_prompt?',
+    ],
+    usage:[
+        'uncached_input_tokens', 'cached_input_tokens', 'cache_write_tokens',
+        'output_tokens', 'calls',
+    ],
+}
+
+export function wireProtocol (role:RoleMeta):string {
+    return role.protocol || role.api || ''
+}
+
+export function captureEnv (
+    env:NodeJS.ProcessEnv,
+    extraSecrets:readonly string[] = []
+):string[] {
+    const secrets = new Set(extraSecrets)
+    return Object.keys(env).filter(name => env[name] !== undefined &&
+        name.startsWith('ROAST_') && !name.endsWith('_API_KEY') &&
+        !secrets.has(name)).sort(compareBytes)
+}
+
+function empty (v:unknown):boolean {
+    if (!v) return true
+    return typeof v === 'object' && Object.keys(v).length === 0
+}
+
+export function ordered (
+    value:object,
+    fields:readonly string[]
+):Record<string, unknown> {
+    const out:Record<string, unknown> = {}
+    for (const field of fields) {
+        const key = field.replace(/\?$/, '')
+        const v:unknown = Reflect.get(value, key)
+        if (!field.endsWith('?') || !empty(v)) out[key] = v
+    }
+    return out
+}
+
+export function orderedMap (
+    value:Record<string, object>,
+    fields:readonly string[]
+):Record<string, unknown> {
+    return Object.fromEntries(Object.keys(value).sort(compareBytes)
+        .map(key => [key, ordered(value[key], fields)]))
+}
+
+export function serializeMeta (meta:Meta):string {
+    const out = ordered(meta, META_FIELDS)
+    for (const key of ['roast', 'scope', 'derived', 'snapshot', 'digests']) {
+        out[key] = ordered(Reflect.get(meta, key), FIELDS[key])
+    }
+    out.roles = orderedMap(meta.roles, FIELDS.role)
+    if (!empty(meta.budgets)) out.budgets = sortedMap(meta.budgets)
+    if (!empty(meta.usage)) out.usage = orderedMap(meta.usage!, FIELDS.usage)
+    return goStringify(out, 2) + '\n'
+}
diff --git a/src/record/meta-read.ts b/src/record/meta-read.ts
new file mode 100644
index 0000000000000000000000000000000000000000..867bf9307ce4d3e9bd2d02d180f9c4906d50ed86
--- /dev/null
+++ b/src/record/meta-read.ts
@@ -0,0 +1,96 @@
+// pattern: Functional Core
+import type { Meta } from './meta-types.js'
+import { FIELDS, META_FIELDS } from './meta-json.js'
+import { wellFormed } from '../llm/json.js'
+
+class NumberToken {
+    constructor (value:number, source:string) {
+        this.value = value
+        this.source = source
+    }
+
+    readonly value:number
+    readonly source:string
+}
+
+const BOOLS = new Set([
+    'uncommitted_only', 'staged_only', 'include_vendored', 'survey',
+    'staged', 'quick', 'interactive', 'do_verify', 'captured',
+])
+const NUMBERS = new Set([
+    'max_turns', 'confidence_floor', 'max_diff_bytes', 'max_file_ctx_bytes',
+    'max_output_tokens', 'input_bytes', ...FIELDS.usage,
+])
+const ARRAYS = new Set([
+    'argv', 'paths', 'excludes', 'files', 'langs', 'excluded_paths',
+    'env_names_only', 'caveats',
+])
+
+function object (value:unknown):Record<string, unknown> {
+    if (value == null) return {}
+    if (typeof value !== 'object' || Array.isArray(value) ||
+        value instanceof NumberToken) throw new Error('expected an object')
+    return value as Record<string, unknown>
+}
+
+function scalar (key:string, value:unknown):unknown {
+    if (ARRAYS.has(key)) {
+        if (value == null) return []
+        if (!Array.isArray(value)) throw new Error('expected an array')
+        return value.map(item => scalar('', item))
+    }
+    if (BOOLS.has(key)) {
+        if (value == null) return false
+        if (typeof value !== 'boolean') throw new Error('expected boolean')
+        return value
+    }
+    if (NUMBERS.has(key)) {
+        if (value == null) return 0
+        if (!(value instanceof NumberToken) ||
+            !Number.isFinite(value.value)) throw new Error('expected number')
+        if (key !== 'confidence_floor' && !/^-?\d+$/.test(value.source)) {
+            throw new Error('expected an integer literal')
+        }
+        return value.value
+    }
+    if (value == null) return ''
+    if (typeof value !== 'string') throw new Error('expected a string')
+    return wellFormed(value)
+}
+
+function plain (value:unknown):unknown {
+    if (value instanceof NumberToken) return value.value
+    if (Array.isArray(value)) return value.map(plain)
+    if (value === null || typeof value !== 'object') return value
+    return Object.fromEntries(Object.entries(value)
+        .map(([key, v]) => [key, plain(v)]))
+}
+
+function struct (value:unknown, fields:readonly string[]):object {
+    const source = object(value)
+    return Object.fromEntries(fields.map(field => {
+        const key = field.replace(/\?$/, '')
+        const v = Object.hasOwn(source, key) ? source[key] : null
+        let decoded:unknown
+        if (['roles', 'usage'].includes(key)) {
+            decoded = Object.fromEntries(Object.entries(object(v))
+                .map(([role, item]) => [role,
+                    struct(item, FIELDS[key === 'roles' ? 'role' : 'usage'])]))
+        } else if (Object.hasOwn(FIELDS, key)) {
+            decoded = struct(v, FIELDS[key])
+        } else if (key === 'budgets') decoded = plain(object(v))
+        else decoded = scalar(key, v)
+        return [key, decoded]
+    }))
+}
+
+export function decodeMeta (text:string):Meta {
+    const raw:unknown = JSON.parse(text, (_key:string, value:unknown,
+        context?:{ source?:string }) => {
+        return typeof value === 'number' ?
+            new NumberToken(value, context?.source ?? String(value)) : value
+    })
+    // Every declared field is decoded and type-checked above; unknown keys
+    // are discarded and null/missing values become Go zero values.
+    return struct(raw, META_FIELDS) as Meta
+}
