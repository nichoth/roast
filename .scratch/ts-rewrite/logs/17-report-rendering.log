  (TestFinderVerifierPipelineWithMockEndpoint,
  TestNativeAnthropicFinderWithChatVerifier),
  `internal/cli/hardening_test.go` (TestRunsShowEscapesStoredReports,
  TestWriteErrorEscapesControls), `internal/cli/trust_test.go`
  (TestTrustSummaryEscapesControlCharacters)

## 7. Resolved

Resolved:

1. `"notes": null` after verification with no notes: Go parity, kept
   (spec.md, "Deliberate changes").
2. JSON output is not HTML-escaped; the differential harness compares
   parsed JSON (spec.md, "JSON encoding").
3. Lone surrogates become U+FFFD when the llm area decodes model output;
   textsafe escapes any remaining as `\uNNNN` (spec.md, "Bytes and text").
4. `verified: true` with no findings: Go parity, kept.
5. Verifier error text in a verdict's reasoning may differ in wording
   from Go: accepted.
// pattern: Functional Core
import { goTrimSpace } from '../gocompat/strings.js'

export const SEVERITIES = [
    'INFO', 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL',
] as const

export type Severity = typeof SEVERITIES[number]

export function severityRank (severity:string):number {
    const rank = SEVERITIES.findIndex(s => s === severity)
    return Math.max(0, rank)
}

export function parseSeverity (value:string):Severity|null {
    const canonical = goTrimSpace(value).toUpperCase()
    return SEVERITIES.find(s => s === canonical) ?? null
}

export type WireFinding = {
    reasoning:string;
    severity:string;
    confidence:number;
    cwe:string;
    description:string;
    file:string;
    lines:number[]|null;
    code_quote:string;
    fixed_code:string;
    frontend_category:string;
}

// The verifier owns the remaining verdict fields (ticket 21).
export type Verdict = {
    status:string;
    recalibrated_severity?:string;
}

export type Finding = WireFinding&{
    verdict?:Verdict;
    _drop_reason?:string;
    id?:string;
    alias?:string;
}

export type FindingsResponse = {
    assessment:string;
    findings:WireFinding[];
}

export type Result = {
    findings:Finding[];
    dropped:Finding[];
    assessment:string;
    notes:string[];
    incomplete?:boolean;
    stopReason?:string;
}

export const ASSESSMENT = {
    FINDINGS_PRESENT:'FINDINGS_PRESENT',
    NO_FINDINGS:'NO_FINDINGS',
    NO_DIFF:'NO_DIFF',
    INCOMPLETE_NO_SUBMISSION:'INCOMPLETE_NO_SUBMISSION',
    NO_FINDINGS_IN_SAMPLED_AREAS:'NO_FINDINGS_IN_SAMPLED_AREAS',
} as const

export const DROP = {
    INVALID_SEVERITY:'invalid_severity',
    MISSING_CODE_QUOTE:'missing_code_quote',
    MISSING_FIXED_CODE:'missing_fixed_code',
    UNGROUNDED_CODE_QUOTE:'ungrounded_code_quote',
    BELOW_CONFIDENCE_FLOOR:'below_confidence_floor',
    REFUTED_BY_VERIFIER:'refuted_by_verifier',
} as const

export function toFinding (w:WireFinding):Finding {
    return {
        reasoning:w.reasoning,
        severity:w.severity,
        confidence:w.confidence,
        cwe:w.cwe,
        description:w.description,
        file:w.file,
        lines:w.lines?.length ? [...w.lines] : null,
        code_quote:w.code_quote,
        fixed_code:w.fixed_code,
        frontend_category:w.frontend_category,
    }
}

export function effectiveSeverity (f:Finding):string {
    if (f.verdict?.status !== 'confirmed') return f.severity
    const recalibrated = parseSeverity(f.verdict.recalibrated_severity ?? '')
    return recalibrated !== null &&
        severityRank(recalibrated) < severityRank(f.severity) ?
        recalibrated : f.severity
}

export function maxSeverity (result:Pick<Result, 'findings'>):number {
    return result.findings.reduce((max, f) =>
        Math.max(max, severityRank(effectiveSeverity(f))), -1)
}
// Classification helpers for the finder prompt layer. Pure functions with no
// model calls and no prompt text.
import { goExt } from '../gocompat/strings.js'
import { UsageError } from '../cli/errors.js'

// Prose extensions compared after lower-casing. Unknown extensions count as
// code — the stricter default.
const PROSE:Set<string> = new Set([
    '.md', '.mdx', '.markdown', '.rst',
    '.txt', '.adoc', '.asciidoc', '.org', '.tex',
])

// Maps lower-cased extensions to language-family tags, used to select finder
// addenda. Extensions not in this table contribute nothing.
const LANG:Map<string, string> = new Map([
    ['.tsx', 'react'], ['.jsx', 'react'],
    ['.vue', 'frontend'], ['.svelte', 'frontend'], ['.astro', 'frontend'],
    ['.ts', 'web'], ['.js', 'web'], ['.mjs', 'web'], ['.cjs', 'web'],
    ['.css', 'web'], ['.scss', 'web'],
    ['.go', 'go'],
])

// Accepted language packs (case-sensitive). resolveLangs validates against this set.
const KNOWN_PACKS:Set<string> = new Set(['go', 'react', 'frontend', 'web'])

/** Classify mode: `code` for empty or all-code files, `prose` when every
  file has a prose extension, `mixed` when some are and others aren't. */
export function classifyMode (files:string[]):'code'|'prose'|'mixed' {
    if (files.length === 0) return 'code'
    let prose = 0
    for (const f of files) {
        const ext = goExt(f).toLowerCase()
        if (PROSE.has(ext)) prose++
    }
    if (prose === 0) return 'code'
    if (prose === files.length) return 'prose'
    return 'mixed'
}

/** Map each file's lower-cased extension through the language table, dedupe,
  and sort ascending. Unmapped extensions contribute nothing; empty input
  yields `[]`. */
export function classifyLangs (files:string[]):string[] {
    const seen = new Set<string>()
    for (const f of files) {
        const ext = goExt(f).toLowerCase()
        const tag = LANG.get(ext)
        if (tag !== undefined) seen.add(tag)
    }
    return Array.from(seen).sort((a, b) => a < b ? -1 : a > b ? 1 : 0)
}

/** Resolve language packs from the `--lang` flag values. When mode is prose
  the flag values are silently ignored and `[]` is returned. Without flag
  values the function auto-classifies by scanning file extensions. For any
  non-empty flag list, `none` alone yields `[]`, `none` combined with another
  pack or an unknown pack (case-sensitive, untrimmed) throws a `UsageError`;
  otherwise the function returns the flag values as given, preserving order
  and duplicates. */
export function resolveLangs (
    values:string[],
    files:string[],
    mode:string,
):string[] {
    if (mode === 'prose') return []

    // No flag values -> auto-classify from file extensions.
    if (values.length === 0) return classifyLangs(files)

    // Validate each value before proceeding.
    for (const v of values) {
        if (v === 'none') {
            if (values.length !== 1) {
                throw new UsageError(
                    '--lang none cannot be combined with another language pack',
                )
            }
            return []
        }
        if (!KNOWN_PACKS.has(v)) {
            throw new UsageError('unknown language pack "' + v + '"')
        }
    }

    // All values are valid -> return as given (order and duplicates kept).
    return [...values]
}
// Neutralizes terminal control sequences in untrusted text before it reaches
// a terminal or a Markdown report (Go: internal/textsafe).
//
// `text` keeps line structure (LF and tab survive, CRLF becomes LF);
// `line` keeps everything on one line (LF and tab become `\n` and `\t`).
// Controls, DEL, C1 controls, invalid UTF-8 bytes, and lone surrogates
// become printable escapes. Backslash is never escaped, so both functions
// are idempotent.

// A decoded unit: a code point (>= 0), or an invalid byte stored as
// -(byte + 1).
type Unit = number

// Fast path: true when the mode would change nothing in `s`. A
// well-formed surrogate pair is clean; a lone surrogate is not.
function isClean (s:string, lineMode:boolean):boolean {
    for (let i = 0; i < s.length; i++) {
        const c = s.charCodeAt(i)
        if (c < 0x20) {
            if (lineMode || (c !== 0x0a && c !== 0x09)) return false
        } else if (c >= 0x7f && c <= 0x9f) {
            return false
        } else if (c >= 0xd800 && c <= 0xdbff) {
            const next = s.charCodeAt(i + 1)
            if (!(next >= 0xdc00 && next <= 0xdfff)) return false
            i++
        } else if (c >= 0xdc00 && c <= 0xdfff) {
            return false
        }
    }
    return true
}

function hex (n:number, width:number):string {
    return n.toString(16).padStart(width, '0')
}

function escapeUnits (units:Unit[], lineMode:boolean):string {
    let out = ''
    for (let i = 0; i < units.length; i++) {
        const u = units[i]
        if (u < 0) {
            out += '\\x' + hex(-u - 1, 2)
        } else if (u === 0x0d) {
            if (!lineMode && units[i + 1] === 0x0a) continue
            out += '\\x0d'
        } else if (u === 0x0a) {
            out += lineMode ? '\\n' : '\n'
        } else if (u === 0x09) {
            out += lineMode ? '\\t' : '\t'
        } else if (u < 0x20 || u === 0x7f) {
            out += '\\x' + hex(u, 2)
        } else if ((u >= 0x80 && u <= 0x9f) ||
            (u >= 0xd800 && u <= 0xdfff)) {
            out += '\\u' + hex(u, 4)
        } else {
            out += String.fromCodePoint(u)
        }
    }
    return out
}

function stringUnits (s:string):Unit[] {
    const units:Unit[] = []
    // String iteration yields a lone surrogate as its own code point.
    for (const ch of s) units.push(ch.codePointAt(0)!)
    return units
}

function isCont (b:number|undefined):boolean {
    return b !== undefined && b >= 0x80 && b <= 0xbf
}

// Decodes one rune at `i` with Go utf8.DecodeRune validity rules. Returns
// [codePoint, size], or [-1, 1] for an invalid or truncated sequence.
function decodeRune (b:Uint8Array, i:number):[number, number] {
    const b0 = b[i]
    if (b0 < 0x80) return [b0, 1]
    const b1 = b[i + 1]
    if (b0 >= 0xc2 && b0 <= 0xdf) {
        if (!isCont(b1)) return [-1, 1]
        return [((b0 & 0x1f) << 6) | (b1 & 0x3f), 2]
    }
    if (b0 >= 0xe0 && b0 <= 0xef) {
        const lo = b0 === 0xe0 ? 0xa0 : 0x80
        const hi = b0 === 0xed ? 0x9f : 0xbf
        if (b1 === undefined || b1 < lo || b1 > hi) return [-1, 1]
        const b2 = b[i + 2]
        if (!isCont(b2)) return [-1, 1]
        return [((b0 & 0x0f) << 12) | ((b1 & 0x3f) << 6) | (b2 & 0x3f), 3]
    }
    if (b0 >= 0xf0 && b0 <= 0xf4) {
        const lo = b0 === 0xf0 ? 0x90 : 0x80
        const hi = b0 === 0xf4 ? 0x8f : 0xbf
        if (b1 === undefined || b1 < lo || b1 > hi) return [-1, 1]
        const b2 = b[i + 2]
        const b3 = b[i + 3]
        if (!isCont(b2) || !isCont(b3)) return [-1, 1]
        return [((b0 & 0x07) << 18) | ((b1 & 0x3f) << 12) |
            ((b2 & 0x3f) << 6) | (b3 & 0x3f), 4]
    }
    return [-1, 1]
}

function byteUnits (b:Uint8Array):Unit[] {
    const units:Unit[] = []
    for (let i = 0; i < b.length;) {
        const [cp, size] = decodeRune(b, i)
        units.push(cp < 0 ? -(b[i] + 1) : cp)
        i += size
    }
    return units
}

// Multi-line sanitizing of a string.
export function text (s:string):string {
    if (isClean(s, false)) return s
    return escapeUnits(stringUnits(s), false)
}

// Single-line sanitizing of a string.
export function line (s:string):string {
    if (isClean(s, true)) return s
    return escapeUnits(stringUnits(s), true)
}

// Multi-line sanitizing of raw bytes, escaping each invalid UTF-8 byte.
export function textBytes (b:Uint8Array):string {
    return escapeUnits(byteUnits(b), false)
}

// Single-line sanitizing of raw bytes.
export function lineBytes (b:Uint8Array):string {
    return escapeUnits(byteUnits(b), true)
}
// Package render converts a completed review run into its two output formats:
// JSON on stdout (consumed by hooks and tooling) and Markdown on stderr
// (human-readable progress and summary).
package render

import (
	"encoding/json"
	"fmt"
	"sort"
	"strings"

	"github.com/bluesky-social/roast/internal/llm"
	"github.com/bluesky-social/roast/internal/review"
	"github.com/bluesky-social/roast/internal/textsafe"
)

// SizeEntry records the byte contribution of one file to the diff payload.
type SizeEntry struct {
	Path  string `json:"path"`
	Bytes int    `json:"bytes"`
}

// Report is everything needed to render one review run.
type Report struct {
	Result        *review.Result
	Mode          string
	FilesReviewed []string
	Task          string
	RunID         string
	// Budgets is the run's budget provenance: every ceiling in force this run
	// (value + default/flag/env source) plus the ledger's reconciled spend,
	// so eval comparisons cannot silently mix budget regimes.
	Budgets           map[string]any
	Quick             bool
	Verified          bool
	DiffTruncated     bool
	OriginalDiffBytes int
	SizeBreakdown     []SizeEntry
	Usage             map[string]llm.Usage
	// Prior maps a finding fingerprint to an optional human note.
	Prior map[string]string
	// PromptPacks is the set of language addenda active for this run
	// (from review.ClassifyLangs or --lang), for post-hoc dimension analysis.
	PromptPacks []string

	// Survey coverage contract (populated only for survey scope). A clean
	// survey must NOT be machine-indistinguishable from a clean full review,
	// so these fields make the triage nature and completeness legible to any
	// consumer. Empty ReviewKind means a normal (diff) review — the fields
	// are omitted from output entirely.
	ReviewKind        string // "survey_triage" for survey scope, else ""
	Completion        string // "partial" | "complete"
	ManifestFileCount int    // number of files in the manifest (len(sc.Files))
	StopReason        string // "converged" | "budget_exhausted" | "incomplete_no_submission"

}

// ToJSON returns the machine-readable JSON payload written to stdout.
// Shape matches the Python v2 to_json output; per-finding fingerprint and
// prior-sighting annotations are added when present.
func ToJSON(r Report) string {
	type findingOut struct {
		review.Finding
		Fingerprint   string `json:"fingerprint,omitempty"`
		PriorSighting string `json:"prior_sighting,omitempty"`
	}

	marshalFindings := func(fs []review.Finding) []findingOut {
		out := make([]findingOut, len(fs))
		for i, f := range fs {
			fo := findingOut{Finding: f}
			fp := review.Fingerprint(f)
			fo.Fingerprint = fp
			if r.Prior != nil {
				if note, ok := r.Prior[fp]; ok {
					fo.PriorSighting = note
				}
			}
			out[i] = fo
		}
		return out
	}

	payload := map[string]any{
		"findings":         marshalFindings(r.Result.Findings),
		"dropped_findings": marshalFindings(r.Result.Dropped),
		"assessment":       r.Result.Assessment,
		"mode":             r.Mode,
		"quick":            r.Quick,
		"verified":         r.Verified,
		"files_reviewed":   r.FilesReviewed,
		"notes":            r.Result.Notes,
		"usage":            r.Usage,
		"prompt_packs":     r.PromptPacks,
	}
	if r.RunID != "" {
		payload["run_id"] = r.RunID
	}
	// Cutoff state must survive into machine-readable output even outside
	// survey scope (where completion/stop_reason don't render): a non-survey
	// interactive cutoff with retained findings reads FINDINGS_PRESENT and
	// would otherwise be indistinguishable from a completed review. The
	// survey block below owns the stop_reason key when ReviewKind is set.
	if r.Result.Incomplete {
		payload["incomplete"] = true
	}
	if r.Result.StopReason != "" && r.ReviewKind == "" {
		payload["stop_reason"] = r.Result.StopReason
	}
	if r.Budgets != nil {
		payload["budgets"] = r.Budgets
	}
	if r.DiffTruncated {
		payload["diff_truncated"] = true
		payload["original_diff_bytes"] = r.OriginalDiffBytes
		payload["size_breakdown"] = r.SizeBreakdown
	}
	if r.ReviewKind != "" {
		payload["review_kind"] = r.ReviewKind
		payload["completion"] = r.Completion
		payload["manifest_file_count"] = r.ManifestFileCount
		payload["stop_reason"] = r.StopReason
	}
	b, _ := json.Marshal(payload)
	return string(b)
}

// ToMarkdown returns the human-readable Markdown summary written to stderr.
// Findings are sorted severity-descending then confidence-descending. When
// showDropped is true a dropped-findings section is appended. Finding text is
// escaped for terminals (see renderFinding); ToJSON needs no such pass because
// encoding/json escapes control characters itself.
func ToMarkdown(r Report, showDropped bool) string {
	res := r.Result
	var lines []string

	if r.ReviewKind != "" {
		lines = append(lines, fmt.Sprintf(
			"> Survey triage — manifest contains %d files, completion=%s, stop=%s",
			r.ManifestFileCount, r.Completion, r.StopReason,
		))
		lines = append(lines, "")
	}

	nRefuted := 0
	for _, f := range res.Dropped {
		if f.DropReason == review.DropRefutedByVerifier {
			nRefuted++
		}
	}
	nMalformed := len(res.Dropped) - nRefuted

	if len(res.Findings) == 0 {
		switch {
		case res.Assessment == review.AssessmentNoDiff:
			lines = append(lines, "## Nothing to review in this scope — no review ran")
			lines = append(lines, "")
			lines = append(lines, "No model was called, so this is NOT a clean review. Already committed? Try `--base <ref>`; use `--staged` before committing or `--scope repo` for a repository survey.")
		// Cutoff first: an incomplete cutoff carries BOTH markers and must
		// name the specific stop reason, not generic budget exhaustion.
		case res.StopReason == "deadline" || res.StopReason == "token_budget":
			// Zero findings before the cutoff — a truncated review must
			// never read as clean.
			lines = append(lines, fmt.Sprintf("## Roast cut off early (%s) — no findings before the cutoff", res.StopReason))
			lines = append(lines, "")
			lines = append(lines, "The review was cut short by a run ceiling; this is NOT a clean review.")
		case res.Assessment == review.AssessmentIncompleteNoSubmission:
			lines = append(lines, "## Roast incomplete — no findings were submitted")
			lines = append(lines, "")
			lines = append(lines, "The interactive review exhausted its budget before submitting; this is NOT a clean review.")
		default:
			lines = append(lines, "## Roast complete — no findings")
			lines = append(lines, "")
			msg := "The adversary found nothing to complain about."
			if nRefuted > 0 {
				msg += fmt.Sprintf(" (%d candidate finding(s) were refuted by the cross-model verifier.)", nRefuted)
			}
			lines = append(lines, msg)
		}
	} else {
		if res.StopReason != "" {
			// Retained/wrap-up findings from any cutoff are partial — the
			// human summary must say so, not read as a completed review.
			lines = append(lines, fmt.Sprintf("## Roast cut off early (%s) — partial findings follow", res.StopReason), "")
		}
		suffix := ""
		if r.Verified {
			suffix = " (cross-model verified)"
		}
		lines = append(lines, fmt.Sprintf("## Roast: %d finding(s)%s", len(res.Findings), suffix))
	}
	if nMalformed > 0 {
		lines = append(lines, "")
		lines = append(lines, fmt.Sprintf("*(%d candidate(s) dropped by schema gates; --show-dropped to see them.)*", nMalformed))
	}
	lines = append(lines, "")

	sorted := make([]review.Finding, len(res.Findings))
	copy(sorted, res.Findings)
	sort.SliceStable(sorted, func(i, j int) bool {
		ri, rj := sorted[i].EffectiveSeverity().Rank(), sorted[j].EffectiveSeverity().Rank()
		if ri != rj {
			return ri > rj
		}
		return sorted[i].Confidence > sorted[j].Confidence
	})

	for i, f := range sorted {
		lines = append(lines, renderFinding(i+1, f, false, r.Prior)...)
	}

	if showDropped && len(res.Dropped) > 0 {
		lines = append(lines, "## Dropped findings (--show-dropped)")
		lines = append(lines, "")
		for i, f := range res.Dropped {
			lines = append(lines, renderFinding(i+1, f, true, r.Prior)...)
		}
	}
	return strings.Join(lines, "\n")
}

// renderFinding formats one finding as a Markdown block. prior maps
// fingerprint → human note; when the finding's fingerprint has an entry it is
// appended as "seen previously" line.
func renderFinding(i int, f review.Finding, dropped bool, prior map[string]string) []string {
	sev := textsafe.Line(string(f.Severity))
	if sev == "" {
		sev = "INFO"
	}
	if eff := f.EffectiveSeverity(); eff != f.Severity {
		sev = fmt.Sprintf("%s (finder claimed %s — verifier recalibrated)", textsafe.Line(string(eff)), sev)
	}
	confStr := fmt.Sprintf(" · conf %.2f", f.Confidence)
	tag := ""
	if dropped {
		reason := f.DropReason
		if reason == "" {
			reason = "?"
		}
		tag = fmt.Sprintf("[DROPPED:%s] ", textsafe.Line(reason))
	}
	path := f.File
	if path == "" {
		path = "?"
	}
	lnStr := "?"
	if len(f.Lines) == 1 {
		lnStr = fmt.Sprintf("%d", f.Lines[0])
	} else if len(f.Lines) > 1 {
		lnStr = fmt.Sprintf("%d-%d", f.Lines[0], f.Lines[len(f.Lines)-1])
	}

	desc := textsafe.Line(strings.TrimSpace(f.Description))
	var out []string
	// Stable alias over ordinal: "R-8d8d19" survives re-runs and
	// re-ordering, "finding #2" does not. Ordinal fallback only for findings
	// predating identity assignment (old run records).
	handle := textsafe.Line(f.Alias)
	if handle == "" {
		handle = fmt.Sprintf("%d.", i)
	}
	out = append(out, fmt.Sprintf("### %s %s[%s%s] %s", handle, tag, sev, confStr, desc))
	out = append(out, "- **File:** "+inlineCode(textsafe.Line(path)+":"+lnStr))
	if f.CWE != "" {
		out = append(out, fmt.Sprintf("- **CWE:** %s", textsafe.Line(f.CWE)))
	}
	out = append(out, fmt.Sprintf("- **Reasoning:** %s", listItemText(f.Reasoning, "  ")))

	if f.Verdict != nil {
		v := f.Verdict
		vStatus := textsafe.Line(string(v.Status))
		vConfStr := fmt.Sprintf(" (conf %.2f)", v.Confidence)
		verifierName := textsafe.Line(v.Verifier)
		if verifierName == "" {
			verifierName = "?"
		}
		out = append(out, fmt.Sprintf("- **Verifier (%s):** %s%s", verifierName, vStatus, vConfStr))
		if v.Grounding != "" {
			out = append(out, fmt.Sprintf("  - grounding: %s", listItemText(v.Grounding, "    ")))
		}
	}

	for _, pair := range [][2]string{{"Current", f.CodeQuote}, {"Proposed fix", f.FixedCode}} {
		label, block := pair[0], strings.TrimRight(textsafe.Text(pair[1]), "\n")
		if block != "" {
			fence := codeFence(block)
			out = append(out, fmt.Sprintf("- **%s:**", label))
			out = append(out, "  "+fence)
			for _, ln := range strings.Split(block, "\n") {
				out = append(out, "  "+ln)
			}
			out = append(out, "  "+fence)
		} else if dropped {
			out = append(out, fmt.Sprintf("- **%s:** *(not provided)*", label))
		}
	}

	// Prior-sighting annotation.
	fp := review.Fingerprint(f)
	if prior != nil {
		if note, ok := prior[fp]; ok {
			out = append(out, fmt.Sprintf("- **Seen previously:** %s", textsafe.Line(note)))
		}
	}

	out = append(out, "")
	return out
}

// listItemText sanitizes a multi-line field and indents each continuation
// line, so model-written text cannot leave its list item and pose as a
// report heading.
func listItemText(s, indent string) string {
	return strings.ReplaceAll(textsafe.Text(strings.TrimSpace(s)), "\n", "\n"+indent)
}

// codeFence returns a backtick fence longer than any backtick run in content,
// so a quoted ``` line cannot close the block early.
func codeFence(content string) string {
	return strings.Repeat("`", max(3, longestBacktickRun(content)+1))
}

// inlineCode wraps s in a code span whose delimiter outruns any backtick run
// inside it, padding with spaces when s starts or ends with a backtick.
func inlineCode(s string) string {
	delim := strings.Repeat("`", longestBacktickRun(s)+1)
	if strings.HasPrefix(s, "`") || strings.HasSuffix(s, "`") {
		return delim + " " + s + " " + delim
	}
	return delim + s + delim
}

func longestBacktickRun(s string) int {
	longest, run := 0, 0
	for i := 0; i < len(s); i++ {
		if s[i] != '`' {
			run = 0
			continue
		}
		run++
		longest = max(longest, run)
	}
	return longest
}

