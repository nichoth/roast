// pattern: Functional Core
import type { RecordUsage } from '../llm/types.js'
import type { Finding, Result } from '../review/types.js'
import { effectiveSeverity, severityRank } from '../review/types.js'
import { headline, renderFinding } from './markdown.js'
import { fingerprint } from '../review/fingerprint.js'

export type SizeEntry = { path:string; bytes:number }

export type Report = {
    result:Omit<Result, 'notes'>&{ notes?:string[]|null };
    mode:string;
    filesReviewed?:string[]|null;
    task?:string;
    runId?:string;
    budgets?:Record<string, unknown>|null;
    quick?:boolean;
    verified?:boolean;
    diffTruncated?:boolean;
    originalDiffBytes?:number;
    sizeBreakdown?:SizeEntry[]|null;
    usage?:Record<string, RecordUsage>|null;
    prior?:Map<string, string>|null;
    promptPacks?:string[]|null;
    reviewKind?:''|'survey_triage';
    completion?:string;
    manifestFileCount?:number;
    stopReason?:string;
}

function findingOut (f:Finding, r:Report):Record<string, unknown> {
    const out:Record<string, unknown> = {
        reasoning:f.reasoning,
        severity:f.severity,
        confidence:f.confidence,
        cwe:f.cwe,
        description:f.description,
        file:f.file,
        lines:f.lines ?? null,
        code_quote:f.code_quote,
        fixed_code:f.fixed_code,
        frontend_category:f.frontend_category,
    }
    if (f.verdict) {
        const v = f.verdict
        const verdict:Record<string, unknown> = {
            reasoning:v.reasoning ?? '',
            status:v.status,
            confidence:v.confidence ?? 0,
            grounding:v.grounding ?? '',
        }
        if (v.recalibrated_severity) {
            verdict.recalibrated_severity = v.recalibrated_severity
        }
        if (v.verifier) verdict.verifier = v.verifier
        if (v.undecided) verdict.undecided = true
        out.verdict = verdict
    }
    for (const key of ['_drop_reason', 'id', 'alias'] as const) {
        if (f[key]) out[key] = f[key]
    }
    const fp = fingerprint(f)
    if (fp) out.fingerprint = fp
    const note = r.prior?.get(fp)
    if (note) out.prior_sighting = note
    return out
}

function sortedValue (value:unknown):unknown {
    if (Array.isArray(value)) return value.map(sortedValue)
    if (value === null || typeof value !== 'object') return value
    return Object.fromEntries(Object.entries(value)
        .sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)
        .map(([key, v]) => [key, sortedValue(v)]))
}

function usageOut (usage:Record<string, RecordUsage>):unknown {
    return Object.fromEntries(Object.keys(usage).sort().map(role => {
        const u = usage[role]
        return [role, {
            uncached_input_tokens:u.uncached_input_tokens,
            cached_input_tokens:u.cached_input_tokens,
            cache_write_tokens:u.cache_write_tokens,
            output_tokens:u.output_tokens,
            calls:u.calls,
        }]
    }))
}

export function toJSON (r:Report):string {
    const payload:Record<string, unknown> = {
        assessment:r.result.assessment,
        dropped_findings:r.result.dropped.map(f => findingOut(f, r)),
        files_reviewed:r.filesReviewed ?? null,
        findings:r.result.findings.map(f => findingOut(f, r)),
        mode:r.mode,
        notes:r.result.notes ?? null,
        prompt_packs:r.promptPacks ?? null,
        quick:r.quick ?? false,
        usage:r.usage ? usageOut(r.usage) : null,
        verified:r.verified ?? false,
    }
    if (r.budgets != null) payload.budgets = sortedValue(r.budgets)
    if (r.diffTruncated) {
        payload.diff_truncated = true
        payload.original_diff_bytes = r.originalDiffBytes ?? 0
        payload.size_breakdown = r.sizeBreakdown?.map(s => ({
            path:s.path, bytes:s.bytes,
        })) ?? null
    }
    if (r.result.incomplete) payload.incomplete = true
    if (r.result.stopReason) payload.stop_reason = r.result.stopReason
    if (r.reviewKind === 'survey_triage') {
        payload.review_kind = r.reviewKind
        payload.completion = r.completion ?? ''
        payload.manifest_file_count = r.manifestFileCount ?? 0
        payload.stop_reason = r.stopReason ?? ''
    }
    if (r.runId) payload.run_id = r.runId
    return JSON.stringify(Object.fromEntries(
        Object.entries(payload).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)
    ))
}

export function toMarkdown (r:Report, showDropped:boolean):string {
    const lines:string[] = []
    if (r.reviewKind === 'survey_triage') {
        lines.push('> Survey triage \u2014 manifest contains ' +
            `${r.manifestFileCount ?? 0} files, ` +
            `completion=${r.completion ?? ''}, stop=${r.stopReason ?? ''}`,
        '')
    }
    lines.push(...headline(r))
    const sorted = [...r.result.findings].sort((a, b) =>
        severityRank(effectiveSeverity(b)) -
        severityRank(effectiveSeverity(a)) || b.confidence - a.confidence)
    for (const [i, f] of sorted.entries()) {
        lines.push(...renderFinding(i + 1, f, false, r.prior))
    }
    if (showDropped && r.result.dropped.length) {
        lines.push('## Dropped findings (--show-dropped)', '')
        for (const [i, f] of r.result.dropped.entries()) {
            lines.push(...renderFinding(i + 1, f, true, r.prior))
        }
    }
    return lines.join('\n')
}

export { writeReport } from './write.js'
// pattern: Functional Core
import type { Report } from './render.js'
import { formatFixed2, goTrimSpace } from '../gocompat/strings.js'
import { line, text } from '../textsafe/textsafe.js'
import { fingerprint } from '../review/fingerprint.js'
import { effectiveSeverity, type Finding } from '../review/types.js'

function longestBacktickRun (s:string):number {
    let longest = 0
    let run = 0
    for (const ch of s) {
        run = ch === '`' ? run + 1 : 0
        longest = Math.max(longest, run)
    }
    return longest
}

function inlineCode (s:string):string {
    const delim = '`'.repeat(longestBacktickRun(s) + 1)
    const padded = s.startsWith('`') || s.endsWith('`') ? ` ${s} ` : s
    return delim + padded + delim
}

export function listItemText (s:string, indent:string):string {
    return text(goTrimSpace(s)).replaceAll('\n', '\n' + indent)
}

export function renderFinding (
    ordinal:number,
    f:Finding,
    dropped:boolean,
    prior?:Map<string, string>|null,
):string[] {
    let sev = line(f.severity) || 'INFO'
    const effective = effectiveSeverity(f)
    if (effective !== f.severity) {
        sev = `${line(effective)} (finder claimed ${sev} ` +
            '\u2014 verifier recalibrated)'
    }
    const handle = line(f.alias ?? '') || `${ordinal}.`
    const tag = dropped ? `[DROPPED:${line(f._drop_reason || '?')}] ` : ''
    const conf = formatFixed2(f.confidence)
    const ln = !f.lines?.length ? '?' : f.lines.length === 1 ?
        `${f.lines[0]}` : `${f.lines[0]}-${f.lines[f.lines.length - 1]}`
    const desc = line(goTrimSpace(f.description))
    const out = [
        `### ${handle} ${tag}[${sev} \u00b7 conf ${conf}] ${desc}`,
        '- **File:** ' + inlineCode(line(f.file || '?') + ':' + ln),
    ]
    if (f.cwe) out.push('- **CWE:** ' + line(f.cwe))
    out.push('- **Reasoning:** ' + listItemText(f.reasoning, '  '))
    if (f.verdict) {
        const v = f.verdict
        out.push(`- **Verifier (${line(v.verifier || '?')}):** ` +
            `${line(v.status)} (conf ${formatFixed2(v.confidence ?? 0)})`)
        if (v.grounding) {
            out.push('  - grounding: ' + listItemText(v.grounding, '    '))
        }
    }
    for (const [label, value] of [
        ['Current', f.code_quote], ['Proposed fix', f.fixed_code],
    ]) {
        const block = text(value).replace(/\n+$/, '')
        if (block) {
            const fence = '`'.repeat(Math.max(3,
                longestBacktickRun(block) + 1))
            out.push(`- **${label}:**`, '  ' + fence,
                ...block.split('\n').map(l => '  ' + l), '  ' + fence)
        } else if (dropped) {
            out.push(`- **${label}:** *(not provided)*`)
        }
    }
    const fp = fingerprint(f)
    if (prior?.has(fp)) {
        out.push('- **Seen previously:** ' + line(prior.get(fp)!))
    }
    out.push('')
    return out
}

export function headline (r:Report):string[] {
    const res = r.result
    const lines:string[] = []
    const refuted = res.dropped.filter(f =>
        f._drop_reason === 'refuted_by_verifier').length
    const malformed = res.dropped.length - refuted
    if (!res.findings.length) {
        if (res.assessment === 'NO_DIFF') {
            lines.push('## Nothing to review in this scope ' +
                '\u2014 no review ran', '',
            'No model was called, so this is NOT a clean review. ' +
                'Already committed? Try `--base <ref>`; use `--staged` ' +
                'before committing or `--scope repo` for a repository survey.')
        } else if (res.stopReason === 'deadline' ||
            res.stopReason === 'token_budget') {
            lines.push(`## Roast cut off early (${res.stopReason}) ` +
                '\u2014 no findings before the cutoff', '',
            'The review was cut short by a run ceiling; ' +
                'this is NOT a clean review.')
        } else if (res.assessment === 'INCOMPLETE_NO_SUBMISSION') {
            lines.push('## Roast incomplete \u2014 ' +
                'no findings were submitted', '',
            'The interactive review exhausted its budget before ' +
                'submitting; this is NOT a clean review.')
        } else {
            let msg = 'The adversary found nothing to complain about.'
            if (refuted > 0) {
                msg += ` (${refuted} candidate finding(s) were refuted ` +
                    'by the cross-model verifier.)'
            }
            lines.push('## Roast complete \u2014 no findings', '', msg)
        }
    } else {
        if (res.stopReason) {
            lines.push(`## Roast cut off early (${line(res.stopReason)}) ` +
                '\u2014 partial findings follow', '')
        }
        const suffix = r.verified ? ' (cross-model verified)' : ''
        lines.push(`## Roast: ${res.findings.length} finding(s)${suffix}`)
    }
    if (malformed > 0) {
        lines.push('', `*(${malformed} candidate(s) dropped by schema ` +
            'gates; --show-dropped to see them.)*')
    }
    lines.push('')
    return lines
}
// pattern: Functional Core
import { maxSeverity, type Result } from '../review/types.js'

export function reportExitCode (
    result:Pick<Result, 'findings'>,
    gateRank:number,
    partial:boolean,
):number {
    const live = result.findings.filter(f => f.verdict?.status !== 'refuted')
    if (gateRank >= 0 && maxSeverity({ findings:live }) >= gateRank) return 1
    return partial ? 4 : 0
}
