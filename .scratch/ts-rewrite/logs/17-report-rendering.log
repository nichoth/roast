// pattern: Functional Core
import { goTrimSpace } from '../gocompat/strings.js'

export const SEVERITIES = [
    'INFO', 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL',
] as const

export type Severity = typeof SEVERITIES[number]

export function severityRank (severity:string):number {
    const rank = SEVERITIES.findIndex(s => s === severity)
    return Math.max(0, rank)
}

export function parseSeverity (value:string):Severity|null {
    const canonical = goTrimSpace(value).toUpperCase()
    return SEVERITIES.find(s => s === canonical) ?? null
}

export type WireFinding = {
    reasoning:string;
    severity:string;
    confidence:number;
    cwe:string;
    description:string;
    file:string;
    lines:number[]|null;
    code_quote:string;
    fixed_code:string;
    frontend_category:string;
}

// The verifier owns the remaining verdict fields (ticket 21).
export type Verdict = {
    status:string;
    recalibrated_severity?:string;
}

export type Finding = WireFinding&{
    verdict?:Verdict;
    _drop_reason?:string;
    id?:string;
    alias?:string;
}

export type FindingsResponse = {
    assessment:string;
    findings:WireFinding[];
}

export type Result = {
    findings:Finding[];
    dropped:Finding[];
    assessment:string;
    notes:string[];
    incomplete?:boolean;
    stopReason?:string;
}

export const ASSESSMENT = {
    FINDINGS_PRESENT:'FINDINGS_PRESENT',
    NO_FINDINGS:'NO_FINDINGS',
    NO_DIFF:'NO_DIFF',
    INCOMPLETE_NO_SUBMISSION:'INCOMPLETE_NO_SUBMISSION',
    NO_FINDINGS_IN_SAMPLED_AREAS:'NO_FINDINGS_IN_SAMPLED_AREAS',
} as const

export const DROP = {
    INVALID_SEVERITY:'invalid_severity',
    MISSING_CODE_QUOTE:'missing_code_quote',
    MISSING_FIXED_CODE:'missing_fixed_code',
    UNGROUNDED_CODE_QUOTE:'ungrounded_code_quote',
    BELOW_CONFIDENCE_FLOOR:'below_confidence_floor',
    REFUTED_BY_VERIFIER:'refuted_by_verifier',
} as const

export function toFinding (w:WireFinding):Finding {
    return {
        reasoning:w.reasoning,
        severity:w.severity,
        confidence:w.confidence,
        cwe:w.cwe,
        description:w.description,
        file:w.file,
        lines:w.lines?.length ? [...w.lines] : null,
        code_quote:w.code_quote,
        fixed_code:w.fixed_code,
        frontend_category:w.frontend_category,
    }
}

export function effectiveSeverity (f:Finding):string {
    if (f.verdict?.status !== 'confirmed') return f.severity
    const recalibrated = parseSeverity(f.verdict.recalibrated_severity ?? '')
    return recalibrated !== null &&
        severityRank(recalibrated) < severityRank(f.severity) ?
        recalibrated : f.severity
}

export function maxSeverity (result:Pick<Result, 'findings'>):number {
    return result.findings.reduce((max, f) =>
        Math.max(max, severityRank(effectiveSeverity(f))), -1)
}
// Usage normalization (spec 06, 2.9): provider fields -> disjoint
// intermediate counts (stage 1, per protocol) -> Usage (stage 2, shared).
// Cached tokens are subtracted exactly once (deliberate change 13).

import type { Usage } from './types.js'

export interface IntermediateUsage {
    input:number;
    cacheRead:number;
    cacheWrite:number;
    output:number;
}

function num (v:unknown):number {
    return typeof v === 'number' && Number.isFinite(v) ? v : 0
}

function obj (v:unknown):Record<string, unknown> {
    return v !== null && typeof v === 'object' && !Array.isArray(v) ?
        v as Record<string, unknown> :
        {}
}

// Stage 1 for `chat`: the `usage` object of a completion chunk.
export function chatUsage (raw:unknown):IntermediateUsage {
    const u = obj(raw)
    const prompt = num(u.prompt_tokens)
    const cached = num(obj(u.prompt_tokens_details).cached_tokens)
    const output = num(u.completion_tokens)
    const reasoning = num(obj(u.completion_tokens_details).reasoning_tokens)
    return {
        input:Math.max(prompt - cached, 0),
        cacheRead:cached,
        cacheWrite:0,
        output:reasoning > output ? output + reasoning : output,
    }
}

// Stage 2: clamp every count to >= 0; one call.
export function normalizeUsage (u:IntermediateUsage):Usage {
    return {
        uncachedInputTokens:Math.max(u.input, 0),
        cachedInputTokens:Math.max(u.cacheRead, 0),
        cacheWriteTokens:Math.max(u.cacheWrite, 0),
        outputTokens:Math.max(u.output, 0),
        calls:1,
    }
}

export function zeroUsage ():Usage {
    return {
        uncachedInputTokens:0,
        cachedInputTokens:0,
        cacheWriteTokens:0,
        outputTokens:0,
        calls:0,
    }
}

// A client's running total across its calls.
export class UsageAccumulator {
    private sum:Usage = zeroUsage()

    add (u:Usage):void {
        this.sum.uncachedInputTokens += u.uncachedInputTokens
        this.sum.cachedInputTokens += u.cachedInputTokens
        this.sum.cacheWriteTokens += u.cacheWriteTokens
        this.sum.outputTokens += u.outputTokens
        this.sum.calls += u.calls
    }

    total ():Usage {
        return { ...this.sum }
    }
}
// pattern: Functional Core
import { createHash } from 'node:crypto'
import { isGoSpace } from '../gocompat/strings.js'

export function collapseWhitespace (s:string):string {
    let out = ''
    let space = false
    for (const ch of s) {
        if (isGoSpace(ch.codePointAt(0)!)) {
            space = out.length > 0
        } else {
            if (space) out += ' '
            out += ch
            space = false
        }
    }
    return out
}

export function fingerprint (
    f:{ file:string, code_quote:string }
):string {
    return createHash('sha256')
        .update(f.file + '\u0000' + collapseWhitespace(f.code_quote))
        .digest('hex').slice(0, 16)
}
import { PassThrough, Writable } from 'node:stream'

// A writable that keeps everything written to it.
export class BufferStream extends Writable {
    chunks:Buffer[] = []

    _write (
        chunk:Buffer|string,
        _enc:BufferEncoding,
        done:(err?:Error|null) => void
    ):void {
        this.chunks.push(Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk))
        done()
    }

    text ():string {
        return Buffer.concat(this.chunks).toString('utf8')
    }
}

// A readable stdin fed with fixed text, then EOF.
export function inputStream (text = ''):NodeJS.ReadableStream {
    const s = new PassThrough()
    s.end(text)
    return s
}
// tapzero's `test` plus Go-style `t.cleanup(fn)`: cleanups run in reverse
// order when the test body finishes, pass or fail.
import { test as tapTest, type Test } from '@substrate-system/tapzero'

export type CleanupTest = Test&{
    cleanup (fn:() => void|Promise<void>):void;
}

export function test (
    name:string,
    fn:(t:CleanupTest) => void|Promise<void>
):void {
    tapTest(name, async t => {
        const cleanups:(() => void|Promise<void>)[] = []
        const ct = Object.assign(t, {
            cleanup (f:() => void|Promise<void>):void { cleanups.push(f) },
        })
        try {
            await fn(ct)
        } finally {
            for (const f of cleanups.reverse()) await f()
        }
    })
}
