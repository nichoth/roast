mode))","+        closed = true","+        await step(`close ${tmp}`, () => handle.close())","+        await step(`replace ${target}`, () => fs.rename(tmp, target))","+    } catch (err) {","+        if (!closed) await handle.close().catch(() => {})","+        await fs.rm(tmp, { force:true }).catch(() => {})","+        throw err","+    }","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/nick/code/roast.ts-rewrite-03-shared-go-compat-and-utility-modules/src/fsutil/atomic.ts"]}},"tool_result_meta":[{"id":"toolu_01NJqfNeSZt21V7iTPtU6nmD","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
