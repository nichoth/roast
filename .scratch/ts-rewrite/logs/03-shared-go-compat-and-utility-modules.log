}\n\nfunction hex (n:number, width:number):string {\n    return n.toString(16).padStart(width, '0')\n}\n\n// Go strconv.Quote (also fmt %q on a string). A lone surrogate, which Go\n// cannot hold, is quoted as U+FFFD would be if it were not printable:\n// `�`.\nexport function goQuote (s:string):string {\n    let out = '\"'\n    for (const ch of s) {\n        const cp = ch.codePointAt(0)!\n        if (cp === 0x22 || cp === 0x5c) {\n            out += '\\\\' + ch\n        } else if (isGoPrint(cp)) {\n            out += ch\n        } else if (NAMED_ESCAPES[cp] !== undefined) {\n            out += NAMED_ESCAPES[cp]\n        } else if (cp < 0x20 || cp === 0x7f) {\n            out += '\\\\x' + hex(cp, 2)\n        } else if (cp >= 0xd800 && cp <= 0xdfff) {\n            out += '\\\\ufffd'\n        } else if (cp < 0x10000) {\n            out += '\\\\u' + hex(cp, 4)\n        } else {\n            out += '\\\\U' + hex(cp, 8)\n        }\n    }\n    return out + '\"'\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01GKe58Jk9FhSJzjMVVH141q","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
