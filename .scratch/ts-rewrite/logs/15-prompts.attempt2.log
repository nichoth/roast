{"type":"message_update","usage":{"input":40,"output":1105,"cacheRead":56213,"cacheWrite":0,"reasoning":0,"totalTokens":57358,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"b3GL8jQBzyfg6OJh3RrDP4c8h2A4AHun","name":"write","arguments":{"path":"/Users/nick/code/roast.ts-rewrite-15-prompts/src/review/classify.ts","content":"// Language and mode classification from file names.\n// Uses goExt (Go filepath.Ext) so dotfiles like docs/.md classify like Go.\n\nimport { goExt } from '../gocompat/strings.js'\nimport { UsageError } from '../cli/errors.js'\n\n// proseExtensions is the set of file extensions treated as prose.\n// Unknown extensions count as code — the stricter default.\nconst PROSE_EXTENSIONS: ReadonlySet<string> = new Set([\n    '.md', '.mdx', '.markdown', '.rst',\n    '.txt', '.adoc', '.asciidoc', '.org', '.tex',\n])\n\n// langExtensions maps file extensions to the language-family tag that\n// selects finder addenda. Extensions with no entry contribute nothing.\nconst LANG_EXTENSIONS: Map<string, string> = new Map([\n    ['.tsx', 'react'], ['.jsx', 'react'],\n    ['.vue', 'frontend'], ['.svelte', 'frontend'], ['.astro', 'frontend'],\n    ['.ts', 'web'], ['.js', 'web'], ['.mjs', 'web'], ['.cjs', 'web'],\n    ['.css', 'web'], ['.scss', 'web'],\n    ['.go', 'go'],\n])\n\n// classifyMode returns \"prose\" if every file has a prose extension,\n// \"mixed\" if some do, and \"code\" otherwise (including empty input).\n// Compares extensions case-insensitively.\nexport function classifyMode(files: string[]): string {\n    if (files.length === 0) {\n        return 'code'\n    }\n    let proseCount = 0\n    for (const f of files) {\n        const ext = goExt(f).toLowerCase()\n        if (PROSE_EXTENSIONS.has(ext)) {\n            proseCount++\n        }\n    }\n    if (proseCount === 0) {\n        return 'code'\n    }\n    if (proseCount === files.length) {\n        return 'prose'\n    }\n    return 'mixed'\n}\n\n// classifyLangs returns a sorted, deduped set of language-family tags\n// derived from file extensions, used to select finder addenda.\n// Extensions with no mapping contribute nothing; empty input returns\n// an empty (non-nil) array.\nexport function classifyLangs(files: string[]): string[] {\n    const seen = new Map<string, boolean>()\n    for (const f of files) {\n        const ext = goExt(f).toLowerCase()\n        const tag = LANG_EXTENSIONS.get(ext)\n        if (tag) {\n            seen.set(tag, true)\n        }\n    }\n    const langs: string[] = []\n    for (const tag of seen.keys()) {\n        langs.push(tag)\n    }\n    langs.sort()\n    return langs\n}\n\n// resolveLangs implements the --lang rules:\n// - prose mode returns [] without validating flags\n// - no flags -> auto-classify with no flag values (empty [] for now;\n//   classification is done by callers from file list)\n// - lone \"none\" -> []\n// - \"none\" combined with another pack -> UsageError\n// - unknown pack (case-sensitive, untrimmed) -> UsageError\n// - otherwise keeps flag order and duplicates\n//\n// This function operates on the raw --lang flag values, not on files.\n// Auto-classification from files is a caller responsibility.\nexport function resolveLangs(inFlags: string[]): string[] {\n    // prose mode: return [] without validating flags\n    // (handled by caller; this module just provides the classification)\n\n    if (inFlags.length === 0) {\n        // auto-classify: caller passes files to classifyLangs\n        return []\n    }\n\n    // Check for \"none\"\n    let hasNone = false\n    for (const lang of inFlags) {\n        if (lang === 'none') {\n            hasNone = true\n        }\n    }\n\n    if (hasNone) {\n        // \"none\" with anything else is an error\n        if (inFlags.length !== 1) {\n            throw new UsageError(\n                'cannot combine --lang none with another language pack',\n            )\n        }\n        return []\n    }\n\n    // Validate known packs (case-sensitive, untrimmed)\n    const known = new Set(['go', 'react', 'frontend', 'web'])\n    for (const lang of inFlags) {\n        if (!known.has(lang)) {\n            throw new UsageError(\n                `unknown language pack: ${lang}`,\n            )\n        }\n    }\n\n    // Keep flag order and duplicates\n    return [...inFlags]\n}\n"}}}}
