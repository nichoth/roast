{"type":"tool_execution_end","toolCallId":"YFr7wXmPf1dLsBXK8sW8QwlXsh5N9g2d","toolName":"read","result":{"content":[{"type":"text","text":"// Finder and verifier user-message rendering. Reproduce the baseline\n// finder_user.tmpl / verifier_user.tmpl output exactly, using dataText\n// defanging for closing wrapper tags (RE2 semantics: ASCII \\s, Unicode\n// simple case folding, ASCII word boundary).\n\nimport { formatFixed2 } from '../gocompat/strings.js'\n\n// FinderUserVars holds the template variables for the finder user message.\nexport interface FinderUserVars {\n    Task: string\n    Diff?: string\n    FileContext?: string\n    Survey?: boolean\n    Manifest?: string\n}\n\n// VerifierVars holds the template variables for the verifier user message.\n// Deliberately does NOT include Reasoning — anti-anchoring.\nexport interface VerifierVars {\n    Severity: string\n    Confidence: number\n    File: string\n    Lines: string\n    Description: string\n    CodeQuote: string\n    FixedCode: string\n    FileSnippet: string\n}\n\n// dataText defangs any closing wrapper tag inside untrusted text, so a\n// claim or file cannot end its own tag early and append text that reads\n// as part of the prompt. Uses RE2 semantics: ASCII \\s, Unicode simple\n// case folding, ASCII word boundary.\nconst tagClose = /<\\/\\s*(?:claim|code_quote|fixed_code|file_contents)\\b/gi\n\nexport function dataText(s: string): string {\n    // The Go regexp matches </\\s*(claim|code_quote|fixed_code|file_contents)\\b\n    // with case-insensitive flag. We replace the closing tag to use the\n    // escaped forward-slash form <\\/$1, which cannot be misinterpreted by\n    // HTML parsers.\n    //\n    // RE2 semantics: \\s matches only ASCII whitespace, the /i flag gives\n    // simple case folding, and \\b is an ASCII word boundary.\n    return s.replace(tagClose, '</$1')\n}\n\n// renderFinderUser renders the finder user message template.\n// Survey mode shows <manifest>; diff mode shows <diff> a