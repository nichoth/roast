n// renderFinderUser renders the finder user message template.\n// Survey mode shows <manifest>; diff mode shows <diff> and <files>.\nexport function renderFinderUser(vars: FinderUserVars): string {\n    const parts: string[] = []\n    parts.push('## Task (what the builder was asked to do)')\n    parts.push(vars.Task)\n\n    if (vars.Survey) {\n        parts.push('')\n        parts.push('## Repository under review (MANIFEST — the map, not the contents)')\n        parts.push('')\n        parts.push('The repository contents are not inline below. Use the local tools to inspect relevant files.')\n        parts.push('')\n        parts.push('<manifest>')\n        parts.push(vars.Manifest || '')\n        parts.push('</manifest>')\n        parts.push('')\n        parts.push('Every finding must include `code_quote` copied verbatim from code retrieved through the tools and a concrete `fixed_code` replacement.')\n    } else {\n        parts.push('')\n        parts.push('## Changes under review')\n        parts.push('')\n        parts.push('<diff>')\n        parts.push(vars.Diff || '')\n        parts.push('</diff>')\n        parts.push('')\n        parts.push('## Files touched (full current contents, each line prefixed with its real file line number)')\n        parts.push('')\n        parts.push('<files>')\n        parts.push(vars.FileContext || '')\n        parts.push('</files>')\n        parts.push('')\n        parts.push('Every finding must include `code_quote` (verbatim from <files>) and `fixed_code` (concrete replacement). Cite line numbers using the real file line numbers from the <files> section — not positions inside the <diff>.')\n    }\n\n    return parts.join('\\n')\n}\n\n// renderVerifierUser renders the verifier user message.\n// Output never contains the finder's reasoning (the type has no such field).\nexport function renderVerifierUser(vars: VerifierVars): string {\n    const parts: string[] = []\n\n    parts.push('## The claim under adjudication')\n    parts.push('')\n    parts.push('<claim>')\n    parts.push(`Severity: ${dataText(vars.Severity)} (finder confidence ${formatFixed2(vars.Confidence)})`)\n    parts.push(`File: ${dataText(vars.File)} lines ${dataText(vars.Lines)}`)\n    parts.push(`Description: ${dataText(vars.Description)}`)\n    parts.push('')\n    parts.push('The code the finder quoted:')\n    parts.push('<code_quote>')\n    parts.push(dataText(vars.CodeQuote))\n    parts.push('</code_quote>')\n    parts.push('')\n    parts.push('The fix the finder proposed:')\n    parts.push('<fixed_code>')\n    parts.push(dataText(vars.FixedCode))\n    parts.push('</fixed_code>')\n    parts.push('</claim>')\n    parts.push('')\n    parts.push('## Current contents of the cited file (line-numbered)')\n    parts.push('')\n    parts.push('<file_contents>')\n    parts.push(dataText(vars.FileSnippet))\n    parts.push('</file_contents>')\n    parts.push('')\n    parts.push('Adjudicate: is the claimed defect real, as described? Ground your verdict in the code.')\n\n    return parts.join('\\n')\n}\n"}}],"api":"openai-completions","provider":"tiiny","model":"Qwen/Qwen3.6-35B-A3B-turbo","usage":{"input":48,"output":1675,"cacheRead":53047,"cacheWrite":0,"reasoning":0,"totalTokens":54770,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"stopReason":"toolUse","timestamp":1795206673098,"responseId":"chatcmpl-r7xBvHapBAlwslTGQ8FiS2tXLSOG0QX7","rawStopReason":"tool_calls","durationMs":53918,"thinkingLevel":"high"},"toolResults":[{"role":"toolResult","toolCallId":"V7uoBguV4zt14GncvGKGlz5IqiUzLhk7","toolName":"write","content":[{"type":"text","text":"Successfully wrote to /Users/nick/code/roast.ts-rewrite-15-prompts/src/prompts/render.ts"}],"isError":false,"durationMs":2,"timestamp":1795206727029}]}
