{"type":"message_update","usage":{"input":1253,"output":1337,"cacheRead":69809,"cacheWrite":0,"reasoning":0,"totalTokens":72399,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"assistantMessageEvent":{"type":"thinking_end","contentIndex":0,"content":"I see the mess - there's now an import and an export of `loadOverride`, plus a duplicate `_lo` import. Let me clean this up completely:\n"}}
{"type":"message_update","usage":{"input":1253,"output":1337,"cacheRead":69809,"cacheWrite":0,"reasoning":0,"totalTokens":72399,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0,"totalFromProvider":false}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"qGbtrYg2DuwzO7bPgWPFz0L1xkK7R36n","name":"write","arguments":{"path":"/Users/nick/code/roast.ts-rewrite-15-prompts/src/prompts/index.ts","content":"// Package prompts provides embedded prompt templates for the finder and\n// verifier stages. Templates are imported directly from the internal source\n// path so the Go embed and the TS bundle read the same bytes.\n//\n// Override paths are resolved by callers through the config's promptPath\n// (ticket 05); this module does not resolve them.\n\nimport finderCore from '../../internal/prompts/templates/finder_core.tmpl'\nimport finderScopeDiff from '../../internal/prompts/templates/finder_scope_diff.tmpl'\nimport finderScopeSurvey from '../../internal/prompts/templates/finder_scope_survey.tmpl'\nimport finderProse from '../../internal/prompts/templates/finder_prose.tmpl'\nimport finderMixedAddendum from '../../internal/prompts/templates/finder_mixed_addendum.tmpl'\nimport finderQuickAddendum from '../../internal/prompts/templates/finder_quick_addendum.tmpl'\nimport finderGoAddendum from '../../internal/prompts/templates/finder_go_addendum.tmpl'\nimport finderFrontendAddendum from '../../internal/prompts/templates/finder_frontend_addendum.tmpl'\nimport finderReactHooksAddendum from '../../internal/prompts/templates/finder_react_hooks_addendum.tmpl'\nimport verifierSystem from '../../internal/prompts/templates/verifier_system.tmpl'\nimport verifierUser from '../../internal/prompts/templates/verifier_user.tmpl'\nimport finderUser from '../../internal/prompts/templates/finder_user.tmpl'\nimport {\n    loadOverride,\n    renderFinderUser,\n    renderVerifierUser,\n    dataText,\n} from './render.js'\n\nexport {\n    finderCore,\n    finderScopeDiff,\n    finderScopeSurvey,\n    finderProse,\n    finderMixedAddendum,\n    finderQuickAddendum,\n    finderGoAddendum,\n    finderFrontendAddendum,\n    finderReactHooksAddendum,\n    verifierSystem,\n    verifierUser,\n    finderUser,\n}\n\nexport type {\n    FinderUserVars,\n    VerifierVars,\n} from './render.js'\n\nexport {\n    renderFinderUser,\n    renderVerifierUser,\n    dataText,\n    loadOverride,\n} from './render.js'\n\n// Finder returns the finder system prompt for the given mode, scope,\n// quick flag, and detected language families.\n//\n// mode must be \"code\", \"prose\", or \"mixed\". The code/mixed prompt is\n// assembled as finder_core + scope framing + lang addenda (+ mixed\n// addendum for mixed), with the quick-mode constraints addendum appended\n// last so it overrides everything above it. langs selects language-scoped\n// addenda (e.g. \"go\", \"react\", \"frontend\"); see appendLangAddenda.\n//\n// overridePath, when non-empty, replaces only the CORE template — the\n// scope framing stays roast-controlled because it encodes review\n// invariants, not taste. Prose mode ignores scope and uses finder_prose\n// as its whole base; overridePath there replaces that base wholesale.\nexport function finderSystem(\n    mode: string,\n    scope: string,\n    quick: boolean,\n    langs: string[],\n    overridePath: string,\n): string {\n    let base: string\n\n    switch (mode) {\n        case 'prose':\n            base = loadOverride(overridePath, finderProse)\n            if (scope === 'repo') {\n                base += finderScopeSurvey\n            }\n            break\n        case 'mixed':\n            base = loadOverride(overridePath, finderCore)\n            base += scopeFraming(scope)\n            base += finderMixedAddendum\n            base += appendLangAddenda(langs)\n            break\n        default: // \"code\" and anything unknown\n            base = loadOverride(overridePath, finderCore)\n            base += scopeFraming(scope)\n            base += appendLangAddenda(langs)\n            break\n    }\n\n    if (quick) {\n        base += finderQuickAddendum\n    }\n\n    return base\n}\n\n// scopeFraming returns the scope-specific framing appended after the core\n// template. \"diff\", \"\" (unset), and any not-yet-recognized scope select\n// the diff-mode framing; \"repo\" selects the survey-mode framing.\nfunction scopeFraming(scope: string): string {\n    if (scope === 'repo') {\n        return finderScopeSurvey\n    }\n    return finderScopeDiff\n}\n\n// appendLangAddenda returns the concatenated language-scoped addenda\n// selected by langs, in a stable order. \"go\" appends the Go addendum.\n// \"react\" appends the frontend addendum plus the React-hooks addendum;\n// \"frontend\" appends the frontend addendum alone (no hooks guidance —\n// Vue/Svelte/Astro have their own reactivity models). The frontend\n// addendum is appended at most once even when both \"react\" and\n// \"frontend\" are present. \"web\" is accepted but triggers no addendum in\n// v1.\nfunction appendLangAddenda(langs: string[]): string {\n    const seen = new Set(langs)\n    let out = ''\n    if (seen.has('go')) {\n        out += finderGoAddendum\n    }\n    if (seen.has('react') || seen.has('frontend')) {\n        out += finderFrontendAddendum\n    }\n    if (seen.has('react')) {\n        out += finderReactHooksAddendum\n    }\n    return out\n}\n\n// verifierSystemPrompt returns the verifier system prompt. overridePath,\n// when non-empty, replaces the embedded default.\nexport function verifierSystemPrompt(\n    overridePath: string,\n): string {\n    return loadOverride(overridePath, verifierSystem)\n}\n"}}}}
