ser,\n    renderVerifierUser,\n    dataText,\n    loadOverride,\n} from './render.js'\n\nimport { loadOverride as _lo } from './render.js'\n\n// Finder returns the finder system prompt for the given mode, scope,\n// quick flag, and detected language families.\n//\n// mode must be \"code\", \"prose\", or \"mixed\". The code/mixed prompt is\n// assembled as finder_core + scope framing + lang addenda (+ mixed\n// addendum for mixed), with the quick-mode constraints addendum appended\n// last so it overrides everything above it. langs selects language-scoped\n// addenda (e.g. \"go\", \"react\", \"frontend\"); see appendLangAddenda.\n//\n// overridePath, when non-empty, replaces only the CORE template — the\n// scope framing stays roast-controlled because it encodes review\n// invariants, not taste. Prose mode ignores scope and uses finder_prose\n// as its whole base; overridePath there replaces that base wholesale.\nexport function finderSystem(\n    mode: string,\n    scope: string,\n    quick: boolean,\n    langs: string[],\n    overridePath: string,\n): string {\n    let base: string\n\n    switch (mode) {\n        case 'prose':\n            base = loadOverride(overridePath, finderProse)\n            if (scope === 'repo') {\n                base += finderScopeSurvey\n            }\n            break\n        case 'mixed':\n            base = loadOverride(overridePath, finderCore)\n            base += scopeFraming(scope)\n            base += finderMixedAddendum\n            base += appendLangAddenda(langs)\n            break\n        default: // \"code\" and anything unknown\n            base = loadOverride(overridePath, finderCore)\n            base += scopeFraming(scope)\n            base += appendLangAddenda(langs)\n            break\n    }\n\n    if (quick) {\n        base += finderQuickAddendum\n    }\n\n    return base\n}\n\n// scopeFraming returns the scope-specific framing appended after the core\n// template. \"diff\", \"\" (unset), and any not-yet-recognized scope select\n// the diff-mode framing; \"repo\" selects the survey-mode framing.\nfunction scopeFraming(scope: string): string {\n    if (scope === 'repo') {\n        return finderScopeSurvey\n    }\n    return finderScopeDiff\n}\n\n// appendLangAddenda returns the concatenated language-scoped addenda\n// selected by langs, in a stable order. \"go\" appends the Go addendum.\n// \"react\" appends the frontend addendum plus the React-hooks addendum;\n// \"frontend\" appends the frontend addendum alone (no hooks guidance —\n// Vue/Svelte/Astro have their own reactivity models). The frontend\n// addendum is appended at most once even when both \"react\" and\n// \"frontend\" are present. \"web\" is accepted but triggers no addendum in\n// v1.\nfunction appendLangAddenda(langs: string[]): string {\n    const seen = new Set(langs)\n    let out = ''\n    if (seen.has('go')) {\n        out += finderGoAddendum\n    }\n    if (seen.has('react') || seen.has('frontend')) {\n        out += finderFrontendAddendum\n    }\n    if (seen.has('react')) {\n        out += finderReactHooksAddendum\n    }\n    return out\n}\n\n\n\n// verifier returns the verifier system prompt. overridePath, when\n// non-empty, replaces the embedded default.\nexport function verifierSystemPrompt(\n    overridePath: string,\n): string {\n    return loadOverride(overridePath, verifierSystem)\n}\n"}],"isError":false,"durationMs":3,"timestamp":1795207121523}}
