# Roast is a TypeScript package that talks to providers over raw fetch

Roast was a Go binary shipped through npm as six platform packages and a
launcher. Every Roast install is already a Node project dependency, so a Go
toolchain, per-platform builds, and the launcher add release machinery
without serving users. We rewrite Roast in TypeScript as one pure-JS npm
package, `2.0.0`, with behavior parity against Go commit `cd08f10` except
for named changes: no Windows support, no `completion` command, Node
`>=22.18`, and the trust hash in ADR-0003.

Runtime libraries (`yargs`, `zod`, `jsonc-parser`,
`@substrate-system/debug`) are bundled into one esbuild ESM file, so
installing Roast adds no transitive packages to a user's project, the same
property the Go binary had. Their license texts ship in a generated
third-party notice.

Inference uses raw `fetch` with one adapter per protocol (`chat`,
`responses`, `anthropic`) and Roast's own agent loop, not a provider SDK
or an LLM framework. The Go version used the Fantasy framework but had to
wrap or override much of it: it captured raw response bytes for run
records, removed headers the SDKs read from ambient environment variables,
replaced retry and tool-call-repair behavior, sized requests for the token
ledger before sending, and reserved a wrap-up turn. Official SDKs would need
the same overrides on two codebases; owning the wire layer puts all of it in
one place.

## Considered options

- Keep Go: no rewrite cost, but keeps the multi-package release and a second
  toolchain for a tool whose users all run Node.
- Official `openai` and `@anthropic-ai/sdk` SDKs: typed streaming for free,
  but both read ambient configuration and run their own retries, which Roast
  must defeat to keep its credential and capture guarantees.
- Vercel AI SDK: closest to Fantasy, but it hides the request bytes and the
  retry policy that the ledger and run records depend on.

 succeeded in 108ms:
// Step retries (spec 07, 2.11): a turn's request is retried on retryable
// errors, never on aborts, capture failures, or cutoff errors.

import { isRetryable, retryDelayMs } from './errors.js'

export const INITIAL_BACKOFF_MS = 5000

export type Sleep = (ms:number, signal:AbortSignal) => Promise<void>

export function defaultSleep (ms:number, signal:AbortSignal):Promise<void> {
    return new Promise<void>((resolve, reject) => {
        if (signal.aborted) {
            reject(signal.reason)
            return
        }
        const onAbort = () => {
            clearTimeout(timer)
            reject(signal.reason)
        }
        const timer = setTimeout(() => {
            signal.removeEventListener('abort', onAbort)
            resolve()
        }, ms)
        signal.addEventListener('abort', onAbort, { once:true })
    })
}

// The delay before the next attempt: the provider's hint, else backoff.
export function retryDelay (err:unknown, backoffMs:number):number {
    return retryDelayMs(err, backoffMs)
}

// Runs `attempt`, retrying a retryable failure up to `maxRetries` times
// with doubling backoff. The last attempt's error is thrown.
export async function withStepRetry<R> (
    attempt:() => Promise<R>,
    opts:{ maxRetries:number, signal:AbortSignal, sleep?:Sleep }
):Promise<R> {
    const sleep = opts.sleep ?? defaultSleep
    let backoff = INITIAL_BACKOFF_MS
    for (let retries = 0; ; retries++) {
        try {
            return await attempt()
        } catch (err) {
            if (opts.signal.aborted || retries >= opts.maxRetries ||
                !isRetryable(err)) {
                throw err
            }
            await sleep(retryDelay(err, backoff), opts.signal)
            backoff *= 2
        }
    }
}
// Roast's agent loop (spec 07): a multi-turn tool conversation that ends
// when the model calls the final tool with arguments that validate. An
// imperative shell around the pure review (review.ts), the ledger, and
// the work deadline. Governing invariant: no stop path discards
// accumulated work; the budget and the deadline never cancel the wrap-up
// call, and record tools always run.

import type { ModelClient } from './client.js'
import { WorkDeadline } from './deadline.js'
import {
    CaptureError,
    cutoffError,
    FinalArgumentsError,
    hasSentinel,
    NoFinalCallError,
    normalizeProviderError,
    SENTINEL_MESSAGE,
    type ErrorDetails,
} from './errors.js'
import { checkRequired, decodeArgs, typeValidate } from './final-args.js'
import { encodeToolResult } from './json.js'
import { reserve, type Ledger } from './ledger.js'
import { transcriptBytes } from './messages.js'
import { withStepRetry, type Sleep } from './retry.js'
import {
    reviewResponse,
    type ReviewCall,
    type ReviewDecision,
    type StopCause,
} from './review.js'
import { newSessionId } from './session.js'
import type {
    AssistantPart,
    ConversationItem,
    ConverseOptions,
    FinishReason,
    ModelRequest,
    ModelTurn,
    Tool,
    ToolDefinition,
    ToolResult,
    Usage,
} from './types.js'
import { zeroUsage } from './usage.js'

export { DEFAULT_WRAP_UP_WINDOW } from './deadline.js'

export const NUDGE_TOOL_NAME = '__roast_continue'
export const DEFAULT_MAX_TURNS = 8
export const DEFAULT_INPUT_BYTE_CEILING = 3_000_000
export const DEFAULT_MAX_ATTEMPTS = 4
// Added to the request body size for ledger admission.
export const REQUEST_OVERHEAD_BYTES = 2048

const NUDGE_TOOL:ToolDefinition = {
    name:NUDGE_TOOL_NAME,
    description:'Continue the Roast tool loop after a free-form response.',
    schema:{
        type:'object',
        properties:{ message:{ type:'string' } },
        required:['message'],
    },
}

export interface LoopDeps {
    client:ModelClient;
    // Request model name, used in error messages.
    model:string;
    maxOutputTokens:number;
    // Already normalized (<= 0 -> DEFAULT_MAX_ATTEMPTS).
    maxAttempts:number;
    ledger:Ledger|null;
    // The client's usage accumulator.
    addUsage:(usage:Usage) => void;
    now?:() => number;
    sleep?:Sleep;
    sessionId?:() => string;
}

type Cutoff = 'work-deadline'|'budget-exhausted'

interface StepOutcome {
    dispatched:boolean;
    stopRequested:boolean;
}

class Conversation<T> {
    private readonly items:ConversationItem[]
    private readonly tools:ReadonlyMap<string, Tool>
    private readonly toolNames:ReadonlySet<string>
    private readonly recordTools:ReadonlySet<string>
    private readonly definitions:readonly ToolDefinition[]
    private readonly deadline:WorkDeadline
    private readonly sessionId:string
    private readonly maxTurns:number
    private readonly ceiling:number

    private turn = 0
    private finalPhase:boolean
    private cutoff:Cutoff|null = null
    private noticeSent = false
    private inputWarned = false
    private budgetNotified = false
    private done = false
    private result?:T
    private finalErr:string|null = null
    private validationExhausted = false
    private halt = false
    private stopCause:StopCause|null = null
    private finish?:{ reason:FinishReason, raw?:string }
    private submissionAttempts = 0
    private recordRounds = 0

    constructor (
        private readonly deps:LoopDeps,
        private readonly system:string,
        user:string,
        private readonly opts:ConverseOptions<T>,
        private readonly structured:boolean,
        private readonly signal:AbortSignal
    ) {
        this.items = [{ role:'user', text:user }]
        const tools = new Map<string, Tool>()
        const records = new Set<string>()
        for (const tool of opts.tools) {
            tools.set(tool.name, tool)
            if (tool.recordsResult && tool.name !== opts.finalTool) {
                records.add(tool.name)
            }
        }
        this.tools = tools
        this.recordTools = records
        this.toolNames = new Set([...tools.keys(), NUDGE_TOOL_NAME])
        this.definitions = [
            ...opts.tools.map(t => ({
                name:t.name,
                description:t.description,
                schema:t.schema,
            })),
            NUDGE_TOOL,
        ]
        this.deadline = new WorkDeadline({
            deadline:opts.workDeadline,
            window:opts.wrapUpWindow,
            onFire:opts.onWorkDeadline,
            now:deps.now,
        })
        this.sessionId = (deps.sessionId ?? newSessionId)()
        this.maxTurns = opts.maxTurns !== undefined && opts.maxTurns > 0 ?
            opts.maxTurns :
            DEFAULT_MAX_TURNS
        this.ceiling = opts.inputByteCeiling !== undefined &&
            opts.inputByteCeiling > 0 ?
            opts.inputByteCeiling :
            DEFAULT_INPUT_BYTE_CEILING
        this.finalPhase = structured
    }

    async run ():Promise<T> {
        let failure:unknown
        let failed = false
        for (;;) {
            this.prepare()
            let outcome:StepOutcome
            try {
                const turn = await withStepRetry(() => this.call(), {
                    maxRetries:this.deps.maxAttempts - 1,
                    signal:this.signal,
                    sleep:this.deps.sleep,
                })
                outcome = await this.process(turn)
            } catch (err) {
                failure = err
                failed = true
                break
            }
            if (this.shouldStop()) break
            if (!outcome.dispatched || outcome.stopRequested) break
            if (this.signal.aborted) {
                failure = this.signal.reason
                failed = true
                break
            }
        }
        return this.conclude(failed, failure)
    }

    // Turn preparation (2.5).
    private prepare ():void {
        this.turn++
        if (this.turn > 1 && !this.inputWarned &&
            transcriptBytes(this.system, this.items) > this.ceiling) {
            this.inputWarned = true
            this.items.push({
                role:'user',
                text:'INPUT BUDGET EXHAUSTED. Do not request more files. ' +
                    `Call \`${this.opts.finalTool}\` now with what you ` +
                    'have \u2014 partial results beat none.',
            })
        }
        if (this.deadline.check()) this.forceFinal('work-deadline')
        if (this.turn >= this.maxTurns) this.forceFinal(null)
        this.sendNotice()
    }

    private forceFinal (cutoff:Cutoff|null):void {
        this.finalPhase = true
        if (cutoff && !this.cutoff) this.cutoff = cutoff
    }

    private notifyBudget ():void {
        if (this.budgetNotified) return
        this.budgetNotified = true
        this.opts.onBudgetExhausted?.()
    }

    private notice ():string {
        const f = '`' + this.opts.finalTool + '`'
        if (this.structured) {
            return `Return the requested structured result via the ${f} ` +
                'tool call. Do not answer in prose.'
        }
        const tail = ` \u2014 call ${f} NOW with everything you have; ` +
            'partial results beat none.'
        if (this.cutoff === 'budget-exhausted') {
            return 'TOKEN BUDGET EXHAUSTED' + tail
        }
        if (this.cutoff === 'work-deadline' && this.deadline.fired) {
            return 'WORK DEADLINE REACHED' + tail
        }
        return 'Exploration budget exhausted' + tail
    }

    private sendNotice ():void {
        if (!this.finalPhase || this.noticeSent) return
        this.noticeSent = true
        this.items.push({ role:'user', text:this.notice() })
    }

    private request (signal:AbortSignal):ModelRequest {
        return {
            system:this.system,
            items:[...this.items],
            tools:this.definitions.map(d => ({
                name:d.name,
                description:d.description,
                schema:structuredClone(d.schema),
            })),
            sessionId:this.sessionId,
            signal,
        }
    }

    // One model call, with the in-step switch to wrap-up on a budget
    // refusal or an in-flight deadline (2.9).
    private async call ():Promise<ModelTurn> {
        const final = this.finalPhase
        const signal = this.deadline.callSignal(this.signal)
        const request = this.request(signal)
        const bytes = this.deps.client.requestBytes(request) +
            REQUEST_OVERHEAD_BYTES
        const release = reserve(this.deps.ledger, bytes,
            this.deps.maxOutputTokens, final)
        if (!release) {
            if (final) {
                if (!this.cutoff) {
                    this.cutoff = 'budget-exhausted'
                    this.notifyBudget()
                }
                throw cutoffError(this.cutoff, 'no headroom for the wrap-up ' +
                    'call', new Error(SENTINEL_MESSAGE['budget-exhausted']),
                this.details())
            }
            this.forceFinal('budget-exhausted')
            this.notifyBudget()
            this.sendNotice()
            return this.call()
        }
        let turn:ModelTurn
        try {
            turn = await this.deps.client.send(request)
            // A response buffered before an abort is never dispatched.
            signal.throwIfAborted()
        } catch (err) {
            release(zeroUsage())
            const deadlineReached = this.deadline.check()
            if (err instanceof CaptureError) throw err
            if (!final && deadlineReached && !this.signal.aborted) {
                this.forceFinal('work-deadline')
                this.sendNotice()
                return this.call()
            }
            if (final && this.cutoff) {
                throw cutoffError(this.cutoff, 'wrap-up call failed',
                    normalizeProviderError(this.signal, this.deps.model, err),
                    this.details())
            }
            throw err
        }
        release(turn.usage)
        this.deps.addUsage(turn.usage)
        this.deadline.check()
        return turn
    }

    // Processing one complete response (2.6) and its dispatch (2.7).
    private async process (turn:ModelTurn):Promise<StepOutcome> {
        if (turn.finishReason !== 'stop' &&
            turn.finishReason !== 'tool-calls') {
            this.abnormalFinish(turn)
            return { dispatched:false, stopRequested:false }
        }
        const calls:ReviewCall[] = []
        for (const p of turn.parts) {
            if (p.type === 'tool-call') {
                calls.push({ id:p.id, name:p.name, input:p.input })
            }
        }
        this.stopCause = null
        const d = reviewResponse({
            calls,
            finalTool:this.opts.finalTool,
            toolNames:this.toolNames,
            recordTools:this.recordTools,
            finalPhase:this.finalPhase,
            turn:this.turn,
            submissionAttempts:this.submissionAttempts,
            recordRounds:this.recordRounds,
            maxAttempts:this.deps.maxAttempts,
            mayContinue:() => this.mayContinueFinalization(),
            validateFinal:input => {
                const v = typeValidate(input, this.opts.final)
                return v.ok ? null : v.error
            },
        })
        for (const call of d.unknownCalls) {
            this.opts.onTurn?.({
                turn:this.turn,
                tool:call.name,
                args:decodeArgs(call.input),
            })
        }
        this.submissionAttempts = d.submissionAttempts
        this.recordRounds = d.recordRounds
        this.stopCause = d.stopCause
        if (d.finalErr !== undefined) this.finalErr = d.finalErr
        if (d.validationExhausted) this.validationExhausted = true
        if (d.halt) this.halt = true
        if (!d.dispatch) return { dispatched:false, stopRequested:false }

        const parts:AssistantPart[] = [...turn.parts]
        const all = [...calls]
        if (d.nudge) {
            const nudge:ReviewCall = {
                id:d.nudge.id,
                name:NUDGE_TOOL_NAME,
                input:JSON.stringify({ message:d.nudge.message }),
            }
            parts.push({ type:'tool-call', ...nudge })
            all.push(nudge)
        }
        this.items.push({ role:'assistant', parts })
        const results:ToolResult[] = []
        let stopRequested = false
        for (const call of all) {
            const r = await this.dispatch(call, d)
            results.push(r.result)
            if (r.stop) stopRequested = true
        }
        this.items.push({ role:'tool', results })
        return { dispatched:all.length > 0, stopRequested }
    }

    private abnormalFinish (turn:ModelTurn):void {
        const reason = turn.finishReason
        let text = `the response ended with finish reason "${reason}"`
        if (turn.rawFinishReason && turn.rawFinishReason !== reason) {
            text += ` (the provider sent "${turn.rawFinishReason}")`
        }
        if (reason === 'length') {
            text += '; raise max_output_tokens if the output was cut off'
        }
        this.stopCause = { kind:'finish-reason', text }
        this.finish = { reason, raw:turn.rawFinishReason }
    }

    private mayContinueFinalization ():boolean {
        if (this.deadline.check()) this.forceFinal('work-deadline')
        return this.cutoff === null
    }

    // One call: required-field validation, then the tool's own handling.
    private async dispatch (
        call:ReviewCall,
        d:ReviewDecision
    ):Promise<{ result:ToolResult, stop?:boolean }> {
        const ok = (output:string):ToolResult => ({
            callId:call.id,
            name:call.name,
            output,
            isError:false,
        })
        const fail = (output:string):ToolResult => ({
            callId:call.id,
            name:call.name,
            output,
            isError:true,
        })
        const tool = this.tools.get(call.name)
        if (!tool && call.name !== NUDGE_TOOL_NAME) {
            return {
                result:fail(`tool not found: ${call.name}. Available ` +
                    `tools: ${this.definitions.map(t => t.name).join(', ')}`),
            }
        }
        const schema = tool?.schema ?? NUDGE_TOOL.schema
        let invalid = checkRequired(schema, call.input)
        if (invalid !== null && tool?.recordsResult) {
            // Record tools receive decodeArgs' error map on malformed
            // JSON, so the finder can retain an all-zero finding. Valid
            // JSON still goes through required-field validation.
            try { JSON.parse(call.input) } catch { invalid = null }
        }
        if (invalid !== null) return { result:fail(invalid) }

        if (!tool) {
            const message = decodeArgs(call.input).message
            return { result:ok(typeof message === 'string' ? message : '') }
        }
        if (call.name === this.opts.finalTool) {
            return this.dispatchFinal(call, d, ok, fail)
        }
        const record = this.recordTools.has(call.name)
        if (d.blockExploration && !record) {
            return { result:fail(d.blockExploration) }
        }
        const args = decodeArgs(call.input)
        const outcome = await this.deadline.runTool(tool, args, this.signal)
        const value = 'error' in outcome ?
            { error:outcome.error.message } :
            outcome.value
        this.opts.onTurn?.({ turn:this.turn, tool:tool.name, args })
        let text:string
        try {
            text = encodeToolResult(value ?? null) ?? 'null'
        } catch (err) {
            const message = err instanceof Error ? err.message : String(err)
            text = encodeToolResult({ error:message })
        }
        return { result:ok(text) }
    }

    private dispatchFinal (
        call:ReviewCall,
        d:ReviewDecision,
        ok:(output:string) => ToolResult,
        fail:(output:string) => ToolResult
    ):{ result:ToolResult, stop?:boolean } {
        if (this.finalErr !== null) {
            return { result:fail(this.finalErr), stop:true }
        }
        if (d.rejectFinal) return { result:fail(d.rejectFinal) }
        if (this.done) return { result:ok('Already submitted.'), stop:true }
        const accepted = d.accept
        if (!accepted || accepted.id !== call.id ||
            accepted.input !== call.input) {
            return {
                result:fail('Not accepted: call `' + this.opts.finalTool +
                    '` once per response.'),
            }
        }
        const v = typeValidate(call.input, this.opts.final)
        if (!v.ok) {
            this.finalErr = v.error
            return { result:fail(v.error), stop:true }
        }
        this.result = v.value
        this.done = true
        return { result:ok(call.input), stop:true }
    }

    // Stop conditions (2.10).
    private shouldStop ():boolean {
        if (this.done || this.validationExhausted || this.halt) return true
        if (this.finalPhase &&
            this.submissionAttempts >= this.deps.maxAttempts) {
            return true
        }
        if (this.finalPhase && this.deadline.check()) {
            this.forceFinal('work-deadline')
            if (!this.stopCause) {
                this.stopCause = {
                    kind:'deadline-during-finalization',
                    text:'the work deadline passed before `' +
                        this.opts.finalTool + '` was called',
                }
            }
            return true
        }
        return false
    }

    private details ():ErrorDetails {
        const d:ErrorDetails = {
            model:this.deps.model,
            submissionAttempts:this.submissionAttempts,
            recordRounds:this.recordRounds,
        }
        if (this.stopCause) d.stopCause = this.stopCause.kind
        if (this.finish) {
            d.finishReason = this.finish.reason
            if (this.finish.raw !== undefined) {
                d.rawFinishReason = this.finish.raw
            }
        }
        return d
    }

    // Result precedence (2.14).
    private conclude (failed:boolean, failure:unknown):T {
        if (this.done) return this.result as T
        const model = this.deps.model
        const final = this.opts.finalTool
        if (this.finalErr !== null) {
            const err = new FinalArgumentsError(
                `${model}: ${final} arguments did not satisfy the schema ` +
                    `(${this.finalErr}); if truncated, raise max_output_tokens`,
                { ...this.details(), stopCause:'invalid-arguments' })
            if (this.cutoff) {
                throw cutoffError(this.cutoff, 'wrap-up submission was ' +
                    'invalid', err)
            }
            throw err
        }
        if (failed) {
            if (hasSentinel(failure, 'no-final-call')) throw failure
            if (this.cutoff) {
                throw cutoffError(this.cutoff, 'wrap-up turn failed', failure,
                    this.details())
            }
            throw normalizeProviderError(this.signal, model, failure)
        }
        const cause = this.stopCause ?
            new Error(`${model}: ${this.stopCause.text}`) :
            undefined
        if (this.cutoff) {
            throw cutoffError(this.cutoff, 'wrap-up turn produced no ' +
                'submission', cause, this.details())
        }
        const head = SENTINEL_MESSAGE['no-final-call']
        throw new NoFinalCallError(
            cause ? `${head}: ${cause.message}` : head,
            { details:this.details() })
    }
}

// Runs one conversation (`converse`, or `completeStructured` when
// `structured`) to its accepted final call.
export async function runConversation<T> (
    deps:LoopDeps,
    system:string,
    user:string,
    opts:ConverseOptions<T>,
    structured:boolean,
    signal:AbortSignal
):Promise<T> {
    if (!opts.tools.some(t => t.name === opts.finalTool)) {
        throw new Error(`final tool "${opts.finalTool}" is not configured`)
    }
    return new Conversation(deps, system, user, opts, structured, signal)
        .run()
}
// `createModelClient` and `send` (spec 06, 3.2): one model turn becomes
// exactly one HTTP request in the profile's protocol. Never retries.

import { goTrimSpace } from '../gocompat/strings.js'
import {
    anthropicUrl,
    decodeAnthropic,
    encodeAnthropic,
} from './anthropic.js'
import { abortable, CaptureGate, openCapturedBody } from './capture.js'
import { chatUrl, decodeChat, encodeChat } from './chat.js'
import {
    CaptureError,
    EndpointError,
    ProviderError,
    SENTINEL_MESSAGE,
} from './errors.js'
import { currentFetch, requestHeaders } from './http.js'
import {
    decodeResponses,
    encodeResponses,
    responsesUrl,
} from './responses.js'
import { parseSse, type SseEvent } from './sse.js'
import {
    DEFAULT_MAX_ATTEMPTS,
    runConversation,
    type LoopDeps,
} from './agent.js'
import type { Ledger } from './ledger.js'
import type { Sleep } from './retry.js'
import type {
    Client,
    ClientConfig,
    ModelRequest,
    ModelTurn,
    Protocol,
    RecordUsage,
    Usage,
} from './types.js'
import { UsageAccumulator } from './usage.js'

export { DEFAULT_MAX_ATTEMPTS }

// Error bodies are read at most this far (deliberate change 9).
export const MAX_ERROR_BODY = 32 * 1024

export interface ModelClient {
    readonly config:Readonly<ClientConfig>;
    // '' normalized to 'chat'.
    readonly protocol:Protocol;
    // <= 0 normalized to DEFAULT_MAX_ATTEMPTS.
    readonly maxAttempts:number;
    // One HTTP attempt. Resolves only after capture succeeded.
    send (request:ModelRequest):Promise<ModelTurn>;
    // Exact byte length of the request body `send` would post.
    requestBytes (request:ModelRequest):number;
    // Accumulated usage across all calls on this client.
    usage ():Usage;
}

interface Adapter {
    url (baseUrl:string):string;
    encode (config:ClientConfig, request:ModelRequest):unknown;
    decode (events:AsyncIterable<SseEvent>):Promise<ModelTurn>;
}

const ADAPTERS:Partial<Record<Protocol, Adapter>> = {
    chat:{
        url:chatUrl,
        encode:(config, request) => encodeChat(config, request),
        decode:decodeChat,
    },
    responses:{
        url:responsesUrl,
        encode:(config, request) => encodeResponses(config, request),
        decode:decodeResponses,
    },
    anthropic:{
        url:anthropicUrl,
        encode:(config, request) => encodeAnthropic(config, request),
        decode:decodeAnthropic,
    },
}

function adapterFor (protocol:string):Adapter {
    const known = protocol === 'chat' || protocol === 'responses' ||
        protocol === 'anthropic'
    const adapter = known ? ADAPTERS[protocol as Protocol] : undefined
    if (!adapter) {
        throw new Error(`unsupported inference protocol "${protocol}"`)
    }
    return adapter
}

// Best-effort provider error fields from an OpenAI-style
// `{"error":{...}}` or Anthropic `{"type":"error","error":{...}}` body.
function providerFields (text:string):{
    type?:string;
    code?:string;
    message?:string;
} {
    try {
        const parsed:unknown = JSON.parse(text)
        if (parsed === null || typeof parsed !== 'object') return {}
        const e = (parsed as { error?:unknown }).error
        if (e === null || typeof e !== 'object') return {}
        const { type, code, message } = e as Record<string, unknown>
        return {
            type:typeof type === 'string' ? type : undefined,
            code:typeof code === 'string' ?
                code :
                typeof code === 'number' ? String(code) : undefined,
            message:typeof message === 'string' ? message : undefined,
        }
    } catch {
        return {}
    }
}

async function readCapped (
    body:ReadableStream<Uint8Array>|null,
    limit:number,
    signal:AbortSignal
):Promise<Uint8Array> {
    if (!body) return new Uint8Array(0)
    const reader = body.getReader()
    const parts:Uint8Array[] = []
    let size = 0
    let eof = false
    try {
        while (size < limit) {
            const r = await abortable(reader.read(), signal)
            if (r.done) {
                eof = true
                break
            }
            const take = r.value.subarray(0, limit - size)
            parts.push(take)
            size += take.length
        }
    } finally {
        if (!eof) await reader.cancel().catch(() => {})
    }
    const out = new Uint8Array(size)
    let off = 0
    for (const p of parts) {
        out.set(p, off)
        off += p.length
    }
    return out
}

async function httpError (
    response:Response,
    url:string,
    model:string,
    signal:AbortSignal
):Promise<Error> {
    const bytes = await readCapped(response.body, MAX_ERROR_BODY, signal)
    const text = new TextDecoder().decode(bytes)
    const fields = providerFields(text)
    const headers:Record<string, string> = {}
    response.headers.forEach((value, name) => { headers[name] = value })
    const detail = fields.message ?? text.slice(0, 512).trim()
    const status = `${response.status} ${response.statusText}`.trim()
    const err = new ProviderError(
        `POST "${url}": ${status}${detail ? `: ${detail}` : ''}`,
        {
            status:response.status,
            headers,
            providerType:fields.type,
            providerCode:fields.code,
            providerMessage:fields.message,
        })
    if (response.status >= 300 && response.status < 400) {
        return new EndpointError(
            `${SENTINEL_MESSAGE.endpoint}: ${model}: redirect refused: ` +
                err.message,
            { cause:err, details:{ model } })
    }
    return err
}

export function createModelClient (config:ClientConfig):ModelClient {
    if (!(config.maxOutputTokens > 0)) {
        throw new Error(`${config.model}: max output tokens must be positive`)
    }
    if (goTrimSpace(config.apiKey) === '') {
        throw new Error(`${config.model}: API key is not configured`)
    }
    const protocol = (config.protocol === '' ?
        'chat' :
        config.protocol) as Protocol
    const adapter = adapterFor(protocol)
    const maxAttempts = config.maxAttempts > 0 ?
        config.maxAttempts :
        DEFAULT_MAX_ATTEMPTS
    const gate = new CaptureGate()
    const total = new UsageAccumulator()
    const url = adapter.url(config.baseUrl)

    function encodeBody (request:ModelRequest):Uint8Array {
        const body = adapter.encode(config, request)
        return new TextEncoder().encode(JSON.stringify(body))
    }

    async function attempt (
        request:ModelRequest,
        signal:AbortSignal
    ):Promise<ModelTurn> {
        const fetchFn = config.fetch ?? currentFetch()
        const response = await fetchFn(url, {
            method:'POST',
            headers:requestHeaders(protocol, config.apiKey,
                request.sessionId, config.sessionHeader),
            body:encodeBody(request),
            redirect:'manual',
            signal,
        })
        if (response.status < 200 || response.status >= 300) {
            throw await httpError(response, url, config.model, signal)
        }
        const body = await openCapturedBody(response, {
            role:config.role,
            protocol,
            model:config.model,
            captureResponse:config.captureResponse,
        }, gate, signal)
        let turn:ModelTurn|undefined
        let failure:unknown
        try {
            turn = await adapter.decode(parseSse(body.chunks))
        } catch (err) {
            failure = err
        }
        if (turn) {
            total.add(turn.usage)
            request.onUsage?.(turn.usage)
        }
        // A capture failure here replaces any turn or error.
        await body.release()
        if (!turn) throw failure
        signal.throwIfAborted()
        return turn
    }

    return {
        config,
        protocol,
        maxAttempts,
        requestBytes (request:ModelRequest):number {
            return encodeBody(request).length
        },
        usage ():Usage {
            return total.total()
        },
        async send (request:ModelRequest):Promise<ModelTurn> {
            if (gate.failure) throw gate.failure
            request.signal.throwIfAborted()
            const timeout = config.requestTimeoutMs > 0 ?
                AbortSignal.timeout(config.requestTimeoutMs) :
                undefined
            const signal = timeout ?
                AbortSignal.any([request.signal, timeout]) :
                request.signal
            try {
                return await attempt(request, signal)
            } catch (err) {
                if (err instanceof CaptureError) throw err
                if (request.signal.aborted) throw request.signal.reason
                if (timeout?.aborted) {
                    throw new EndpointError(
                        `${SENTINEL_MESSAGE.endpoint}: ${config.model}: ` +
                            'request timed out after ' +
                            `${config.requestTimeoutMs}ms`,
                        {
                            cause:timeout.reason,
                            details:{ model:config.model },
                        })
                }
                throw err
            }
        },
    }
}

export interface CreateClientOptions {
    // The run's shared ledger; none means unlimited.
    ledger?:Ledger|null;
    now?:() => number;
    sleep?:Sleep;
    sessionId?:() => string;
}

function recordUsage (u:Usage):RecordUsage {
    return {
        uncached_input_tokens:u.uncachedInputTokens,
        cached_input_tokens:u.cachedInputTokens,
        cache_write_tokens:u.cacheWriteTokens,
        output_tokens:u.outputTokens,
        calls:u.calls,
    }
}

// The `Client` the finder and verifier call (spec 07, 3.3): both entry
// points run the agent loop over `model`; usage accumulates across all
// of this client's conversations.
export function createClient (
    model:ModelClient,
    opts:CreateClientOptions = {}
):Client {
    const total = new UsageAccumulator()
    const deps:LoopDeps = {
        client:model,
        model:model.config.model,
        maxOutputTokens:model.config.maxOutputTokens,
        maxAttempts:model.maxAttempts > 0 ?
            model.maxAttempts :
            DEFAULT_MAX_ATTEMPTS,
        ledger:opts.ledger ?? null,
        addUsage:u => total.add(u),
        now:opts.now,
        sleep:opts.sleep,
        sessionId:opts.sessionId,
    }
    return {
        name:model.config.model,
        converse (system, user, converseOpts, signal) {
            return runConversation(deps, system, user, converseOpts, false,
                signal)
        },
        completeStructured (system, user, schemaName, result, signal) {
            return runConversation(deps, system, user, {
                tools:[{
                    name:schemaName,
                    description:'Return the requested structured result.',
                    schema:result.schema,
                }],
                finalTool:schemaName,
                final:{ decode:result.decode },
                maxTurns:1,
            }, true, signal)
        },
        usage () {
            return recordUsage(total.total())
        },
    }
}
// The agent loop over the real `chat` adapter against the fake inference
// server (spec 07, 5.2, 5.5, and 5.6 [HTTP] items).
import type { ServerResponse } from 'node:http'
import { test, type CleanupTest } from '../helpers/test.js'
import {
    startInferenceServer,
    type InferenceServer,
    type Script,
} from '../helpers/inference-server.js'
import { createClient, createModelClient } from '../../src/llm/client.js'
import type { LlmError } from '../../src/llm/errors.js'
import { hasSentinel } from '../../src/llm/errors.js'
import { defaultSleep, type Sleep } from '../../src/llm/retry.js'
import type { ClientConfig } from '../../src/llm/types.js'
import {
    failure,
    finalTool,
    options,
    readTool,
    signal,
} from './agent-helpers.js'

async function server (t:CleanupTest, script:Script):Promise<InferenceServer> {
    const s = await startInferenceServer(script)
    t.cleanup(() => s.close())
    return s
}

function cfg (url:string, over:Partial<ClientConfig> = {}):ClientConfig {
    return {
        role:'finder',
        baseUrl:`${url}/v1`,
        apiKey:'sk-test',
        model:'deepseek-chat',
        protocol:'chat',
        maxOutputTokens:4096,
        maxAttempts:0,
        requestTimeoutMs:0,
        ...over,
    }
}

const USAGE = { prompt_tokens:10, completion_tokens:2, total_tokens:12 }

function response (
    message:Record<string, unknown>,
    finish:string,
    usage:unknown = USAGE
) {
    return {
        id:'c1',
        model:'m',
        choices:[{
            index:0,
            message:{ role:'assistant', ...message },
            finish_reason:finish,
        }],
        usage,
    }
}

function toolCall (name:string, args:unknown, id = 'call-1') {
    return response({
        tool_calls:[{
            id,
            type:'function',
            function:{ name, arguments:JSON.stringify(args) },
        }],
    }, 'tool_calls')
}

function client (
    url:string,
    over:Partial<ClientConfig> = {},
    sleep:Sleep = async () => {}
) {
    return createClient(createModelClient(cfg(url, over)), {
        sleep,
    })
}

test('http: usage normalization through Client.usage()', async t => {
    const s = await server(t, () => ({
        stream:{
            ...toolCall('submit', { summary:'ok' }),
            usage:{
                prompt_tokens:8,
                prompt_tokens_details:{ cached_tokens:4 },
                completion_tokens:3,
                total_tokens:11,
            },
        },
    }))
    const c = client(s.url)
    await c.converse('sys', 'user', options([finalTool()], { maxTurns:1 }),
        signal())
    t.deepEqual(c.usage(), {
        uncached_input_tokens:4,
        cached_input_tokens:4,
        cache_write_tokens:0,
        output_tokens:3,
        calls:1,
    }, 'disjoint counts, cached subtracted once')
})

test('http: a truncated response names finish reason length', async t => {
    const s = await server(t, () => ({
        stream:response({ content:'partial' }, 'length'),
    }))
    const err = await failure(client(s.url).converse('sys', 'user',
        options([readTool(), finalTool()]), signal()))
    t.ok(hasSentinel(err, 'no-final-call'), 'no-final-call')
    t.equal((err as LlmError).details.finishReason, 'length',
        'details name finish reason length')
    t.equal((err as LlmError).details.stopCause, 'finish-reason',
        'stopped on the finish reason')
    t.equal(s.requests.length, 1, 'not retried')
})

test('http: prose names the model and the attempt count', async t => {
    const s = await server(t, () => ({
        stream:response({ content:'looks fine' }, 'stop'),
    }))
    const err = await failure(client(s.url, { maxAttempts:2 }).converse(
        'sys', 'user', options([readTool(), finalTool()], { maxTurns:1 }),
        signal()))
    const details = (err as LlmError).details
    t.ok(hasSentinel(err, 'no-final-call'), 'no-final-call')
    t.equal(details.model, 'deepseek-chat', 'names the model')
    t.equal(details.submissionAttempts, 2, 'names the attempt count')
    t.equal(details.stopCause, 'answered-without-final', 'prose')
})

test('http: a reasoning-only length finish is a no-submission error',
    async t => {
        const s = await server(t, () => ({
            stream:response({ reasoning_content:'thinking hard' }, 'length'),
        }))
        const err = await failure(client(s.url, { maxAttempts:3 }).converse(
            'sys', 'user', options([readTool(), finalTool()]), signal()))
        t.ok(hasSentinel(err, 'no-final-call'), 'no-final-call')
        t.ok(!hasSentinel(err, 'endpoint'), 'not endpoint')
        t.equal((err as LlmError).details.finishReason, 'length',
            'names the ceiling')
        t.equal(s.requests.length, 1, 'one request')
    })

test('http: one session ID per conversation', async t => {
    const s = await server(t, (req, n) => {
        if (n === 0) return { status:503, body:'{"error":{"message":"busy"}}' }
        if (n === 1) return { stream:toolCall('submit', { summary:5 }) }
        return { stream:toolCall('submit', { summary:'ok' }) }
    })
    const c = client(s.url, { model:'deepseek-reasoner' })
    await c.converse('sys', 'user', options([readTool(), finalTool()],
        { maxTurns:1 }), signal())
    await c.converse('sys', 'user', options([readTool(), finalTool()],
        { maxTurns:1 }), signal())
    const ids = s.requests.map(r => r.headers['x-agent-session-id'])
    t.equal(s.requests.length, 4, 'retry, correction, and a second run')
    t.ok(typeof ids[0] === 'string' && ids[0].startsWith('roast-'),
        'a roast session ID')
    t.ok(ids[0] === ids[1] && ids[1] === ids[2],
        'shared by requests, retries, and corrections')
    t.ok(ids[3] !== ids[0], 'distinct across conversations')
    for (const r of s.requests.slice(1)) {
        t.equal((r.body as Record<string, unknown>).tool_choice, 'auto',
            'thinking-mode model gets automatic tool choice')
    }
})

test('http: cancellation during a provider-directed retry delay', async t => {
    const s = await server(t, (_req, n) => n === 0 ? {
        status:503,
        headers:{ 'retry-after-ms':'1' },
        body:'{"error":{"message":"busy"}}',
    } : { stream:toolCall('submit', { summary:'ok' }) })
    const controller = new AbortController()
    const reason = new Error('cancel during retry')
    const delays:number[] = []
    const c = client(s.url, { maxAttempts:2 }, async (ms, retrySignal) => {
        delays.push(ms)
        controller.abort(reason)
        await defaultSleep(ms, retrySignal)
    })
    const err = await failure(c.converse('sys', 'user',
        options([finalTool()], { maxTurns:1 }), controller.signal))
    t.equal(err, reason, 'returns the cancellation reason')
    t.deepEqual(delays, [1], 'uses the provider retry delay')
    t.equal(s.requests.length, 1, 'does not send another request')
})

test('http: a call buffered before a request timeout is never run',
    async t => {
        const read = readTool()
        const s = await server(t, () => (res:ServerResponse) => {
            res.writeHead(200, { 'Content-Type':'text/event-stream' })
            const chunk = {
                id:'c1',
                object:'chat.completion.chunk',
                created:1,
                model:'m',
                choices:[{
                    index:0,
                    delta:{
                        tool_calls:[{
                            index:0,
                            id:'call-1',
                            type:'function',
                            function:{
                                name:'read',
                                arguments:'{"path":"a"}',
                            },
                        }],
                    },
                    finish_reason:null,
                }],
            }
            res.write(`data: ${JSON.stringify(chunk)}\n\n`)
            // The stream never finishes.
        })
        const started = Date.now()
        const err = await failure(client(s.url, {
            requestTimeoutMs:200,
            maxAttempts:3,
        }).converse('sys', 'user', options([read, finalTool()]), signal()))
        t.ok(hasSentinel(err, 'endpoint'), 'endpoint')
        t.equal(s.requests.length, 1, 'after one call')
        t.equal(read.runs, 0, 'the buffered call never ran')
        t.ok(Date.now() - started < 5000, 'promptly')
    })
// `roast review` on an `anthropic` profile against the fake inference
// server (spec 06, 5; ticket 28).
import fs from 'node:fs'
import path from 'node:path'
import { reviewHooks } from '../../src/cli/review.js'
import { test, type CleanupTest } from '../helpers/test.js'
import type {
    RecordedRequest,
    Script,
} from '../helpers/inference-server.js'
import {
    anthropicCalls,
    deepSeekScript,
    type DeepSeekAnswer,
} from '../helpers/anthropic-fakes.js'
import { writeInferenceStream } from '../helpers/inference-stream.js'
import {
    anthropicProfileConfig,
    approveProjectConfig,
    chatCalls,
    FINDER_KEY,
    finding,
    profileConfig,
    requestRecorder,
    reviewMeta,
    runDirs,
    settingsRepo,
    toolNames,
    writeConfig,
    type ReviewRepo,
    type Wire,
} from '../helpers/review.js'

const REVIEW = ['review', '--no-verify', '--format', 'json',
    '--error-format', 'json']
const INTERACTIVE = [...REVIEW, '--interactive', '--max-turns', '2']
const EXPLORE = { interactive:{ min_diff_lines:0, min_files:0 } }

type Block = Record<string, unknown>
type Body = {
    model:string,
    max_tokens:number,
    system:Block[],
    stream:boolean,
    tools:{ name:string, input_schema:Record<string, unknown> }[],
    tool_choice:{ type:string },
    thinking?:unknown,
    messages:{ role:string, content:Block[] }[],
}

function body (req:RecordedRequest):Body {
    return req.body as Body
}

function submit (findings:Wire[] = []) {
    return {
        name:'submit_findings',
        args:{
            assessment:findings.length ? 'FINDINGS_PRESENT' : 'NO_FINDINGS',
            findings,
        },
    }
}

function structured (findings:Wire[] = []) {
    return { ...submit(findings), name:'findings' }
}

// Explore main.go once, then submit `findings`.
function exploreThenSubmit (findings:Wire[] = []):Script {
    return (_req, n) => ({
        stream:n === 0 ?
            anthropicCalls([{
                name:'read_file', args:{ path:'main.go' },
            }], { thinking:'look first' }) :
            anthropicCalls([submit(findings)]),
    })
}

async function anthropicRepo (
    t:CleanupTest,
    script:Script,
    over:object = {},
    profile:object = {}
):Promise<ReviewRepo> {
    const r = await settingsRepo(t, script, { config:null })
    writeConfig(r.dir, anthropicProfileConfig(r.server.url, over, profile))
    await approveProjectConfig(r)
    return r
}

function lastError (stderr:string):Record<string, unknown> {
    return JSON.parse(stderr.trim().split('\n').pop() ?? '')
}

test('anthropic review: native messages through the wrap-up turn',
    async t => {
        const r = await anthropicRepo(t, exploreThenSubmit(), EXPLORE)
        const requests = requestRecorder(r)
        const res = await r.roast(INTERACTIVE)
        t.equal(res.code, 0, res.stderr)
        const [first, second] = requests()
        t.equal(requests().length, 2, 'two requests')
        for (const q of requests()) {
            t.equal(q.path, '/v1/messages', 'messages endpoint')
            t.equal(q.headers['x-api-key'], FINDER_KEY, 'x-api-key')
            t.ok(String(q.headers['anthropic-version'] ?? '') !== '',
                'anthropic-version')
            t.equal(q.headers.authorization, undefined, 'no authorization')
            t.equal(body(q).stream, true, 'stream')
            t.ok(body(q).system.length > 0, 'system blocks')
        }
        t.ok(toolNames(first).includes('read_file'), 'exploration tools')
        t.deepEqual(body(second).tools, body(first).tools,
            'same tools on the wrap-up turn')
        const replay = body(second).messages
        t.equal(replay.length, 3, 'user, assistant, user')
        t.equal(replay[1].content[0].type, 'thinking',
            'signed thinking replayed first')
        const last = replay[2].content
        t.ok(last.some(b => b.type === 'tool_result'), 'tool result')
        t.ok(last.some(b => b.type === 'text'), 'injected notice')
        t.equal(body(first).messages.length, 1, 'no notice at first')
        const usage = reviewMeta(r).usage.finder
        t.deepEqual(usage, {
            uncached_input_tokens:20,
            cached_input_tokens:6,
            cache_write_tokens:4,
            output_tokens:8,
            calls:2,
        }, 'usage accumulates')
    })

test('anthropic review gates on findings; base URL without /v1',
    async t => {
        const script:Script = () => ({
            stream:anthropicCalls([structured([finding()])]),
        })
        const r = await settingsRepo(t, script, { config:null })
        writeConfig(r.dir, anthropicProfileConfig(r.server.url, {}, {
            endpoint:r.server.url,
        }))
        await approveProjectConfig(r)
        const requests = requestRecorder(r)
        const res = await r.roast([...REVIEW, '--max-severity', 'HIGH'])
        t.equal(res.code, 1, res.stderr)
        t.equal(JSON.parse(res.stdout).findings.length, 1, 'finding')
        t.equal(requests()[0].path, '/v1/messages', 'v1 appended')
        const ok = await r.roast([...REVIEW, '--max-severity',
            'critical'])
        t.equal(ok.code, 0, 'below the threshold exits 0')
    })

test('anthropic max_tokens is the profile budget', async t => {
    for (const budget of [1024, 32768]) {
        const r = await anthropicRepo(t, () => ({
            stream:anthropicCalls([structured()]),
        }), {}, { max_output_tokens:budget })
        const requests = requestRecorder(r)
        t.equal((await r.roast(REVIEW)).code, 0, `${budget}: review`)
        t.equal(body(requests()[0]).max_tokens, budget, `${budget}`)
    }
})

test('anthropic tool_choice is auto in every phase (DeepSeek fake)',
    async t => {
        const respond = (req:RecordedRequest, n:number):DeepSeekAnswer => {
            const names = toolNames(req)
            if (names.includes('submit_verdict')) {
                return {
                    tool:'submit_verdict',
                    args:{
                        reasoning:'checked',
                        status:'confirmed',
                        confidence:0.9,
                        grounding:'line 4',
                    },
                }
            }
            const call = names.includes('findings') ?
                structured([finding()]) :
                submit([finding()])
            return n === 1 && names.includes('read_file') ?
                { tool:'read_file', args:{ path:'main.go' } } :
                { tool:call.name, args:call.args }
        }
        for (const args of [[], ['--interactive', '--max-turns', '2']]) {
            const fake = deepSeekScript('anthropic', respond)
            const r = await anthropicRepo(t, fake.script, EXPLORE)
            const requests = requestRecorder(r)
            const res = await r.roast(['review', '--format', 'json',
                ...args])
            const label = args.length ? 'interactive' : 'structured'
            t.equal(res.code, 0, `${label}: ${res.stderr}`)
            t.equal(fake.rejected.length, 0, `${label}: nothing rejected`)
            t.ok(requests().some(q =>
                toolNames(q).includes('submit_verdict')),
            `${label}: verifier ran`)
            t.ok(requests().every(q =>
                body(q).tool_choice.type === 'auto'),
            `${label}: auto everywhere`)
        }
    })

function withRequired (schema:Record<string, unknown>) {
    return { ...schema, required:schema.required ?? [] }
}

test('anthropic input_schema is the full caller schema', async t => {
    const anthropic = exploreThenSubmit()
    const script:Script = (req, n) => req.path.endsWith('/v1/messages') ?
        anthropic(req, n) :
        { stream:chatCalls([submit()]) }
    const r = await anthropicRepo(t, script, EXPLORE)
    const requests = requestRecorder(r)
    t.equal((await r.roast(INTERACTIVE)).code, 0, 'anthropic review')
    const tools = body(requests()[0]).tools
    // The chat adapter sends each caller schema unchanged.
    writeConfig(r.dir, profileConfig(r.server.url, EXPLORE))
    await approveProjectConfig(r)
    t.equal((await r.roast(INTERACTIVE)).code, 0, 'chat review')
    type ChatTool = {
        function:{ name:string, parameters:Record<string, unknown> },
    }
    const chat = (requests()[2].body as { tools:ChatTool[] }).tools
    t.equal(tools.length, chat.length, 'same tool count')
    for (const tool of chat) {
        const got = tools.find(a => a.name === tool.function.name)
        t.deepEqual(got?.input_schema, withRequired(tool.function.parameters),
            `${tool.function.name} schema`)
    }
    const text = JSON.stringify(tools)
    t.ok(text.includes('"additionalProperties"'), 'additionalProperties')
})

test('only claude-mythos-preview gets adaptive thinking', async t => {
    for (const model of ['claude-mythos-preview', 'claude-test']) {
        const r = await anthropicRepo(t, () => ({
            stream:anthropicCalls([structured()]),
        }), {}, { model })
        const requests = requestRecorder(r)
        t.equal((await r.roast(REVIEW)).code, 0, `${model}: review`)
        const thinking = body(requests()[0]).thinking
        if (model === 'claude-test') {
            t.equal(thinking, undefined, 'no thinking field')
        } else {
            t.deepEqual(thinking, { type:'adaptive', display:'summarized' },
                'adaptive thinking')
        }
    }
})

test('anthropic 401 exits 3 with category auth', async t => {
    const r = await anthropicRepo(t, () => ({
        status:401,
        headers:{ 'content-type':'application/json' },
        body:'{"type":"error","error":{"type":"authentication_error",' +
            '"message":"invalid x-api-key"}}',
    }))
    const res = await r.roast(REVIEW)
    t.equal(res.code, 3, 'exit 3')
    t.equal(lastError(res.stderr).error_category, 'auth', 'auth category')
})

test('an interrupted anthropic stream is retried; its tool never runs',
    async t => {
        const script:Script = (_req, n) => res => {
            const response = n === 2 ?
                anthropicCalls([submit()]) :
                anthropicCalls([{
                    name:'read_file', args:{ path:'main.go' },
                }])
            let out = ''
            const sink = {
                setHeader:(k:string, v:string) => res.setHeader(k, v),
                write:(s:string) => { out += s },
                end:() => {},
            }
            writeInferenceStream(sink, 'anthropic', response)
            if (n === 0) out = out.slice(0, out.indexOf('event: message_stop'))
            res.end(out)
        }
        const r = await anthropicRepo(t, script, EXPLORE)
        const requests = requestRecorder(r)
        const delays:number[] = []
        reviewHooks.sleep = async ms => { delays.push(ms) }
        t.cleanup(() => { reviewHooks.sleep = undefined })
        const res = await r.roast([...INTERACTIVE, '--max-attempts', '2'])
        t.equal(res.code, 0, res.stderr)
        t.deepEqual(delays, [5000], 'uses the initial retry delay')
        t.equal(requests().length, 3, 'three requests')
        t.deepEqual(requests()[1].body, requests()[0].body,
            'the retry resends the same request')
        t.equal(body(requests()[2]).messages.filter(m =>
            m.content.some(b => b.type === 'tool_result')).length, 1,
        'only the completed call ran')
        const lines = fs.readFileSync(path.join(runDirs(r)[0],
            'provider-responses.jsonl'), 'utf8').trimEnd().split('\n')
        t.equal(lines.length, 3, 'every stream captured')
        t.equal(reviewMeta(r).usage.finder.calls, 2,
            'usage counts completed calls only')
    })

