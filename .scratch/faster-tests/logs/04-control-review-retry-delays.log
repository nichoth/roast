// Step retries (spec 07, 2.11): a turn's request is retried on retryable
// errors, never on aborts, capture failures, or cutoff errors.

import { isRetryable, retryDelayMs } from './errors.js'

export const INITIAL_BACKOFF_MS = 5000

export type Sleep = (ms:number, signal:AbortSignal) => Promise<void>

export function defaultSleep (ms:number, signal:AbortSignal):Promise<void> {
    return new Promise<void>((resolve, reject) => {
        if (signal.aborted) {
            reject(signal.reason)
            return
        }
        const onAbort = () => {
            clearTimeout(timer)
            reject(signal.reason)
        }
        const timer = setTimeout(() => {
            signal.removeEventListener('abort', onAbort)
            resolve()
        }, ms)
        signal.addEventListener('abort', onAbort, { once:true })
    })
}

// The delay before the next attempt: the provider's hint, else backoff.
export function retryDelay (err:unknown, backoffMs:number):number {
    return retryDelayMs(err, backoffMs)
}

// Runs `attempt`, retrying a retryable failure up to `maxRetries` times
// with doubling backoff. The last attempt's error is thrown.
export async function withStepRetry<R> (
    attempt:() => Promise<R>,
    opts:{ maxRetries:number, signal:AbortSignal, sleep?:Sleep }
):Promise<R> {
    const sleep = opts.sleep ?? defaultSleep
    let backoff = INITIAL_BACKOFF_MS
    for (let retries = 0; ; retries++) {
        try {
            return await attempt()
        } catch (err) {
            if (opts.signal.aborted || retries >= opts.maxRetries ||
                !isRetryable(err)) {
                throw err
            }
            await sleep(retryDelay(err, backoff), opts.signal)
            backoff *= 2
        }
    }
}
// The agent loop over the real `chat` adapter against the fake inference
// server (spec 07, 5.2, 5.5, and 5.6 [HTTP] items).
import type { ServerResponse } from 'node:http'
import { test, type CleanupTest } from '../helpers/test.js'
import {
    startInferenceServer,
    type InferenceServer,
    type Script,
} from '../helpers/inference-server.js'
import { createClient, createModelClient } from '../../src/llm/client.js'
import type { LlmError } from '../../src/llm/errors.js'
import { hasSentinel } from '../../src/llm/errors.js'
import type { ClientConfig } from '../../src/llm/types.js'
import {
    failure,
    finalTool,
    options,
    readTool,
    signal,
} from './agent-helpers.js'

async function server (t:CleanupTest, script:Script):Promise<InferenceServer> {
    const s = await startInferenceServer(script)
    t.cleanup(() => s.close())
    return s
}

function cfg (url:string, over:Partial<ClientConfig> = {}):ClientConfig {
    return {
        role:'finder',
        baseUrl:`${url}/v1`,
        apiKey:'sk-test',
        model:'deepseek-chat',
        protocol:'chat',
        maxOutputTokens:4096,
        maxAttempts:0,
        requestTimeoutMs:0,
        ...over,
    }
}

const USAGE = { prompt_tokens:10, completion_tokens:2, total_tokens:12 }

function response (
    message:Record<string, unknown>,
    finish:string,
    usage:unknown = USAGE
) {
    return {
        id:'c1',
        model:'m',
        choices:[{
            index:0,
            message:{ role:'assistant', ...message },
            finish_reason:finish,
        }],
        usage,
    }
}

function toolCall (name:string, args:unknown, id = 'call-1') {
    return response({
        tool_calls:[{
            id,
            type:'function',
            function:{ name, arguments:JSON.stringify(args) },
        }],
    }, 'tool_calls')
}

function client (url:string, over:Partial<ClientConfig> = {}) {
    return createClient(createModelClient(cfg(url, over)), {
        sleep:async () => {},
    })
}

test('http: usage normalization through Client.usage()', async t => {
    const s = await server(t, () => ({
        stream:{
            ...toolCall('submit', { summary:'ok' }),
            usage:{
                prompt_tokens:8,
                prompt_tokens_details:{ cached_tokens:4 },
                completion_tokens:3,
                total_tokens:11,
            },
        },
    }))
    const c = client(s.url)
    await c.converse('sys', 'user', options([finalTool()], { maxTurns:1 }),
        signal())
    t.deepEqual(c.usage(), {
        uncached_input_tokens:4,
        cached_input_tokens:4,
        cache_write_tokens:0,
        output_tokens:3,
        calls:1,
    }, 'disjoint counts, cached subtracted once')
})

test('http: a truncated response names finish reason length', async t => {
    const s = await server(t, () => ({
        stream:response({ content:'partial' }, 'length'),
    }))
    const err = await failure(client(s.url).converse('sys', 'user',
        options([readTool(), finalTool()]), signal()))
    t.ok(hasSentinel(err, 'no-final-call'), 'no-final-call')
    t.equal((err as LlmError).details.finishReason, 'length',
        'details name finish reason length')
    t.equal((err as LlmError).details.stopCause, 'finish-reason',
        'stopped on the finish reason')
    t.equal(s.requests.length, 1, 'not retried')
})

test('http: prose names the model and the attempt count', async t => {
    const s = await server(t, () => ({
        stream:response({ content:'looks fine' }, 'stop'),
    }))
    const err = await failure(client(s.url, { maxAttempts:2 }).converse(
        'sys', 'user', options([readTool(), finalTool()], { maxTurns:1 }),
        signal()))
    const details = (err as LlmError).details
    t.ok(hasSentinel(err, 'no-final-call'), 'no-final-call')
    t.equal(details.model, 'deepseek-chat', 'names the model')
    t.equal(details.submissionAttempts, 2, 'names the attempt count')
    t.equal(details.stopCause, 'answered-without-final', 'prose')
})

test('http: a reasoning-only length finish is a no-submission error',
    async t => {
        const s = await server(t, () => ({
            stream:response({ reasoning_content:'thinking hard' }, 'length'),
        }))
        const err = await failure(client(s.url, { maxAttempts:3 }).converse(
            'sys', 'user', options([readTool(), finalTool()]), signal()))
        t.ok(hasSentinel(err, 'no-final-call'), 'no-final-call')
        t.ok(!hasSentinel(err, 'endpoint'), 'not endpoint')
        t.equal((err as LlmError).details.finishReason, 'length',
            'names the ceiling')
        t.equal(s.requests.length, 1, 'one request')
    })

test('http: one session ID per conversation', async t => {
    const s = await server(t, (req, n) => {
        if (n === 0) return { status:503, body:'{"error":{"message":"busy"}}' }
        if (n === 1) return { stream:toolCall('submit', { summary:5 }) }
        return { stream:toolCall('submit', { summary:'ok' }) }
    })
    const c = client(s.url, { model:'deepseek-reasoner' })
    await c.converse('sys', 'user', options([readTool(), finalTool()],
        { maxTurns:1 }), signal())
    await c.converse('sys', 'user', options([readTool(), finalTool()],
        { maxTurns:1 }), signal())
    const ids = s.requests.map(r => r.headers['x-agent-session-id'])
    t.equal(s.requests.length, 4, 'retry, correction, and a second run')
    t.ok(typeof ids[0] === 'string' && ids[0].startsWith('roast-'),
        'a roast session ID')
    t.ok(ids[0] === ids[1] && ids[1] === ids[2],
        'shared by requests, retries, and corrections')
    t.ok(ids[3] !== ids[0], 'distinct across conversations')
    for (const r of s.requests.slice(1)) {
        t.equal((r.body as Record<string, unknown>).tool_choice, 'auto',
            'thinking-mode model gets automatic tool choice')
    }
})

test('http: a call buffered before a request timeout is never run',
    async t => {
        const read = readTool()
        const s = await server(t, () => (res:ServerResponse) => {
            res.writeHead(200, { 'Content-Type':'text/event-stream' })
            const chunk = {
                id:'c1',
                object:'chat.completion.chunk',
                created:1,
                model:'m',
                choices:[{
                    index:0,
                    delta:{
                        tool_calls:[{
                            index:0,
                            id:'call-1',
                            type:'function',
                            function:{
                                name:'read',
                                arguments:'{"path":"a"}',
                            },
                        }],
                    },
                    finish_reason:null,
                }],
            }
            res.write(`data: ${JSON.stringify(chunk)}\n\n`)
            // The stream never finishes.
        })
        const started = Date.now()
        const err = await failure(client(s.url, {
            requestTimeoutMs:200,
            maxAttempts:3,
        }).converse('sys', 'user', options([read, finalTool()]), signal()))
        t.ok(hasSentinel(err, 'endpoint'), 'endpoint')
        t.equal(s.requests.length, 1, 'after one call')
        t.equal(read.runs, 0, 'the buffered call never ran')
        t.ok(Date.now() - started < 5000, 'promptly')
    })
// `roast review` on an `anthropic` profile against the fake inference
// server (spec 06, 5; ticket 28).
import fs from 'node:fs'
import path from 'node:path'
import { test, type CleanupTest } from '../helpers/test.js'
import type {
    RecordedRequest,
    Script,
} from '../helpers/inference-server.js'
import {
    anthropicCalls,
    deepSeekScript,
    type DeepSeekAnswer,
} from '../helpers/anthropic-fakes.js'
import { writeInferenceStream } from '../helpers/inference-stream.js'
import {
    anthropicProfileConfig,
    approveProjectConfig,
    chatCalls,
    FINDER_KEY,
    finding,
    profileConfig,
    requestRecorder,
    reviewMeta,
    runDirs,
    settingsRepo,
    toolNames,
    writeConfig,
    type ReviewRepo,
    type Wire,
} from '../helpers/review.js'

const REVIEW = ['review', '--no-verify', '--format', 'json',
    '--error-format', 'json']
const INTERACTIVE = [...REVIEW, '--interactive', '--max-turns', '2']
const EXPLORE = { interactive:{ min_diff_lines:0, min_files:0 } }

type Block = Record<string, unknown>
type Body = {
    model:string,
    max_tokens:number,
    system:Block[],
    stream:boolean,
    tools:{ name:string, input_schema:Record<string, unknown> }[],
    tool_choice:{ type:string },
    thinking?:unknown,
    messages:{ role:string, content:Block[] }[],
}

function body (req:RecordedRequest):Body {
    return req.body as Body
}

function submit (findings:Wire[] = []) {
    return {
        name:'submit_findings',
        args:{
            assessment:findings.length ? 'FINDINGS_PRESENT' : 'NO_FINDINGS',
            findings,
        },
    }
}

function structured (findings:Wire[] = []) {
    return { ...submit(findings), name:'findings' }
}

// Explore main.go once, then submit `findings`.
function exploreThenSubmit (findings:Wire[] = []):Script {
    return (_req, n) => ({
        stream:n === 0 ?
            anthropicCalls([{
                name:'read_file', args:{ path:'main.go' },
            }], { thinking:'look first' }) :
            anthropicCalls([submit(findings)]),
    })
}

async function anthropicRepo (
    t:CleanupTest,
    script:Script,
    over:object = {},
    profile:object = {}
):Promise<ReviewRepo> {
    const r = await settingsRepo(t, script, { config:null })
    writeConfig(r.dir, anthropicProfileConfig(r.server.url, over, profile))
    await approveProjectConfig(r)
    return r
}

function lastError (stderr:string):Record<string, unknown> {
    return JSON.parse(stderr.trim().split('\n').pop() ?? '')
}

test('anthropic review: native messages through the wrap-up turn',
    async t => {
        const r = await anthropicRepo(t, exploreThenSubmit(), EXPLORE)
        const requests = requestRecorder(r)
        const res = await r.roast(INTERACTIVE)
        t.equal(res.code, 0, res.stderr)
        const [first, second] = requests()
        t.equal(requests().length, 2, 'two requests')
        for (const q of requests()) {
            t.equal(q.path, '/v1/messages', 'messages endpoint')
            t.equal(q.headers['x-api-key'], FINDER_KEY, 'x-api-key')
            t.ok(String(q.headers['anthropic-version'] ?? '') !== '',
                'anthropic-version')
            t.equal(q.headers.authorization, undefined, 'no authorization')
            t.equal(body(q).stream, true, 'stream')
            t.ok(body(q).system.length > 0, 'system blocks')
        }
        t.ok(toolNames(first).includes('read_file'), 'exploration tools')
        t.deepEqual(body(second).tools, body(first).tools,
            'same tools on the wrap-up turn')
        const replay = body(second).messages
        t.equal(replay.length, 3, 'user, assistant, user')
        t.equal(replay[1].content[0].type, 'thinking',
            'signed thinking replayed first')
        const last = replay[2].content
        t.ok(last.some(b => b.type === 'tool_result'), 'tool result')
        t.ok(last.some(b => b.type === 'text'), 'injected notice')
        t.equal(body(first).messages.length, 1, 'no notice at first')
        const usage = reviewMeta(r).usage.finder
        t.deepEqual(usage, {
            uncached_input_tokens:20,
            cached_input_tokens:6,
            cache_write_tokens:4,
            output_tokens:8,
            calls:2,
        }, 'usage accumulates')
    })

