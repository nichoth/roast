// Bundles the CLI (default), the test entry (--test), one test module
// (--test-file <path>), or the live-test entry (--live) with esbuild.
// Run directly by Node (type stripping), so only erasable TypeScript
// syntax is allowed here.
import { execFileSync } from 'node:child_process'
import { readFileSync } from 'node:fs'
import { chmod, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
import { resolve } from 'node:path'
import { build } from 'esbuild'
import type { Metafile } from 'esbuild'
import { ROOT, baseOptions } from './esbuild-options.ts'
import {
    bundledPackageDirs,
    readBundledPackages,
    renderNotices,
} from './licenses.ts'

const SHEBANG = '#!/usr/bin/env node'
// esbuild's ESM output turns a bundled CommonJS `require('node:fs')` into
// a runtime "Dynamic require is not supported" error unless a `require`
// is in scope.
const REQUIRE_SHIM = [
    "import { createRequire as __roastRequire } from 'node:module'",
    'const require = __roastRequire(import.meta.url)',
].join('\n')

type Mode =
    { kind:'cli'|'test'|'live' }|
    { kind:'test-file', file:string, outfile:string }

function parseMode (args:string[]):Mode {
    if (args.length === 0) return { kind:'cli' }
    if (args.length === 1 && args[0] === '--test') return { kind:'test' }
    if (args.length === 1 && args[0] === '--live') return { kind:'live' }
    if (args.length === 3 && args[0] === '--test-file' &&
        args[1].endsWith('.ts')) {
        return { kind:'test-file', file:args[1], outfile:args[2] }
    }
    throw new Error('usage: node scripts/bundle.ts ' +
        '[--test|--test-file <path.ts> <outfile>|--live], ' +
        `got ${args.join(' ')}`)
}

// Runs git at the repository root; `unknown` when git fails (a build
// from a tarball, no git on PATH).
function git (args:string[]):string {
    try {
        const out = execFileSync('git', args, {
            cwd:ROOT,
            encoding:'utf8',
            stdio:['ignore', 'pipe', 'ignore'],
        }).trim()
        return out || 'unknown'
    } catch {
        return 'unknown'
    }
}

async function packageVersion ():Promise<string> {
    const text = await readFile(new URL('package.json', `file://${ROOT}`),
        'utf8')
    const version = JSON.parse(text).version
    if (typeof version !== 'string') {
        throw new Error('package.json has no string version')
    }
    return version
}

// Writes dist/THIRD_PARTY_LICENSES.txt from the metafile (spec 15, 2.6).
// Throws, naming the package, when a bundled package fails validation.
async function writeThirdPartyNotices (metafile:Metafile):Promise<void> {
    const dirs = bundledPackageDirs(metafile, 'dist/cli.js')
        .map(dir => resolve(ROOT, dir))
    const notices = renderNotices(readBundledPackages(dirs),
        path => readFileSync(path, 'utf8'))
    await writeFile(new URL('dist/THIRD_PARTY_LICENSES.txt',
        `file://${ROOT}`), notices)
}

async function bundleCli ():Promise<void> {
    const dist = new URL('dist/', `file://${ROOT}`)
    await rm(dist, { recursive:true, force:true })
    await mkdir(dist, { recursive:true })

    const version = await packageVersion()
    const commit = git(['rev-parse', '--short=7', 'HEAD'])
    const date = git(['log', '-1', '--format=%cI'])

    const result = await build({
        ...baseOptions(),
        entryPoints:['src/cli.ts'],
        outfile:'dist/cli.js',
        tsconfig:'tsconfig.build.json',
        metafile:true,
        banner:{ js:`${SHEBANG}\n${REQUIRE_SHIM}` },
        define:{
            __ROAST_VERSION__:JSON.stringify(version),
            __ROAST_COMMIT__:JSON.stringify(commit),
            __ROAST_DATE__:JSON.stringify(date),
        },
    })
    const metafile = result.metafile
    if (!metafile) throw new Error('esbuild returned no metafile')
    await writeFile(new URL('meta.json', dist), JSON.stringify(metafile))
    await writeThirdPartyNotices(metafile)
    await chmod(new URL('cli.js', dist), 0o755)
}

async function bundleTests (entry:string, outfile:string):Promise<void> {
    await build({
        ...baseOptions(),
        entryPoints:[entry],
        outfile,
        tsconfig:'tsconfig.json',
        banner:{ js:REQUIRE_SHIM },
    })
}

async function main ():Promise<void> {
    const mode = parseMode(process.argv.slice(2))
    if (mode.kind === 'cli') return bundleCli()
    if (mode.kind === 'test') {
        return bundleTests('test/index.ts', 'test/test-bundle.js')
    }
    if (mode.kind === 'test-file') {
        return bundleTests(mode.file, mode.outfile)
    }
    return bundleTests('test/live/index.ts', 'test/live-bundle.js')
}

try {
    await main()
} catch (err) {
    // esbuild has already printed its own diagnostics for build errors.
    console.error(err instanceof Error ? err.message : err)
    process.exitCode = 1
}
import { existsSync } from 'node:fs'
import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
import { tmpdir } from 'node:os'
import { delimiter, join } from 'node:path'
import { test } from '@substrate-system/tapzero'
import { ROOT, run } from '../helpers/spawn.js'

// Runs the real `test:one` script from package.json at the repository
// root, the way `npm run test:one -- <file>` does: npm appends the
// arguments to the script text.
async function testOne (args:string[]) {
    const pkg = JSON.parse(await readFile(join(ROOT, 'package.json'),
        'utf8'))
    const script:string = pkg.scripts['test:one']
    const bin = join(ROOT, 'node_modules', '.bin')
    const quoted = args.map(arg => `'${arg}'`).join(' ')
    return run('sh', ['-c', `${script} ${quoted}`], {
        cwd:ROOT,
        env:{ ...process.env, PATH:bin + delimiter + process.env.PATH },
    })
}

// Writes `source` as a test module in a temporary directory and runs it
// through `test:one`.
async function testOneSource (source:string) {
    const dir = await mkdtemp(join(tmpdir(), 'roast-test-one-'))
    try {
        const file = join(dir, 'fixture.ts')
        await writeFile(file, source)
        return await testOne([file])
    } finally {
        await rm(dir, { recursive:true, force:true })
    }
}

const PASSING_TAP = "console.log('TAP version 13\\nok 1 - fine\\n1..1')\n"

test('simultaneous focused commands keep their own results', async t => {
    const results = await Promise.all(Array.from({ length:8 }, (_, i) => {
        const label = `focused-fixture-${i}`
        const status = i % 2
        const source = `console.log('TAP version 13\\nok 1 - ${label}` +
            `\\n1..1')\nprocess.exitCode = ${status}\n`
        return testOneSource(source)
    }))
    for (const [i, res] of results.entries()) {
        t.equal(res.code, i % 2, `fixture ${i} exit status`)
        t.ok(res.stdout.includes(`focused-fixture-${i}`),
            `fixture ${i} reports its own output`)
    }
})

test('test:one exits 0 when the test module passes', async t => {
    const res = await testOneSource(PASSING_TAP)
    t.equal(res.code, 0, 'exits 0')
})

test('test:one exits non-zero when the test module fails', async t => {
    const res = await testOneSource(PASSING_TAP + 'process.exitCode = 1\n')
    t.ok(res.code !== 0, 'exits non-zero')
})

test('test:one exits non-zero without a test file', async t => {
    const res = await testOne([])
    t.ok(res.code !== 0, 'exits non-zero')
})

test('test:one exits non-zero for a missing test file', async t => {
    const res = await testOne(['test/no-such-focused-test.ts'])
    t.ok(res.code !== 0, 'exits non-zero')
})

test('test:one exits non-zero for a failed assertion', async t => {
    const res = await testOneSource(
        "console.log('TAP version 13\\nnot ok 1 - broken\\n1..1')\n"
    )
    t.ok(res.code !== 0, 'exits non-zero')
})

test('test:one exits non-zero for a crashed process', async t => {
    const res = await testOneSource("throw new Error('fixture crash')\n")
    t.ok(res.code !== 0, 'exits non-zero')
    t.ok(res.stderr.includes('fixture crash'), 'reports the crash')
})

test('focused bundles are removed after success and failure', async t => {
    for (const [name, ending, expected] of [
        ['success', '', 0],
        ['failure', 'process.exitCode = 1', 1],
        ['crash', "throw new Error('crash')", 1],
    ] as const) {
        const source = "import { fileURLToPath } from 'node:url'\n" +
            "console.error('bundle-path=' + fileURLToPath(import.meta.url))\n" +
            PASSING_TAP + ending + '\n'
        const res = await testOneSource(source)
        const path = res.stderr.match(/bundle-path=(.+)/)?.[1]
        t.equal(res.code, expected, `${name} has expected exit status`)
        t.ok(path, `${name} reports its bundle path`)
        t.ok(path && !existsSync(path), `${name} removes its bundle`)
    }
})

