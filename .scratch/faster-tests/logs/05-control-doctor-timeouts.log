epo, trustHash(projection), ctx)\n        if (state === 'approved') {\n            return {\n                name,\n                status:'pass',\n                detail:'approval required and ' +\n                    'granted for this clone'\n            }\n        }\n        const why = state === 'legacy' ?\n            'approval required; approved by an older Roast' :\n            'approval required and not granted'\n        return {\n            name,\n            status:'fail',\n            detail:why +\n                '; endpoint probes skipped; run `npx roast trust`'\n        }\n    } catch (err) {\n        return {\n            name,\n            status:'fail',\n            detail:'approval required; could ' +\n                `not read approvals: ${message(err)}`\n        }\n    }\n}\n\nasync function discardModelsBody (\n    response:Response,\n    signal:AbortSignal\n):Promise<void> {\n    if (!response.body) return\n    const reader = response.body.getReader()\n    let size = 0\n    try {\n        while (size < 32 * 1024) {\n            const chunk = await abortable(reader.read(), signal)\n            if (chunk.done) return\n            size += chunk.value.byteLength\n        }\n    } finally {\n        await reader.cancel().catch(() => {})\n        reader.releaseLock()\n    }\n}\n\nexport async function doctorEndpointCheck (\n    name:RoleName,\n    resolved:ResolvedRole,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const url = resolved.baseURL.replace(/\\/+$/, '') + '/models'\n    const result:DoctorResult = {\n        name:`${name}-endpoint`, status:'fail', detail:'',\n    }\n    if (!URL.canParse(url)) {\n        return { ...result, detail:'invalid models endpoint: invalid URL' }\n    }\n    const signal = AbortSignal.any([\n        ctx.signal, doctorHooks.timeout(5000),\n    ])\n    try {\n        const response = await ctx.fetch(url, {\n            method:'GET',\n            redirect:'manual',\n            signal,\n            headers:resolved.protocol === 'anthropic' ? {\n                'x-api-key':resolved.apiKey,\n                'anthropic-version':'2023-06-01',\n            } : { Authorization:`Bearer ${resolved.apiKey}` },\n        })\n        await discardModelsBody(response, signal)\n        const status = `HTTP ${response.status} ${response.statusText}`.trim()\n        if (response.ok) {\n            result.status = 'pass'\n            result.detail = `GET ${url}: ${status}`\n        } else if (response.status >= 300 && response.status < 400) {\n            result.detail = `GET ${url}: redirect refused (${status})`\n        } else if (response.status === 401 || response.status === 403) {\n            result.detail = `credential rejected by ${url}: ${status}`\n        } else if (response.status >= 500) {\n            result.detail = `${url} returned ${status}`\n        } else {\n            result.status = 'warn'\n            result.detail = 'endpoint is reachable but model listing ' +\n                `returned ${status}`\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = `GET ${url}: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nconst probeResult = z.object({ ok:z.boolean(), token:z.string() })\n\nexport async function doctorRoundtripCheck (\n    name:RoleName,\n    resolved:ResolvedRole,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const result:DoctorResult = {\n        name:`${name}-roundtrip`, status:'fail', detail:'',\n    }\n    const signal = AbortSignal.any([\n        ctx.signal, doctorHooks.timeout(35000),\n    ])\n    try {\n        const protocol = resolved.protocol\n        if (protocol !== 'chat' && protocol !== 'responses' &&\n            protocol !== 'anthropic') {\n            throw new Error(`unsupported inference protocol \"${protocol}\"`)\n        }\n        const limit = resolved.maxOutputTokens\n        const client = createClient(createModelClient({\n            role:name,\n            baseUrl:resolved.baseURL,\n            apiKey:resolved.apiKey,\n            model:resolved.model,\n            protocol,\n            maxOutputTokens:limit > 0 && limit <= 512 ? limit : 512,\n            sessionHeader:resolved.sessionHeader,\n            maxAttempts:1,\n            requestTimeoutMs:15000,\n            fetch:ctx.fetch,\n        }))\n        const token = `roast-doctor-${newSessionId().slice(6)}`\n        let looked = false\n        const output = await client.converse(\n            'This is a connectivity check. Call doctor_lookup once, then ' +\n                'call doctor_probe with ok=true and the token ' +\n                'doctor_lookup returned.',\n            'Run the check now.', {\n                tools:[{\n                    name:'doctor_lookup',\n                    description:'Return the diagnostic token.',\n                    schema:{\n                        type:'object',\n                        properties:{},\n                        additionalProperties:false,\n                    },\n                    run:() => {\n                        looked = true\n                        return { token }\n                    },\n                }, {\n                    name:'doctor_probe',\n                    description:'Return the diagnostic result.',\n                    schema:{\n                        type:'object',\n                        properties:{\n                            ok:{ type:'boolean' }, token:{ type:'string' },\n                        },\n                        required:['ok', 'token'],\n                        additionalProperties:false,\n                    },\n                }],\n                finalTool:'doctor_probe',\n                final:{ decode:value => probeResult.parse(value) },\n                maxTurns:2,\n            }, signal)\n        if (!output.ok) {\n            result.detail = 'doctor_probe returned ok=false'\n        } else if (!looked || output.token !== token) {\n            result.detail = 'doctor_probe did not return the token from ' +\n                'doctor_lookup; the tool result did not round-trip'\n        } else {\n            result.status = 'pass'\n            result.detail = `${resolved.model} via ${resolved.protocol} ` +\n                '(two-turn tool loop)'\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = hasSentinel(err, 'auth') ?\n            'credential rejected by the configured inference route' :\n            `${resolved.protocol}/${resolved.model} two-turn tool probe ` +\n                `failed: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nasync function doctorRoleChecks (\n    cfg:ProjectConfig,\n    trusted:boolean,\n    ctx:RunContext\n):Promise<DoctorResult[]> {\n    const results:DoctorResult[] = []\n    for (const name of ['finder', 'verifier'] as const) {\n        let resolved:ResolvedRole\n        try {\n            resolved = resolveRole(cfg, name, ctx.env)\n        } catch (err) {\n            results.push({\n                name:`${name}-profile`, status:'fail', detail:message(err),\n            })\n            continue\n        }\n        const source = describeSource(resolved.credential)\n        results.push({\n            name:`${name}-credential`,\n            status:goTrimSpace(resolved.apiKey) ? 'pass' : 'fail',\n            detail:source,\n        })\n        try {\n            validateRole(name, resolved)\n        } catch (err) {\n            results.push({\n                name:`${name}-profile`, status:'fail', detail:message(err),\n            })\n            continue\n        }\n        results.push({\n            name:`${name}-profile`,\n            status:'pass',\n            detail:`${resolved.profile}: ${resolved.model} via ` +\n                `${resolved.protocol} at ${resolved.baseURL} with ` +\n                `credential ${source}` + (resolved.sessionHeader ?\n                `, session header ${resolved.sessionHeader}` : ''),\n        })\n        if (!trusted) continue\n        results.push(await doctorEndpointCheck(name, resolved, ctx))\n        results.push(await doctorRoundtripCheck(name, resolved, ctx))\n    }\n    return results\n}\n\nexport async function doctorChecks (\n    explicit:string,\n    ctx:RunContext\n):Promise<DoctorResult[]> {\n    const results:DoctorResult[] = [{\n        name:'build',\n        status:buildInfo.version === 'dev' ? 'warn' : 'pass',\n        detail:formatBuildInfo(buildInfo) +\n            (buildInfo.version === 'dev' ? '; development build' : ''),\n    }]\n    let file = ''\n    try {\n        file = await projectConfigPath(explicit, ctx)\n        if (!file) throw new Error(NO_PROJECT_CONFIG)\n        results.push({ name:'config-file', status:'pass', detail:file })\n    } catch (err) {\n        results.push({\n            name:'config-file',\n            status:'fail',\n            detail:message(err)\n        })\n    }\n    let cfg:ProjectConfig|undefined\n    if (file) {\n        try {\n            cfg = await loadProjectConfig(path.resolve(ctx.cwd, file), ctx)\n            results.push({\n                name:'config',\n                status:'pass',\n                detail:`schema version ${cfg.version}`\n            })\n        } catch (err) {\n            results.push({\n                name:'config',\n                status:'fail',\n                detail:message(err)\n            })\n        }\n    }\n    if (cfg) {\n        const trust = await doctorTrustCheck(cfg, ctx)\n        results.push(trust)\n        results.push(...await doctorRoleChecks(cfg,\n            trust.status === 'pass', ctx))\n    }\n    let repo = ''\n    try {\n        repo = await gitRoot(ctx.cwd, ctx)\n        results.push({ name:'git', status:'pass', detail:repo })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        results.push({\n            name:'git',\n            status:'warn',\n            detail:'not inside a Git repository'\n        })\n    }\n    if (repo) {\n        try {\n            const gate = await inspectGate(repo, ctx.env)\n            results.push({\n                name:'git-gate',\n                status:gate.stale ||\n                    (gate.decision === 'enabled' && !isActive(gate)) ?\n                    'warn' : 'pass',\n                detail:summary(gate)\n            })\n        } catch (err) {\n            results.push({\n                name:'git-gate',\n                status:'warn',\n                detail:message(err)\n            })\n        }\n    }\n    const store = await openCredentialStore(ctx.cwd, ctx.env, ctx)\n    for (const scope of ['project', 'user'] as const) {\n        const file = store.paths[scope]\n        if (!file) continue\n        try {\n            await lstat(file)\n        } catch (err) {\n            if ((err as NodeJS.ErrnoException).code === 'ENOENT') continue\n            // Let the credential loader report other filesystem errors.\n        }\n        const name = `${scope}-credentials`\n        try {\n            const entries = await loadCredentials(file)\n            const providers = [...entries.keys()].sort().join(', ')\n            results.push({\n                name,\n                status:'pass',\n                detail:`${file} (${providers || 'none stored'})`\n            })\n        } catch (err) {\n            results.push({ name, status:'fail', detail:message(err) })\n        }\n    }\n    const variable = ctx.env.HTTPS_PROXY ? 'HTTPS_PROXY' :\n        ctx.env.https_proxy ? 'https_proxy' : ''\n    const honored = ctx.env.NODE_USE_ENV_PROXY === '1'\n    results.push({\n        name:'proxy-env',\n        status:variable && !honored ? 'warn' : 'pass',\n        detail:!variable ? 'no proxy configured' : honored ?\n            'proxy variables honored (NODE_USE_ENV_PROXY=1)' :\n            `${variable} is set but NODE_USE_ENV_PROXY is not; ` +\n                'Node ignores proxy variables unless NODE_USE_ENV_PROXY=1',\n    })\n    let targets:InstallationTarget[] = []\n    try {\n        targets = await installationTargets('', '', { env:ctx.env })\n    } catch (err) {\n        results.push({\n            name:'agent-skills',\n            status:'warn',\n            detail:message(err)\n        })\n    }\n    for (const target of targets) {\n        const name = `${target.harness}-skill`\n        try {\n            const skill = await inspectSkill(target.path)\n            switch (skill.state) {\n                case 'not_installed':\n                    results.push({\n                        name,\n                        status:'warn',\n                        detail:'not installed; run ' +\n                            '`roast skill install --global`'\n                    })\n                    break\n                case 'stale':\n                    results.push({\n                        name,\n                        status:'warn',\n                        detail:'stale; run ' +\n                            '`roast skill install --global --force`'\n                    })\n                    break\n                default:\n                    results.push({\n                        name,\n                        status:'pass',\n                        detail:target.path +\n                            (skill.state === 'symlink' ?\n                                ' (development symlink)' : '')\n                    })\n            }\n        } catch (err) {\n            results.push({ name, status:'warn', detail:message(err) })\n        }\n    }\n    return results\n}\n\nexport const doctorCommand:CommandDef = {\n    command:'doctor',\n    describe:'Check configuration, providers, and local integration',\n    builder:y => y\n        .option('config', {\n            type:'string',\n            default:'',\n            describe:'project config file (default: nearest .roast.jsonc ' +\n                'up to the Git toplevel)',\n        })\n        .option('json', {\n            type:'boolean', default:false, describe:'emit a JSON array',\n        }),\n    async handler (args, ctx) {\n        const results = await doctorChecks(String(args.config), ctx)\n        if (args.json) {\n            ctx.stdout.write(JSON.stringify(results, null, 2) + '\\n')\n        } else {\n            for (const result of results) {\n                ctx.stdout.write(result.status.toUpperCase().padEnd(5) +\n                    ` ${result.name.padEnd(18)} ${result.detail}\\n`)\n            }\n        }\n        if (results.some(result => result.status === 'fail')) {\n            throw new Error('one or more doctor checks failed')\n        }\n    },\n}\n"},"isError":false,"durationMs":10}
{"type":"tool_execution_end","toolCallId":"SrLBJm6Mjt2S1m5pXX30bwnu1DISOcZ4","toolName":"read","result":{"content":[{"type":"text","text":"import fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'\nimport { runRoast } from '../helpers/run.js'\nimport { saveCredential, projectCredentialsPath, userCredentialsPath }\n    from '../../src/credentials/credentials.js'\nimport { installationTargets, install, skillHooks }\n    from '../../src/skill/skill.js'\nimport { git } from '../../src/git/git.js'\nimport { startInferenceServer } from '../helpers/inference-server.js'\nimport { doctorProbe, probeCall } from '../helpers/doctor-probe.js'\nimport { providerServer } from '../helpers/provider-server.js'\nimport { doctorHooks } from '../../src/cli/doctor.js'\nimport { CancelledError } from '../../src/cli/errors.js'\n\nconst BUILTIN = {\n    version:1,\n    inference_profiles:{ o:{ protocol:'chat', model:'m' } },\n    roles:{ finder:{ profile:'o' }, verifier:{ profile:'o' } },\n}\n\nfunction doctorRepo (t:CleanupTest):TempDir {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    delete r.env.HTTPS_PROXY\n    delete r.env.https_proxy\n    delete r.env.NODE_USE_ENV_PROXY\n    r.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n    r.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n    fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n        JSON.stringify(BUILTIN))\n    return r\n}\n\ninterface Row {\n    name:string;\n    status:string;\n    detail:string;\n}\n\nasync function doctor (\n    r:TempDir,\n    args:string[] = [],\n    redirectTo?:string\n) {\n    const server = redirectTo ? undefined : await providerServer(doctorProbe())\n    try {\n        const res = await runRoast(['doctor', '--json', ...args],\n            { cwd:r.dir, env:r.env, redirectTo:redirectTo ?? server?.url })\n        const rows:Row[] = res.stdout.startsWith('[') ?\n            JSON.parse(res.stdout) : []\n        return { ...res, rows }\n    } finally {\n        await server?.close()\n    }\n}\n\ntest('doctor keeps all local checks after missing or invalid config',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        await saveCredential(project, 'openai', 'secret', new Date())\n        fs.unlinkSync(path.join(r.dir, '.roast.jsonc'))\n        const missing = await doctor(r)\n        t.equal(missing.code, 4, 'missing config fails')\n        t.deepEqual(missing.rows.map(x => x.name), [\n            'build', 'config-file', 'git', 'git-gate',\n            'project-credentials', 'proxy-env', 'agents-skill', 'claude-skill',\n        ], 'local checks remain in order')\n        t.equal(missing.rows[1].status, 'fail', 'config-file failure')\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), '{')\n        const invalid = await doctor(r)\n        t.equal(invalid.code, 4, 'invalid config fails')\n        t.equal(invalid.rows.find(x => x.name === 'config')?.status,\n            'fail', 'config failure')\n        t.ok(invalid.rows.some(x => x.name === 'agents-skill'),\n            'skills still checked')\n        const explicit = await doctor(r, ['--config', 'missing.json'])\n        t.equal(explicit.rows.find(x => x.name === 'config-file')?.status,\n            'pass', 'explicit missing path accepted')\n        t.equal(explicit.rows.find(x => x.name === 'config')?.status,\n            'fail', 'explicit missing file fails loading')\n        fs.writeFileSync(path.join(r.dir, 'custom.json'),\n            JSON.stringify(BUILTIN))\n        const relative = await doctor(r, ['--config', 'custom.json'])\n        t.equal(relative.code, 0, 'relative config uses invocation cwd')\n    })\n\ntest('doctor checks gate health and only user-level skill installations',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const targets = await installationTargets('', '', { env:r.env })\n        await install(targets[0].path, false)\n        await git(r.dir, ['config', '--local', 'roast.gate', 'enabled'],\n            { env:r.env })\n        const res = await doctor(r)\n        t.equal(res.code, 0, 'warnings do not fail')\n        t.equal(res.rows.find(x => x.name === 'git-gate')?.status,\n            'warn', 'enabled but absent gate warns')\n        t.equal(res.rows.find(x => x.name === 'agents-skill')?.status,\n            'pass', 'user install found')\n        fs.writeFileSync(path.join(targets[0].path, 'SKILL.md'), 'stale')\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'warn', 'stale warns')\n        fs.rmSync(targets[0].path, { recursive:true })\n        fs.symlinkSync(r.dir, targets[0].path)\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'pass', 'symlink passes')\n        const outside = tempDir()\n        t.cleanup(outside.remove)\n        outside.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n        outside.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n        fs.writeFileSync(path.join(outside.dir, '.roast.jsonc'),\n            JSON.stringify(BUILTIN))\n        const out = await doctor(outside)\n        t.equal(out.code, 0, 'outside repository only warns')\n        t.equal(out.rows.find(x => x.name === 'git')?.status,\n            'warn', 'git warns')\n        t.ok(!out.rows.some(x => x.name === 'git-gate'), 'gate omitted')\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const text = await runRoast(['doctor'], {\n            cwd:r.dir, env:r.env, redirectTo:server.url,\n        })\n        t.equal(text.code, 0, 'text mode')\n        t.equal(text.stdout.split('\\n').filter(Boolean).length,\n            res.rows.length, 'one text line per result')\n        t.equal((await doctor(r, ['extra'])).code, 2, 'rejects positional')\n    })\n\nexport async function approveDoctorConfig (r:TempDir):Promise<void> {\n    const res = await runRoast(['trust', '--yes'],\n        { cwd:r.dir, env:r.env })\n    if (res.code !== 0) throw new Error(res.stderr)\n}\n\ntest('doctor inspects both stored scopes even with an environment key',\n    async t => {\n        const r = doctorRepo(t)\n        r.env.OPENAI_API_KEY = 'environment-secret'\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        const user = userCredentialsPath(r.env)\n        const secret = 'stored-secret-do-not-print'\n        for (const file of [project, user]) {\n            await saveCredential(file, 'openai', secret, new Date())\n        }\n        const usable = await doctor(r)\n        t.equal(usable.code, 0, usable.stderr)\n        for (const scope of ['project', 'user']) {\n            const row = usable.rows.find(x => x.name ===\n                `${scope}-credentials`)\n            t.equal(row?.status, 'pass', `${scope} reported`)\n            t.ok(row?.detail.includes('(openai)'), 'provider reported')\n        }\n        t.ok(!usable.stdout.includes(secret), 'stored key omitted')\n        for (const [scope, file] of [['project', project], ['user', user]]) {\n            fs.writeFileSync(file, JSON.stringify({\n                version:1, providers:{ openai:{ key:secret } }, bogus:true,\n            }))\n            const broken = await doctor(r)\n            t.equal(broken.code, 4, `${scope} broken fails`)\n            t.equal(broken.rows.find(x => x.name ===\n                `${scope}-credentials`)?.status, 'fail', 'failure row')\n            t.ok(broken.rows.some(x => x.name === 'proxy-env'),\n                'later checks run')\n            t.ok(!(broken.stdout + broken.stderr).includes(secret),\n                'no key in error output')\n            fs.unlinkSync(file)\n        }\n        const absent = await doctor(r)\n        t.equal(absent.code, 0, 'absent files pass')\n        t.ok(!absent.rows.some(x => x.name.endsWith('-credentials')),\n            'absent files omitted')\n    })\n\ntest('doctor never echoes malformed credential JSON', async t => {\n    const r = doctorRepo(t)\n    const file = userCredentialsPath(r.env)\n    const secret = 'leak-key'\n    await saveCredential(file, 'openai', secret, new Date())\n    fs.writeFileSync(file, `{\"key\":${secret}}`)\n    const res = await doctor(r)\n    t.equal(res.code, 4, 'malformed file fails')\n    t.equal(res.rows.find(x => x.name === 'user-credentials')?.status,\n        'fail', 'scope reports failure')\n    t.ok(!(res.stdout + res.stderr).includes(secret),\n        'JSON parser context must not expose a key')\n})\n\ntest('doctor requires clone approval for custom endpoints', async t => {\n    const r = doctorRepo(t)\n    t.equal((await doctor(r)).rows.find(x =>\n        x.name === 'config-trust')?.status, 'pass', 'built-in needs none')\n    fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n        ...BUILTIN,\n        inference_profiles:{\n            o:{\n                protocol:'chat',\n                model:'m',\n                endpoint:'https://gateway.example/v1',\n            },\n        },\n    }))\n    const unapproved = await doctor(r)\n    t.equal(unapproved.code, 4, 'unapproved fails')\n    t.equal(unapproved.rows.find(x => x.name === 'config-trust')?.status,\n        'fail', 'trust fails')\n    await approveDoctorConfig(r)\n    t.equal((await doctor(r)).code, 0, 'v2 approval passes')\n    const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n    fs.writeFileSync(file, JSON.stringify({ version:1, approved:['old'] }))\n    const legacy = await doctor(r)\n    t.equal(legacy.code, 4, 'legacy fails')\n    const detail = legacy.rows.find(x => x.name === 'config-trust')?.detail\n    t.ok(detail?.includes('older Roast'), 'explains legacy approval')\n    t.ok(detail?.includes('npx roast trust'), 'names approval command')\n    fs.writeFileSync(file, '{')\n    t.equal((await doctor(r)).code, 4, 'malformed approval fails')\n})\n\ntest('doctor diagnoses proxy variables without exposing the URL', async t => {\n    const r = doctorRepo(t)\n    const secret = 'https://user:proxy-secret@example.com:8080'\n    for (const variable of ['HTTPS_PROXY', 'https_proxy']) {\n        r.env[variable] = secret\n        const res = await doctor(r)\n        t.equal(res.code, 0, res.stderr)\n        t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,\n            'warn', variable)\n        t.ok(!res.stdout.includes(secret), 'proxy URL omitted')\n        r.env.NODE_USE_ENV_PROXY = '1'\n        const honored = await doctor(r)\n        t.equal(honored.code, 0, honored.stderr)\n        t.equal(honored.rows.find(row => row.name === 'proxy-env')?.status,\n            'pass', 'proxy enabled')\n        delete r.env[variable]\n        delete r.env.NODE_USE_ENV_PROXY\n    }\n    const res = await doctor(r)\n    t.equal(res.code, 0, res.stderr)\n    t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,\n        'pass', 'no proxy')\n})\n\ntest('doctor probes models with each role protocol and no key in output',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:204 })\n        t.cleanup(server.close)\n        r.env.ROAST_FINDER_API_KEY = 'finder-private-key'\n        r.env.ROAST_VERIFIER_API_KEY = 'verifier-private-key'\n        for (const protocol of ['chat', 'responses', 'anthropic']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{\n                        o:{\n                            model:'m',\n                            protocol,\n                            endpoint:server.url + '/custom/v1///',\n                            session_header:'X-Session',\n                        },\n                    },\n                }))\n            await approveDoctorConfig(r)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, `${protocol} adapter is available`)\n            t.deepEqual(res.rows.filter(x => !x.name.endsWith('-roundtrip'))\n                .slice(4, 10).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'],\n                ['finder-profile', 'pass'],\n                ['finder-endpoint', 'pass'],\n                ['verifier-credential', 'pass'],\n                ['verifier-profile', 'pass'],\n                ['verifier-endpoint', 'pass'],\n            ], 'endpoint checks retain role order')\n            const roundtrips = res.rows.filter(x =>\n                x.name.endsWith('-roundtrip'))\n            t.deepEqual(roundtrips.map(x => x.status), ['pass', 'pass'],\n                'both roundtrips pass')\n            const requests = server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n            t.equal(requests.length, 2, 'one models probe per role')\n            for (const [i, req] of requests.entries()) {\n                const key = i === 0 ? 'finder-private-key' :\n                    'verifier-private-key'\n                t.equal(req.method, 'GET', 'models uses GET')\n                t.equal(req.path, '/custom/v1/models', 'base slashes removed')\n                t.equal(req.rawBody.length, 0, 'no request body')\n                t.equal(req.headers['x-session'], undefined,\n                    'session header is only for inference')\n                t.equal(req.headers.authorization,\n                    protocol === 'anthropic' ? undefined : `Bearer ${key}`,\n                    'bearer authentication for OpenAI protocols')\n                t.equal(req.headers['x-api-key'],\n                    protocol === 'anthropic' ? key : undefined,\n                    'Anthropic authentication')\n                t.equal(req.headers['anthropic-version'],\n                    protocol === 'anthropic' ? '2023-06-01' : undefined,\n                    'Anthropic version')\n            }\n            t.ok(!(res.stdout + res.stderr).includes('finder-private-key'),\n                'finder key omitted from output')\n            t.ok(!(res.stdout + res.stderr).includes('verifier-private-key'),\n                'verifier key omitted from output')\n        }\n    })\n\ntest('doctor classifies models status without disclosing response bodies',\n    async t => {\n        const r = doctorRepo(t)\n        let status = 200\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : {\n                status, body:r.env.ROAST_FINDER_API_KEY,\n            })\n        t.cleanup(server.close)\n        for (const [code, expected] of [\n            [200, 'pass'], [299, 'pass'],\n            [401, 'fail'], [403, 'fail'], [500, 'fail'], [503, 'fail'],\n            [404, 'warn'], [429, 'warn'],\n        ] as const) {\n            status = code\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, expected === 'fail' ? 4 : 0,\n                `HTTP ${code} exit code`)\n            const endpoints = res.rows.filter(x =>\n                x.name.endsWith('-endpoint'))\n            t.deepEqual(endpoints.map(x => x.status), [expected, expected],\n                `HTTP ${code} status for both roles`)\n            t.ok(endpoints.every(x => x.detail.includes(String(code))),\n                'status code in diagnostics')\n            t.ok(!(res.stdout + res.stderr).includes(\n                r.env.ROAST_FINDER_API_KEY), 'body and key omitted')\n        }\n    })\n\ntest('doctor refuses redirects without sending the key to their target',\n    async t => {\n        const r = doctorRepo(t)\n        const target = await startInferenceServer(() => ({ status:200 }))\n        t.cleanup(target.close)\n        let status = 301\n        const source = await startInferenceServer(() => ({\n            status, headers:{ location:target.url + '/stolen' },\n        }))\n        t.cleanup(source.close)\n        for (const code of [301, 302, 303, 307, 308]) {\n            status = code\n            const res = await doctor(r, [], source.url)\n            t.equal(res.code, 4, `HTTP ${code} is an endpoint error`)\n            t.deepEqual(res.rows.filter(x =>\n                x.name.endsWith('-endpoint')).map(x => x.status),\n            ['fail', 'fail'], 'both redirects fail')\n        }\n        t.equal(target.requests.length, 0, 'redirect target never contacted')\n    })\n\ntest('doctor times out a models request and continues',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const deadline = new AbortController()\n        const original = doctorHooks.timeout\n        let first = true\n        doctorHooks.timeout = ms => {\n            if (ms !== 5000 || !first) return original(ms)\n            first = false\n            return deadline.signal\n        }\n        t.cleanup(() => { doctorHooks.timeout = original })\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            if (n > 0) return { status:200 }\n            return () => {\n                deadline.abort(new DOMException('deadline', 'TimeoutError'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 4, 'timeout fails doctor')\n        t.equal(res.rows.find(x => x.name === 'finder-endpoint')?.status,\n            'fail', 'finder request times out')\n        t.ok(res.rows.find(x => x.name === 'finder-endpoint')?.detail\n            .includes('deadline'), 'timeout appears in the diagnostic')\n        t.equal(res.rows.find(x => x.name === 'verifier-endpoint')?.status,\n            'pass', 'verifier still runs')\n    })\n\ntest('doctor preserves probe deadlines for both roles', async t => {\n    const r = doctorRepo(t)\n    const deadlines:number[] = []\n    const original = doctorHooks.timeout\n    doctorHooks.timeout = ms => {\n        deadlines.push(ms)\n        return original(ms)\n    }\n    t.cleanup(() => { doctorHooks.timeout = original })\n    const res = await doctor(r)\n    t.equal(res.code, 0, 'both roles complete their probes')\n    t.deepEqual(deadlines, [5000, 35000, 5000, 35000],\n        'models and roundtrip deadlines remain unchanged')\n})\n\ntest('doctor cancellation closes the pending models request', async t => {\n    const r = doctorRepo(t)\n    const controller = new AbortController()\n    let closed!:() => void\n    const connectionClosed = new Promise<void>(resolve => { closed = resolve })\n    const server = await startInferenceServer(() => res => {\n        res.on('close', closed)\n        controller.abort(new CancelledError())\n    })\n    t.cleanup(server.close)\n    const res = await runRoast(['doctor', '--json'], {\n        cwd:r.dir,\n        env:r.env,\n        redirectTo:server.url,\n        signal:controller.signal,\n    })\n    await connectionClosed\n    t.equal(res.code, 5, 'cancellation exits 5')\n    t.ok(res.stderr.includes('cancelled'), 'cancellation is reported')\n    t.equal(res.stdout, '', 'no partial doctor results are emitted')\n    t.equal(server.requests.length, 1, 'no further probes are sent')\n})\n\ntest('doctor withholds ambient keys from a custom finder independently',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        delete r.env.ROAST_FINDER_API_KEY\n        r.env.OPENAI_API_KEY = 'ambient-key-must-stay-home'\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                custom:{ model:'m', endpoint:'https://gateway.example/v1' },\n                direct:{ model:'m', protocol:'anthropic' },\n            },\n            roles:{\n                finder:{ profile:'custom' }, verifier:{ profile:'direct' },\n            },\n        }))\n        await approveDoctorConfig(r)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 4, 'missing finder key fails doctor')\n        t.deepEqual(res.rows.slice(4, 9).map(x => [x.name, x.status]), [\n            ['finder-credential', 'fail'],\n            ['finder-profile', 'fail'],\n            ['verifier-credential', 'pass'],\n            ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'],\n        ], 'verifier remains independent of finder failure')\n        t.ok(res.rows.find(x => x.name === 'finder-credential')?.detail\n            .includes('OPENAI_API_KEY'), 'names withheld variable')\n        t.ok(!res.rows.some(x => x.name === 'finder-endpoint'),\n            'invalid finder is not probed')\n        t.ok(res.hosts.length > 0 &&\n            res.hosts.every(h => h === 'api.anthropic.com'),\n        'only verifier endpoint contacted')\n        t.ok(server.credentials.length > 0 && server.credentials.every(k =>\n            k === r.env.ROAST_VERIFIER_API_KEY), 'only verifier key sent')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.OPENAI_API_KEY),\n            'withheld key omitted from output')\n    })\n\ntest('doctor reports stored credential scopes through role resolution',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        const user = userCredentialsPath(r.env)\n        for (const [scope, file] of [['project', project], ['user', user]]) {\n            const key = `${scope}-private-key`\n            await saveCredential(file, 'openai', key, new Date())\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, `${scope} stored key works`)\n            const sources = res.rows.filter(x =>\n                x.name.endsWith('-credential'))\n            t.deepEqual(sources.map(x => x.status), ['pass', 'pass'],\n                'both roles find stored credential')\n            t.ok(sources.every(x => x.detail.includes(scope) &&\n                x.detail.includes('openai')), 'scope and provider reported')\n            t.deepEqual(server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n                .map(x => x.headers.authorization),\n            [`Bearer ${key}`, `Bearer ${key}`], 'stored key sent')\n            t.ok(!(res.stdout + res.stderr).includes(key),\n                'stored key omitted from output')\n            fs.unlinkSync(file)\n        }\n    })\n\ntest('doctor skips invalid profiles while retaining later diagnostics',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        for (const model of ['', '<finder-model>']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN, inference_profiles:{ o:{ model } },\n                }))\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 4, 'unusable model fails')\n            t.deepEqual(res.rows.slice(4, 8).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'], ['finder-profile', 'fail'],\n                ['verifier-credential', 'pass'], ['verifier-profile', 'fail'],\n            ], 'validation failure skips endpoint checks')\n        }\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN, roles:{},\n        }))\n        const res = await doctor(r, [], server.url)\n        t.deepEqual(res.rows.slice(4, 6).map(x => [x.name, x.status]), [\n            ['finder-profile', 'fail'], ['verifier-profile', 'fail'],\n        ], 'unconfigured roles produce only failed profiles')\n        t.ok(res.rows.some(x => x.name === 'proxy-env'), 'local checks run')\n        t.equal(server.requests.length, 0, 'no invalid profile is probed')\n    })\n\ntest('doctor makes no requests until custom endpoint trust is current',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:200 })\n        t.cleanup(server.close)\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', endpoint:server.url + '/v1' },\n            },\n        }))\n        const unapproved = await doctor(r, [], server.url)\n        t.equal(unapproved.code, 4, 'unapproved config fails')\n        t.equal(server.requests.length, 0, 'no unapproved requests')\n        t.deepEqual(unapproved.rows.slice(4, 8).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n        ], 'local role checks still run')\n        t.ok(!unapproved.rows.some(x => x.name.endsWith('-endpoint')),\n            'no endpoint rows for untrusted config')\n        const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n        fs.mkdirSync(path.dirname(file), { recursive:true })\n        for (const record of [\n            JSON.stringify({ version:1, approved:['Go-era-approval'] }), '{',\n        ]) {\n            fs.writeFileSync(file, record)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 4, 'unusable trust record fails')\n            t.equal(server.requests.length, 0, 'no requests with bad trust')\n            t.ok(!res.rows.some(x => x.name.endsWith('-endpoint')),\n                'no probes with bad trust')\n        }\n        fs.writeFileSync(file, JSON.stringify({ version:1, approved:[] }))\n        await approveDoctorConfig(r)\n        const approved = await doctor(r, [], server.url)\n        t.equal(approved.code, 0, 'trust --yes permits probes')\n        t.deepEqual(server.requests.filter(x => x.method === 'GET')\n            .map(x => [x.method, x.path]), [\n            ['GET', '/v1/models'], ['GET', '/v1/models'],\n        ], 'approved endpoint probed once per role')\n        t.deepEqual(server.requests.filter(x => x.method === 'GET')\n            .map(x => x.headers.authorization), [\n            'Bearer finder-test-key', 'Bearer verifier-test-key',\n        ], 'approved probes use explicit role credentials')\n    })\n\ntest('doctor bounds models body reads and hides reflected credentials',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            return res => {\n                const key = String(req.headers.authorization).slice(7)\n                res.writeHead(200, key)\n                // The probe must finish after 32 KiB even without an EOF.\n                res.write(Buffer.alloc(32 * 1024, 'x'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, 'large unterminated body does not time out')\n        t.deepEqual(res.rows.filter(x =>\n            x.name.endsWith('-endpoint')).map(x => x.status),\n        ['pass', 'pass'], 'both models requests succeed at the body limit')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_FINDER_API_KEY),\n            'key reflected in status text is redacted')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_VERIFIER_API_KEY),\n            'verifier key reflected in status text is redacted')\n    })\n\ntest('doctor chat roundtrip uses two turns with a stable prefix', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(doctorProbe())\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 0, res.stderr)\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => [x.name, x.status]), [\n        ['finder-roundtrip', 'pass'], ['verifier-roundtrip', 'pass'],\n    ], 'both roles complete the tool loop')\n    t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n    ], 'each endpoint probe is followed by exactly two inference requests')\n})\n\ntest('doctor rejects a guessed token without doctor_lookup', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(() =>\n        probeCall('doctor_probe', { ok:true, token:'roast-doctor-guess' }))\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'guessing does not pass doctor')\n    const rows = res.rows.filter(x => x.name.endsWith('-roundtrip'))\n    t.deepEqual(rows.map(x => x.status), ['fail', 'fail'],\n        'both roles must roundtrip the lookup token')\n    t.ok(rows.every(x => x.detail.includes('doctor_lookup')),\n        'diagnostic identifies the skipped lookup')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 2,\n        'one rejected final answer per role')\n})\n\ntest('doctor rejects a changed lookup token on the final turn', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(req => {\n        const body = req.body as { messages:{ role:string }[] }\n        return body.messages.some(x => x.role === 'tool') ?\n            probeCall('doctor_probe', { ok:true, token:'changed-token' }) :\n            probeCall('doctor_lookup', {})\n    })\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'lookup alone does not prove a roundtrip')\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => x.status), ['fail', 'fail'], 'changed token fails')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 4,\n        'both roles reached the second turn')\n})\n\ntest('doctor sends the configured session header on both chat turns',\n    async t => {\n        const r = doctorRepo(t)\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{\n                    protocol:'chat',\n                    model:'m',\n                    session_header:'X-Doctor-Session',\n                },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, res.stderr)\n        const requests = server.requests.filter(x => x.method === 'POST')\n        t.equal(requests.length, 4, 'two turns per role')\n        const sessions = requests.map(x => x.headers['x-doctor-session'])\n        t.ok(sessions.every(x => typeof x === 'string' &&\n            /^roast-[A-Z2-7]{26}$/.test(x)), 'session IDs sent')\n        t.equal(sessions[0], sessions[1], 'finder session survives replay')\n        t.equal(sessions[2], sessions[3], 'verifier session survives replay')\n        t.ok(sessions[0] !== sessions[2], 'roles use separate sessions')\n        t.ok(server.requests.filter(x => x.method === 'GET').every(x =>\n            x.headers['x-doctor-session'] === undefined),\n        'session header remains absent from models checks')\n    })\n\ntest('doctor emits approved chat diagnostics for an explicit config',\n    async t => {\n        const r = doctorRepo(t)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const secret = 'doctor-key-never-print'\n        r.env.DOCTOR_KEY = secret\n        const file = path.join(r.dir, 'diagnostic.json')\n        fs.writeFileSync(file, JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', api_key_env:'DOCTOR_KEY' },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const approved = await runRoast([\n            'trust', '--yes', '--config', file,\n        ], { cwd:r.dir, env:r.env })\n        t.equal(approved.code, 0, approved.stderr)\n        const res = await doctor(r, ['--config', file], server.url)\n        t.equal(res.code, 0, res.stderr)\n        t.ok(Array.isArray(JSON.parse(res.stdout)) && res.rows.length >= 8,\n            'stdout is a complete JSON result array')\n        t.equal(res.rows.find(x => x.name === 'finder-credential')?.detail,\n            'DOCTOR_KEY (profile api_key_env)', 'names credential source')\n        t.deepEqual(res.rows.slice(4, 12).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['finder-endpoint', 'pass'], ['finder-roundtrip', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'], ['verifier-roundtrip', 'pass'],\n        ], 'role checks and probes remain in specified order')\n        t.ok(!(res.stdout + res.stderr).includes(secret),\n            'secret absent from output')\n        t.ok(server.requests.every(x =>\n            x.headers.authorization === `Bearer ${secret}`),\n        'profile credential reaches both kinds of request')\n    })\n\nfor (const [protocol, endpoint] of [\n    ['responses', '/v1/responses'],\n    ['anthropic', '/v1/messages'],\n] as const) {\n    test(`doctor ${protocol} roundtrip uses two turns with a stable prefix`,\n        async t => {\n            const r = doctorRepo(t)\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{ o:{ protocol, model:'m' } },\n                }))\n            const server = await providerServer(doctorProbe())\n            t.cleanup(server.close)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, res.stderr)\n            t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n                .map(x => [x.name, x.status]), [\n                ['finder-roundtrip', 'pass'],\n                ['verifier-roundtrip', 'pass'],\n            ], 'both roles complete the tool loop')\n            t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n                ['GET', '/v1/models'],\n                ['POST', endpoint],\n                ['POST', endpoint],\n                ['GET', '/v1/models'],\n                ['POST', endpoint],\n                ['POST', endpoint],\n            ], 'each role makes exactly two inference requests')\n        })\n}\n"}],"structuredContent":"import fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'\nimport { runRoast } from '../helpers/run.js'\nimport { saveCredential, projectCredentialsPath, userCredentialsPath }\n    from '../../src/credentials/credentials.js'\nimport { installationTargets, install, skillHooks }\n    from '../../src/skill/skill.js'\nimport { git } from '../../src/git/git.js'\nimport { startInferenceServer } from '../helpers/inference-server.js'\nimport { doctorProbe, probeCall } from '../helpers/doctor-probe.js'\nimport { providerServer } from '../helpers/provider-server.js'\nimport { doctorHooks } from '../../src/cli/doctor.js'\nimport { CancelledError } from '../../src/cli/errors.js'\n\nconst BUILTIN = {\n    version:1,\n    inference_profiles:{ o:{ protocol:'chat', model:'m' } },\n    roles:{ finder:{ profile:'o' }, verifier:{ profile:'o' } },\n}\n\nfunction doctorRepo (t:CleanupTest):TempDir {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    delete r.env.HTTPS_PROXY\n    delete r.env.https_proxy\n    delete r.env.NODE_USE_ENV_PROXY\n    r.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n    r.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n    fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n        JSON.stringify(BUILTIN))\n    return r\n}\n\ninterface Row {\n    name:string;\n    status:string;\n    detail:string;\n}\n\nasync function doctor (\n    r:TempDir,\n    args:string[] = [],\n    redirectTo?:string\n) {\n    const server = redirectTo ? undefined : await providerServer(doctorProbe())\n    try {\n        const res = await runRoast(['doctor', '--json', ...args],\n            { cwd:r.dir, env:r.env, redirectTo:redirectTo ?? server?.url })\n        const rows:Row[] = res.stdout.startsWith('[') ?\n            JSON.parse(res.stdout) : []\n        return { ...res, rows }\n    } finally {\n        await server?.close()\n    }\n}\n\ntest('doctor keeps all local checks after missing or invalid config',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        await saveCredential(project, 'openai', 'secret', new Date())\n        fs.unlinkSync(path.join(r.dir, '.roast.jsonc'))\n        const missing = await doctor(r)\n        t.equal(missing.code, 4, 'missing config fails')\n        t.deepEqual(missing.rows.map(x => x.name), [\n            'build', 'config-file', 'git', 'git-gate',\n            'project-credentials', 'proxy-env', 'agents-skill', 'claude-skill',\n        ], 'local checks remain in order')\n        t.equal(missing.rows[1].status, 'fail', 'config-file failure')\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), '{')\n        const invalid = await doctor(r)\n        t.equal(invalid.code, 4, 'invalid config fails')\n        t.equal(invalid.rows.find(x => x.name === 'config')?.status,\n            'fail', 'config failure')\n        t.ok(invalid.rows.some(x => x.name === 'agents-skill'),\n            'skills still checked')\n        const explicit = await doctor(r, ['--config', 'missing.json'])\n        t.equal(explicit.rows.find(x => x.name === 'config-file')?.status,\n            'pass', 'explicit missing path accepted')\n        t.equal(explicit.rows.find(x => x.name === 'config')?.status,\n            'fail', 'explicit missing file fails loading')\n        fs.writeFileSync(path.join(r.dir, 'custom.json'),\n            JSON.stringify(BUILTIN))\n        const relative = await doctor(r, ['--config', 'custom.json'])\n        t.equal(relative.code, 0, 'relative config uses invocation cwd')\n    })\n\ntest('doctor checks gate health and only user-level skill installations',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const targets = await installationTargets('', '', { env:r.env })\n        await install(targets[0].path, false)\n        await git(r.dir, ['config', '--local', 'roast.gate', 'enabled'],\n            { env:r.env })\n        const res = await doctor(r)\n        t.equal(res.code, 0, 'warnings do not fail')\n        t.equal(res.rows.find(x => x.name === 'git-gate')?.status,\n            'warn', 'enabled but absent gate warns')\n        t.equal(res.rows.find(x => x.name === 'agents-skill')?.status,\n            'pass', 'user install found')\n        fs.writeFileSync(path.join(targets[0].path, 'SKILL.md'), 'stale')\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'warn', 'stale warns')\n        fs.rmSync(targets[0].path, { recursive:true })\n        fs.symlinkSync(r.dir, targets[0].path)\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'pass', 'symlink passes')\n        const outside = tempDir()\n        t.cleanup(outside.remove)\n        outside.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n        outside.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n        fs.writeFileSync(path.join(outside.dir, '.roast.jsonc'),\n            JSON.stringify(BUILTIN))\n        const out = await doctor(outside)\n        t.equal(out.code, 0, 'outside repository only warns')\n        t.equal(out.rows.find(x => x.name === 'git')?.status,\n            'warn', 'git warns')\n        t.ok(!out.rows.some(x => x.name === 'git-gate'), 'gate omitted')\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const text = await runRoast(['doctor'], {\n            cwd:r.dir, env:r.env, redirectTo:server.url,\n        })\n        t.equal(text.code, 0, 'text mode')\n        t.equal(text.stdout.split('\\n').filter(Boolean).length,\n            res.rows.length, 'one text line per result')\n        t.equal((await doctor(r, ['extra'])).code, 2, 'rejects positional')\n    })\n\nexport async function approveDoctorConfig (r:TempDir):Promise<void> {\n    const res = await runRoast(['trust', '--yes'],\n        { cwd:r.dir, env:r.env })\n    if (res.code !== 0) throw new Error(res.stderr)\n}\n\ntest('doctor inspects both stored scopes even with an environment key',\n    async t => {\n        const r = doctorRepo(t)\n        r.env.OPENAI_API_KEY = 'environment-secret'\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        const user = userCredentialsPath(r.env)\n        const secret = 'stored-secret-do-not-print'\n        for (const file of [project, user]) {\n            await saveCredential(file, 'openai', secret, new Date())\n        }\n        const usable = await doctor(r)\n        t.equal(usable.code, 0, usable.stderr)\n        for (const scope of ['project', 'user']) {\n            const row = usable.rows.find(x => x.name ===\n                `${scope}-credentials`)\n            t.equal(row?.status, 'pass', `${scope} reported`)\n            t.ok(row?.detail.includes('(openai)'), 'provider reported')\n        }\n        t.ok(!usable.stdout.includes(secret), 'stored key omitted')\n        for (const [scope, file] of [['project', project], ['user', user]]) {\n            fs.writeFileSync(file, JSON.stringify({\n                version:1, providers:{ openai:{ key:secret } }, bogus:true,\n            }))\n            const broken = await doctor(r)\n            t.equal(broken.code, 4, `${scope} broken fails`)\n            t.equal(broken.rows.find(x => x.name ===\n                `${scope}-credentials`)?.status, 'fail', 'failure row')\n            t.ok(broken.rows.some(x => x.name === 'proxy-env'),\n                'later checks run')\n            t.ok(!(broken.stdout + broken.stderr).includes(secret),\n                'no key in error output')\n            fs.unlinkSync(file)\n        }\n        const absent = await doctor(r)\n        t.equal(absent.code, 0, 'absent files pass')\n        t.ok(!absent.rows.some(x => x.name.endsWith('-credentials')),\n            'absent files omitted')\n    })\n\ntest('doctor never echoes malformed credential JSON', async t => {\n    const r = doctorRepo(t)\n    const file = userCredentialsPath(r.env)\n    const secret = 'leak-key'\n    await saveCredential(file, 'openai', secret, new Date())\n    fs.writeFileSync(file, `{\"key\":${secret}}`)\n    const res = await doctor(r)\n    t.equal(res.code, 4, 'malformed file fails')\n    t.equal(res.rows.find(x => x.name === 'user-credentials')?.status,\n        'fail', 'scope reports failure')\n    t.ok(!(res.stdout + res.stderr).includes(secret),\n        'JSON parser context must not expose a key')\n})\n\ntest('doctor requires clone approval for custom endpoints', async t => {\n    const r = doctorRepo(t)\n    t.equal((await doctor(r)).rows.find(x =>\n        x.name === 'config-trust')?.status, 'pass', 'built-in needs none')\n    fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n        ...BUILTIN,\n        inference_profiles:{\n            o:{\n                protocol:'chat',\n                model:'m',\n                endpoint:'https://gateway.example/v1',\n            },\n        },\n    }))\n    const unapproved = await doctor(r)\n    t.equal(unapproved.code, 4, 'unapproved fails')\n    t.equal(unapproved.rows.find(x => x.name === 'config-trust')?.status,\n        'fail', 'trust fails')\n    await approveDoctorConfig(r)\n    t.equal((await doctor(r)).code, 0, 'v2 approval passes')\n    const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n    fs.writeFileSync(file, JSON.stringify({ version:1, approved:['old'] }))\n    const legacy = await doctor(r)\n    t.equal(legacy.code, 4, 'legacy fails')\n    const detail = legacy.rows.find(x => x.name === 'config-trust')?.detail\n    t.ok(detail?.includes('older Roast'), 'explains legacy approval')\n    t.ok(detail?.includes('npx roast trust'), 'names approval command')\n    fs.writeFileSync(file, '{')\n    t.equal((await doctor(r)).code, 4, 'malformed approval fails')\n})\n\ntest('doctor diagnoses proxy variables without exposing the URL', async t => {\n    const r = doctorRepo(t)\n    const secret = 'https://user:proxy-secret@example.com:8080'\n    for (const variable of ['HTTPS_PROXY', 'https_proxy']) {\n        r.env[variable] = secret\n        const res = await doctor(r)\n        t.equal(res.code, 0, res.stderr)\n        t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,\n            'warn', variable)\n        t.ok(!res.stdout.includes(secret), 'proxy URL omitted')\n        r.env.NODE_USE_ENV_PROXY = '1'\n        const honored = await doctor(r)\n        t.equal(honored.code, 0, honored.stderr)\n        t.equal(honored.rows.find(row => row.name === 'proxy-env')?.status,\n            'pass', 'proxy enabled')\n        delete r.env[variable]\n        delete r.env.NODE_USE_ENV_PROXY\n    }\n    const res = await doctor(r)\n    t.equal(res.code, 0, res.stderr)\n    t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,\n        'pass', 'no proxy')\n})\n\ntest('doctor probes models with each role protocol and no key in output',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:204 })\n        t.cleanup(server.close)\n        r.env.ROAST_FINDER_API_KEY = 'finder-private-key'\n        r.env.ROAST_VERIFIER_API_KEY = 'verifier-private-key'\n        for (const protocol of ['chat', 'responses', 'anthropic']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{\n                        o:{\n                            model:'m',\n                            protocol,\n                            endpoint:server.url + '/custom/v1///',\n                            session_header:'X-Session',\n                        },\n                    },\n                }))\n            await approveDoctorConfig(r)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, `${protocol} adapter is available`)\n            t.deepEqual(res.rows.filter(x => !x.name.endsWith('-roundtrip'))\n                .slice(4, 10).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'],\n                ['finder-profile', 'pass'],\n                ['finder-endpoint', 'pass'],\n                ['verifier-credential', 'pass'],\n                ['verifier-profile', 'pass'],\n                ['verifier-endpoint', 'pass'],\n            ], 'endpoint checks retain role order')\n            const roundtrips = res.rows.filter(x =>\n                x.name.endsWith('-roundtrip'))\n            t.deepEqual(roundtrips.map(x => x.status), ['pass', 'pass'],\n                'both roundtrips pass')\n            const requests = server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n            t.equal(requests.length, 2, 'one models probe per role')\n            for (const [i, req] of requests.entries()) {\n                const key = i === 0 ? 'finder-private-key' :\n                    'verifier-private-key'\n                t.equal(req.method, 'GET', 'models uses GET')\n                t.equal(req.path, '/custom/v1/models', 'base slashes removed')\n                t.equal(req.rawBody.length, 0, 'no request body')\n                t.equal(req.headers['x-session'], undefined,\n                    'session header is only for inference')\n                t.equal(req.headers.authorization,\n                    protocol === 'anthropic' ? undefined : `Bearer ${key}`,\n                    'bearer authentication for OpenAI protocols')\n                t.equal(req.headers['x-api-key'],\n                    protocol === 'anthropic' ? key : undefined,\n                    'Anthropic authentication')\n                t.equal(req.headers['anthropic-version'],\n                    protocol === 'anthropic' ? '2023-06-01' : undefined,\n                    'Anthropic version')\n            }\n            t.ok(!(res.stdout + res.stderr).includes('finder-private-key'),\n                'finder key omitted from output')\n            t.ok(!(res.stdout + res.stderr).includes('verifier-private-key'),\n                'verifier key omitted from output')\n        }\n    })\n\ntest('doctor classifies models status without disclosing response bodies',\n    async t => {\n        const r = doctorRepo(t)\n        let status = 200\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : {\n                status, body:r.env.ROAST_FINDER_API_KEY,\n            })\n        t.cleanup(server.close)\n        for (const [code, expected] of [\n            [200, 'pass'], [299, 'pass'],\n            [401, 'fail'], [403, 'fail'], [500, 'fail'], [503, 'fail'],\n            [404, 'warn'], [429, 'warn'],\n        ] as const) {\n            status = code\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, expected === 'fail' ? 4 : 0,\n                `HTTP ${code} exit code`)\n            const endpoints = res.rows.filter(x =>\n                x.name.endsWith('-endpoint'))\n            t.deepEqual(endpoints.map(x => x.status), [expected, expected],\n                `HTTP ${code} status for both roles`)\n            t.ok(endpoints.every(x => x.detail.includes(String(code))),\n                'status code in diagnostics')\n            t.ok(!(res.stdout + res.stderr).includes(\n                r.env.ROAST_FINDER_API_KEY), 'body and key omitted')\n        }\n    })\n\ntest('doctor refuses redirects without sending the key to their target',\n    async t => {\n        const r = doctorRepo(t)\n        const target = await startInferenceServer(() => ({ status:200 }))\n        t.cleanup(target.close)\n        let status = 301\n        const source = await startInferenceServer(() => ({\n            status, headers:{ location:target.url + '/stolen' },\n        }))\n        t.cleanup(source.close)\n        for (const code of [301, 302, 303, 307, 308]) {\n            status = code\n            const res = await doctor(r, [], source.url)\n            t.equal(res.code, 4, `HTTP ${code} is an endpoint error`)\n            t.deepEqual(res.rows.filter(x =>\n                x.name.endsWith('-endpoint')).map(x => x.status),\n            ['fail', 'fail'], 'both redirects fail')\n        }\n        t.equal(target.requests.length, 0, 'redirect target never contacted')\n    })\n\ntest('doctor times out a models request and continues',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const deadline = new AbortController()\n        const original = doctorHooks.timeout\n        let first = true\n        doctorHooks.timeout = ms => {\n            if (ms !== 5000 || !first) return original(ms)\n            first = false\n            return deadline.signal\n        }\n        t.cleanup(() => { doctorHooks.timeout = original })\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            if (n > 0) return { status:200 }\n            return () => {\n                deadline.abort(new DOMException('deadline', 'TimeoutError'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 4, 'timeout fails doctor')\n        t.equal(res.rows.find(x => x.name === 'finder-endpoint')?.status,\n            'fail', 'finder request times out')\n        t.ok(res.rows.find(x => x.name === 'finder-endpoint')?.detail\n            .includes('deadline'), 'timeout appears in the diagnostic')\n        t.equal(res.rows.find(x => x.name === 'verifier-endpoint')?.status,\n            'pass', 'verifier still runs')\n    })\n\ntest('doctor preserves probe deadlines for both roles', async t => {\n    const r = doctorRepo(t)\n    const deadlines:number[] = []\n    const original = doctorHooks.timeout\n    doctorHooks.timeout = ms => {\n        deadlines.push(ms)\n        return original(ms)\n    }\n    t.cleanup(() => { doctorHooks.timeout = original })\n    const res = await doctor(r)\n    t.equal(res.code, 0, 'both roles complete their probes')\n    t.deepEqual(deadlines, [5000, 35000, 5000, 35000],\n        'models and roundtrip deadlines remain unchanged')\n})\n\ntest('doctor cancellation closes the pending models request', async t => {\n    const r = doctorRepo(t)\n    const controller = new AbortController()\n    let closed!:() => void\n    const connectionClosed = new Promise<void>(resolve => { closed = resolve })\n    const server = await startInferenceServer(() => res => {\n        res.on('close', closed)\n        controller.abort(new CancelledError())\n    })\n    t.cleanup(server.close)\n    const res = await runRoast(['doctor', '--json'], {\n        cwd:r.dir,\n        env:r.env,\n        redirectTo:server.url,\n        signal:controller.signal,\n    })\n    await connectionClosed\n    t.equal(res.code, 5, 'cancellation exits 5')\n    t.ok(res.stderr.includes('cancelled'), 'cancellation is reported')\n    t.equal(res.stdout, '', 'no partial doctor results are emitted')\n    t.equal(server.requests.length, 1, 'no further probes are sent')\n})\n\ntest('doctor withholds ambient keys from a custom finder independently',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        delete r.env.ROAST_FINDER_API_KEY\n        r.env.OPENAI_API_KEY = 'ambient-key-must-stay-home'\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                custom:{ model:'m', endpoint:'https://gateway.example/v1' },\n                direct:{ model:'m', protocol:'anthropic' },\n            },\n            roles:{\n                finder:{ profile:'custom' }, verifier:{ profile:'direct' },\n            },\n        }))\n        await approveDoctorConfig(r)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 4, 'missing finder key fails doctor')\n        t.deepEqual(res.rows.slice(4, 9).map(x => [x.name, x.status]), [\n            ['finder-credential', 'fail'],\n            ['finder-profile', 'fail'],\n            ['verifier-credential', 'pass'],\n            ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'],\n        ], 'verifier remains independent of finder failure')\n        t.ok(res.rows.find(x => x.name === 'finder-credential')?.detail\n            .includes('OPENAI_API_KEY'), 'names withheld variable')\n        t.ok(!res.rows.some(x => x.name === 'finder-endpoint'),\n            'invalid finder is not probed')\n        t.ok(res.hosts.length > 0 &&\n            res.hosts.every(h => h === 'api.anthropic.com'),\n        'only verifier endpoint contacted')\n        t.ok(server.credentials.length > 0 && server.credentials.every(k =>\n            k === r.env.ROAST_VERIFIER_API_KEY), 'only verifier key sent')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.OPENAI_API_KEY),\n            'withheld key omitted from output')\n    })\n\ntest('doctor reports stored credential scopes through role resolution',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        const user = userCredentialsPath(r.env)\n        for (const [scope, file] of [['project', project], ['user', user]]) {\n            const key = `${scope}-private-key`\n            await saveCredential(file, 'openai', key, new Date())\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, `${scope} stored key works`)\n            const sources = res.rows.filter(x =>\n                x.name.endsWith('-credential'))\n            t.deepEqual(sources.map(x => x.status), ['pass', 'pass'],\n                'both roles find stored credential')\n            t.ok(sources.every(x => x.detail.includes(scope) &&\n                x.detail.includes('openai')), 'scope and provider reported')\n            t.deepEqual(server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n                .map(x => x.headers.authorization),\n            [`Bearer ${key}`, `Bearer ${key}`], 'stored key sent')\n            t.ok(!(res.stdout + res.stderr).includes(key),\n                'stored key omitted from output')\n            fs.unlinkSync(file)\n        }\n    })\n\ntest('doctor skips invalid profiles while retaining later diagnostics',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        for (const model of ['', '<finder-model>']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN, inference_profiles:{ o:{ model } },\n                }))\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 4, 'unusable model fails')\n            t.deepEqual(res.rows.slice(4, 8).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'], ['finder-profile', 'fail'],\n                ['verifier-credential', 'pass'], ['verifier-profile', 'fail'],\n            ], 'validation failure skips endpoint checks')\n        }\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN, roles:{},\n        }))\n        const res = await doctor(r, [], server.url)\n        t.deepEqual(res.rows.slice(4, 6).map(x => [x.name, x.status]), [\n            ['finder-profile', 'fail'], ['verifier-profile', 'fail'],\n        ], 'unconfigured roles produce only failed profiles')\n        t.ok(res.rows.some(x => x.name === 'proxy-env'), 'local checks run')\n        t.equal(server.requests.length, 0, 'no invalid profile is probed')\n    })\n\ntest('doctor makes no requests until custom endpoint trust is current',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:200 })\n        t.cleanup(server.close)\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', endpoint:server.url + '/v1' },\n            },\n        }))\n        const unapproved = await doctor(r, [], server.url)\n        t.equal(unapproved.code, 4, 'unapproved config fails')\n        t.equal(server.requests.length, 0, 'no unapproved requests')\n        t.deepEqual(unapproved.rows.slice(4, 8).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n        ], 'local role checks still run')\n        t.ok(!unapproved.rows.some(x => x.name.endsWith('-endpoint')),\n            'no endpoint rows for untrusted config')\n        const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n        fs.mkdirSync(path.dirname(file), { recursive:true })\n        for (const record of [\n            JSON.stringify({ version:1, approved:['Go-era-approval'] }), '{',\n        ]) {\n            fs.writeFileSync(file, record)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 4, 'unusable trust record fails')\n            t.equal(server.requests.length, 0, 'no requests with bad trust')\n            t.ok(!res.rows.some(x => x.name.endsWith('-endpoint')),\n                'no probes with bad trust')\n        }\n        fs.writeFileSync(file, JSON.stringify({ version:1, approved:[] }))\n        await approveDoctorConfig(r)\n        const approved = await doctor(r, [], server.url)\n        t.equal(approved.code, 0, 'trust --yes permits probes')\n        t.deepEqual(server.requests.filter(x => x.method === 'GET')\n            .map(x => [x.method, x.path]), [\n            ['GET', '/v1/models'], ['GET', '/v1/models'],\n        ], 'approved endpoint probed once per role')\n        t.deepEqual(server.requests.filter(x => x.method === 'GET')\n            .map(x => x.headers.authorization), [\n            'Bearer finder-test-key', 'Bearer verifier-test-key',\n        ], 'approved probes use explicit role credentials')\n    })\n\ntest('doctor bounds models body reads and hides reflected credentials',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            return res => {\n                const key = String(req.headers.authorization).slice(7)\n                res.writeHead(200, key)\n                // The probe must finish after 32 KiB even without an EOF.\n                res.write(Buffer.alloc(32 * 1024, 'x'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, 'large unterminated body does not time out')\n        t.deepEqual(res.rows.filter(x =>\n            x.name.endsWith('-endpoint')).map(x => x.status),\n        ['pass', 'pass'], 'both models requests succeed at the body limit')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_FINDER_API_KEY),\n            'key reflected in status text is redacted')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_VERIFIER_API_KEY),\n            'verifier key reflected in status text is redacted')\n    })\n\ntest('doctor chat roundtrip uses two turns with a stable prefix', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(doctorProbe())\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 0, res.stderr)\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => [x.name, x.status]), [\n        ['finder-roundtrip', 'pass'], ['verifier-roundtrip', 'pass'],\n    ], 'both roles complete the tool loop')\n    t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n    ], 'each endpoint probe is followed by exactly two inference requests')\n})\n\ntest('doctor rejects a guessed token without doctor_lookup', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(() =>\n        probeCall('doctor_probe', { ok:true, token:'roast-doctor-guess' }))\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'guessing does not pass doctor')\n    const rows = res.rows.filter(x => x.name.endsWith('-roundtrip'))\n    t.deepEqual(rows.map(x => x.status), ['fail', 'fail'],\n        'both roles must roundtrip the lookup token')\n    t.ok(rows.every(x => x.detail.includes('doctor_lookup')),\n        'diagnostic identifies the skipped lookup')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 2,\n        'one rejected final answer per role')\n})\n\ntest('doctor rejects a changed lookup token on the final turn', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(req => {\n        const body = req.body as { messages:{ role:string }[] }\n        return body.messages.some(x => x.role === 'tool') ?\n            probeCall('doctor_probe', { ok:true, token:'changed-token' }) :\n            probeCall('doctor_lookup', {})\n    })\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'lookup alone does not prove a roundtrip')\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => x.status), ['fail', 'fail'], 'changed token fails')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 4,\n        'both roles reached the second turn')\n})\n\ntest('doctor sends the configured session header on both chat turns',\n    async t => {\n        const r = doctorRepo(t)\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{\n                    protocol:'chat',\n                    model:'m',\n                    session_header:'X-Doctor-Session',\n                },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, res.stderr)\n        const requests = server.requests.filter(x => x.method === 'POST')\n        t.equal(requests.length, 4, 'two turns per role')\n        const sessions = requests.map(x => x.headers['x-doctor-session'])\n        t.ok(sessions.every(x => typeof x === 'string' &&\n            /^roast-[A-Z2-7]{26}$/.test(x)), 'session IDs sent')\n        t.equal(sessions[0], sessions[1], 'finder session survives replay')\n        t.equal(sessions[2], sessions[3], 'verifier session survives replay')\n        t.ok(sessions[0] !== sessions[2], 'roles use separate sessions')\n        t.ok(server.requests.filter(x => x.method === 'GET').every(x =>\n            x.headers['x-doctor-session'] === undefined),\n        'session header remains absent from models checks')\n    })\n\ntest('doctor emits approved chat diagnostics for an explicit config',\n    async t => {\n        const r = doctorRepo(t)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const secret = 'doctor-key-never-print'\n        r.env.DOCTOR_KEY = secret\n        const file = path.join(r.dir, 'diagnostic.json')\n        fs.writeFileSync(file, JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', api_key_env:'DOCTOR_KEY' },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const approved = await runRoast([\n            'trust', '--yes', '--config', file,\n        ], { cwd:r.dir, env:r.env })\n        t.equal(approved.code, 0, approved.stderr)\n        const res = await doctor(r, ['--config', file], server.url)\n        t.equal(res.code, 0, res.stderr)\n        t.ok(Array.isArray(JSON.parse(res.stdout)) && res.rows.length >= 8,\n            'stdout is a complete JSON result array')\n        t.equal(res.rows.find(x => x.name === 'finder-credential')?.detail,\n            'DOCTOR_KEY (profile api_key_env)', 'names credential source')\n        t.deepEqual(res.rows.slice(4, 12).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['finder-endpoint', 'pass'], ['finder-roundtrip', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'], ['verifier-roundtrip', 'pass'],\n        ], 'role checks and probes remain in specified order')\n        t.ok(!(res.stdout + res.stderr).includes(secret),\n            'secret absent from output')\n        t.ok(server.requests.every(x =>\n            x.headers.authorization === `Bearer ${secret}`),\n        'profile credential reaches both kinds of request')\n    })\n\nfor (const [protocol, endpoint] of [\n    ['responses', '/v1/responses'],\n    ['anthropic', '/v1/messages'],\n] as const) {\n    test(`doctor ${protocol} roundtrip uses two turns with a stable prefix`,\n        async t => {\n            const r = doctorRepo(t)\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{ o:{ protocol, model:'m' } },\n                }))\n            const server = await providerServer(doctorProbe())\n            t.cleanup(server.close)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, res.stderr)\n            t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n                .map(x => [x.name, x.status]), [\n                ['finder-roundtrip', 'pass'],\n                ['verifier-roundtrip', 'pass'],\n            ], 'both roles complete the tool loop')\n            t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n                ['GET', '/v1/models'],\n                ['POST', endpoint],\n                ['POST', endpoint],\n                ['GET', '/v1/models'],\n                ['POST', endpoint],\n                ['POST', endpoint],\n            ], 'each role makes exactly two inference requests')\n        })\n}\n"},"isError":false,"durationMs":10}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"7WDEPH3qbHzOY4nDxsRm7QgEBixRVzT9","toolName":"read","content":[{"type":"text","text":"// pattern: Imperative Shell\n// Sequential setup diagnostics, with network probes gated by clone trust.\nimport { buildInfo, formatBuildInfo } from '../buildinfo.js'\nimport path from 'node:path'\nimport { z } from 'zod'\nimport { createClient, createModelClient } from '../llm/client.js'\nimport { hasSentinel } from '../llm/errors.js'\nimport { newSessionId } from '../llm/session.js'\nimport { loadProjectConfig, projectConfigPath, NO_PROJECT_CONFIG }\n    from './config.js'\nimport { trustProjection, requiresApproval, trustHash }\n    from '../config/trust.js'\nimport { isApproved } from '../trust/trust.js'\nimport { gitRoot } from '../git/git.js'\nimport type { ProjectConfig } from '../config/load.js'\nimport {\n    resolveRole, validateRole, type RoleName, type ResolvedRole,\n} from '../config/role.js'\nimport { describeSource } from '../config/credential.js'\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport { abortable } from '../llm/capture.js'\nimport { lstat } from 'node:fs/promises'\nimport { openCredentialStore, loadCredentials }\n    from '../credentials/credentials.js'\nimport { inspect as inspectGate, summary, isActive } from '../gate/hook.js'\nimport {\n    inspect as inspectSkill, installationTargets,\n    type InstallationTarget\n} from '../skill/skill.js'\nimport type { CommandDef, RunContext } from './command.js'\n\nexport type DoctorStatus = 'pass'|'warn'|'fail'\n\nexport interface DoctorResult {\n    name:string;\n    status:DoctorStatus;\n    detail:string;\n}\n\nexport const doctorHooks = {\n    timeout:(ms:number):AbortSignal => AbortSignal.timeout(ms),\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nasync function doctorTrustCheck (\n    cfg:ProjectConfig,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const projection = trustProjection(cfg)\n    const name = 'config-trust'\n    if (!requiresApproval(projection)) {\n        return {\n            name,\n            status:'pass',\n            detail:'no approval required ' +\n                '(default provider endpoints and key variables only)'\n        }\n    }\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, ctx)\n    } catch {\n        return {\n            name,\n            status:'fail',\n            detail:'approval required but not ' +\n                'granted: not inside a Git repository'\n        }\n    }\n    try {\n        const state = await isApproved(repo, trustHash(projection), ctx)\n        if (state === 'approved') {\n            return {\n                name,\n                status:'pass',\n                detail:'approval required and ' +\n                    'granted for this clone'\n            }\n        }\n        const why = state === 'legacy' ?\n            'approval required; approved by an older Roast' :\n            'approval required and not granted'\n        return {\n            name,\n            status:'fail',\n            detail:why +\n                '; endpoint probes skipped; run `npx roast trust`'\n        }\n    } catch (err) {\n        return {\n            name,\n            status:'fail',\n            detail:'approval required; could ' +\n                `not read approvals: ${message(err)}`\n        }\n    }\n}\n\nasync function discardModelsBody (\n    response:Response,\n    signal:AbortSignal\n):Promise<void> {\n    if (!response.body) return\n    const reader = response.body.getReader()\n    let size = 0\n    try {\n        while (size < 32 * 1024) {\n            const chunk = await abortable(reader.read(), signal)\n            if (chunk.done) return\n            size += chunk.value.byteLength\n        }\n    } finally {\n        await reader.cancel().catch(() => {})\n        reader.releaseLock()\n    }\n}\n\nexport async function doctorEndpointCheck (\n    name:RoleName,\n    resolved:ResolvedRole,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const url = resolved.baseURL.replace(/\\/+$/, '') + '/models'\n    const result:DoctorResult = {\n        name:`${name}-endpoint`, status:'fail', detail:'',\n    }\n    if (!URL.canParse(url)) {\n        return { ...result, detail:'invalid models endpoint: invalid URL' }\n    }\n    const signal = AbortSignal.any([\n        ctx.signal, doctorHooks.timeout(5000),\n    ])\n    try {\n        const response = await ctx.fetch(url, {\n            method:'GET',\n            redirect:'manual',\n            signal,\n            headers:resolved.protocol === 'anthropic' ? {\n                'x-api-key':resolved.apiKey,\n                'anthropic-version':'2023-06-01',\n            } : { Authorization:`Bearer ${resolved.apiKey}` },\n        })\n        await discardModelsBody(response, signal)\n        const status = `HTTP ${response.status} ${response.statusText}`.trim()\n        if (response.ok) {\n            result.status = 'pass'\n            result.detail = `GET ${url}: ${status}`\n        } else if (response.status >= 300 && response.status < 400) {\n            result.detail = `GET ${url}: redirect refused (${status})`\n        } else if (response.status === 401 || response.status === 403) {\n            result.detail = `credential rejected by ${url}: ${status}`\n        } else if (response.status >= 500) {\n            result.detail = `${url} returned ${status}`\n        } else {\n            result.status = 'warn'\n            result.detail = 'endpoint is reachable but model listing ' +\n                `returned ${status}`\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = `GET ${url}: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nconst probeResult = z.object({ ok:z.boolean(), token:z.string() })\n\nexport async function doctorRoundtripCheck (\n    name:RoleName,\n    resolved:ResolvedRole,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const result:DoctorResult = {\n        name:`${name}-roundtrip`, status:'fail', detail:'',\n    }\n    const signal = AbortSignal.any([\n        ctx.signal, doctorHooks.timeout(35000),\n    ])\n    try {\n        const protocol = resolved.protocol\n        if (protocol !== 'chat' && protocol !== 'responses' &&\n            protocol !== 'anthropic') {\n            throw new Error(`unsupported inference protocol \"${protocol}\"`)\n        }\n        const limit = resolved.maxOutputTokens\n        const client = createClient(createModelClient({\n            role:name,\n            baseUrl:resolved.baseURL,\n            apiKey:resolved.apiKey,\n            model:resolved.model,\n            protocol,\n            maxOutputTokens:limit > 0 && limit <= 512 ? limit : 512,\n            sessionHeader:resolved.sessionHeader,\n            maxAttempts:1,\n            requestTimeoutMs:15000,\n            fetch:ctx.fetch,\n        }))\n        const token = `roast-doctor-${newSessionId().slice(6)}`\n        let looked = false\n        const output = await client.converse(\n            'This is a connectivity check. Call doctor_lookup once, then ' +\n                'call doctor_probe with ok=true and the token ' +\n                'doctor_lookup returned.',\n            'Run the check now.', {\n                tools:[{\n                    name:'doctor_lookup',\n                    description:'Return the diagnostic token.',\n                    schema:{\n                        type:'object',\n                        properties:{},\n                        additionalProperties:false,\n                    },\n                    run:() => {\n                        looked = true\n                        return { token }\n                    },\n                }, {\n                    name:'doctor_probe',\n                    description:'Return the diagnostic result.',\n                    schema:{\n                        type:'object',\n                        properties:{\n                            ok:{ type:'boolean' }, token:{ type:'string' },\n                        },\n                        required:['ok', 'token'],\n                        additionalProperties:false,\n                    },\n                }],\n                finalTool:'doctor_probe',\n                final:{ decode:value => probeResult.parse(value) },\n                maxTurns:2,\n            }, signal)\n        if (!output.ok) {\n            result.detail = 'doctor_probe returned ok=false'\n        } else if (!looked || output.token !== token) {\n            result.detail = 'doctor_probe did not return the token from ' +\n                'doctor_lookup; the tool result did not round-trip'\n        } else {\n            result.status = 'pass'\n            result.detail = `${resolved.model} via ${resolved.protocol} ` +\n                '(two-turn tool loop)'\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = hasSentinel(err, 'auth') ?\n            'credential rejected by the configured inference route' :\n            `${resolved.protocol}/${resolved.model} two-turn tool probe ` +\n                `failed: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nasync function doctorRoleChecks (\n    cfg:ProjectConfig,\n    trusted:boolean,\n    ctx:RunContext\n):Promise<DoctorResult[]> {\n    const results:DoctorResult[] = []\n    for (const name of ['finder', 'verifier'] as const) {\n        let resolved:ResolvedRole\n        try {\n            resolved = resolveRole(cfg, name, ctx.env)\n        } catch (err) {\n            results.push({\n                name:`${name}-profile`, status:'fail', detail:message(err),\n            })\n            continue\n        }\n        const source = describeSource(resolved.credential)\n        results.push({\n            name:`${name}-credential`,\n            status:goTrimSpace(resolved.apiKey) ? 'pass' : 'fail',\n            detail:source,\n        })\n        try {\n            validateRole(name, resolved)\n        } catch (err) {\n            results.push({\n                name:`${name}-profile`, status:'fail', detail:message(err),\n            })\n            continue\n        }\n        results.push({\n            name:`${name}-profile`,\n            status:'pass',\n            detail:`${resolved.profile}: ${resolved.model} via ` +\n                `${resolved.protocol} at ${resolved.baseURL} with ` +\n                `credential ${source}` + (resolved.sessionHeader ?\n                `, session header ${resolved.sessionHeader}` : ''),\n        })\n        if (!trusted) continue\n        results.push(await doctorEndpointCheck(name, resolved, ctx))\n        results.push(await doctorRoundtripCheck(name, resolved, ctx))\n    }\n    return results\n}\n\nexport async function doctorChecks (\n    explicit:string,\n    ctx:RunContext\n):Promise<DoctorResult[]> {\n    const results:DoctorResult[] = [{\n        name:'build',\n        status:buildInfo.version === 'dev' ? 'warn' : 'pass',\n        detail:formatBuildInfo(buildInfo) +\n            (buildInfo.version === 'dev' ? '; development build' : ''),\n    }]\n    let file = ''\n    try {\n        file = await projectConfigPath(explicit, ctx)\n        if (!file) throw new Error(NO_PROJECT_CONFIG)\n        results.push({ name:'config-file', status:'pass', detail:file })\n    } catch (err) {\n        results.push({\n            name:'config-file',\n            status:'fail',\n            detail:message(err)\n        })\n    }\n    let cfg:ProjectConfig|undefined\n    if (file) {\n        try {\n            cfg = await loadProjectConfig(path.resolve(ctx.cwd, file), ctx)\n            results.push({\n                name:'config',\n                status:'pass',\n                detail:`schema version ${cfg.version}`\n            })\n        } catch (err) {\n            results.push({\n                name:'config',\n                status:'fail',\n                detail:message(err)\n            })\n        }\n    }\n    if (cfg) {\n        const trust = await doctorTrustCheck(cfg, ctx)\n        results.push(trust)\n        results.push(...await doctorRoleChecks(cfg,\n            trust.status === 'pass', ctx))\n    }\n    let repo = ''\n    try {\n        repo = await gitRoot(ctx.cwd, ctx)\n        results.push({ name:'git', status:'pass', detail:repo })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        results.push({\n            name:'git',\n            status:'warn',\n            detail:'not inside a Git repository'\n        })\n    }\n    if (repo) {\n        try {\n            const gate = await inspectGate(repo, ctx.env)\n            results.push({\n                name:'git-gate',\n                status:gate.stale ||\n                    (gate.decision === 'enabled' && !isActive(gate)) ?\n                    'warn' : 'pass',\n                detail:summary(gate)\n            })\n        } catch (err) {\n            results.push({\n                name:'git-gate',\n                status:'warn',\n                detail:message(err)\n            })\n        }\n    }\n    const store = await openCredentialStore(ctx.cwd, ctx.env, ctx)\n    for (const scope of ['project', 'user'] as const) {\n        const file = store.paths[scope]\n        if (!file) continue\n        try {\n            await lstat(file)\n        } catch (err) {\n            if ((err as NodeJS.ErrnoException).code === 'ENOENT') continue\n            // Let the credential loader report other filesystem errors.\n        }\n        const name = `${scope}-credentials`\n        try {\n            const entries = await loadCredentials(file)\n            const providers = [...entries.keys()].sort().join(', ')\n            results.push({\n                name,\n                status:'pass',\n                detail:`${file} (${providers || 'none stored'})`\n            })\n        } catch (err) {\n            results.push({ name, status:'fail', detail:message(err) })\n        }\n    }\n    const variable = ctx.env.HTTPS_PROXY ? 'HTTPS_PROXY' :\n        ctx.env.https_proxy ? 'https_proxy' : ''\n    const honored = ctx.env.NODE_USE_ENV_PROXY === '1'\n    results.push({\n        name:'proxy-env',\n        status:variable && !honored ? 'warn' : 'pass',\n        detail:!variable ? 'no proxy configured' : honored ?\n            'proxy variables honored (NODE_USE_ENV_PROXY=1)' :\n            `${variable} is set but NODE_USE_ENV_PROXY is not; ` +\n                'Node ignores proxy variables unless NODE_USE_ENV_PROXY=1',\n    })\n    let targets:InstallationTarget[] = []\n    try {\n        targets = await installationTargets('', '', { env:ctx.env })\n    } catch (err) {\n        results.push({\n            name:'agent-skills',\n            status:'warn',\n            detail:message(err)\n        })\n    }\n    for (const target of targets) {\n        const name = `${target.harness}-skill`\n        try {\n            const skill = await inspectSkill(target.path)\n            switch (skill.state) {\n                case 'not_installed':\n                    results.push({\n                        name,\n                        status:'warn',\n                        detail:'not installed; run ' +\n                            '`roast skill install --global`'\n                    })\n                    break\n                case 'stale':\n                    results.push({\n                        name,\n                        status:'warn',\n                        detail:'stale; run ' +\n                            '`roast skill install --global --force`'\n                    })\n                    break\n                default:\n                    results.push({\n                        name,\n                        status:'pass',\n                        detail:target.path +\n                            (skill.state === 'symlink' ?\n                                ' (development symlink)' : '')\n                    })\n            }\n        } catch (err) {\n            results.push({ name, status:'warn', detail:message(err) })\n        }\n    }\n    return results\n}\n\nexport const doctorCommand:CommandDef = {\n    command:'doctor',\n    describe:'Check configuration, providers, and local integration',\n    builder:y => y\n        .option('config', {\n            type:'string',\n            default:'',\n            describe:'project config file (default: nearest .roast.jsonc ' +\n                'up to the Git toplevel)',\n        })\n        .option('json', {\n            type:'boolean', default:false, describe:'emit a JSON array',\n        }),\n    async handler (args, ctx) {\n        const results = await doctorChecks(String(args.config), ctx)\n        if (args.json) {\n            ctx.stdout.write(JSON.stringify(results, null, 2) + '\\n')\n        } else {\n            for (const result of results) {\n                ctx.stdout.write(result.status.toUpperCase().padEnd(5) +\n                    ` ${result.name.padEnd(18)} ${result.detail}\\n`)\n            }\n        }\n        if (results.some(result => result.status === 'fail')) {\n            throw new Error('one or more doctor checks failed')\n        }\n    },\n}\n"}],"isError":false,"durationMs":10,"timestamp":1795668128068}}
{"type":"message_end","message":{"role":"toolResult","toolCallId":"7WDEPH3qbHzOY4nDxsRm7QgEBixRVzT9","toolName":"read","content":[{"type":"text","text":"// pattern: Imperative Shell\n// Sequential setup diagnostics, with network probes gated by clone trust.\nimport { buildInfo, formatBuildInfo } from '../buildinfo.js'\nimport path from 'node:path'\nimport { z } from 'zod'\nimport { createClient, createModelClient } from '../llm/client.js'\nimport { hasSentinel } from '../llm/errors.js'\nimport { newSessionId } from '../llm/session.js'\nimport { loadProjectConfig, projectConfigPath, NO_PROJECT_CONFIG }\n    from './config.js'\nimport { trustProjection, requiresApproval, trustHash }\n    from '../config/trust.js'\nimport { isApproved } from '../trust/trust.js'\nimport { gitRoot } from '../git/git.js'\nimport type { ProjectConfig } from '../config/load.js'\nimport {\n    resolveRole, validateRole, type RoleName, type ResolvedRole,\n} from '../config/role.js'\nimport { describeSource } from '../config/credential.js'\nimport { goTrimSpace } from '../gocompat/strings.js'\nimport { abortable } from '../llm/capture.js'\nimport { lstat } from 'node:fs/promises'\nimport { openCredentialStore, loadCredentials }\n    from '../credentials/credentials.js'\nimport { inspect as inspectGate, summary, isActive } from '../gate/hook.js'\nimport {\n    inspect as inspectSkill, installationTargets,\n    type InstallationTarget\n} from '../skill/skill.js'\nimport type { CommandDef, RunContext } from './command.js'\n\nexport type DoctorStatus = 'pass'|'warn'|'fail'\n\nexport interface DoctorResult {\n    name:string;\n    status:DoctorStatus;\n    detail:string;\n}\n\nexport const doctorHooks = {\n    timeout:(ms:number):AbortSignal => AbortSignal.timeout(ms),\n}\n\nfunction message (err:unknown):string {\n    return err instanceof Error ? err.message : String(err)\n}\n\nasync function doctorTrustCheck (\n    cfg:ProjectConfig,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const projection = trustProjection(cfg)\n    const name = 'config-trust'\n    if (!requiresApproval(projection)) {\n        return {\n            name,\n            status:'pass',\n            detail:'no approval required ' +\n                '(default provider endpoints and key variables only)'\n        }\n    }\n    let repo:string\n    try {\n        repo = await gitRoot(ctx.cwd, ctx)\n    } catch {\n        return {\n            name,\n            status:'fail',\n            detail:'approval required but not ' +\n                'granted: not inside a Git repository'\n        }\n    }\n    try {\n        const state = await isApproved(repo, trustHash(projection), ctx)\n        if (state === 'approved') {\n            return {\n                name,\n                status:'pass',\n                detail:'approval required and ' +\n                    'granted for this clone'\n            }\n        }\n        const why = state === 'legacy' ?\n            'approval required; approved by an older Roast' :\n            'approval required and not granted'\n        return {\n            name,\n            status:'fail',\n            detail:why +\n                '; endpoint probes skipped; run `npx roast trust`'\n        }\n    } catch (err) {\n        return {\n            name,\n            status:'fail',\n            detail:'approval required; could ' +\n                `not read approvals: ${message(err)}`\n        }\n    }\n}\n\nasync function discardModelsBody (\n    response:Response,\n    signal:AbortSignal\n):Promise<void> {\n    if (!response.body) return\n    const reader = response.body.getReader()\n    let size = 0\n    try {\n        while (size < 32 * 1024) {\n            const chunk = await abortable(reader.read(), signal)\n            if (chunk.done) return\n            size += chunk.value.byteLength\n        }\n    } finally {\n        await reader.cancel().catch(() => {})\n        reader.releaseLock()\n    }\n}\n\nexport async function doctorEndpointCheck (\n    name:RoleName,\n    resolved:ResolvedRole,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const url = resolved.baseURL.replace(/\\/+$/, '') + '/models'\n    const result:DoctorResult = {\n        name:`${name}-endpoint`, status:'fail', detail:'',\n    }\n    if (!URL.canParse(url)) {\n        return { ...result, detail:'invalid models endpoint: invalid URL' }\n    }\n    const signal = AbortSignal.any([\n        ctx.signal, doctorHooks.timeout(5000),\n    ])\n    try {\n        const response = await ctx.fetch(url, {\n            method:'GET',\n            redirect:'manual',\n            signal,\n            headers:resolved.protocol === 'anthropic' ? {\n                'x-api-key':resolved.apiKey,\n                'anthropic-version':'2023-06-01',\n            } : { Authorization:`Bearer ${resolved.apiKey}` },\n        })\n        await discardModelsBody(response, signal)\n        const status = `HTTP ${response.status} ${response.statusText}`.trim()\n        if (response.ok) {\n            result.status = 'pass'\n            result.detail = `GET ${url}: ${status}`\n        } else if (response.status >= 300 && response.status < 400) {\n            result.detail = `GET ${url}: redirect refused (${status})`\n        } else if (response.status === 401 || response.status === 403) {\n            result.detail = `credential rejected by ${url}: ${status}`\n        } else if (response.status >= 500) {\n            result.detail = `${url} returned ${status}`\n        } else {\n            result.status = 'warn'\n            result.detail = 'endpoint is reachable but model listing ' +\n                `returned ${status}`\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = `GET ${url}: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nconst probeResult = z.object({ ok:z.boolean(), token:z.string() })\n\nexport async function doctorRoundtripCheck (\n    name:RoleName,\n    resolved:ResolvedRole,\n    ctx:RunContext\n):Promise<DoctorResult> {\n    const result:DoctorResult = {\n        name:`${name}-roundtrip`, status:'fail', detail:'',\n    }\n    const signal = AbortSignal.any([\n        ctx.signal, doctorHooks.timeout(35000),\n    ])\n    try {\n        const protocol = resolved.protocol\n        if (protocol !== 'chat' && protocol !== 'responses' &&\n            protocol !== 'anthropic') {\n            throw new Error(`unsupported inference protocol \"${protocol}\"`)\n        }\n        const limit = resolved.maxOutputTokens\n        const client = createClient(createModelClient({\n            role:name,\n            baseUrl:resolved.baseURL,\n            apiKey:resolved.apiKey,\n            model:resolved.model,\n            protocol,\n            maxOutputTokens:limit > 0 && limit <= 512 ? limit : 512,\n            sessionHeader:resolved.sessionHeader,\n            maxAttempts:1,\n            requestTimeoutMs:15000,\n            fetch:ctx.fetch,\n        }))\n        const token = `roast-doctor-${newSessionId().slice(6)}`\n        let looked = false\n        const output = await client.converse(\n            'This is a connectivity check. Call doctor_lookup once, then ' +\n                'call doctor_probe with ok=true and the token ' +\n                'doctor_lookup returned.',\n            'Run the check now.', {\n                tools:[{\n                    name:'doctor_lookup',\n                    description:'Return the diagnostic token.',\n                    schema:{\n                        type:'object',\n                        properties:{},\n                        additionalProperties:false,\n                    },\n                    run:() => {\n                        looked = true\n                        return { token }\n                    },\n                }, {\n                    name:'doctor_probe',\n                    description:'Return the diagnostic result.',\n                    schema:{\n                        type:'object',\n                        properties:{\n                            ok:{ type:'boolean' }, token:{ type:'string' },\n                        },\n                        required:['ok', 'token'],\n                        additionalProperties:false,\n                    },\n                }],\n                finalTool:'doctor_probe',\n                final:{ decode:value => probeResult.parse(value) },\n                maxTurns:2,\n            }, signal)\n        if (!output.ok) {\n            result.detail = 'doctor_probe returned ok=false'\n        } else if (!looked || output.token !== token) {\n            result.detail = 'doctor_probe did not return the token from ' +\n                'doctor_lookup; the tool result did not round-trip'\n        } else {\n            result.status = 'pass'\n            result.detail = `${resolved.model} via ${resolved.protocol} ` +\n                '(two-turn tool loop)'\n        }\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        result.detail = hasSentinel(err, 'auth') ?\n            'credential rejected by the configured inference route' :\n            `${resolved.protocol}/${resolved.model} two-turn tool probe ` +\n                `failed: ${message(err)}`\n    }\n    if (resolved.apiKey) {\n        result.detail = result.detail.replaceAll(resolved.apiKey,\n            '[redacted]')\n    }\n    return result\n}\n\nasync function doctorRoleChecks (\n    cfg:ProjectConfig,\n    trusted:boolean,\n    ctx:RunContext\n):Promise<DoctorResult[]> {\n    const results:DoctorResult[] = []\n    for (const name of ['finder', 'verifier'] as const) {\n        let resolved:ResolvedRole\n        try {\n            resolved = resolveRole(cfg, name, ctx.env)\n        } catch (err) {\n            results.push({\n                name:`${name}-profile`, status:'fail', detail:message(err),\n            })\n            continue\n        }\n        const source = describeSource(resolved.credential)\n        results.push({\n            name:`${name}-credential`,\n            status:goTrimSpace(resolved.apiKey) ? 'pass' : 'fail',\n            detail:source,\n        })\n        try {\n            validateRole(name, resolved)\n        } catch (err) {\n            results.push({\n                name:`${name}-profile`, status:'fail', detail:message(err),\n            })\n            continue\n        }\n        results.push({\n            name:`${name}-profile`,\n            status:'pass',\n            detail:`${resolved.profile}: ${resolved.model} via ` +\n                `${resolved.protocol} at ${resolved.baseURL} with ` +\n                `credential ${source}` + (resolved.sessionHeader ?\n                `, session header ${resolved.sessionHeader}` : ''),\n        })\n        if (!trusted) continue\n        results.push(await doctorEndpointCheck(name, resolved, ctx))\n        results.push(await doctorRoundtripCheck(name, resolved, ctx))\n    }\n    return results\n}\n\nexport async function doctorChecks (\n    explicit:string,\n    ctx:RunContext\n):Promise<DoctorResult[]> {\n    const results:DoctorResult[] = [{\n        name:'build',\n        status:buildInfo.version === 'dev' ? 'warn' : 'pass',\n        detail:formatBuildInfo(buildInfo) +\n            (buildInfo.version === 'dev' ? '; development build' : ''),\n    }]\n    let file = ''\n    try {\n        file = await projectConfigPath(explicit, ctx)\n        if (!file) throw new Error(NO_PROJECT_CONFIG)\n        results.push({ name:'config-file', status:'pass', detail:file })\n    } catch (err) {\n        results.push({\n            name:'config-file',\n            status:'fail',\n            detail:message(err)\n        })\n    }\n    let cfg:ProjectConfig|undefined\n    if (file) {\n        try {\n            cfg = await loadProjectConfig(path.resolve(ctx.cwd, file), ctx)\n            results.push({\n                name:'config',\n                status:'pass',\n                detail:`schema version ${cfg.version}`\n            })\n        } catch (err) {\n            results.push({\n                name:'config',\n                status:'fail',\n                detail:message(err)\n            })\n        }\n    }\n    if (cfg) {\n        const trust = await doctorTrustCheck(cfg, ctx)\n        results.push(trust)\n        results.push(...await doctorRoleChecks(cfg,\n            trust.status === 'pass', ctx))\n    }\n    let repo = ''\n    try {\n        repo = await gitRoot(ctx.cwd, ctx)\n        results.push({ name:'git', status:'pass', detail:repo })\n    } catch (err) {\n        if (ctx.signal.aborted) throw err\n        results.push({\n            name:'git',\n            status:'warn',\n            detail:'not inside a Git repository'\n        })\n    }\n    if (repo) {\n        try {\n            const gate = await inspectGate(repo, ctx.env)\n            results.push({\n                name:'git-gate',\n                status:gate.stale ||\n                    (gate.decision === 'enabled' && !isActive(gate)) ?\n                    'warn' : 'pass',\n                detail:summary(gate)\n            })\n        } catch (err) {\n            results.push({\n                name:'git-gate',\n                status:'warn',\n                detail:message(err)\n            })\n        }\n    }\n    const store = await openCredentialStore(ctx.cwd, ctx.env, ctx)\n    for (const scope of ['project', 'user'] as const) {\n        const file = store.paths[scope]\n        if (!file) continue\n        try {\n            await lstat(file)\n        } catch (err) {\n            if ((err as NodeJS.ErrnoException).code === 'ENOENT') continue\n            // Let the credential loader report other filesystem errors.\n        }\n        const name = `${scope}-credentials`\n        try {\n            const entries = await loadCredentials(file)\n            const providers = [...entries.keys()].sort().join(', ')\n            results.push({\n                name,\n                status:'pass',\n                detail:`${file} (${providers || 'none stored'})`\n            })\n        } catch (err) {\n            results.push({ name, status:'fail', detail:message(err) })\n        }\n    }\n    const variable = ctx.env.HTTPS_PROXY ? 'HTTPS_PROXY' :\n        ctx.env.https_proxy ? 'https_proxy' : ''\n    const honored = ctx.env.NODE_USE_ENV_PROXY === '1'\n    results.push({\n        name:'proxy-env',\n        status:variable && !honored ? 'warn' : 'pass',\n        detail:!variable ? 'no proxy configured' : honored ?\n            'proxy variables honored (NODE_USE_ENV_PROXY=1)' :\n            `${variable} is set but NODE_USE_ENV_PROXY is not; ` +\n                'Node ignores proxy variables unless NODE_USE_ENV_PROXY=1',\n    })\n    let targets:InstallationTarget[] = []\n    try {\n        targets = await installationTargets('', '', { env:ctx.env })\n    } catch (err) {\n        results.push({\n            name:'agent-skills',\n            status:'warn',\n            detail:message(err)\n        })\n    }\n    for (const target of targets) {\n        const name = `${target.harness}-skill`\n        try {\n            const skill = await inspectSkill(target.path)\n            switch (skill.state) {\n                case 'not_installed':\n                    results.push({\n                        name,\n                        status:'warn',\n                        detail:'not installed; run ' +\n                            '`roast skill install --global`'\n                    })\n                    break\n                case 'stale':\n                    results.push({\n                        name,\n                        status:'warn',\n                        detail:'stale; run ' +\n                            '`roast skill install --global --force`'\n                    })\n                    break\n                default:\n                    results.push({\n                        name,\n                        status:'pass',\n                        detail:target.path +\n                            (skill.state === 'symlink' ?\n                                ' (development symlink)' : '')\n                    })\n            }\n        } catch (err) {\n            results.push({ name, status:'warn', detail:message(err) })\n        }\n    }\n    return results\n}\n\nexport const doctorCommand:CommandDef = {\n    command:'doctor',\n    describe:'Check configuration, providers, and local integration',\n    builder:y => y\n        .option('config', {\n            type:'string',\n            default:'',\n            describe:'project config file (default: nearest .roast.jsonc ' +\n                'up to the Git toplevel)',\n        })\n        .option('json', {\n            type:'boolean', default:false, describe:'emit a JSON array',\n        }),\n    async handler (args, ctx) {\n        const results = await doctorChecks(String(args.config), ctx)\n        if (args.json) {\n            ctx.stdout.write(JSON.stringify(results, null, 2) + '\\n')\n        } else {\n            for (const result of results) {\n                ctx.stdout.write(result.status.toUpperCase().padEnd(5) +\n                    ` ${result.name.padEnd(18)} ${result.detail}\\n`)\n            }\n        }\n        if (results.some(result => result.status === 'fail')) {\n            throw new Error('one or more doctor checks failed')\n        }\n    },\n}\n"}],"isError":false,"durationMs":10,"timestamp":1795668128068}}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"SrLBJm6Mjt2S1m5pXX30bwnu1DISOcZ4","toolName":"read","content":[{"type":"text","text":"import fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'\nimport { runRoast } from '../helpers/run.js'\nimport { saveCredential, projectCredentialsPath, userCredentialsPath }\n    from '../../src/credentials/credentials.js'\nimport { installationTargets, install, skillHooks }\n    from '../../src/skill/skill.js'\nimport { git } from '../../src/git/git.js'\nimport { startInferenceServer } from '../helpers/inference-server.js'\nimport { doctorProbe, probeCall } from '../helpers/doctor-probe.js'\nimport { providerServer } from '../helpers/provider-server.js'\nimport { doctorHooks } from '../../src/cli/doctor.js'\nimport { CancelledError } from '../../src/cli/errors.js'\n\nconst BUILTIN = {\n    version:1,\n    inference_profiles:{ o:{ protocol:'chat', model:'m' } },\n    roles:{ finder:{ profile:'o' }, verifier:{ profile:'o' } },\n}\n\nfunction doctorRepo (t:CleanupTest):TempDir {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    delete r.env.HTTPS_PROXY\n    delete r.env.https_proxy\n    delete r.env.NODE_USE_ENV_PROXY\n    r.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n    r.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n    fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n        JSON.stringify(BUILTIN))\n    return r\n}\n\ninterface Row {\n    name:string;\n    status:string;\n    detail:string;\n}\n\nasync function doctor (\n    r:TempDir,\n    args:string[] = [],\n    redirectTo?:string\n) {\n    const server = redirectTo ? undefined : await providerServer(doctorProbe())\n    try {\n        const res = await runRoast(['doctor', '--json', ...args],\n            { cwd:r.dir, env:r.env, redirectTo:redirectTo ?? server?.url })\n        const rows:Row[] = res.stdout.startsWith('[') ?\n            JSON.parse(res.stdout) : []\n        return { ...res, rows }\n    } finally {\n        await server?.close()\n    }\n}\n\ntest('doctor keeps all local checks after missing or invalid config',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        await saveCredential(project, 'openai', 'secret', new Date())\n        fs.unlinkSync(path.join(r.dir, '.roast.jsonc'))\n        const missing = await doctor(r)\n        t.equal(missing.code, 4, 'missing config fails')\n        t.deepEqual(missing.rows.map(x => x.name), [\n            'build', 'config-file', 'git', 'git-gate',\n            'project-credentials', 'proxy-env', 'agents-skill', 'claude-skill',\n        ], 'local checks remain in order')\n        t.equal(missing.rows[1].status, 'fail', 'config-file failure')\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), '{')\n        const invalid = await doctor(r)\n        t.equal(invalid.code, 4, 'invalid config fails')\n        t.equal(invalid.rows.find(x => x.name === 'config')?.status,\n            'fail', 'config failure')\n        t.ok(invalid.rows.some(x => x.name === 'agents-skill'),\n            'skills still checked')\n        const explicit = await doctor(r, ['--config', 'missing.json'])\n        t.equal(explicit.rows.find(x => x.name === 'config-file')?.status,\n            'pass', 'explicit missing path accepted')\n        t.equal(explicit.rows.find(x => x.name === 'config')?.status,\n            'fail', 'explicit missing file fails loading')\n        fs.writeFileSync(path.join(r.dir, 'custom.json'),\n            JSON.stringify(BUILTIN))\n        const relative = await doctor(r, ['--config', 'custom.json'])\n        t.equal(relative.code, 0, 'relative config uses invocation cwd')\n    })\n\ntest('doctor checks gate health and only user-level skill installations',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const targets = await installationTargets('', '', { env:r.env })\n        await install(targets[0].path, false)\n        await git(r.dir, ['config', '--local', 'roast.gate', 'enabled'],\n            { env:r.env })\n        const res = await doctor(r)\n        t.equal(res.code, 0, 'warnings do not fail')\n        t.equal(res.rows.find(x => x.name === 'git-gate')?.status,\n            'warn', 'enabled but absent gate warns')\n        t.equal(res.rows.find(x => x.name === 'agents-skill')?.status,\n            'pass', 'user install found')\n        fs.writeFileSync(path.join(targets[0].path, 'SKILL.md'), 'stale')\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'warn', 'stale warns')\n        fs.rmSync(targets[0].path, { recursive:true })\n        fs.symlinkSync(r.dir, targets[0].path)\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'pass', 'symlink passes')\n        const outside = tempDir()\n        t.cleanup(outside.remove)\n        outside.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n        outside.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n        fs.writeFileSync(path.join(outside.dir, '.roast.jsonc'),\n            JSON.stringify(BUILTIN))\n        const out = await doctor(outside)\n        t.equal(out.code, 0, 'outside repository only warns')\n        t.equal(out.rows.find(x => x.name === 'git')?.status,\n            'warn', 'git warns')\n        t.ok(!out.rows.some(x => x.name === 'git-gate'), 'gate omitted')\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const text = await runRoast(['doctor'], {\n            cwd:r.dir, env:r.env, redirectTo:server.url,\n        })\n        t.equal(text.code, 0, 'text mode')\n        t.equal(text.stdout.split('\\n').filter(Boolean).length,\n            res.rows.length, 'one text line per result')\n        t.equal((await doctor(r, ['extra'])).code, 2, 'rejects positional')\n    })\n\nexport async function approveDoctorConfig (r:TempDir):Promise<void> {\n    const res = await runRoast(['trust', '--yes'],\n        { cwd:r.dir, env:r.env })\n    if (res.code !== 0) throw new Error(res.stderr)\n}\n\ntest('doctor inspects both stored scopes even with an environment key',\n    async t => {\n        const r = doctorRepo(t)\n        r.env.OPENAI_API_KEY = 'environment-secret'\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        const user = userCredentialsPath(r.env)\n        const secret = 'stored-secret-do-not-print'\n        for (const file of [project, user]) {\n            await saveCredential(file, 'openai', secret, new Date())\n        }\n        const usable = await doctor(r)\n        t.equal(usable.code, 0, usable.stderr)\n        for (const scope of ['project', 'user']) {\n            const row = usable.rows.find(x => x.name ===\n                `${scope}-credentials`)\n            t.equal(row?.status, 'pass', `${scope} reported`)\n            t.ok(row?.detail.includes('(openai)'), 'provider reported')\n        }\n        t.ok(!usable.stdout.includes(secret), 'stored key omitted')\n        for (const [scope, file] of [['project', project], ['user', user]]) {\n            fs.writeFileSync(file, JSON.stringify({\n                version:1, providers:{ openai:{ key:secret } }, bogus:true,\n            }))\n            const broken = await doctor(r)\n            t.equal(broken.code, 4, `${scope} broken fails`)\n            t.equal(broken.rows.find(x => x.name ===\n                `${scope}-credentials`)?.status, 'fail', 'failure row')\n            t.ok(broken.rows.some(x => x.name === 'proxy-env'),\n                'later checks run')\n            t.ok(!(broken.stdout + broken.stderr).includes(secret),\n                'no key in error output')\n            fs.unlinkSync(file)\n        }\n        const absent = await doctor(r)\n        t.equal(absent.code, 0, 'absent files pass')\n        t.ok(!absent.rows.some(x => x.name.endsWith('-credentials')),\n            'absent files omitted')\n    })\n\ntest('doctor never echoes malformed credential JSON', async t => {\n    const r = doctorRepo(t)\n    const file = userCredentialsPath(r.env)\n    const secret = 'leak-key'\n    await saveCredential(file, 'openai', secret, new Date())\n    fs.writeFileSync(file, `{\"key\":${secret}}`)\n    const res = await doctor(r)\n    t.equal(res.code, 4, 'malformed file fails')\n    t.equal(res.rows.find(x => x.name === 'user-credentials')?.status,\n        'fail', 'scope reports failure')\n    t.ok(!(res.stdout + res.stderr).includes(secret),\n        'JSON parser context must not expose a key')\n})\n\ntest('doctor requires clone approval for custom endpoints', async t => {\n    const r = doctorRepo(t)\n    t.equal((await doctor(r)).rows.find(x =>\n        x.name === 'config-trust')?.status, 'pass', 'built-in needs none')\n    fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n        ...BUILTIN,\n        inference_profiles:{\n            o:{\n                protocol:'chat',\n                model:'m',\n                endpoint:'https://gateway.example/v1',\n            },\n        },\n    }))\n    const unapproved = await doctor(r)\n    t.equal(unapproved.code, 4, 'unapproved fails')\n    t.equal(unapproved.rows.find(x => x.name === 'config-trust')?.status,\n        'fail', 'trust fails')\n    await approveDoctorConfig(r)\n    t.equal((await doctor(r)).code, 0, 'v2 approval passes')\n    const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n    fs.writeFileSync(file, JSON.stringify({ version:1, approved:['old'] }))\n    const legacy = await doctor(r)\n    t.equal(legacy.code, 4, 'legacy fails')\n    const detail = legacy.rows.find(x => x.name === 'config-trust')?.detail\n    t.ok(detail?.includes('older Roast'), 'explains legacy approval')\n    t.ok(detail?.includes('npx roast trust'), 'names approval command')\n    fs.writeFileSync(file, '{')\n    t.equal((await doctor(r)).code, 4, 'malformed approval fails')\n})\n\ntest('doctor diagnoses proxy variables without exposing the URL', async t => {\n    const r = doctorRepo(t)\n    const secret = 'https://user:proxy-secret@example.com:8080'\n    for (const variable of ['HTTPS_PROXY', 'https_proxy']) {\n        r.env[variable] = secret\n        const res = await doctor(r)\n        t.equal(res.code, 0, res.stderr)\n        t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,\n            'warn', variable)\n        t.ok(!res.stdout.includes(secret), 'proxy URL omitted')\n        r.env.NODE_USE_ENV_PROXY = '1'\n        const honored = await doctor(r)\n        t.equal(honored.code, 0, honored.stderr)\n        t.equal(honored.rows.find(row => row.name === 'proxy-env')?.status,\n            'pass', 'proxy enabled')\n        delete r.env[variable]\n        delete r.env.NODE_USE_ENV_PROXY\n    }\n    const res = await doctor(r)\n    t.equal(res.code, 0, res.stderr)\n    t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,\n        'pass', 'no proxy')\n})\n\ntest('doctor probes models with each role protocol and no key in output',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:204 })\n        t.cleanup(server.close)\n        r.env.ROAST_FINDER_API_KEY = 'finder-private-key'\n        r.env.ROAST_VERIFIER_API_KEY = 'verifier-private-key'\n        for (const protocol of ['chat', 'responses', 'anthropic']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{\n                        o:{\n                            model:'m',\n                            protocol,\n                            endpoint:server.url + '/custom/v1///',\n                            session_header:'X-Session',\n                        },\n                    },\n                }))\n            await approveDoctorConfig(r)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, `${protocol} adapter is available`)\n            t.deepEqual(res.rows.filter(x => !x.name.endsWith('-roundtrip'))\n                .slice(4, 10).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'],\n                ['finder-profile', 'pass'],\n                ['finder-endpoint', 'pass'],\n                ['verifier-credential', 'pass'],\n                ['verifier-profile', 'pass'],\n                ['verifier-endpoint', 'pass'],\n            ], 'endpoint checks retain role order')\n            const roundtrips = res.rows.filter(x =>\n                x.name.endsWith('-roundtrip'))\n            t.deepEqual(roundtrips.map(x => x.status), ['pass', 'pass'],\n                'both roundtrips pass')\n            const requests = server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n            t.equal(requests.length, 2, 'one models probe per role')\n            for (const [i, req] of requests.entries()) {\n                const key = i === 0 ? 'finder-private-key' :\n                    'verifier-private-key'\n                t.equal(req.method, 'GET', 'models uses GET')\n                t.equal(req.path, '/custom/v1/models', 'base slashes removed')\n                t.equal(req.rawBody.length, 0, 'no request body')\n                t.equal(req.headers['x-session'], undefined,\n                    'session header is only for inference')\n                t.equal(req.headers.authorization,\n                    protocol === 'anthropic' ? undefined : `Bearer ${key}`,\n                    'bearer authentication for OpenAI protocols')\n                t.equal(req.headers['x-api-key'],\n                    protocol === 'anthropic' ? key : undefined,\n                    'Anthropic authentication')\n                t.equal(req.headers['anthropic-version'],\n                    protocol === 'anthropic' ? '2023-06-01' : undefined,\n                    'Anthropic version')\n            }\n            t.ok(!(res.stdout + res.stderr).includes('finder-private-key'),\n                'finder key omitted from output')\n            t.ok(!(res.stdout + res.stderr).includes('verifier-private-key'),\n                'verifier key omitted from output')\n        }\n    })\n\ntest('doctor classifies models status without disclosing response bodies',\n    async t => {\n        const r = doctorRepo(t)\n        let status = 200\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : {\n                status, body:r.env.ROAST_FINDER_API_KEY,\n            })\n        t.cleanup(server.close)\n        for (const [code, expected] of [\n            [200, 'pass'], [299, 'pass'],\n            [401, 'fail'], [403, 'fail'], [500, 'fail'], [503, 'fail'],\n            [404, 'warn'], [429, 'warn'],\n        ] as const) {\n            status = code\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, expected === 'fail' ? 4 : 0,\n                `HTTP ${code} exit code`)\n            const endpoints = res.rows.filter(x =>\n                x.name.endsWith('-endpoint'))\n            t.deepEqual(endpoints.map(x => x.status), [expected, expected],\n                `HTTP ${code} status for both roles`)\n            t.ok(endpoints.every(x => x.detail.includes(String(code))),\n                'status code in diagnostics')\n            t.ok(!(res.stdout + res.stderr).includes(\n                r.env.ROAST_FINDER_API_KEY), 'body and key omitted')\n        }\n    })\n\ntest('doctor refuses redirects without sending the key to their target',\n    async t => {\n        const r = doctorRepo(t)\n        const target = await startInferenceServer(() => ({ status:200 }))\n        t.cleanup(target.close)\n        let status = 301\n        const source = await startInferenceServer(() => ({\n            status, headers:{ location:target.url + '/stolen' },\n        }))\n        t.cleanup(source.close)\n        for (const code of [301, 302, 303, 307, 308]) {\n            status = code\n            const res = await doctor(r, [], source.url)\n            t.equal(res.code, 4, `HTTP ${code} is an endpoint error`)\n            t.deepEqual(res.rows.filter(x =>\n                x.name.endsWith('-endpoint')).map(x => x.status),\n            ['fail', 'fail'], 'both redirects fail')\n        }\n        t.equal(target.requests.length, 0, 'redirect target never contacted')\n    })\n\ntest('doctor times out a models request and continues',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const deadline = new AbortController()\n        const original = doctorHooks.timeout\n        let first = true\n        doctorHooks.timeout = ms => {\n            if (ms !== 5000 || !first) return original(ms)\n            first = false\n            return deadline.signal\n        }\n        t.cleanup(() => { doctorHooks.timeout = original })\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            if (n > 0) return { status:200 }\n            return () => {\n                deadline.abort(new DOMException('deadline', 'TimeoutError'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 4, 'timeout fails doctor')\n        t.equal(res.rows.find(x => x.name === 'finder-endpoint')?.status,\n            'fail', 'finder request times out')\n        t.ok(res.rows.find(x => x.name === 'finder-endpoint')?.detail\n            .includes('deadline'), 'timeout appears in the diagnostic')\n        t.equal(res.rows.find(x => x.name === 'verifier-endpoint')?.status,\n            'pass', 'verifier still runs')\n    })\n\ntest('doctor preserves probe deadlines for both roles', async t => {\n    const r = doctorRepo(t)\n    const deadlines:number[] = []\n    const original = doctorHooks.timeout\n    doctorHooks.timeout = ms => {\n        deadlines.push(ms)\n        return original(ms)\n    }\n    t.cleanup(() => { doctorHooks.timeout = original })\n    const res = await doctor(r)\n    t.equal(res.code, 0, 'both roles complete their probes')\n    t.deepEqual(deadlines, [5000, 35000, 5000, 35000],\n        'models and roundtrip deadlines remain unchanged')\n})\n\ntest('doctor cancellation closes the pending models request', async t => {\n    const r = doctorRepo(t)\n    const controller = new AbortController()\n    let closed!:() => void\n    const connectionClosed = new Promise<void>(resolve => { closed = resolve })\n    const server = await startInferenceServer(() => res => {\n        res.on('close', closed)\n        controller.abort(new CancelledError())\n    })\n    t.cleanup(server.close)\n    const res = await runRoast(['doctor', '--json'], {\n        cwd:r.dir,\n        env:r.env,\n        redirectTo:server.url,\n        signal:controller.signal,\n    })\n    await connectionClosed\n    t.equal(res.code, 5, 'cancellation exits 5')\n    t.ok(res.stderr.includes('cancelled'), 'cancellation is reported')\n    t.equal(res.stdout, '', 'no partial doctor results are emitted')\n    t.equal(server.requests.length, 1, 'no further probes are sent')\n})\n\ntest('doctor withholds ambient keys from a custom finder independently',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        delete r.env.ROAST_FINDER_API_KEY\n        r.env.OPENAI_API_KEY = 'ambient-key-must-stay-home'\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                custom:{ model:'m', endpoint:'https://gateway.example/v1' },\n                direct:{ model:'m', protocol:'anthropic' },\n            },\n            roles:{\n                finder:{ profile:'custom' }, verifier:{ profile:'direct' },\n            },\n        }))\n        await approveDoctorConfig(r)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 4, 'missing finder key fails doctor')\n        t.deepEqual(res.rows.slice(4, 9).map(x => [x.name, x.status]), [\n            ['finder-credential', 'fail'],\n            ['finder-profile', 'fail'],\n            ['verifier-credential', 'pass'],\n            ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'],\n        ], 'verifier remains independent of finder failure')\n        t.ok(res.rows.find(x => x.name === 'finder-credential')?.detail\n            .includes('OPENAI_API_KEY'), 'names withheld variable')\n        t.ok(!res.rows.some(x => x.name === 'finder-endpoint'),\n            'invalid finder is not probed')\n        t.ok(res.hosts.length > 0 &&\n            res.hosts.every(h => h === 'api.anthropic.com'),\n        'only verifier endpoint contacted')\n        t.ok(server.credentials.length > 0 && server.credentials.every(k =>\n            k === r.env.ROAST_VERIFIER_API_KEY), 'only verifier key sent')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.OPENAI_API_KEY),\n            'withheld key omitted from output')\n    })\n\ntest('doctor reports stored credential scopes through role resolution',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        const user = userCredentialsPath(r.env)\n        for (const [scope, file] of [['project', project], ['user', user]]) {\n            const key = `${scope}-private-key`\n            await saveCredential(file, 'openai', key, new Date())\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, `${scope} stored key works`)\n            const sources = res.rows.filter(x =>\n                x.name.endsWith('-credential'))\n            t.deepEqual(sources.map(x => x.status), ['pass', 'pass'],\n                'both roles find stored credential')\n            t.ok(sources.every(x => x.detail.includes(scope) &&\n                x.detail.includes('openai')), 'scope and provider reported')\n            t.deepEqual(server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n                .map(x => x.headers.authorization),\n            [`Bearer ${key}`, `Bearer ${key}`], 'stored key sent')\n            t.ok(!(res.stdout + res.stderr).includes(key),\n                'stored key omitted from output')\n            fs.unlinkSync(file)\n        }\n    })\n\ntest('doctor skips invalid profiles while retaining later diagnostics',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        for (const model of ['', '<finder-model>']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN, inference_profiles:{ o:{ model } },\n                }))\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 4, 'unusable model fails')\n            t.deepEqual(res.rows.slice(4, 8).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'], ['finder-profile', 'fail'],\n                ['verifier-credential', 'pass'], ['verifier-profile', 'fail'],\n            ], 'validation failure skips endpoint checks')\n        }\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN, roles:{},\n        }))\n        const res = await doctor(r, [], server.url)\n        t.deepEqual(res.rows.slice(4, 6).map(x => [x.name, x.status]), [\n            ['finder-profile', 'fail'], ['verifier-profile', 'fail'],\n        ], 'unconfigured roles produce only failed profiles')\n        t.ok(res.rows.some(x => x.name === 'proxy-env'), 'local checks run')\n        t.equal(server.requests.length, 0, 'no invalid profile is probed')\n    })\n\ntest('doctor makes no requests until custom endpoint trust is current',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:200 })\n        t.cleanup(server.close)\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', endpoint:server.url + '/v1' },\n            },\n        }))\n        const unapproved = await doctor(r, [], server.url)\n        t.equal(unapproved.code, 4, 'unapproved config fails')\n        t.equal(server.requests.length, 0, 'no unapproved requests')\n        t.deepEqual(unapproved.rows.slice(4, 8).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n        ], 'local role checks still run')\n        t.ok(!unapproved.rows.some(x => x.name.endsWith('-endpoint')),\n            'no endpoint rows for untrusted config')\n        const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n        fs.mkdirSync(path.dirname(file), { recursive:true })\n        for (const record of [\n            JSON.stringify({ version:1, approved:['Go-era-approval'] }), '{',\n        ]) {\n            fs.writeFileSync(file, record)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 4, 'unusable trust record fails')\n            t.equal(server.requests.length, 0, 'no requests with bad trust')\n            t.ok(!res.rows.some(x => x.name.endsWith('-endpoint')),\n                'no probes with bad trust')\n        }\n        fs.writeFileSync(file, JSON.stringify({ version:1, approved:[] }))\n        await approveDoctorConfig(r)\n        const approved = await doctor(r, [], server.url)\n        t.equal(approved.code, 0, 'trust --yes permits probes')\n        t.deepEqual(server.requests.filter(x => x.method === 'GET')\n            .map(x => [x.method, x.path]), [\n            ['GET', '/v1/models'], ['GET', '/v1/models'],\n        ], 'approved endpoint probed once per role')\n        t.deepEqual(server.requests.filter(x => x.method === 'GET')\n            .map(x => x.headers.authorization), [\n            'Bearer finder-test-key', 'Bearer verifier-test-key',\n        ], 'approved probes use explicit role credentials')\n    })\n\ntest('doctor bounds models body reads and hides reflected credentials',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            return res => {\n                const key = String(req.headers.authorization).slice(7)\n                res.writeHead(200, key)\n                // The probe must finish after 32 KiB even without an EOF.\n                res.write(Buffer.alloc(32 * 1024, 'x'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, 'large unterminated body does not time out')\n        t.deepEqual(res.rows.filter(x =>\n            x.name.endsWith('-endpoint')).map(x => x.status),\n        ['pass', 'pass'], 'both models requests succeed at the body limit')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_FINDER_API_KEY),\n            'key reflected in status text is redacted')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_VERIFIER_API_KEY),\n            'verifier key reflected in status text is redacted')\n    })\n\ntest('doctor chat roundtrip uses two turns with a stable prefix', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(doctorProbe())\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 0, res.stderr)\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => [x.name, x.status]), [\n        ['finder-roundtrip', 'pass'], ['verifier-roundtrip', 'pass'],\n    ], 'both roles complete the tool loop')\n    t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n    ], 'each endpoint probe is followed by exactly two inference requests')\n})\n\ntest('doctor rejects a guessed token without doctor_lookup', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(() =>\n        probeCall('doctor_probe', { ok:true, token:'roast-doctor-guess' }))\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'guessing does not pass doctor')\n    const rows = res.rows.filter(x => x.name.endsWith('-roundtrip'))\n    t.deepEqual(rows.map(x => x.status), ['fail', 'fail'],\n        'both roles must roundtrip the lookup token')\n    t.ok(rows.every(x => x.detail.includes('doctor_lookup')),\n        'diagnostic identifies the skipped lookup')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 2,\n        'one rejected final answer per role')\n})\n\ntest('doctor rejects a changed lookup token on the final turn', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(req => {\n        const body = req.body as { messages:{ role:string }[] }\n        return body.messages.some(x => x.role === 'tool') ?\n            probeCall('doctor_probe', { ok:true, token:'changed-token' }) :\n            probeCall('doctor_lookup', {})\n    })\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'lookup alone does not prove a roundtrip')\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => x.status), ['fail', 'fail'], 'changed token fails')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 4,\n        'both roles reached the second turn')\n})\n\ntest('doctor sends the configured session header on both chat turns',\n    async t => {\n        const r = doctorRepo(t)\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{\n                    protocol:'chat',\n                    model:'m',\n                    session_header:'X-Doctor-Session',\n                },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, res.stderr)\n        const requests = server.requests.filter(x => x.method === 'POST')\n        t.equal(requests.length, 4, 'two turns per role')\n        const sessions = requests.map(x => x.headers['x-doctor-session'])\n        t.ok(sessions.every(x => typeof x === 'string' &&\n            /^roast-[A-Z2-7]{26}$/.test(x)), 'session IDs sent')\n        t.equal(sessions[0], sessions[1], 'finder session survives replay')\n        t.equal(sessions[2], sessions[3], 'verifier session survives replay')\n        t.ok(sessions[0] !== sessions[2], 'roles use separate sessions')\n        t.ok(server.requests.filter(x => x.method === 'GET').every(x =>\n            x.headers['x-doctor-session'] === undefined),\n        'session header remains absent from models checks')\n    })\n\ntest('doctor emits approved chat diagnostics for an explicit config',\n    async t => {\n        const r = doctorRepo(t)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const secret = 'doctor-key-never-print'\n        r.env.DOCTOR_KEY = secret\n        const file = path.join(r.dir, 'diagnostic.json')\n        fs.writeFileSync(file, JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', api_key_env:'DOCTOR_KEY' },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const approved = await runRoast([\n            'trust', '--yes', '--config', file,\n        ], { cwd:r.dir, env:r.env })\n        t.equal(approved.code, 0, approved.stderr)\n        const res = await doctor(r, ['--config', file], server.url)\n        t.equal(res.code, 0, res.stderr)\n        t.ok(Array.isArray(JSON.parse(res.stdout)) && res.rows.length >= 8,\n            'stdout is a complete JSON result array')\n        t.equal(res.rows.find(x => x.name === 'finder-credential')?.detail,\n            'DOCTOR_KEY (profile api_key_env)', 'names credential source')\n        t.deepEqual(res.rows.slice(4, 12).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['finder-endpoint', 'pass'], ['finder-roundtrip', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'], ['verifier-roundtrip', 'pass'],\n        ], 'role checks and probes remain in specified order')\n        t.ok(!(res.stdout + res.stderr).includes(secret),\n            'secret absent from output')\n        t.ok(server.requests.every(x =>\n            x.headers.authorization === `Bearer ${secret}`),\n        'profile credential reaches both kinds of request')\n    })\n\nfor (const [protocol, endpoint] of [\n    ['responses', '/v1/responses'],\n    ['anthropic', '/v1/messages'],\n] as const) {\n    test(`doctor ${protocol} roundtrip uses two turns with a stable prefix`,\n        async t => {\n            const r = doctorRepo(t)\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{ o:{ protocol, model:'m' } },\n                }))\n            const server = await providerServer(doctorProbe())\n            t.cleanup(server.close)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, res.stderr)\n            t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n                .map(x => [x.name, x.status]), [\n                ['finder-roundtrip', 'pass'],\n                ['verifier-roundtrip', 'pass'],\n            ], 'both roles complete the tool loop')\n            t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n                ['GET', '/v1/models'],\n                ['POST', endpoint],\n                ['POST', endpoint],\n                ['GET', '/v1/models'],\n                ['POST', endpoint],\n                ['POST', endpoint],\n            ], 'each role makes exactly two inference requests')\n        })\n}\n"}],"isError":false,"durationMs":10,"timestamp":1795668128068}}
{"type":"message_end","message":{"role":"toolResult","toolCallId":"SrLBJm6Mjt2S1m5pXX30bwnu1DISOcZ4","toolName":"read","content":[{"type":"text","text":"import fs from 'node:fs'\nimport path from 'node:path'\nimport { test, type CleanupTest } from '../helpers/test.js'\nimport { tempDir, tempRepo, type TempDir } from '../helpers/repo.js'\nimport { runRoast } from '../helpers/run.js'\nimport { saveCredential, projectCredentialsPath, userCredentialsPath }\n    from '../../src/credentials/credentials.js'\nimport { installationTargets, install, skillHooks }\n    from '../../src/skill/skill.js'\nimport { git } from '../../src/git/git.js'\nimport { startInferenceServer } from '../helpers/inference-server.js'\nimport { doctorProbe, probeCall } from '../helpers/doctor-probe.js'\nimport { providerServer } from '../helpers/provider-server.js'\nimport { doctorHooks } from '../../src/cli/doctor.js'\nimport { CancelledError } from '../../src/cli/errors.js'\n\nconst BUILTIN = {\n    version:1,\n    inference_profiles:{ o:{ protocol:'chat', model:'m' } },\n    roles:{ finder:{ profile:'o' }, verifier:{ profile:'o' } },\n}\n\nfunction doctorRepo (t:CleanupTest):TempDir {\n    const r = tempRepo()\n    t.cleanup(r.remove)\n    const cwd = process.cwd()\n    process.chdir(r.dir)\n    t.cleanup(() => process.chdir(cwd))\n    delete r.env.HTTPS_PROXY\n    delete r.env.https_proxy\n    delete r.env.NODE_USE_ENV_PROXY\n    r.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n    r.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n    fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n        JSON.stringify(BUILTIN))\n    return r\n}\n\ninterface Row {\n    name:string;\n    status:string;\n    detail:string;\n}\n\nasync function doctor (\n    r:TempDir,\n    args:string[] = [],\n    redirectTo?:string\n) {\n    const server = redirectTo ? undefined : await providerServer(doctorProbe())\n    try {\n        const res = await runRoast(['doctor', '--json', ...args],\n            { cwd:r.dir, env:r.env, redirectTo:redirectTo ?? server?.url })\n        const rows:Row[] = res.stdout.startsWith('[') ?\n            JSON.parse(res.stdout) : []\n        return { ...res, rows }\n    } finally {\n        await server?.close()\n    }\n}\n\ntest('doctor keeps all local checks after missing or invalid config',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        await saveCredential(project, 'openai', 'secret', new Date())\n        fs.unlinkSync(path.join(r.dir, '.roast.jsonc'))\n        const missing = await doctor(r)\n        t.equal(missing.code, 4, 'missing config fails')\n        t.deepEqual(missing.rows.map(x => x.name), [\n            'build', 'config-file', 'git', 'git-gate',\n            'project-credentials', 'proxy-env', 'agents-skill', 'claude-skill',\n        ], 'local checks remain in order')\n        t.equal(missing.rows[1].status, 'fail', 'config-file failure')\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), '{')\n        const invalid = await doctor(r)\n        t.equal(invalid.code, 4, 'invalid config fails')\n        t.equal(invalid.rows.find(x => x.name === 'config')?.status,\n            'fail', 'config failure')\n        t.ok(invalid.rows.some(x => x.name === 'agents-skill'),\n            'skills still checked')\n        const explicit = await doctor(r, ['--config', 'missing.json'])\n        t.equal(explicit.rows.find(x => x.name === 'config-file')?.status,\n            'pass', 'explicit missing path accepted')\n        t.equal(explicit.rows.find(x => x.name === 'config')?.status,\n            'fail', 'explicit missing file fails loading')\n        fs.writeFileSync(path.join(r.dir, 'custom.json'),\n            JSON.stringify(BUILTIN))\n        const relative = await doctor(r, ['--config', 'custom.json'])\n        t.equal(relative.code, 0, 'relative config uses invocation cwd')\n    })\n\ntest('doctor checks gate health and only user-level skill installations',\n    async t => {\n        const r = doctorRepo(t)\n        const original = skillHooks.lookPath\n        skillHooks.lookPath = async () => false\n        t.cleanup(() => { skillHooks.lookPath = original })\n        const targets = await installationTargets('', '', { env:r.env })\n        await install(targets[0].path, false)\n        await git(r.dir, ['config', '--local', 'roast.gate', 'enabled'],\n            { env:r.env })\n        const res = await doctor(r)\n        t.equal(res.code, 0, 'warnings do not fail')\n        t.equal(res.rows.find(x => x.name === 'git-gate')?.status,\n            'warn', 'enabled but absent gate warns')\n        t.equal(res.rows.find(x => x.name === 'agents-skill')?.status,\n            'pass', 'user install found')\n        fs.writeFileSync(path.join(targets[0].path, 'SKILL.md'), 'stale')\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'warn', 'stale warns')\n        fs.rmSync(targets[0].path, { recursive:true })\n        fs.symlinkSync(r.dir, targets[0].path)\n        t.equal((await doctor(r)).rows.find(x =>\n            x.name === 'agents-skill')?.status, 'pass', 'symlink passes')\n        const outside = tempDir()\n        t.cleanup(outside.remove)\n        outside.env.ROAST_FINDER_API_KEY = 'finder-test-key'\n        outside.env.ROAST_VERIFIER_API_KEY = 'verifier-test-key'\n        fs.writeFileSync(path.join(outside.dir, '.roast.jsonc'),\n            JSON.stringify(BUILTIN))\n        const out = await doctor(outside)\n        t.equal(out.code, 0, 'outside repository only warns')\n        t.equal(out.rows.find(x => x.name === 'git')?.status,\n            'warn', 'git warns')\n        t.ok(!out.rows.some(x => x.name === 'git-gate'), 'gate omitted')\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const text = await runRoast(['doctor'], {\n            cwd:r.dir, env:r.env, redirectTo:server.url,\n        })\n        t.equal(text.code, 0, 'text mode')\n        t.equal(text.stdout.split('\\n').filter(Boolean).length,\n            res.rows.length, 'one text line per result')\n        t.equal((await doctor(r, ['extra'])).code, 2, 'rejects positional')\n    })\n\nexport async function approveDoctorConfig (r:TempDir):Promise<void> {\n    const res = await runRoast(['trust', '--yes'],\n        { cwd:r.dir, env:r.env })\n    if (res.code !== 0) throw new Error(res.stderr)\n}\n\ntest('doctor inspects both stored scopes even with an environment key',\n    async t => {\n        const r = doctorRepo(t)\n        r.env.OPENAI_API_KEY = 'environment-secret'\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        const user = userCredentialsPath(r.env)\n        const secret = 'stored-secret-do-not-print'\n        for (const file of [project, user]) {\n            await saveCredential(file, 'openai', secret, new Date())\n        }\n        const usable = await doctor(r)\n        t.equal(usable.code, 0, usable.stderr)\n        for (const scope of ['project', 'user']) {\n            const row = usable.rows.find(x => x.name ===\n                `${scope}-credentials`)\n            t.equal(row?.status, 'pass', `${scope} reported`)\n            t.ok(row?.detail.includes('(openai)'), 'provider reported')\n        }\n        t.ok(!usable.stdout.includes(secret), 'stored key omitted')\n        for (const [scope, file] of [['project', project], ['user', user]]) {\n            fs.writeFileSync(file, JSON.stringify({\n                version:1, providers:{ openai:{ key:secret } }, bogus:true,\n            }))\n            const broken = await doctor(r)\n            t.equal(broken.code, 4, `${scope} broken fails`)\n            t.equal(broken.rows.find(x => x.name ===\n                `${scope}-credentials`)?.status, 'fail', 'failure row')\n            t.ok(broken.rows.some(x => x.name === 'proxy-env'),\n                'later checks run')\n            t.ok(!(broken.stdout + broken.stderr).includes(secret),\n                'no key in error output')\n            fs.unlinkSync(file)\n        }\n        const absent = await doctor(r)\n        t.equal(absent.code, 0, 'absent files pass')\n        t.ok(!absent.rows.some(x => x.name.endsWith('-credentials')),\n            'absent files omitted')\n    })\n\ntest('doctor never echoes malformed credential JSON', async t => {\n    const r = doctorRepo(t)\n    const file = userCredentialsPath(r.env)\n    const secret = 'leak-key'\n    await saveCredential(file, 'openai', secret, new Date())\n    fs.writeFileSync(file, `{\"key\":${secret}}`)\n    const res = await doctor(r)\n    t.equal(res.code, 4, 'malformed file fails')\n    t.equal(res.rows.find(x => x.name === 'user-credentials')?.status,\n        'fail', 'scope reports failure')\n    t.ok(!(res.stdout + res.stderr).includes(secret),\n        'JSON parser context must not expose a key')\n})\n\ntest('doctor requires clone approval for custom endpoints', async t => {\n    const r = doctorRepo(t)\n    t.equal((await doctor(r)).rows.find(x =>\n        x.name === 'config-trust')?.status, 'pass', 'built-in needs none')\n    fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n        ...BUILTIN,\n        inference_profiles:{\n            o:{\n                protocol:'chat',\n                model:'m',\n                endpoint:'https://gateway.example/v1',\n            },\n        },\n    }))\n    const unapproved = await doctor(r)\n    t.equal(unapproved.code, 4, 'unapproved fails')\n    t.equal(unapproved.rows.find(x => x.name === 'config-trust')?.status,\n        'fail', 'trust fails')\n    await approveDoctorConfig(r)\n    t.equal((await doctor(r)).code, 0, 'v2 approval passes')\n    const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n    fs.writeFileSync(file, JSON.stringify({ version:1, approved:['old'] }))\n    const legacy = await doctor(r)\n    t.equal(legacy.code, 4, 'legacy fails')\n    const detail = legacy.rows.find(x => x.name === 'config-trust')?.detail\n    t.ok(detail?.includes('older Roast'), 'explains legacy approval')\n    t.ok(detail?.includes('npx roast trust'), 'names approval command')\n    fs.writeFileSync(file, '{')\n    t.equal((await doctor(r)).code, 4, 'malformed approval fails')\n})\n\ntest('doctor diagnoses proxy variables without exposing the URL', async t => {\n    const r = doctorRepo(t)\n    const secret = 'https://user:proxy-secret@example.com:8080'\n    for (const variable of ['HTTPS_PROXY', 'https_proxy']) {\n        r.env[variable] = secret\n        const res = await doctor(r)\n        t.equal(res.code, 0, res.stderr)\n        t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,\n            'warn', variable)\n        t.ok(!res.stdout.includes(secret), 'proxy URL omitted')\n        r.env.NODE_USE_ENV_PROXY = '1'\n        const honored = await doctor(r)\n        t.equal(honored.code, 0, honored.stderr)\n        t.equal(honored.rows.find(row => row.name === 'proxy-env')?.status,\n            'pass', 'proxy enabled')\n        delete r.env[variable]\n        delete r.env.NODE_USE_ENV_PROXY\n    }\n    const res = await doctor(r)\n    t.equal(res.code, 0, res.stderr)\n    t.equal(res.rows.find(row => row.name === 'proxy-env')?.status,\n        'pass', 'no proxy')\n})\n\ntest('doctor probes models with each role protocol and no key in output',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:204 })\n        t.cleanup(server.close)\n        r.env.ROAST_FINDER_API_KEY = 'finder-private-key'\n        r.env.ROAST_VERIFIER_API_KEY = 'verifier-private-key'\n        for (const protocol of ['chat', 'responses', 'anthropic']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{\n                        o:{\n                            model:'m',\n                            protocol,\n                            endpoint:server.url + '/custom/v1///',\n                            session_header:'X-Session',\n                        },\n                    },\n                }))\n            await approveDoctorConfig(r)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, `${protocol} adapter is available`)\n            t.deepEqual(res.rows.filter(x => !x.name.endsWith('-roundtrip'))\n                .slice(4, 10).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'],\n                ['finder-profile', 'pass'],\n                ['finder-endpoint', 'pass'],\n                ['verifier-credential', 'pass'],\n                ['verifier-profile', 'pass'],\n                ['verifier-endpoint', 'pass'],\n            ], 'endpoint checks retain role order')\n            const roundtrips = res.rows.filter(x =>\n                x.name.endsWith('-roundtrip'))\n            t.deepEqual(roundtrips.map(x => x.status), ['pass', 'pass'],\n                'both roundtrips pass')\n            const requests = server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n            t.equal(requests.length, 2, 'one models probe per role')\n            for (const [i, req] of requests.entries()) {\n                const key = i === 0 ? 'finder-private-key' :\n                    'verifier-private-key'\n                t.equal(req.method, 'GET', 'models uses GET')\n                t.equal(req.path, '/custom/v1/models', 'base slashes removed')\n                t.equal(req.rawBody.length, 0, 'no request body')\n                t.equal(req.headers['x-session'], undefined,\n                    'session header is only for inference')\n                t.equal(req.headers.authorization,\n                    protocol === 'anthropic' ? undefined : `Bearer ${key}`,\n                    'bearer authentication for OpenAI protocols')\n                t.equal(req.headers['x-api-key'],\n                    protocol === 'anthropic' ? key : undefined,\n                    'Anthropic authentication')\n                t.equal(req.headers['anthropic-version'],\n                    protocol === 'anthropic' ? '2023-06-01' : undefined,\n                    'Anthropic version')\n            }\n            t.ok(!(res.stdout + res.stderr).includes('finder-private-key'),\n                'finder key omitted from output')\n            t.ok(!(res.stdout + res.stderr).includes('verifier-private-key'),\n                'verifier key omitted from output')\n        }\n    })\n\ntest('doctor classifies models status without disclosing response bodies',\n    async t => {\n        const r = doctorRepo(t)\n        let status = 200\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : {\n                status, body:r.env.ROAST_FINDER_API_KEY,\n            })\n        t.cleanup(server.close)\n        for (const [code, expected] of [\n            [200, 'pass'], [299, 'pass'],\n            [401, 'fail'], [403, 'fail'], [500, 'fail'], [503, 'fail'],\n            [404, 'warn'], [429, 'warn'],\n        ] as const) {\n            status = code\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, expected === 'fail' ? 4 : 0,\n                `HTTP ${code} exit code`)\n            const endpoints = res.rows.filter(x =>\n                x.name.endsWith('-endpoint'))\n            t.deepEqual(endpoints.map(x => x.status), [expected, expected],\n                `HTTP ${code} status for both roles`)\n            t.ok(endpoints.every(x => x.detail.includes(String(code))),\n                'status code in diagnostics')\n            t.ok(!(res.stdout + res.stderr).includes(\n                r.env.ROAST_FINDER_API_KEY), 'body and key omitted')\n        }\n    })\n\ntest('doctor refuses redirects without sending the key to their target',\n    async t => {\n        const r = doctorRepo(t)\n        const target = await startInferenceServer(() => ({ status:200 }))\n        t.cleanup(target.close)\n        let status = 301\n        const source = await startInferenceServer(() => ({\n            status, headers:{ location:target.url + '/stolen' },\n        }))\n        t.cleanup(source.close)\n        for (const code of [301, 302, 303, 307, 308]) {\n            status = code\n            const res = await doctor(r, [], source.url)\n            t.equal(res.code, 4, `HTTP ${code} is an endpoint error`)\n            t.deepEqual(res.rows.filter(x =>\n                x.name.endsWith('-endpoint')).map(x => x.status),\n            ['fail', 'fail'], 'both redirects fail')\n        }\n        t.equal(target.requests.length, 0, 'redirect target never contacted')\n    })\n\ntest('doctor times out a models request and continues',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const deadline = new AbortController()\n        const original = doctorHooks.timeout\n        let first = true\n        doctorHooks.timeout = ms => {\n            if (ms !== 5000 || !first) return original(ms)\n            first = false\n            return deadline.signal\n        }\n        t.cleanup(() => { doctorHooks.timeout = original })\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            if (n > 0) return { status:200 }\n            return () => {\n                deadline.abort(new DOMException('deadline', 'TimeoutError'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 4, 'timeout fails doctor')\n        t.equal(res.rows.find(x => x.name === 'finder-endpoint')?.status,\n            'fail', 'finder request times out')\n        t.ok(res.rows.find(x => x.name === 'finder-endpoint')?.detail\n            .includes('deadline'), 'timeout appears in the diagnostic')\n        t.equal(res.rows.find(x => x.name === 'verifier-endpoint')?.status,\n            'pass', 'verifier still runs')\n    })\n\ntest('doctor preserves probe deadlines for both roles', async t => {\n    const r = doctorRepo(t)\n    const deadlines:number[] = []\n    const original = doctorHooks.timeout\n    doctorHooks.timeout = ms => {\n        deadlines.push(ms)\n        return original(ms)\n    }\n    t.cleanup(() => { doctorHooks.timeout = original })\n    const res = await doctor(r)\n    t.equal(res.code, 0, 'both roles complete their probes')\n    t.deepEqual(deadlines, [5000, 35000, 5000, 35000],\n        'models and roundtrip deadlines remain unchanged')\n})\n\ntest('doctor cancellation closes the pending models request', async t => {\n    const r = doctorRepo(t)\n    const controller = new AbortController()\n    let closed!:() => void\n    const connectionClosed = new Promise<void>(resolve => { closed = resolve })\n    const server = await startInferenceServer(() => res => {\n        res.on('close', closed)\n        controller.abort(new CancelledError())\n    })\n    t.cleanup(server.close)\n    const res = await runRoast(['doctor', '--json'], {\n        cwd:r.dir,\n        env:r.env,\n        redirectTo:server.url,\n        signal:controller.signal,\n    })\n    await connectionClosed\n    t.equal(res.code, 5, 'cancellation exits 5')\n    t.ok(res.stderr.includes('cancelled'), 'cancellation is reported')\n    t.equal(res.stdout, '', 'no partial doctor results are emitted')\n    t.equal(server.requests.length, 1, 'no further probes are sent')\n})\n\ntest('doctor withholds ambient keys from a custom finder independently',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        delete r.env.ROAST_FINDER_API_KEY\n        r.env.OPENAI_API_KEY = 'ambient-key-must-stay-home'\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                custom:{ model:'m', endpoint:'https://gateway.example/v1' },\n                direct:{ model:'m', protocol:'anthropic' },\n            },\n            roles:{\n                finder:{ profile:'custom' }, verifier:{ profile:'direct' },\n            },\n        }))\n        await approveDoctorConfig(r)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 4, 'missing finder key fails doctor')\n        t.deepEqual(res.rows.slice(4, 9).map(x => [x.name, x.status]), [\n            ['finder-credential', 'fail'],\n            ['finder-profile', 'fail'],\n            ['verifier-credential', 'pass'],\n            ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'],\n        ], 'verifier remains independent of finder failure')\n        t.ok(res.rows.find(x => x.name === 'finder-credential')?.detail\n            .includes('OPENAI_API_KEY'), 'names withheld variable')\n        t.ok(!res.rows.some(x => x.name === 'finder-endpoint'),\n            'invalid finder is not probed')\n        t.ok(res.hosts.length > 0 &&\n            res.hosts.every(h => h === 'api.anthropic.com'),\n        'only verifier endpoint contacted')\n        t.ok(server.credentials.length > 0 && server.credentials.every(k =>\n            k === r.env.ROAST_VERIFIER_API_KEY), 'only verifier key sent')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.OPENAI_API_KEY),\n            'withheld key omitted from output')\n    })\n\ntest('doctor reports stored credential scopes through role resolution',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const project = await projectCredentialsPath(r.dir, { env:r.env })\n        const user = userCredentialsPath(r.env)\n        for (const [scope, file] of [['project', project], ['user', user]]) {\n            const key = `${scope}-private-key`\n            await saveCredential(file, 'openai', key, new Date())\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, `${scope} stored key works`)\n            const sources = res.rows.filter(x =>\n                x.name.endsWith('-credential'))\n            t.deepEqual(sources.map(x => x.status), ['pass', 'pass'],\n                'both roles find stored credential')\n            t.ok(sources.every(x => x.detail.includes(scope) &&\n                x.detail.includes('openai')), 'scope and provider reported')\n            t.deepEqual(server.requests.splice(0)\n                .filter(x => x.method === 'GET')\n                .map(x => x.headers.authorization),\n            [`Bearer ${key}`, `Bearer ${key}`], 'stored key sent')\n            t.ok(!(res.stdout + res.stderr).includes(key),\n                'stored key omitted from output')\n            fs.unlinkSync(file)\n        }\n    })\n\ntest('doctor skips invalid profiles while retaining later diagnostics',\n    async t => {\n        const r = doctorRepo(t)\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        for (const model of ['', '<finder-model>']) {\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN, inference_profiles:{ o:{ model } },\n                }))\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 4, 'unusable model fails')\n            t.deepEqual(res.rows.slice(4, 8).map(x => [x.name, x.status]), [\n                ['finder-credential', 'pass'], ['finder-profile', 'fail'],\n                ['verifier-credential', 'pass'], ['verifier-profile', 'fail'],\n            ], 'validation failure skips endpoint checks')\n        }\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN, roles:{},\n        }))\n        const res = await doctor(r, [], server.url)\n        t.deepEqual(res.rows.slice(4, 6).map(x => [x.name, x.status]), [\n            ['finder-profile', 'fail'], ['verifier-profile', 'fail'],\n        ], 'unconfigured roles produce only failed profiles')\n        t.ok(res.rows.some(x => x.name === 'proxy-env'), 'local checks run')\n        t.equal(server.requests.length, 0, 'no invalid profile is probed')\n    })\n\ntest('doctor makes no requests until custom endpoint trust is current',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) =>\n            req.method === 'POST' ? probe(req, n) : { status:200 })\n        t.cleanup(server.close)\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', endpoint:server.url + '/v1' },\n            },\n        }))\n        const unapproved = await doctor(r, [], server.url)\n        t.equal(unapproved.code, 4, 'unapproved config fails')\n        t.equal(server.requests.length, 0, 'no unapproved requests')\n        t.deepEqual(unapproved.rows.slice(4, 8).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n        ], 'local role checks still run')\n        t.ok(!unapproved.rows.some(x => x.name.endsWith('-endpoint')),\n            'no endpoint rows for untrusted config')\n        const file = path.join(r.dir, '.git', 'roast', 'trust.json')\n        fs.mkdirSync(path.dirname(file), { recursive:true })\n        for (const record of [\n            JSON.stringify({ version:1, approved:['Go-era-approval'] }), '{',\n        ]) {\n            fs.writeFileSync(file, record)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 4, 'unusable trust record fails')\n            t.equal(server.requests.length, 0, 'no requests with bad trust')\n            t.ok(!res.rows.some(x => x.name.endsWith('-endpoint')),\n                'no probes with bad trust')\n        }\n        fs.writeFileSync(file, JSON.stringify({ version:1, approved:[] }))\n        await approveDoctorConfig(r)\n        const approved = await doctor(r, [], server.url)\n        t.equal(approved.code, 0, 'trust --yes permits probes')\n        t.deepEqual(server.requests.filter(x => x.method === 'GET')\n            .map(x => [x.method, x.path]), [\n            ['GET', '/v1/models'], ['GET', '/v1/models'],\n        ], 'approved endpoint probed once per role')\n        t.deepEqual(server.requests.filter(x => x.method === 'GET')\n            .map(x => x.headers.authorization), [\n            'Bearer finder-test-key', 'Bearer verifier-test-key',\n        ], 'approved probes use explicit role credentials')\n    })\n\ntest('doctor bounds models body reads and hides reflected credentials',\n    async t => {\n        const r = doctorRepo(t)\n        const probe = doctorProbe()\n        const server = await startInferenceServer((req, n) => {\n            if (req.method === 'POST') return probe(req, n)\n            return res => {\n                const key = String(req.headers.authorization).slice(7)\n                res.writeHead(200, key)\n                // The probe must finish after 32 KiB even without an EOF.\n                res.write(Buffer.alloc(32 * 1024, 'x'))\n            }\n        })\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, 'large unterminated body does not time out')\n        t.deepEqual(res.rows.filter(x =>\n            x.name.endsWith('-endpoint')).map(x => x.status),\n        ['pass', 'pass'], 'both models requests succeed at the body limit')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_FINDER_API_KEY),\n            'key reflected in status text is redacted')\n        t.ok(!(res.stdout + res.stderr).includes(r.env.ROAST_VERIFIER_API_KEY),\n            'verifier key reflected in status text is redacted')\n    })\n\ntest('doctor chat roundtrip uses two turns with a stable prefix', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(doctorProbe())\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 0, res.stderr)\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => [x.name, x.status]), [\n        ['finder-roundtrip', 'pass'], ['verifier-roundtrip', 'pass'],\n    ], 'both roles complete the tool loop')\n    t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n        ['GET', '/v1/models'],\n        ['POST', '/v1/chat/completions'],\n        ['POST', '/v1/chat/completions'],\n    ], 'each endpoint probe is followed by exactly two inference requests')\n})\n\ntest('doctor rejects a guessed token without doctor_lookup', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(() =>\n        probeCall('doctor_probe', { ok:true, token:'roast-doctor-guess' }))\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'guessing does not pass doctor')\n    const rows = res.rows.filter(x => x.name.endsWith('-roundtrip'))\n    t.deepEqual(rows.map(x => x.status), ['fail', 'fail'],\n        'both roles must roundtrip the lookup token')\n    t.ok(rows.every(x => x.detail.includes('doctor_lookup')),\n        'diagnostic identifies the skipped lookup')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 2,\n        'one rejected final answer per role')\n})\n\ntest('doctor rejects a changed lookup token on the final turn', async t => {\n    const r = doctorRepo(t)\n    const server = await providerServer(req => {\n        const body = req.body as { messages:{ role:string }[] }\n        return body.messages.some(x => x.role === 'tool') ?\n            probeCall('doctor_probe', { ok:true, token:'changed-token' }) :\n            probeCall('doctor_lookup', {})\n    })\n    t.cleanup(server.close)\n    const res = await doctor(r, [], server.url)\n    t.equal(res.code, 4, 'lookup alone does not prove a roundtrip')\n    t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n        .map(x => x.status), ['fail', 'fail'], 'changed token fails')\n    t.equal(server.requests.filter(x => x.method === 'POST').length, 4,\n        'both roles reached the second turn')\n})\n\ntest('doctor sends the configured session header on both chat turns',\n    async t => {\n        const r = doctorRepo(t)\n        fs.writeFileSync(path.join(r.dir, '.roast.jsonc'), JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{\n                    protocol:'chat',\n                    model:'m',\n                    session_header:'X-Doctor-Session',\n                },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const res = await doctor(r, [], server.url)\n        t.equal(res.code, 0, res.stderr)\n        const requests = server.requests.filter(x => x.method === 'POST')\n        t.equal(requests.length, 4, 'two turns per role')\n        const sessions = requests.map(x => x.headers['x-doctor-session'])\n        t.ok(sessions.every(x => typeof x === 'string' &&\n            /^roast-[A-Z2-7]{26}$/.test(x)), 'session IDs sent')\n        t.equal(sessions[0], sessions[1], 'finder session survives replay')\n        t.equal(sessions[2], sessions[3], 'verifier session survives replay')\n        t.ok(sessions[0] !== sessions[2], 'roles use separate sessions')\n        t.ok(server.requests.filter(x => x.method === 'GET').every(x =>\n            x.headers['x-doctor-session'] === undefined),\n        'session header remains absent from models checks')\n    })\n\ntest('doctor emits approved chat diagnostics for an explicit config',\n    async t => {\n        const r = doctorRepo(t)\n        delete r.env.ROAST_FINDER_API_KEY\n        delete r.env.ROAST_VERIFIER_API_KEY\n        const secret = 'doctor-key-never-print'\n        r.env.DOCTOR_KEY = secret\n        const file = path.join(r.dir, 'diagnostic.json')\n        fs.writeFileSync(file, JSON.stringify({\n            ...BUILTIN,\n            inference_profiles:{\n                o:{ protocol:'chat', model:'m', api_key_env:'DOCTOR_KEY' },\n            },\n        }))\n        const server = await providerServer(doctorProbe())\n        t.cleanup(server.close)\n        const approved = await runRoast([\n            'trust', '--yes', '--config', file,\n        ], { cwd:r.dir, env:r.env })\n        t.equal(approved.code, 0, approved.stderr)\n        const res = await doctor(r, ['--config', file], server.url)\n        t.equal(res.code, 0, res.stderr)\n        t.ok(Array.isArray(JSON.parse(res.stdout)) && res.rows.length >= 8,\n            'stdout is a complete JSON result array')\n        t.equal(res.rows.find(x => x.name === 'finder-credential')?.detail,\n            'DOCTOR_KEY (profile api_key_env)', 'names credential source')\n        t.deepEqual(res.rows.slice(4, 12).map(x => [x.name, x.status]), [\n            ['finder-credential', 'pass'], ['finder-profile', 'pass'],\n            ['finder-endpoint', 'pass'], ['finder-roundtrip', 'pass'],\n            ['verifier-credential', 'pass'], ['verifier-profile', 'pass'],\n            ['verifier-endpoint', 'pass'], ['verifier-roundtrip', 'pass'],\n        ], 'role checks and probes remain in specified order')\n        t.ok(!(res.stdout + res.stderr).includes(secret),\n            'secret absent from output')\n        t.ok(server.requests.every(x =>\n            x.headers.authorization === `Bearer ${secret}`),\n        'profile credential reaches both kinds of request')\n    })\n\nfor (const [protocol, endpoint] of [\n    ['responses', '/v1/responses'],\n    ['anthropic', '/v1/messages'],\n] as const) {\n    test(`doctor ${protocol} roundtrip uses two turns with a stable prefix`,\n        async t => {\n            const r = doctorRepo(t)\n            fs.writeFileSync(path.join(r.dir, '.roast.jsonc'),\n                JSON.stringify({\n                    ...BUILTIN,\n                    inference_profiles:{ o:{ protocol, model:'m' } },\n                }))\n            const server = await providerServer(doctorProbe())\n            t.cleanup(server.close)\n            const res = await doctor(r, [], server.url)\n            t.equal(res.code, 0, res.stderr)\n            t.deepEqual(res.rows.filter(x => x.name.endsWith('-roundtrip'))\n                .map(x => [x.name, x.status]), [\n                ['finder-roundtrip', 'pass'],\n                ['verifier-roundtrip', 'pass'],\n            ], 'both roles complete the tool loop')\n            t.deepEqual(server.requests.map(x => [x.method, x.path]), [\n                ['GET', '/v1/models'],\n                ['POST', endpoint],\n                ['POST', endpoint],\n                ['GET', '/v1/models'],\n                ['POST', endpoint],\n                ['POST', endpoint],\n            ], 'each role makes exactly two inference requests')\n        })\n}\n"}],"isError":false,"durationMs":10,"timestamp":1795668128068}}
