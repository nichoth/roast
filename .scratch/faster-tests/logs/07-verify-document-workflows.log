# Roast is a TypeScript package that talks to providers over raw fetch

Roast was a Go binary shipped through npm as six platform packages and a
launcher. Every Roast install is already a Node project dependency, so a Go
toolchain, per-platform builds, and the launcher add release machinery
without serving users. We rewrite Roast in TypeScript as one pure-JS npm
package, `2.0.0`, with behavior parity against Go commit `cd08f10` except
for named changes: no Windows support, no `completion` command, Node
`>=22.18`, and the trust hash in ADR-0003.

Runtime libraries (`yargs`, `zod`, `jsonc-parser`,
`@substrate-system/debug`) are bundled into one esbuild ESM file, so
installing Roast adds no transitive packages to a user's project, the same
property the Go binary had. Their license texts ship in a generated
third-party notice.

Inference uses raw `fetch` with one adapter per protocol (`chat`,
`responses`, `anthropic`) and Roast's own agent loop, not a provider SDK
or an LLM framework. The Go version used the Fantasy framework but had to
wrap or override much of it: it captured raw response bytes for run
records, removed headers the SDKs read from ambient environment variables,
replaced retry and tool-call-repair behavior, sized requests for the token
ledger before sending, and reserved a wrap-up turn. Official SDKs would need
the same overrides on two codebases; owning the wire layer puts all of it in
one place.

## Considered options

- Keep Go: no rewrite cost, but keeps the multi-package release and a second
  toolchain for a tool whose users all run Node.
- Official `openai` and `@anthropic-ai/sdk` SDKs: typed streaming for free,
  but both read ambient configuration and run their own retries, which Roast
  must defeat to keep its credential and capture guarantees.
- Vercel AI SDK: closest to Fantasy, but it hides the request bytes and the
  retry policy that the ledger and run records depend on.
// Run the entries in test/index.ts in isolated, bounded child processes.
import { spawn } from 'node:child_process'
import type { ChildProcess } from 'node:child_process'
import { readFile, rm } from 'node:fs/promises'
import { availableParallelism } from 'node:os'
import { resolve } from 'node:path'
import { randomUUID } from 'node:crypto'
import { build } from 'esbuild'
import { ROOT, baseOptions } from './esbuild-options.ts'

const shim = [
    "import { createRequire as __roastRequire } from 'node:module'",
    'const require = __roastRequire(import.meta.url)',
].join('\n')

async function execute (files:string[], number:number):Promise<boolean> {
    const bundle = resolve(ROOT, 'test', `.group-${randomUUID()}.js`)
    try {
        await build({
            ...baseOptions(),
            stdin:{
                contents:files.map(file => `import ${JSON.stringify(file)}`)
                    .join('\n'),
                resolveDir:ROOT,
                loader:'ts',
            },
            outfile:bundle,
            tsconfig:'tsconfig.json',
            banner:{ js:shim },
        })
        const child = spawn(process.execPath, [bundle], {
            cwd:ROOT, stdio:['ignore', 'pipe', 'pipe'],
        })
        const reporter = spawn(process.execPath,
            [resolve(ROOT, 'node_modules/tap-spec/bin/cmd.js')], {
                cwd:ROOT, stdio:['pipe', 'pipe', 'pipe'],
            })
        let output = ''
        child.stdout.pipe(reporter.stdin)
        child.stderr.on('data', chunk => { output += chunk })
        reporter.stdout.on('data', chunk => { output += chunk })
        reporter.stderr.on('data', chunk => { output += chunk })
        const wait = (proc:ChildProcess) => new Promise<boolean>(resolve => {
            proc.on('error', () => resolve(false))
            proc.on('close', code => resolve(code === 0))
        })
        const results = await Promise.all([wait(child), wait(reporter)])
        console.log(`\n--- group ${number}: ${files.join(', ')} ---\n${output}`)
        return results.every(Boolean)
    } catch (err) {
        console.error(`group ${number}:`, err)
        return false
    } finally {
        await rm(bundle, { force:true })
    }
}

async function main ():Promise<void> {
    const arg = process.env.ROAST_TEST_WORKERS
    if (arg !== undefined && (!/^\d+$/.test(arg) || Number(arg) < 1 ||
        !Number.isSafeInteger(Number(arg)))) {
        throw new Error('ROAST_TEST_WORKERS must be a positive integer')
    }
    const workers = arg ? Number(arg) : Math.min(4, availableParallelism())
    const args = process.argv.slice(2)
    let groups:string[][]
    if (args.length) {
        groups = args.map(file => [resolve(file)])
    } else {
        const index = await readFile(resolve(ROOT, 'test/index.ts'), 'utf8')
        const imports = [...index.matchAll(/^import '(.+\.js)'$/gm)]
            .map(match => resolve(ROOT, 'test',
                match[1].replace(/\.js$/, '.ts')))
        if (!imports.length) throw new Error('no test imports found')
        groups = Array.from({ length:Math.min(imports.length, 16) }, () => [])
        imports.forEach((file, i) => groups[i % groups.length].push(file))
    }
    let next = 0
    let failed = false
    await Promise.all(Array.from({ length:Math.min(workers, groups.length) },
        async () => {
            while (next < groups.length) {
                const i = next++
                if (!await execute(groups[i], i + 1)) failed = true
            }
        }))
    if (failed) process.exitCode = 1
}

try {
    await main()
} catch (err) {
    console.error(err)
    process.exitCode = 1
}

